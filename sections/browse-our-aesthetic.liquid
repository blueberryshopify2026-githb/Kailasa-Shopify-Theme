      "id": "big_image",
      "label": "Big Background Image"
    },
    {
      "type": "header",
      "content": "Center Card Size"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Center Card Width (%)",
      "min": 10,
      "max": 500,
      "step": 5,
      "default": 120
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Center Card Height (px)",
      "min": 100,
      "max": 600,
      "step": 5,
      "default": 300
    },
    {
      "type": "range",
      "id": "card_overlap",
      "label": "Card Overlap on Big Image (%)",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 20
