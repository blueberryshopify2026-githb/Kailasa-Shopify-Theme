        }
      ],
      "default": "700"
    },
    {
      "type": "select",
      "id": "title_style",
      "label": "Title Font Style",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "italic",
          "label": "Italic"
        }
      ],
      "default": "normal"
    },
    {
      "type": "select",
      "id": "subtitle_font",
      "label": "Subtitle Font Family",
      "options": [
        {
          "value": "Gilroy",
          "label": "Gilroy"
        },
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Arial",
          "label": "Arial"
        },
        {
          "value": "Helvetica",
          "label": "Helvetica"
        },
        {
          "value": "Georgia",
          "label": "Georgia"
        },
        {
          "value": "Times New Roman",
          "label": "Times New Roman"
        }
      ],
      "default": "Montserrat"
    },
