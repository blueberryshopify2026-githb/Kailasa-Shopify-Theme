<style>
    .cellular-harmony-hero {
      background: {{ section.settings.background_color | default: '#000' }};
      color: {{ section.settings.text_color | default: 'white' }};
      height: 90vh;
      width: 100%;
      padding: 0;
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: center;
    }

    .hero-container {
      width: 100%;
      max-width: 1600px;
      margin: 0 auto;
      padding: {{ section.settings.section_padding_top | default: 20 }}px {{ section.settings.section_padding_left | default: 40 }}px {{ section.settings.section_padding_bottom | default: 20 }}px;
      display: grid;
      grid-template-columns: 50% 50%;
      gap: 60px;
      align-items: center;
      height: 100vh;
      box-sizing: border-box;
    }

    /* Left Content */
    .hero-content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      max-width: 100%;
    }
  .hero-title {
    font-family: {{ section.settings.title_font | default: 'Montserrat' }}, -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: {{ section.settings.title_size | default: 48 }}px;
    line-height: 1.1;
    margin: 0 0 32px 0;
    color: {{ section.settings.text_color | default: '#ffffff' }};
    padding-left: 50px; /* adjust if needed */
    font-weight: 300; /* base: light (so "introducing" is light) */
  }

  /* Ensure the <p> inside the richtext has no extra margins */
  .hero-title p {
    margin: 0;
  }

  /* Make all <strong> inside the title bold */
  .hero-title strong {
    font-weight: 700;
    /* optionally keep them same color, or adjust if needed */
  }

  /* If you want "introducing" slightly smaller than the rest, uncomment:
  .hero-title p {
    font-size: 0.9em;
  }
  */


    .hero-subtitle {
      font-family: {{ section.settings.subtitle_font | default: 'Montserrat' }}, -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: {{ section.settings.subtitle_size | default: 18 }}px;
      font-weight: {{ section.settings.subtitle_weight | default: 400 }};
      font-style: {{ section.settings.subtitle_style | default: 'normal' }};
      line-height: 1.5;
      margin: 0 0 48px 0;
      color: {{ section.settings.text_color | default: 'white' | color_modify: 'alpha', 0.8 }};
      max-width: 85%;
     padding-left: 50px; /* adjust the value as needed */
    }

    /* Feature List */
    .hero-features {
      margin: 0 0 60px 0;
      position: relative;
    }

    .feature-item {
    display: flex;
    align-items: center;
    margin-bottom: 24px;
    position: relative;
    padding-left: 50px; /* adjust the value as needed */
  }

    .feature-item:last-child {
      margin-bottom: 0;
    }

    .feature-icon {
      width: 42px;
      height: 42px;
      margin-right: 20px;
      flex-shrink: 0;
    }

    .feature-icon svg {
      width: 100%;
      height: 100%;
      stroke: {{ section.settings.text_color | default: 'white' }};
      stroke-width: 1.5;
      fill: none;
    }

    .feature-icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .feature-text {
      flex: 1;
    }

    .feature-title {
      font-family: {{ section.settings.feature_font | default: 'Montserrat' }}, -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: {{ section.settings.feature_title_size | default: 18 }}px;
      font-weight: {{ section.settings.feature_title_weight | default: 700 }};
      font-style: {{ section.settings.feature_title_style | default: 'normal' }};
      line-height: 1.3;
      margin: 0 0 4px 0;
      color: {{ section.settings.text_color | default: 'white' }};
    }

    .feature-subtitle {
      font-family: {{ section.settings.feature_font | default: 'Montserrat' }}, -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: {{ section.settings.feature_subtitle_size | default: 15 }}px;
      font-weight: {{ section.settings.feature_subtitle_weight | default: 400 }};
      font-style: {{ section.settings.feature_subtitle_style | default: 'normal' }};
      line-height: 1.3;
      margin: 0;
      color: {{ section.settings.text_color | default: 'white' | color_modify: 'alpha', 0.7 }};
    }

    /* Plus signs between features */
    .feature-separator {
      display: flex;
      justify-content: flex-start;
      margin: 20px 82px;
      padding-left: 52px;
    }

    .feature-plus {
      width: {{ section.settings.plus_size | default: 20 }}px;
      height: {{ section.settings.plus_size | default: 20 }}px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .feature-plus::before,
    .feature-plus::after {
      content: '';
      position: absolute;
      background: {{ section.settings.plus_color | default: 'rgba(255, 255, 255, 1)' }};
    }

    .feature-plus::before {
      width: {{ section.settings.plus_line_length | default: 10 }}px;
      height: {{ section.settings.plus_line_width | default: 1.5 }}px;
    }

    .feature-plus::after {
      width: {{ section.settings.plus_line_width | default: 1.5 }}px;
      height: {{ section.settings.plus_line_length | default: 10 }}px;
    }

    /* CTA Buttons */
    .hero-ctas {
      display: flex;
      flex-direction: column;
      gap: 12px;
      align-items: center;
      width: 100%;
    }

    .cellular-harmony-cta-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 50px;
      border-radius: 30px;
      font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 16px;
      font-weight: 900;
      text-decoration: none;
      transition: all 0.3s ease;
      cursor: pointer;
      border: none;
      white-space: nowrap;
      height: 48px;
      box-sizing: border-box;
      position: relative;
      width: 100%;
      max-width: 460px;
    }

    .cta-primary {
      background: {{ section.settings.primary_cta_bg | default: 'white' }};
      color: {{ section.settings.primary_cta_text_color | default: '#000' }};
      min-width: 260px;
    }

    .cta-primary:hover {
      background: {{ section.settings.primary_cta_bg | default: 'white' | color_modify: 'alpha', 0.9 }};
      transform: translateY(-1px);
      box-shadow: 0 4px 12px {{ section.settings.primary_cta_bg | default: 'white' | color_modify: 'alpha', 0.2 }};
    }

    .cta-secondary {
      background: {{ section.settings.secondary_cta_bg | default: '#00bcd4' }};
      color: {{ section.settings.secondary_cta_text_color | default: 'white' }};
      min-width: 220px;
    }

    .cta-secondary:hover {
      background: {{ section.settings.secondary_cta_bg | default: '#00bcd4' | color_darken: 5 }};
      transform: translateY(-1px);
      box-shadow: 0 4px 12px {{ section.settings.secondary_cta_bg | default: '#00bcd4' | color_modify: 'alpha', 0.3 }};
    }

    .cta-icon {
      position: absolute;
      right: 20px;
      width: 18px;
      height: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .cta-icon svg {
      width: 100%;
      height: 100%;
      stroke: currentColor;
      stroke-width: 2;
      fill: none;
    }

    /* Right Column */
    .hero-image {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      position: relative;
      gap: 10px;
    }

    .cellular-harmony-hero .before-after-container {
      position: relative;
      width: {{ section.settings.image_width | default: 400 }}px !important;
      height: {{ section.settings.image_height | default: 500 }}px !important;
      border-radius: {{ section.settings.image_border_radius | default: 24 }}px;
      overflow: hidden;
      box-shadow: 0 20px 60px s;
      /* Debug: Current settings - Width: {{ section.settings.image_width | default: 400 }}px, Height: {{ section.settings.image_height | default: 500 }}px */
    }

    .cellular-harmony-hero .results-before-after {
      width: 100%;
      height: 100%;
      object-fit: {{ section.settings.image_fit | default: 'cover' }};
      display: block;
    }

    .image-divider {
      position: absolute;
      top: 0;
      left: 50%;
      width: 3px;
      height: 100%;
      background: white;
      transform: translateX(-50%);
      z-index: 2;
      box-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
    }

    /* Responsive Design */
    @media (max-width: 1600px) {
      .hero-container {
        padding: 20px 30px;
        gap: 40px;
      }

      .hero-title {
        font-size: 42px;
      }

      .cellular-harmony-hero .before-after-container {
        width: calc({{ section.settings.image_width | default: 400 }}px * 0.875) !important;
        height: calc({{ section.settings.image_height | default: 500 }}px * 0.88) !important;
      }
    }

    @media (max-width: 968px) {
      .cellular-harmony-hero {
        height: auto;
        min-height: 100vh;
      }

      .hero-container {
        grid-template-columns: 1fr;
        gap: 40px;
        text-align: left;
        height: auto;
        min-height: 100vh;
        padding: 60px 40px;
      }

      .hero-content {
        order: 2;
      }

      .hero-image {
        order: 1;
        justify-content: center;
      }

      .hero-title {
        font-size: 38px;
      }

      .hero-subtitle {
        max-width: 100%;
      }

      .cellular-harmony-hero .before-after-container {
        width: calc({{ section.settings.image_width | default: 400 }}px * 0.8) !important;
        height: calc({{ section.settings.image_height | default: 500 }}px * 0.8) !important;
      }
    }

    @media (max-width: 640px) {
      .cellular-harmony-hero {
        height: auto;
        min-height: 100vh;
      }

      .hero-container {
        padding: 40px 20px;
        gap: 32px;
        min-height: 100vh;
      }

      .hero-title {
        font-size: 32px;
      }

      .hero-subtitle {
        font-size: 16px;
        margin-bottom: 40px;
      }

      .hero-features {
        margin-bottom: 50px;
      }

      .feature-item {
        margin-bottom: 24px;
      }

      .feature-title {
        font-size: 15px;
      }

      .feature-subtitle {
        font-size: 13px;
      }

      .cellular-harmony-cta-button {
        padding: 14px 24px;
        font-size: 14px;
        height: 48px;
      }

      .hero-ctas {
        flex-direction: column;
        width: 100%;
        gap: 12px;
      }

      .cellular-harmony-cta-button {
        width: 100%;
        justify-content: center;
      }

      .cellular-harmony-hero .before-after-container {
        width: calc({{ section.settings.image_width | default: 400 }}px * 0.7) !important;
        height: calc({{ section.settings.image_height | default: 500 }}px * 0.7) !important;
      }
    }

    @media (max-width: 480px) {
      .hero-container {
        padding: 32px 16px;
      }

      .hero-title {
        font-size: 28px;
      }

      .hero-subtitle {
        font-size: 15px;
      }

      .cellular-harmony-hero .before-after-container {
        width: calc({{ section.settings.image_width | default: 400 }}px * 0.6) !important;
        height: calc({{ section.settings.image_height | default: 500 }}px * 0.6) !important;
      }

      .feature-separator {
        padding-left: 40px;
      }
    }
</style>

<section class="cellular-harmony-hero full-width">
  <div class="hero-container">
    <!-- Left Content -->
    <div class="hero-content">
      <div class="hero-title">
        {{ section.settings.title }}
      </div>

      <p class="hero-subtitle">
        {{
          section.settings.subtitle
          | default: 'Restore firmness, smooth fine lines, and revive your natural glow with science backed anti-aging therapy.'
        }}
      </p>

      <div class="hero-features">
        {% for block in section.blocks %}
          <div class="feature-item">
            <div class="feature-icon">
              {% if block.settings.custom_icon %}
                <img
                  src="{{ block.settings.custom_icon | image_url: width: 64 }}"
                  alt="{{ block.settings.title }}"
                  width="32"
                  height="32"
                >
              {% else %}
                {% case block.settings.icon %}
                  {% when 'led-mask' %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="9" cy="9" r="1.5" fill="currentColor"/>
                      <circle cx="15" cy="9" r="1.5" fill="currentColor"/>
                      <path d="M8 15s1.5 2 4 2 4-2 4-2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                  {% when 'supplement' %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M12 2L2 7v10c0 5.55 3.84 9.74 9 11 5.16-1.26 9-5.45 9-11V7l-10-5z" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {% when 'skincare' %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z" stroke="currentColor" stroke-width="1.5"/>
                      <circle cx="12" cy="9" r="2" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  {% when 'heart' %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  {% when 'star' %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <polygon points="12,2 15.09,8.26 22,9.27 17,14.14 18.18,21.02 12,17.77 5.82,21.02 7,14.14 2,9.27 8.91,8.26" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  {% when 'lightning' %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <polygon points="13,2 3,14 12,14 11,22 21,10 12,10" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  {% when 'leaf' %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.06.82C6.16 17.85 9.28 12.48 16 11.16c2.5-.47 5-1.16 6-2.16 1-1 1.69-3.5 2.16-6-.47 2.5-1.16 5-2.16 6z" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M9 10a4 4 0 0 1 4-4" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  {% when 'diamond' %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <polygon points="6,3 18,3 22,9 12,20 2,9" stroke="currentColor" stroke-width="1.5"/>
                      <polyline points="6,3 12,9 18,3" stroke="currentColor" stroke-width="1.5"/>
                      <polyline points="2,9 12,9 22,9" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  {% when 'circle' %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  {% when 'hexagon' %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <polygon points="7.86,2 16.14,2 20.28,8 16.14,14 7.86,14 3.72,8" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none">
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/>
                      <path d="M8 12h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      <path d="M12 8v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    </svg>
                {% endcase %}
              {% endif %}
            </div>
            <div class="feature-text">
              <h3 class="feature-title">{{ block.settings.title | default: 'Feature Title' }}</h3>
              <p class="feature-subtitle">{{ block.settings.subtitle | default: 'Feature Description' }}</p>
            </div>
          </div>
          {% unless forloop.last %}
            <div class="feature-separator">
              <div class="feature-plus"></div>
            </div>
          {% endunless %}
        {% endfor %}
      </div>
    </div>

    <!-- Right Column: Image + Buttons -->
    <div class="hero-image">
      <div class="before-after-container">
        {% if section.settings.hero_image %}
          <img
            src="{{ section.settings.hero_image | image_url: width: 800, height: 1000 }}"
            alt="Before and After Results"
            class="results-before-after"
            width="400"
            height="500"
          >
        {% else %}
          <div
            class="results-before-after"
            style="background: #333; display: flex; align-items: center; justify-content: center; color: #999; font-size: 14px;"
          >
            Before / After Image
          </div>
        {% endif %}
        {% if section.settings.show_image_divider %}
          <div class="image-divider"></div>
        {% endif %}
      </div>

      <!-- Buttons under the image -->
      <div class="hero-ctas">
        <a href="{{ section.settings.primary_cta_url | default: '#' }}" class="cellular-harmony-cta-button cta-primary">
          {{ section.settings.primary_cta_text | default: 'Cellular Harmony™ Protocol' }}
          <span class="cta-icon">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>

        <a href="{{ section.settings.secondary_cta_url | default: '#' }}" class="cellular-harmony-cta-button cta-secondary">
          {{ section.settings.secondary_cta_text | default: 'Take Regeneration Audit' }}
          <span class="cta-icon">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cellular Harmony Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero Content"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Hero Title",
      "default": "<p>introducing <strong>Cellular</strong><br><strong>Harmony™</strong></p>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Hero Subtitle",
      "default": "Restore firmness, smooth fine lines, and revive your natural glow with science backed anti-aging therapy."
    },
    {
      "type": "header",
      "content": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Before/After Image",
      "info": "Recommended: Portrait orientation, 800x1000px minimum"
    },
    {
      "type": "checkbox",
      "id": "show_image_divider",
      "label": "Show vertical divider line",
      "default": true
    },
    {
      "type": "header",
      "content": "Call-to-Action Buttons"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Text",
      "default": "Cellular Harmony™ Protocol"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "color",
      "id": "primary_cta_bg",
      "label": "Primary CTA Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "primary_cta_text_color",
      "label": "Primary CTA Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "Take Regeneration Audit"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "color",
      "id": "secondary_cta_bg",
      "label": "Secondary CTA Background",
      "default": "#00bcd4"
    },
    {
      "type": "color",
      "id": "secondary_cta_text_color",
      "label": "Secondary CTA Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "title_font",
      "label": "Title Font Family",
      "options": [
        {
          "value": "Gilroy",
          "label": "Gilroy"
        },
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Arial",
          "label": "Arial"
        },
        {
          "value": "Helvetica",
          "label": "Helvetica"
        },
        {
          "value": "Georgia",
          "label": "Georgia"
        },
        {
          "value": "Times New Roman",
          "label": "Times New Roman"
