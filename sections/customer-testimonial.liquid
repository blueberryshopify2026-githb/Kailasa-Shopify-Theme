    { "type": "range", "id": "ct_gap", "label": "Gap Between Cards (px)", "min": 4, "max": 40, "step": 1, "default": 15 },
    { "type": "range", "id": "ct_card_height", "label": "Card Height (px)", "min": 200, "max": 600, "step": 10, "default": 420 },
    { "type": "range", "id": "ct_card_radius", "label": "Card Border Radius (px)", "min": 0, "max": 40, "step": 2, "default": 16 },

    { "type": "header", "content": "── Heading" },
    { "type": "text", "id": "ct_heading", "label": "Heading", "default": "What Our Customers Say" },
