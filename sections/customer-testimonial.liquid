    { "type": "range", "id": "ct_frost_radius", "label": "Radius (px)", "min": 0, "max": 30, "step": 2, "default": 12 },
    { "type": "range", "id": "ct_frost_offset", "label": "Offset from Edge (px)", "min": 0, "max": 30, "step": 2, "default": 12 },
    { "type": "range", "id": "ct_frost_pad_v", "label": "Padding Vertical (px)", "min": 8, "max": 40, "step": 2, "default": 16 },
    { "type": "range", "id": "ct_frost_pad_h", "label": "Padding Horizontal (px)", "min": 8, "max": 40, "step": 2, "default": 16 },

    { "type": "header", "content": "── Text" },
    { "type": "range", "id": "ct_quote_size", "label": "Quote Size (px)", "min": 11, "max": 22, "step": 1, "default": 14 },
    { "type": "color", "id": "ct_quote_color", "label": "Quote Color", "default": "#000000" },
    { "type": "range", "id": "ct_name_size", "label": "Name Size (px)", "min": 10, "max": 18, "step": 1, "default": 13 },
    { "type": "color", "id": "ct_name_color", "label": "Name Color", "default": "#4fffff" },

