{% comment %}
  Customer Testimonial — sequential infinite scroll, one column at a time
  Class suffix: ct
{% endcomment %}

{%- assign ct_card_h = section.settings.ct_card_height -%}
{%- assign ct_gap    = section.settings.ct_gap -%}
{% comment %} {%- assign ct_vis_h  = ct_card_h | plus: ct_gap | plus: ct_card_h | divided_by: 2 -%} {% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap');

  .ct-section {
    font-family: 'Montserrat', sans-serif;
    background-color: {{ section.settings.ct_bg }};
    /* padding: {{ section.settings.ct_padding_v }}px 0; */
    padding-bottom:20px;
    padding-top:30px;
    overflow: hidden;
    width: 100%;

  }

  .ct-heading-wrap {
    text-align: {{ section.settings.ct_heading_align }};
    padding: 0 30px {{ section.settings.ct_heading_gap }}px;
  }

  .ct-heading {
    font-size: {{ section.settings.ct_heading_size }}px;
    font-weight: {{ section.settings.ct_heading_weight }};
    color: {{ section.settings.ct_heading_color }};
    margin: 0 0 8px 0;
    padding: 10px;
    /* border: 1px solid red; */
  
  }

  .ct-subheading {
    font-size: {{ section.settings.ct_subheading_size }}px;
    color: {{ section.settings.ct_subheading_color }};
    margin: 0;
  }

  .ct-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ ct_gap }}px;
    padding: 10px;
    height: 90vh;
    overflow: hidden;
    align-items: start;
  }

  .ct-col {
    display: flex;
    flex-direction: column;
    gap: {{ ct_gap }}px;
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Initial positions set via CSS — col 2 & 4 offset by half card */
  #ctCol1, #ctCol3 {
    transform: translateY(0px);
  }
  #ctCol2, #ctCol4 {
    transform: translateY(-{{ ct_card_h | divided_by: 2 }}px);
  }

  .ct-card {
    position: relative;
    border-radius: {{ section.settings.ct_card_radius }}px;
    overflow: hidden;
    flex-shrink: 0;
    height: {{ ct_card_h }}px;
    background: #ddd;
  }

  .ct-card-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ct-card-bg-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #e8e8e8, #d0d0d0);
  }

  .ct-frost {
    position: absolute;
    bottom: {{ section.settings.ct_frost_offset }}px;
    left: {{ section.settings.ct_frost_offset }}px;
    right: {{ section.settings.ct_frost_offset }}px;
    background: rgba(255,255,255,{{ section.settings.ct_frost_opacity | divided_by: 100.0 }});
    backdrop-filter: blur({{ section.settings.ct_frost_blur }}px);
    -webkit-backdrop-filter: blur({{ section.settings.ct_frost_blur }}px);
    border-radius: {{ section.settings.ct_frost_radius }}px;
    padding: {{ section.settings.ct_frost_pad_v }}px {{ section.settings.ct_frost_pad_h }}px;
    border: 1px solid rgba(255,255,255,0.5);
  }

  .ct-quote {
    font-size: {{ section.settings.ct_quote_size }}px;
    font-weight: 500;
    color: {{ section.settings.ct_quote_color }};
    line-height: 1.5;
    margin: 0 0 6px 0;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ct-name {
    font-size: {{ section.settings.ct_name_size }}px;
    font-weight: 700;
    color: {{ section.settings.ct_name_color }};
    margin: 0;
  }

  @media (max-width: 768px) {
    .ct-grid {
      grid-template-columns: repeat(2, 1fr);
      height: auto;
      overflow: visible;
    }
  }
</style>

<section class="ct-section">
  {% if section.settings.ct_heading != blank or section.settings.ct_subheading != blank %}
    <div class="ct-heading-wrap">
      {% if section.settings.ct_heading != blank %}
        <h2 class="ct-heading">{{ section.settings.ct_heading }}</h2>
      {% endif %}
      {% if section.settings.ct_subheading != blank %}
        <p class="ct-subheading">{{ section.settings.ct_subheading }}</p>
      {% endif %}
    </div>
  {% endif %}

  <div class="ct-grid">
    {% for col_index in (1..4) %}
      <div class="ct-col" id="ctCol{{ col_index }}">
        {% comment %}Render cards 3 times for seamless infinite loop{% endcomment %}
        {% for pass in (1..3) %}
          {% for block in section.blocks %}
            {%- assign block_col = block.settings.ct_column | plus: 0 -%}
            {% if block_col == col_index %}
              <div class="ct-card" {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>
                {% if block.settings.ct_bg_image != blank %}
                  <img
                    class="ct-card-bg"
                    src="{{ block.settings.ct_bg_image | image_url: width: 600 }}"
                    alt="{{ block.settings.ct_customer_name }}"
                    width="600"
                    height="800"
                    loading="lazy"
                  >
                {% else %}
                  <div class="ct-card-bg-placeholder"></div>
                {% endif %}
                <div class="ct-frost">
                  {% if block.settings.ct_quote != blank %}
                    <p class="ct-quote">"{{ block.settings.ct_quote }}"</p>
                  {% endif %}
                  {% if block.settings.ct_customer_name != blank %}
                    <p class="ct-name">— {{ block.settings.ct_customer_name }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</section>

<script>
(function () {
  var CARD_H   = {{ ct_card_h }};
  var GAP      = {{ ct_gap }};
  var SPEED    = {{ section.settings.ct_speed }};
  var PAUSE_MS = {{ section.settings.ct_anim_pause }};

  // SET_H = height of one full set of 4 cards
  var SET_H = (CARD_H + GAP) * 4;

  /*
    REST = the y value that shows the correct "stopped" layout.
    Cols 1,3 (up):   REST = 0            → card1 full, card2 half
    Cols 2,4 (down): REST = -(CARD_H/2)  → card1 half, card2 full

    Valid y range for each column: [REST - 2*SET_H, REST]
    This ensures 3 sets of cards always cover the viewport — never blank.

    When scrolling UP (dir=1):  y decreases. Clamp: y >= REST - 2*SET_H
    When scrolling DOWN (dir=-1): y increases. Clamp: y <= REST

    After each full SET_H scroll, snap y back toward REST by adding/subtracting SET_H.
  */

  var REST = { ctCol1: 0, ctCol2: -(CARD_H/2), ctCol3: 0, ctCol4: -(CARD_H/2) };

  var sequence = [
    { id: 'ctCol1', dir: 1  },
    { id: 'ctCol4', dir: -1 },
    { id: 'ctCol3', dir: 1  },
    { id: 'ctCol2', dir: -1 }
  ];

  // Start each column at REST - SET_H so there's content above for down-scroll
  var colY = {
    ctCol1: REST.ctCol1 - SET_H,
    ctCol2: REST.ctCol2 - SET_H,
    ctCol3: REST.ctCol3 - SET_H,
    ctCol4: REST.ctCol4 - SET_H
  };

  var hovered = { ctCol1:false, ctCol2:false, ctCol3:false, ctCol4:false };
  var seqIndex = 0, raf = null, lastTime = null, activeId = null, scrolled = 0;

  function getEl(id) { return document.getElementById(id); }

  function applyY(id) {
    var el = getEl(id);
    if (el) el.style.transform = 'translateY(' + colY[id] + 'px)';
  }

  function clampY(id) {
    var rest = REST[id];
    var lo = rest - 2 * SET_H;
    var hi = rest;
    // Wrap into valid range
    while (colY[id] < lo) colY[id] += SET_H;
    while (colY[id] > hi) colY[id] -= SET_H;
  }

  function startNext() {
    var s = sequence[seqIndex % sequence.length];
    activeId = s.id;
    scrolled = 0;
    lastTime = null;
    raf = requestAnimationFrame(tick);
  }

  function tick(now) {
    if (!lastTime) { lastTime = now; raf = requestAnimationFrame(tick); return; }
    var dt = Math.min((now - lastTime) / 1000, 0.05);
    lastTime = now;

    var dir = sequence[seqIndex % sequence.length].dir;

    if (!hovered[activeId]) {
      var remaining = SET_H - scrolled;
      var move = Math.min(SPEED * dt, remaining);
      scrolled += move;
      colY[activeId] -= dir * move;
      // Clamp immediately — never let y escape valid range
      clampY(activeId);
      applyY(activeId);
    }

    if (scrolled >= SET_H) {
      // Final snap: round to nearest SET_H step from REST
      var rest = REST[activeId];
      var diff = colY[activeId] - rest;
      var steps = Math.round(diff / SET_H);
      colY[activeId] = rest + steps * SET_H;
      clampY(activeId);
      applyY(activeId);

      seqIndex++;
      cancelAnimationFrame(raf);
      setTimeout(startNext, PAUSE_MS);
      return;
    }

    raf = requestAnimationFrame(tick);
  }

  function setupHover() {
    ['ctCol1','ctCol2','ctCol3','ctCol4'].forEach(function(id) {
      var el = getEl(id);
      if (!el) return;
      el.addEventListener('mouseenter', function() { hovered[id] = true; });
      el.addEventListener('mouseleave', function() { hovered[id] = false; });
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    ['ctCol1','ctCol2','ctCol3','ctCol4'].forEach(function(id) {
      applyY(id);
    });
    setupHover();
    setTimeout(startNext, PAUSE_MS);
  });
})();
</script>

{% schema %}
{
  "name": "Customer Testimonial",
