</style>

<script>
  let currentActiveMenu = null;
  let hoverTimeout = null;

  function showMegaMenuOnHover(menuType) {
    // Clear any pending hover timeout
    if (hoverTimeout) {
      clearTimeout(hoverTimeout);
      hoverTimeout = null;
    }

    const megaBox = document.getElementById('mega-menu-box');
    const allSections = document.querySelectorAll('.mega-menu-section');
    const targetSection = document.getElementById('menu-' + menuType);
    
    // Remove active class from all nav items
    const allNavItems = document.querySelectorAll('.nav-item');
    allNavItems.forEach(item => {
      item.classList.remove('active');
    });
    
    // Add active class to hovered nav item
    const hoveredNavItem = document.querySelector(`[onmouseenter*="${menuType}"]`).parentElement;
    hoveredNavItem.classList.add('active');

    // Hide all sections first
    allSections.forEach(section => {
      section.classList.remove('active');
    });

    // Show the target section and mega box
    targetSection.classList.add('active');
    megaBox.classList.add('active');
    currentActiveMenu = menuType;
  }

  function closeMegaMenu(event) {
    // Prevent default link behavior
    event.preventDefault();
    
    const megaBox = document.getElementById('mega-menu-box');
    
    // Close the mega menu
    megaBox.classList.remove('active');
    
    document.querySelectorAll('.mega-menu-section').forEach(section => {
      section.classList.remove('active');
    });
    
    document.querySelectorAll('.nav-item').forEach(item => {
      item.classList.remove('active');
    });
    
    currentActiveMenu = null;
    
    // Clear any pending hover timeout
    if (hoverTimeout) {
      clearTimeout(hoverTimeout);
      hoverTimeout = null;
    }
  }

  function hideMegaMenuOnLeave() {
    // Add a small delay before hiding to prevent flickering
    hoverTimeout = setTimeout(() => {
      const megaBox = document.getElementById('mega-menu-box');
      megaBox.classList.remove('active');
      
      document.querySelectorAll('.mega-menu-section').forEach(section => {
        section.classList.remove('active');
      });
      
      document.querySelectorAll('.nav-item').forEach(item => {
        item.classList.remove('active');
      });
      
      currentActiveMenu = null;
    }, 200); // 200ms delay
  }

  function keepMegaMenuOpen() {
    // Cancel the hide timeout when mouse enters mega menu
    if (hoverTimeout) {
      clearTimeout(hoverTimeout);
      hoverTimeout = null;
    }
  }

  // Add event listeners when DOM is loaded
  document.addEventListener('DOMContentLoaded', function() {
    const navigation = document.querySelector('.main-navigation');
    const megaBox = document.getElementById('mega-menu-box');
    
    // Keep mega menu open when hovering over it
    if (megaBox) {
      megaBox.addEventListener('mouseenter', keepMegaMenuOpen);
      megaBox.addEventListener('mouseleave', hideMegaMenuOnLeave);
    }
    
    // Add hover listeners to navigation
    if (navigation) {
      navigation.addEventListener('mouseleave', hideMegaMenuOnLeave);
    }
  });

  // Close mega menu with Escape key
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      const megaBox = document.getElementById('mega-menu-box');
      megaBox.classList.remove('active');
      document.querySelectorAll('.mega-menu-section').forEach(section => {
        section.classList.remove('active');
      });
      document.querySelectorAll('.nav-item').forEach(item => {
        item.classList.remove('active');
      });
      currentActiveMenu = null;
    }
  });

  // Header hide/show on scroll
  let lastScrollTop = 0;
  let scrollThreshold = 10;
  let ticking = false;
  
  function updateHeaderVisibility() {
    const headerWrapper = document.querySelector('.header-wrapper');
    const currentScroll = window.pageYOffset || document.documentElement.scrollTop;
    
    // Prevent negative values
    if (currentScroll < 0) {
      ticking = false;
      return;
    }
    
    // Check if scroll difference is significant
    if (Math.abs(currentScroll - lastScrollTop) < scrollThreshold) {
      ticking = false;
      return;
    }
    
    if (currentScroll > lastScrollTop && currentScroll > 150) {
      // Scrolling down & past 150px - hide header
      headerWrapper.classList.add('header-hidden');
    } else if (currentScroll < lastScrollTop) {
      // Scrolling up - show header
      headerWrapper.classList.remove('header-hidden');
    }
    
    lastScrollTop = currentScroll <= 0 ? 0 : currentScroll;
    ticking = false;
  }
  
  window.addEventListener('scroll', function() {
    if (!ticking) {
      window.requestAnimationFrame(updateHeaderVisibility);
      ticking = true;
    }
  }, { passive: true });
</script>

