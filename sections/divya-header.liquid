<div class="header-wrapper">
  {% if section.settings.show_announcement_bar %}
    <div class="announcement-bar" style="background-color: {{ section.settings.announcement_bg_color }}; color: {{ section.settings.announcement_text_color }};">
      <div class="announcement-content">
        {{ section.settings.announcement_text }}
      </div>
    </div>
  {% endif %}

  <header>
    <div class="header-container">
    <!-- Logo -->
    <div class="logo">
      <h1 style="font-family: {{ section.settings.font_family }}; font-weight: {{ section.settings.logo_font_weight }}; font-size: {{ section.settings.logo_font_size }}px;">
        Kailasa
      </h1>
    </div>

    <!-- Navigation Menu -->
    <nav class="main-navigation">
      <ul class="nav-list">
        <li class="nav-item {% if section.settings.active_tab == 'shop-all' %}active{% endif %}">
          <a href="#" onmouseenter="showMegaMenuOnHover('shop-all')" onclick="closeMegaMenu(event)" style="font-family: {{ section.settings.font_family }}; font-weight: {{ section.settings.nav_font_weight }}; font-size: {{ section.settings.nav_font_size }}px;">
            Shop All
          </a>
        </li>
        <li class="nav-item {% if section.settings.active_tab == 'science' %}active{% endif %}">
          <a href="#" onmouseenter="showMegaMenuOnHover('science')" onclick="closeMegaMenu(event)" style="font-family: {{ section.settings.font_family }}; font-weight: {{ section.settings.nav_font_weight }}; font-size: {{ section.settings.nav_font_size }}px;">
            Science
          </a>
        </li>
        <li class="nav-item {% if section.settings.active_tab == 'quiz' %}active{% endif %}">
          <a href="#" onmouseenter="showMegaMenuOnHover('quiz')" onclick="closeMegaMenu(event)" style="font-family: {{ section.settings.font_family }}; font-weight: {{ section.settings.nav_font_weight }}; font-size: {{ section.settings.nav_font_size }}px;">
            Quiz
          </a>
        </li>
        <li class="nav-item {% if section.settings.active_tab == 'routine' %}active{% endif %}">
          <a href="#" onmouseenter="showMegaMenuOnHover('routine')" onclick="closeMegaMenu(event)" style="font-family: {{ section.settings.font_family }}; font-weight: {{ section.settings.nav_font_weight }}; font-size: {{ section.settings.nav_font_size }}px;">
            Routine
          </a>
        </li>
        <li class="nav-item {% if section.settings.active_tab == 'vip' %}active{% endif %}">
          <a href="#" onmouseenter="showMegaMenuOnHover('vip')" onclick="closeMegaMenu(event)" style="font-family: {{ section.settings.font_family }}; font-weight: {{ section.settings.nav_font_weight }}; font-size: {{ section.settings.nav_font_size }}px;">
            VIP
          </a>
        </li>
        <li class="nav-item {% if section.settings.active_tab == 'about' %}active{% endif %}">
          <a href="#" onmouseenter="showMegaMenuOnHover('about')" onclick="closeMegaMenu(event)" style="font-family: {{ section.settings.font_family }}; font-weight: {{ section.settings.nav_font_weight }}; font-size: {{ section.settings.nav_font_size }}px;">
            About
          </a>
        </li>
        <li class="nav-item {% if section.settings.active_tab == 'blog' %}active{% endif %}">
          <a href="#" onmouseenter="showMegaMenuOnHover('blog')" onclick="closeMegaMenu(event)" style="font-family: {{ section.settings.font_family }}; font-weight: {{ section.settings.nav_font_weight }}; font-size: {{ section.settings.nav_font_size }}px;">
            Blog
          </a>
        </li>
      </ul>
    </nav>

    <!-- Header Icons -->
    <div class="header-icons">
      <button class="icon-btn search-btn" aria-label="Search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>
      
      <button class="icon-btn cart-btn" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 22C9.55228 22 10 21.5523 10 21C10 20.4477 9.55228 20 9 20C8.44772 20 8 20.4477 8 21C8 21.5523 8.44772 22 9 22Z"></path>
          <path d="M20 22C20.5523 22 21 21.5523 21 21C21 20.4477 20.5523 20 20 20C19.4477 20 19 20.4477 19 21C19 21.5523 19.4477 22 20 22Z"></path>
          <path d="M1 1H5L7.68 14.39C7.77144 14.8504 8.02191 15.264 8.38755 15.5583C8.75318 15.8526 9.2107 16.009 9.68 16H19.4C19.8693 16.009 20.3268 15.8526 20.6925 15.5583C21.0581 15.264 21.3086 14.8504 21.4 14.39L23 6H6"></path>
        </svg>
      </button>
      
      <button class="icon-btn user-btn" aria-label="Account">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mega Menu Frost Glass Box -->
<div id="mega-menu-box" class="mega-menu-box">
  <div class="mega-menu-container">
    
    <!-- Shop All Menu -->
    <div id="menu-shop-all" class="mega-menu-section">
      <div class="shop-all-layout">
        <!-- Left Section - 9 Products (3x3 Grid) -->
        <div class="kailasa-header-products-section">
          {% for i in (1..9) %}
            <div class="kailasa-header-product-card">
              {% assign product_image_key = 'shop_all_product_' | append: i | append: '_image' %}
              {% assign product_name_key = 'shop_all_product_' | append: i | append: '_name' %}
              {% assign product_image = section.settings[product_image_key] %}
              {% assign product_name = section.settings[product_name_key] %}
              
              <div class="product-card-image">
                {% if product_image %}
                  <img src="{{ product_image | img_url: '120x120' }}" alt="{{ product_name }}" width="120" height="120">
                {% else %}
                  <div class="product-placeholder"></div>
                {% endif %}
              </div>
              <p class="product-card-name">{{ product_name | default: 'Product' }}</p>
            </div>
          {% endfor %}
        </div>

        <!-- Middle Section - 2 Images Stacked -->
        <div class="middle-images-section">
          <div class="middle-image-card">
            {% if section.settings.shop_all_middle_image_1 %}
              <img src="{{ section.settings.shop_all_middle_image_1 | img_url: '300x300' }}" alt="{{ section.settings.shop_all_middle_image_1_text }}" width="300" height="300">
            {% else %}
              <div class="middle-placeholder"></div>
            {% endif %}
            {% if section.settings.shop_all_middle_image_1_text %}
              <p class="middle-image-text">{{ section.settings.shop_all_middle_image_1_text }}</p>
            {% endif %}
          </div>
          
          <div class="middle-image-card">
            {% if section.settings.shop_all_middle_image_2 %}
              <img src="{{ section.settings.shop_all_middle_image_2 | img_url: '300x300' }}" alt="{{ section.settings.shop_all_middle_image_2_text }}" width="300" height="300">
            {% else %}
              <div class="middle-placeholder"></div>
            {% endif %}
            {% if section.settings.shop_all_middle_image_2_text %}
              <p class="middle-image-text">{{ section.settings.shop_all_middle_image_2_text }}</p>
            {% endif %}
          </div>
        </div>

        <!-- Right Section - 1 Large Image with Button -->
        <div class="right-large-section">
          <div class="large-image-card">
            {% if section.settings.shop_all_large_image %}
              <img src="{{ section.settings.shop_all_large_image | img_url: '600x600' }}" alt="{{ section.settings.shop_all_large_button_text }}" width="600" height="600">
            {% else %}
              <div class="large-placeholder"></div>
            {% endif %}
          </div>
           {% if section.settings.shop_all_large_button_text %}
              <a href="{{ section.settings.shop_all_large_button_link | default: '#' }}" class="large-image-button">
                {{ section.settings.shop_all_large_button_text }}
              </a>
            {% endif %}
        </div>
      </div>
    </div>

    <!-- Science Menu -->
    <div id="menu-science" class="mega-menu-section">
      <div class="science-tiles-layout">
        {% for i in (1..4) %}
          {% assign tile_image_key = 'science_tile_' | append: i | append: '_image' %}
          {% assign tile_name_key = 'science_tile_' | append: i | append: '_name' %}
          {% assign tile_link_key = 'science_tile_' | append: i | append: '_link' %}
          {% assign tile_image = section.settings[tile_image_key] %}
          {% assign tile_name = section.settings[tile_name_key] %}
          {% assign tile_link = section.settings[tile_link_key] %}
          
          <a href="{{ tile_link | default: '#' }}" class="science-tile">
            <div class="science-tile-image">
              {% if tile_image %}
                <img src="{{ tile_image | image_url: width: 250 }}" 
                     alt="{{ tile_name }}" 
                     width="180" 
                     height="180" 
                     loading="lazy">
              {% else %}
                <div class="science-tile-placeholder"></div>
              {% endif %}
            </div>
            <p class="science-tile-name">{{ tile_name | default: 'Science Tile' }}</p>
          </a>
        {% endfor %}
      </div>
    </div>

    <!-- Quiz Menu -->
    <div id="menu-quiz" class="mega-menu-section">
      <div class="quiz-content-layout">
        <div class="quiz-text-section">
          <h2 class="quiz-title">{{ section.settings.quiz_title }}</h2>
          {% comment %} <p class="quiz-subtitle">{{ section.settings.quiz_subtitle }}</p> {% endcomment %}
          <p class="quiz-description">{{ section.settings.quiz_description }}</p>
          <a href="{{ section.settings.quiz_button_link | default: '#' }}" class="quiz-cta-button">
            {{ section.settings.quiz_button_text }}
          </a>
        </div>
        
        <div class="quiz-image-section">
          {% if section.settings.quiz_image %}
            <img src="{{ section.settings.quiz_image | image_url: width: 500 }}" 
                 alt="{{ section.settings.quiz_title }}" 
                 width="500" 
                 height="300" 
                 loading="lazy">
          {% else %}
            <div class="quiz-image-placeholder"></div>
          {% endif %}
        </div>
      </div>
    </div>

    
    <!-- Routine Menu -->
    <div id="menu-routine" class="mega-menu-section">
      <div class="routine-mega-content">
        <div class="routine-mega-header">
          {% comment %} <h2 class="routine-mega-title">{{ section.settings.routine_title | default: 'Skincare Routine -' }}</h2> {% endcomment %}
          <p class="routine-mega-subtitle">{{ section.settings.routine_subtitle | default: 'Give your skin a megadose of Vitamin C. Our 20%' }}</p>
        </div>
        
        <div class="routine-mega-images-row">
          <div class="routine-mega-image-card">
            {% if section.settings.routine_image_1 %}
              <img src="{{ section.settings.routine_image_1 | image_url: width: 300 }}" 
                   alt="Routine Step 1" 
                   width="300" 
                   height="300" 
                   loading="lazy">
            {% else %}
              <div class="routine-mega-placeholder"></div>
            {% endif %}
          </div>
          
          <div class="routine-mega-plus">+</div>
          
          <div class="routine-mega-image-card">
            {% if section.settings.routine_image_2 %}
              <img src="{{ section.settings.routine_image_2 | image_url: width: 300 }}" 
                   alt="Routine Step 2" 
                   width="300" 
                   height="300" 
                   loading="lazy">
            {% else %}
              <div class="routine-mega-placeholder"></div>
            {% endif %}
          </div>
          
          <div class="routine-mega-plus">+</div>
          
          <div class="routine-mega-image-card">
            {% if section.settings.routine_image_3 %}
              <img src="{{ section.settings.routine_image_3 | image_url: width: 300 }}" 
                   alt="Routine Step 3" 
                   width="300" 
                   height="300" 
                   loading="lazy">
            {% else %}
              <div class="routine-mega-placeholder"></div>
            {% endif %}
          </div>
        </div>
        
        <div class="routine-mega-button-wrapper">
          <a href="{{ section.settings.routine_button_link | default: '#' }}" class="routine-mega-button">
            {{ section.settings.routine_button_text | default: 'Take the Quiz' }}
          </a>
        </div>
      </div>
    </div>

    <!-- VIP Menu -->
    <div id="menu-vip" class="mega-menu-section">
      <div class="vip-layout">
        <!-- Left Section - Text Content -->
        <div class="vip-text-section">
          <h2 class="kailasa-header-vip-title">{{ section.settings.vip_title }}</h2>
          <p class="vip-description">{{ section.settings.vip_description }}</p>
          <a href="{{ section.settings.vip_button_link | default: '#' }}" class="vip-cta-button">
            {{ section.settings.vip_button_text }}
          </a>
        </div>

        <!-- Center Section - Large Product Image -->
        <div class="vip-center-image">
          {% if section.settings.vip_center_image %}
            <a href="{{ section.settings.vip_center_image_link | default: '#' }}">
              <img src="{{ section.settings.vip_center_image | image_url: width: 500 }}" 
                   alt="{{ section.settings.vip_title }}" 
                   width="500" 
                   height="400" 
                   loading="lazy">
            </a>
          {% else %}
            <div class="vip-center-placeholder"></div>
          {% endif %}
        </div>

        <!-- Right Section - 6 Icons Grid (2x3) -->
        <div class="vip-icons-section">
          {% for i in (1..6) %}
            {% assign icon_image_key = 'vip_icon_' | append: i | append: '_image' %}
            {% assign icon_text_key = 'vip_icon_' | append: i | append: '_text' %}
            {% assign icon_link_key = 'vip_icon_' | append: i | append: '_link' %}
            {% assign icon_image = section.settings[icon_image_key] %}
            {% assign icon_text = section.settings[icon_text_key] %}
            {% assign icon_link = section.settings[icon_link_key] %}
            
            <a href="{{ icon_link | default: '#' }}" class="vip-icon-card">
              <div class="vip-icon-image">
                {% if icon_image %}
                  <img src="{{ icon_image | image_url: width: 80 }}" 
                       alt="{{ icon_text }}" 
                       width="80" 
                       height="80" 
                       loading="lazy">
                {% else %}
                  <div class="vip-icon-placeholder"></div>
                {% endif %}
              </div>
              <p class="vip-icon-text">{{ icon_text | default: 'Brightens skin' }}</p>
            </a>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- About Menu -->
    <div id="menu-about" class="mega-menu-section">
      <div class="about-cards-layout">
        {% for i in (1..3) %}
          {% assign card_image_key = 'about_card_' | append: i | append: '_image' %}
          {% assign card_title_key = 'about_card_' | append: i | append: '_title' %}
          {% assign card_description_key = 'about_card_' | append: i | append: '_description' %}
          {% assign card_link_key = 'about_card_' | append: i | append: '_link' %}
          {% assign card_image = section.settings[card_image_key] %}
          {% assign card_title = section.settings[card_title_key] %}
          {% assign card_description = section.settings[card_description_key] %}
          {% assign card_link = section.settings[card_link_key] %}
          
          <div class="about-card">
            <a href="{{ card_link | default: '#' }}" class="about-card-image-link">
              <div class="about-card-image">
                {% if card_image %}
                  <img src="{{ card_image | image_url: width: 400 }}" 
                       alt="{{ card_title }}" 
                       width="400" 
                       height="300" 
                       loading="lazy">
                {% else %}
                  <div class="about-card-placeholder"></div>
                {% endif %}
              </div>
            </a>
            <div class="about-card-content">
              <p class="about-card-title">{{ card_title | default: 'Card Title' }}</p>
              <p class="about-card-description">{{ card_description | default: 'Our goal is to change the cosmetics industry for the better. Discover our story here.' }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- Blog Menu -->
    <div id="menu-blog" class="mega-menu-section">
      <div class="blog-layout">
        <!-- Left Section - Explore Blog -->
        <div class="blog-explore-section">
          <p class="blog-section-title">Explore Blog</p>
          <ul class="blog-category-list">
            {% for i in (1..6) %}
              {% assign category_text_key = 'blog_category_' | append: i | append: '_text' %}
              {% assign category_link_key = 'blog_category_' | append: i | append: '_link' %}
              {% assign category_text = section.settings[category_text_key] %}
              {% assign category_link = section.settings[category_link_key] %}
              
              <li class="blog-category-item">
                <a href="{{ category_link | default: '#' }}" class="blog-category-link">
                  {{ category_text | default: 'Category' }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>

        <!-- Middle Section - Latest from the Blog -->
        <div class="blog-latest-section">
          <p class="blog-section-title">Latest from the Blog</p>
          <div class="blog-latest-articles">
            {% for i in (1..2) %}
              {% assign article_image_key = 'blog_latest_' | append: i | append: '_image' %}
              {% assign article_title_key = 'blog_latest_' | append: i | append: '_title' %}
              {% assign article_category_key = 'blog_latest_' | append: i | append: '_category' %}
              {% assign article_read_time_key = 'blog_latest_' | append: i | append: '_read_time' %}
              {% assign article_link_key = 'blog_latest_' | append: i | append: '_link' %}
              {% assign article_image = section.settings[article_image_key] %}
              {% assign article_title = section.settings[article_title_key] %}
              {% assign article_category = section.settings[article_category_key] %}
              {% assign article_read_time = section.settings[article_read_time_key] %}
              {% assign article_link = section.settings[article_link_key] %}
              
              <div class="blog-article-card">
                <a href="{{ article_link | default: '#' }}" class="blog-article-image-link">
                  <div class="blog-article-image">
                    {% if article_image %}
                      <img src="{{ article_image | image_url: width: 150 }}" 
                           alt="{{ article_title }}" 
                           width="150" 
                           height="150" 
                           loading="lazy">
                    {% else %}
                      <div class="blog-article-placeholder"></div>
                    {% endif %}
                  </div>
                </a>
                <div class="blog-article-content">
                  <a href="{{ article_link | default: '#' }}" class="blog-article-title-link">
                    <h4 class="blog-article-title">{{ article_title | default: 'Article Title' }}</h4>
                  </a>
                  <p class="blog-article-meta">
                    {{ article_category | default: 'Category' }} • {{ article_read_time | default: '5 min read' }}
                  </p>
                </div>
              </div>
            {% endfor %}
          </div>
          <div class="blog-read-article-wrapper">
            <a href="{{ section.settings.blog_read_article_link | default: '#' }}" class="blog-read-article-button">
              {{ section.settings.blog_read_article_text | default: 'Read Article' }}
            </a>
          </div>
        </div>

        <!-- Right Section - Editor's Pick -->
        <div class="blog-editors-pick-section">
          <p class="blog-section-title">Editor's Pick</p>
          <a href="{{ section.settings.blog_editors_pick_link | default: '#' }}" class="blog-editors-pick-card">
            <div class="blog-editors-pick-image">
              {% if section.settings.blog_editors_pick_image %}
                <img src="{{ section.settings.blog_editors_pick_image | image_url: width: 400 }}" 
                     alt="{{ section.settings.blog_editors_pick_title }}" 
                     width="400" 
                     height="200" 
                     loading="lazy">
              {% else %}
                <div class="blog-editors-pick-placeholder"></div>
              {% endif %}
            </div>
            <div class="blog-editors-pick-content">
              <h4 class="blog-editors-pick-title">{{ section.settings.blog_editors_pick_title | default: 'Supplements vs Nutrition: What Matters?' }}</h4>
              <p class="blog-editors-pick-description">{{ section.settings.blog_editors_pick_description | default: 'Discover the key differences for optimal health' }}</p>
            </div>
          </a>
        </div>
      </div>
    </div>

  </div>
</div>
</div>

<style>
  /* Prevent horizontal scrollbar */
  html, body {
    overflow-x: clip;
    max-width: 100%;
  }

  .announcement-bar {
    text-align: center;
    padding: 8px 0;
    font-size: 14px;
    font-weight: 500;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
  }

  .announcement-content {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .header-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 101;   
    background: white;
    border-bottom: 1px solid #e5e5e5;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    transition: transform 0.3s ease-in-out;
    transform: translateY(0);
  }

  .header-wrapper.header-hidden {
    transform: translateY(-100%);
  }

  header {
    border-bottom: 1px solid #d1d1d1;
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    padding: 15px 20px;
    white-space: nowrap;
    background: white;
  }

  .logo {
    flex: 0 0 auto;
    margin-left: -50px;
  }

  .logo h1 {
    margin: 0;
    color: #333;
    font-size: 28px;
    font-weight: 700;
  }

  .main-navigation {
    flex: 1;
    display: flex;
    justify-content: flex-start;
    margin-left: 350px;
  }

  .nav-list {
    display: flex;
    list-style: none; 
    margin: 0;
    padding: 0;
    gap: 35px;
  }

  .nav-item {
    position: relative;
    flex: 0 0 auto;
  }

  .nav-item a {
    text-decoration: none;
    color: #181818;
    font-size: 16px;
    font-weight: 500;
    padding: 10px 0;
    display: block;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .nav-item a:hover {
    color: #181818;
  }

  .nav-item.active::after {
    content: '';
    position: absolute;
    {% comment %} bottom: -3px; {% endcomment %}
    left: 0;
    right: 0;
    height: 3px;
    background-color: #4fffff;
    transition: all 0.3s ease;
  }

  .header-icons {
    display: flex;
    gap: 15px;
    align-items: center;
    flex: 0 0 auto;
    margin-left: 80px;
  }

  .icon-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    border-radius: 4px;
    color: #333;
  }

  /* Manual Icon Size Control - Change width and height values to increase/decrease icon size */
  .icon-btn svg {
    width: 24px !important;
    height: 24px !important;
  }

  /* Manual Logo Size Control - Change font-size value to increase/decrease logo size */
  .logo h1 {
    margin: 0;
    color: #181818;
    font-size: 40px !important; /* Change this value: 28px = default, 36px = larger, 24px = smaller */
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .header-container {
      padding: 10px 15px;
    }
    
    .nav-list {
      gap: 20px;
    }
    
    .nav-item a {
      font-size: 14px;
    }
    
    .logo h1 {
      font-size: 24px;
    }
  }

  /* Mega Menu Plain White Box */
  .mega-menu-box {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    height: auto;
    min-height: 460px;
    max-height: 500px;
    background: #ffffff;
    border: none;
