<script>
  let currentIndex = 0;
  let doctorCards = [];
  let isAnimating = false;

  function updateMainCard(cardData) {
    const mainImage = document.getElementById('mainDoctorImage');
    const mainPlaceholder = document.getElementById('mainPlaceholder');
    const mainName = document.getElementById('mainDoctorName');
    const mainSpecialty = document.getElementById('mainDoctorSpecialty');
    const mainRating = document.getElementById('mainRating');
    const mainQuote = document.getElementById('mainDoctorQuote');
    const mainExperience = document.getElementById('mainExperience');
    const currentDoctorName = document.getElementById('currentDoctorName');

    const cardImage = cardData.querySelector('.card-bg-image');

    if (cardImage) {
      if (mainImage) { mainImage.src = cardImage.src; mainImage.alt = cardImage.alt; mainImage.style.display = 'block'; }
      if (mainPlaceholder) mainPlaceholder.style.display = 'none';
    } else {
      if (mainImage) mainImage.style.display = 'none';
      if (mainPlaceholder) mainPlaceholder.style.display = 'flex';
    }

    const name = cardData.querySelector('.doctor-name')?.textContent || '';
    const specialty = cardData.querySelector('.doctor-specialty')?.textContent || '';
    const rating = cardData.querySelector('.rating')?.innerHTML || '';
    const quote = cardData.querySelector('.doctor-quote')?.textContent || '';
    const experience = cardData.querySelector('.experience')?.textContent || '';

    if (mainName) mainName.textContent = name;
    if (mainSpecialty) mainSpecialty.textContent = specialty;
    if (mainRating) mainRating.innerHTML = rating;
    if (mainQuote) mainQuote.textContent = quote;
    if (mainExperience) {
      const parts = experience.split('•').map(p => p.trim()).filter(Boolean);
      mainExperience.innerHTML = parts.map(p => `<div class="main-exp-pill">${p}</div>`).join('');
    }
    if (currentDoctorName) currentDoctorName.textContent = name;
  }

  function positionCardsStatic() {
    doctorCards.forEach((card) => {
      card.style.display = 'none';
      card.style.width = '{{ section.settings.right_card_width | default: 70 }}%';
    });

    let cascadeIndex = 0;
    const totalCards = doctorCards.length;

    for (let i = 1; i < totalCards; i++) {
      const cardIndex = (currentIndex + i) % totalCards;
      const card = doctorCards[cardIndex];
      card.style.display = 'block';
      card.style.transform = `translateY(${cascadeIndex * 8}px) translateX(${cascadeIndex * 40}px)`;
      card.style.opacity = 1;
      card.style.zIndex = 10 - cascadeIndex;
      card.style.transition = 'all 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
      cascadeIndex++;
    }
  }

  function updateDisplay(animate) {
    if (doctorCards.length === 0) return;
    if (animate) {
      animateCardSlide();
    } else {
      updateMainCard(doctorCards[currentIndex]);
      positionCardsStatic();
    }
  }

  function animateCardSlide() {
    if (isAnimating) return;
    isAnimating = true;

    const newMainCard = doctorCards[currentIndex];
    const heroCard = document.getElementById('mainHeroCard');
    const heroSection = document.querySelector('.hero-section');
    const animationDuration = {{ section.settings.card_animation_duration | default: 600 }};

    const ctaButton = document.querySelector('.cta-button-doctor-endo');
    if (ctaButton) { ctaButton.style.pointerEvents = 'none'; ctaButton.style.opacity = '0.8'; }
    doctorCards.forEach((card) => { card.style.pointerEvents = 'none'; });

    const incomingCard = newMainCard.cloneNode(true);
    incomingCard.style.cssText = `position:absolute;top:${heroCard.offsetTop}px;left:${heroCard.offsetLeft + heroCard.offsetWidth + 30}px;width:${heroCard.offsetWidth}px;height:${heroCard.offsetHeight}px;aspect-ratio:5.5/3;z-index:1001;border-radius:32px;transition:all ${animationDuration}ms cubic-bezier(0.25,0.46,0.45,0.94);box-shadow:none;`;

    const outgoingCard = heroCard.cloneNode(true);
    outgoingCard.style.cssText = `position:absolute;top:${heroCard.offsetTop}px;left:${heroCard.offsetLeft}px;width:${heroCard.offsetWidth}px;height:${heroCard.offsetHeight}px;aspect-ratio:5.5/3;z-index:999;border-radius:32px;transition:all ${animationDuration}ms cubic-bezier(0.25,0.46,0.45,0.94);box-shadow:none;`;

    heroSection.appendChild(incomingCard);
    heroSection.appendChild(outgoingCard);
    heroCard.style.opacity = '0';

    setTimeout(() => {
      incomingCard.style.left = heroCard.offsetLeft + 'px';
      outgoingCard.style.left = Math.max(0, heroCard.offsetLeft - heroCard.offsetWidth - 30) + 'px';
      outgoingCard.style.opacity = '0.7';
    }, 60);

    setTimeout(() => {
      updateMainCard(newMainCard);
      heroCard.style.opacity = '1';
      if (incomingCard.parentNode) incomingCard.parentNode.removeChild(incomingCard);
      if (outgoingCard.parentNode) outgoingCard.parentNode.removeChild(outgoingCard);
      positionCardsStatic();
      if (ctaButton) { ctaButton.style.pointerEvents = 'auto'; ctaButton.style.opacity = '1'; }
      doctorCards.forEach((card) => { card.style.pointerEvents = 'auto'; });
      isAnimating = false;
    }, animationDuration + 60);
  }

  function nextCard() {
    if (doctorCards.length === 0) return;
    currentIndex = (currentIndex + 1) % doctorCards.length;
    updateDisplay(true);
  }

  function goToCard(targetIndex) {
    if (doctorCards.length === 0 || targetIndex === currentIndex) return;
    currentIndex = targetIndex;
    updateDisplay(true);
  }

  document.addEventListener('DOMContentLoaded', function () {
    doctorCards = Array.from(document.querySelectorAll('.doctor-card'));
    doctorCards.forEach((card, index) => {
      card.addEventListener('click', () => { goToCard(index); });
    });
    if (doctorCards.length > 0) updateDisplay(false);
  });

  window.addEventListener('resize', function () { updateDisplay(false); });

  // Tablet Slider Logic
  (function () {
    var track = document.getElementById('tabletCardsTrack');
    var dots = document.querySelectorAll('.tablet-dot');
    if (!track || !dots.length) return;

    function getActiveIndex() {
      var cards = track.querySelectorAll('.tablet-doctor-card');
      if (!cards.length) return 0;
      var trackLeft = track.getBoundingClientRect().left;
      var closest = 0, minDist = Infinity;33  
      cards.forEach(function (card, i) {
        var dist = Math.abs(card.getBoundingClientRect().left - trackLeft);
        if (dist < minDist) { minDist = dist; closest = i; }
      });
      return closest;
    }

    function updateDots(index) {
      dots.forEach(function (dot, i) {
        dot.classList.toggle('active', i === index);
      });
    }

    track.addEventListener('scroll', function () {
      updateDots(getActiveIndex());
    }, { passive: true });

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        var idx = parseInt(dot.getAttribute('data-tablet-dot-index'), 10);
        var cards = track.querySelectorAll('.tablet-doctor-card');
        if (cards[idx]) {
          cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
        }
      });
    });
  })();

  // Mobile Slider Logic
  (function () {
    var track = document.getElementById('mobileCardsTrack');
    var dots = document.querySelectorAll('.mobile-dot');
    if (!track || !dots.length) return;

    function getActiveIndex() {
      var cards = track.querySelectorAll('.mobile-doctor-card');
      if (!cards.length) return 0;
      var trackLeft = track.getBoundingClientRect().left;
      var closest = 0, minDist = Infinity;
      cards.forEach(function (card, i) {
        var dist = Math.abs(card.getBoundingClientRect().left - trackLeft);
        if (dist < minDist) { minDist = dist; closest = i; }
      });
      return closest;
    }

    function updateDots(index) {
      dots.forEach(function (dot, i) {
        dot.classList.toggle('active', i === index);
      });
    }

    track.addEventListener('scroll', function () {
      updateDots(getActiveIndex());
    }, { passive: true });

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        var idx = parseInt(dot.getAttribute('data-dot-index'), 10);
        var cards = track.querySelectorAll('.mobile-doctor-card');
        if (cards[idx]) {
          cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
        }
      });
    });
  })();
</script>

