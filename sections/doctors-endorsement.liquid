{% comment %}
  Luxury Skincare Doctor Endorsement Section
  60% left main card, 40% right cascading cards with doctor details
{% endcomment %}

<section class="doctor-endorsement-section full-width">
  <div class="container">

    <!-- Desktop Layout -->
    <div class="endorsement-layout">
      <!-- Left Side: Main Hero Card (70%) -->
      <div class="hero-section">
        <div class="hero-card" id="mainHeroCard">
          {% assign current_block = section.blocks.first %}
          {% if current_block.settings.doctor_image %}
            <img
              src="{{ current_block.settings.doctor_image | image_url: width: 800, height: 600 }}"
              alt="{{ current_block.settings.doctor_name }}"
              class="doctor-image"
              width="800"
              height="600"
              loading="lazy"
              id="mainDoctorImage"
            >
          {% else %}
            <div class="placeholder-content" id="mainPlaceholder">
              <div class="placeholder-icon"></div>
            </div>
          {% endif %}

          <div class="main-card-overlay-content">
            <div class="main-doctor-info">
              <h3 class="main-doctor-name" id="mainDoctorName">
                {{ current_block.settings.doctor_name | default: 'Dr. Sarah Johnson' }}
              </h3>
              <p class="main-doctor-specialty" id="mainDoctorSpecialty">
                {{ current_block.settings.specialty | default: 'Dermatologist' }}
              </p>
              {% if current_block.settings.rating %}
                <div class="main-rating" id="mainRating">
                  {% assign rating = current_block.settings.rating | times: 1 %}
                  {% for i in (1..5) %}
                    <span class="star {% if i <= rating %}filled{% endif %}">★</span>
                  {% endfor %}
                  <span class="rating-text">({{ current_block.settings.rating }}/5)</span>
                </div>
              {% endif %}
              {% if current_block.settings.quote %}
                <blockquote class="main-doctor-quote" id="mainDoctorQuote">
                  "{{ current_block.settings.quote }}"
                </blockquote>
              {% endif %}
              {% if current_block.settings.experience %}
                <div class="main-experience-pills" id="mainExperience">
                  {% assign exp_parts = current_block.settings.experience | split: '•' %}
                  {% for part in exp_parts limit: 3 %}
                    <div class="main-exp-pill">{{ part | strip }}</div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <!-- Right Side: Cascading Cards (30%) -->
      <div class="cascading-cards-section">
        <div class="cards-stack" id="cardsStack">
          {% for block in section.blocks limit: 5 %}
            <div class="doctor-card" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              {% if block.settings.doctor_image %}
                <img
                  src="{{ block.settings.doctor_image | image_url: width: 400, height: 300 }}"
                  alt="{{ block.settings.doctor_name }}"
                  class="card-bg-image"
                  width="400"
                  height="300"
                  loading="lazy"
                >
                <div class="card-overlay-content">
                  <div class="doctor-info">
                    <h3 class="doctor-name">{{ block.settings.doctor_name | default: 'Dr. Name' }}</h3>
                    <p class="doctor-specialty">{{ block.settings.specialty | default: 'Specialty' }}</p>
                    {% if block.settings.rating %}
                      <div class="rating">
                        {% assign rating = block.settings.rating | times: 1 %}
                        {% for i in (1..5) %}
                          <span class="star {% if i <= rating %}filled{% endif %}">★</span>
                        {% endfor %}
                        <span class="rating-text">({{ block.settings.rating }}/5)</span>
                      </div>
                    {% endif %}
                    {% if block.settings.quote %}
                      <blockquote class="doctor-quote">"{{ block.settings.quote }}"</blockquote>
                    {% endif %}
                    {% if block.settings.experience %}
                      <p class="experience">{{ block.settings.experience }}</p>
                    {% endif %}
                  </div>
                </div>
              {% else %}
                <div class="card-placeholder-empty">
                  <span class="upload-text"></span>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- Desktop CTA -->
    <div class="cta-section">
      <div class="cta-pill">
        <span class="current-doctor-name" id="currentDoctorName">
          {{- section.blocks.first.settings.doctor_name | default: 'Dr. Sarah Johnson' -}}
        </span>
        <button class="cta-button-doctor-endo" onclick="nextCard()" aria-label="Next doctor">
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Tablet Slider (shown only on tablet via CSS) -->
    <div class="tablet-slider-wrapper">
      <div class="tablet-cards-track" id="tabletCardsTrack">
        {% for block in section.blocks limit: 5 %}
          {% assign rating_val = block.settings.rating | times: 1 %}
          {% assign cred_parts = block.settings.experience | split: '•' %}
          <div class="tablet-doctor-card" data-tablet-index="{{ forloop.index0 }}">
            {% if block.settings.doctor_image %}
              <img
                src="{{ block.settings.doctor_image | image_url: width: 900, height: 600 }}"
                alt="{{ block.settings.doctor_name }}"
                class="tablet-card-img"
                width="900"
                height="600"
                loading="lazy"
              >
            {% else %}
              <div class="tablet-card-placeholder"></div>
            {% endif %}

            <div class="tablet-card-content">
              {% if block.settings.specialty %}
                <div class="tablet-specialty-tag">
                  <span class="tablet-tag-plus">+</span>
                  {{ block.settings.specialty | upcase }}
                </div>
              {% endif %}

              <h3 class="tablet-doctor-name">{{ block.settings.doctor_name | default: 'Dr. Name' }}</h3>
              <p class="tablet-doctor-specialty">{{ block.settings.specialty | default: 'Specialty' }}</p>

              {% if block.settings.rating %}
                <div class="tablet-rating">
                  {% for i in (1..5) %}
                    <span class="tablet-star {% if i <= rating_val %}filled{% endif %}">★</span>
                  {% endfor %}
                  <span class="tablet-rating-text">({{ block.settings.rating }}/5)</span>
                </div>
              {% endif %}

              {% if block.settings.quote %}
                <p class="tablet-quote">"{{ block.settings.quote }}"</p>
              {% endif %}

              {% if block.settings.experience %}
                <div class="tablet-credentials">
                  {% for part in cred_parts limit: 2 %}
                    <div class="tablet-cred-item">
                      <svg class="tablet-cred-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/>
                        <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                      </svg>
                      <span>{{ part | strip }}</span>
                    </div>
                    {% unless forloop.last %}<div class="tablet-cred-divider"></div>{% endunless %}
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="tablet-dots" id="tabletDots">
        {% for block in section.blocks limit: 5 %}
          <button
            class="tablet-dot {% if forloop.first %}active{% endif %}"
            data-tablet-dot-index="{{ forloop.index0 }}"
            aria-label="Go to doctor {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    </div>

    <!-- Mobile Slider (shown only on mobile via CSS) -->
    <div class="mobile-slider-wrapper">
      <div class="mobile-cards-track" id="mobileCardsTrack">
        {% for block in section.blocks limit: 5 %}
          {% assign rating_val = block.settings.rating | times: 1 %}
          <div class="mobile-doctor-card" data-mobile-index="{{ forloop.index0 }}">
            {% if block.settings.doctor_image %}
              <img
                src="{{ block.settings.doctor_image | image_url: width: 600, height: 800 }}"
                alt="{{ block.settings.doctor_name }}"
                class="mobile-card-img"
                width="600"
                height="800"
                loading="lazy"
              >
            {% else %}
              <div class="mobile-card-placeholder"></div>
            {% endif %}

            <div class="mobile-card-overlay">
              <h3 class="mobile-doctor-name">{{ block.settings.doctor_name | default: 'Dr. Name' }}</h3>
              <p class="mobile-doctor-specialty">{{ block.settings.specialty | default: 'Specialty' }}</p>

              {% if block.settings.rating %}
                <div class="mobile-rating">
                  {% for i in (1..5) %}
                    <span class="mobile-star {% if i <= rating_val %}filled{% endif %}">★</span>
                  {% endfor %}
                  <span class="mobile-rating-text">({{ block.settings.rating }}/5)</span>
                </div>
              {% endif %}

              {% if block.settings.quote %}
                <p class="mobile-quote">"{{ block.settings.quote }}"</p>
              {% endif %}

              {% if block.settings.experience %}
                <div class="mobile-credentials">
                  {% assign cred_parts = block.settings.experience | split: '•' %}
                  {% for part in cred_parts limit: 2 %}
                    <div class="mobile-cred-pill">{{ part | strip }}</div>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="mobile-dots" id="mobileDots">
        {% for block in section.blocks limit: 5 %}
          <button
            class="mobile-dot {% if forloop.first %}active{% endif %}"
            data-dot-index="{{ forloop.index0 }}"
            aria-label="Go to doctor {{ forloop.index }}"
          ></button>
        {% endfor %}
      </div>
    </div>

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap');

  .doctor-endorsement-section {
    padding: 80px 0;
    background: #ffffff;
    font-family: 'Montserrat', sans-serif;
    overflow-x: hidden;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    margin-left: {{ section.settings.left_margin | default: 6 }}%;
    overflow-x: hidden;
  }

  /* ---- Desktop Layout ---- */
  .endorsement-layout {
    display: grid;
    grid-template-columns: 70% 30%;
    gap: {{ section.settings.cards_gap | default: 20 }}px;
    align-items: flex-start;
    margin-bottom: 20px;
    position: relative;
  }

  .hero-section {
    width: 100%;
    margin-left: {{ section.settings.main_card_left_position | default: 5 }}%;
  }

  .hero-card {
    border-radius: {{ section.settings.main_card_border_radius | default: 32 }}px;
    aspect-ratio: 5.5/3;
    overflow: hidden;
    position: relative;
  }

  .doctor-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 32px;
  }

  .placeholder-content {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #ffffff;
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
  }

  .main-card-overlay-content {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 32px 28px 24px;
    color: {{ section.settings.text_color | default: '#ffffff' }};
  }

  .main-doctor-info { text-align: left; }

  .main-doctor-name {
    font-size: 1.9rem;
    font-weight: 700;
    margin: 0 0 1px 0;
    letter-spacing: -0.02em;
    color: #ffffff;
    line-height: 1.05;
    font-family: 'Montserrat', sans-serif;
  }

  .main-doctor-specialty {
    font-size: {{ section.settings.main_specialty_size | default: 0.95 }}rem;
    color: {{ section.settings.specialty_color | default: '#00d4aa' }};
    margin: 0 0 6px 0;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
  }

  .main-rating {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-bottom: 5px;
  }

  .main-rating .star { font-size: 1rem; color: #333; }
  .main-rating .star.filled {
    color: {{ section.settings.star_color | default: '#ffd700' }};
    filter: drop-shadow(0 1px 3px rgba(255,215,0,0.4));
  }

  .main-rating .rating-text {
    font-size: 0.85rem;
    color: #ffffff;
    margin-left: 6px;
    font-weight: 500;
  }

  .main-doctor-quote {
    font-size: 17px;
    line-height: 1.2;
    font-style: italic;
    margin: 0 0 6px 0;
    color: #ffffff;
    font-weight: 500;
    font-family: 'Montserrat', sans-serif;
  }

  .main-experience-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .main-exp-pill {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50px;
    padding: 6px 14px;
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    color: #ffffff;
    font-weight: 600;
    white-space: nowrap;
  }

  .cascading-cards-section {
    width: 100%;
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    padding-top: {{ section.settings.right_card_vertical_gap | default: 20 }}px;
    padding-bottom: {{ section.settings.right_card_vertical_gap | default: 20 }}px;
    overflow: hidden;
  }

  .cards-stack {
    position: relative;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
    min-height: 400px;
  }

  .doctor-card {
    position: absolute;
    border-radius: {{ section.settings.right_card_border_radius | default: 32 }}px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    width: {{ section.settings.right_card_width | default: 70 }}%;
    aspect-ratio: {{ section.settings.right_card_aspect_width | default: 2.5 }}/{{ section.settings.right_card_aspect_height | default: 4 }};
  }

  .doctor-card .card-bg-image {
    width: 100%; height: 100%;
    object-fit: cover;
    position: absolute; top: 0; left: 0;
  }

  .doctor-card .card-overlay-content {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 20px 16px 16px;
    color: {{ section.settings.text_color | default: '#ffffff' }};
  }

  .doctor-card .doctor-info { text-align: left; }

  .doctor-card .doctor-name {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 2px 0;
    color: #ffffff;
    line-height: 1.1;
  }

  .doctor-card .doctor-specialty {
    font-size: 0.7rem;
    color: {{ section.settings.specialty_color | default: '#4fffff' }};
    margin: 0 0 6px 0;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .doctor-card .rating {
    display: flex;
    align-items: center;
    gap: 1px;
    margin-bottom: 6px;
  }

  .doctor-card .star { font-size: 0.75rem; color: #333; }
  .doctor-card .star.filled { color: {{ section.settings.star_color | default: '#ffd700' }}; }

  .doctor-card .rating-text {
    font-size: 0.6rem;
    color: #ffffff;
    margin-left: 3px;
    font-weight: 500;
  }

  .doctor-card .doctor-quote {
    font-size: 0.65rem;
    line-height: 1.2;
    font-style: italic;
    margin: 0 0 4px 0;
    color: #ffffff;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .doctor-card .experience {
    font-size: 0.55rem;
    color: #cccccc;
    margin: 0;
    font-weight: 500;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-placeholder-empty {
    width: 100%; height: 100%;
    background: transparent;
    border: 2px dashed {{ section.settings.placeholder_border | default: '#cccccc' }};
    border-radius: {{ section.settings.right_card_border_radius | default: 32 }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: absolute; top: 0; left: 0;
  }

  /* CTA */
  .cta-section {
    display: flex;
    justify-content: flex-start;
    padding-left: calc(70% / 2 - 120px);
  }

  .cta-pill {
    display: flex;
    align-items: center;
    background: {{ section.settings.pill_bg_color | default: '#ffffff' }};
    border: {{ section.settings.pill_border_width | default: 2 }}px solid {{ section.settings.pill_border_color | default: '#4fffff' }};
    border-radius: {{ section.settings.pill_border_radius | default: 50 }}px;
    padding: {{ section.settings.pill_padding_vertical | default: 8 }}px {{ section.settings.pill_padding_horizontal | default: 16 }}px;
    gap: {{ section.settings.name_button_gap | default: 15 }}px;
    transition: all 0.3s ease;
    min-width: {{ section.settings.pill_min_width | default: 280 }}px;
    max-width: {{ section.settings.pill_max_width | default: 400 }}px;
    box-shadow: {{ section.settings.pill_shadow | default: '0 4px 12px rgba(0,188,212,0.2)' }};
  }

  .cta-pill:hover {
    border-color: {{ section.settings.pill_hover_border_color | default: '#00acc1' }};
    transform: translateY(-2px);
    box-shadow: {{ section.settings.pill_hover_shadow | default: '0 6px 20px rgba(0,188,212,0.3)' }};
  }

  .current-doctor-name {
    font-size: {{ section.settings.doctor_name_font_size | default: 18 }}px;
    font-weight: {{ section.settings.doctor_name_font_weight | default: 600 }};
    color: {{ section.settings.doctor_name_color | default: '#1a1a1a' }};
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cta-button-doctor-endo {
    width: {{ section.settings.cta_button_size | default: 35 }}px;
    height: {{ section.settings.cta_button_size | default: 35 }}px;
    background: {{ section.settings.cta_bg_color | default: '#000000' }};
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .cta-button-doctor-endo:hover {
    background: {{ section.settings.cta_hover_color | default: '#4fffff' }};
    transform: scale({{ section.settings.cta_hover_scale | default: 1.1 }});
  }

  .arrow-icon {
    width: {{ section.settings.arrow_icon_size | default: 20 }}px;
    height: {{ section.settings.arrow_icon_size | default: 20 }}px;
    color: {{ section.settings.arrow_icon_color | default: '#ffffff' }};
  }

  /* =============================================
     TABLET SLIDER - hidden on mobile and desktop
     ============================================= */
  .tablet-slider-wrapper {
    display: none;
  }

  .tablet-cards-track {
    display: flex;
    overflow-x: scroll;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-left: 5%;
    padding-right: 20px;
    gap: {{ section.settings.tablet_cards_gap | default: 16 }}px;
  }

  .tablet-cards-track::-webkit-scrollbar { display: none; }

  .tablet-doctor-card {
    flex: 0 0 {{ section.settings.tablet_card_width_vw | default: 78 }}vw;
    max-width: 560px;
    scroll-snap-align: start;
    border-radius: {{ section.settings.tablet_card_border_radius | default: 28 }}px;
    overflow: hidden;
    position: relative;
    aspect-ratio: 16/10;
    background: #1a1a1a;
    font-family: 'Montserrat', sans-serif;
    box-shadow: 0 4px 24px rgba(0,0,0,0.15);
    flex-shrink: 0;
  }

  .tablet-card-img {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .tablet-card-placeholder {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: #2a2a2a;
  }

  .tablet-card-content {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    padding: 28px 24px 22px 24px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: linear-gradient(transparent 0%, rgba(0,0,0,0.15) 50%, rgba(0,0,0,0.55) 100%);
    z-index: 2;
  }

  .tablet-specialty-tag { display: none; }
  .tablet-tag-plus { display: none; }

  .tablet-doctor-name {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(1.1rem, 2.8vw, 1.6rem);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 2px 0;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .tablet-doctor-specialty {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(0.6rem, 1.5vw, 0.75rem);
    font-weight: 700;
    color: {{ section.settings.specialty_color | default: '#4fffff' }};
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 6px 0;
  }
    display: flex;
    align-items: center;
    gap: 2px;
    margin-bottom: 8px;
  }

  .tablet-star {
    font-size: clamp(0.75rem, 2vw, 0.95rem);
    color: #555;
  }

  .tablet-star.filled {
    color: {{ section.settings.star_color | default: '#ffd700' }};
  }

  .tablet-rating-text {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(0.6rem, 1.5vw, 0.75rem);
    color: #ffffff;
    margin-left: 5px;
    font-weight: 500;
  }

  .tablet-quote {
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(0.65rem, 1.6vw, 0.8rem);
    font-style: italic;
    color: #ffffff;
    line-height: 1.5;
    margin: 0 0 12px 0;
    opacity: 0.95;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tablet-quote::before {
    content: '\201C';
    font-size: 1.2em;
    color: {{ section.settings.specialty_color | default: '#4fffff' }};
    font-style: normal;
    margin-right: 2px;
  }

  .tablet-credentials {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: nowrap;
  }

  .tablet-cred-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(0.58rem, 1.4vw, 0.7rem);
    color: #ffffff;
    font-weight: 600;
    white-space: nowrap;
  }

  .tablet-cred-icon {
    width: clamp(14px, 2.5vw, 20px);
    height: clamp(14px, 2.5vw, 20px);
    color: {{ section.settings.specialty_color | default: '#4fffff' }};
    flex-shrink: 0;
  }

  .tablet-cred-divider {
    width: 1px;
    height: 24px;
    background: rgba(255,255,255,0.3);
    flex-shrink: 0;
  }

  .tablet-dots {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .tablet-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d0d0d0;
    border: none;
    padding: 0;
    cursor: pointer;
