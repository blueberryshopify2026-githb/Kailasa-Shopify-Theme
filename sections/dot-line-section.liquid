      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Mobile Chapter Pill Font Size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Tablet Settings"
    },
    {
      "type": "range",
      "id": "tablet_nav_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Tablet Nav Distance From Bottom",
