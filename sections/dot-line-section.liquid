{% comment %}
  Dot Line Section - Premium full-width section with dot navigation
  Features glassmorphism UI, smooth background transitions, and responsive design
{% endcomment %}

<style>
  .dot-line-section {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    overflow: hidden;
    font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* Background Media Container */
  .background-media-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .background-media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .background-media.active {
    opacity: 1;
  }

  .background-media.dls-media-image {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .background-media.video {
    object-fit: cover;
  }

  .background-media.video-embed {
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .background-media.video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
    pointer-events: none;
  }

  /* Dot Navigation Container */
  .dot-navigation {
    position: absolute;
    bottom: 60px;
    left: 60px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }

  /* Description Container */
  {% assign glass_opacity_decimal = section.settings.glass_opacity | default: 8 | divided_by: 100.0 %}
  {% assign glass_border_opacity = glass_opacity_decimal | times: 1.5 %}
  {% assign dot_count = section.blocks.size %}
  {% comment %} Calculate exact width: container padding (48px) + inactive dots (32px each) + one active dot (232px) {% endcomment %}
  {% assign nav_padding = 48 %}
  {% assign inactive_dots_total = dot_count | minus: 1 | times: 32 %}
  {% assign active_dot_total = 232 %}
  {% assign calculated_width = nav_padding | plus: inactive_dots_total | plus: active_dot_total %}
  .description-container {
    background: {{ section.settings.glass_background_color | default: '#ffffff' | color_modify: 'alpha', glass_opacity_decimal }};
    backdrop-filter: blur({{ section.settings.glass_blur | default: 12 }}px);
    -webkit-backdrop-filter: blur({{ section.settings.glass_blur | default: 12 }}px);
    border: 1px solid {{ section.settings.glass_border_color | default: '#ffffff' | color_modify: 'alpha', glass_border_opacity }};
    border-radius: 24px;
    padding: 24px 32px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    width: {{ calculated_width }}px;
    max-width: {{ calculated_width }}px;
    min-width: {{ calculated_width }}px;
    transition: none;
  }

  .description-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    justify-content: center;
  }

  .description-title {
    font-size: 22px;
    font-weight: 700;
    color: {{ section.settings.description_title_color | default: '#1a1a1a' }};
    margin: 0;
    line-height: 1.3;
    transition: opacity 0.35s ease;
  }

  .description-text {
    font-size: 18px;
    font-weight: 500;
    color: {{ section.settings.description_text_color | default: '#4a4a4a' }};
    margin: 0;
    line-height: 1.5;
    opacity: 0.9;
    transition: opacity 0.35s ease;
  }

  /* Glassmorphism Navigation Container */
  .nav-container {
    background: {{ section.settings.glass_background_color | default: '#ffffff' | color_modify: 'alpha', glass_opacity_decimal }};
    backdrop-filter: blur({{ section.settings.glass_blur | default: 12 }}px);
    -webkit-backdrop-filter: blur({{ section.settings.glass_blur | default: 12 }}px);
    border: 1px solid {{ section.settings.glass_border_color | default: '#ffffff' | color_modify: 'alpha', glass_border_opacity }};
    border-radius: 50px;
    padding: 10px 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    position: relative;
    width: {{ calculated_width }}px;
    max-width: {{ calculated_width }}px;
    min-width: {{ calculated_width }}px;
  }

  /* Connecting Line */
  {% comment %} Calculate connecting line position: from center of first dot to center of last dot {% endcomment %}
  {% assign line_start = 24 | plus: 8 | plus: 8 %}
  {% assign line_end = 24 | plus: 8 | plus: 8 %}
  .connecting-line {
    position: absolute;
    top: 50%;
    left: {{ line_start }}px;
    right: {{ line_end }}px;
    height: 2px;
    background: linear-gradient(90deg, 
      {{ section.settings.dot_color | default: '#4FFFFF' | color_modify: 'alpha', 0.3 }} 0%, 
      {{ section.settings.dot_color | default: '#4FFFFF' | color_modify: 'alpha', 0.6 }} 50%, 
      {{ section.settings.dot_color | default: '#4FFFFF' | color_modify: 'alpha', 0.3 }} 100%);
    transform: translateY(-50%);
    z-index: 1;
  }

  /* Individual Dots */
  .nav-dot {
    position: relative;
    width: 16px !important;
    height: 16px !important;
    border-radius: 50%;
    background: {{ section.settings.dot_color | default: '#4FFFFF' | color_modify: 'alpha', 0.4 }};
    border: 2px solid {{ section.settings.dot_color | default: '#4FFFFF' | color_modify: 'alpha', 0.6 }};
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    z-index: 2;
    box-shadow: 0 2px 8px {{ section.settings.dot_color | default: '#4FFFFF' | color_modify: 'alpha', 0.2 }};
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    white-space: nowrap;
    margin: 0 8px;
  }

  .nav-dot:hover {
    transform: scale(1.2);
    background: {{ section.settings.dot_color | default: '#4FFFFF' | color_modify: 'alpha', 0.7 }};
    border-color: {{ section.settings.dot_color | default: '#4FFFFF' | color_modify: 'alpha', 0.9 }};
    box-shadow: 0 4px 16px {{ section.settings.dot_color | default: '#4FFFFF' | color_modify: 'alpha', 0.4 }};
  }

  .nav-dot.active {
    width: 200px !important;
    min-width: 200px !important;
    max-width: 200px !important;
    height: 32px !important;
    padding: 0 16px !important;
    background: rgba(255, 255, 255, 0.95) !important;
    border-color: rgba(255, 255, 255, 1) !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
    transform: scale(1) !important;
    border-radius: 16px !important;
    margin: 0 16px;
    box-sizing: border-box !important;
    transition: none !important;
  }

  .nav-dot.active:hover {
    transform: scale(1) !important;
    background: rgba(255, 255, 255, 0.98);
    width: 200px !important;
    min-width: 200px !important;
    max-width: 200px !important;
  }

  /* Dot Content */
  .dot-content {
    font-size: 12px !important;
    font-weight: 600 !important;
    color: #1a1a1a;
    opacity: 0;
    transition: opacity 0.3s ease;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
    line-height: 1.2;
  }

  .nav-dot.active .dot-content {
    opacity: 1;
  }

  /* Small Dot Labels (for inactive dots) */
  .dot-label {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-12px);
    background: {{ section.settings.glass_background_color | default: '#ffffff' | color_modify: 'alpha', glass_opacity_decimal }};
    backdrop-filter: blur({{ section.settings.glass_blur | default: 12 }}px);
    -webkit-backdrop-filter: blur({{ section.settings.glass_blur | default: 12 }}px);
    border: 1px solid {{ section.settings.glass_border_color | default: '#ffffff' | color_modify: 'alpha', glass_border_opacity }};
    border-radius: 20px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 500;
    color: {{ section.settings.dot_label_color | default: '#ffffff' }};
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
    pointer-events: none;
  }

  .dot-label::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 6px solid {{ section.settings.glass_background_color | default: '#ffffff' | color_modify: 'alpha', glass_opacity_decimal }};
  }

  /* Only show tooltip on hover for inactive dots */
  .nav-dot:not(.active):hover .dot-label {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(-16px);
  }

  /* Hide tooltip for active dots */
  .nav-dot.active .dot-label {
    display: none;
  }

  /* Loading Animation */
  .loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 5;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .loading-overlay.show {
    opacity: 1;
    visibility: visible;
  }

  .loading-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-top: 3px solid white;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  /* Responsive Design */
  {% comment %} Calculate responsive widths - exact fit {% endcomment %}
  {% assign tablet_padding = 40 %}
  {% assign tablet_inactive_total = dot_count | minus: 1 | times: 28 %}
  {% assign tablet_active_total = 188 %}
  {% assign tablet_width = tablet_padding | plus: tablet_inactive_total | plus: tablet_active_total %}
  
  {% assign mobile_padding = 32 %}
  {% assign mobile_inactive_total = dot_count | minus: 1 | times: 24 %}
  {% assign mobile_active_total = 172 %}
  {% assign mobile_width = mobile_padding | plus: mobile_inactive_total | plus: mobile_active_total %}
  
  {% assign small_mobile_padding = 32 %}
  {% assign small_mobile_inactive_total = dot_count | minus: 1 | times: 20 %}
  {% assign small_mobile_active_total = 156 %}
  {% assign small_mobile_width = small_mobile_padding | plus: small_mobile_inactive_total | plus: small_mobile_active_total %}
  
  @media (max-width: 1024px) {
    .dot-navigation {
      bottom: 40px;
      left: 40px;
    }

    .description-container {
      width: {{ tablet_width }}px;
      max-width: {{ tablet_width }}px;
      min-width: {{ tablet_width }}px;
      padding: 20px 28px;
    }

    .nav-container {
      width: {{ tablet_width }}px;
      max-width: {{ tablet_width }}px;
      min-width: {{ tablet_width }}px;
    }

    .description-title {
      font-size: 22px;
    }

    .description-text {
      font-size: 15px;
    }
  }

  @media (max-width: 768px) {
    .dot-line-section {
      height: 80vh;
      min-height: 500px;
    }

    .dot-navigation {
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%);
      align-items: center;
    }

    .description-container {
      width: {{ mobile_width }}px;
      max-width: {{ mobile_width }}px;
      min-width: {{ mobile_width }}px;
      padding: 18px 24px;
    }

    .nav-container {
      width: {{ mobile_width }}px;
      max-width: {{ mobile_width }}px;
      min-width: {{ mobile_width }}px;
      padding: 12px 16px;
    }

    .description-title {
      font-size: 20px;
    }

    .description-text {
      font-size: 14px;
    }

    .nav-dot {
      margin: 0 6px;
    }

    .nav-dot.active {
      width: 160px !important;
      height: 28px !important;
      padding: 0 12px !important;
      margin: 0 12px;
    }

    .dot-content {
      font-size: 11px !important;
    }

    .dot-label {
      font-size: 12px;
      padding: 6px 12px;
    }
  }

  @media (max-width: 480px) {
    .dot-line-section {
      height: 70vh;
      min-height: 400px;
    }

    .description-container {
      width: {{ small_mobile_width }}px;
      max-width: {{ small_mobile_width }}px;
      min-width: {{ small_mobile_width }}px;
      padding: 16px 20px;
    }

    .nav-container {
      width: {{ small_mobile_width }}px;
      max-width: {{ small_mobile_width }}px;
      min-width: {{ small_mobile_width }}px;
      padding: 10px 16px;
    }

    .description-title {
      font-size: 18px;
    }

    .description-text {
      font-size: 13px;
    }

    .nav-dot {
      margin: 0 4px;
    }

    .nav-dot.active {
      width: 140px !important;
      height: 26px !important;
      padding: 0 10px !important;
      margin: 0 8px;
    }

    .dot-content {
      font-size: 10px !important;
    }

    .connecting-line {
      left: 20px;
      right: 20px;
    }
  }

  /* Hide mobile chapter label on desktop */
  .dls-mobile-chapter-label {
    display: none;
  }

  /* Mobile-specific backgrounds: hidden on desktop */
  .dls-mobile-bg {
    display: none;
  }

  @media (max-width: 768px) {
    /* Show mobile backgrounds, hide desktop ones when mobile version exists */
    .dls-mobile-bg {
      display: block;
    }
  }

  /* =============================================
     TABLET ONLY - 769px to 1024px
     Desktop code above is NOT touched
     Mobile code below is NOT touched
     ============================================= */
  @media (min-width: 769px) and (max-width: 1024px) {

    .dot-line-section {
      height: 100vh;
      min-height: 700px;
    }

    /* Navigation anchored bottom-left, larger */
    .dot-navigation {
      bottom: {{ section.settings.tablet_nav_bottom | default: 50 }}px !important;
      left: {{ section.settings.tablet_nav_left | default: 50 }}px !important;
      gap: 20px !important;
      align-items: flex-start !important;
      transform: none !important;
      width: auto !important;
      max-width: 65vw !important;
    }

    /* Description glass box: larger text, left-aligned */
    .description-container {
      width: 60vw !important;
      max-width: 600px !important;
      min-width: 400px !important;
      padding: 32px 40px !important;
      border-radius: 24px !important;
      text-align: left !important;
      box-sizing: border-box !important;
    }

    .description-content {
      align-items: flex-start !important;
      gap: 16px !important;
    }

    .description-title {
      font-size: {{ section.settings.tablet_title_font_size | default: 30 }}px !important;
      font-weight: {{ section.settings.tablet_title_font_weight | default: '700' }} !important;
      color: {{ section.settings.tablet_title_color | default: '#1a1a1a' }} !important;
      font-style: {{ section.settings.tablet_title_font_style | default: 'normal' }} !important;
      text-align: left !important;
      line-height: 1.3 !important;
    }

    .description-text {
      font-size: {{ section.settings.tablet_desc_font_size | default: 18 }}px !important;
      font-weight: {{ section.settings.tablet_desc_font_weight | default: '400' }} !important;
      color: {{ section.settings.tablet_desc_color | default: '#4a4a4a' }} !important;
      font-style: {{ section.settings.tablet_desc_font_style | default: 'normal' }} !important;
      text-align: left !important;
      line-height: 1.6 !important;
    }

    /* Nav container: matches description width exactly so dots never overflow */
    .nav-container {
      width: 60vw !important;
      max-width: 600px !important;
      min-width: 400px !important;
      padding: 14px 24px !important;
      box-sizing: border-box !important;
      justify-content: space-between !important;
      overflow: hidden !important;
    }

    /* Dots: larger on tablet, spread evenly */
    .nav-dot {
      width: 28px !important;
      height: 28px !important;
      min-width: 28px !important;
      max-width: 28px !important;
      margin: 0 !important;
      flex-shrink: 0 !important;
      transition: none !important;
    }

    /* Active dot: fixed width, no expansion animation */
    .nav-dot.active,
    .nav-dot.active:hover {
      width: 160px !important;
      min-width: 160px !important;
      max-width: 160px !important;
      height: 36px !important;
      padding: 0 16px !important;
      margin: 0 !important;
      border-radius: 18px !important;
      transition: none !important;
      transform: none !important;
    }

    .nav-dot.active .dot-content {
      opacity: 1 !important;
    }

    .dot-content {
      font-size: {{ section.settings.tablet_dot_font_size | default: 14 }}px !important;
      color: {{ section.settings.tablet_dot_color | default: '#1a1a1a' }} !important;
    }

    .connecting-line {
      left: 24px !important;
      right: 24px !important;
    }

  }

  /* =============================================
     MOBILE ONLY - max-width: 768px
     Desktop code above is NOT touched
     ============================================= */
  @media (max-width: 768px) {

    /* Section height */
    .dot-line-section {
      height: {{ section.settings.mobile_section_height | default: 100 }}vh !important;
      min-height: 500px !important;
    }

    /* Stack dot-navigation centered at bottom */
    .dot-navigation {
      bottom: {{ section.settings.mobile_nav_bottom | default: 24 }}px !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      align-items: center !important;
      width: calc(100vw - 32px) !important;
      max-width: 420px !important;
      gap: 12px !important;
    }

    /* Description glass box: full width, centered text */
    .description-container {
      width: 100% !important;
      max-width: 100% !important;
      min-width: unset !important;
      padding: {{ section.settings.mobile_glass_padding | default: 20 }}px !important;
      border-radius: 20px !important;
      text-align: center !important;
      box-sizing: border-box !important;
    }

    .description-content {
      align-items: center !important;
      gap: 10px !important;
      width: 100% !important;
    }

    .description-title {
      font-size: {{ section.settings.mobile_title_font_size | default: 20 }}px !important;
      font-weight: 700 !important;
      text-align: center !important;
      transition: opacity 0.35s ease !important;
    }

    .description-text {
      font-size: {{ section.settings.mobile_desc_font_size | default: 14 }}px !important;
      text-align: center !important;
      transition: opacity 0.35s ease !important;
    }

    /* Nav container: full width, dots spread edge to edge */
    .nav-container {
      width: 100% !important;
      max-width: 100% !important;
      min-width: unset !important;
      padding: 14px 20px !important;
      box-sizing: border-box !important;
      justify-content: space-between !important;
    }

    /* All dots: same circle size, no transitions on mobile */
    .nav-dot,
    .nav-dot:hover {
      margin: 0 !important;
      width: 18px !important;
      height: 18px !important;
      min-width: 18px !important;
      max-width: 18px !important;
      flex-shrink: 0 !important;
      transition: none !important;
      transform: none !important;
    }

    /* Active dot: filled cyan circle */
    .nav-dot.active,
    .nav-dot.active:hover {
      width: 20px !important;
      min-width: 20px !important;
      max-width: 20px !important;
      height: 20px !important;
      padding: 0 !important;
      margin: 0 !important;
      border-radius: 50% !important;
      background: {{ section.settings.dot_color | default: '#4FFFFF' }} !important;
      border: 2px solid rgba(255, 255, 255, 0.9) !important;
      box-shadow: 0 0 8px {{ section.settings.dot_color | default: '#4FFFFF' }}80, 0 0 0 3px rgba(255, 255, 255, 0.3) !important;
      transform: none !important;
      transition: none !important;
      flex-shrink: 0 !important;
    }

    .dot-content {
      font-size: 11px !important;
    }

    /* Hide text inside active dot */
    .nav-dot.active .dot-content {
      display: none !important;
    }

    /* Chapter pill — separate element below the nav glass */
    .dls-mobile-chapter-label {
      display: flex !important;
      justify-content: center !important;
      width: 100% !important;
    }

    .dls-mobile-chapter-pill {
      background: rgba(255, 255, 255, 0.95) !important;
      border: 1px solid rgba(255, 255, 255, 0.7) !important;
      border-radius: 50px !important;
      padding: 11px 40px !important;
      font-size: {{ section.settings.mobile_chapter_font_size | default: 14 }}px !important;
      font-weight: 600 !important;
      color: #1a1a1a !important;
      font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
      white-space: nowrap !important;
      letter-spacing: 0.01em !important;
      box-shadow: 0 2px 12px rgba(0,0,0,0.08) !important;
    }

  }
</style>

<div class="dot-line-section full-width">
  <!-- Background Media Container -->
  <div class="background-media-container">
    {% for block in section.blocks %}
      {% comment %} Desktop/tablet background {% endcomment %}
      {% if block.settings.media_type == 'image' %}
        {% assign image_src = '' %}
        {% if block.settings.background_image %}
          {% assign image_src = block.settings.background_image | image_url: width: 1920, height: 1080 %}
        {% elsif block.settings.image_url != blank %}
          {% assign image_src = block.settings.image_url %}
        {% endif %}
        
        {% if image_src != blank %}
          <div class="background-media dls-media-image {% if forloop.first %}active{% endif %}" 
               data-block-id="{{ block.id }}"
               style="background-image: url('{{ image_src }}');">
          </div>
        {% else %}
          <!-- Fallback for blocks without media -->
          <div class="background-media dls-media-image {% if forloop.first %}active{% endif %}" 
               data-block-id="{{ block.id }}"
               style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
          </div>
        {% endif %}
        
      {% elsif block.settings.media_type == 'video' and block.settings.video_url != blank %}
        {% assign video_url = block.settings.video_url %}
        
        {% if video_url contains 'youtube.com' or video_url contains 'youtu.be' %}
          <!-- YouTube Video -->
          {% assign video_id = '' %}
          {% if video_url contains 'youtu.be/' %}
            {% assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first %}
          {% elsif video_url contains 'watch?v=' %}
            {% assign video_id = video_url | split: 'watch?v=' | last | split: '&' | first %}
          {% endif %}
          
          <div class="background-media video-embed {% if forloop.first %}active{% endif %}" 
               data-block-id="{{ block.id }}">
            <iframe src="https://www.youtube.com/embed/{{ video_id }}?autoplay=1&mute=1&loop=1&playlist={{ video_id }}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1"
                    frameborder="0" 
                    allow="autoplay; encrypted-media" 
                    allowfullscreen></iframe>
          </div>
          
        {% elsif video_url contains 'vimeo.com' %}
          <!-- Vimeo Video -->
          {% assign video_id = video_url | split: 'vimeo.com/' | last | split: '?' | first %}
          
          <div class="background-media video-embed {% if forloop.first %}active{% endif %}" 
               data-block-id="{{ block.id }}">
            <iframe src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1&muted=1&loop=1&background=1&controls=0"
                    frameborder="0" 
                    allow="autoplay; fullscreen" 
                    allowfullscreen></iframe>
          </div>
          
        {% else %}
          <!-- Direct Video File -->
          <video class="background-media video {% if forloop.first %}active{% endif %}" 
                 data-block-id="{{ block.id }}"
                 autoplay 
                 muted 
                 loop 
                 playsinline
                 preload="auto"
                 {% if block.settings.video_poster %}poster="{{ block.settings.video_poster | image_url: width: 1920, height: 1080 }}"{% endif %}>
            <source src="{{ video_url }}" type="video/mp4">
            Your browser does not support the video tag.
          </video>
        {% endif %}
      {% else %}
        <!-- Fallback for blocks without media -->
        <div class="background-media dls-media-image {% if forloop.first %}active{% endif %}" 
             data-block-id="{{ block.id }}"
             style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
        </div>
      {% endif %}

      {% comment %} Mobile-specific background (shown only on mobile if set) {% endcomment %}
      {% assign has_mobile_media = false %}
      {% if block.settings.mobile_background_image or block.settings.mobile_video_url != blank %}
        {% assign has_mobile_media = true %}
      {% endif %}
      {% if has_mobile_media %}
        {% if block.settings.mobile_media_type == 'video' and block.settings.mobile_video_url != blank %}
          {% assign m_url = block.settings.mobile_video_url %}
          {% if m_url contains 'youtube.com' or m_url contains 'youtu.be' %}
            {% if m_url contains 'youtu.be/' %}
              {% assign m_vid_id = m_url | split: 'youtu.be/' | last | split: '?' | first %}
            {% else %}
              {% assign m_vid_id = m_url | split: 'watch?v=' | last | split: '&' | first %}
            {% endif %}
            <div class="background-media video-embed dls-mobile-bg {% if forloop.first %}active{% endif %}"
                 data-block-id="{{ block.id }}" data-mobile="true">
              <iframe src="https://www.youtube.com/embed/{{ m_vid_id }}?autoplay=1&mute=1&loop=1&playlist={{ m_vid_id }}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1"
                      frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
            </div>
          {% elsif m_url contains 'vimeo.com' %}
            {% assign m_vid_id = m_url | split: 'vimeo.com/' | last | split: '?' | first %}
            <div class="background-media video-embed dls-mobile-bg {% if forloop.first %}active{% endif %}"
                 data-block-id="{{ block.id }}" data-mobile="true">
              <iframe src="https://player.vimeo.com/video/{{ m_vid_id }}?autoplay=1&muted=1&loop=1&background=1&controls=0"
                      frameborder="0" allow="autoplay; fullscreen" allowfullscreen></iframe>
            </div>
          {% else %}
            <video class="background-media dls-media-video dls-mobile-bg {% if forloop.first %}active{% endif %}"
                   data-block-id="{{ block.id }}" data-mobile="true"
                   autoplay muted loop playsinline preload="auto"
                   {% if block.settings.mobile_video_poster %}poster="{{ block.settings.mobile_video_poster | image_url: width: 800, height: 1200 }}"{% endif %}>
              <source src="{{ m_url }}" type="video/mp4">
            </video>
          {% endif %}
        {% elsif block.settings.mobile_background_image %}
          <div class="background-media dls-media-image dls-mobile-bg {% if forloop.first %}active{% endif %}"
               data-block-id="{{ block.id }}" data-mobile="true"
               style="background-image: url('{{ block.settings.mobile_background_image | image_url: width: 800, height: 1200 }}');">
          </div>
        {% endif %}
      {% endif %}

    {% endfor %}
  </div>

  <!-- Dot Navigation -->
  {% if section.blocks.size > 0 %}
    <div class="dot-navigation">
      <!-- Description Container -->
      {% assign active_block = section.blocks.first %}
      {% for block in section.blocks %}
        {% if forloop.first %}
          {% assign active_block = block %}
        {% endif %}
      {% endfor %}
      
      <div class="description-container" id="description-container">
        <div class="description-content">
          <h3 class="description-title" id="description-title">
            {% if active_block.settings.content_title != blank %}
              {{ active_block.settings.content_title }}
            {% endif %}
          </h3>
          <p class="description-text" id="description-text">
            {% if active_block.settings.content_description != blank %}
              {{ active_block.settings.content_description }}
            {% endif %}
          </p>
        </div>
      </div>

      <!-- Navigation Container -->
      <div class="nav-container">
        <div class="connecting-line"></div>
        {% for block in section.blocks %}
          <div class="nav-dot {% if forloop.first %}active{% endif %}" 
               data-block-id="{{ block.id }}"
               data-index="{{ forloop.index0 }}"
               data-title="{{ block.settings.content_title }}"
               data-description="{{ block.settings.content_description }}">
            <div class="dot-content">
              {{ block.settings.dot_label }}
            </div>
            {% if block.settings.dot_label != blank %}
              <div class="dot-label">{{ block.settings.dot_label }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <!-- Mobile Chapter Label (hidden on desktop via CSS) -->
      <div class="dls-mobile-chapter-label" id="dls-mobile-chapter-label">
        <span class="dls-mobile-chapter-pill" id="dls-mobile-chapter-pill">
          {{ section.blocks.first.settings.dot_label }}
        </span>
      </div>


    </div>
  {% endif %}

  <!-- Loading Overlay -->
  <div class="loading-overlay">
    <div class="loading-spinner"></div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const section = document.querySelector('.dot-line-section');
    if (!section) return;

    const dots = section.querySelectorAll('.nav-dot');
    const backgroundMedia = section.querySelectorAll('.background-media');
    const loadingOverlay = section.querySelector('.loading-overlay');

    let currentActiveIndex = 0;
    let isTransitioning = false;
    
    // ── Mobile dot style helper ───────────────────────────────────
    function isMobileDot() { return window.innerWidth <= 768; }
    function isTabletDot() { return window.innerWidth >= 769 && window.innerWidth <= 1024; }

    function resetDotStylesForMobile() {
      if (!isMobileDot() && !isTabletDot()) return;
      dots.forEach(dot => {
        dot.removeAttribute('style');
        dot.style.transition = 'none';
      });
    }
    // ── End helper ────────────────────────────────────────────────

    // Preload images for smooth transitions
    function preloadImages() {
      backgroundMedia.forEach(media => {
        if (media.classList.contains('dls-media-image')) {
          const img = new Image();
          const bgImage = media.style.backgroundImage;
          const url = bgImage.slice(4, -1).replace(/"/g, "");
          img.src = url;
        }
      });
    }

    // Switch active background
    function switchBackground(targetIndex) {
      if (isTransitioning || targetIndex === currentActiveIndex) return;

      isTransitioning = true;
      loadingOverlay.classList.add('show');

      const safetyTimeout = setTimeout(() => {
        loadingOverlay.classList.remove('show');
        isTransitioning = false;
      }, 2000);

      // Determine which media set to use
      const isMobileView = window.innerWidth <= 768;
      const mobileMedia = section.querySelectorAll('.background-media[data-mobile="true"]');
      const hasMobileMedia = mobileMedia.length > 0;

      // Deactivate ALL background media (both mobile and desktop versions)
      backgroundMedia.forEach(m => {
        m.classList.remove('active');
        if (m.tagName === 'VIDEO') m.pause();
      });
      dots[currentActiveIndex].classList.remove('active');
      
      // Instantly reset previous dot to simple state
      const prevDot = dots[currentActiveIndex];
      if (window.innerWidth > 1024) {
        if (prevDot) {
          prevDot.style.transition = 'none';
          prevDot.style.width = '16px';
          prevDot.style.height = '16px';
          prevDot.style.minWidth = '16px';
          prevDot.style.maxWidth = '16px';
          prevDot.style.padding = '0';
          prevDot.style.borderRadius = '50%';
          prevDot.style.margin = '0 8px';
          setTimeout(() => {
            prevDot.style.transition = 'transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease';
          }, 10);
        }
      } else {
        // Mobile & tablet: CSS takes full control
        if (prevDot) prevDot.removeAttribute('style');
      }

      // Instantly activate new dot
      dots[targetIndex].classList.add('active');
      const activeDot = dots[targetIndex];
      if (window.innerWidth > 1024) {
        if (activeDot) {
          activeDot.style.transition = 'none';
          activeDot.style.width = '200px';
          activeDot.style.minWidth = '200px';
          activeDot.style.maxWidth = '200px';
          activeDot.style.height = '32px';
          activeDot.style.padding = '0 16px';
          activeDot.style.borderRadius = '16px';
          activeDot.style.margin = '0 16px';
        }
      } else {
        if (activeDot) activeDot.removeAttribute('style');
      }

      // Update description content
      const targetDot = dots[targetIndex];
      const descriptionTitle = section.querySelector('#description-title');
      const descriptionText = section.querySelector('#description-text');

      if (descriptionTitle && descriptionText) {
        descriptionTitle.style.opacity = '0';
        descriptionText.style.opacity = '0';

        setTimeout(() => {
          descriptionTitle.textContent = targetDot.dataset.title || '';
          descriptionText.textContent = targetDot.dataset.description || '';
          descriptionTitle.style.opacity = '1';
          descriptionText.style.opacity = '1';
        }, 400);
      }

      // Activate background media immediately
      const targetBlockId = dots[targetIndex].dataset.blockId;
      const isMobileView2 = window.innerWidth <= 768;
      const mobileMedia2 = section.querySelectorAll('.background-media[data-mobile="true"]');
      const hasMobileMedia2 = mobileMedia2.length > 0;

      let targetMedia = null;
      if (isMobileView2 && hasMobileMedia2) {
        targetMedia = section.querySelector(`.background-media[data-block-id="${targetBlockId}"][data-mobile="true"]`);
      }
      if (!targetMedia) {
        targetMedia = section.querySelector(`.background-media[data-block-id="${targetBlockId}"]:not([data-mobile="true"])`);
      }

      if (targetMedia) {
        targetMedia.classList.add('active');
        if (targetMedia.tagName === 'VIDEO') {
          targetMedia.currentTime = 0;
          targetMedia.play().catch(e => console.log('Video autoplay prevented:', e));
        } else if (targetMedia.classList.contains('video-embed')) {
          const iframe = targetMedia.querySelector('iframe');
          if (iframe) {
            const src = iframe.src;
            iframe.src = '';
            setTimeout(() => { iframe.src = src; }, 50);
          }
        }
      }

      // Pause previous video
      const prevMedia = section.querySelector(`.background-media[data-block-id="${dots[currentActiveIndex].dataset.blockId}"].active`);
      if (prevMedia && prevMedia.tagName === 'VIDEO') prevMedia.pause();

      currentActiveIndex = targetIndex;
      
      // Hide loading overlay quickly
      clearTimeout(safetyTimeout);
      setTimeout(() => {
        loadingOverlay.classList.remove('show');
        isTransitioning = false;
        resetDotStylesForMobile();
      }, 200);
    }

    // Add click event listeners to dots
    dots.forEach((dot, index) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        switchBackground(index);
      });

      // Add hover effects (desktop only)
      dot.addEventListener('mouseenter', () => {
        if (window.innerWidth > 768 && !dot.classList.contains('active')) {
          dot.style.transform = 'scale(1.2)';
        }
      });

      dot.addEventListener('mouseleave', () => {
        if (window.innerWidth > 768 && !dot.classList.contains('active')) {
          dot.style.transform = 'scale(1)';
        }
      });
    });

    // Auto-advance functionality (optional)
    {% if section.settings.auto_advance %}
      let autoAdvanceInterval;
      const autoAdvanceDelay = {{ section.settings.auto_advance_delay | default: 5000 }};

      function startAutoAdvance() {
        autoAdvanceInterval = setInterval(() => {
          if (!isTransitioning) {
            const nextIndex = (currentActiveIndex + 1) % backgroundMedia.length;
            switchBackground(nextIndex);
          }
        }, autoAdvanceDelay);
      }

      function stopAutoAdvance() {
        if (autoAdvanceInterval) {
          clearInterval(autoAdvanceInterval);
        }
      }

      // Start auto-advance
      startAutoAdvance();

      // Pause on hover
      section.addEventListener('mouseenter', stopAutoAdvance);
      section.addEventListener('mouseleave', startAutoAdvance);

      // Pause on dot interaction
      dots.forEach(dot => {
        dot.addEventListener('click', () => {
          stopAutoAdvance();
          setTimeout(startAutoAdvance, autoAdvanceDelay);
        });
      });
    {% endif %}

    // Initialize
    preloadImages();

    // Reset all dots to simple state first
    dots.forEach((dot, index) => {
      if (window.innerWidth > 1024) {
        if (!dot.classList.contains('active')) {
          dot.style.width = '16px';
          dot.style.height = '16px';
          dot.style.minWidth = '16px';
          dot.style.maxWidth = '16px';
          dot.style.padding = '0';
          dot.style.borderRadius = '50%';
        }
      } else {
        dot.removeAttribute('style');
      }
    });

    // Force initial active dot sizing (desktop only)
    const initialActiveDot = section.querySelector('.nav-dot.active');
    if (initialActiveDot && window.innerWidth > 1024) {
      initialActiveDot.style.transition = 'none';
      initialActiveDot.style.width = '200px';
      initialActiveDot.style.minWidth = '200px';
      initialActiveDot.style.maxWidth = '200px';
      initialActiveDot.style.height = '32px';
      initialActiveDot.style.padding = '0 16px';
      initialActiveDot.style.borderRadius = '16px';
      initialActiveDot.style.margin = '0 16px';
    }

    // On mobile: clear all inline styles so CSS controls everything
    resetDotStylesForMobile();

    // Ensure first video plays if it's the active media
    const firstMedia = backgroundMedia[0];
    if (firstMedia) {
      if (firstMedia.tagName === 'VIDEO') {
        firstMedia.play().catch(e => console.log('Video autoplay prevented:', e));
      } else if (firstMedia.classList.contains('video-embed')) {
        // Embedded videos should autoplay via URL parameters
        console.log('Embedded video initialized');
      }
    }

    // ── MOBILE: update chapter pill text on dot switch ───────────
    const dlsChapterPill = section.querySelector('#dls-mobile-chapter-pill');
    if (dlsChapterPill) {
      dots.forEach(dot => {
        dot.addEventListener('click', () => {
          const content = dot.querySelector('.dot-content');
          if (content) dlsChapterPill.textContent = content.textContent.trim();
        });
      });
    }
    // ── END MOBILE CHAPTER PILL ───────────────────────────────────

    // Handle visibility change (pause videos when tab is not active)
    document.addEventListener('visibilitychange', () => {
      const activeMedia = backgroundMedia[currentActiveIndex];
      if (activeMedia && activeMedia.tagName === 'VIDEO') {
        if (document.hidden) {
          activeMedia.pause();
        } else {
          activeMedia.play().catch(e => console.log('Video autoplay prevented:', e));
        }
      }
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!section.matches(':hover')) return;
      
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        const prevIndex = currentActiveIndex > 0 ? currentActiveIndex - 1 : backgroundMedia.length - 1;
        switchBackground(prevIndex);
      } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        const nextIndex = (currentActiveIndex + 1) % backgroundMedia.length;
        switchBackground(nextIndex);
      }
    });
  });
</script>

{% schema %}
