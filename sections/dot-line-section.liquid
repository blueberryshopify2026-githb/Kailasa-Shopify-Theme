      "default": "#4FFFFF",
      "info": "Color for dots and connecting line"
    },
    {
      "type": "color",
      "id": "description_title_color",
      "label": "Description Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "description_text_color",
      "label": "Description Text Color",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "dot_label_color",
      "label": "Dot Label Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Glassmorphism Settings"
    },
    {
      "type": "color",
      "id": "glass_background_color",
      "label": "Glass Background Color",
      "default": "#ffffff",
      "info": "Base color for frosted glass containers"
    },
    {
      "type": "color",
      "id": "glass_border_color",
      "label": "Glass Border Color",
      "default": "#ffffff",
      "info": "Border color for frosted glass containers"
    },
    {
      "type": "range",
      "id": "glass_opacity",
      "min": 5,
      "max": 25,
      "step": 1,
      "unit": "%",
      "label": "Glass Background Opacity",
      "default": 8,
      "info": "Transparency level of frosted glass containers"
    },
    {
      "type": "range",
      "id": "glass_blur",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
