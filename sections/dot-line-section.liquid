      "default": 24
    },
    {
      "type": "select",
      "id": "tablet_desc_font_weight",
      "label": "Tablet Description Font Weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "select",
      "id": "tablet_desc_font_style",
      "label": "Tablet Description Font Style",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "italic", "label": "Italic" }
      ],
      "default": "normal"
    },
    {
      "type": "color",
      "id": "tablet_desc_color",
      "label": "Tablet Description Color",
      "default": "#4a4a4a"
    },
    {
      "type": "range",
      "id": "tablet_dot_font_size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Tablet Active Dot Label Font Size",
      "default": 20
    },
    {
      "type": "color",
      "id": "tablet_dot_color",
      "label": "Tablet Active Dot Label Color",
      "default": "#1a1a1a"
    }
  ],
  "blocks": [
    {
      "type": "media_block",
      "name": "Media Block",
      "settings": [
        {
          "type": "text",
          "id": "dot_label",
          "label": "Dot Label",
          "default": "Chapter 1",
          "info": "Text shown in the small dot tooltip"
        },
        {
          "type": "text",
          "id": "content_title",
          "label": "Content Title",
          "default": "Science-backed probiotics",
          "info": "Main heading shown in the description area"
        },
        {
          "type": "textarea",
          "id": "content_description",
          "label": "Content Description",
          "default": "From gut to brain to skin health, your microbiome plays a key role in how you feel every day.",
          "info": "Description text shown in the frosted glass container"
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "Media Type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background Image",
          "info": "Upload image or use Shopify image picker"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Image URL",
          "info": "Direct image URL from any source (alternative to image picker)"
        },
        {
          "type": "text",
