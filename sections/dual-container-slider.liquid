{% comment %}
  Dual Container Slider Section - Optimized
  25% left container, 70% right container with 20px gap
  Split heading, full screen responsive design
{% endcomment %}

<section class="dual-slider full-width">
  <!-- Split Heading -->
  <div class="heading-wrapper">
    <h1 class="split-title">
      <span class="title-white" style="color: {{ section.settings.white_color | default: '#ffffff' }};">
        {{ section.settings.white_text | default: 'BUILD ON BIOLOGY.' }}
      </span>
      <span class="title-cyan-dual" style="color: {{ section.settings.cyan_color | default: '#00ffff' }};">
        {{ section.settings.cyan_text | default: 'GUIDED BY SCIENCE' }}
      </span>
    </h1>
  </div>

  <!-- Slides Container -->
  <div class="slides-container">
    {% for block in section.blocks %}
      {% if block.type == 'slide_item' %}
        <div
          class="slide-item {% if forloop.first %}active{% endif %}"
          data-slide="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <!-- Left Box -->
          <div class="box left-box" style="background: {{ section.settings.left_bg | default: '#f8f8f8' }};">
            {% if block.settings.left_image %}
              <img
                src="{{ block.settings.left_image | image_url: width: 400 }}"
                alt="Left image"
                width="400"
                height="300"
                style="object-fit: {{ block.settings.left_fit | default: 'cover' }};"
              >
            {% else %}
              <div class="placeholder">Upload Left Image</div>
            {% endif %}
          </div>

          <!-- Right Box -->
          <div class="box right-box" style="background: {{ section.settings.right_bg | default: '#f8f8f8' }};">
            {% if block.settings.right_image %}
              <img
                src="{{ block.settings.right_image | image_url: width: 850 }}"
                alt="Right image"
                width="850"
                height="300"
                style="object-fit: {{ block.settings.right_fit | default: 'cover' }};"
              >
            {% else %}
              <div class="placeholder">Upload Right Image</div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <!-- Indicators -->
  <div class="indicators">
    {% for block in section.blocks %}
      {% if block.type == 'slide_item' %}
        <button class="dot {% if forloop.first %}active{% endif %}" data-slide="{{ forloop.index0 }}"></button>
      {% endif %}
    {% endfor %}
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap');

  .dual-slider {
    width: 100%;
    min-height: {{ section.settings.section_height | default: 600 }}px;
    background: {{ section.settings.bg_color | default: '#000000' }};
    font-family: 'Montserrat', sans-serif;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: {{ section.settings.section_padding | default: 40 }}px 0;
    box-sizing: border-box;
  }

  /* Heading */
  .heading-wrapper {
    flex-shrink: 0;
    text-align: center;
    padding: {{ section.settings.heading_padding | default: 30 }}px 20px;
  }

  .split-title {
    margin: 0;
    font-size: {{ section.settings.title_size | default: 48 }}px;
    font-weight: {{ section.settings.title_weight | default: 700 }};
    line-height: 1.2;
  }

  .title-white, .title-cyan-dual {
    display: inline;
  }

  /* Slides */
  .slides-container {
    flex: 1;
    position: relative;
    padding: 0 {{ section.settings.side_padding | default: 10 }}px;
    display: flex;
    align-items: center;
  }

  .slide-item {
    display: none;
    width: 100%;
    height: {{ section.settings.slide_height | default: 400 }}px;
    gap: {{ section.settings.gap | default: 20 }}px;
    align-items: stretch;
  }

  .slide-item.active {
    display: flex;
  }

  /* Boxes */
  .box {
    border-radius: {{ section.settings.border_radius | default: 20 }}px;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }

  .left-box {
    flex: 0 0 25%;
    margin-left: 20px;
    
  }

  .right-box {
    flex: 0 0 70%;
  }

  .box img {
    width: 100%;
    height: 100%;
    border-radius: {{ section.settings.border_radius | default: 20 }}px;
    object-fit: cover;
  }

  .placeholder {
    color: {{ section.settings.placeholder_color | default: '#666666' }};
    font-size: {{ section.settings.placeholder_size | default: 14 }}px;
    text-align: center;
  }

  /* Indicators */
  .indicators {
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    gap: {{ section.settings.dot_gap | default: 10 }}px;
    padding: {{ section.settings.indicators_padding | default: 20 }}px;
  }

  .dot {
    width: {{ section.settings.dot_size | default: 12 }}px;
    height: {{ section.settings.dot_size | default: 12 }}px;
    border-radius: 50%;
    border: none;
    background: {{ section.settings.dot_inactive | default: '#666666' }};
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .dot.active {
    background: {{ section.settings.dot_active | default: '#00ffff' }};
  }

  .dot:hover {
    transform: scale(1.2);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .dual-slider {
      min-height: {{ section.settings.mobile_section_height | default: 500 }}px;
      padding: {{ section.settings.mobile_section_padding | default: 30 }}px 0;
    }

    .split-title {
      font-size: {{ section.settings.mobile_title_size | default: 28 }}px;
    }

    .title-white, .title-cyan-dual {
      display: block;
      margin-bottom: 5px;
    }

    .slide-item {
      flex-direction: column;
      gap: {{ section.settings.mobile_gap | default: 15 }}px;
      height: {{ section.settings.mobile_slide_height | default: 350 }}px;
    }

    .left-box, .right-box {
      flex: 1 1 auto;
      height: {{ section.settings.mobile_box_height | default: 150 }}px;
    }

    .heading-wrapper {
      padding: {{ section.settings.mobile_heading_padding | default: 20 }}px 15px;
    }

    .slides-container {
      padding: 0 {{ section.settings.mobile_side_padding | default: 15 }}px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slides = document.querySelectorAll('.slide-item');
    const dots = document.querySelectorAll('.dot');
    let currentSlide = 0;
    let autoInterval;

    function showSlide(index) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === index);
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === index);
      });
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % slides.length;
      showSlide(currentSlide);
    }

    function startAuto() {
      {% if section.settings.auto_slide %}
        autoInterval = setInterval(nextSlide, {{ section.settings.auto_duration | default: 5000 }});
      {% endif %}
    }

    function stopAuto() {
      clearInterval(autoInterval);
    }

    // Dot clicks
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        currentSlide = index;
        showSlide(currentSlide);
        stopAuto();
        startAuto();
      });
    });

    // Touch swipe
    let startX = 0;
    const container = document.querySelector('.slides-container');

    container.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
    });

    container.addEventListener('touchend', (e) => {
      const endX = e.changedTouches[0].clientX;
      const diff = startX - endX;

      if (Math.abs(diff) > 50) {
        if (diff > 0) {
          nextSlide();
        } else {
          currentSlide = (currentSlide - 1 + slides.length) % slides.length;
          showSlide(currentSlide);
        }
        stopAuto();
        startAuto();
      }
    });

    // Auto-slide
    startAuto();

    // Pause on hover
    container.addEventListener('mouseenter', stopAuto);
    container.addEventListener('mouseleave', startAuto);
  });
</script>

