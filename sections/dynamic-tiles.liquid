{% comment %}
  Dynamic Tiles Section - Full-width background with floating white strip
  Features: One image per slide with 3 text tiles, infinite sliding
{% endcomment %}

<style>
  .dynamic-tiles-section {
    font-family: 'Montserrat', sans-serif;
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: #000000;
  }

  /* Background Images */
  .dynamic-tiles-backgrounds {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .dynamic-tiles-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
  }

  .dynamic-tiles-bg-image.active {
    opacity: 1;
  }

  .dynamic-tiles-bg-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Black Strip Container */
  .dynamic-tiles-strip-container {
    position: absolute;
    z-index: 10;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0;
  }

  /* Black Strip */
  .dynamic-tiles-strip {
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: none;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.3);
    padding: 0;
    position: relative;
    display: flex;
    align-items: stretch;
    gap: 0;
    height: 200px;
  }

  /* Tile Thumbnail - 40% width on left side */
  .dynamic-tile-thumbnail {
    width: 40%;
    height: 200px;
    flex-shrink: 0;
    overflow: hidden;
    background: #1a1a1a;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .dynamic-tile-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: opacity 0.4s ease-in-out;
  }

  /* Content wrapper - 60% width */
  .dynamic-tiles-content-wrapper {
    width: 60%;
    height: 200px;
    flex-shrink: 0;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  /* Tiles Track */
  .dynamic-tiles-track-wrapper {
    overflow: hidden;
    flex: 1;
    padding: 40px 50px;
  }

  .dynamic-tiles-track {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 50px;
    width: 100%;
    height: 100%;
  }

  /* Individual Tile */
  .dynamic-tile {
    background: transparent;
    border-radius: 0;
    padding: 0;
    display: none;
    align-items: flex-start;
    justify-content: flex-start;
    cursor: pointer;
  }

  .dynamic-tile.visible {
    display: flex;
  }

  /* Navigation Arrows - Bottom right corner */
  .dynamic-tiles-nav {
    position: absolute;
    bottom: 15px;
    right: 40px;
    display: flex;
    gap: 10px;
    z-index: 20;
  }

  /* Tile Content */
  .dynamic-tile-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .dynamic-tile-stat {
    font-size: 48px;
    font-weight: 800;
    color: {{ section.settings.accent_color | default: '#4FFFFF' }};
    line-height: 1;
    margin: 0;
  }

  .dynamic-tile-title {
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    margin: 0;
  }

  .dynamic-tile-description {
    font-size: 14px;
    color: #cccccc;
    line-height: 1.4;
    margin: 0;
  }

  .dynamic-tiles-nav-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.95);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .dynamic-tiles-nav-btn:hover {
    transform: scale(1.1);
    background: rgba(255, 255, 255, 1);
  }

  .dynamic-tiles-nav-btn svg {
    width: 12px;
    height: 12px;
    stroke: #000000;
    stroke-width: 2.5;
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .dynamic-tiles-track {
      grid-template-columns: repeat(4, 1fr);
      gap: 30px;
    }
  }

  @media (max-width: 1024px) {
    .dynamic-tiles-strip-container {
      bottom: 0;
    }

    .dynamic-tiles-strip {
      padding: 25px 40px;
      gap: 30px;
    }

    .dynamic-tiles-track {
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
    }
  }

  @media (max-width: 768px) {
    .dynamic-tiles-section {
      height: auto;
      min-height: 500px;
    }

    .dynamic-tiles-strip-container {
      bottom: 0;
    }

    .dynamic-tiles-strip {
      padding: 20px;
      gap: 20px;
      flex-direction: column;
    }

    .dynamic-tiles-track {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .dynamic-tile {
      flex-direction: column;
      text-align: center;
    }

    .dynamic-tile-thumbnail {
      width: 70px;
      height: 70px;
    }

    .dynamic-tile-stat {
      font-size: 28px;
    }

    .dynamic-tile-title {
      font-size: 14px;
    }

    .dynamic-tile-description {
      font-size: 11px;
    }

    .dynamic-tiles-strip-container {
      padding: 0 20px;
    }

    .dynamic-tiles-strip {
      padding: 24px 20px;
    }
  }
</style>

<section class="dynamic-tiles-section">
  <!-- Background Images -->
  <div class="dynamic-tiles-backgrounds">
    {% for block in section.blocks %}
      <div class="dynamic-tiles-bg-image {% if forloop.first %}active{% endif %}" 
           data-bg-index="{{ forloop.index0 }}">
        {% if block.settings.background_image %}
          <img src="{{ block.settings.background_image | image_url: width: 2000 }}" 
               alt="{{ block.settings.slide_title }}"
               width="2000"
               height="1200"
               loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <!-- Black Strip -->
  <div class="dynamic-tiles-strip-container">
    <div class="dynamic-tiles-strip">
      <!-- Image at left - 40% width -->
      <div class="dynamic-tile-thumbnail" id="strip-thumbnail-{{ section.id }}">
        {% if section.blocks.first.settings.thumbnail_image %}
          <img src="{{ section.blocks.first.settings.thumbnail_image | image_url: width: 800 }}" 
               alt="{{ section.blocks.first.settings.slide_title }}"
               width="800"
               height="400">
        {% endif %}
      </div>

      <!-- Content wrapper - 60% width -->
      <div class="dynamic-tiles-content-wrapper">
        <!-- Tiles Track -->
        <div class="dynamic-tiles-track-wrapper">
          <div class="dynamic-tiles-track" id="tiles-track-{{ section.id }}">
            {% comment %} Only text tiles, no image tiles {% endcomment %}
            {% for block in section.blocks %}
              {% comment %} Tile 1: Text only {% endcomment %}
              <div class="dynamic-tile {% if forloop.first %}visible{% endif %}" 
                   data-slide="{{ forloop.index0 }}"
                   onclick="selectSlide({{ forloop.index0 }}, '{{ section.id }}')">
                <div class="dynamic-tile-content">
                  <div class="dynamic-tile-stat">{{ block.settings.statistic_1 }}</div>
                  <div class="dynamic-tile-title">{{ block.settings.title_1 }}</div>
                  <div class="dynamic-tile-description">{{ block.settings.description_1 }}</div>
                </div>
              </div>
              
              {% comment %} Tile 2: Text only {% endcomment %}
              <div class="dynamic-tile {% if forloop.first %}visible{% endif %}" 
                   data-slide="{{ forloop.index0 }}"
                   onclick="selectSlide({{ forloop.index0 }}, '{{ section.id }}')">
                <div class="dynamic-tile-content">
                  <div class="dynamic-tile-stat">{{ block.settings.statistic_2 }}</div>
                  <div class="dynamic-tile-title">{{ block.settings.title_2 }}</div>
                  <div class="dynamic-tile-description">{{ block.settings.description_2 }}</div>
                </div>
              </div>
              
              {% comment %} Tile 3: Text only {% endcomment %}
              <div class="dynamic-tile {% if forloop.first %}visible{% endif %}" 
                   data-slide="{{ forloop.index0 }}"
                   onclick="selectSlide({{ forloop.index0 }}, '{{ section.id }}')">
                <div class="dynamic-tile-content">
                  <div class="dynamic-tile-stat">{{ block.settings.statistic_3 }}</div>
                  <div class="dynamic-tile-title">{{ block.settings.title_3 }}</div>
                  <div class="dynamic-tile-description">{{ block.settings.description_3 }}</div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        <!-- Navigation at bottom right corner -->
        <div class="dynamic-tiles-nav">
          <button class="dynamic-tiles-nav-btn" onclick="moveSlides(-1, '{{ section.id }}')">
            <svg viewBox="0 0 24 24" fill="none"><path d="M15 18L9 12L15 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="dynamic-tiles-nav-btn" onclick="moveSlides(1, '{{ section.id }}')">
            <svg viewBox="0 0 24 24" fill="none"><path d="M9 18L15 12L9 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
window.dynamicTilesData = window.dynamicTilesData || {};

function initDynamicTiles(sectionId) {
  const totalSlides = {{ section.blocks.size }};
  
  window.dynamicTilesData[sectionId] = {
    currentSlide: 0,
    totalSlides: totalSlides,
    isTransitioning: false,
    autoplayInterval: null
  };
  
  // Start autoplay
  startAutoplay(sectionId);
}

function startAutoplay(sectionId) {
  const data = window.dynamicTilesData[sectionId];
  
  // Clear any existing interval
  if (data.autoplayInterval) {
    clearInterval(data.autoplayInterval);
  }
  
  // Set new interval for 7 seconds
  data.autoplayInterval = setInterval(() => {
    moveSlides(1, sectionId);
  }, 7000);
}

function stopAutoplay(sectionId) {
  const data = window.dynamicTilesData[sectionId];
  if (data.autoplayInterval) {
    clearInterval(data.autoplayInterval);
    data.autoplayInterval = null;
  }
}

function resetAutoplay(sectionId) {
  stopAutoplay(sectionId);
  startAutoplay(sectionId);
}

function selectSlide(slideIndex, sectionId) {
  const data = window.dynamicTilesData[sectionId];
  if (data.isTransitioning || data.currentSlide === slideIndex) return;
  
  data.isTransitioning = true;
  data.currentSlide = slideIndex;
  
  // Update visible tiles
  const tiles = document.querySelectorAll(`#tiles-track-${sectionId} .dynamic-tile`);
  tiles.forEach((tile) => {
    const tileSlide = parseInt(tile.getAttribute('data-slide'));
    if (tileSlide === slideIndex) {
      tile.classList.add('visible');
    } else {
      tile.classList.remove('visible');
    }
  });
  
  // Update background
  const backgrounds = document.querySelectorAll('.dynamic-tiles-bg-image');
  backgrounds.forEach((bg, i) => {
    if (i === slideIndex) {
      bg.classList.add('active');
    } else {
      bg.classList.remove('active');
    }
  });
  
  // Update thumbnail image with smooth crossfade
  const thumbnail = document.getElementById(`strip-thumbnail-${sectionId}`);
  if (thumbnail) {
    const currentImg = thumbnail.querySelector('img');
    if (currentImg) {
      const thumbnailImages = [
        {% for block in section.blocks %}
          "{{ block.settings.thumbnail_image | image_url: width: 800 }}"{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ];
      
      if (thumbnailImages[slideIndex] && currentImg.src !== thumbnailImages[slideIndex]) {
        // Create new image element
        const newImg = new Image();
        newImg.src = thumbnailImages[slideIndex];
        newImg.style.position = 'absolute';
        newImg.style.top = '0';
        newImg.style.left = '0';
        newImg.style.width = '100%';
        newImg.style.height = '100%';
        newImg.style.objectFit = 'cover';
        newImg.style.objectPosition = 'center';
        newImg.style.opacity = '0';
        newImg.style.transition = 'opacity 0.4s ease-in-out';
        
        // Add new image to container
        thumbnail.appendChild(newImg);
        
        // Trigger crossfade
        setTimeout(() => {
          currentImg.style.opacity = '0';
          newImg.style.opacity = '1';
        }, 10);
        
        // Remove old image after transition
        setTimeout(() => {
          if (currentImg.parentNode === thumbnail) {
            thumbnail.removeChild(currentImg);
          }
        }, 450);
      }
    }
  }
  
  setTimeout(() => { data.isTransitioning = false; }, 450);
}

function moveSlides(direction, sectionId) {
  const data = window.dynamicTilesData[sectionId];
  if (data.isTransitioning) return;
  
  let newSlide = data.currentSlide + direction;
  
  // Loop around
  if (newSlide >= data.totalSlides) {
    newSlide = 0;
  } else if (newSlide < 0) {
    newSlide = data.totalSlides - 1;
  }
  
  selectSlide(newSlide, sectionId);
  
  // Reset autoplay timer when user manually changes slides
  resetAutoplay(sectionId);
}

document.addEventListener('DOMContentLoaded', function() {
  initDynamicTiles('{{ section.id }}');
});
</script>

{% schema %}
{
  "name": "Dynamic Tiles",
  "tag": "section",
  "class": "dynamic-tiles-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Section Height",
      "default": 80
    },
    {
      "type": "range",
      "id": "strip_border_radius",
      "min": 16,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Strip Border Radius",
      "default": 24
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4FFFFF"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "slide_title",
          "label": "Slide Title",
          "default": "Slide 1"
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background Image"
        },
        {
          "type": "image_picker",
          "id": "thumbnail_image",
          "label": "Thumbnail Image"
        },
        {
          "type": "header",
          "content": "Tile 1 (with image)"
        },
        {
          "type": "text",
          "id": "statistic_1",
          "label": "Statistic 1",
          "default": "500K"
        },
        {
          "type": "text",
          "id": "title_1",
          "label": "Title 1",
          "default": "Consumer reach"
        },
        {
          "type": "text",
          "id": "description_1",
          "label": "Description 1",
          "default": "Consumer across 20 countries"
        },
        {
          "type": "header",
          "content": "Tile 2 (text only)"
        },
        {
          "type": "text",
          "id": "statistic_2",
          "label": "Statistic 2",
          "default": "60%"
        },
        {
          "type": "text",
          "id": "title_2",
          "label": "Title 2",
          "default": "Reduced Carbon"
        },
        {
          "type": "text",
          "id": "description_2",
          "label": "Description 2",
          "default": "Consumer across 20 countries"
        },
        {
          "type": "header",
          "content": "Tile 3 (text only)"
        },
        {
          "type": "text",
          "id": "statistic_3",
          "label": "Statistic 3",
          "default": "90%"
        },
        {
          "type": "text",
          "id": "title_3",
          "label": "Title 3",
          "default": "Consumer reach"
        },
        {
          "type": "text",
          "id": "description_3",
          "label": "Description 3",
          "default": "Consumer across 20 countries"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dynamic Tiles",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
