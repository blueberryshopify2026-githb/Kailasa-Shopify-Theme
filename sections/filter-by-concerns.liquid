{% comment %}
  Filter by Concerns Section
  Shows ingredients by skin concern with automatic tab switching on scroll
{% endcomment %}

<style>
  .filter-concerns {
    display: flex;
    min-height: 100vh;
    font-family: 'Montserrat', sans-serif;
  }

  .filter-concerns__sidebar {
    width: 310px;
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-right: 1px solid #e5e5e5;
  }

  .filter-concerns__nav {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .filter-concerns__nav-item {
    padding: 30px 48px;
    font-size: 18px;
    font-weight: 500;
    color: #000;
    text-decoration: none;
    border-bottom: 1px solid #e5e5e5;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
  }

  .filter-concerns__nav-item.active {
    color: #000;
  }

  .filter-concerns__nav-item.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 48px;
    width: 77px;
    height: 3px;
    background: #00CED1;
  }

  .filter-concerns__content {
    flex: 1;
    overflow-y: auto;
    background: #f5f5f5;
    padding: {{ section.settings.image_gap }}px;
  }

  .filter-concerns__group {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.image_gap }}px;
  }

  .filter-concerns__image-wrapper {
    position: relative;
    background: #fff;
    height: {{ section.settings.image_height }}px;
    border-radius: 8px;
    overflow: hidden;
  }

  .filter-concerns__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .filter-concerns__button {
    position: absolute;
    bottom: 40px;
    right: 40px;
    background: #fff;
    color: #000;
    padding: 12px 32px;
    border-radius: 50px;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: all 0.3s ease;
    font-family: 'Montserrat', sans-serif;
  }

  .filter-concerns__button:hover {
    background: #f0f0f0;
  }

  @media (max-width: 768px) {
    .filter-concerns {
      flex-direction: column;
    }

    .filter-concerns__sidebar {
      width: 100%;
      height: auto;
      position: relative;
      flex-direction: row;
      overflow-x: auto;
      border-right: none;
      border-bottom: 1px solid #e5e5e5;
    }

    .filter-concerns__nav {
      flex-direction: row;
    }

    .filter-concerns__nav-item {
      padding: 20px 24px;
      white-space: nowrap;
      border-bottom: none;
      border-right: 1px solid #e5e5e5;
    }

    .filter-concerns__nav-item.active::after {
      left: 24px;
      right: 24px;
      width: auto;
    }
  }
</style>

<div class="filter-concerns" id="filter-concerns-{{ section.id }}">
  <div class="filter-concerns__sidebar">
    <nav class="filter-concerns__nav">
      {% for block in section.blocks %}
        <a 
          href="#concern-{{ block.id }}" 
          class="filter-concerns__nav-item" 
          data-concern="{{ block.id }}"
        >
          {{ block.settings.concern_name }}
        </a>
      {% endfor %}
    </nav>
  </div>

  <div class="filter-concerns__content" id="concerns-content-{{ section.id }}">
    {% for block in section.blocks %}
      <div class="filter-concerns__group" id="concern-{{ block.id }}" data-concern="{{ block.id }}">
        {% for i in (1..5) %}
          {% assign image_key = 'image_' | append: i %}
          {% assign image = block.settings[image_key] %}
          {% if image %}
            <div class="filter-concerns__image-wrapper">
              <img 
                src="{{ image | image_url: width: 1200 }}" 
                alt="{{ block.settings.concern_name }} ingredient {{ i }}"
                class="filter-concerns__image"
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="lazy"
              >
              <a href="#" class="filter-concerns__button">
                {{ section.settings.button_text }}
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const content = document.getElementById('concerns-content-' + sectionId);
    const navItems = document.querySelectorAll('#filter-concerns-' + sectionId + ' .filter-concerns__nav-item');
    const groups = document.querySelectorAll('#filter-concerns-' + sectionId + ' .filter-concerns__group');

    let isScrolling = false;

    function updateActiveNav() {
      if (isScrolling) return;

      const scrollTop = content.scrollTop;
      const scrollHeight = content.scrollHeight;
      const clientHeight = content.clientHeight;

      let activeIndex = 0;

      groups.forEach((group, index) => {
        const rect = group.getBoundingClientRect();
        const contentRect = content.getBoundingClientRect();
        
        if (rect.top <= contentRect.top + 100) {
          activeIndex = index;
        }
      });

      navItems.forEach((item, index) => {
        if (index === activeIndex) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });
    }

    content.addEventListener('scroll', updateActiveNav);

    navItems.forEach((item, index) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        isScrolling = true;

        const targetId = item.getAttribute('href').substring(1);
        const targetGroup = document.getElementById(targetId);

        if (targetGroup) {
          const contentRect = content.getBoundingClientRect();
          const targetRect = targetGroup.getBoundingClientRect();
          const scrollTo = content.scrollTop + targetRect.top - contentRect.top;

          content.scrollTo({
            top: scrollTo,
            behavior: 'smooth'
          });

          setTimeout(() => {
            isScrolling = false;
            updateActiveNav();
          }, 1000);
        }
      });
    });

    // Initialize
    updateActiveNav();
  })();
</script>

{% schema %}
{
  "name": "Filter by Concerns",
  "settings": [
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Know More"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image Height (px)",
      "min": 300,
      "max": 800,
      "step": 50,
      "default": 500,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Gap Between Images (px)",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 20,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Skin Concern",
      "settings": [
        {
          "type": "text",
          "id": "concern_name",
          "label": "Concern Name",
          "default": "Acne"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Ingredient Image 1"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Ingredient Image 2"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Ingredient Image 3"
        },
        {
          "type": "image_picker",
          "id": "image_4",
          "label": "Ingredient Image 4"
        },
        {
          "type": "image_picker",
          "id": "image_5",
          "label": "Ingredient Image 5"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Filter by Concerns",
      "blocks": [
        {
          "type": "concern",
          "settings": {
            "concern_name": "Acne"
          }
        },
        {
          "type": "concern",
          "settings": {
            "concern_name": "Dryness"
          }
        },
        {
          "type": "concern",
          "settings": {
            "concern_name": "Wrinkles/fine lines"
          }
        },
        {
          "type": "concern",
          "settings": {
            "concern_name": "Hyperpigmentation"
          }
        },
        {
          "type": "concern",
          "settings": {
            "concern_name": "Sensitivity"
          }
        },
        {
          "type": "concern",
          "settings": {
            "concern_name": "Enlarged Pores"
          }
        },
        {
          "type": "concern",
          "settings": {
            "concern_name": "Oily Skin"
          }
        }
      ]
    }
  ]
}
{% endschema %}
