{% comment %}
  Free From Section
  Wide image left + 3 right cards | 4 bottom cards
  Icon half-outside card top | hover replaces card with frost glass
  Class suffix: ff
{% endcomment %}


<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap');


  .ff-section {
    font-family: 'Montserrat', sans-serif;
    background: {{ section.settings.ff_bg }};
    padding: {{ section.settings.ff_padding_v }}px {{ section.settings.ff_padding_h }}px;
    height: 110vh;
    min-height: 600px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }


  /* ── Heading ── */
  .ff-heading {
    font-size: {{ section.settings.ff_heading_size }}px;
    font-weight: {{ section.settings.ff_heading_weight }};
    color: {{ section.settings.ff_heading_color }};
    line-height: 1.2;
    margin: 0 20 {{ section.settings.ff_heading_gap }}px 0;
    /* border:1px solid red; */
    padding-bottom: 20px;
  }


  /* ── Main grid layout ──
     Image left, right col with 3 stacked cards.
     Bottom row: 2 cards under image + 1 card under right column.
  */
  .ff-layout {
    display: grid;
    grid-template-columns: 1fr 405px;
    grid-template-rows: 1fr auto;
    gap: {{ section.settings.ff_card_gap }}px;
    flex: 1;
    min-height: 0;
  }


  /* Image: top-left cell */
  .ff-image-wrap {
    grid-column: 1;
    grid-row: 1;
    min-height: 0;
    overflow: hidden;
    border-radius: {{ section.settings.ff_img_radius }}px;
  }


  .ff-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ section.settings.ff_img_radius }}px;
    display: block;
  }


  .ff-image-placeholder {
    width: 100%;
    height: 100%;
    border-radius: {{ section.settings.ff_img_radius }}px;
    background: #e8e8e8;
  }


  /* Right column: 3 cards stacked, top-right cell — same card height as bottom */
  .ff-right-col {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: {{ section.settings.ff_card_gap }}px;
    min-height: 0;
  }


  .ff-right-col .ff-card-wrap {
    flex: none;
    width: 405px;
  }


  .ff-right-col .ff-card {
    height: {{ section.settings.ff_card_height }}px;
  }


  /* Bottom row: 2 cards under image, 1 card under right column */
  .ff-bottom-row {
    grid-column: 1;
    grid-row: 2;
    display: flex;
    justify-content: space-between;
    flex-shrink: 0;
  }

  .ff-bottom-row .ff-card-wrap {
    width: 405px;
    flex-shrink: 0;
  }

  /* Third bottom card positioned in right column */
  .ff-bottom-right {
    grid-column: 2;
    grid-row: 2;
  }

  .ff-bottom-right .ff-card-wrap {
    width: 405px;
  }

  .ff-bottom-right .ff-card {
    height: {{ section.settings.ff_card_height }}px;
  }


  /* ── Card wrap — extra top space for half-out icon ── */
  .ff-card-wrap {
    position: relative;
    padding-top: {{ section.settings.ff_icon_size | divided_by: 2 }}px;
  }


  .ff-bottom-row .ff-card-wrap {
    flex: none;
  }


  .ff-card {
    position: relative;
    border: {{ section.settings.ff_card_border_width }}px solid {{ section.settings.ff_card_border_color }};
    border-radius: {{ section.settings.ff_card_radius }}px;
    background: {{ section.settings.ff_card_bg }};
    height: {{ section.settings.ff_card_height }}px;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
    padding: {{ section.settings.ff_card_pad_v }}px {{ section.settings.ff_card_pad_h }}px;
    padding-left: {{ section.settings.ff_card_pad_h | plus: section.settings.ff_icon_size | plus: 12 }}px;
    overflow: visible;
    cursor: default;
    transition: border-color 0.25s;
    box-sizing: border-box;
  }


  /* Icon: half outside top-left of card */
  .ff-icon-wrap {
    position: absolute;
    top: -{{ section.settings.ff_icon_size | divided_by: 2 }}px;
    left: {{ section.settings.ff_card_pad_h }}px;
    width: {{ section.settings.ff_icon_size }}px;
    height: {{ section.settings.ff_icon_size }}px;
    flex-shrink: 0;
    z-index: 3;
    background: {{ section.settings.ff_card_bg }};
    border-radius: 50%;
  }


  .ff-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }


  .ff-icon-placeholder {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    background: #fff;
  }


  /* Label */
  .ff-card-label {
    font-size: {{ section.settings.ff_label_size }}px;
    font-weight: {{ section.settings.ff_label_weight }};
    color: {{ section.settings.ff_label_color }};
    margin: 0;
  }


  /* ── Frost hover card — expands UPWARD from card top ── */
  .ff-hover-card {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    border-radius: {{ section.settings.ff_card_radius }}px;
    background: rgba(255,255,255,{{ section.settings.ff_frost_opacity | divided_by: 100.0 }});
    backdrop-filter: blur({{ section.settings.ff_frost_blur }}px);
    -webkit-backdrop-filter: blur({{ section.settings.ff_frost_blur }}px);
    border: {{ section.settings.ff_frost_border_width }}px solid #4fffff;
    box-shadow: 0 4px 24px rgba(79,255,255,0.3);
    padding: {{ section.settings.ff_frost_pad }}px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 8px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    z-index: 20;
  }


  .ff-card-wrap:hover .ff-hover-card {
    opacity: 1;
    visibility: visible;
  }


  .ff-hover-icon-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }


  .ff-hover-icon {
    width: {{ section.settings.ff_icon_size | times: 70 | divided_by: 100 }}px;
    height: {{ section.settings.ff_icon_size | times: 70 | divided_by: 100 }}px;
    object-fit: contain;
    flex-shrink: 0;
  }


  .ff-hover-icon-placeholder {
    width: {{ section.settings.ff_icon_size | times: 70 | divided_by: 100 }}px;
    height: {{ section.settings.ff_icon_size | times: 70 | divided_by: 100 }}px;
    border-radius: 50%;
    border: 2px solid #000;
    flex-shrink: 0;
  }


  .ff-hover-label {
    font-size: {{ section.settings.ff_label_size }}px;
    font-weight: 700;
    color: {{ section.settings.ff_label_color }};
    margin: 0;
  }
  


  .ff-hover-text {
    font-size: {{ section.settings.ff_hover_text_size }}px;
    color: {{ section.settings.ff_hover_text_color }};
    line-height: 1.55;
    margin: 0;
  }


  /* ── Mobile Marquee ── */
  .ff-marquee-container {
    display: none;
    width: 100%;
    overflow: hidden;
    position: relative;
    padding: 20px 0;
  }

  /* Mobile/Tablet elements hidden by default on desktop */
  .ff-mobile-image-wrap {
    display: none;
  }

  .ff-mobile-cards-grid {
    display: none;
  }


  .ff-marquee-track {
    display: flex;
    gap: 16px;
    animation: ff-scroll 30s linear infinite;
    will-change: transform;
  }


  @keyframes ff-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }


  .ff-marquee-card {
    flex: 0 0 auto;
    width: 280px;
    position: relative;
    padding-top: {{ section.settings.ff_icon_size | divided_by: 2 }}px;
  }


  .ff-marquee-card .ff-card {
    height: auto;
    min-height: 80px;
    padding: 20px 16px 20px {{ section.settings.ff_card_pad_h | plus: section.settings.ff_icon_size | plus: 12 }}px;
  }


  /* Close button for tablet touch */
  .ff-close-btn {
    display: none;
    position: absolute;
    top: 8px;
    right: 8px;
    width: 28px;
    height: 28px;
    background: rgba(0,0,0,0.6);
    border: none;
    border-radius: 50%;
    color: #fff;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
    z-index: 25;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }


  .ff-close-btn:hover {
    background: rgba(0,0,0,0.8);
  }


  .ff-hover-card.active .ff-close-btn {
    display: flex;
  }


  /* ── RESPONSIVE: Mobile First ── */
 
  /* Mobile: < 768px */
  @media (max-width: 767px) {
    .ff-section {
      height: auto;
      min-height: auto;
      padding: {{ section.settings.ff_mobile_padding_v }}px {{ section.settings.ff_mobile_padding_h }}px;
    }


    .ff-heading {
      font-size: 20px;
      margin-bottom: 16px;
      text-align: center;
      line-height: 1.25;
      padding: 0 10px;
    }


    /* Hide desktop layout */
    .ff-layout {
      display: none !important;
    }


    /* Show and style mobile image */
    .ff-mobile-image-wrap {
      display: block !important;
      width: 100%;
      margin-bottom: 16px;
      border-radius: 12px;
      overflow: hidden;
      height: 170px;
    }


    .ff-mobile-image {
      width: 100%;
      height: 170px;
      object-fit: cover;
      display: block;
    }


    .ff-mobile-image-placeholder {
      width: 100%;
      height: 180px;
      background: #e8e8e8;
      border-radius: 12px;
    }


    /* Hide marquee */
    .ff-marquee-container {
      display: none !important;
    }


    /* Show mobile card grid: 2 columns × 3 rows */
    .ff-mobile-cards-grid {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }


    .ff-mobile-cards-grid .ff-card-wrap {
      padding-top: 18px;
    }


    .ff-mobile-cards-grid .ff-card {
      height: 72px;
      padding: 10px;
      padding-left: 48px;
      cursor: pointer;
      display: flex;
      align-items: center;
    }


    .ff-mobile-cards-grid .ff-icon-wrap {
      width: 36px;
      height: 36px;
      top: -18px;
      left: 10px;
    }


    .ff-mobile-cards-grid .ff-card-label {
      font-size: 13px;
      font-weight: {{ section.settings.ff_label_weight }};
      line-height: 1.3;
    }


    /* Enable hover cards on mobile with click/touch */
    .ff-mobile-cards-grid .ff-hover-card {
      display: flex;
      pointer-events: none;
    }


    .ff-mobile-cards-grid .ff-hover-card.active {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }


    .ff-mobile-cards-grid .ff-hover-card.active .ff-close-btn {
      display: flex;
    }


    .ff-mobile-cards-grid .ff-hover-icon {
      width: 25px;
      height: 25px;
    }


    .ff-mobile-cards-grid .ff-hover-icon-placeholder {
      width: 25px;
      height: 25px;
    }


    .ff-mobile-cards-grid .ff-hover-label {
      font-size: 13px;
    }


    .ff-mobile-cards-grid .ff-hover-text {
      font-size: 11px;
    }
  }

  /* Tablet: 768px - 1024px */
  @media (min-width: 768px) and (max-width: 1024px) {
    .ff-section {
      height: auto;
      min-height: 0;
      padding: 24px 16px;
      display: flex;
      flex-direction: column;
      overflow: visible;
    }

    .ff-heading {
      font-size: 26px;
      margin-bottom: 20px;
      text-align: left;
      line-height: 1.25;
      display: block;
      width: 100%;
      flex-shrink: 0;
      position: relative;
      z-index: 1;
    }

    /* Hide mobile elements */
    .ff-mobile-image-wrap {
      display: none !important;
    }

    .ff-mobile-cards-grid {
      display: none !important;
    }

    .ff-marquee-container {
      display: none !important;
    }

    /* Desktop L-shaped layout - responsive for tablet */
    .ff-layout {
      display: grid !important;
      grid-template-columns: 60% 38%;
      grid-template-rows: 320px auto;
      gap: 12px;
      flex-shrink: 0;
      position: relative;
    }

    .ff-image-wrap {
      grid-column: 1;
      grid-row: 1;
      overflow: hidden;
      border-radius: 12px;
      height: 310px;
    }

    .ff-image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 12px;
      display: block;
    }

    .ff-right-col {
      grid-column: 2;
      grid-row: 1;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 12px;
    }

    .ff-right-col .ff-card-wrap {
      flex: none;
      width: 100%;
    }

    .ff-right-col .ff-card {
      height: 68px;
    }

    .ff-bottom-row {
      grid-column: 1;
      grid-row: 2;
      display: flex;
      justify-content: space-between;
      gap: 12px;
    }

    .ff-bottom-row .ff-card-wrap {
      flex: 1;
    }

    .ff-bottom-right {
      grid-column: 2;
      grid-row: 2;
    }

    .ff-bottom-right .ff-card-wrap {
      width: 100%;
    }

    .ff-bottom-right .ff-card {
      height: 68px;
    }

    .ff-card {
      height: 68px;
      padding: 10px 12px;
      padding-left: 54px;
    }

    .ff-icon-wrap {
      width: 36px;
      height: 36px;
      top: -18px;
      left: 12px;
    }

    .ff-card-label {
      font-size: 14px;
      line-height: 1.3;
    }

    .ff-hover-card {
      padding: 10px;
    }

    .ff-hover-icon {
      width: 25px;
      height: 25px;
    }

    .ff-hover-label {
      font-size: 14px;
    }

    .ff-hover-text {
      font-size: 10px;
    }
  }
      width: {{ section.settings.ff_tablet_icon_size | times: 70 | divided_by: 100 }}px;



  /* Desktop: > 1024px */
  @media (min-width: 1025px) {
    /* Hide mobile elements */
    .ff-mobile-image-wrap {
      display: none;
    }

    .ff-mobile-cards-grid {
      display: none;
    }

    .ff-marquee-container {
      display: none;
    }

    /* Show desktop layout */
    .ff-layout {
      display: grid;
    }
  }
</style>


<section class="ff-section full-width">


  <h2 class="ff-heading">{{ section.settings.ff_heading }}</h2>


  <!-- Mobile/Tablet Image -->
  <div class="ff-mobile-image-wrap">
    {% if section.settings.ff_image != blank %}
      <img
        class="ff-mobile-image"
        src="{{ section.settings.ff_image | image_url: width: 800 }}"
        alt="{{ section.settings.ff_heading }}"
        width="800"
        height="280"
        loading="lazy"
      >
    {% else %}
      <div class="ff-mobile-image-placeholder"></div>
    {% endif %}
  </div>


  <!-- Mobile/Tablet Card Grid (2 columns) -->
  <div class="ff-mobile-cards-grid">
    {% for block in section.blocks %}
      <div class="ff-card-wrap" data-block-id="{{ block.id }}">
        <div class="ff-card">
          <div class="ff-icon-wrap">
            {% if block.settings.ff_icon != blank %}
              <img class="ff-icon" src="{{ block.settings.ff_icon | image_url: width: 120 }}" alt="{{ block.settings.ff_label }}" width="{{ section.settings.ff_icon_size }}" height="{{ section.settings.ff_icon_size }}">
            {% else %}
              <div class="ff-icon-placeholder">✦</div>
            {% endif %}
          </div>
          <p class="ff-card-label">{{ block.settings.ff_label }}</p>
        </div>
        {% if block.settings.ff_hover_text != blank %}
          <div class="ff-hover-card">
            <button class="ff-close-btn" aria-label="Close">&times;</button>
            <div class="ff-hover-icon-row">
              {% if block.settings.ff_icon != blank %}
                <img class="ff-hover-icon" src="{{ block.settings.ff_icon | image_url: width: 80 }}" alt="{{ block.settings.ff_label }}" width="{{ section.settings.ff_icon_size | times: 70 | divided_by: 100 }}" height="{{ section.settings.ff_icon_size | times: 70 | divided_by: 100 }}">
              {% else %}
                <div class="ff-hover-icon-placeholder"></div>
              {% endif %}
              <p class="ff-hover-label">{{ block.settings.ff_label }}</p>
            </div>
            <p class="ff-hover-text">{{ block.settings.ff_hover_text }}</p>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>


  <!-- Grid layout: image top-left, right cards top-right, bottom cards full width -->
  <div class="ff-layout">


    <div class="ff-image-wrap">
      {% if section.settings.ff_image != blank %}
        <img
          class="ff-image"
          src="{{ section.settings.ff_image | image_url: width: 1200 }}"
          alt="{{ section.settings.ff_heading }}"
          width="1200"
          height="{{ section.settings.ff_img_height }}"
          loading="lazy"
        >
      {% else %}
        <div class="ff-image-placeholder"></div>
      {% endif %}
    </div>


    <div class="ff-right-col">
      {% for block in section.blocks %}
        {% if block.settings.ff_position == 'right' %}
          <div class="ff-card-wrap" {{ block.shopify_attributes }}>
            <div class="ff-card">
              <div class="ff-icon-wrap">
                {% if block.settings.ff_icon != blank %}
                  <img class="ff-icon" src="{{ block.settings.ff_icon | image_url: width: 120 }}" alt="{{ block.settings.ff_label }}" width="{{ section.settings.ff_icon_size }}" height="{{ section.settings.ff_icon_size }}">
                {% else %}
                  <div class="ff-icon-placeholder">✦</div>
                {% endif %}
              </div>
              <p class="ff-card-label">{{ block.settings.ff_label }}</p>
            </div>
            {% if block.settings.ff_hover_text != blank %}
              <div class="ff-hover-card">
                <div class="ff-hover-icon-row">
                  {% if block.settings.ff_icon != blank %}
                    <img class="ff-hover-icon" src="{{ block.settings.ff_icon | image_url: width: 80 }}" alt="{{ block.settings.ff_label }}" width="{{ section.settings.ff_icon_size | times: 70 | divided_by: 100 }}" height="{{ section.settings.ff_icon_size | times: 70 | divided_by: 100 }}">
                  {% else %}
                    <div class="ff-hover-icon-placeholder"></div>
                  {% endif %}
                  <p class="ff-hover-label">{{ block.settings.ff_label }}</p>
                </div>
                <p class="ff-hover-text">{{ block.settings.ff_hover_text }}</p>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>


    <!-- Bottom row: 2 cards under image -->
    <div class="ff-bottom-row">
      {% assign bottom_count = 0 %}
      {% for block in section.blocks %}
        {% if block.settings.ff_position == 'bottom' %}
          {% if bottom_count < 2 %}
            <div class="ff-card-wrap" {{ block.shopify_attributes }}>
              <div class="ff-card">
                <div class="ff-icon-wrap">
                  {% if block.settings.ff_icon != blank %}
                    <img class="ff-icon" src="{{ block.settings.ff_icon | image_url: width: 120 }}" alt="{{ block.settings.ff_label }}" width="{{ section.settings.ff_icon_size }}" height="{{ section.settings.ff_icon_size }}">
                  {% else %}
                    <div class="ff-icon-placeholder">✦</div>
                  {% endif %}
                </div>
                <p class="ff-card-label">{{ block.settings.ff_label }}</p>
              </div>
              {% if block.settings.ff_hover_text != blank %}
                <div class="ff-hover-card">
                  <div class="ff-hover-icon-row">
                    {% if block.settings.ff_icon != blank %}
                      <img class="ff-hover-icon" src="{{ block.settings.ff_icon | image_url: width: 80 }}" alt="{{ block.settings.ff_label }}" width="{{ section.settings.ff_icon_size | times: 70 | divided_by: 100 }}" height="{{ section.settings.ff_icon_size | times: 70 | divided_by: 100 }}">
                    {% else %}
                      <div class="ff-hover-icon-placeholder"></div>
                    {% endif %}
                    <p class="ff-hover-label">{{ block.settings.ff_label }}</p>
                  </div>
                  <p class="ff-hover-text">{{ block.settings.ff_hover_text }}</p>
                </div>
              {% endif %}
            </div>
            {% assign bottom_count = bottom_count | plus: 1 %}
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>

    <!-- Third bottom card: positioned under right column -->
    {% assign bottom_count = 0 %}
    {% for block in section.blocks %}
      {% if block.settings.ff_position == 'bottom' %}
        {% assign bottom_count = bottom_count | plus: 1 %}
        {% if bottom_count == 3 %}
          <div class="ff-bottom-right">
            <div class="ff-card-wrap" {{ block.shopify_attributes }}>
              <div class="ff-card">
                <div class="ff-icon-wrap">
                  {% if block.settings.ff_icon != blank %}
                    <img class="ff-icon" src="{{ block.settings.ff_icon | image_url: width: 120 }}" alt="{{ block.settings.ff_label }}" width="{{ section.settings.ff_icon_size }}" height="{{ section.settings.ff_icon_size }}">
                  {% else %}
                    <div class="ff-icon-placeholder">✦</div>
                  {% endif %}
                </div>
                <p class="ff-card-label">{{ block.settings.ff_label }}</p>
              </div>
              {% if block.settings.ff_hover_text != blank %}
                <div class="ff-hover-card">
                  <div class="ff-hover-icon-row">
                    {% if block.settings.ff_icon != blank %}
                      <img class="ff-hover-icon" src="{{ block.settings.ff_icon | image_url: width: 80 }}" alt="{{ block.settings.ff_label }}" width="{{ section.settings.ff_icon_size | times: 70 | divided_by: 100 }}" height="{{ section.settings.ff_icon_size | times: 70 | divided_by: 100 }}">
                    {% else %}
                      <div class="ff-hover-icon-placeholder"></div>
                    {% endif %}
                    <p class="ff-hover-label">{{ block.settings.ff_label }}</p>
                  </div>
                  <p class="ff-hover-text">{{ block.settings.ff_hover_text }}</p>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}


  </div>


</section>


<script>
(function() {
  // Mobile and Tablet touch interaction for hover cards
  if (window.matchMedia('(max-width: 1024px)').matches) {
    const marqueeCards = document.querySelectorAll('.ff-marquee-card');
   
    marqueeCards.forEach(card => {
      const cardElement = card.querySelector('.ff-card');
      const hoverCard = card.querySelector('.ff-hover-card');
      const closeBtn = card.querySelector('.ff-close-btn');
     
      if (cardElement && hoverCard) {
        // Open hover card on card click
        cardElement.addEventListener('click', function(e) {
          e.stopPropagation();
         
          // Close all other hover cards
          document.querySelectorAll('.ff-hover-card.active').forEach(other => {
            if (other !== hoverCard) {
              other.classList.remove('active');
            }
          });
         
          // Toggle current hover card
          hoverCard.classList.toggle('active');
        });
       
        // Close button
        if (closeBtn) {
          closeBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            hoverCard.classList.remove('active');
          });
        }
      }
    });
   
    // Close hover cards when clicking outside
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.ff-marquee-card')) {
        document.querySelectorAll('.ff-hover-card.active').forEach(card => {
          card.classList.remove('active');
        });
      }
    });
  }
})();
</script>


