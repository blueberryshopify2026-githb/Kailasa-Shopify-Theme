{% comment %}
  How To Use Section - Interactive tabs with video backgrounds and progress steps
  Features: AM/PM/PM Light/Exfoliate tabs, synced video backgrounds, progress bar, product images
{% endcomment %}


<style>
  .how-to-use-section {
    font-family: 'Montserrat', sans-serif;
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    background: #000000;
  }


  /* Video Background Container */
  .how-to-use-video-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }


  .how-to-use-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.2s ease-in-out;
  }


  .how-to-use-video.active {
    opacity: 1;
  }


  .how-to-use-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  /* Content Container */
  .how-to-use-content {
    position: relative;
    z-index: 10;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0;
  }


  /* Frosted Glass Strip - Full width at bottom with curved top edges */
  .how-to-use-strip-wrapper {
    position: relative;
    width: 100%;
    background: #fff;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    {% comment %} border-radius: 40px 40px 0 0; {% endcomment %}
    padding: 50px 80px 15px 80px;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.1);
  }


  /* Tab Content */
  .how-to-use-tab-content {
    display: none;
    position: relative;
    overflow: visible;
  }


  .how-to-use-tab-content.active {
    display: block;
  }


  /* Product Display - Separate image and name positioning */
  .how-to-use-product {
    position: relative;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
    z-index: 20;
  }


  .how-to-use-product.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }


  .how-to-use-product-image {
    position: absolute;
    max-width: 280px;
    width: auto;
    height: 350px;
    object-fit: contain;
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.25));
    margin: 0;
    display: block;
    cursor: pointer;
    transition: transform 0.3s ease, filter 0.3s ease;
  }


  .how-to-use-product-image:hover {
    transform: translateY(-5px);
    filter: drop-shadow(0 12px 25px rgba(0, 0, 0, 0.3));
  }


  .how-to-use-product-info {
    position: absolute;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 20px;
    padding: 20px 25px;
    max-width: 350px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }


  .how-to-use-product-info:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  }


  .how-to-use-product-name {
    font-size: 24px;
    font-weight: 700;
    color: #000;
    text-align: left;
    line-height: 1.3;
    margin: 0 0 8px 0;
  }


  .how-to-use-product-description {
    font-size: 14px;
    font-weight: 400;
    color: #333;
    text-align: left;
    line-height: 1.4;
    margin: 0;
    opacity: 0.9;
  }


  /* Tabs - Positioned between video and strip */
  .how-to-use-tabs {
    position: relative;
    display: flex;
    justify-content: flex-end;
    gap: 15px;
    margin-bottom: -10px;
    padding-right: 80px;
    z-index: 25;
  }


  .how-to-use-tab {
    padding: 12px 28px;
    background: #fff;
    border: 2px solid rgba(0, 0, 0, 0.1);
    border-radius: 50px;
    color: #000;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }


  .how-to-use-tab:hover {
    background: rgba(255, 255, 255, 0.8);
    border-color: rgba(0, 0, 0, 0.2);
  }


  .how-to-use-tab.active {
    background: #fff;
    border-color: #4fffff;
    color: #000;
  }


  /* Progress Bar Container */
  .how-to-use-progress {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0;
    padding-bottom: 0;
  }


  /* Progress Line */
  .how-to-use-progress-line {
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    height: 3px;
    background: #e0e0e0;
    z-index: 1;
    border-radius: 2px;
    margin: 0 20px;
    pointer-events: none;
  }


  .how-to-use-progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: {{ section.settings.accent_color | default: '#4FFFFF' }};
    transition: none;
    width: 0%;
    border-radius: 2px;
    pointer-events: none;
  }


  /* Progress Steps */
  .how-to-use-step {
    position: relative;
    z-index: 30 !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer !important;
    pointer-events: auto !important;
  }


  .how-to-use-step-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #ffffff;
    border: 3px solid #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    color: #666666;
    transition: all 0.3s ease;
    margin-bottom: 8px;
    cursor: pointer !important;
    pointer-events: auto !important;
    position: relative;
    z-index: 50 !important;
    user-select: none;
  }


  .how-to-use-step-circle:hover {
    transform: scale(1.05);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }


  .how-to-use-step.completed .how-to-use-step-circle {
    background: {{ section.settings.accent_color | default: '#4FFFFF' }};
    border-color: {{ section.settings.accent_color | default: '#4FFFFF' }};
    color: #ffffff;
  }


  .how-to-use-step.active .how-to-use-step-circle {
    background: {{ section.settings.accent_color | default: '#4FFFFF' }};
    border-color: {{ section.settings.accent_color | default: '#4FFFFF' }};
    color: #ffffff;
    transform: scale(1.15);
    box-shadow: 0 4px 12px rgba(79, 255, 255, 0.4);
  }


  @keyframes blink-pulse {
    0%, 100% {
      transform: scale(1.15);
      box-shadow: 0 4px 12px rgba(79, 255, 255, 0.4);
    }
    50% {
      transform: scale(1.3);
      box-shadow: 0 6px 20px rgba(79, 255, 255, 0.7);
    }
  }


  /* Hide mobile chapter label on desktop — desktop handles its own tab positioning */
  .htu-mobile-tabs-wrapper .htu-mobile-product-overlay {
    display: none;
  }


  .how-to-use-step-label {
    font-size: 12px;
    font-weight: 600;
    color: #333333;
    text-align: center;
    max-width: 100px;
  }






  /* Responsive */
  @media (max-width: 1024px) {
    .how-to-use-strip-wrapper {
      padding: 20px 60px 20px;
    }
   
    .how-to-use-tabs {
      position: static;
      justify-content: center;
      gap: 10px;
      margin-bottom: 15px;
      right: auto;
      top: auto;
    }


    .how-to-use-tab {
      padding: 8px 20px;
      font-size: 13px;
    }


    .how-to-use-product {
      top: -90px;
      gap: 15px;
    }


    .how-to-use-product-image {
      width: 130px;
      height: 180px;
    }


    .how-to-use-product-info {
      padding: 15px 20px;
      max-width: 280px;
      border-radius: 16px;
    }


    .how-to-use-product-name {
      font-size: 16px;
      margin-bottom: 6px;
    }


    .how-to-use-product-description {
      font-size: 12px;
    }
  }


  @media (max-width: 768px) {
    .how-to-use-strip-wrapper {
      padding: 15px 30px 20px;
      border-radius: 24px 24px 0 0;
    }


    .how-to-use-tabs {
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
    }


    .how-to-use-tab {
      padding: 6px 14px;
      font-size: 12px;
    }


    .how-to-use-step-circle {
      width: 32px;
      height: 36px;
      font-size: 14px;
    }


    .how-to-use-step-label {
      font-size: 11px;
      max-width: 70px;
    }


    .how-to-use-product {
      position: relative;
      left: 0;
      top: 0;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      margin: 20px auto 30px;
    }


    .how-to-use-product-image {
      width: 100px;
      height: 140px;
    }


    .how-to-use-product-info {
      padding: 12px 16px;
      max-width: 220px;
      border-radius: 14px;
    }


    .how-to-use-product-name {
      font-size: 13px;
      margin-bottom: 4px;
    }


    .how-to-use-product-description {
      font-size: 11px;
    }
  }


  /* =============================================
     MOBILE ONLY - max-width: 768px
     Desktop code above is NOT touched
     ============================================= */
  @media (max-width: 768px) {


    /* Section: size to content, no extra black space */
    .how-to-use-section {
      min-height: unset !important;
    }

    /* Video background: reduced height on mobile */
    .how-to-use-video-bg {
      height: {{ section.settings.mob_video_height | default: 75 }}vh !important;
      min-height: unset !important;
    }

    /* Content: matches video height so tabs land at the boundary */
    .how-to-use-content {
      justify-content: flex-end !important;
      min-height: {{ section.settings.mob_video_height | default: 75 }}vh !important;
      height: {{ section.settings.mob_video_height | default: 75 }}vh !important;
    }


    /* Tabs: centered, straddling video/strip boundary */
    .how-to-use-tabs {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      justify-content: center !important;
      align-items: center !important;
      gap: {{ section.settings.mobile_tab_gap | default: 8 }}px !important;
      margin-bottom: -20px !important;
      padding: 0 16px !important;
      position: relative !important;
      z-index: 25 !important;
      overflow-x: auto !important;
      scrollbar-width: none !important;
    }


    .how-to-use-tabs::-webkit-scrollbar { display: none !important; }


    .how-to-use-tab {
      padding: {{ section.settings.mobile_tab_padding_v | default: 10 }}px {{ section.settings.mobile_tab_padding_h | default: 18 }}px !important;
      font-size: {{ section.settings.mobile_tab_font_size | default: 13 }}px !important;
      font-weight: 600 !important;
      background: #fff !important;
      border: 2px solid rgba(0,0,0,0.1) !important;
      border-radius: 50px !important;
      white-space: nowrap !important;
      flex-shrink: 0 !important;
    }


    .how-to-use-tab.active {
      border-color: {{ section.settings.accent_color | default: '#4fffff' }} !important;
    }


    /* Strip: white area, straight top edge */
    .how-to-use-strip-wrapper {
      padding: 30px {{ section.settings.mobile_strip_padding_h | default: 20 }}px {{ section.settings.mobile_strip_padding_h | default: 20 }}px !important;
      border-radius: 0 !important;
      background: #fff !important;
    }


    /* Hide desktop-positioned product images inside strip on mobile */
    .how-to-use-product {
      display: none !important;
    }


    /* Progress steps */
    .how-to-use-step-circle {
      width: {{ section.settings.mobile_step_circle_size | default: 36 }}px !important;
      height: {{ section.settings.mobile_step_circle_size | default: 36 }}px !important;
      font-size: {{ section.settings.mobile_step_font_size | default: 14 }}px !important;
      margin-bottom: 6px !important;
    }


    .how-to-use-step-label {
      font-size: {{ section.settings.mobile_step_label_size | default: 11 }}px !important;
      max-width: 70px !important;
    }


    .how-to-use-progress-line {
      top: {{ section.settings.mobile_step_circle_size | default: 36 | divided_by: 2 }}px !important;
    }


    /* Wrapper so overlay positions relative to tabs row */
    .htu-mobile-tabs-wrapper {
      position: relative !important;
      width: 100% !important;
      z-index: 25 !important;
    }


    /* Mobile product overlay — sits directly above tabs row */
    .htu-mobile-product-overlay {
      display: flex !important;
      flex-wrap: nowrap !important;
      position: absolute !important;
      bottom: 100% !important;
      left: 0 !important;
      right: 0 !important;
      z-index: 20 !important;
      pointer-events: none !important;
      padding: 0 16px 8px 16px !important;
      align-items: flex-end !important;
      justify-content: center !important;
      gap: 8px !important;
      box-sizing: border-box !important;
    }

    .htu-mobile-product-img-wrap {
      flex: 0 0 {{ section.settings.mobile_product_img_width | default: 160 }}px !important;
      width: {{ section.settings.mobile_product_img_width | default: 160 }}px !important;
      pointer-events: auto !important;
      align-self: flex-end !important;
      overflow: visible !important;
    }

    .htu-mobile-product-img {
      width: 100% !important;
      height: auto !important;
      object-fit: contain !important;
      filter: drop-shadow(0 6px 14px rgba(0,0,0,0.25)) !important;
      display: block !important;
    }

    .htu-mobile-product-info {
      background: rgba(255, 255, 255, 0.82) !important;
      backdrop-filter: blur(20px) !important;
      -webkit-backdrop-filter: blur(20px) !important;
      border: 1px solid rgba(255,255,255,0.3) !important;
      border-radius: 16px !important;
      padding: {{ section.settings.mobile_info_padding | default: 16 }}px !important;
      flex: 0 0 {{ section.settings.mob_info_max_width | default: 240 }}px !important;
      width: {{ section.settings.mob_info_max_width | default: 240 }}px !important;
      min-width: 0 !important;
      max-width: 100% !important;
      pointer-events: auto !important;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1) !important;
      margin-bottom: 16px !important;
      overflow: hidden !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      text-align: center !important;
    }


    .htu-mobile-product-name {
      font-size: {{ section.settings.mobile_product_name_size | default: 18 }}px !important;
      font-weight: 700 !important;
      color: #000 !important;
      margin: 0 0 6px 0 !important;
      line-height: 1.3 !important;
      font-family: 'Montserrat', sans-serif !important;
      text-align: center !important;
      width: 100% !important;
    }


    .htu-mobile-product-desc {
      font-size: {{ section.settings.mobile_product_desc_size | default: 13 }}px !important;
      color: #333 !important;
      margin: 0 !important;
      line-height: 1.4 !important;
      font-family: 'Montserrat', sans-serif !important;
      text-align: center !important;
      width: 100% !important;
    }


  }


  /* =============================================
     TABLET ONLY - 769px to 1024px
     Same layout as mobile. Desktop & mobile NOT touched.
     ============================================= */
  @media (min-width: 769px) and (max-width: 1024px) {


    .how-to-use-section {
      min-height: unset !important;
    }

    /* Video background: reduced height on tablet */
    .how-to-use-video-bg {
      height: {{ section.settings.tab_video_height | default: 70 }}vh !important;
      min-height: unset !important;
    }

    .how-to-use-content {
      justify-content: flex-end !important;
      min-height: {{ section.settings.tab_video_height | default: 70 }}vh !important;
      height: {{ section.settings.tab_video_height | default: 70 }}vh !important;
    }


    /* Tabs: centered row */
    .how-to-use-tabs {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 12px !important;
      margin-bottom: -20px !important;
      padding: 0 20px !important;
      position: relative !important;
      z-index: 25 !important;
    }


    .how-to-use-tab {
      padding: 12px 24px !important;
      font-size: {{ section.settings.tablet_tab_font_size | default: 15 }}px !important;
      font-weight: 600 !important;
      background: #fff !important;
      border: 2px solid rgba(0,0,0,0.1) !important;
      border-radius: 50px !important;
      white-space: nowrap !important;
      flex-shrink: 0 !important;
    }


    .how-to-use-tab.active {
      border-color: {{ section.settings.accent_color | default: '#4fffff' }} !important;
    }


    /* Strip: white, straight top edge */
    .how-to-use-strip-wrapper {
      padding: 40px {{ section.settings.tablet_strip_padding_h | default: 40 }}px 24px !important;
      border-radius: 0 !important;
      background: #fff !important;
    }


    /* Hide desktop-positioned products inside strip */
    .how-to-use-product {
      display: none !important;
    }


    /* Progress steps */
    .how-to-use-step-circle {
      width: {{ section.settings.tablet_step_circle_size | default: 44 }}px !important;
      height: {{ section.settings.tablet_step_circle_size | default: 44 }}px !important;
      font-size: {{ section.settings.tablet_step_font_size | default: 16 }}px !important;
      margin-bottom: 8px !important;
    }


    .how-to-use-step-label {
      font-size: {{ section.settings.tablet_step_label_size | default: 13 }}px !important;
      max-width: 90px !important;
    }


    .how-to-use-progress-line {
      top: {{ section.settings.tablet_step_circle_size | default: 44 | divided_by: 2 }}px !important;
    }


    /* Tablet tabs wrapper — centered flex column */
    .htu-mobile-tabs-wrapper {
      position: relative !important;
      width: 100% !important;
      z-index: 25 !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
    }


    /* Tablet product overlay — centered, matches tab row width */
    .htu-mobile-product-overlay {
      display: flex !important;
      flex-wrap: nowrap !important;
      position: absolute !important;
      bottom: 100% !important;
      left: 50% !important;
      transform: translateX(-50%) !important;
      width: calc(100% - 40px) !important;
      max-width: 680px !important;
      z-index: 20 !important;
      pointer-events: none !important;
      padding: 0 0 10px 0 !important;
      align-items: flex-end !important;
      gap: 10px !important;
      box-sizing: border-box !important;
    }

    .htu-mobile-product-img-wrap {
      flex: 0 0 {{ section.settings.tablet_product_img_width | default: 200 }}px !important;
      width: {{ section.settings.tablet_product_img_width | default: 200 }}px !important;
      pointer-events: auto !important;
      align-self: flex-end !important;
      overflow: visible !important;
    }

    .htu-mobile-product-img {
      width: 100% !important;
      height: auto !important;
      object-fit: contain !important;
      filter: drop-shadow(0 8px 18px rgba(0,0,0,0.25)) !important;
      display: block !important;
    }

    .htu-mobile-product-info {
      background: rgba(255, 255, 255, 0.82) !important;
      backdrop-filter: blur(20px) !important;
      -webkit-backdrop-filter: blur(20px) !important;
      border: 1px solid rgba(255,255,255,0.3) !important;
      border-radius: 20px !important;
      padding: {{ section.settings.tablet_info_padding | default: 22 }}px !important;
      flex: 0 0 {{ section.settings.tab_info_max_width | default: 360 }}px !important;
      width: {{ section.settings.tab_info_max_width | default: 360 }}px !important;
      min-width: 0 !important;
      max-width: 100% !important;
      pointer-events: auto !important;
      box-shadow: 0 6px 24px rgba(0,0,0,0.1) !important;
      margin-bottom: 20px !important;
      overflow: hidden !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      text-align: center !important;
    }


    .htu-mobile-product-name {
      font-size: {{ section.settings.tablet_product_name_size | default: 24 }}px !important;
      font-weight: 700 !important;
      color: #000 !important;
      margin: 0 0 8px 0 !important;
      line-height: 1.3 !important;
      font-family: 'Montserrat', sans-serif !important;
      text-align: center !important;
      width: 100% !important;
    }


    .htu-mobile-product-desc {
      font-size: {{ section.settings.tablet_product_desc_size | default: 15 }}px !important;
      color: #333 !important;
      margin: 0 !important;
      line-height: 1.5 !important;
      font-family: 'Montserrat', sans-serif !important;
      text-align: center !important;
      width: 100% !important;
    }


  }
</style>


<section class="how-to-use-section full-width" id="how-to-use-{{ section.id }}">
  <!-- Video Backgrounds -->
  <div class="how-to-use-video-bg">
    {% for block in section.blocks %}
      {% assign step_in_tab = 0 %}
      {% for check_block in section.blocks %}
        {% if check_block.settings.tab_id == block.settings.tab_id %}
          {% assign step_in_tab = step_in_tab | plus: 1 %}
          {% if check_block == block %}
            {% break %}
          {% endif %}
        {% endif %}
      {% endfor %}
     
      <div class="how-to-use-video {% if forloop.first %}active{% endif %}"
           data-tab="{{ block.settings.tab_id }}"
           data-step="{{ step_in_tab }}"
           id="video-{{ section.id }}-{{ forloop.index }}">
        {% if block.settings.video_url %}
          <video muted playsinline preload="metadata">
            <source src="{{ block.settings.video_url }}" type="video/mp4">
          </video>
        {% endif %}
      </div>
    {% endfor %}
  </div>


  <!-- Content -->
  <div class="how-to-use-content">


    <!-- Tabs + product overlay wrapper -->
    <div class="htu-mobile-tabs-wrapper">


      <!-- Mobile product overlay (hidden on desktop via CSS) -->
      <div class="htu-mobile-product-overlay" id="htu-mobile-overlay-{{ section.id }}" style="display:none;">
        <div class="htu-mobile-product-img-wrap" id="htu-mobile-img-wrap-{{ section.id }}"></div>
        <div class="htu-mobile-product-info" id="htu-mobile-info-{{ section.id }}">
          <div class="htu-mobile-product-name" id="htu-mobile-name-{{ section.id }}"></div>
          <div class="htu-mobile-product-desc" id="htu-mobile-desc-{{ section.id }}"></div>
        </div>
      </div>


      <!-- Tabs - Positioned between video and strip -->
      <div class="how-to-use-tabs">
      <button class="how-to-use-tab active" data-tab="am" onclick="switchTab('am', '{{ section.id }}')">AM</button>
      <button class="how-to-use-tab" data-tab="pm" onclick="switchTab('pm', '{{ section.id }}')">PM</button>
      <button class="how-to-use-tab" data-tab="pm-light" onclick="switchTab('pm-light', '{{ section.id }}')">PM + Light</button>
      <button class="how-to-use-tab" data-tab="exfoliate" onclick="switchTab('exfoliate', '{{ section.id }}')">Exfoliate</button>
    </div>


    </div><!-- end htu-mobile-tabs-wrapper -->


    <!-- Frosted Glass Strip Wrapper - Contains progress only -->
    <div class="how-to-use-strip-wrapper">


      <!-- Tab Contents -->
      {% assign tabs = "am,pm,pm-light,exfoliate" | split: "," %}
      {% for tab in tabs %}
        <div class="how-to-use-tab-content {% if forloop.first %}active{% endif %}" data-tab="{{ tab }}">
         
          <!-- Progress Bar -->
          <div class="how-to-use-progress">
            <div class="how-to-use-progress-line">
              <div class="how-to-use-progress-fill" id="progress-fill-{{ section.id }}-{{ tab }}"></div>
            </div>
           
            {% assign step_count = 0 %}
            {% for block in section.blocks %}
              {% if block.settings.tab_id == tab %}
                {% assign step_count = step_count | plus: 1 %}
              {% endif %}
            {% endfor %}
           
            {% assign current_step = 0 %}
            {% for block in section.blocks %}
              {% if block.settings.tab_id == tab %}
                {% assign current_step = current_step | plus: 1 %}
                <div class="how-to-use-step {% if current_step == 1 %}active{% endif %}"
                     data-step="{{ current_step }}"
                     onclick="forceGoToStep({{ current_step }}, '{{ tab }}', '{{ section.id }}');">
                  <div class="how-to-use-step-circle"
                       onclick="forceGoToStep({{ current_step }}, '{{ tab }}', '{{ section.id }}');">{{ current_step }}</div>
                  <div class="how-to-use-step-label"
                       onclick="forceGoToStep({{ current_step }}, '{{ tab }}', '{{ section.id }}');">{{ block.settings.step_label }}</div>
                </div>
              {% endif %}
            {% endfor %}
          </div>


          <!-- Product Images - Positioned relative to strip-wrapper -->
          {% assign product_step = 0 %}
          {% for block in section.blocks %}
            {% if block.settings.tab_id == tab %}
              {% assign product_step = product_step | plus: 1 %}
              <div class="how-to-use-product {% if product_step == 1 %}active{% endif %}"
                   data-step="{{ product_step }}"
                   data-tab="{{ tab }}">
                {% if block.settings.product_image %}
                  {% if block.settings.product_link != blank %}
                    <a href="{{ block.settings.product_link }}">
                      <img src="{{ block.settings.product_image | image_url: width: 400 }}"
                           alt="{{ block.settings.product_name }}"
                           class="how-to-use-product-image"
                           style="left: {{ block.settings.image_position_x | default: -50 }}px; top: {{ block.settings.image_position_y | default: -250 }}px;"
                           width="400"
                           height="480">
                    </a>
                  {% else %}
                    <img src="{{ block.settings.product_image | image_url: width: 400 }}"
                         alt="{{ block.settings.product_name }}"
                         class="how-to-use-product-image"
                         style="left: {{ block.settings.image_position_x | default: -50 }}px; top: {{ block.settings.image_position_y | default: -250 }}px;"
                         width="400"
                         height="480">
                  {% endif %}
                {% endif %}
                {% if block.settings.product_link != blank %}
                  <a href="{{ block.settings.product_link }}" style="text-decoration: none;">
                    <div class="how-to-use-product-info"
                         style="left: {{ block.settings.name_position_x | default: 250 }}px; top: {{ block.settings.name_position_y | default: -100 }}px;">
                      <div class="how-to-use-product-name">{{ block.settings.product_name }}</div>
                      {% if block.settings.product_description != blank %}
                        <div class="how-to-use-product-description">{{ block.settings.product_description }}</div>
                      {% endif %}
                    </div>
                  </a>
                {% else %}
                  <div class="how-to-use-product-info"
                       style="left: {{ block.settings.name_position_x | default: 250 }}px; top: {{ block.settings.name_position_y | default: -100 }}px;">
                    <div class="how-to-use-product-name">{{ block.settings.product_name }}</div>
                    {% if block.settings.product_description != blank %}
                      <div class="how-to-use-product-description">{{ block.settings.product_description }}</div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}


        </div>
      {% endfor %}
    </div>
  </div>
</section>


<script>
(function () {
  'use strict';
  window.howToUseData = window.howToUseData || {};

  // ── Cached DOM refs per section — built once, reused everywhere ──────────
  var _cache = {};
  function getCache(sid) {
    if (_cache[sid]) return _cache[sid];
    var root = document.getElementById('how-to-use-' + sid);
    if (!root) return null;
    var c = {
      root: root,
      videos: {},    // keyed by tab+step: "am-1"
      fills: {},     // keyed by tabId
      tabContents: {},
      stepCounts: {}
    };
    // Index all video divs once
    root.querySelectorAll('.how-to-use-video').forEach(function(div) {
      c.videos[div.dataset.tab + '-' + div.dataset.step] = div;
    });
    // Index fills
    root.querySelectorAll('[id^="progress-fill-"]').forEach(function(el) {
      var parts = el.id.split('-');
      c.fills[parts[parts.length - 1]] = el;
    });
    // Index tab contents
    root.querySelectorAll('.how-to-use-tab-content').forEach(function(el) {
      c.tabContents[el.dataset.tab] = el;
      c.stepCounts[el.dataset.tab] = el.querySelectorAll('.how-to-use-step').length;
    });
    _cache[sid] = c;
    return c;
  }

  // ── Preload a single video — no-op if already loading/loaded ─────────────
  function preloadVideo(vid) {
    if (!vid) return;
    if (vid.preload === 'auto') return;
    vid.preload = 'auto';
    vid.load();
  }

  // ── Stop current video only (not all) ───────────────────────────────────
  function stopCurrent(sid) {
    var d = window.howToUseData[sid];
    if (!d) return;
    if (d.rafId) { cancelAnimationFrame(d.rafId); d.rafId = null; }
    var c = getCache(sid);
    if (!c) return;
    var key = d.currentTab + '-' + d.currentStep;
    var div = c.videos[key];
    if (div) {
      var v = div.querySelector('video');
      if (v) { v.pause(); v.currentTime = 0; }
    }
  }

  // ── Stop all videos (used on tab switch / reset) ─────────────────────────
  function stopAllVideos(sid) {
    var d = window.howToUseData[sid];
    if (!d) return;
    if (d.rafId) { cancelAnimationFrame(d.rafId); d.rafId = null; }
    var c = getCache(sid);
    if (!c) return;
    Object.values(c.videos).forEach(function(div) {
      var v = div.querySelector('video');
      if (v && !v.paused) { v.pause(); v.currentTime = 0; }
    });
  }

  // ── Update progress circles + fill bar ───────────────────────────────────
  function updateProgress(sid, tabId, stepNumber) {
    var c = getCache(sid);
    if (!c) return;
    var tabContent = c.tabContents[tabId];
    if (!tabContent) return;
    var totalSteps = c.stepCounts[tabId];

    tabContent.querySelectorAll('.how-to-use-step').forEach(function(step, i) {
      var n = i + 1;
      step.classList.remove('active', 'blink', 'completed');
      if (n < stepNumber) step.classList.add('completed');
      else if (n === stepNumber) {
        step.classList.add('active');
        if (stepNumber > 1) step.classList.add('completed');
      }
    });

    var fill = c.fills[tabId];
    if (fill && totalSteps > 1) {
      var pct = stepNumber === 1 ? 0 : ((stepNumber - 1) / (totalSteps - 1)) * 100;
      fill.style.width = pct + '%';
    }

    tabContent.querySelectorAll('.how-to-use-product').forEach(function(p, i) {
      p.classList.toggle('active', i + 1 === stepNumber);
    });
  }

  // ── Play the current step's video ────────────────────────────────────────
  function playCurrentVideo(sid) {
    var d = window.howToUseData[sid];
    if (!d) return;
    var tabId = d.currentTab;
    var stepNumber = d.currentStep;
    var c = getCache(sid);
    if (!c) return;

    if (d.rafId) { cancelAnimationFrame(d.rafId); d.rafId = null; }

    // Hide all video divs; show only target
    var key = tabId + '-' + stepNumber;
    Object.keys(c.videos).forEach(function(k) {
      c.videos[k].classList.toggle('active', k === key);
    });

    var target = c.videos[key];
    if (!target) return;
    var video = target.querySelector('video');
    if (!video) return;

    // Ensure buffered
    preloadVideo(video);
    // Preload next step ahead of time
    preloadVideo((c.videos[tabId + '-' + (stepNumber + 1)] || {querySelector: function(){}}).querySelector('video'));

    if (video.readyState < 3) {
      var onReady = function() {
        video.removeEventListener('canplaythrough', onReady);
        video.currentTime = 0;
        video.play().then(function() {
          d.rafId = requestAnimationFrame(updateBar);
        }).catch(function(){});
      };
      video.addEventListener('canplaythrough', onReady);
      return;
    }

    video.currentTime = 0;

    // Progress bar rAF loop — cached refs, throttled to 100ms
    var fill = c.fills[tabId];
    var totalSteps = c.stepCounts[tabId] || 1;
    var lastUpdate = 0;

    function updateBar(ts) {
      if (!d.rafId) return;
      if (ts - lastUpdate > 100) {
        lastUpdate = ts;
        if (fill && video.duration > 0 && totalSteps > 1) {
          var stepProg = video.currentTime / video.duration;
          var base  = stepNumber === 1 ? 0 : ((stepNumber - 1) / (totalSteps - 1)) * 100;
          var range = (1 / (totalSteps - 1)) * 100;
          fill.style.width = Math.min(base + stepProg * range, 100) + '%';
        }
      }
      d.rafId = requestAnimationFrame(updateBar);
    }

    // Clean up old ended listener
    if (video._htuEnded) video.removeEventListener('ended', video._htuEnded);
    video._htuEnded = function () {
      if (d.rafId) { cancelAnimationFrame(d.rafId); d.rafId = null; }
      onVideoEnded(sid);
    };
    video.addEventListener('ended', video._htuEnded);

    video.play().then(function () {
      d.rafId = requestAnimationFrame(updateBar);
    }).catch(function () {});
  }

  // ── Advance to next step when video ends ────────────────────────────────
  function onVideoEnded(sid) {
    var d = window.howToUseData[sid];
    if (!d || d.isProgressing) return;
    d.isProgressing = true;
    var tabId = d.currentTab;
    var c = getCache(sid);
    var totalSteps = c ? c.stepCounts[tabId] : 0;
    d.currentStep = d.currentStep < totalSteps ? d.currentStep + 1 : 1;
    updateProgress(sid, tabId, d.currentStep);
    playCurrentVideo(sid);
    setTimeout(function () { d.isProgressing = false; }, 300);
  }

  // ── Public API ────────────────────────────────────────────────────────────
  window.initHowToUse = function (sid) {
    window.howToUseData[sid] = { currentTab: 'am', currentStep: 1, isProgressing: false, rafId: null };
    // Pre-buffer AM videos with stagger — playback starts via IntersectionObserver
    var c = getCache(sid);
    if (c) {
      var amVids = Object.keys(c.videos)
        .filter(function(k) { return k.indexOf('am-') === 0; })
        .sort()
        .map(function(k) { return c.videos[k].querySelector('video'); });
      amVids.forEach(function(v, i) {
        setTimeout(function() { preloadVideo(v); }, i * 150);
      });
      // Pre-buffer step 1 of the other tabs so they're ready before the user switches
      var otherTabs = ['pm', 'pm-light', 'exfoliate'];
      otherTabs.forEach(function(tab, ti) {
        setTimeout(function() {
          var firstKey = tab + '-1';
          var div = c.videos[firstKey];
          if (div) preloadVideo(div.querySelector('video'));
        }, 2000 + ti * 2000);
      });
    }
  };

  window.switchTab = function (tabId, sid) {
    var d = window.howToUseData[sid];
    if (!d) return;
    stopAllVideos(sid);
    d.currentTab = tabId;
    d.currentStep = 1;
    var c = getCache(sid);
    if (!c) return;
    // Update tab buttons
    c.root.querySelectorAll('.how-to-use-tab').forEach(function(t) {
      t.classList.toggle('active', t.dataset.tab === tabId);
    });
    // Update tab content panels
    Object.keys(c.tabContents).forEach(function(t) {
      c.tabContents[t].classList.toggle('active', t === tabId);
    });
    // Pre-buffer new tab's videos
    var newVids = Object.keys(c.videos)
      .filter(function(k) { return k.indexOf(tabId + '-') === 0; })
      .sort()
      .map(function(k) { return c.videos[k].querySelector('video'); });
    newVids.forEach(function(v, i) {
      setTimeout(function() { preloadVideo(v); }, i * 150);
    });
    updateProgress(sid, tabId, 1);
    playCurrentVideo(sid);
    if (window.innerWidth <= 1024) htuUpdateMobileOverlay(tabId, 1, sid);
  };

  window.forceGoToStep = function (stepNumber, tabId, sid) {
    var d = window.howToUseData[sid];
    if (!d || d.currentTab !== tabId) return;
    stopCurrent(sid);
    d.currentStep = stepNumber;
    d.isProgressing = false;
    updateProgress(sid, tabId, stepNumber);
    playCurrentVideo(sid);
    if (window.innerWidth <= 1024) htuUpdateMobileOverlay(tabId, stepNumber, sid);
  };

  // ── Mobile/tablet product overlay ─────────────────────────────────────────
  var HTU_MOBILE_DATA = {
    {% assign tabs_list = "am,pm,pm-light,exfoliate" | split: "," %}
    {% for tab in tabs_list %}
    "{{ tab }}": [
      {% assign s = 0 %}
      {% for block in section.blocks %}
        {% if block.settings.tab_id == tab %}
          {% assign s = s | plus: 1 %}
          {
            step: {{ s }},
            name: {{ block.settings.product_name | default: '' | json }},
            desc: {{ block.settings.product_description | default: '' | json }},
            link: {{ block.settings.product_link | default: '' | json }},
            img: "{% if block.settings.product_image %}{{ block.settings.product_image | image_url: width: 300 }}{% endif %}",
            mobileImgX: {{ block.settings.mobile_image_x | default: 0 }},
            mobileImgY: {{ block.settings.mobile_image_y | default: 0 }},
            mobileInfoX: {{ block.settings.mobile_info_x | default: 0 }},
            mobileInfoY: {{ block.settings.mobile_info_y | default: 0 }},
            tabletImgX: {{ block.settings.tablet_image_x | default: 0 }},
            tabletImgY: {{ block.settings.tablet_image_y | default: 0 }},
            tabletInfoX: {{ block.settings.tablet_info_x | default: 0 }},
            tabletInfoY: {{ block.settings.tablet_info_y | default: 0 }}
          }{% unless forloop.last %},{% endunless %}
        {% endif %}
      {% endfor %}
    ]{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  // Cache overlay DOM refs — queried once
  var _overlayCache = null;
  function getOverlayEls(sid) {
    if (_overlayCache) return _overlayCache;
    _overlayCache = {
      overlay: document.getElementById('htu-mobile-overlay-' + sid),
      imgWrap: document.getElementById('htu-mobile-img-wrap-' + sid),
      nameEl:  document.getElementById('htu-mobile-name-' + sid),
      descEl:  document.getElementById('htu-mobile-desc-' + sid),
      infoEl:  document.getElementById('htu-mobile-info-' + sid)
    };
    return _overlayCache;
  }

  // Track last rendered overlay state to skip redundant DOM writes
  var _lastOverlay = { tabId: null, stepNumber: null };

  function htuUpdateMobileOverlay(tabId, stepNumber, sid) {
    if (window.innerWidth > 1024) return;
    // Skip if nothing changed
    if (_lastOverlay.tabId === tabId && _lastOverlay.stepNumber === stepNumber) return;
    _lastOverlay.tabId = tabId;
    _lastOverlay.stepNumber = stepNumber;

    var els = getOverlayEls(sid || '{{ section.id }}');
    if (!els.overlay) return;
    els.overlay.style.display = 'flex';

    var steps = HTU_MOBILE_DATA[tabId] || [];
    var step = null;
    for (var i = 0; i < steps.length; i++) { if (steps[i].step === stepNumber) { step = steps[i]; break; } }
    if (!step) step = steps[0];
    if (!step) return;

    var isTablet = window.innerWidth >= 769 && window.innerWidth <= 1024;
    var imgX  = isTablet ? step.tabletImgX  : step.mobileImgX;
    var imgY  = isTablet ? step.tabletImgY  : step.mobileImgY;
    var infoX = isTablet ? step.tabletInfoX : step.mobileInfoX;
    var infoY = isTablet ? step.tabletInfoY : step.mobileInfoY;

    els.imgWrap.style.transform = 'translate(' + imgX + 'px,' + imgY + 'px)';

    // Only rebuild image DOM if src changed
    var existingImg = els.imgWrap.querySelector('img');
    if (!existingImg || existingImg.src !== step.img) {
      els.imgWrap.innerHTML = '';
      if (step.img) {
        var img = document.createElement('img');
        img.src = step.img;
        img.alt = step.name || '';
        img.className = 'htu-mobile-product-img';
        if (step.link) {
          var a = document.createElement('a');
          a.href = step.link;
          a.appendChild(img);
          els.imgWrap.appendChild(a);
        } else {
          els.imgWrap.appendChild(img);
        }
      }
    }

    if (els.infoEl) els.infoEl.style.transform = 'translate(' + infoX + 'px,' + infoY + 'px)';
    if (els.nameEl) els.nameEl.textContent = step.name || '';
    if (els.descEl) els.descEl.textContent = step.desc || '';
  }

  // ── Tablet overlay width sync — debounced ─────────────────────────────────
  var _syncTimer = null;
  function htuSyncTabletOverlayWidth(sid) {
    if (window.innerWidth < 769 || window.innerWidth > 1024) return;
    var tabsRow = document.querySelector('#how-to-use-' + sid + ' .how-to-use-tabs');
    var overlay = document.getElementById('htu-mobile-overlay-' + sid);
    if (!tabsRow || !overlay) return;
    var tabsRect = tabsRow.getBoundingClientRect();
    overlay.style.width = tabsRect.width + 'px';
    overlay.style.left = (tabsRect.left - tabsRow.parentElement.getBoundingClientRect().left) + 'px';
    overlay.style.transform = 'none';
  }

  // ── Init on DOMContentLoaded ──────────────────────────────────────────────
  document.addEventListener('DOMContentLoaded', function () {
    var sid = '{{ section.id }}';
    window.initHowToUse(sid);

    // IntersectionObserver: start from step 1 when section enters viewport
    var htuEl = document.getElementById('how-to-use-' + sid);
    if (htuEl && 'IntersectionObserver' in window) {
      var isVisible = false;
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && !isVisible) {
            isVisible = true;
            var d = window.howToUseData[sid];
            if (d) {
              stopAllVideos(sid);
              d.currentStep = 1;
              d.isProgressing = false;
              updateProgress(sid, d.currentTab, 1);
              playCurrentVideo(sid);
              if (window.innerWidth <= 1024) htuUpdateMobileOverlay(d.currentTab, 1, sid);
            }
          } else if (!entry.isIntersecting && isVisible) {
            isVisible = false;
            var d = window.howToUseData[sid];
            if (d) {
              stopAllVideos(sid);
              d.currentStep = 1;
              d.isProgressing = false;
              updateProgress(sid, d.currentTab, 1);
            }
          }
        });
      }, { threshold: 0.3 });
      obs.observe(htuEl);
    }

    // MutationObserver for overlay sync — single observer, debounced handler
    if (window.innerWidth <= 1024 && htuEl) {
      var lastMutStep = 0;
      var mobObs = new MutationObserver(function () {
        var d = window.howToUseData[sid];
        if (!d || d.currentStep === lastMutStep) return;
        lastMutStep = d.currentStep;
        htuUpdateMobileOverlay(d.currentTab, d.currentStep, sid);
      });
      htuEl.querySelectorAll('.how-to-use-step').forEach(function (el) {
        mobObs.observe(el, { attributes: true, attributeFilter: ['class'] });
      });

      htuUpdateMobileOverlay('am', 1, sid);
    }

    // Tablet overlay width sync
    if (window.innerWidth >= 769 && window.innerWidth <= 1024) {
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { htuSyncTabletOverlayWidth(sid); });
      });
      var resizeTimer = null;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function () { htuSyncTabletOverlayWidth(sid); }, 150);
      });
    }
  });
})();
</script>


{% schema %}
{
  "name": "How To Use",
  "tag": "section",
  "class": "how-to-use-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4FFFFF"
    },
    {
      "type": "header",
      "content": "Mobile Settings"
    },
    {
      "type": "range",
      "id": "mob_video_height",
      "label": "Mobile Video Height",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "vh",
      "default": 80,
      "info": "Height of the background video on mobile as percentage of viewport height"
    },
    {
      "type": "range",
      "id": "mobile_tab_font_size",
      "min": 10, "max": 18, "step": 1, "unit": "px",
      "label": "Mobile Tab Font Size",
      "default": 13
    },
    {
      "type": "range",
      "id": "mobile_tab_padding_v",
      "min": 6, "max": 16, "step": 1, "unit": "px",
      "label": "Mobile Tab Vertical Padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_tab_padding_h",
      "min": 10, "max": 30, "step": 2, "unit": "px",
      "label": "Mobile Tab Horizontal Padding",
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_tab_gap",
      "min": 4, "max": 16, "step": 2, "unit": "px",
      "label": "Mobile Tab Gap",
      "default": 6
    },
    {
      "type": "range",
      "id": "mobile_strip_padding_h",
      "min": 12, "max": 40, "step": 2, "unit": "px",
      "label": "Mobile Strip Horizontal Padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_step_circle_size",
      "min": 28, "max": 48, "step": 2, "unit": "px",
      "label": "Mobile Step Circle Size",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_step_font_size",
      "min": 10, "max": 18, "step": 1, "unit": "px",
      "label": "Mobile Step Number Font Size",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_step_label_size",
      "min": 9, "max": 14, "step": 1, "unit": "px",
      "label": "Mobile Step Label Font Size",
      "default": 11
    },
    {
      "type": "range",
      "id": "mobile_product_img_width",
      "min": 60, "max": 300, "step": 5, "unit": "px",
      "label": "Mobile Product Image Width",
      "default": 200
    },
    {
      "type": "range",
      "id": "mob_info_max_width",
      "min": 120, "max": 400, "step": 10, "unit": "px",
      "label": "Mobile Info Box Max Width",
      "info": "Maximum width of the glassmorphism info box on mobile",
      "default": 220
    },
    {
      "type": "range",
      "id": "mobile_info_padding",
      "min": 10, "max": 28, "step": 2, "unit": "px",
      "label": "Mobile Info Box Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_product_name_size",
      "min": 14, "max": 26, "step": 1, "unit": "px",
      "label": "Mobile Product Name Font Size",
