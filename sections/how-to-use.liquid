{% comment %}
  How To Use Section - Interactive tabs with video backgrounds and progress steps
  Features: AM/PM/PM Light/Exfoliate tabs, synced video backgrounds, progress bar, product images
{% endcomment %}

<style>
  .how-to-use-section {
    font-family: 'Montserrat', sans-serif;
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    background: #000000;
  }

  /* Video Background Container */
  .how-to-use-video-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .how-to-use-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }

  .how-to-use-video.active {
    opacity: 1;
  }

  .how-to-use-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Content Container */
  .how-to-use-content {
    position: relative;
    z-index: 10;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0;
  }

  /* Frosted Glass Strip - Full width at bottom with curved top edges */
  .how-to-use-strip-wrapper {
    position: relative;
    width: 100%;
    background: #fff;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    {% comment %} border-radius: 40px 40px 0 0; {% endcomment %}
    padding: 50px 80px 15px 80px;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.1);
  }

  /* Tab Content */
  .how-to-use-tab-content {
    display: none;
    position: relative;
    overflow: visible;
  }

  .how-to-use-tab-content.active {
    display: block;
  }

  /* Product Display - Separate image and name positioning */
  .how-to-use-product {
    position: relative;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
    z-index: 20;
  }

  .how-to-use-product.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .how-to-use-product-image {
    position: absolute;
    max-width: 280px;
    width: auto;
    height: 350px;
    object-fit: contain;
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.25));
    margin: 0;
    display: block;
    cursor: pointer;
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .how-to-use-product-image:hover {
    transform: translateY(-5px);
    filter: drop-shadow(0 12px 25px rgba(0, 0, 0, 0.3));
  }

  .how-to-use-product-info {
    position: absolute;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 20px;
    padding: 20px 25px;
    max-width: 350px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }

  .how-to-use-product-info:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  }

  .how-to-use-product-name {
    font-size: 24px;
    font-weight: 700;
    color: #000;
    text-align: left;
    line-height: 1.3;
    margin: 0 0 8px 0;
  }

  .how-to-use-product-description {
    font-size: 14px;
    font-weight: 400;
    color: #333;
    text-align: left;
    line-height: 1.4;
    margin: 0;
    opacity: 0.9;
  }

  /* Tabs - Positioned between video and strip */
  .how-to-use-tabs {
    position: relative;
    display: flex;
    justify-content: flex-end;
    gap: 15px;
    margin-bottom: -20px;
    padding-right: 80px;
    z-index: 25;
  }

  .how-to-use-tab {
    padding: 12px 28px;
    background: #fff;
    border: 2px solid rgba(0, 0, 0, 0.1);
    border-radius: 50px;
    color: #000;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .how-to-use-tab:hover {
    background: rgba(255, 255, 255, 0.8);
    border-color: rgba(0, 0, 0, 0.2);
  }

  .how-to-use-tab.active {
    background: #fff;
    border-color: #4fffff;
    color: #000;
  }

  /* Progress Bar Container */
  .how-to-use-progress {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  /* Progress Line */
  .how-to-use-progress-line {
    position: absolute;
    top: 20px;
    left: 0;
    right: 0;
    height: 3px;
    background: #e0e0e0;
    z-index: 1;
    border-radius: 2px;
    margin: 0 20px;
    pointer-events: none;
  }

  .how-to-use-progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: {{ section.settings.accent_color | default: '#4FFFFF' }};
    transition: none;
    width: 0%;
    border-radius: 2px;
    pointer-events: none;
  }

  /* Progress Steps */
  .how-to-use-step {
    position: relative;
    z-index: 30 !important;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer !important;
    pointer-events: auto !important;
  }

  .how-to-use-step-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #ffffff;
    border: 3px solid #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    color: #666666;
    transition: all 0.3s ease;
    margin-bottom: 8px;
    cursor: pointer !important;
    pointer-events: auto !important;
    position: relative;
    z-index: 50 !important;
    user-select: none;
  }

  .how-to-use-step-circle:hover {
    transform: scale(1.05);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .how-to-use-step.completed .how-to-use-step-circle {
    background: {{ section.settings.accent_color | default: '#4FFFFF' }};
    border-color: {{ section.settings.accent_color | default: '#4FFFFF' }};
    color: #ffffff;
  }

  .how-to-use-step.active .how-to-use-step-circle {
    background: {{ section.settings.accent_color | default: '#4FFFFF' }};
    border-color: {{ section.settings.accent_color | default: '#4FFFFF' }};
    color: #ffffff;
    transform: scale(1.15);
    box-shadow: 0 4px 12px rgba(79, 255, 255, 0.4);
  }

  @keyframes blink-pulse {
    0%, 100% { 
      transform: scale(1.15);
      box-shadow: 0 4px 12px rgba(79, 255, 255, 0.4);
    }
    50% { 
      transform: scale(1.3);
      box-shadow: 0 6px 20px rgba(79, 255, 255, 0.7);
    }
  }

  .how-to-use-step.active.blink .how-to-use-step-circle {
    animation: blink-pulse 0.6s ease-in-out 2;
  }

  .how-to-use-step-label {
    font-size: 12px;
    font-weight: 600;
    color: #333333;
    text-align: center;
    max-width: 100px;
  }



  /* Responsive */
  @media (max-width: 1024px) {
    .how-to-use-strip-wrapper {
      padding: 20px 60px 20px;
    }
    
    .how-to-use-tabs {
      position: static;
      justify-content: center;
      gap: 10px;
      margin-bottom: 15px;
      right: auto;
      top: auto;
    }

    .how-to-use-tab {
      padding: 8px 20px;
      font-size: 13px;
    }

    .how-to-use-product {
      top: -90px;
      gap: 15px;
    }

    .how-to-use-product-image {
      width: 130px;
      height: 180px;
    }

    .how-to-use-product-info {
      padding: 15px 20px;
      max-width: 280px;
      border-radius: 16px;
    }

    .how-to-use-product-name {
      font-size: 16px;
      margin-bottom: 6px;
    }

    .how-to-use-product-description {
      font-size: 12px;
    }
  }

  @media (max-width: 768px) {
    .how-to-use-strip-wrapper {
      padding: 15px 30px 20px;
      border-radius: 24px 24px 0 0;
    }

    .how-to-use-tabs {
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
    }

    .how-to-use-tab {
      padding: 6px 14px;
      font-size: 12px;
    }

    .how-to-use-step-circle {
      width: 32px;
      height: 36px;
      font-size: 14px;
    }

    .how-to-use-step-label {
      font-size: 11px;
      max-width: 70px;
    }

    .how-to-use-product {
      position: relative;
      left: 0;
      top: 0;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      margin: 20px auto 30px;
    }

    .how-to-use-product-image {
      width: 100px;
      height: 140px;
    }

    .how-to-use-product-info {
      padding: 12px 16px;
      max-width: 220px;
      border-radius: 14px;
    }

    .how-to-use-product-name {
      font-size: 13px;
      margin-bottom: 4px;
    }

    .how-to-use-product-description {
      font-size: 11px;
    }
  }
</style>

<section class="how-to-use-section full-width" id="how-to-use-{{ section.id }}">
  <!-- Video Backgrounds -->
  <div class="how-to-use-video-bg">
    {% for block in section.blocks %}
      {% assign step_in_tab = 0 %}
      {% for check_block in section.blocks %}
        {% if check_block.settings.tab_id == block.settings.tab_id %}
          {% assign step_in_tab = step_in_tab | plus: 1 %}
          {% if check_block == block %}
            {% break %}
          {% endif %}
        {% endif %}
      {% endfor %}
      
      <div class="how-to-use-video {% if forloop.first %}active{% endif %}" 
           data-tab="{{ block.settings.tab_id }}"
           data-step="{{ step_in_tab }}"
           id="video-{{ section.id }}-{{ forloop.index }}">
        {% if block.settings.video_url %}
          <video muted playsinline preload="metadata">
            <source src="{{ block.settings.video_url }}" type="video/mp4">
          </video>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <!-- Content -->
  <div class="how-to-use-content">
    <!-- Tabs - Positioned between video and strip -->
    <div class="how-to-use-tabs">
      <button class="how-to-use-tab active" data-tab="am" onclick="switchTab('am', '{{ section.id }}')">AM</button>
      <button class="how-to-use-tab" data-tab="pm" onclick="switchTab('pm', '{{ section.id }}')">PM</button>
      <button class="how-to-use-tab" data-tab="pm-light" onclick="switchTab('pm-light', '{{ section.id }}')">PM + Light</button>
      <button class="how-to-use-tab" data-tab="exfoliate" onclick="switchTab('exfoliate', '{{ section.id }}')">Exfoliate</button>
    </div>

    <!-- Frosted Glass Strip Wrapper - Contains progress only -->
    <div class="how-to-use-strip-wrapper">

      <!-- Tab Contents -->
      {% assign tabs = "am,pm,pm-light,exfoliate" | split: "," %}
      {% for tab in tabs %}
        <div class="how-to-use-tab-content {% if forloop.first %}active{% endif %}" data-tab="{{ tab }}">
          
          <!-- Progress Bar -->
          <div class="how-to-use-progress">
            <div class="how-to-use-progress-line">
              <div class="how-to-use-progress-fill" id="progress-fill-{{ section.id }}-{{ tab }}"></div>
            </div>
            
            {% assign step_count = 0 %}
            {% for block in section.blocks %}
              {% if block.settings.tab_id == tab %}
                {% assign step_count = step_count | plus: 1 %}
              {% endif %}
            {% endfor %}
            
            {% assign current_step = 0 %}
            {% for block in section.blocks %}
              {% if block.settings.tab_id == tab %}
                {% assign current_step = current_step | plus: 1 %}
                <div class="how-to-use-step {% if current_step == 1 %}active{% endif %}" 
                     data-step="{{ current_step }}"
                     onclick="forceGoToStep({{ current_step }}, '{{ tab }}', '{{ section.id }}');">
                  <div class="how-to-use-step-circle" 
                       onclick="forceGoToStep({{ current_step }}, '{{ tab }}', '{{ section.id }}');">{{ current_step }}</div>
                  <div class="how-to-use-step-label" 
                       onclick="forceGoToStep({{ current_step }}, '{{ tab }}', '{{ section.id }}');">{{ block.settings.step_label }}</div>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <!-- Product Images - Positioned relative to strip-wrapper -->
          {% assign product_step = 0 %}
          {% for block in section.blocks %}
            {% if block.settings.tab_id == tab %}
              {% assign product_step = product_step | plus: 1 %}
              <div class="how-to-use-product {% if product_step == 1 %}active{% endif %}" 
                   data-step="{{ product_step }}"
                   data-tab="{{ tab }}">
                {% if block.settings.product_image %}
                  {% if block.settings.product_link != blank %}
                    <a href="{{ block.settings.product_link }}">
                      <img src="{{ block.settings.product_image | image_url: width: 400 }}" 
                           alt="{{ block.settings.product_name }}"
                           class="how-to-use-product-image"
                           style="left: {{ block.settings.image_position_x | default: -50 }}px; top: {{ block.settings.image_position_y | default: -250 }}px;"
                           width="400"
                           height="480">
                    </a>
                  {% else %}
                    <img src="{{ block.settings.product_image | image_url: width: 400 }}" 
                         alt="{{ block.settings.product_name }}"
                         class="how-to-use-product-image"
                         style="left: {{ block.settings.image_position_x | default: -50 }}px; top: {{ block.settings.image_position_y | default: -250 }}px;"
                         width="400"
                         height="480">
                  {% endif %}
                {% endif %}
                {% if block.settings.product_link != blank %}
                  <a href="{{ block.settings.product_link }}" style="text-decoration: none;">
                    <div class="how-to-use-product-info" 
                         style="left: {{ block.settings.name_position_x | default: 250 }}px; top: {{ block.settings.name_position_y | default: -100 }}px;">
                      <div class="how-to-use-product-name">{{ block.settings.product_name }}</div>
                      {% if block.settings.product_description != blank %}
                        <div class="how-to-use-product-description">{{ block.settings.product_description }}</div>
                      {% endif %}
                    </div>
                  </a>
                {% else %}
                  <div class="how-to-use-product-info" 
                       style="left: {{ block.settings.name_position_x | default: 250 }}px; top: {{ block.settings.name_position_y | default: -100 }}px;">
                    <div class="how-to-use-product-name">{{ block.settings.product_name }}</div>
                    {% if block.settings.product_description != blank %}
                      <div class="how-to-use-product-description">{{ block.settings.product_description }}</div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}

        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
window.howToUseData = window.howToUseData || {};

function initHowToUse(sectionId) {
  window.howToUseData[sectionId] = {
    currentTab: 'am',
    currentStep: 1,
    previousStep: 1,
    isPlaying: false,
    videoEndedListener: null,
    manualClick: false,
    isProgressing: false
  };
  
  // FORCE reset all progress bars to 0% on initialization
  const allProgressFills = document.querySelectorAll(`[id^="progress-fill-${sectionId}"]`);
  allProgressFills.forEach(fill => {
    fill.style.width = '0%';
  });
  console.log(`INIT: All progress bars reset to 0%`);
  
  // Start first video
  playCurrentVideo(sectionId);
}

function switchTab(tabId, sectionId) {
  const data = window.howToUseData[sectionId];
  
  // Stop current video
  stopAllVideos(sectionId);
  
  // Update tab state
  data.currentTab = tabId;
  data.currentStep = 1;
  
  // Update UI
  document.querySelectorAll('.how-to-use-tab').forEach(tab => {
    tab.classList.toggle('active', tab.dataset.tab === tabId);
  });
  
  document.querySelectorAll('.how-to-use-tab-content').forEach(content => {
    content.classList.toggle('active', content.dataset.tab === tabId);
  });
  
  // FORCE reset progress to 0% for step 1
  const progressFill = document.getElementById(`progress-fill-${sectionId}-${tabId}`);
  if (progressFill) {
    progressFill.style.width = '0%';
    console.log(`TAB SWITCH: Progress bar reset to 0% for step 1`);
  }
  
  // Reset progress
  updateProgress(sectionId, tabId, 1);
  
  // Play new video
  playCurrentVideo(sectionId);
}

function forceGoToStep(stepNumber, tabId, sectionId) {
  console.log(`FORCE: Going to step ${stepNumber} in tab ${tabId} - CLICK DETECTED`);
  
  const data = window.howToUseData[sectionId];
  
  // Track previous step for smooth animation
  data.previousStep = data.currentStep;
  
  // Special handling for step 1 to ensure it always works
  if (stepNumber === 1) {
    console.log(`FORCE: Special handling for step 1 - RESETTING TO 0%`);
    // Immediately reset progress bar to 0% for step 1
    const progressFill = document.getElementById(`progress-fill-${sectionId}-${tabId}`);
    if (progressFill) {
      progressFill.style.width = '0%';
      console.log(`FORCE: Progress bar immediately set to 0% for step 1`);
    }
  }
  
  // Force stop all videos immediately
  const allVideos = document.querySelectorAll(`#how-to-use-${sectionId} video`);
  allVideos.forEach(video => {
    video.pause();
    video.currentTime = 0;
    // Remove all event listeners
    video.removeEventListener('ended', data.videoEndedListener);
  });
  
  // Force update the data
  data.currentStep = stepNumber;
  data.isPlaying = false;
  data.manualClick = true;
  data.isProgressing = false;
  
  console.log(`FORCE: Data updated - currentStep: ${data.currentStep}, previousStep: ${data.previousStep}`);
  
  // Force update progress immediately
  forceUpdateProgress(sectionId, tabId, stepNumber);
  
  // Force play video after a short delay
  setTimeout(() => {
    forcePlayVideo(sectionId, tabId, stepNumber);
  }, 100);
  
  // Reset manual click flag
  setTimeout(() => {
    data.manualClick = false;
  }, 2000);
}

function forceUpdateProgress(sectionId, tabId, stepNumber) {
  console.log(`FORCE UPDATE: Step ${stepNumber} in tab ${tabId}`);
  
  const tabContent = document.querySelector(`.how-to-use-tab-content[data-tab="${tabId}"]`);
  if (!tabContent) {
    console.log(`FORCE: No tab content found for ${tabId}`);
    return;
  }
  
  const steps = tabContent.querySelectorAll('.how-to-use-step');
  const totalSteps = steps.length;
  
  // Force clear and update all step states
  steps.forEach((step, index) => {
    const stepNum = index + 1;
    
    // Remove all classes
    step.classList.remove('active', 'blink', 'completed');
    
    // Apply correct classes
    if (stepNum < stepNumber) {
      step.classList.add('completed');
    } else if (stepNum === stepNumber) {
      step.classList.add('active');
      // Don't add completed to step 1
      if (stepNumber > 1) {
        step.classList.add('completed');
      }
    }
    
    console.log(`FORCE: Step ${stepNum} classes: ${step.className}`);
  });
  
  // Force update progress bar - ALWAYS 0% for step 1
  const progressFill = document.getElementById(`progress-fill-${sectionId}-${tabId}`);
  if (progressFill) {
    let percentage = 0;
    
    // Step 1 should ALWAYS be 0%
    if (stepNumber === 1) {
      percentage = 0;
    } else if (totalSteps > 1) {
      percentage = ((stepNumber - 1) / (totalSteps - 1)) * 100;
    }
    
    progressFill.style.width = percentage + '%';
    console.log(`FORCE: Progress bar set to ${percentage}% for step ${stepNumber}`);
  }
  
  // Force update products
  const products = tabContent.querySelectorAll('.how-to-use-product');
  products.forEach((product, index) => {
    if ((index + 1) === stepNumber) {
      product.classList.add('active');
    } else {
      product.classList.remove('active');
    }
  });
}

function forcePlayVideo(sectionId, tabId, stepNumber) {
  console.log(`FORCE PLAY: Step ${stepNumber} in tab ${tabId}`);
  
  const videos = document.querySelectorAll('.how-to-use-video');
  let targetVideo = null;
  
  // Find the correct video
  videos.forEach((videoDiv) => {
    const videoTab = videoDiv.dataset.tab;
    const videoStep = parseInt(videoDiv.dataset.step);
    
    if (videoTab === tabId && videoStep === stepNumber) {
      targetVideo = videoDiv;
      console.log(`FORCE: Found video for tab=${videoTab}, step=${videoStep}`);
    }
  });
  
  if (!targetVideo) {
    console.log(`FORCE: No video found for tab=${tabId}, step=${stepNumber}`);
    return;
  }
  
  // Hide all videos and show target
  videos.forEach(v => v.classList.remove('active'));
  targetVideo.classList.add('active');
  
  const video = targetVideo.querySelector('video');
  if (video) {
    video.currentTime = 0;
    video.play().then(() => {
      console.log(`FORCE: Video playing for step ${stepNumber}`);
      const data = window.howToUseData[sectionId];
      data.isPlaying = true;
      
      // Add ended listener
      video.addEventListener('ended', () => {
        if (!data.manualClick) {
          onVideoEnded(sectionId);
        }
      });
    }).catch(error => {
      console.log(`FORCE: Video play failed:`, error);
    });
  }
}

function goToStep(stepNumber, tabId, sectionId) {
  // Use the force function for all steps now
  forceGoToStep(stepNumber, tabId, sectionId);
}

function updateProgress(sectionId, tabId, stepNumber, shouldBlink = false) {
  console.log(`Updating progress to step ${stepNumber} in tab ${tabId}`);
  
  const tabContent = document.querySelector(`.how-to-use-tab-content[data-tab="${tabId}"]`);
  if (!tabContent) {
    console.log(`No tab content found for tab: ${tabId}`);
    return;
  }
  
  const steps = tabContent.querySelectorAll('.how-to-use-step');
  const totalSteps = steps.length;
  
  // Update step circles - mark completed and active
  steps.forEach((step, index) => {
    const stepNum = index + 1;
    
    // Clear all classes first
    step.classList.remove('active', 'blink', 'completed');
    
    // Apply appropriate classes
    if (stepNum < stepNumber) {
      step.classList.add('completed');
    } else if (stepNum === stepNumber) {
      step.classList.add('active');
      // Only add completed class if it's not step 1
      if (stepNumber > 1) {
        step.classList.add('completed');
      }
      if (shouldBlink) {
        step.classList.add('blink');
      }
    }
  });
  
  // Update progress bar - ALWAYS 0% for step 1
  const progressFill = document.getElementById(`progress-fill-${sectionId}-${tabId}`);
  if (progressFill && totalSteps > 1) {
    let percentage = 0;
    
    // Step 1 should ALWAYS be 0%
    if (stepNumber === 1) {
      percentage = 0;
    } else {
      percentage = ((stepNumber - 1) / (totalSteps - 1)) * 100;
    }
    
    console.log(`Setting progress bar to ${percentage}% for step ${stepNumber}`);
    progressFill.style.width = percentage + '%';
  }
  
  // Update product display
  const products = tabContent.querySelectorAll('.how-to-use-product');
  products.forEach((product, index) => {
    product.classList.toggle('active', (index + 1) === stepNumber);
  });
}

function playCurrentVideo(sectionId) {
  const data = window.howToUseData[sectionId];
  const tabId = data.currentTab;
  const stepNumber = data.currentStep;
  
  console.log(`Playing video for tab: ${tabId}, step: ${stepNumber}`);
  
  // Find the video for current tab and step
  const videos = document.querySelectorAll('.how-to-use-video');
  let videoElement = null;
  
  console.log(`Found ${videos.length} total videos`);
  
  videos.forEach((videoDiv, index) => {
    const videoTab = videoDiv.dataset.tab;
    const videoStep = parseInt(videoDiv.dataset.step);
    console.log(`Video ${index}: tab=${videoTab}, step=${videoStep}`);
    
    if (videoTab === tabId && videoStep === stepNumber) {
      videoElement = videoDiv;
      console.log(`Found matching video at index ${index}`);
    }
  });
  
  if (!videoElement) {
    console.log(`No video found for tab: ${tabId}, step: ${stepNumber}`);
    return;
  }
  
  // Show video
  videos.forEach(v => v.classList.remove('active'));
  videoElement.classList.add('active');
  
  const video = videoElement.querySelector('video');
  if (video) {
    video.currentTime = 0;
    video.play();
    data.isPlaying = true;
    
    // Update progress bar as video plays - but NOT for step 1
    const updateProgressBar = () => {
      if (!data.isPlaying) return;
      
      const currentTime = video.currentTime;
      const duration = video.duration;
      
      if (duration > 0) {
        const tabContent = document.querySelector(`.how-to-use-tab-content[data-tab="${tabId}"]`);
        const steps = tabContent ? tabContent.querySelectorAll('.how-to-use-step') : [];
        const totalSteps = steps.length;
        
        if (totalSteps > 1) {
          // Calculate progress within current step
          const stepProgress = currentTime / duration;
          const baseProgress = ((stepNumber - 1) / (totalSteps - 1)) * 100;
          const stepRange = (1 / (totalSteps - 1)) * 100;
          let currentProgress = baseProgress + (stepProgress * stepRange);
          
          // Special handling for step 1 - keep at 0% until video ends
          if (stepNumber === 1) {
            currentProgress = stepProgress * stepRange;
          }
          
          // Cap at 100%
          currentProgress = Math.min(currentProgress, 100);
          
          const progressFill = document.getElementById(`progress-fill-${sectionId}-${tabId}`);
          if (progressFill) {
            progressFill.style.width = currentProgress + '%';
          }
        }
      }
      
      if (data.isPlaying) {
        requestAnimationFrame(updateProgressBar);
      }
    };
    
    requestAnimationFrame(updateProgressBar);
    
    // Listen for video end
    if (data.videoEndedListener) {
      video.removeEventListener('ended', data.videoEndedListener);
    }
    
    data.videoEndedListener = () => {
      onVideoEnded(sectionId);
    };
    
    video.addEventListener('ended', data.videoEndedListener);
  }
}

function stopAllVideos(sectionId) {
  const videos = document.querySelectorAll(`#how-to-use-${sectionId} video`);
  videos.forEach(video => {
    video.pause();
    video.currentTime = 0;
  });
  
  const data = window.howToUseData[sectionId];
  data.isPlaying = false;
}

function onVideoEnded(sectionId) {
  const data = window.howToUseData[sectionId];
  
  // Don't auto-progress if user just clicked manually
  if (data.manualClick) {
    console.log('Skipping auto-progression due to manual click');
    return;
  }
  
  // Prevent multiple rapid calls
  if (data.isProgressing) {
    console.log('Already progressing, skipping duplicate call');
    return;
  }
  
  data.isProgressing = true;
  
  const tabId = data.currentTab;
  console.log(`Video ended for tab: ${tabId}, current step: ${data.currentStep}`);
  
  // Count total steps for current tab
  const tabContent = document.querySelector(`.how-to-use-tab-content[data-tab="${tabId}"]`);
  const totalSteps = tabContent ? tabContent.querySelectorAll('.how-to-use-step').length : 0;
  
  console.log(`Total steps in tab ${tabId}: ${totalSteps}`);
  
  // Move to next step
  if (data.currentStep < totalSteps) {
    const nextStep = data.currentStep + 1;
    console.log(`Moving from step ${data.currentStep} to step ${nextStep}`);
    data.currentStep = nextStep;
    updateProgress(sectionId, tabId, data.currentStep, false);
    playCurrentVideo(sectionId);
  } else {
    // Loop back to first step with blink animation
    console.log(`Looping back from step ${data.currentStep} to step 1`);
    data.currentStep = 1;
    updateProgress(sectionId, tabId, data.currentStep, true);
    playCurrentVideo(sectionId);
  }
  
  // Reset progression flag after a short delay
  setTimeout(() => {
    data.isProgressing = false;
  }, 500);
}

function smoothAutoProgress(sectionId, tabId, targetStep, previousStep, shouldBlink = false) {
  console.log(`AUTO SMOOTH: From step ${previousStep} to step ${targetStep}`);
  
  const tabContent = document.querySelector(`.how-to-use-tab-content[data-tab="${tabId}"]`);
  if (!tabContent) return;
  
  const steps = tabContent.querySelectorAll('.how-to-use-step');
  const totalSteps = steps.length;
  const progressFill = document.getElementById(`progress-fill-${sectionId}-${tabId}`);
  
  if (!progressFill || totalSteps <= 1) return;
  
  // Calculate target percentage
  let targetPercentage = 0;
  if (targetStep > 1) {
    targetPercentage = ((targetStep - 1) / (totalSteps - 1)) * 100;
  }
  
  // Immediately update step states for smooth progression
  steps.forEach((step, index) => {
    const stepNum = index + 1;
    step.classList.remove('active', 'blink', 'completed');
    
    if (stepNum < targetStep) {
      step.classList.add('completed');
    } else if (stepNum === targetStep) {
      step.classList.add('active');
      if (targetStep > 1) {
        step.classList.add('completed');
      }
      if (shouldBlink) {
        step.classList.add('blink');
      }
    }
  });
  
  // Animate progress bar
  progressFill.style.width = targetPercentage + '%';
  
  // Update products
  const products = tabContent.querySelectorAll('.how-to-use-product');
  products.forEach((product, index) => {
    product.classList.toggle('active', (index + 1) === targetStep);
  });
}

document.addEventListener('DOMContentLoaded', function() {
  initHowToUse('{{ section.id }}');
  
  // Add aggressive click listeners for all step circles, especially step 1
  setTimeout(() => {
    const allSteps = document.querySelectorAll('.how-to-use-step');
    allSteps.forEach(step => {
      const stepNumber = parseInt(step.dataset.step);
      const circle = step.querySelector('.how-to-use-step-circle');
      const label = step.querySelector('.how-to-use-step-label');
      
      if (circle) {
        // Remove any existing listeners
        circle.removeEventListener('click', handleStepClick);
        // Add new listener
        circle.addEventListener('click', function(e) {
          console.log(`DIRECT CLICK: Step ${stepNumber} circle clicked`);
          const tabContent = step.closest('.how-to-use-tab-content');
          const tabId = tabContent ? tabContent.dataset.tab : 'am';
          forceGoToStep(stepNumber, tabId, '{{ section.id }}');
        }, true); // Use capture phase
        
        // Also add mousedown for extra reliability
        circle.addEventListener('mousedown', function(e) {
          console.log(`MOUSEDOWN: Step ${stepNumber} circle`);
          const tabContent = step.closest('.how-to-use-tab-content');
          const tabId = tabContent ? tabContent.dataset.tab : 'am';
          forceGoToStep(stepNumber, tabId, '{{ section.id }}');
        }, true);
      }
      
      if (label) {
        label.addEventListener('click', function(e) {
          console.log(`DIRECT CLICK: Step ${stepNumber} label clicked`);
          const tabContent = step.closest('.how-to-use-tab-content');
          const tabId = tabContent ? tabContent.dataset.tab : 'am';
          forceGoToStep(stepNumber, tabId, '{{ section.id }}');
        }, true);
      }
    });
  }, 500);
});
</script>

