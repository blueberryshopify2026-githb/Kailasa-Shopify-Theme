{% comment %}
  How To Use Section - Interactive tabs with video backgrounds and progress steps
  Features: AM/PM/PM Light/Exfoliate tabs, synced video backgrounds, progress bar, product images
{% endcomment %}

<style>
  .how-to-use-section {
    font-family: 'Montserrat', sans-serif;
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    background: #000000;
  }

  /* Video Background Container */
  .how-to-use-video-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .how-to-use-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }

  .how-to-use-video.active {
    opacity: 1;
  }

  .how-to-use-video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Content Container */
  .how-to-use-content {
    position: relative;
    z-index: 10;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0;
  }

  /* Frosted Glass Strip - Full width at bottom with curved top edges */
  .how-to-use-strip-wrapper {
    position: relative;
    width: 100%;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    {% comment %} border-radius: 40px 40px 0 0; {% endcomment %}
    padding: 30px 80px 30px 80px;
    box-shadow: 0 -8px 32px rgba(0, 0, 0, 0.1);
  }

  /* Tab Content */
  .how-to-use-tab-content {
    display: none;
    position: relative;
    overflow: visible;
  }

  .how-to-use-tab-content.active {
    display: block;
  }

  /* Product Display - Separate image and name positioning */
  .how-to-use-product {
    position: relative;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
    z-index: 20;
  }

  .how-to-use-product.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .how-to-use-product-image {
    position: absolute;
    max-width: 280px;
    width: auto;
    height: 350px;
    object-fit: contain;
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.25));
    margin: 0;
    display: block;
    cursor: pointer;
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .how-to-use-product-image:hover {
    transform: translateY(-5px);
    filter: drop-shadow(0 12px 25px rgba(0, 0, 0, 0.3));
  }

  .how-to-use-product-name {
    position: absolute;
    font-size: 20px;
    font-weight: 700;
    color: #333333;
    text-align: left;
    max-width: 200px;
    line-height: 1.3;
    margin: 0;
    cursor: pointer;
  }

  /* Tabs - Inside strip at top */
  .how-to-use-tabs {
    display: flex;
    justify-content: flex-end;
    gap: 20px;
    margin-bottom: 25px;
  }

  .how-to-use-tab {
    padding: 12px 32px;
    background: rgba(255, 255, 255, 0.5);
    border: 2px solid rgba(0, 0, 0, 0.1);
    border-radius: 50px;
    color: #333333;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .how-to-use-tab:hover {
    background: rgba(255, 255, 255, 0.8);
    border-color: rgba(0, 0, 0, 0.2);
  }

  .how-to-use-tab.active {
    background: #000000;
    border-color: #000000;
    color: #ffffff;
  }

  /* Progress Bar Container */
  .how-to-use-progress {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  /* Progress Line */
  .how-to-use-progress-line {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
    height: 4px;
    background: #e0e0e0;
    z-index: 1;
    border-radius: 2px;
    margin: 0 24px;
  }

  .how-to-use-progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: {{ section.settings.accent_color | default: '#4FFFFF' }};
    transition: width 0.5s ease-out;
    width: 0%;
    border-radius: 2px;
  }

  /* Progress Steps */
  .how-to-use-step {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
  }

  .how-to-use-step-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #ffffff;
    border: 4px solid #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 700;
    color: #666666;
    transition: all 0.3s ease;
    margin-bottom: 12px;
  }

  .how-to-use-step.completed .how-to-use-step-circle {
    background: {{ section.settings.accent_color | default: '#4FFFFF' }};
    border-color: {{ section.settings.accent_color | default: '#4FFFFF' }};
    color: #ffffff;
  }

  .how-to-use-step.active .how-to-use-step-circle {
    background: {{ section.settings.accent_color | default: '#4FFFFF' }};
    border-color: {{ section.settings.accent_color | default: '#4FFFFF' }};
    color: #ffffff;
    transform: scale(1.15);
    box-shadow: 0 4px 12px rgba(79, 255, 255, 0.4);
  }

  @keyframes blink-pulse {
    0%, 100% { 
      transform: scale(1.15);
      box-shadow: 0 4px 12px rgba(79, 255, 255, 0.4);
    }
    50% { 
      transform: scale(1.3);
      box-shadow: 0 6px 20px rgba(79, 255, 255, 0.7);
    }
  }

  .how-to-use-step.active.blink .how-to-use-step-circle {
    animation: blink-pulse 0.6s ease-in-out 2;
  }

  .how-to-use-step-label {
    font-size: 14px;
    font-weight: 600;
    color: #333333;
    text-align: center;
    max-width: 100px;
  }



  /* Responsive */
  @media (max-width: 1024px) {
    .how-to-use-strip-wrapper {
      padding: 40px 60px 50px;
      border-radius: 32px 32px 0 0;
    }

    .how-to-use-tabs {
      gap: 12px;
      margin-bottom: 40px;
    }

    .how-to-use-tab {
      padding: 10px 24px;
      font-size: 14px;
    }

    .how-to-use-product {
      top: -90px;
      gap: 15px;
    }

    .how-to-use-product-image {
      width: 130px;
      height: 180px;
    }

    .how-to-use-product-name {
      font-size: 16px;
      padding: 12px 20px;
    }
  }

  @media (max-width: 768px) {
    .how-to-use-strip-wrapper {
      padding: 30px 30px 40px;
      border-radius: 24px 24px 0 0;
    }

    .how-to-use-tabs {
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 30px;
    }

    .how-to-use-tab {
      padding: 8px 16px;
      font-size: 13px;
    }

    .how-to-use-step-circle {
      width: 36px;
      height: 36px;
      font-size: 14px;
    }

    .how-to-use-step-label {
      font-size: 11px;
      max-width: 70px;
    }

    .how-to-use-product {
      position: relative;
      left: 0;
      top: 0;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      margin: 20px auto 30px;
    }

    .how-to-use-product-image {
      width: 100px;
      height: 140px;
    }

    .how-to-use-product-name {
      font-size: 13px;
      padding: 8px 14px;
      margin-bottom: 0;
    }
  }
</style>

<section class="how-to-use-section full-width" id="how-to-use-{{ section.id }}">
  <!-- Video Backgrounds -->
  <div class="how-to-use-video-bg">
    {% for block in section.blocks %}
      <div class="how-to-use-video {% if forloop.first %}active{% endif %}" 
           data-tab="{{ block.settings.tab_id }}"
           data-step="{{ forloop.index0 }}"
           id="video-{{ section.id }}-{{ forloop.index0 }}">
        {% if block.settings.video_url %}
          <video muted playsinline preload="metadata">
            <source src="{{ block.settings.video_url }}" type="video/mp4">
          </video>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <!-- Content -->
  <div class="how-to-use-content">
    <!-- Frosted Glass Strip Wrapper - Contains tabs and progress -->
    <div class="how-to-use-strip-wrapper">
      <!-- Tabs - Inside strip at top -->
      <div class="how-to-use-tabs">
        <button class="how-to-use-tab active" data-tab="am" onclick="switchTab('am', '{{ section.id }}')">AM</button>
        <button class="how-to-use-tab" data-tab="pm" onclick="switchTab('pm', '{{ section.id }}')">PM</button>
        <button class="how-to-use-tab" data-tab="pm-light" onclick="switchTab('pm-light', '{{ section.id }}')">PM Light</button>
        <button class="how-to-use-tab" data-tab="exfoliate" onclick="switchTab('exfoliate', '{{ section.id }}')">Exfoliate</button>
      </div>

      <!-- Tab Contents -->
      {% assign tabs = "am,pm,pm-light,exfoliate" | split: "," %}
      {% for tab in tabs %}
        <div class="how-to-use-tab-content {% if forloop.first %}active{% endif %}" data-tab="{{ tab }}">
          
          <!-- Progress Bar -->
          <div class="how-to-use-progress">
            <div class="how-to-use-progress-line">
              <div class="how-to-use-progress-fill" id="progress-fill-{{ section.id }}-{{ tab }}"></div>
            </div>
            
            {% assign step_count = 0 %}
            {% for block in section.blocks %}
              {% if block.settings.tab_id == tab %}
                {% assign step_count = step_count | plus: 1 %}
              {% endif %}
            {% endfor %}
            
            {% assign current_step = 0 %}
            {% for block in section.blocks %}
              {% if block.settings.tab_id == tab %}
                {% assign current_step = current_step | plus: 1 %}
                <div class="how-to-use-step {% if current_step == 1 %}active{% endif %}" 
                     data-step="{{ current_step }}"
                     onclick="goToStep({{ current_step }}, '{{ tab }}', '{{ section.id }}')">
                  <div class="how-to-use-step-circle">{{ current_step }}</div>
                  <div class="how-to-use-step-label">{{ block.settings.step_label }}</div>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <!-- Product Images - Positioned relative to strip-wrapper -->
          {% assign product_step = 0 %}
          {% for block in section.blocks %}
            {% if block.settings.tab_id == tab %}
              {% assign product_step = product_step | plus: 1 %}
              <div class="how-to-use-product {% if product_step == 1 %}active{% endif %}" 
                   data-step="{{ product_step }}"
                   data-tab="{{ tab }}">
                {% if block.settings.product_image %}
                  {% if block.settings.product_link != blank %}
                    <a href="{{ block.settings.product_link }}">
                      <img src="{{ block.settings.product_image | image_url: width: 400 }}" 
                           alt="{{ block.settings.product_name }}"
                           class="how-to-use-product-image"
                           style="left: {{ block.settings.image_position_x | default: -50 }}px; top: {{ block.settings.image_position_y | default: -250 }}px;"
                           width="400"
                           height="480">
                    </a>
                  {% else %}
                    <img src="{{ block.settings.product_image | image_url: width: 400 }}" 
                         alt="{{ block.settings.product_name }}"
                         class="how-to-use-product-image"
                         style="left: {{ block.settings.image_position_x | default: -50 }}px; top: {{ block.settings.image_position_y | default: -250 }}px;"
                         width="400"
                         height="480">
                  {% endif %}
                {% endif %}
                {% if block.settings.product_link != blank %}
                  <a href="{{ block.settings.product_link }}" style="text-decoration: none;">
                    <div class="how-to-use-product-name" 
                         style="left: {{ block.settings.name_position_x | default: 250 }}px; top: {{ block.settings.name_position_y | default: -100 }}px;">
                      {{ block.settings.product_name }}
                    </div>
                  </a>
                {% else %}
                  <div class="how-to-use-product-name" 
                       style="left: {{ block.settings.name_position_x | default: 250 }}px; top: {{ block.settings.name_position_y | default: -100 }}px;">
                    {{ block.settings.product_name }}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}

        </div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
window.howToUseData = window.howToUseData || {};

function initHowToUse(sectionId) {
  window.howToUseData[sectionId] = {
    currentTab: 'am',
    currentStep: 1,
    isPlaying: false,
    videoEndedListener: null
  };
  
  // Start first video
  playCurrentVideo(sectionId);
}

function switchTab(tabId, sectionId) {
  const data = window.howToUseData[sectionId];
  
  // Stop current video
  stopAllVideos(sectionId);
  
  // Update tab state
  data.currentTab = tabId;
  data.currentStep = 1;
  
  // Update UI
  document.querySelectorAll('.how-to-use-tab').forEach(tab => {
    tab.classList.toggle('active', tab.dataset.tab === tabId);
  });
  
  document.querySelectorAll('.how-to-use-tab-content').forEach(content => {
    content.classList.toggle('active', content.dataset.tab === tabId);
  });
  
  // Reset progress
  updateProgress(sectionId, tabId, 1);
  
  // Play new video
  playCurrentVideo(sectionId);
}

function goToStep(stepNumber, tabId, sectionId) {
  const data = window.howToUseData[sectionId];
  
  // Only allow clicking if we're on the correct tab
  if (data.currentTab !== tabId) {
    return;
  }
  
  // Stop current video
  stopAllVideos(sectionId);
  
  // Update step - allow jumping to any step
  data.currentStep = stepNumber;
  
  // Update progress without blink animation for manual clicks
  updateProgress(sectionId, tabId, stepNumber, false);
  
  // Play video for this step
  playCurrentVideo(sectionId);
}

function updateProgress(sectionId, tabId, stepNumber, shouldBlink = false) {
  const tabContent = document.querySelector(`.how-to-use-tab-content[data-tab="${tabId}"]`);
  if (!tabContent) return;
  
  const steps = tabContent.querySelectorAll('.how-to-use-step');
  const totalSteps = steps.length;
  
  // Update step circles - mark completed and active
  steps.forEach((step, index) => {
    const stepNum = index + 1;
    step.classList.remove('active', 'blink');
    
    // Mark as completed if it's before current step
    if (stepNum < stepNumber) {
      step.classList.add('completed');
    } else if (stepNum === stepNumber) {
      step.classList.add('active', 'completed');
      if (shouldBlink) {
        step.classList.add('blink');
      }
    } else {
      step.classList.remove('completed');
    }
  });
  
  // Update progress bar
  const progressFill = document.getElementById(`progress-fill-${sectionId}-${tabId}`);
  if (progressFill && totalSteps > 1) {
    const percentage = ((stepNumber - 1) / (totalSteps - 1)) * 100;
    progressFill.style.width = percentage + '%';
  }
  
  // Update product display
  const products = tabContent.querySelectorAll('.how-to-use-product');
  products.forEach((product, index) => {
    product.classList.toggle('active', (index + 1) === stepNumber);
  });
}

function playCurrentVideo(sectionId) {
  const data = window.howToUseData[sectionId];
  const tabId = data.currentTab;
  const stepNumber = data.currentStep;
  
  // Find the video for current tab and step
  const videos = document.querySelectorAll('.how-to-use-video');
  let videoElement = null;
  let videoIndex = 0;
  
  videos.forEach((videoDiv, index) => {
    if (videoDiv.dataset.tab === tabId) {
      videoIndex++;
      if (videoIndex === stepNumber) {
        videoElement = videoDiv;
      }
    }
  });
  
  if (!videoElement) return;
  
  // Show video
  videos.forEach(v => v.classList.remove('active'));
  videoElement.classList.add('active');
  
  const video = videoElement.querySelector('video');
  if (video) {
    video.currentTime = 0;
    video.play();
    data.isPlaying = true;
    
    // Update progress bar as video plays
    const updateProgressBar = () => {
      if (!data.isPlaying) return;
      
      const currentTime = video.currentTime;
      const duration = video.duration;
      
      if (duration > 0) {
        const tabContent = document.querySelector(`.how-to-use-tab-content[data-tab="${tabId}"]`);
        const steps = tabContent ? tabContent.querySelectorAll('.how-to-use-step') : [];
        const totalSteps = steps.length;
        
        if (totalSteps > 1) {
          // Calculate progress within current step
          const stepProgress = currentTime / duration;
          const baseProgress = ((stepNumber - 1) / (totalSteps - 1)) * 100;
          const stepRange = (1 / (totalSteps - 1)) * 100;
          let currentProgress = baseProgress + (stepProgress * stepRange);
          
          // Cap at 100% to ensure line doesn't exceed last dot
          currentProgress = Math.min(currentProgress, 100);
          
          const progressFill = document.getElementById(`progress-fill-${sectionId}-${tabId}`);
          if (progressFill) {
            progressFill.style.width = currentProgress + '%';
          }
        }
      }
      
      if (data.isPlaying) {
        requestAnimationFrame(updateProgressBar);
      }
    };
    
    requestAnimationFrame(updateProgressBar);
    
    // Listen for video end
    if (data.videoEndedListener) {
      video.removeEventListener('ended', data.videoEndedListener);
    }
    
    data.videoEndedListener = () => {
      onVideoEnded(sectionId);
    };
    
    video.addEventListener('ended', data.videoEndedListener);
  }
}

function stopAllVideos(sectionId) {
  const videos = document.querySelectorAll(`#how-to-use-${sectionId} video`);
  videos.forEach(video => {
    video.pause();
    video.currentTime = 0;
  });
  
  const data = window.howToUseData[sectionId];
  data.isPlaying = false;
}

function onVideoEnded(sectionId) {
  const data = window.howToUseData[sectionId];
  const tabId = data.currentTab;
  
  // Count total steps for current tab
  const tabContent = document.querySelector(`.how-to-use-tab-content[data-tab="${tabId}"]`);
  const totalSteps = tabContent ? tabContent.querySelectorAll('.how-to-use-step').length : 0;
  
  // Move to next step
  if (data.currentStep < totalSteps) {
    data.currentStep++;
    updateProgress(sectionId, tabId, data.currentStep, false);
    playCurrentVideo(sectionId);
  } else {
    // Loop back to first step with blink animation
    data.currentStep = 1;
    updateProgress(sectionId, tabId, data.currentStep, true);
    playCurrentVideo(sectionId);
  }
}

document.addEventListener('DOMContentLoaded', function() {
  initHowToUse('{{ section.id }}');
});
</script>

{% schema %}
{
  "name": "How To Use",
  "tag": "section",
  "class": "how-to-use-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#4FFFFF"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "tab_id",
          "label": "Tab",
          "options": [
            { "value": "am", "label": "AM" },
            { "value": "pm", "label": "PM" },
            { "value": "pm-light", "label": "PM Light" },
            { "value": "exfoliate", "label": "Exfoliate" }
          ],
          "default": "am"
        },
        {
          "type": "text",
          "id": "step_label",
          "label": "Step Label",
          "default": "Cleanser"
        },
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Name",
          "default": "Product Name"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Product Link",
          "info": "Link to product page or collection (optional)"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL"
        },
        {
          "type": "header",
          "content": "Product Image Position"
        },
        {
          "type": "range",
          "id": "image_position_x",
          "label": "Image Horizontal Position (X-axis)",
          "min": -300,
          "max": 300,
          "step": 10,
          "default": -50,
          "unit": "px",
          "info": "Move image left (negative) or right (positive)"
        },
        {
          "type": "range",
          "id": "image_position_y",
          "label": "Image Vertical Position (Y-axis)",
          "min": -500,
          "max": 100,
          "step": 10,
          "default": -250,
          "unit": "px",
          "info": "Move image up (negative) or down (positive)"
        },
        {
          "type": "header",
          "content": "Product Name Position"
        },
        {
          "type": "range",
          "id": "name_position_x",
          "label": "Name Horizontal Position (X-axis)",
          "min": -300,
          "max": 600,
          "step": 10,
          "default": 250,
          "unit": "px",
          "info": "Move name left (negative) or right (positive)"
        },
        {
          "type": "range",
          "id": "name_position_y",
          "label": "Name Vertical Position (Y-axis)",
          "min": -500,
          "max": 100,
          "step": 10,
          "default": -100,
          "unit": "px",
          "info": "Move name up (negative) or down (positive)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How To Use",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "tab_id": "am",
            "step_label": "Cleanser",
            "product_name": "BHA & Tea Tree"
          }
        },
        {
          "type": "step",
          "settings": {
            "tab_id": "am",
            "step_label": "Toner",
            "product_name": "Hydrating Tonic"
          }
        },
        {
          "type": "step",
          "settings": {
            "tab_id": "am",
            "step_label": "Moisturiser",
            "product_name": "PM Moisturiser"
          }
        }
      ]
    }
  ]
}
{% endschema %}
