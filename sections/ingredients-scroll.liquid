<script>
  // Global variables for this section
  window.ingredientsScrollData = window.ingredientsScrollData || {};


  function initializeIngredientsScroll(sectionId) {
    const originalBlocksCount = parseInt('{{ section.blocks.size }}');
    // With 10 clone sets at beginning + 1 original set + 10 clone sets at end = 21 total sets
    // Start in the middle of the original set (11th set, which is index 10 * originalBlocksCount)
    const currentIndex = (10 * originalBlocksCount) + Math.floor(originalBlocksCount / 2);


    // Store data for this section
    window.ingredientsScrollData[sectionId] = {
      originalBlocksCount: originalBlocksCount,
      currentIndex: currentIndex,
      previousIndex: currentIndex,
      isTransitioning: false,
      totalSets: 21, // 10 clone sets + 1 original + 10 clone sets
      cloneSetsBeforeOriginal: 10,
      cloneSetsAfterOriginal: 10,
    };


    const track = document.getElementById('track-' + sectionId);
    const cards = track.querySelectorAll('.ingredient-d-card');


    if (cards.length === 0) return;


    // Set initial position without animation
    track.style.transition = 'none';


    // Force initial active state
    cards.forEach((card, i) => {
      if (i === currentIndex) {
        card.classList.add('active');
      } else {
        card.classList.remove('active');
      }
    });


    // Wait for layout to settle, then center the active card properly
    setTimeout(() => {
      // Use the centerCard function for consistent centering
      centerCard(currentIndex, sectionId, false);
    }, 200);
  }


  function selectIngredient(index, sectionId, animate = true) {
    const track = document.getElementById('track-' + sectionId);
    const cards = track.querySelectorAll('.ingredient-d-card');


    if (index < 0 || index >= cards.length) return;


    const data = window.ingredientsScrollData[sectionId];


    // Prevent rapid successive calls that could cause flickering
    if (data.currentIndex === index && animate) return;


    // Store previous index before updating
    const previousIndex = data.currentIndex;
    data.previousIndex = previousIndex;


    // Update active class immediately for smooth conveyor belt effect
    cards.forEach((card, i) => {
      if (i === index) {
        card.classList.add('active');
        
        // Show frost glass on active card
        const frostGlass = card.querySelector('.ingredient-auto-info');
        if (frostGlass) {
          frostGlass.style.opacity = '1';
          frostGlass.style.visibility = 'visible';
          frostGlass.style.pointerEvents = 'auto';
        }
        
        // Hide any open hover info
        const hoverInfo = card.querySelector('.ingredient-hover-info');
        if (hoverInfo) {
          hoverInfo.classList.remove('show-details');
        }
      } else {
        card.classList.remove('active');
        
        // Hide frost glass on inactive cards
        const frostGlass = card.querySelector('.ingredient-auto-info');
        if (frostGlass) {
          frostGlass.style.opacity = '0';
          frostGlass.style.visibility = 'hidden';
          frostGlass.style.pointerEvents = 'none';
        }
        
        // Hide any open hover info on inactive cards
        const hoverInfo = card.querySelector('.ingredient-hover-info');
        if (hoverInfo) {
          hoverInfo.classList.remove('show-details');
        }
      }
    });


    // Update current index
    data.currentIndex = index;


    // Center the selected card with smooth sliding
    centerCard(index, sectionId, animate);


    // Refresh hover behavior after card selection
    if (sectionId === '{{ section.id }}') {
      setTimeout(setupFrostGlassHover, 100);
    }
  }


  function selectIngredientClone(originalIndex, sectionId) {
    // Use the same logic as regular click - find closest instance
    selectIngredientByClick(originalIndex, sectionId);
  }


  // Enhanced click handler for infinite loop behavior
  function selectIngredientByClick(targetIndex, sectionId) {
    const data = window.ingredientsScrollData[sectionId];
    if (data.isTransitioning) return;

    const track = document.getElementById('track-' + sectionId);
    const cards = track.querySelectorAll('.ingredient-d-card');
    const originalBlocksCount = data.originalBlocksCount;
    const currentIndex = data.currentIndex;
   
    // Find the closest instance of the target ingredient to the current position
    const targetInstances = [];
   
    // Find all instances of this ingredient (original + clones)
    cards.forEach((card, index) => {
      const cardIndex = card.dataset.index || card.dataset.originalIndex;
      if (parseInt(cardIndex) === targetIndex) {
        targetInstances.push(index);
      }
    });
   
    // Find the closest instance to current position
    let closestIndex = targetInstances[0];
    let minDistance = Math.abs(targetInstances[0] - currentIndex);
   
    targetInstances.forEach(instanceIndex => {
      const distance = Math.abs(instanceIndex - currentIndex);
      if (distance < minDistance) {
        minDistance = distance;
        closestIndex = instanceIndex;
      }
    });

    // Check if the clicked card is already active (centered)
    const clickedCard = cards[closestIndex];
    if (clickedCard && clickedCard.classList.contains('active')) {
      // If already active, show the detailed info
      const hoverInfo = clickedCard.querySelector('.ingredient-hover-info');
      if (hoverInfo) {
        hoverInfo.classList.add('show-details');
      }
    } else {
      // If not active, just center it without showing details
      selectIngredient(closestIndex, sectionId, true);
    }
  }


  function centerCard(index, sectionId, animate = true) {
    const track = document.getElementById('track-' + sectionId);
    const cards = track.querySelectorAll('.ingredient-d-card');
    const container = track.parentElement;


    if (cards.length === 0) return;


    // Get the actual card being centered
    const activeCard = cards[index];
    if (!activeCard) return;


    const data = window.ingredientsScrollData[sectionId];


    // Always calculate exact center position for smooth infinite loop
    const containerWidth = container.offsetWidth;
    const containerCenter = containerWidth / 2;


    const sideCardWidth = 180; // Side card width
    const activeCardWidth = 340; // Active card width
    const gap = 40; // Gap between cards


    // Calculate position to center the active card perfectly
    let totalWidthBefore = 0;


    // Add width of all cards before the active card (using side card width)
    for (let i = 0; i < index; i++) {
      totalWidthBefore += sideCardWidth + gap;
    }


    // Add half of the ACTIVE card width to get to its center
    totalWidthBefore += activeCardWidth / 2;


    // Calculate the transform needed to center the active card
    const targetTransform = containerCenter - totalWidthBefore;


    if (!animate) {
      track.style.transition = 'none';
    } else {
      track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
    }


    track.style.transform = `translateX(${targetTransform}px)`;


    if (!animate) {
      setTimeout(() => {
        track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
      }, 50);
    }


    // Store the previous index for future movements
    data.previousIndex = index;


    // Check if we need to handle infinite loop repositioning for truly endless scrolling
    if (animate) {
      setTimeout(() => {
        if (!data.isTransitioning) {
          handleInfiniteLoopRepositioning(index, sectionId);
        }
      }, 650);
    } else {
      // For immediate positioning, check after a short delay
      setTimeout(() => {
        if (!data.isTransitioning) {
          handleInfiniteLoopRepositioning(index, sectionId);
        }
      }, 100);
    }
  }


  // Dynamic infinite loop repositioning for truly endless scrolling
  function handleInfiniteLoopRepositioning(currentIndex, sectionId) {
    const data = window.ingredientsScrollData[sectionId];
    const track = document.getElementById('track-' + sectionId);
    const originalBlocksCount = data.originalBlocksCount;
    const totalCards = data.totalSets * originalBlocksCount;
   
    // Only reposition if we're not transitioning
    if (data.isTransitioning) return;
   
    // Define safe zones - reposition when getting close to edges
    const safeZoneSize = 3 * originalBlocksCount; // 3 sets worth of buffer
    const leftEdge = safeZoneSize;
    const rightEdge = totalCards - safeZoneSize;
   
    // If we're getting too close to the left edge, jump to equivalent position on the right
    if (currentIndex <= leftEdge) {
      const equivalentIndex = currentIndex + (10 * originalBlocksCount); // Jump 10 sets forward
      seamlessReposition(equivalentIndex, sectionId);
    }
    // If we're getting too close to the right edge, jump to equivalent position on the left
    else if (currentIndex >= rightEdge) {
      const equivalentIndex = currentIndex - (10 * originalBlocksCount); // Jump 10 sets backward
      seamlessReposition(equivalentIndex, sectionId);
    }
  }


  // Seamless repositioning without visual interruption
  function seamlessReposition(newIndex, sectionId) {
    const data = window.ingredientsScrollData[sectionId];
    const track = document.getElementById('track-' + sectionId);
    const cards = track.querySelectorAll('.ingredient-d-card');
   
    // Temporarily disable transitions
    track.style.transition = 'none';
   
    // Update active states
    cards.forEach((card, i) => {
      if (i === newIndex) {
        card.classList.add('active');
      } else {
        card.classList.remove('active');
      }
    });
   
    // Update current index
    data.currentIndex = newIndex;
   
    // Center the card without animation
    centerCard(newIndex, sectionId, false);
   
    // Re-enable transitions after a brief delay
    setTimeout(() => {
      track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
    }, 50);
  }


  function moveCarousel(direction, sectionId) {
    const data = window.ingredientsScrollData[sectionId];
    if (data.isTransitioning) return;


    data.isTransitioning = true;


    const track = document.getElementById('track-' + sectionId);
    const cards = track.querySelectorAll('.ingredient-d-card');
    const currentIndex = data.currentIndex;
    const originalBlocksCount = data.originalBlocksCount;


    // Calculate new index with proper infinite loop handling
    let newIndex = currentIndex + direction;


    // Handle infinite loop by wrapping around smoothly
    if (newIndex < 0) {
      newIndex = cards.length - 1;
    } else if (newIndex >= cards.length) {
      newIndex = 0;
    }


    // Move to the new card
    selectIngredient(newIndex, sectionId, true);


    setTimeout(() => {
      data.isTransitioning = false;
    }, 700);
  }


  // Hover info is now handled by CSS - no JavaScript needed


  // Initialize on load with multiple fallbacks
  function initializeWhenReady() {
    if (document.getElementById('track-{{ section.id }}')) {
      initializeIngredientsScroll('{{ section.id }}');


      // Hover behavior is now handled entirely by CSS
    } else {
      // Retry if element not found
      setTimeout(initializeWhenReady, 100);
    }
  }


  // Multiple initialization attempts
  document.addEventListener('DOMContentLoaded', initializeWhenReady);


  // Fallback for when DOMContentLoaded already fired
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeWhenReady);
  } else {
    initializeWhenReady();
  }


  // Additional fallback
  setTimeout(initializeWhenReady, 500);


  // Force centering function with proper calculation
  function forceCenterActiveCard() {
    const track = document.getElementById('track-{{ section.id }}');
    if (track) {
      const activeCard = track.querySelector('.ingredient-d-card.active');
      if (activeCard) {
        const data = window.ingredientsScrollData['{{ section.id }}'];
        if (data) {
          // Use the centerCard function for consistency
          centerCard(data.currentIndex, '{{ section.id }}', false);
        }
      }
    }
  }


  // Force center multiple times to ensure it works
  setTimeout(forceCenterActiveCard, 1000);
  setTimeout(forceCenterActiveCard, 2000);


  // Add frost glass specific hover behavior
  function setupFrostGlassHover() {
    // Target ALL ingredient cards, not just active ones
    const ingredientCards = document.querySelectorAll('#ingredients-scroll-{{ section.id }} .ingredient-d-card');

    ingredientCards.forEach((card) => {
      const frostGlass = card.querySelector('.ingredient-auto-info');
      const hoverInfo = card.querySelector('.ingredient-hover-info');

      if (frostGlass && hoverInfo) {
        // Remove any existing listeners to prevent duplicates
        frostGlass.removeEventListener('mouseenter', frostGlass._hoverEnter);
        card.removeEventListener('mouseleave', card._hoverLeave);
        hoverInfo.removeEventListener('mouseenter', hoverInfo._hoverEnter);

        // Add new listeners and store references for removal
        frostGlass._hoverEnter = function () {
          // ONLY show details if this card is active (centered)
          if (card.classList.contains('active')) {
            hoverInfo.classList.add('show-details');
          }
        };

        card._hoverLeave = function () {
          // Only hide if this card is active
          if (card.classList.contains('active')) {
            hoverInfo.classList.remove('show-details');
          }
        };

        hoverInfo._hoverEnter = function () {
          // ONLY show details if this card is active (centered)
          if (card.classList.contains('active')) {
            this.classList.add('show-details');
          }
        };

        // Only add hover listeners to active cards
        if (card.classList.contains('active')) {
          frostGlass.addEventListener('mouseenter', frostGlass._hoverEnter);
          card.addEventListener('mouseleave', card._hoverLeave);
          hoverInfo.addEventListener('mouseenter', hoverInfo._hoverEnter);
        }
      }
    });
  }


  // Setup frost glass hover after initialization
  setTimeout(setupFrostGlassHover, 1000);


  // Add window resize handler to maintain centering
  let resizeTimeout;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      const data = window.ingredientsScrollData['{{ section.id }}'];
      if (data && data.currentIndex !== undefined) {
        centerCard(data.currentIndex, '{{ section.id }}', false);
      }
    }, 250);
  });


  // Close hover info function
  function closeHoverInfo(sectionId) {
    console.log('Closing hover info for section:', sectionId);
    
    // Find all hover info overlays in this section and hide them
    const section = document.getElementById('ingredients-scroll-' + sectionId);
    if (section) {
      const hoverInfos = section.querySelectorAll('.ingredient-hover-info');
      hoverInfos.forEach(hoverInfo => {
        hoverInfo.classList.remove('show-details');
      });
      
      // Make sure the frost glass is visible on the active card
      const activeCard = section.querySelector('.ingredient-d-card.active');
      if (activeCard) {
        const frostGlass = activeCard.querySelector('.ingredient-auto-info');
        if (frostGlass) {
          frostGlass.style.opacity = '1';
          frostGlass.style.visibility = 'visible';
        }
      }
      
      console.log('✅ Hover info closed, frost glass restored');
    }
  }

  // View Supplement Facts button function
  function viewSupplementFacts() {
    const modal = document.getElementById('supplement-facts-modal');
    if (modal) {
      modal.classList.add('active');
      document.body.style.overflow = 'hidden'; // Prevent background scrolling
    }
  }


  // Close Supplement Facts modal function
  function closeSupplementFacts() {
    const modal = document.getElementById('supplement-facts-modal');
    if (modal) {
      modal.classList.remove('active');
      document.body.style.overflow = ''; // Restore scrolling
    }
  }


  // Close modal when clicking outside the content
  document.addEventListener('click', function (event) {
    const modal = document.getElementById('supplement-facts-modal');
    if (modal && event.target === modal) {
      closeSupplementFacts();
    }
  });


  // Close modal with Escape key
  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') {
      closeSupplementFacts();
    }
  });
</script>


