{% comment %} Ingredients Showcase Section - ingredients-showcase.liquid {% endcomment %}

<section class="ing-section full-width" id="ing-section-{{ section.id }}"
  style="
    --ing-bg-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --ing-card-bg: {{ section.settings.card_bg_color }};
    --ing-card-border: {{ section.settings.card_border_color }};
    --ing-text-color: {{ section.settings.text_color }};
    --ing-accent: {{ section.settings.accent_color }};
    --ing-section-height: {{ section.settings.section_height }}px;
    --ing-card-width: {{ section.settings.card_width }}px;
    --ing-card-height: {{ section.settings.card_height }}px;
    --ing-scroll-speed: {{ section.settings.scroll_speed }}s;
    --ing-card-radius: {{ section.settings.card_radius }}px;
    --ing-blur-amount: {{ section.settings.blur_amount }}px;
    --ing-name-size: {{ section.settings.name_font_size }}px;
  "
>

  {%- comment -%} Background Media {%- endcomment -%}
  <div class="ing-bg-wrap">
    {%- if section.settings.bg_video != blank -%}
      <video
        class="ing-bg-video"
        src="{{ section.settings.bg_video }}"
        autoplay
        loop
        muted
        playsinline
        aria-hidden="true"
      ></video>
    {%- elsif section.settings.bg_image != blank -%}
      <img
        class="ing-bg-image"
        src="{{ section.settings.bg_image | image_url: width: 2000 }}"
        alt=""
        loading="lazy"
        aria-hidden="true"
        width="2000"
        height="1000"
      >
    {%- else -%}
      <div class="ing-bg-placeholder"></div>
    {%- endif -%}
    <div class="ing-bg-overlay"></div>
  </div>

  {%- comment -%} Section Heading {%- endcomment -%}
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="ing-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="ing-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="ing-subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} Infinite Scroll Track {%- endcomment -%}
  {%- if section.blocks.size > 0 -%}
    <div class="ing-scroll-outer" aria-label="{{ section.settings.heading | escape }}">
      <div class="ing-scroll-track">
        {%- comment -%}
          FIRST SET — real cards with shopify_attributes for theme editor support.
          These are the accessible, indexable cards.
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          <div class="ing-card" {{ block.shopify_attributes }}>
            <div class="ing-card-inner">
              <span class="ing-card-name">{{ block.settings.ingredient_name }}</span>
              <div class="ing-card-img-wrap">
                {%- if block.settings.ingredient_image != blank -%}
                  <img
                    class="ing-card-img"
                    src="{{ block.settings.ingredient_image | image_url: width: 300 }}"
                    alt="{{ block.settings.ingredient_name | escape }}"
                    loading="lazy"
                    width="300"
                    height="300"
                  >
                {%- else -%}
                  <div class="ing-card-img-placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="3"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <path d="M21 15l-5-5L5 21"/>
                    </svg>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
        {%- comment -%}
          SECOND SET (clone) — exact duplicate, aria-hidden so screen readers skip it.
          Required for the seamless loop: when set 1 scrolls fully off-screen left,
          set 2 is already in position and the CSS animation resets to 0 invisibly.
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          <div class="ing-card ing-card--clone" aria-hidden="true">
            <div class="ing-card-inner">
              <span class="ing-card-name">{{ block.settings.ingredient_name }}</span>
              <div class="ing-card-img-wrap">
                {%- if block.settings.ingredient_image != blank -%}
                  <img
                    class="ing-card-img"
                    src="{{ block.settings.ingredient_image | image_url: width: 300 }}"
                    alt=""
                    loading="lazy"
                    width="300"
                    height="300"
                  >
                {%- else -%}
                  <div class="ing-card-img-placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="3"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <path d="M21 15l-5-5L5 21"/>
                    </svg>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

</section>

<style>
  /* ===== INGREDIENTS SHOWCASE - .ing- namespace ===== */

  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap');

  .ing-section,
  .ing-section * {
    font-family: 'Montserrat', sans-serif;
  }

  .ing-section {
    position: relative;
    width: 100%;
    height: var(--ing-section-height, 600px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: #000;
    margin-top: 80px;
  }

  /* Background */
  .ing-bg-wrap {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .ing-bg-image,
  .ing-bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .ing-bg-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #111 0%, #1a1a1a 100%);
  }

  .ing-bg-overlay {
    position: absolute;
    inset: 0;
    /* background: rgba(0, 0, 0, var(--ing-bg-overlay, 0.25)); */
  }

  /* Header — top left, absolute so it doesn't affect scroll layout */
  .ing-header {
    position: absolute;
    top: 32px;
    left: 48px;
    z-index: 3;
    text-align: left;
    padding: 0;
  }

  .ing-heading {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 800;
    color: var(--ing-text-color, #ffffff);
    margin: 0 0 6px;
    letter-spacing: -0.02em;
  }

  .ing-subheading {
    font-size: 18px;
    color: var(--ing-accent, #4fffff);
    margin: 0;
    opacity: 0.85;
  }

  /* ─────────────────────────────────────────────────────────
     Scroll outer — clips the moving track and fades the edges.
     The mask-image creates a soft dissolve on left/right so
     cards appear to emerge from and disappear into the bg.
  ───────────────────────────────────────────────────────── */
  .ing-scroll-outer {
    position: relative;
    z-index: 2;
    width: 100%;
    overflow: hidden; 
     padding: 12px;      /* hides cards outside the viewport */
    padding-bottom: 32px;

    /* Soft fade on both edges */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    mask-image:         linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
  }

  /* ─────────────────────────────────────────────────────────
     Scroll track — the moving belt that holds all cards.

     How the seamless loop works:
       1. Cards are rendered TWICE in Liquid (original + clone).
       2. The track is translateX(0) → translateX(-50%).
       3. -50% = exactly one full set width.
       4. When the animation resets to 0, the clone set is in
          the same position the original started — invisible jump.

     will-change: transform → GPU compositor layer = no jank.
     gap: 0 → spacing is on each card via margin-right instead,
              so the seam between set 1 and set 2 has the same
              gap as every other card pair.
  ───────────────────────────────────────────────────────── */
  .ing-scroll-track {
    display: flex;
    gap: 0;
    width: max-content;
    will-change: transform;
    animation: ing-scroll var(--ing-scroll-speed, 30s) linear infinite;
  }

  /* Pause on hover so users can read the cards */
  .ing-scroll-track:hover {
    animation-play-state: paused;
  }

  /* Keyframe: moves exactly half the total track width (= one set) */
  @keyframes ing-scroll {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ─────────────────────────────────────────────────────────
     Card — margin-right instead of gap keeps the loop seam
     pixel-perfect (no extra space where set 1 meets set 2).

     Frosted glass recipe:
       background  : semi-transparent white (0.4 opacity)
       backdrop-filter : blur behind the card
       border      : subtle white border for the glass edge
       box-shadow  : soft depth shadow
  ───────────────────────────────────────────────────────── */
  .ing-card {
    flex-shrink: 0;

    /* Spacing — carried per-card so the clone seam matches */
    margin-right: 16px;

    /* Fixed dimensions from schema */
    width:  var(--ing-card-width,  180px);
    height: var(--ing-card-height, 140px);
    border-radius: var(--ing-card-radius, 20px);

    /* ── Frosted glass ── */
    background:          rgba(255, 255, 255, 0.4);
    backdrop-filter:         blur(var(--ing-blur-amount, 30px));
    -webkit-backdrop-filter: blur(var(--ing-blur-amount, 30px));
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 8px 3px 0 rgba(0, 0, 0, 0.1);

    overflow: hidden;
    cursor: default;
    box-sizing: border-box;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  /* Subtle lift on hover — does not affect scroll animation */
  .ing-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.15);
  }

  /* Card inner — flex column: name at top, image fills remaining space */
  .ing-card-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    padding: 10px 10px 12px;
  }

  /* Ingredient name — sits at the top of the card */
  .ing-card-name {
    font-size: var(--ing-name-size, 16px);
    font-weight: 600;
    color: var(--ing-text-color, #ffffff);
    text-align: center;
    line-height: 1.3;
    letter-spacing: 0.01em;
    width: 100%;
  }

  /* Image wrapper — flex-grows to fill remaining card height */
  .ing-card-img-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 8px 0 0;
  }

  /* Ingredient image — contained, with a soft drop shadow */
  .ing-card-img {
    max-width: 100%;
    max-height: 80px;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 4px 4px rgba(0,0,0,0.3));
  }

  /* Placeholder shown when no image is uploaded */
  .ing-card-img-placeholder {
    width: 84px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.4;
    color: var(--ing-text-color, #fff);
  }

  .ing-card-img-placeholder svg {
    width: 100%;
    height: 100%;
  }

  /* Pause animation in editor */
  @media (prefers-reduced-motion: reduce) {
    .ing-scroll-track {
      animation: none;
    }
  }
</style>

<script>
  (function() {
    // Autoplay video fallback for browsers that block autoplay
    document.querySelectorAll('.ing-bg-video').forEach(function(video) {
      video.play().catch(function() {
        video.muted = true;
        video.play();
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Ingredients Showcase",
  "tag": "section",
  "class": "ing-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Ingredients"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Clinically formulated with precision"
    },
    {
      "type": "header",
      "content": "Background Media"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image",
      "info": "Used when no video is set. Recommended: 2000px wide."
    },
    {
      "type": "url",
      "id": "bg_video",
      "label": "Background Video URL",
      "info": "Paste a direct .mp4 URL. Video autoplays, loops, and is muted. Overrides background image."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background Overlay Opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Height",
      "min": 400,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 600
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card Width",
      "min": 120,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 200
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card Height",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Border Radius",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "name_font_size",
      "label": "Ingredient Name Font Size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "blur_amount",
      "label": "Frosted Glass Blur",
      "min": 4,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll Speed",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "s",
      "default": 30,
      "info": "Lower = faster scroll"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#ffffff26"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border",
      "default": "#ffffff40"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Subheading Color",
      "default": "#4fffff"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient Card",
      "settings": [
        {
          "type": "text",
          "id": "ingredient_name",
          "label": "Ingredient Name",
          "default": "Ingredient"
        },
        {
          "type": "image_picker",
          "id": "ingredient_image",
          "label": "Ingredient Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients Showcase",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "ingredient_name": "Compounded GLP-1"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "ingredient_name": "Oral Rx"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "ingredient_name": "Ozempic®"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "ingredient_name": "Vitamin B12"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "ingredient_name": "L-Carnitine"
          }
        }
      ]
    }
  ]
}
{% endschema %}
