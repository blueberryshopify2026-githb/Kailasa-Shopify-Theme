{% comment %} Lifestyle Interactive Showcase Section {% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap');

  /* Hide mobile-only button set on desktop */
  .lifestyle-buttons-mobile {
    display: none;
  }

  .lifestyle-showcase {
    font-family: 'Montserrat', sans-serif;
    background: #000000;
    min-height: 100vh;
    display: flex;
    position: relative;
    overflow: hidden;
  }

  .lifestyle-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .lifestyle-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lifestyle-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    position: relative;
    z-index: 2;
  }

  .lifestyle-left {
    padding: 60px;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    padding-top: calc(15vh + 30px);
  }

  .lifestyle-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(79, 255, 255, 0.2);
    border-radius: 20px;
    padding: 25px 20px;
    width: 100%;
    max-width: 500px;
    min-height: 60vh;
    height: auto;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
  }

  .lifestyle-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
    border-color: rgba(79, 255, 255, 0.4);
  }

  .lifestyle-heading {
    font-size: {{ section.settings.heading_size | default: 28 }}px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.4s ease;
  }

  .lifestyle-description {
    font-size: {{ section.settings.description_size | default: 16 }}px;
    font-weight: 400;
    color: #ffffff;
    line-height: 1.6;
    margin-bottom: 25px;
    opacity: 0.9;
    transition: all 0.4s ease;
  }

  .lifestyle-points {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .lifestyle-points li {
    font-size: {{ section.settings.points_size | default: 14 }}px;
    font-weight: 500;
    color: #ffffff;
    margin-bottom: 12px;
    padding-left: 20px;
    position: relative;
    transition: all 0.4s ease;
  }

  .lifestyle-points li:before {
    content: "•";
    color: #ffffff;
    font-size: 18px;
    position: absolute;
    left: 0;
    top: -2px;
  }

  .lifestyle-right {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 0 30px;
  }

  .lifestyle-buttons-container {
    display: flex;
    gap: 20px;
    justify-content: center;
    align-items: center;
    flex-wrap: nowrap;
    width: 100%;
    max-width: 800px;
  }

  .lifestyle-button {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 2px solid rgba(79, 255, 255, 0.3);
    border-radius: 50px;
    padding: 10px 10px;
    color: #ffffff;
    font-family: 'Montserrat', sans-serif;
    font-size: {{ section.settings.button_size | default: 14 }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
    min-width: 180px;
    text-align: center;
  }

  .lifestyle-button:hover {
    background: rgba(79, 255, 255, 0.2);
    border-color: #4fffff;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(79, 255, 255, 0.3);
  }

  .lifestyle-button.active {
    background: rgba(79, 255, 255, 0.3);
    border-color: #4fffff;
    color: #ffffff;
    box-shadow: 0 0 30px rgba(79, 255, 255, 0.5);
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    .lifestyle-showcase {
      min-height: unset !important;
      height: 85vw;
      max-height: 580px;
    }

    .lifestyle-left {
      padding: 30px 30px 0 30px;
      padding-top: 30px;
      align-items: flex-start;
      justify-content: flex-start;
      /* Card sits at top, not stretching to fill */
      flex: 0 0 auto;
    }

    .lifestyle-card {
      max-width: auto;
      min-height: unset;
      padding: 22px 20px;
      border-radius: 16px;
    }

    .lifestyle-card:hover {
      transform: translateY(-3px);
    }

    .lifestyle-heading {
      font-size: 26px;
      margin-bottom: 14px;
    }

    .lifestyle-description {
      font-size: 18px;
      margin-bottom: 18px;
    }

    .lifestyle-points li {
      font-size: 18px;
      margin-bottom: 10px;
    }

    /* Buttons pinned to bottom with 30px gap from card */
    .lifestyle-right {
      bottom: 24px;
      padding: 0 30px;
    }

    .lifestyle-container {
      /* Ensure card and buttons don't collapse together */
      justify-content: space-between;
      min-height: unset;
      height: 100%;
    }

    .lifestyle-buttons-container--desktop {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 12px;
      max-width: 100%;
      width: 100%;
    }

    .lifestyle-button--desktop {
      min-width: unset;
      flex: 1 1 calc(33.333% - 10px);
      max-width: calc(33.333% - 10px);
      padding: 12px 14px;
      font-size: 13px;
      letter-spacing: 0.4px;
    }
  }

  @media (max-width: 767px) {
    /* Stack: image on top half, card overlapping from middle down */
    .lifestyle-showcase {
      flex-direction: column;
      min-height: 100svh;
      position: relative;
    }

    .lifestyle-background {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    .lifestyle-background img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
    }

    .lifestyle-container {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-height: 100svh;
      position: relative;
      z-index: 2;
      padding-bottom: 10;
    
    }

    /* Single unified glass panel: card + buttons together */
    .lifestyle-left {
      padding: 0 14px 0 14px;
      padding-top: 0;
      display: flex;
      align-items: flex-end;
      justify-content: center;
    }

    .lifestyle-card {
      background: rgba(160, 148, 132, 0.45);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-bottom: none;
      border-radius: 18px 18px 18px 18px;
      padding: 22px 18px 20px 18px;
      width: 100%;
      max-width: 100%;
      min-height: unset;
      box-shadow: 0 -8px 32px rgba(0,0,0,0.18);
        margin-bottom: 20px;
    }

    .lifestyle-card:hover {
      transform: none;
      box-shadow: 0 -8px 32px rgba(0,0,0,0.18);
    }

    .lifestyle-heading {
      font-size: {{ section.settings.mobile_heading_size | default: 20 }}px !important;
      font-weight: 700;
      margin-bottom: 10px;
      letter-spacing: 0.5px;
    }

    .lifestyle-description {
      font-size: {{ section.settings.mobile_description_size | default: 13 }}px !important;
      line-height: 1.55;
      margin-bottom: 14px;
    }

    .lifestyle-points {
      margin-bottom: 24px;
    }

    .lifestyle-points li {
      font-size: {{ section.settings.mobile_points_size | default: 13 }}px !important;
      margin-bottom: 8px;
      padding-left: 18px;
    }

    .lifestyle-points li:before {
      content: "•";
      color: #4fffff;
      font-size: 16px;
    }

    /* Show mobile buttons inside card, hide desktop button panel */
    .lifestyle-buttons-mobile {
      display: block;
    }

    .lifestyle-right {
      display: none;
    }

    .lifestyle-buttons-container--mobile {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      width: 100%;
    }

    .lifestyle-button--mobile {
      padding: 11px 8px;
      font-size: {{ section.settings.mobile_button_size | default: 11 }}px !important;
      min-width: unset;
      width: 100%;
      white-space: normal;
      border-radius: 50px;
      letter-spacing: 0.3px;
    }

    .lifestyle-button--mobile:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
</style>

<section class="lifestyle-showcase full-width">
  <div class="lifestyle-background">
    {% if section.settings.background_image %}
      <img
        src="{{ section.settings.background_image | image_url: width: 1920 }}"
        alt="{{ section.settings.background_image.alt }}"
        width="1920"
        height="1080"
        loading="lazy"
      >
    {% endif %}
  </div>

  <div class="lifestyle-container">
    <div class="lifestyle-left">
      <div class="lifestyle-card">
        <h2 id="lifestyle-heading" class="lifestyle-heading">
          {{ section.settings.default_heading | default: 'OUR VALUES' }}
        </h2>
        <p id="lifestyle-description" class="lifestyle-description">
          {{
            section.settings.default_description
            | default: 'It was important to us to build a value driven business. At rhode, we believe in: Simplicity. Affordability. Authenticity. Quality. Transparency.'
          }}
        </p>
        <ul id="lifestyle-points" class="lifestyle-points">
          <li>{{ section.settings.default_point_1 | default: 'Premium Quality Ingredients' }}</li>
          <li>{{ section.settings.default_point_2 | default: 'Sustainable Practices' }}</li>
          <li>{{ section.settings.default_point_3 | default: 'Transparent Process' }}</li>
        </ul>

        {%- comment -%} Mobile: buttons live inside the card so it's one unified glass panel {%- endcomment -%}
        <div class="lifestyle-buttons-mobile">
          <div class="lifestyle-buttons-container lifestyle-buttons-container--mobile">
            {% for block in section.blocks %}
              <button class="lifestyle-button lifestyle-button--mobile{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}">
                {{ block.settings.button_text | default: 'Button ' | append: forloop.index }}
              </button>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

    <div class="lifestyle-right">
      <div class="lifestyle-buttons-container lifestyle-buttons-container--desktop">
        {% for block in section.blocks %}
          <button class="lifestyle-button lifestyle-button--desktop{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}">
            {{ block.settings.button_text | default: 'Button ' | append: forloop.index }}
          </button>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const desktopButtons = document.querySelectorAll('.lifestyle-button--desktop');
    const mobileButtons = document.querySelectorAll('.lifestyle-button--mobile');
    const allButtons = document.querySelectorAll('.lifestyle-button');
    const heading = document.getElementById('lifestyle-heading');
    const description = document.getElementById('lifestyle-description');
    const pointsList = document.getElementById('lifestyle-points');

    const contentData = [
      {% for block in section.blocks %}
        {
          heading: '{{ block.settings.heading | escape | default: "Content Heading" }}',
          description: '{{ block.settings.description | escape | default: "Content description goes here." }}',
          points: [
            '{{ block.settings.point_1 | escape | default: "Point 1" }}',
            '{{ block.settings.point_2 | escape | default: "Point 2" }}',
            '{{ block.settings.point_3 | escape | default: "Point 3" }}'
          ]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ];

    let currentIndex = 0;

    function updateContent(index) {
      // Sync active state on ALL buttons (both desktop and mobile sets)
      allButtons.forEach(btn => btn.classList.remove('active'));
      desktopButtons[index] && desktopButtons[index].classList.add('active');
      mobileButtons[index] && mobileButtons[index].classList.add('active');

      const data = contentData[index];
      if (!data) return;

      heading.style.opacity = '0';
      description.style.opacity = '0';
      pointsList.style.opacity = '0';

      setTimeout(() => {
        heading.textContent = data.heading;
        description.textContent = data.description;

        pointsList.innerHTML = '';
        data.points.forEach(point => {
          if (point.trim()) {
            const li = document.createElement('li');
            li.textContent = point;
            pointsList.appendChild(li);
          }
        });

        heading.style.opacity = '1';
        description.style.opacity = '1';
        pointsList.style.opacity = '1';
      }, 200);
    }

    // Desktop: hover triggers update
    desktopButtons.forEach((button, index) => {
      button.addEventListener('mouseenter', function () {
        currentIndex = index;
        updateContent(index);
      });
    });

    // Mobile: tap triggers update
    mobileButtons.forEach((button, index) => {
      button.addEventListener('click', function () {
        currentIndex = index;
        updateContent(index);
      });
    });

    // Initialize
    if (contentData.length > 0) {
      updateContent(0);
    }
  });
</script>

