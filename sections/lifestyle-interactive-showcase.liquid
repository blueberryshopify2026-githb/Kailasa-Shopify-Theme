{% comment %} Lifestyle Interactive Showcase Section {% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap');

  .lifestyle-showcase {
    font-family: 'Montserrat', sans-serif;
    background: #000000;
    min-height: 100vh;
    display: flex;
    position: relative;
    overflow: hidden;
  }

  .lifestyle-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .lifestyle-background img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lifestyle-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    position: relative;
    z-index: 2;
  }

  .lifestyle-left {
    padding: 60px;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    padding-top: calc(15vh + 30px);
  }

  .lifestyle-card {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(79, 255, 255, 0.2);
    border-radius: 20px;
    padding: 25px 20px;
    width: 100%;
    max-width: 500px;
    min-height: 60vh;
    height: auto;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
  }

  .lifestyle-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
    border-color: rgba(79, 255, 255, 0.4);
  }

  .lifestyle-heading {
    font-size: {{ section.settings.heading_size | default: 28 }}px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.4s ease;
  }

  .lifestyle-description {
    font-size: {{ section.settings.description_size | default: 16 }}px;
    font-weight: 400;
    color: #ffffff;
    line-height: 1.6;
    margin-bottom: 25px;
    opacity: 0.9;
    transition: all 0.4s ease;
  }

  .lifestyle-points {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .lifestyle-points li {
    font-size: {{ section.settings.points_size | default: 14 }}px;
    font-weight: 500;
    color: #ffffff;
    margin-bottom: 12px;
    padding-left: 20px;
    position: relative;
    transition: all 0.4s ease;
  }

  .lifestyle-points li:before {
    content: "•";
    color: #ffffff;
    font-size: 18px;
    position: absolute;
    left: 0;
    top: -2px;
  }

  .lifestyle-right {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    display: flex;
    justify-content: center;
    padding: 0 30px;
  }

  .lifestyle-buttons-container {
    display: flex;
    gap: 20px;
    justify-content: center;
    align-items: center;
    flex-wrap: nowrap;
    width: 100%;
    max-width: 800px;
  }

  .lifestyle-button {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 2px solid rgba(79, 255, 255, 0.3);
    border-radius: 50px;
    padding: 10px 10px;
    color: #ffffff;
    font-family: 'Montserrat', sans-serif;
    font-size: {{ section.settings.button_size | default: 14 }}px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
    min-width: 180px;
    text-align: center;
  }

  .lifestyle-button:hover {
    background: rgba(79, 255, 255, 0.2);
    border-color: #4fffff;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(79, 255, 255, 0.3);
  }

  .lifestyle-button.active {
    background: rgba(79, 255, 255, 0.3);
    border-color: #4fffff;
    color: #ffffff;
    box-shadow: 0 0 30px rgba(79, 255, 255, 0.5);
  }

  @media (max-width: 768px) {
    .lifestyle-left {
      padding: 20px;
      padding-top: calc(10vh + 20px);
    }

    .lifestyle-card {
      padding: 20px 15px;
      max-width: 100%;
      min-height: 60vh;
    }

    .lifestyle-right {
      position: relative;
      bottom: auto;
      left: auto;
      transform: none;
      padding: 20px;
      margin-top: 20px;
    }

    .lifestyle-buttons-container {
      gap: 8px;
      max-width: 100%;
      flex-wrap: wrap;
    }

    .lifestyle-button {
      padding: 10px 15px;
      font-size: 11px;
      min-width: 80px;
    }

    .lifestyle-heading {
      font-size: 24px;
    }

    .lifestyle-description {
      font-size: 14px;
    }

    .lifestyle-points li {
      font-size: 13px;
    }
  }
</style>

<section class="lifestyle-showcase full-width">
  <div class="lifestyle-background">
    {% if section.settings.background_image %}
      <img
        src="{{ section.settings.background_image | image_url: width: 1920 }}"
        alt="{{ section.settings.background_image.alt }}"
        width="1920"
        height="1080"
        loading="lazy"
      >
    {% endif %}
  </div>

  <div class="lifestyle-container">
    <div class="lifestyle-left">
      <div class="lifestyle-card">
        <h2 id="lifestyle-heading" class="lifestyle-heading">
          {{ section.settings.default_heading | default: 'OUR VALUES' }}
        </h2>
        <p id="lifestyle-description" class="lifestyle-description">
          {{
            section.settings.default_description
            | default: 'It was important to us to build a value driven business. At rhode, we believe in: Simplicity. Affordability. Authenticity. Quality. Transparency.'
          }}
        </p>
        <ul id="lifestyle-points" class="lifestyle-points">
          <li>{{ section.settings.default_point_1 | default: 'Premium Quality Ingredients' }}</li>
          <li>{{ section.settings.default_point_2 | default: 'Sustainable Practices' }}</li>
          <li>{{ section.settings.default_point_3 | default: 'Transparent Process' }}</li>
        </ul>
      </div>
    </div>

    <div class="lifestyle-right">
      <div class="lifestyle-buttons-container">
        {% for block in section.blocks %}
          <button class="lifestyle-button{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}">
            {{ block.settings.button_text | default: 'Button ' | append: forloop.index }}
          </button>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const buttons = document.querySelectorAll('.lifestyle-button');
    const heading = document.getElementById('lifestyle-heading');
    const description = document.getElementById('lifestyle-description');
    const pointsList = document.getElementById('lifestyle-points');

    const contentData = [
      {% for block in section.blocks %}
        {
          heading: '{{ block.settings.heading | escape | default: "Content Heading" }}',
          description: '{{ block.settings.description | escape | default: "Content description goes here." }}',
          points: [
            '{{ block.settings.point_1 | escape | default: "Point 1" }}',
            '{{ block.settings.point_2 | escape | default: "Point 2" }}',
            '{{ block.settings.point_3 | escape | default: "Point 3" }}'
          ]
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ];

    let currentIndex = 0;

    function updateContent(index) {
      // Remove active class from all buttons
      buttons.forEach(btn => btn.classList.remove('active'));

      // Add active class to current button
      if (buttons[index]) {
        buttons[index].classList.add('active');
      }

      const data = contentData[index];
      if (!data) return;

      // Fade out content
      heading.style.opacity = '0';
      description.style.opacity = '0';
      pointsList.style.opacity = '0';

      setTimeout(() => {
        // Update content
        heading.textContent = data.heading;
        description.textContent = data.description;

        // Update points
        pointsList.innerHTML = '';
        data.points.forEach(point => {
          if (point.trim()) {
            const li = document.createElement('li');
            li.textContent = point;
            pointsList.appendChild(li);
          }
        });

        // Fade in content
        heading.style.opacity = '1';
        description.style.opacity = '1';
        pointsList.style.opacity = '1';
      }, 200);
    }

    // Button hover handlers
    buttons.forEach((button, index) => {
      button.addEventListener('mouseenter', function () {
        currentIndex = index;
        updateContent(index);
      });
    });

    // Initialize with first content if available
    if (contentData.length > 0) {
      updateContent(0);
    }
  });
</script>

