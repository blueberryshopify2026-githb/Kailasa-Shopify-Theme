{% comment %}
  Lifestyle Section - Flexible layout with positionable text and image blocks
  Features: Background image, text blocks, image blocks with X/Y positioning
{% endcomment %}

<style>
  .lifestyle-section {
    font-family: 'Montserrat', sans-serif;
    position: relative;
    width: 100%;
    min-height: {{ section.settings.section_height }}vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: {{ section.settings.section_bg_color | default: '#f5f5f5' }};
  }

  /* Background Image */
  .lifestyle-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
  }

  .lifestyle-container {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: {{ section.settings.section_height }}vh;
    z-index: 1;
  }

  /* Text Block */
  .lifestyle-text-block {
    position: absolute;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 40px;
    width: 400px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
  }

  .lifestyle-text-title {
    font-size: 24px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 20px 0;
    line-height: 1.3;
    font-family: 'Montserrat', sans-serif;
  }

  .lifestyle-text-title .highlight {
    color: {{ section.settings.highlight_color | default: '#4FFFFF' }};
  }

  .lifestyle-text-item {
    margin-bottom: 20px;
  }

  .lifestyle-text-item:last-child {
    margin-bottom: 0;
  }

  .lifestyle-text-heading {
    font-size: 16px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 5px 0;
    text-transform: uppercase;
    font-family: 'Montserrat', sans-serif;
  }

  .lifestyle-text-description {
    font-size: 14px;
    color: #666666;
    margin: 0;
    line-height: 1.5;
    font-family: 'Montserrat', sans-serif;
  }

  /* Image Block */
  .lifestyle-image-block {
    position: absolute;
    background: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
    width: 350px;
  }

  .lifestyle-image-wrapper {
    width: 100%;
    height: 220px;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 15px;
  }

  .lifestyle-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lifestyle-image-caption {
    font-size: 14px;
    font-weight: 700;
    color: #000000;
    margin: 0 0 5px 0;
    text-transform: uppercase;
    font-family: 'Montserrat', sans-serif;
  }

  .lifestyle-image-description {
    font-size: 13px;
    color: #000000;
    margin: 0;
    line-height: 1.5;
    font-family: 'Montserrat', sans-serif;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .lifestyle-section {
      min-height: auto;
      padding: 40px 0;
    }

    .lifestyle-container {
      position: relative;
      min-height: auto;
      padding: 20px;
    }

    .lifestyle-text-block,
    .lifestyle-image-block {
      position: relative !important;
      left: 0 !important;
      top: 0 !important;
      transform: none !important;
      margin-bottom: 20px;
      width: 100%;
    }
  }
</style>

<section class="lifestyle-section">
  <!-- Background Image -->
  {% if section.settings.background_image %}
    <div class="lifestyle-background" 
         style="background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');">
    </div>
  {% endif %}

  <div class="lifestyle-container">
    {% for block in section.blocks %}
      {% if block.type == 'text_block' %}
        <!-- Text Block -->
        <div class="lifestyle-text-block" 
             style="left: {{ block.settings.position_x }}%; top: {{ block.settings.position_y }}%; transform: translate(-50%, -50%);"
             {{ block.shopify_attributes }}>
          {% if block.settings.title != blank %}
            <h2 class="lifestyle-text-title">{{ block.settings.title }}</h2>
          {% endif %}
          
          {% if block.settings.item1_heading != blank %}
            <div class="lifestyle-text-item">
              <h3 class="lifestyle-text-heading">{{ block.settings.item1_heading }}</h3>
              <p class="lifestyle-text-description">{{ block.settings.item1_description }}</p>
            </div>
          {% endif %}

          {% if block.settings.item2_heading != blank %}
            <div class="lifestyle-text-item">
              <h3 class="lifestyle-text-heading">{{ block.settings.item2_heading }}</h3>
              <p class="lifestyle-text-description">{{ block.settings.item2_description }}</p>
            </div>
          {% endif %}

          {% if block.settings.item3_heading != blank %}
            <div class="lifestyle-text-item">
              <h3 class="lifestyle-text-heading">{{ block.settings.item3_heading }}</h3>
              <p class="lifestyle-text-description">{{ block.settings.item3_description }}</p>
            </div>
          {% endif %}
        </div>

      {% elsif block.type == 'image_block' %}
        <!-- Image Block -->
        <div class="lifestyle-image-block" 
             style="left: {{ block.settings.position_x }}%; top: {{ block.settings.position_y }}%; transform: translate(-50%, -50%);"
             {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <div class="lifestyle-image-wrapper">
              <img src="{{ block.settings.image | image_url: width: 800 }}" 
                   alt="{{ block.settings.caption }}"
                   width="800"
                   height="auto"
                   loading="lazy">
            </div>
          {% endif %}
          
          {% if block.settings.caption != blank %}
            <h3 class="lifestyle-image-caption">{{ block.settings.caption }}</h3>
          {% endif %}
          
          {% if block.settings.description != blank %}
            <p class="lifestyle-image-description">{{ block.settings.description }}</p>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Lifestyle Section",
  "tag": "section",
  "class": "lifestyle-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background Color",
      "default": "#f5f5f5",
      "info": "Shows when no background image is set"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "vh",
      "label": "Section Height",
      "default": 100
    },
    {
      "type": "header",
      "content": "Text Styling"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight Color",
      "default": "#4FFFFF"
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Text Block",
      "settings": [
        {
          "type": "header",
          "content": "Position"
        },
        {
          "type": "range",
          "id": "position_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal Position (X-axis)",
          "default": 20,
          "info": "0% = left edge, 50% = center, 100% = right edge"
        },
        {
          "type": "range",
          "id": "position_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical Position (Y-axis)",
          "default": 40,
          "info": "0% = top edge, 50% = center, 100% = bottom edge"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "WHY OUR SKINCARE IS DIFFERENT"
        },
        {
          "type": "text",
          "id": "item1_heading",
          "label": "Item 1 Heading",
          "default": "MINIMAL INGREDIENTS"
        },
        {
          "type": "textarea",
          "id": "item1_description",
          "label": "Item 1 Description",
          "default": "Formulated with only functional actives. No unnecessary additives."
        },
        {
          "type": "text",
          "id": "item2_heading",
          "label": "Item 2 Heading",
          "default": "MAXIMUM EFFICACY"
        },
        {
          "type": "textarea",
          "id": "item2_description",
          "label": "Item 2 Description",
          "default": "Efficacy proven through controlled clinical studies. Results before aesthetics."
        },
        {
          "type": "text",
          "id": "item3_heading",
          "label": "Item 3 Heading",
          "default": "NO MARKETING NOISE"
        },
        {
          "type": "textarea",
          "id": "item3_description",
          "label": "Item 3 Description",
          "default": "No fragrance. No fillers. No hype. Science over sensation."
        }
      ]
    },
    {
      "type": "image_block",
      "name": "Image Block",
      "settings": [
        {
          "type": "header",
          "content": "Position"
        },
        {
          "type": "range",
          "id": "position_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal Position (X-axis)",
          "default": 80,
          "info": "0% = left edge, 50% = center, 100% = right edge"
        },
        {
          "type": "range",
          "id": "position_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical Position (Y-axis)",
          "default": 70,
          "info": "0% = top edge, 50% = center, 100% = bottom edge"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "RETINAL 0.1%"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Accelerates cell turnover + boosts collagen FINE-LINE REDUCTION, IMPROVED ELASTICITY"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lifestyle Section",
      "blocks": [
        {
          "type": "text_block",
          "settings": {
            "position_x": 20,
            "position_y": 30
          }
        },
        {
          "type": "image_block",
          "settings": {
            "position_x": 80,
            "position_y": 70
          }
        }
      ]
    }
  ]
}
{% endschema %}
