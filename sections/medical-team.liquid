{% comment %}
  Medical Team Section - Infinite carousel with center focus card and frosted glass overlay
{% endcomment %}

<style>
  .medical-team-section {
    font-family: 'Montserrat', sans-serif;
    background: {{ section.settings.section_bg_color | default: '#000000' }};
    padding: 40px 0 30px 0;
    overflow: hidden;
    min-height: auto;
    display: flex;
    align-items: center;
  }


  .medical-team-container {
    width: 100%;
    margin: 0;
    padding: 0;
  }


  /* Header */
  .medical-team-header {
    text-align: center;
    margin-bottom: 50px;
    background: transparent;
    width: 100%;
    padding: 0 20px;
  }


  .medical-team-title-wrapper {
    margin-bottom: 15px;
    background: transparent;
    width: 100%;
  }


  .medical-team-title {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: 800;
    color: {{ section.settings.title_color | default: '#ffffff' }};
    line-height: 1.2;
    margin: 0 auto;
    padding: 0;
    font-family: 'Montserrat', sans-serif;
    background: transparent !important;
    text-align: center;
    width: 100%;
  }


  .medical-team-title .medical-team-highlight {
    color: {{ section.settings.highlight_color | default: '#4FFFFF' }};
    background: transparent !important;
    background-color: transparent !important;
    font-size: inherit;
    font-weight: 800;
    display: inline;
    margin: 0;
    padding: 0;
    font-family: inherit;
    line-height: inherit;
    text-decoration: none;
    border: none;
    outline: none;
  }

  .medical-team-highlight {
    color: {{ section.settings.highlight_color | default: '#4FFFFF' }};
    background: transparent;
    font-weight: 800;
    display: inline;
    margin: 0;
    padding: 0;
  }


  .medical-team-title .medical-team-highlight::before,
  .medical-team-title .medical-team-highlight::after {
    display: none;
  }


  .medical-team-description {
    font-size: {{ section.settings.description_font_size }}px;
    color: {{ section.settings.description_color | default: '#ffffff' }};
    line-height: 1.6;
    margin: 0 auto;
    max-width: 800px;
    font-family: 'Montserrat', sans-serif;
    text-align: center;
  }


  /* Carousel */
  .medical-team-carousel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
    padding: 0 20px;
    height: 500px;
    min-height: 500px;
    width: 100%;
  }


  .medical-team-track-container {
    flex: 1;
    overflow: visible;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 500px;
  }


  .medical-team-track {
    display: flex;
    gap: 25px;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    padding: 15px 0;
    align-items: center;
    justify-content: center;
    height: 500px;
    opacity: 0;
    visibility: hidden;
    will-change: transform;
  }
 
  .medical-team-track.initialized {
    opacity: 1;
    visibility: visible;
  }


  /* Navigation Buttons */
  .medical-team-nav {
    background: {{ section.settings.nav_bg_color | default: '#000000' }};
    border: 2px solid {{ section.settings.nav_border_color | default: '#4FFFFF' }};
    border-radius: 50%;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    flex-shrink: 0;
    z-index: 10;
  }


  .medical-team-nav:hover {
    transform: scale(1.1);
    box-shadow: 0 0 20px {{ section.settings.nav_border_color | default: '#4FFFFF' }};
  }


  .medical-team-nav svg {
    width: 24px;
    height: 24px;
    stroke: {{ section.settings.nav_icon_color | default: '#4FFFFF' }};
  }


  /* Side Cards - Simple Grayscale Images */
  .medical-team-card {
    position: relative;
    flex-shrink: 0;
    cursor: pointer;
    transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    background: transparent;
    border-radius: 18px;
    padding: 0;
    box-shadow: none;
    width: 240px;
    height: 280px;
    opacity: 0.7;
    filter: grayscale(100%);
    align-self: center;
    overflow: hidden;
  }


  .medical-team-card:hover {
    opacity: 0.8;
    transform: none;
  }


  .side-card-image {
    width: 100%;
    height: 100%;
    border-radius: 18px;
    overflow: hidden;
    margin-bottom: 0;
    background: #f0f0f0;
  }


  .side-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  .side-card-name {
    display: none;
  }

  .side-card-designation {
    display: none;
  }


  /* Center Active Card - Larger with Full Image and Frosted Glass */
  .medical-team-card.active {
    width: 400px !important;
    height: 480px !important;
    opacity: 1 !important;
    filter: grayscale(0) !important;
    transform: scale(1) !important;
    z-index: 10 !important;
    border-radius: 22px !important;
    overflow: hidden !important;
    box-shadow: 0 25px 70px rgba(0, 0, 0, 0.5) !important;
    background: #000000 !important;
    padding: 0 !important;
    align-self: center !important;
    margin-bottom: 0 !important;
  }


  .medical-team-card.active:hover {
    transform: scale(1) !important;
    opacity: 1 !important;
  }


  .medical-team-card.active .side-card-image,
  .medical-team-card.active .side-card-name,
  .medical-team-card.active .side-card-designation {
    display: none !important;
  }
 
  .medical-team-card.active .center-card-image {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
  }
 
  .medical-team-card.active .center-card-image img {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }


  .center-card-image {
    width: 100%;
    height: 100%;
    position: relative;
    display: block;
  }


  .center-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }


  /* Frosted Glass Overlay */
  .center-card-frost {
    position: absolute;
    bottom: 30px;
    left: 30px;
    right: 30px;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    padding: 25px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease 0.2s, transform 0.5s ease 0.2s;
  }


  .medical-team-card.active .center-card-frost {
    opacity: 1;
    transform: translateY(0);
  }


  .center-card-name {
    font-size: 24px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 6px 0;
    font-family: 'Montserrat', sans-serif;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }


  .center-card-designation {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.95);
    margin: 0;
    font-family: 'Montserrat', sans-serif;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }


  .center-card-image {
    width: 100%;
    height: 100%;
    position: relative;
  }


  .center-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  /* Responsive */
  @media (max-width: 1024px) {
    .medical-team-header {
      margin-bottom: 40px;
    }

    .medical-team-card {
      width: 200px;
      height: 240px;
    }

    .medical-team-card.active {
      width: 350px !important;
      height: 420px !important;
    }

    .side-card-image {
      height: 150px;
    }
  }


  @media (max-width: 768px) {
    .medical-team-section {
      padding: 60px 0;
    }

    .medical-team-header {
      margin-bottom: 40px;
      padding: 0 15px;
    }

    .medical-team-title {
      font-size: {{ section.settings.title_font_size | minus: 10 }}px;
    }

    .medical-team-description {
      font-size: {{ section.settings.description_font_size | minus: 2 }}px;
    }

    .medical-team-carousel {
      gap: 15px;
      padding: 0 15px;
    }

    .medical-team-card {
      width: 200px;
      height: 240px;
    }

    .medical-team-card.active {
      width: 320px !important;
      height: 420px !important;
    }

    .side-card-image {
      height: 150px;
    }

    .side-card-name {
      font-size: 14px;
    }

    .side-card-designation {
      font-size: 12px;
    }

    .center-card-frost {
      bottom: 20px;
      left: 20px;
      right: 20px;
      padding: 20px;
    }

    .center-card-name {
      font-size: 22px;
    }

    .center-card-designation {
      font-size: 14px;
    }

    .medical-team-nav {
      width: 48px;
      height: 48px;
    }
  }


  /* ─── MOBILE ONLY: ≤768px ─────────────────────────────────────── */
  @media (max-width: 768px) {
    .medical-team-carousel { display: none !important; }

    .medical-team-section {
      display: block !important;
      overflow: visible !important;
      padding: 40px 0 50px !important;
    }

    .medical-team-container { display: block !important; }

    .medical-team-header  { margin-bottom: 32px !important; padding: 0 20px !important; }
    .medical-team-title   { font-size: {{ section.settings.title_font_size | minus: 6 }}px !important; }
    .medical-team-description { font-size: {{ section.settings.description_font_size | minus: 2 }}px !important; }

    .mt-mob-carousel {
      display: block !important;
      width: 100%;
      overflow: hidden;
      position: relative;
      height: {{ section.settings.mob_card_height | default: 75 }}vw;
    }

    .mt-mob-track {
      display: flex;
      align-items: center;
      gap: 12px;
      will-change: transform;
      position: absolute;
      left: 50%;
      top: 50%;
    }

    .mt-mob-spacer {
      display: none;
    }

    .mt-mob-card {
      flex: 0 0 {{ section.settings.mob_card_width | default: 62 }}vw;
      width: {{ section.settings.mob_card_width | default: 62 }}vw;
      height: {{ section.settings.mob_card_height | default: 75 }}vw;
      min-height: 300px;
      border-radius: 20px;
      overflow: hidden;
      position: relative;
      filter: grayscale(100%);
      opacity: 0.5;
      transition: filter 0.4s ease, opacity 0.4s ease, box-shadow 0.4s ease;
      background: #111;
      cursor: pointer;
      flex-shrink: 0;
    }

    .mt-mob-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      display: block;
    }

    .mt-mob-card.mt-mob-active {
      filter: grayscale(0) !important;
      opacity: 1 !important;
      box-shadow: 0 20px 60px rgba(0,0,0,0.5) !important;
      z-index: 5;
    }

    .mt-mob-frost {
      display: none;
      position: absolute;
      bottom: 16px;
      left: 12px;
      right: 12px;
      background: rgba(255,255,255,0.22);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      padding: 14px 16px;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,0.3);
    }
    .mt-mob-card.mt-mob-active .mt-mob-frost { display: block; }

    .mt-mob-frost-name {
      font-size: {{ section.settings.mob_frost_name_size | default: 16 }}px;
      font-weight: 700;
      color: #fff;
      margin: 0 0 3px;
      font-family: 'Montserrat', sans-serif;
    }
    .mt-mob-frost-desig {
      font-size: {{ section.settings.mob_frost_desig_size | default: 12 }}px;
      color: rgba(255,255,255,0.88);
      margin: 0;
      font-family: 'Montserrat', sans-serif;
    }
  }

  @media (min-width: 769px) {
    .mt-mob-carousel { display: none; }
  }

  /* ─── TABLET ONLY: 769px – 1024px ─────────────────────────────
     Same pattern as mobile. Desktop and mobile NOT changed.
     New classes use mt-tab- prefix.
  ─────────────────────────────────────────────────────────────── */
  @media (min-width: 769px) and (max-width: 1024px) {
    /* Hide desktop carousel */
    .medical-team-carousel { display: none !important; }

    .medical-team-section {
      display: block !important;
      overflow: visible !important;
      padding: 50px 0 60px !important;
    }

    .medical-team-container { display: block !important; }

    .medical-team-header  { margin-bottom: 40px !important; }

    /* Tablet carousel wrapper */
    .mt-tab-carousel {
      display: block;
      width: 100%;
      overflow: hidden;
      position: relative;
      height: 52vw;
    }

    .mt-tab-track {
      display: flex;
      align-items: center;
      gap: 16px;
      will-change: transform;
      position: absolute;
      left: 50%;
      top: 50%;
    }

    /* Side cards */
    .mt-tab-card {
      flex: 0 0 {{ section.settings.tab_side_width | default: 26 }}vw;
      width: {{ section.settings.tab_side_width | default: 26 }}vw;
      height: 34vw;
      border-radius: 20px;
      overflow: hidden;
      position: relative;
      filter: grayscale(100%);
      opacity: 0.5;
      transition: filter 0.4s ease, opacity 0.4s ease, box-shadow 0.4s ease;
      background: #111;
      cursor: pointer;
      flex-shrink: 0;
    }

    .mt-tab-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      display: block;
    }

    /* Active center card */
    .mt-tab-card.mt-tab-active {
      flex: 0 0 {{ section.settings.tab_active_width | default: 40 }}vw !important;
      width: {{ section.settings.tab_active_width | default: 40 }}vw !important;
      height: 52vw !important;
      filter: grayscale(0) !important;
      opacity: 1 !important;
      box-shadow: 0 25px 70px rgba(0,0,0,0.5) !important;
      z-index: 5;
    }

    /* Frosted glass */
    .mt-tab-frost {
      display: none;
      position: absolute;
      bottom: 20px;
      left: 16px;
      right: 16px;
      background: rgba(255,255,255,0.22);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      padding: 18px 20px;
      border-radius: 16px;
      border: 1px solid rgba(255,255,255,0.3);
    }
    .mt-tab-card.mt-tab-active .mt-tab-frost { display: block; }

    .mt-tab-frost-name {
      font-size: {{ section.settings.tab_frost_name_size | default: 20 }}px;
      font-weight: 700;
      color: #fff;
      margin: 0 0 4px;
      font-family: 'Montserrat', sans-serif;
    }
    .mt-tab-frost-desig {
      font-size: {{ section.settings.tab_frost_desig_size | default: 14 }}px;
      color: rgba(255,255,255,0.88);
      margin: 0;
      font-family: 'Montserrat', sans-serif;
    }
  }

  /* Hide tablet carousel outside tablet range */
  .mt-tab-carousel { display: none; }
  @media (min-width: 769px) and (max-width: 1024px) {
    .mt-tab-carousel { display: block; }
  }
</style>


<section class="medical-team-section full-width">
  <div class="medical-team-container">
    <!-- Header -->
    <div class="medical-team-header">
      <div class="medical-team-title-wrapper">
        <h2 class="medical-team-title">
          {{ section.settings.title_part1 | default: 'MEET OUR SPECIALISED' }}
          <span class="medical-team-highlight">{{ section.settings.title_part2 | default: 'MEDICAL TEAM' }}</span>
        </h2>
      </div>
      <p class="medical-team-description">
        {{ section.settings.description | default: 'The science of probiotics demands precision. In collaboration with leading scientists and research partners from around the world' }}
      </p>
    </div>


    <!-- Carousel -->
    <div class="medical-team-carousel">
      <button class="medical-team-nav" onclick="moveMedicalTeam(-1, '{{ section.id }}')">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M15 18L9 12L15 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>


      <div class="medical-team-track-container">
        <div class="medical-team-track" id="medical-track-{{ section.id }}">
          <!-- Clone sets before for infinite loop -->
          {% assign card_index = 0 %}
          {% for i in (1..100) %}
            {% for block in section.blocks %}
              <div class="medical-team-card clone-card"
                   data-original-index="{{ forloop.index0 }}"
                   data-card-index="{{ card_index }}"
                   data-image-url="{{ block.settings.image | image_url: width: 900 }}"
                   data-name="{{ block.settings.name }}"
                   data-designation="{{ block.settings.designation }}"
                   onclick="handleCardClick(this, '{{ section.id }}')">
                <div class="side-card-image">
                  {% if block.settings.image %}
                    <img src="{{ block.settings.image | image_url: width: 560 }}"
                         alt="{{ block.settings.name }}"
                         width="560"
                         height="560"
                         loading="lazy">
                  {% endif %}
                </div>
                <h3 class="side-card-name">{{ block.settings.name }}</h3>
                <p class="side-card-designation">{{ block.settings.designation }}</p>
              </div>
              {% assign card_index = card_index | plus: 1 %}
            {% endfor %}
          {% endfor %}


          <!-- Original cards -->
          {% for block in section.blocks %}
            <div class="medical-team-card original-card {% if forloop.first %}active{% endif %}"
                 data-index="{{ forloop.index0 }}"
                 data-card-index="{{ card_index }}"
                 data-image-url="{{ block.settings.image | image_url: width: 900 }}"
                 data-name="{{ block.settings.name }}"
                 data-designation="{{ block.settings.designation }}"
                 onclick="handleCardClick(this, '{{ section.id }}')">
             
              {% if forloop.first %}
                <!-- Center Active Card -->
                <div class="center-card-image">
                  {% if block.settings.image %}
                    <img src="{{ block.settings.image | image_url: width: 900 }}"
                         alt="{{ block.settings.name }}"
                         width="900"
                         height="1100">
                  {% endif %}
                  <div class="center-card-frost">
                    <h3 class="center-card-name">{{ block.settings.name }}</h3>
                    <p class="center-card-designation">{{ block.settings.designation }}</p>
                  </div>
                </div>
              {% else %}
                <!-- Side Polaroid Card -->
                <div class="side-card-image">
                  {% if block.settings.image %}
                    <img src="{{ block.settings.image | image_url: width: 560 }}"
                         alt="{{ block.settings.name }}"
                         width="560"
                         height="560"
                         loading="lazy">
                  {% endif %}
                </div>
                <h3 class="side-card-name">{{ block.settings.name }}</h3>
                <p class="side-card-designation">{{ block.settings.designation }}</p>
              {% endif %}
            </div>
            {% assign card_index = card_index | plus: 1 %}
          {% endfor %}


          <!-- Clone sets after for infinite loop -->
          {% for i in (1..50) %}
            {% for block in section.blocks %}
              <div class="medical-team-card clone-card"
                   data-original-index="{{ forloop.index0 }}"
                   data-card-index="{{ card_index }}"
                   data-image-url="{{ block.settings.image | image_url: width: 900 }}"
                   data-name="{{ block.settings.name }}"
                   data-designation="{{ block.settings.designation }}"
                   onclick="handleCardClick(this, '{{ section.id }}')">
                <div class="side-card-image">
                  {% if block.settings.image %}
                    <img src="{{ block.settings.image | image_url: width: 560 }}"
                         alt="{{ block.settings.name }}"
                         width="560"
                         height="560"
                         loading="lazy">
                  {% endif %}
                </div>
                <h3 class="side-card-name">{{ block.settings.name }}</h3>
                <p class="side-card-designation">{{ block.settings.designation }}</p>
              </div>
              {% assign card_index = card_index | plus: 1 %}
            {% endfor %}
          {% endfor %}
        </div>
      </div>


      <button class="medical-team-nav" onclick="moveMedicalTeam(1, '{{ section.id }}')">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M9 18L15 12L9 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>

  {% comment %}── MOBILE CAROUSEL (≤768px) — desktop carousel hidden at this breakpoint ──{% endcomment %}
  <div class="mt-mob-carousel" id="mt-mob-{{ section.id }}">
    <div class="mt-mob-track" id="mt-mob-track-{{ section.id }}">
      <div class="mt-mob-spacer"></div>
      {% for block in section.blocks %}
        <div class="mt-mob-card {% if forloop.first %}mt-mob-active{% endif %}"
             data-mob-index="{{ forloop.index0 }}"
             data-name="{{ block.settings.name | escape }}"
             data-desig="{{ block.settings.designation | escape }}">
          {% if block.settings.image %}
            <img src="{{ block.settings.image | image_url: width: 600 }}"
                 alt="{{ block.settings.name | escape }}"
                 width="600" height="750"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          {% endif %}
          <div class="mt-mob-frost">
            <p class="mt-mob-frost-name">{{ block.settings.name }}</p>
            <p class="mt-mob-frost-desig">{{ block.settings.designation }}</p>
          </div>
        </div>
      {% endfor %}
      <div class="mt-mob-spacer"></div>
    </div>
  </div>
  {% comment %}── TABLET CAROUSEL (769px–1024px) ──{% endcomment %}
  <div class="mt-tab-carousel" id="mt-tab-{{ section.id }}">
    <div class="mt-tab-track" id="mt-tab-track-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="mt-tab-card {% if forloop.first %}mt-tab-active{% endif %}"
             data-tab-index="{{ forloop.index0 }}"
             data-name="{{ block.settings.name | escape }}"
             data-desig="{{ block.settings.designation | escape }}">
          {% if block.settings.image %}
            <img src="{{ block.settings.image | image_url: width: 800 }}"
                 alt="{{ block.settings.name | escape }}"
                 width="800" height="1000"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          {% endif %}
          <div class="mt-tab-frost">
            <p class="mt-tab-frost-name">{{ block.settings.name }}</p>
            <p class="mt-tab-frost-desig">{{ block.settings.designation }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

</section>


<script>
(function() {
// Medical Team Carousel - Exact copy of ingredients logic
window.medicalTeamData = window.medicalTeamData || {};


function initializeMedicalTeam(sectionId) {
  const originalBlocksCount = parseInt('{{ section.blocks.size }}');
  // Start at the first card of the original set (after 100 clone sets)
  const currentIndex = 100 * originalBlocksCount;


  window.medicalTeamData[sectionId] = {
    originalBlocksCount: originalBlocksCount,
    currentIndex: currentIndex,
    previousIndex: currentIndex,
    isTransitioning: false
  };


  const track = document.getElementById(`medical-track-${sectionId}`);
  const cards = track.querySelectorAll('.medical-team-card');


  if (cards.length === 0) return;


  track.style.transition = 'none';


  // Update all cards to their initial state
  cards.forEach((card, i) => {
    const imageUrl = card.getAttribute('data-image-url') || '';
    const name = card.getAttribute('data-name') || 'Name';
    const designation = card.getAttribute('data-designation') || 'Designation';
   
    if (i === currentIndex) {
      // Initial active card - full image with frosted glass
      card.innerHTML = `
        <div class="center-card-image">
          <img src="${imageUrl}" alt="${name}" width="320" height="400" style="display: block;">
          <div class="center-card-frost">
            <h3 class="center-card-name">${name}</h3>
            <p class="center-card-designation">${designation}</p>
          </div>
        </div>
      `;
      card.classList.add('active');
    } else {
      // All other cards - simple grayscale image only
      card.innerHTML = `
        <div class="side-card-image">
          <img src="${imageUrl}" alt="${name}" width="240" height="280">
        </div>
      `;
      card.classList.remove('active');
    }
  });


  // Position immediately without delay
  centerMedicalCard(currentIndex, sectionId, false);
 
  // Show the track after positioning
  setTimeout(() => {
    track.classList.add('initialized');
  }, 100);
}


function selectMedicalCard(index, sectionId, animate = true) {
  const track = document.getElementById(`medical-track-${sectionId}`);
  const cards = track.querySelectorAll('.medical-team-card');


  const data = window.medicalTeamData[sectionId];
  if (data.currentIndex === index && animate) return;


  const previousIndex = data.currentIndex;


  // STEP 1: Update ALL card content to their FINAL state IMMEDIATELY
  cards.forEach((card, i) => {
    const imageUrl = card.getAttribute('data-image-url') || '';
    const name = card.getAttribute('data-name') || 'Name';
    const designation = card.getAttribute('data-designation') || 'Designation';
   
    if (i === index) {
      // New active card - full image with frosted glass
      card.innerHTML = `
        <div class="center-card-image">
          <img src="${imageUrl}" alt="${name}" width="320" height="400" style="display: block;">
          <div class="center-card-frost">
            <h3 class="center-card-name">${name}</h3>
            <p class="center-card-designation">${designation}</p>
          </div>
        </div>
      `;
      card.classList.add('active');
    } else {
      // All other cards - simple grayscale image only
      card.innerHTML = `
        <div class="side-card-image">
          <img src="${imageUrl}" alt="${name}" width="240" height="280">
        </div>
      `;
      card.classList.remove('active');
    }
  });


  data.currentIndex = index;
 
  // STEP 2: Start slide animation immediately (no delay)
  requestAnimationFrame(() => {
    centerMedicalCard(index, sectionId, animate);
  });
}


function centerMedicalCard(index, sectionId, animate = true) {
  const track = document.getElementById(`medical-track-${sectionId}`);
  const cards = track.querySelectorAll('.medical-team-card');
  const container = track.parentElement;


  if (cards.length === 0) return;


  const activeCard = cards[index];
  if (!activeCard) return;


  const data = window.medicalTeamData[sectionId];


  const containerWidth = container.offsetWidth;
  const containerCenter = containerWidth / 2;


  const sideCardWidth = 240;
  const activeCardWidth = 400;
  const gap = 25;


  // Calculate the left edge position of the active card
  let leftEdgePosition = 0;
 
  for (let i = 0; i < index; i++) {
    // All cards before the active one are side cards
    leftEdgePosition += sideCardWidth + gap;
  }


  // Add half of the active card width to get to its center
  const activeCardCenter = leftEdgePosition + (activeCardWidth / 2);


  // Calculate how much to shift to center the active card
  const targetTransform = containerCenter - activeCardCenter;


  if (!animate) {
    track.style.transition = 'none';
  } else {
    track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
  }


  track.style.transform = `translateX(${targetTransform}px)`;


  if (!animate) {
    requestAnimationFrame(() => {
      track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
    });
  }


  data.previousIndex = index;
}


function moveMedicalTeam(direction, sectionId) {
  const data = window.medicalTeamData[sectionId];
  if (data.isTransitioning) return;


  data.isTransitioning = true;


  const track = document.getElementById(`medical-track-${sectionId}`);
  const cards = track.querySelectorAll('.medical-team-card');
  const totalCards = cards.length;
  const originalBlocksCount = data.originalBlocksCount;


  let newIndex = data.currentIndex + direction;
 
  // Define boundaries
  const firstCloneSetStart = 0;
  const firstCloneSetEnd = (100 * originalBlocksCount) - 1;
  const originalSetStart = 100 * originalBlocksCount;
  const originalSetEnd = originalSetStart + originalBlocksCount - 1;
  const lastCloneSetStart = originalSetEnd + 1;
  const lastCloneSetEnd = totalCards - 1;


  // Check if we're at boundaries and need to loop
  let needsLoop = false;
  let jumpToIndex = newIndex;


  // Moving right: if we go past the end of the first clone set after originals
  if (newIndex > originalSetEnd + originalBlocksCount) {
    needsLoop = true;
    // Calculate position within the pattern
    const positionInSet = (newIndex - originalSetStart) % originalBlocksCount;
    jumpToIndex = originalSetStart + positionInSet;
  }
  // Moving left: if we go before the last clone set before originals
  else if (newIndex < originalSetStart - originalBlocksCount) {
    needsLoop = true;
    // Calculate position within the pattern
    const positionInSet = ((newIndex - originalSetStart) % originalBlocksCount + originalBlocksCount) % originalBlocksCount;
    jumpToIndex = originalSetStart + positionInSet;
  }


  // Perform the slide
  selectMedicalCard(newIndex, sectionId, true);


  if (needsLoop) {
    // After animation completes, jump to equivalent position
    setTimeout(() => {
      track.style.transition = 'none';
      selectMedicalCard(jumpToIndex, sectionId, false);
     
      requestAnimationFrame(() => {
        track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        data.isTransitioning = false;
      });
    }, 600);
  } else {
    setTimeout(() => {
      data.isTransitioning = false;
    }, 650);
  }
}


function handleCardClick(cardElement, sectionId) {
  const data = window.medicalTeamData[sectionId];
  if (data.isTransitioning) return;


  // Find the index of the clicked card in the NodeList
  const track = document.getElementById(`medical-track-${sectionId}`);
  const cards = track.querySelectorAll('.medical-team-card');
  const clickedIndex = Array.from(cards).indexOf(cardElement);


  if (clickedIndex === -1) return;


  data.isTransitioning = true;
  selectMedicalCard(clickedIndex, sectionId, true);


  setTimeout(() => {
    data.isTransitioning = false;
  }, 650);
}

// Expose onclick-bound functions to global scope
window.moveMedicalTeam = moveMedicalTeam;
window.handleCardClick = handleCardClick;

// ── Breakpoint-aware init — only reinit when breakpoint CHANGES ──────────────
var _currentBP = null; // 'mobile' | 'tablet' | 'desktop'

function getBreakpoint() {
  var w = window.innerWidth;
  if (w <= 768)              return 'mobile';
  if (w >= 769 && w <= 1024) return 'tablet';
  return 'desktop';
}

function handleBreakpointInit(sid) {
  var bp = getBreakpoint();
  if (bp === _currentBP) return; // same breakpoint — do nothing
  _currentBP = bp;

  if (bp === 'mobile') {
    destroyDesktopCarousel(sid);
    destroyTabCarousel(sid);
    initMobCarousel(sid);
  } else if (bp === 'tablet') {
    destroyDesktopCarousel(sid);
    destroyMobCarousel(sid);
    initTabCarousel(sid);
  } else {
    destroyMobCarousel(sid);
    destroyTabCarousel(sid);
    initializeMedicalTeam(sid);
  }
}

// Destroy helpers — only clean up state/transforms, never touch the DOM of
// the carousel that is about to be reinited (initMob handles its own DOM).
function destroyDesktopCarousel(sid) {
  var track = document.getElementById('medical-track-' + sid);
  if (track) {
    track.style.transform = '';
    track.style.transition = '';
    track.classList.remove('initialized');
  }
  if (window.medicalTeamData && window.medicalTeamData[sid]) {
    delete window.medicalTeamData[sid];
  }
}

function destroyMobCarousel(sid) {
  var track = document.getElementById('mt-mob-track-' + sid);
  if (track) {
    track.style.transform = '';
    track.style.transition = '';
  }
}

function destroyTabCarousel(sid) {
  var track = document.getElementById('mt-tab-track-' + sid);
  if (track) {
    track.style.transform = '';
    track.style.transition = '';
  }
}

// Initialize on load
document.addEventListener('DOMContentLoaded', function() {
  handleBreakpointInit('{{ section.id }}');
});

// Resize: only fires reinit when breakpoint boundary is crossed
var resizeTimer;
window.addEventListener('resize', function() {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(function() {
    handleBreakpointInit('{{ section.id }}');
  }, 200);
});

// ── Mobile Carousel ──────────────────────────────────────────────────────────
var _mobCardData = null;

function initMobCarousel(sid) {
  if (window.innerWidth > 768) return;

  var track = document.getElementById('mt-mob-track-' + sid);
  if (!track) return;

  // Capture original card data once
  if (!_mobCardData) {
    var origEls = Array.from(track.querySelectorAll('.mt-mob-card:not(.mt-mob-clone)'));
    if (!origEls.length) origEls = Array.from(track.querySelectorAll('.mt-mob-card'));
    if (!origEls.length) return;
    _mobCardData = origEls.map(function(c) {
      return {
        img:   c.querySelector('img') ? c.querySelector('img').outerHTML : '',
        name:  c.querySelector('.mt-mob-frost-name') ? c.querySelector('.mt-mob-frost-name').textContent : '',
        desig: c.querySelector('.mt-mob-frost-desig') ? c.querySelector('.mt-mob-frost-desig').textContent : ''
      };
    });
  }

  var N = _mobCardData.length;
  if (N === 0) return;

  // ── N+4 clone structure — same as ugc-content-section ────────────────────
  var PREPEND = 2, APPEND = 2;
  var SIDE_VW  = {{ section.settings.mob_card_width | default: 62 }} / 100;
  var CTR_VW   = {{ section.settings.mob_card_width | default: 62 }} / 100; // same width, grayscale differs
  var GAP      = 12;

  function buildCard(dataIdx, extraClass) {
    var d = _mobCardData[((dataIdx % N) + N) % N];
    var div = document.createElement('div');
    div.className = 'mt-mob-card' + (extraClass ? ' ' + extraClass : '');
    div.innerHTML = d.img +
      '<div class="mt-mob-frost">' +
        '<p class="mt-mob-frost-name">' + d.name + '</p>' +
        '<p class="mt-mob-frost-desig">' + d.desig + '</p>' +
      '</div>';
    return div;
  }

  track.innerHTML = '';
  var cards = [];
  for (var p = PREPEND; p >= 1; p--) { var c = buildCard(N - p, 'mt-mob-clone'); track.appendChild(c); cards.push(c); }
  for (var i = 0; i < N; i++)         { var c = buildCard(i, '');               track.appendChild(c); cards.push(c); }
  for (var a = 0; a < APPEND; a++)    { var c = buildCard(a, 'mt-mob-clone');   track.appendChild(c); cards.push(c); }

  var current   = PREPEND; // real card 0
  var animating = false;

  // ── centerMob: position:absolute left:50% top:50% ─────────────────────────
  // translateX = -(index × (cardW+gap) + cardW/2), translateY = -50%
  function centerMob(idx, anim) {
    var cardW = Math.round(window.innerWidth * SIDE_VW);
    var tx    = -(idx * (cardW + GAP) + cardW / 2);
    track.style.transition = anim
      ? 'transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94)'
      : 'none';
    track.style.transform = 'translateX(' + tx + 'px) translateY(-50%)';
    if (!anim) {
      requestAnimationFrame(function() {
        track.style.transition = 'transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94)';
      });
    }
  }

  function applyStates(idx) {
    cards.forEach(function(c, i) { c.classList.toggle('mt-mob-active', i === idx); });
  }

  // ── go: pre-jump before animating — no blink ─────────────────────────────
  function go(dir) {
    if (animating) return;
    animating = true;

    if (dir === 1 && current === PREPEND + N - 1) {
      var jumpTo = current - N;
      var cardW  = Math.round(window.innerWidth * SIDE_VW);
      var jumpTx = -(jumpTo * (cardW + GAP) + cardW / 2);
      track.style.transition = 'none';
      track.style.transform  = 'translateX(' + jumpTx + 'px) translateY(-50%)';
      track.getBoundingClientRect();
      current = jumpTo;
    } else if (dir === -1 && current === PREPEND) {
      var jumpTo = current + N;
      var cardW  = Math.round(window.innerWidth * SIDE_VW);
      var jumpTx = -(jumpTo * (cardW + GAP) + cardW / 2);
      track.style.transition = 'none';
      track.style.transform  = 'translateX(' + jumpTx + 'px) translateY(-50%)';
      track.getBoundingClientRect();
      current = jumpTo;
    }

    current += dir;
    applyStates(current);
    track.style.transition = 'transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94)';
    centerMob(current, true);

    setTimeout(function() { animating = false; }, 520);
  }

  // Click
  track.addEventListener('click', function(e) {
    var card = e.target.closest('.mt-mob-card');
    if (!card || animating) return;
    var idx = cards.indexOf(card);
    if (idx === -1 || idx === current) return;
    go(idx > current ? 1 : -1);
  });

  // Swipe
  var sx = 0, sy = 0, swDir = null;
  track.parentElement.addEventListener('touchstart', function(e) {
    sx = e.touches[0].clientX; sy = e.touches[0].clientY; swDir = null;
  }, { passive: true });
  track.parentElement.addEventListener('touchmove', function(e) {
    if (swDir === 'v') return;
    var dx = Math.abs(e.touches[0].clientX - sx), dy = Math.abs(e.touches[0].clientY - sy);
    if (!swDir && dx < 5 && dy < 5) return;
    if (!swDir) swDir = dx >= dy ? 'h' : 'v';
    if (swDir === 'h') e.preventDefault();
  }, { passive: false });
  track.parentElement.addEventListener('touchend', function(e) {
    if (swDir !== 'h' || animating) return;
    if (Math.abs(e.changedTouches[0].clientX - sx) > 35)
      go(e.changedTouches[0].clientX < sx ? 1 : -1);
  }, { passive: true });

  // Init
  applyStates(current);
  centerMob(current, false);
}

// ── Tablet Carousel (769px–1024px) — same pattern as mobile ─────────────────
function initTabCarousel(sid) {
  if (window.innerWidth < 769 || window.innerWidth > 1024) return;

  var track = document.getElementById('mt-tab-track-' + sid);
  if (!track) return;

  // Collect original cards (strip old clones first)
  Array.from(track.querySelectorAll('.mt-tab-clone')).forEach(function(c) { c.parentNode.removeChild(c); });
  track.style.transform = ''; track.style.transition = '';

  var origCards = Array.from(track.querySelectorAll('.mt-tab-card'));
  var N = origCards.length;
  if (N === 0) return;

  var origData = origCards.map(function(c) {
    return {
      img:   c.querySelector('img') ? c.querySelector('img').outerHTML : '',
      name:  c.querySelector('.mt-tab-frost-name') ? c.querySelector('.mt-tab-frost-name').textContent : '',
      desig: c.querySelector('.mt-tab-frost-desig') ? c.querySelector('.mt-tab-frost-desig').textContent : ''
    };
  });

  var PREPEND    = 2, APPEND = 2;
  var SIDE_VW    = {{ section.settings.tab_side_width | default: 26 }} / 100;
  var CTR_VW     = {{ section.settings.tab_active_width | default: 40 }} / 100;
  var GAP        = 16;

  function buildTabCard(dataIdx, extraClass) {
    var d = origData[((dataIdx % N) + N) % N];
    var el = document.createElement('div');
    el.className = 'mt-tab-card' + (extraClass ? ' ' + extraClass : '');
    el.innerHTML = d.img +
      '<div class="mt-tab-frost">' +
        '<p class="mt-tab-frost-name">' + d.name + '</p>' +
        '<p class="mt-tab-frost-desig">' + d.desig + '</p>' +
      '</div>';
    return el;
  }

  // Rebuild track with N+4 structure
  track.innerHTML = '';
  var cards = [];
  for (var p = PREPEND; p >= 1; p--) { var c = buildTabCard(N - p, 'mt-tab-clone'); track.appendChild(c); cards.push(c); }
  for (var i = 0; i < N; i++)         { var c = buildTabCard(i, '');                track.appendChild(c); cards.push(c); }
  for (var a = 0; a < APPEND; a++)    { var c = buildTabCard(a, 'mt-tab-clone');    track.appendChild(c); cards.push(c); }

  var current   = PREPEND;
  var animating = false;

  // ── centerTab: position:absolute left:50% top:50% ─────────────────────────
  // Side cards use SIDE_VW, active card uses CTR_VW
  // translateX = -(index × (sideW+gap) + ctrW/2) — active card always ctrW
  function centerTab(idx, anim) {
    var sideW = Math.round(window.innerWidth * SIDE_VW);
    var ctrW  = Math.round(window.innerWidth * CTR_VW);
    var tx    = -(idx * (sideW + GAP) + ctrW / 2);
    track.style.transition = anim
      ? 'transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94)'
      : 'none';
    track.style.transform = 'translateX(' + tx + 'px) translateY(-50%)';
    if (!anim) {
      requestAnimationFrame(function() {
        track.style.transition = 'transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94)';
      });
    }
  }

  function applyStates(idx) {
    cards.forEach(function(c, i) { c.classList.toggle('mt-tab-active', i === idx); });
  }

  // ── go: pre-jump before animating — no blink ─────────────────────────────
  function go(dir) {
    if (animating) return;
    animating = true;

    if (dir === 1 && current === PREPEND + N - 1) {
      var jumpTo = current - N;
      var sideW  = Math.round(window.innerWidth * SIDE_VW);
      var ctrW   = Math.round(window.innerWidth * CTR_VW);
      var jumpTx = -(jumpTo * (sideW + GAP) + ctrW / 2);
      track.style.transition = 'none';
      track.style.transform  = 'translateX(' + jumpTx + 'px) translateY(-50%)';
      track.getBoundingClientRect();
      current = jumpTo;
    } else if (dir === -1 && current === PREPEND) {
      var jumpTo = current + N;
      var sideW  = Math.round(window.innerWidth * SIDE_VW);
      var ctrW   = Math.round(window.innerWidth * CTR_VW);
      var jumpTx = -(jumpTo * (sideW + GAP) + ctrW / 2);
      track.style.transition = 'none';
      track.style.transform  = 'translateX(' + jumpTx + 'px) translateY(-50%)';
      track.getBoundingClientRect();
      current = jumpTo;
    }

    current += dir;
    applyStates(current);
    track.style.transition = 'transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94)';
    centerTab(current, true);

    setTimeout(function() { animating = false; }, 520);
  }

  // Click
  track.addEventListener('click', function(e) {
    var card = e.target.closest('.mt-tab-card');
    if (!card || animating) return;
    var idx = cards.indexOf(card);
    if (idx === -1 || idx === current) return;
    go(idx > current ? 1 : -1);
  });

  // Swipe
  var sx = 0, sy = 0, swDir = null;
  track.parentElement.addEventListener('touchstart', function(e) {
    sx = e.touches[0].clientX; sy = e.touches[0].clientY; swDir = null;
  }, { passive: true });
  track.parentElement.addEventListener('touchmove', function(e) {
    if (swDir === 'v') return;
    var dx = Math.abs(e.touches[0].clientX - sx), dy = Math.abs(e.touches[0].clientY - sy);
    if (!swDir && dx < 5 && dy < 5) return;
    if (!swDir) swDir = dx >= dy ? 'h' : 'v';
    if (swDir === 'h') e.preventDefault();
  }, { passive: false });
  track.parentElement.addEventListener('touchend', function(e) {
    if (swDir !== 'h' || animating) return;
    if (Math.abs(e.changedTouches[0].clientX - sx) > 35)
      go(e.changedTouches[0].clientX < sx ? 1 : -1);
  }, { passive: true });

  // Init
  applyStates(current);
  centerTab(current, false);
}

})(); // end IIFE
