<script>
  function toggleMultiTabContent(button) {
    const contentInner = button.nextElementSibling.querySelector('.tab-content-inner');
    const isExpanded = button.getAttribute('aria-expanded') === 'true';

    button.setAttribute('aria-expanded', !isExpanded);
    contentInner.style.display = isExpanded ? 'none' : 'block';
  }

  function switchProductTab(button, productTabIndex) {
    const section = button.closest('.multi-tab-section');

    // Remove active class from all product tab buttons and content
    section.querySelectorAll('.product-tab-nav-button').forEach((btn) => btn.classList.remove('active'));
    section.querySelectorAll('.product-tab-content').forEach((content) => content.classList.remove('active'));

    // Add active class to clicked button and corresponding content
    button.classList.add('active');
    section.querySelector(`.product-tab-content[data-product-tab="${productTabIndex}"]`).classList.add('active');

    // Reset inner tabs to show "About" tab by default
    const activeProductContent = section.querySelector(`.product-tab-content[data-product-tab="${productTabIndex}"]`);
    if (activeProductContent) {
      // Reset inner tab navigation
      activeProductContent.querySelectorAll('.inner-tab-nav-button').forEach((btn) => btn.classList.remove('active'));
      activeProductContent
        .querySelectorAll('.inner-tab-content')
        .forEach((content) => content.classList.remove('active'));

      // Activate "About" tab
      const aboutButton = activeProductContent.querySelector('.inner-tab-nav-button[data-inner-tab="about"]');
      const aboutContent = activeProductContent.querySelector('.inner-tab-content[data-inner-tab="about"]');
      if (aboutButton && aboutContent) {
        aboutButton.classList.add('active');
        aboutContent.classList.add('active');
      }
    }
  }

  function switchMultiInnerTab(button, tabType, productIndex) {
    const productContent = button.closest('.product-tab-content');

    // Remove active class from all inner tab buttons and content within this product
    productContent.querySelectorAll('.inner-tab-nav-button').forEach((btn) => btn.classList.remove('active'));
    productContent.querySelectorAll('.inner-tab-content').forEach((content) => content.classList.remove('active'));

    // Add active class to clicked button and corresponding content
    button.classList.add('active');
    productContent.querySelector(`.inner-tab-content[data-inner-tab="${tabType}"]`).classList.add('active');
  }

  function toggleFAQ(button) {
    const faqItem = button.closest('.faq-item');
    const faqList = button.closest('.faq-list');
    const answer = faqItem.querySelector('.faq-answer');
    const isActive = button.classList.contains('active');

    // Close all other FAQs in the same list
    faqList.querySelectorAll('.faq-question').forEach((q) => {
      q.classList.remove('active');
      q.closest('.faq-item').querySelector('.faq-answer').classList.remove('active');
    });

    // Toggle current FAQ
    if (!isActive) {
      button.classList.add('active');
      answer.classList.add('active');
    }
  }

  function scrollIngredients(button, direction) {
    const ingredientsSection = button.closest('.ingredients-section');
    const scrollContainer = ingredientsSection.querySelector('.ingredients-list-container');

    if (!scrollContainer) return;

    const scrollAmount = 120;
    const currentScrollTop = scrollContainer.scrollTop;

    if (direction === 'up') {
      scrollContainer.scrollTo({
        top: Math.max(0, currentScrollTop - scrollAmount),
        behavior: 'smooth',
      });
    } else if (direction === 'down') {
      scrollContainer.scrollTo({
        top: currentScrollTop + scrollAmount,
        behavior: 'smooth',
      });
    }
  }

  function scrollFAQs(button, direction) {
    const faqSection = button.closest('.faq-section');
    const scrollContainer = faqSection.querySelector('.faq-list-container');

    if (!scrollContainer) return;

    const scrollAmount = 100;
    const currentScrollTop = scrollContainer.scrollTop;

    if (direction === 'up') {
      scrollContainer.scrollTo({
        top: Math.max(0, currentScrollTop - scrollAmount),
        behavior: 'smooth',
      });
    } else if (direction === 'down') {
      scrollContainer.scrollTo({
        top: currentScrollTop + scrollAmount,
        behavior: 'smooth',
      });
    }
  }

  // Force refresh for live theme editor updates
  if (window.Shopify && window.Shopify.designMode) {
    document.addEventListener('shopify:section:load', function (event) {
      // Re-initialize dropdown functionality
      const dropdownButtons = event.target.querySelectorAll('.tab-button');
      dropdownButtons.forEach((button) => {
        button.addEventListener('click', function () {
          toggleMultiTabContent(this);
        });
      });

      // Re-initialize product tab functionality
      const productTabButtons = event.target.querySelectorAll('.product-tab-nav-button');
      productTabButtons.forEach((button, index) => {
        button.addEventListener('click', function () {
          switchProductTab(this, index);
        });
      });

      // Re-initialize inner tab functionality
      const innerTabButtons = event.target.querySelectorAll('.inner-tab-nav-button');
      innerTabButtons.forEach((button) => {
        const tabType = button.getAttribute('data-inner-tab');
        const productIndex = button.closest('.product-tab-content').getAttribute('data-product-tab');
        button.addEventListener('click', function () {
          switchMultiInnerTab(this, tabType, productIndex);
        });
      });

      // Re-initialize FAQ functionality
      const faqButtons = event.target.querySelectorAll('.faq-question');
      faqButtons.forEach((button) => {
        button.addEventListener('click', function () {
          toggleFAQ(this);
        });
      });
    });
  }
</script>

