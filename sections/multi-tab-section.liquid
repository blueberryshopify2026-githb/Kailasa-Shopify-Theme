<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Gilroy:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
  rel="stylesheet"
>

<section
  class="multi-tab-section"
  data-section-id="{{ section.id }}"
  style="
    --tab-bg-color: {{ section.settings.background_color }};
    --tab-text-color: {{ section.settings.text_color }};
    --tab-border-color: {{ section.settings.border_color }};
    --tab-border-width: {{ section.settings.border_width }}px;
    --title-font-family: {{ section.settings.title_font_family }};
    --title-font-weight: {{ section.settings.title_font_weight }};
    --title-font-style: {{ section.settings.title_font_style }};
    --title-font-size-desktop: {{ section.settings.title_font_size_desktop }}px;
    --title-font-size-mobile: {{ section.settings.title_font_size_mobile }}px;
    --tab-font-family: {{ section.settings.tab_font_family }};
    --tab-font-weight: {{ section.settings.tab_font_weight }};
    --tab-font-style: {{ section.settings.tab_font_style }};
    --tab-font-size-desktop: {{ section.settings.tab_font_size_desktop }}px;
    --tab-font-size-mobile: {{ section.settings.tab_font_size_mobile }}px;
    --tab-height-desktop: {{ section.settings.height_desktop }}px;
    --tab-height-mobile: {{ section.settings.height_mobile }}px;
    --tab-title-padding-desktop: {{ section.settings.title_padding_desktop }}px;
    --tab-title-padding-mobile: {{ section.settings.title_padding_mobile }}px;
    --tab-arrow-padding-desktop: {{ section.settings.arrow_padding_desktop }}px;
    --tab-arrow-padding-mobile: {{ section.settings.arrow_padding_mobile }}px;
    --tab-arrow-size-desktop: {{ section.settings.arrow_size_desktop }}px;
    --tab-arrow-size-mobile: {{ section.settings.arrow_size_mobile }}px;
    --tab-arrow-stroke-desktop: {{ section.settings.arrow_stroke_desktop }}px;
    --tab-arrow-stroke-mobile: {{ section.settings.arrow_stroke_mobile }}px;
    --inner-tab-active-bg: {{ section.settings.inner_tab_active_bg }};
    --inner-tab-active-text: {{ section.settings.inner_tab_active_text }};
    --inner-tab-active-dot: {{ section.settings.inner_tab_active_dot }};
    --inner-tab-inactive-bg: {{ section.settings.inner_tab_inactive_bg }};
    --inner-tab-inactive-text: {{ section.settings.inner_tab_inactive_text }};
    --inner-tab-hover-bg: {{ section.settings.inner_tab_hover_bg }};
    --inner-tab-hover-text: {{ section.settings.inner_tab_hover_text }};
    --inner-tab-border-color: {{ section.settings.inner_tab_border_color }};
    --inner-tab-border-width: {{ section.settings.inner_tab_border_width }}px;
  "
>
  <button
    class="tab-button"
    aria-expanded="false"
    data-no-focus-ring
    onclick="toggleMultiTabContent(this)"
  >
    <h2 class="tab-title">{{ section.settings.title | default: 'Multi Product Tabs' }}</h2>

    <div class="tab-arrow">
      {% if section.settings.arrow_style == 'filled' %}
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M7 10l5 5 5-5z"/>
        </svg>
      {% else %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <polyline points="6,9 12,15 18,9"></polyline>
        </svg>
      {% endif %}
    </div>
  </button>

  <div class="tab-content">
    <div class="tab-content-inner" style="display: none;">
      <!-- Product Tab Navigation (Top Level) -->
      <div class="product-tab-navigation">
        {% for block in section.blocks %}
          <button
            class="product-tab-nav-button {% if forloop.first %}active{% endif %}"
            data-product-tab="{{ forloop.index0 }}"
            onclick="switchProductTab(this, {{ forloop.index0 }})"
            {{ block.shopify_attributes }}
          >
            <div class="tab-content-wrapper">
              <span class="inner-tab-dot"></span>
              <span class="tab-text">{{ block.settings.product_name | default: 'Product' }}</span>
            </div>
          </button>
        {% endfor %}
      </div>

      <!-- Product Tab Content -->
      <div class="product-tab-content-wrapper">
        {% for block in section.blocks %}
          <div
            class="product-tab-content {% if forloop.first %}active{% endif %}"
            data-product-tab="{{ forloop.index0 }}"
          >
            <!-- Inner Tab Navigation (About, Ingredients, Usage, FAQ) -->
            <div class="inner-tab-navigation">
              <button
                class="inner-tab-nav-button active"
                data-inner-tab="about"
                onclick="switchMultiInnerTab(this, 'about', {{ forloop.index0 }})"
              >
                <div class="tab-content-wrapper">
                  <span class="inner-tab-dot"></span>
                  <span class="tab-text">About</span>
                </div>
              </button>
              <button
                class="inner-tab-nav-button"
                data-inner-tab="ingredients"
                onclick="switchMultiInnerTab(this, 'ingredients', {{ forloop.index0 }})"
              >
                <div class="tab-content-wrapper">
                  <span class="inner-tab-dot"></span>
                  <span class="tab-text">Ingredients</span>
                </div>
              </button>
              <button
                class="inner-tab-nav-button"
                data-inner-tab="usage"
                onclick="switchMultiInnerTab(this, 'usage', {{ forloop.index0 }})"
              >
                <div class="tab-content-wrapper">
                  <span class="inner-tab-dot"></span>
                  <span class="tab-text">Usage</span>
                </div>
              </button>
              <button
                class="inner-tab-nav-button"
                data-inner-tab="faq"
                onclick="switchMultiInnerTab(this, 'faq', {{ forloop.index0 }})"
              >
                <div class="tab-content-wrapper">
                  <span class="inner-tab-dot"></span>
                  <span class="tab-text">FAQ</span>
                </div>
              </button>
            </div>

            <!-- Inner Tab Content -->
            <div class="inner-tab-content-wrapper">
              <!-- About Tab Content -->
              <div class="inner-tab-content active" data-inner-tab="about">
                <div class="image-text-content {% if block.settings.about_layout == 'text-image' %}reverse{% endif %}">
                  <div class="content-image">
                    {% if block.settings.about_image %}
                      <img
                        src="{{ block.settings.about_image | image_url: width: 600, height: 600 }}"
                        alt="{{ block.settings.about_image.alt | escape }}"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    {% else %}
                      <div class="multi-tab-placeholder-image">
                        <svg width="100" height="100" viewBox="0 0 100 100" fill="none">
                          <rect width="100" height="100" fill="#f0f0f0"/>
                          <path d="M30 70L50 50L70 70M40 40H40.01" stroke="#ccc" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                      </div>
                    {% endif %}
                  </div>
                  <div class="content-text">
                    <div class="text-content">
                      {{ block.settings.about_text_content }}
                    </div>
                  </div>
                </div>
              </div>

              <!-- Ingredients Tab Content -->
              <div class="inner-tab-content" data-inner-tab="ingredients">
                <div
                  class="ingredient-block"
                  style="
                    display: flex;
                    align-items: stretch;
                    gap: 0;
                    padding: 0;
                    min-height: 400px;
                    {% if block.settings.ingredients_layout == 'image-ingredients' %}
                      flex-direction: row-reverse;
                    {% endif %}
                  "
                >
                  <!-- Ingredients Section (Left Side - 50%) -->
                  <div
                    class="ingredients-section"
                    style="
                      flex: 1;
                      width: 50%;
                      padding: 1rem;
                      background-color: {{ block.settings.ingredient_bg_color | default: '#ffffff' }};
                      overflow: hidden;
                    "
                  >
                    {% if block.settings.ingredients_title != blank %}
                      <div
                        class="ingredients-header"
                        style="
                          display: flex;
                          justify-content: space-between;
                          align-items: center;
                          margin-bottom: 0.5rem;
                        "
                      >
                        <h3
                          style="
                            font-family: {{ block.settings.font_family | default: 'Montserrat, sans-serif' }};
                            font-size: {{ block.settings.section_title_font_size | default: 14 }}px;
                            font-weight: 400;
                            color: {{ block.settings.section_title_color | default: '#999999' }};
                            margin: 0;
                            text-transform: uppercase;
                            letter-spacing: 1px;
                          "
                        >
                          {{ block.settings.ingredients_title }}
                        </h3>

                        <div
                          class="scroll-arrows"
                          style="
                            display: flex;
                            gap: 0.5rem;
                            align-items: center;
                            margin-right : 10px;
                          "
                        >
                          <button
                            class="scroll-arrow scroll-up"
                            onclick="scrollIngredients(this, 'up')"
                            style="
                              background: none;
                              border: none;
                              cursor: pointer;
                              padding: 4px;
                              color: {{ block.settings.section_title_color | default: '#999999' }};
                              font-size: 35px;
                              line-height: 1;
                              transition: opacity 0.2s ease;
                            "
                            onmouseover="this.style.opacity='0.6'"
                            onmouseout="this.style.opacity='1'"
                          >
                            &#8249;
                          </button>
                          <button
                            class="scroll-arrow scroll-down"
                            onclick="scrollIngredients(this, 'down')"
                            style="
                              background: none;
                              border: none;
                              cursor: pointer;
                              padding: 4px;
                              color: {{ block.settings.section_title_color | default: '#999999' }};
                              font-size: 35px;
                              line-height: 1;
                              transition: opacity 0.2s ease;
                            "
                            onmouseover="this.style.opacity='0.6'"
                            onmouseout="this.style.opacity='1'"
                          >
                            &#8250;
                          </button>
                        </div>
                      </div>
                    {% endif %}

                    <div
                      class="ingredients-list-container"
                      style="
                        max-height: 500px;
                        overflow-y: auto;
                        overflow-x: hidden;
                        scrollbar-width: none;
                        -ms-overflow-style: none;
                      "
                    >
                      <div
                        class="ingredients-list"
                        style="
                          display: flex;
                          flex-direction: column;
                          gap: 1.5rem;
                          padding-right: 10px;
                        "
                      >
                        {% for i in (1..10) %}
                          {% assign ingredient_image = 'ingredient_image_' | append: i %}
                          {% assign ingredient_title = 'ingredient_title_' | append: i %}
                          {% assign ingredient_description = 'ingredient_description_' | append: i %}

                          {% if block.settings[ingredient_image] != blank
                            or block.settings[ingredient_title] != blank
                          %}
                            <div
                              class="ingredient-item"
                              style="
                                display: flex;
                                align-items: center;
                                gap: 1rem;
                                padding: 10px;
                                background-color: #D3FFFF;
                                border: none;
                                width: 100%;
                              "
                            >
                              {% if block.settings[ingredient_image] != blank %}
                                <div
                                  class="multi-tab-ingredient-image"
                                  style="
                                    width: {{ block.settings.ingredient_image_size | default: 60 }}px;
                                    height: {{ block.settings.ingredient_image_size | default: 60 }}px;
                                    border-radius: 50%;
                                    overflow: hidden;
                                    flex-shrink: 0;
                                    background-color: #f8f8f8;
                                    border: none;
                                  "
                                >
                                  <img
                                    src="{{ block.settings[ingredient_image] | image_url: width: 120, height: 120 }}"
                                    alt="{{ block.settings[ingredient_title] | default: 'Ingredient' }}"
                                    width="120"
                                    height="120"
                                    style="width: 100%; height: 100%; object-fit: cover;"
                                  >
                                </div>
                              {% endif %}

                              <div
                                class="ingredient-content"
                                style="
                                  flex: 1;
                                  min-width: 0;
                                  max-width: calc(100% - 70px);
                                "
                              >
                                {% if block.settings[ingredient_title] != blank %}
                                  <h4
                                    style="
                                      font-family: {{ block.settings.font_family | default: 'Montserrat, sans-serif' }};
                                      font-size: {{ block.settings.ingredient_title_font_size | default: 16 }}px;
                                      font-weight: 600;
                                      color: {{ block.settings.ingredient_title_color | default: '#333333' }};
                                      margin: 0 0 0.5rem 0;
                                      line-height: 1.3;
                                      word-wrap: break-word;
                                      overflow-wrap: break-word;
                                    "
                                  >
                                    {{ block.settings[ingredient_title] }}
                                  </h4>
                                {% endif %}

                                {% if block.settings[ingredient_description] != blank %}
                                  <p
                                    style="
                                      font-family: {{ block.settings.font_family | default: 'Montserrat, sans-serif' }};
                                      font-size: {{ block.settings.ingredient_desc_font_size | default: 13 }}px;
                                      font-weight: 400;
                                      color: {{ block.settings.ingredient_desc_color | default: '#888888' }};
                                      margin: 0;
                                      line-height: 1.5;
                                      word-wrap: break-word;
                                      overflow-wrap: break-word;
                                      hyphens: auto;
                                      white-space: normal;
                                    "
                                  >
                                    {{ block.settings[ingredient_description] }}
                                  </p>
                                {% endif %}
                              </div>
                            </div>
                          {% endif %}
                        {% endfor %}
                      </div>
                    </div>
                  </div>

                  <!-- Main Image Section -->
                  <div class="main-image-section" style="flex: 1; padding: 1rem;">
                    {% if block.settings.ingredients_main_image != blank %}
                      <img
                        src="{{ block.settings.ingredients_main_image | image_url: width: 600, height: 600 }}"
                        alt="{{ block.settings.ingredients_main_image_alt | default: 'Product ingredients' }}"
                        width="600"
                        height="600"
                        style="width: 100%; height: auto; display: block;"
                      >
                    {% endif %}
                  </div>
                </div>
              </div>

              <!-- Usage Tab Content -->
              <div class="inner-tab-content" data-inner-tab="usage">
                <div class="image-text-content {% if block.settings.usage_layout == 'text-image' %}reverse{% endif %}">
                  <div class="content-image">
                    {% if block.settings.usage_image %}
                      <img
                        src="{{ block.settings.usage_image | image_url: width: 600, height: 600 }}"
                        alt="{{ block.settings.usage_image.alt | escape }}"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    {% else %}
                      <div class="multi-tab-placeholder-image">
                        <svg width="100" height="100" viewBox="0 0 100 100" fill="none">
                          <rect width="100" height="100" fill="#f0f0f0"/>
                          <path d="M30 70L50 50L70 70M40 40H40.01" stroke="#ccc" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                      </div>
                    {% endif %}
                  </div>
                  <div class="content-text">
                    <div class="text-content">
                      {{ block.settings.usage_text_content }}
                    </div>
                  </div>
                </div>
              </div>

              <!-- FAQ Tab Content -->
              <div class="inner-tab-content" data-inner-tab="faq">
                <div
                  class="faq-content {% if block.settings.faq_layout == 'faq-image' %}reverse{% endif %}"
                  style="
                    --faq-bg-color: {{ block.settings.faq_bg_color }};
                    --question-text-color: {{ block.settings.question_text_color }};
                    --answer-text-color: {{ block.settings.answer_text_color }};
                    --faq-border-color: {{ block.settings.faq_border_color }};
                    --faq-max-height: {{ block.settings.faq_max_height }}px;
                  "
                >
                  <div class="faq-image">
                    {% if block.settings.faq_image %}
                      <img
                        src="{{ block.settings.faq_image | image_url: width: 600, height: 600 }}"
                        alt="{{ block.settings.faq_image.alt | escape }}"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    {% else %}
                      <div class="multi-tab-placeholder-image">
                        <svg width="100" height="100" viewBox="0 0 100 100" fill="none">
                          <rect width="100" height="100" fill="#f0f0f0"/>
                          <path d="M30 70L50 50L70 70M40 40H40.01" stroke="#ccc" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                      </div>
                    {% endif %}
                  </div>
                  <div class="faq-section">
                    <div
                      class="faq-header"
                      style="
                        align-items: left;
                        margin-bottom: 0.5rem;
                        padding: 10px 30px;
                        
                      "
                    >
                      <div
                        class="faq-scroll-arrows"
                        style="
                          display: flex;
                          gap: 0.5rem;
                          align-items: center;
                        "
                      >
                        <button
                          class="faq-scroll-arrow faq-scroll-up"
                          onclick="scrollFAQs(this, 'up')"
                          style="
                            background: none;
                            border: none;
                            cursor: pointer;
                            padding: 4px;
                            color: #999999;
                            font-size: 35px;
                            line-height: 1;
                            transition: opacity 0.2s ease;
                          "
                          onmouseover="this.style.opacity='0.6'"
                          onmouseout="this.style.opacity='1'"
                        >
                          &#8249;
                        </button>
                        <button
                          class="faq-scroll-arrow faq-scroll-down"
                          onclick="scrollFAQs(this, 'down')"
                          style="
                            background: none;
                            border: none;
                            cursor: pointer;
                            padding: 4px;
                            color: #999999;
                            font-size: 35px;
                            line-height: 1;
                            transition: opacity 0.2s ease;
                          "
                          onmouseover="this.style.opacity='0.6'"
                          onmouseout="this.style.opacity='1'"
                        >
                          &#8250;
                        </button>
                      </div>
                    </div>

                    <div
                      class="faq-list-container"
                      style="
                        max-height: 550px;
                        overflow-y: auto;
                        overflow-x: hidden;
                        scrollbar-width: none;
                        -ms-overflow-style: none;
                        
                      "
                    >
                      <div
                        class="faq-list"
                        data-block-id="{{ block.id }}"
                        style="padding-right: 30px;"
                      >
                        {% for i in (1..10) %}
                          {% assign faq_question = 'faq' | append: i | append: '_question' %}
                          {% assign faq_answer = 'faq' | append: i | append: '_answer' %}

                          {% if block.settings[faq_question] != blank %}
                            <div class="faq-item">
                              <button class="faq-question" onclick="toggleFAQ(this)">
                                <span class="question-text">{{ block.settings[faq_question] }}</span>
                                <span class="faq-icon">+</span>
                              </button>
                              <div class="faq-answer">
                                <div class="answer-content">
                                  {{ block.settings[faq_answer] }}
                                </div>
                              </div>
                            </div>
                          {% endif %}
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  /* Main Dropdown Section */
  .multi-tab-section {
    width: 100%;
    max-width: 100%;
    border: var(--tab-border-width) solid var(--tab-border-color);
    background-color: var(--tab-bg-color);
    margin-top: 20px;
  }

  .tab-button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: transparent;
    color: var(--tab-text-color);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: var(--tab-font-family);
    font-weight: var(--tab-font-weight);
    font-style: var(--tab-font-style);
    height: var(--tab-height-desktop);
  }

  .tab-button:hover {
    opacity: 0.8;
  }

  .tab-button:focus {
    outline: none;
  }

  .tab-title {
    margin: 0;
    padding-left: var(--tab-title-padding-desktop);
    font-size: var(--title-font-size-desktop);
    font-family: var(--title-font-family);
    font-weight: var(--title-font-weight);
    font-style: var(--title-font-style);
    color: inherit;
    text-align: left;
  }

  .tab-arrow {
    padding-right: var(--tab-arrow-padding-desktop);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .tab-arrow svg {
    width: var(--tab-arrow-size-desktop);
    height: var(--tab-arrow-size-desktop);
    stroke-width: var(--tab-arrow-stroke-desktop);
  }

  .tab-button[aria-expanded='true'] .tab-arrow {
    transform: rotate(180deg);
  }

  .tab-content {
    background-color: transparent;
    border: none;
  }

  .tab-content-inner {
    color: var(--tab-text-color);
  }

  /* Product Tab Navigation (Top Level) */
  .product-tab-navigation {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 20px 0 0 0;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 10px;
  }

  .product-tab-nav-button {
    flex: 1;
    min-width: 100px;
    max-width: 150px;
    min-height: 44px;
    padding: 8px 12px;
    border: var(--inner-tab-border-width) solid var(--inner-tab-border-color);
    border-radius: 8px;
    background-color: var(--inner-tab-inactive-bg);
    color: var(--inner-tab-inactive-text);
    font-family: var(--tab-font-family);
    font-weight: var(--tab-font-weight);
    font-style: var(--tab-font-style);
    font-size: var(--tab-font-size-desktop);
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    gap: 8px;
  }

  .product-tab-nav-button .tab-content-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
  }

  .product-tab-nav-button .tab-text {
    word-wrap: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
    line-height: 1.2;
    white-space: normal;
  }

  .product-tab-nav-button:hover {
    background-color: var(--inner-tab-hover-bg);
    color: var(--inner-tab-hover-text);
  }

  .product-tab-nav-button.active {
    background-color: var(--inner-tab-active-bg);
    color: var(--inner-tab-active-text);
  }

  .product-tab-nav-button:focus {
    outline: none;
  }

  .product-tab-nav-button .inner-tab-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: transparent;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .product-tab-nav-button.active .inner-tab-dot {
    background-color: var(--inner-tab-active-dot);
  }

  /* Inner Tab System (About, Ingredients, Usage, FAQ) */
  .inner-tab-navigation {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 10px 0 0 0;
    gap: 8px;
    padding: 0 10px;
    border: none;
  }

  .inner-tab-nav-button {
    flex: 1;
    max-width: 25%;
    min-height: 44px;
    padding: 8px 12px;
    border: var(--inner-tab-border-width) solid var(--inner-tab-border-color);
    border-radius: 8px;
    background-color: var(--inner-tab-inactive-bg);
    color: var(--inner-tab-inactive-text);
