{% comment %}
  Product Page Ingredients Section - Dynamic tiles with conveyor belt animation
  Features: Background image with content on left (70%), moving tiles on right (30%)
{% endcomment %}


<style>
  .ppis {
    position: relative;
    width: 100%;
    min-height: 100vh;
    overflow: hidden;
    font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    display: flex;
    align-items: center;
    background: #000000;
  }


  /* Main container with 70/30 split */
  .ppis__container {
    width: 100%;
    height: 100vh;
    display: grid;
    grid-template-columns: 70% 30%;
    position: relative;
  }


  /* Left side - Background image with content — rounded card matching right side */
  .ppis__content-section {
    position: relative;
    background-color: #000000;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    padding: 40px;
    overflow: hidden;
    border-radius: {{ section.settings.card_border_radius | default: 20 }}px;
    margin: 20px 10px 20px 20px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
  }


  .ppis__content-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.1) 100%);
    z-index: 1;
  }


  .ppis__content-wrapper {
    position: relative;
    z-index: 2;
    max-width: 600px;
    color: white;
  }


  .ppis__heading {
    font-size: {{ section.settings.heading_size | default: 48 }}px;
    font-weight: 800;
    color: {{ section.settings.heading_color | default: '#ffffff' }};
    line-height: 1.1;
    margin: 0 0 30px 0;
    letter-spacing: -0.02em;
    font-family: 'Montserrat', sans-serif;
  }


  .ppis__description {
    font-size: {{ section.settings.description_size | default: 18 }}px;
    line-height: 1.6;
    color: {{ section.settings.description_color | default: '#ffffff' }};
    font-weight: 500;
    font-family: 'Montserrat', sans-serif;
    opacity: 0.95;
  }


  .ppis__description p {
    margin: 0 0 20px 0;
  }


  /* Right side - Dynamic tiles conveyor belt */
  .ppis__tiles-section {
    position: relative;
    background: #000000;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }


  .ppis__tiles-container {
    position: relative;
    width: calc(100% - 40px);
    height: calc(100% - 40px);
    background: #ffffff;
    border-radius: {{ section.settings.card_border_radius | default: 20 }}px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
    margin: 20px 20px 20px 10px;
  }

  .ppis__tiles-container::before,
  .ppis__tiles-container::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 20px;
    background: #ffffff;
    z-index: 10;
    pointer-events: none;
  }

  .ppis__tiles-container::before {
    top: 0;
    border-radius: 20px 20px 0 0;
  }

  .ppis__tiles-container::after {
    bottom: 0;
    border-radius: 0 0 20px 20px;
  }


  .ppis__tiles-track {
    position: absolute;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    top: 0;
    left: 0;
    padding: 0 20px;
    will-change: transform;
  }

  .ppis__tile {
    border-radius: 18px;
    min-height: 280px;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 2px solid transparent;
    background: #ffffff;
  }


  .ppis__tile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 18px;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }


  .ppis__tile-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    z-index: 2;
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
    border-radius: 18px;
  }


  .ppis__tile:hover {
    border-color: #4fffff;
    box-shadow: 0 8px 32px rgba(79, 255, 255, 0.3);
  }


  .ppis__tile:hover .ppis__tile-overlay {
    opacity: 1;
  }


  .ppis__tile-title {
    font-size: 16px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 8px 0;
    font-family: 'Montserrat', sans-serif;
    line-height: 1.3;
  }


  .ppis__tile-description {
    font-size: 14px;
    color: #cccccc;
    font-weight: 500;
    line-height: 1.4;
    margin: 0;
    font-family: 'Montserrat', sans-serif;
  }


  /* Remove pause animation on hover - handled by JavaScript */


  /* Mobile responsive */
  @media (max-width: 1024px) {
    .ppis__container {
      grid-template-columns: 1fr;
      grid-template-rows: 60% 40%;
      height: auto;
      min-height: 100vh;
    }


    .ppis__content-section {
      padding: 40px 20px;
    }


    .ppis__heading {
      font-size: calc({{ section.settings.heading_size | default: 48 }}px * 0.7);
    }


    .ppis__description {
      font-size: calc({{ section.settings.description_size | default: 18 }}px * 0.9);
    }


    .ppis__tiles-section {
      height: 40vh;
      padding: 0;
    }

    .ppis__tiles-container {
      width: calc(100% - 30px);
      height: calc(100% - 30px);
      border-radius: 15px;
      margin: 15px;
    }

    .ppis__tiles-container::before,
    .ppis__tiles-container::after {
      height: 20px;
    }

    .ppis__tiles-container::before {
      border-radius: 15px 15px 0 0;
    }

    .ppis__tiles-container::after {
      border-radius: 0 0 15px 15px;
    }


    .ppis__tiles-track {
      flex-direction: row;
      top: 0;
      height: 200%;
      padding: 0 15px;
    }


    .ppis__tile {
      min-width: 200px;
      min-height: 200px;
      flex-shrink: 0;
    }


    .ppis__tile-overlay {
      padding: 15px;
    }
  }


  @media (max-width: 768px) {
    .ppis__content-section {
      padding: 30px 15px;
    }


    .ppis__heading {
      font-size: calc({{ section.settings.heading_size | default: 48 }}px * 0.5);
      margin-bottom: 20px;
    }


    .ppis__description {
      font-size: calc({{ section.settings.description_size | default: 18 }}px * 0.8);
    }


    .ppis__tile {
      min-width: 180px;
      min-height: 180px;
      padding: 15px;
    }


    .ppis__tile-overlay {
      padding: 10px;
    }


    .ppis__tile-image {
      border-radius: 13px;
    }


    .ppis__tile-overlay {
      border-radius: 13px;
    }


    .ppis__tile-title {
      font-size: 14px;
    }


    .ppis__tile-description {
      font-size: 12px;
    }
  }

  /* ── TABLET ONLY: 481px – 1024px ───────────────────────────────
     Desktop and mobile code NOT changed.
     Uses existing ppis__ prefix for all classes.
     Tiles remain horizontal conveyor belt, same JS functionality.
  ─────────────────────────────────────────────────────────────── */
  @media (min-width: 481px) and (max-width: 1024px) {

    /* Section: auto height, black background */
    .ppis {
      min-height: unset !important;
    }

    /* Stack: content card top, tiles card below — equal 16px outer padding */
    .ppis__container {
      display: flex !important;
      flex-direction: column !important;
      height: auto !important;
      min-height: unset !important;
      padding: 16px !important;
      gap: 16px !important;
      box-sizing: border-box !important;
      background: #000000 !important;
    }

    /* ── Left: content card — center-aligned text ── */
    .ppis__content-section {
      width: 100% !important;
      margin: 0 !important;
      padding: {{ section.settings.tab_content_padding | default: 40 }}px !important;
      border-radius: {{ section.settings.card_border_radius | default: 20 }}px !important;
      min-height: {{ section.settings.tab_content_height | default: 400 }}px !important;
      box-sizing: border-box !important;
      text-align: center !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    .ppis__content-wrapper {
      text-align: center !important;
      max-width: 680px !important;
      margin: 0 auto !important;
    }

    .ppis__heading {
      font-size: {{ section.settings.tab_heading_size | default: 36 }}px !important;
      margin-bottom: 20px !important;
      text-align: center !important;
    }

    .ppis__description {
      font-size: {{ section.settings.tab_description_size | default: 17 }}px !important;
      text-align: center !important;
    }

    /* ── Right: tiles card — horizontal conveyor, square tiles ── */
    .ppis__tiles-section {
      width: 100% !important;
      height: {{ section.settings.tab_tile_size | default: 220 | plus: 32 }}px !important;
      margin: 0 !important;
      padding: 0 !important;
      flex-shrink: 0 !important;
    }

    .ppis__tiles-container {
      width: 100% !important;
      height: 100% !important;
      margin: 0 !important;
      border-radius: {{ section.settings.card_border_radius | default: 20 }}px !important;
      padding: 0 !important;
      box-sizing: border-box !important;
    }

    /* Track: horizontal, JS translateX still works with left:0 */
    .ppis__tiles-track {
      flex-direction: row !important;
      height: calc(100% - 32px) !important;
      width: auto !important;
      top: 16px !important;
      left: 0 !important;
      padding: 0 16px !important;
      gap: 16px !important;
      align-items: center !important;
    }

    /* Square tiles with curved corners */
    .ppis__tile {
      flex: 0 0 {{ section.settings.tab_tile_size | default: 220 }}px !important;
      width: {{ section.settings.tab_tile_size | default: 220 }}px !important;
      min-width: {{ section.settings.tab_tile_size | default: 220 }}px !important;
      max-width: {{ section.settings.tab_tile_size | default: 220 }}px !important;
      height: {{ section.settings.tab_tile_size | default: 220 }}px !important;
      min-height: {{ section.settings.tab_tile_size | default: 220 }}px !important;
      max-height: {{ section.settings.tab_tile_size | default: 220 }}px !important;
      border-radius: {{ section.settings.card_border_radius | default: 20 }}px !important;
      overflow: hidden !important;
    }

    .ppis__tile-image {
      border-radius: {{ section.settings.card_border_radius | default: 20 }}px !important;
    }

    .ppis__tile-overlay {
      border-radius: {{ section.settings.card_border_radius | default: 20 }}px !important;
      padding: 14px !important;
    }

    .ppis__tile-title {
      font-size: {{ section.settings.tab_tile_title_size | default: 14 }}px !important;
      margin-bottom: 8px !important;
    }

    .ppis__tile-description {
      font-size: {{ section.settings.tab_tile_desc_size | default: 12 }}px !important;
    }

    /* Left/right white masks — same as mobile */
    .ppis__tiles-container::before,
    .ppis__tiles-container::after {
      display: block !important;
      content: '' !important;
      position: absolute !important;
      top: 0 !important;
      bottom: 0 !important;
      width: 16px !important;
      height: 100% !important;
      background: #ffffff !important;
      z-index: 20 !important;
      pointer-events: none !important;
      border-radius: 0 !important;
    }
    .ppis__tiles-container::before {
      left: 0 !important;
      right: unset !important;
    }
    .ppis__tiles-container::after {
      right: 0 !important;
      left: unset !important;
      bottom: unset !important;
    }
  }
  /* ── END TABLET ─────────────────────────────────────────────── */

  /* ── MOBILE ONLY: max-width 480px ──────────────────────────────
     Desktop code above is NOT changed.
     All new classes use the existing ppis__ prefix.
     The conveyor belt animation/JS is preserved — only sizes and spacing adjusted.
  ─────────────────────────────────────────────────────────────── */
  @media (max-width: 480px) {

    /* Remove excess black space — section fills content height */
    .ppis {
      min-height: unset !important;
    }

    /* Stack: content card on top, tiles card below */
    .ppis__container {
      display: flex !important;
      flex-direction: column !important;
      height: auto !important;
      min-height: unset !important;
      padding: 16px !important;
      gap: 12px !important;
      box-sizing: border-box !important;
      background: #000000 !important;
    }

    /* ── Left: content card ── */
    .ppis__content-section {
      width: 100% !important;
      margin: 0 !important;
      padding: {{ section.settings.mob_content_padding | default: 24 }}px {{ section.settings.mob_content_padding | default: 20 }}px !important;
      border-radius: {{ section.settings.card_border_radius | default: 20 }}px !important;
      min-height: {{ section.settings.mob_content_height | default: 480 }}px !important;
      box-sizing: border-box !important;
      text-align: center !important;
      background-image: var(--mob-bg, none) !important;
    }

    /* Hide overlay if no mobile background */
    .ppis__content-section:not([style*="--mob-bg: url"]) .ppis__content-overlay {
      display: none !important;
    }

    .ppis__content-wrapper {
      text-align: center !important;
    }

    .ppis__heading {
      font-size: {{ section.settings.mob_heading_size | default: 26 }}px !important;
      margin-bottom: 16px !important;
    }

    .ppis__description {
      font-size: {{ section.settings.mob_description_size | default: 15 }}px !important;
    }

    /* ── Right: tiles card — fixed height so conveyor belt has room ── */
    .ppis__tiles-section {
      width: 100% !important;
      height: {{ section.settings.mob_tile_size | default: 130 | plus: 32 }}px !important;
      margin: 0 !important;
      padding: 0 !important;
      flex-shrink: 0 !important;
    }

    .ppis__tiles-container {
      width: 100% !important;
      height: 100% !important;
      margin: 0 !important;
      border-radius: {{ section.settings.card_border_radius | default: 20 }}px !important;
      padding: 0 !important;
      box-sizing: border-box !important;
    }

    /* Track stays position:absolute for JS conveyor — only change direction to horizontal */
    .ppis__tiles-track {
      flex-direction: row !important;
      height: calc(100% - 32px) !important;
      width: auto !important;
      top: 16px !important;
      left: 0 !important;
      padding: 0 16px !important;
      gap: 12px !important;
      align-items: center !important;
    }

    /* Tiles: square, fixed size */
    .ppis__tile {
      flex: 0 0 {{ section.settings.mob_tile_size | default: 130 }}px !important;
      width: {{ section.settings.mob_tile_size | default: 130 }}px !important;
      min-width: {{ section.settings.mob_tile_size | default: 130 }}px !important;
      max-width: {{ section.settings.mob_tile_size | default: 130 }}px !important;
      height: {{ section.settings.mob_tile_size | default: 130 }}px !important;
      min-height: {{ section.settings.mob_tile_size | default: 130 }}px !important;
      max-height: {{ section.settings.mob_tile_size | default: 130 }}px !important;
      border-radius: {{ section.settings.card_border_radius | default: 20 }}px !important;
      overflow: hidden !important;
    }

    .ppis__tile-image {
      border-radius: {{ section.settings.card_border_radius | default: 20 }}px !important;
    }

    .ppis__tile-overlay {
      border-radius: {{ section.settings.card_border_radius | default: 20 }}px !important;
      padding: 8px !important;
    }

    .ppis__tile-title {
      font-size: {{ section.settings.mob_tile_title_size | default: 11 }}px !important;
      margin-bottom: 4px !important;
    }

    .ppis__tile-description {
      font-size: {{ section.settings.mob_tile_desc_size | default: 9 }}px !important;
    }

    /* Left/right white padding strips — fixed position, always visible regardless of JS transform */
    .ppis__tiles-container::before,
    .ppis__tiles-container::after {
      display: block !important;
      content: '' !important;
      position: absolute !important;
      top: 0 !important;
      bottom: 0 !important;
      width: 16px !important;
      height: 100% !important;
      background: #ffffff !important;
      z-index: 20 !important;
      pointer-events: none !important;
    }
    .ppis__tiles-container::before {
      left: 0 !important;
      right: unset !important;
      border-radius: {{ section.settings.card_border_radius | default: 20 }}px 0 0 {{ section.settings.card_border_radius | default: 20 }}px !important;
    }
    .ppis__tiles-container::after {
      right: 0 !important;
      left: unset !important;
      border-radius: 0 {{ section.settings.card_border_radius | default: 20 }}px {{ section.settings.card_border_radius | default: 20 }}px 0 !important;
    }
  }
</style>


<section class="ppis full-width" id="ppis-{{ section.id }}">
  {% if section.blocks.size == 0 %}
    <div style="padding: 60px 20px; text-align: center; color: #000000;">
      <h2>Product Page Ingredients Section</h2>
      <p>Add ingredient blocks to get started. Click "Add block" below to create your first ingredient tile.</p>
    </div>
  {% else %}
    <div class="ppis__container">
      <!-- Left side - Content with background -->
      <div
        class="ppis__content-section"
        {% if section.settings.mob_background_image %}
          style="background-image: url('{{ section.settings.background_image | image_url: width: 1200 }}'); --mob-bg: url('{{ section.settings.mob_background_image | image_url: width: 800 }}');"
        {% elsif section.settings.background_image %}
          style="background-image: url('{{ section.settings.background_image | image_url: width: 1200 }}'); --mob-bg: none;"
        {% endif %}
      >
        <div class="ppis__content-overlay"></div>
        <div class="ppis__content-wrapper">
          {% if section.settings.heading != blank %}
            <h2 class="ppis__heading">{{ section.settings.heading }}</h2>
          {% endif %}


          {% if section.settings.description != blank %}
            <div class="ppis__description">{{ section.settings.description }}</div>
          {% endif %}
        </div>
      </div>


      <!-- Right side - Dynamic tiles conveyor belt -->
      <div class="ppis__tiles-section">
        <div class="ppis__tiles-container">
          <div class="ppis__tiles-track" id="ppis-tiles-track-{{ section.id }}">
            <!-- Tiles will be dynamically generated by JavaScript for seamless infinite scroll -->
          </div>
        </div>
      </div>
    </div>
  {% endif %}
</section>


<script>
document.addEventListener('DOMContentLoaded', function() {
  const sectionId = '{{ section.id }}';
  const tilesTrack = document.getElementById(`ppis-tiles-track-${sectionId}`);
  
  if (!tilesTrack) return;

  // Tile data from Liquid
  const tileData = [
    {% for block in section.blocks %}
    {
      image: {% if block.settings.tile_image %}'{{ block.settings.tile_image | image_url: width: 300 }}'{% else %}null{% endif %},
      title: {{ block.settings.tile_title | json }},
      titleColor: {{ block.settings.tile_title_color | default: '#ffffff' | json }},
      titleSize: {{ block.settings.tile_title_size | default: 16 }},
      description: {{ block.settings.tile_description | json }},
      descColor: {{ block.settings.tile_desc_color | default: '#cccccc' | json }},
      descSize: {{ block.settings.tile_desc_size | default: 14 }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];

  if (tileData.length === 0) return;

  // Animation settings
  const animationSpeed = {{ section.settings.animation_speed | default: 6000 }};
  const tileHeight = 300; // tile height + gap
  const tileWidth = 220; // mobile tile width + gap
  
  let currentPosition = 0;
  let animationId;
  let isAnimating = false;
  let isMobile = window.innerWidth <= 1024;

  // Create tile HTML
  function createTileHTML(data) {
    return `
      <div class="ppis__tile">
        ${data.image ? `
          <img
            src="${data.image}"
            alt="${data.title || 'Ingredient'}"
            class="ppis__tile-image"
            width="300"
            height="280"
          >
        ` : ''}
        <div class="ppis__tile-overlay">
          ${data.title ? `<h3 class="ppis__tile-title" style="color:${data.titleColor};font-size:${data.titleSize}px">${data.title}</h3>` : ''}
          ${data.description ? `<p class="ppis__tile-description" style="color:${data.descColor};font-size:${data.descSize}px">${data.description}</p>` : ''}
        </div>
      </div>
    `;
  }

  // Initialize tiles for infinite scroll
  function initializeTiles() {
    const container = tilesTrack.parentElement;
    const containerSize = isMobile ? container.offsetWidth : container.offsetHeight;
    const tileSize = isMobile ? tileWidth : tileHeight;
    
    // Calculate how many tiles we need to fill 3x the container size for seamless scrolling
    const tilesNeeded = Math.ceil((containerSize * 3) / tileSize);
    const totalTiles = Math.max(tilesNeeded, tileData.length * 3);
    
    // Clear and rebuild tiles
    tilesTrack.innerHTML = '';
    
    for (let i = 0; i < totalTiles; i++) {
      const dataIndex = i % tileData.length;
      tilesTrack.innerHTML += createTileHTML(tileData[dataIndex]);
    }
    
    // Set initial position
    currentPosition = 0;
    tilesTrack.style.transform = isMobile ? 'translateX(0px)' : 'translateY(0px)';
  }

  // Smooth infinite scroll animation
  function animate() {
    if (!isAnimating) return;
    
    const speed = (isMobile ? tileWidth : tileHeight) / (animationSpeed / 16.67); // 60fps
    currentPosition -= speed;
    
    // Calculate when to reset (after one full cycle of original tiles)
    const resetDistance = -(tileData.length * (isMobile ? tileWidth : tileHeight));
    
    if (currentPosition <= resetDistance) {
      currentPosition = 0; // Seamless reset to beginning
    }
    
    // Apply transform
    const transform = isMobile ? `translateX(${currentPosition}px)` : `translateY(${currentPosition}px)`;
    tilesTrack.style.transform = transform;
    
    animationId = requestAnimationFrame(animate);
  }

  // Start animation
  function startAnimation() {
    if (isAnimating) return;
    isAnimating = true;
    animate();
  }

  // Stop animation
  function stopAnimation() {
    isAnimating = false;
    if (animationId) {
      cancelAnimationFrame(animationId);
    }
  }

  // Setup hover events
  function setupHoverEvents() {
    const tiles = tilesTrack.querySelectorAll('.ppis__tile');
    tiles.forEach(tile => {
      tile.addEventListener('mouseenter', stopAnimation);
      tile.addEventListener('mouseleave', startAnimation);
    });
  }

  // Handle responsive changes
  function handleResize() {
    const newIsMobile = window.innerWidth <= 1024;
    
    if (newIsMobile !== isMobile) {
      isMobile = newIsMobile;
      stopAnimation();
      
      // Update flex direction
      tilesTrack.style.flexDirection = isMobile ? 'row' : 'column';
      
      // Reinitialize
      initializeTiles();
      setupHoverEvents();
      startAnimation();
    }
  }

  // Initialize everything
  tilesTrack.style.flexDirection = isMobile ? 'row' : 'column';
  initializeTiles();
  setupHoverEvents();
  startAnimation();

  // Handle window resize
  window.addEventListener('resize', handleResize);
});
</script>


{% schema %}
{
  "name": "Product Page Ingredients",
  "tag": "section",
  "class": "ppis-section",
  "settings": [
    {
      "type": "header",
      "content": "Card Styling"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "label": "Card Border Radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20,
      "info": "Applies to both left content card and right tiles card"
    },
    {
