{% comment %}
  Product Page Tactical Banner - Interactive product showcase with blinking dots
  Features: 40/60 layout, product image with interactive dots, hover info panels
{% endcomment %}


<style>
  .pptb {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: {{ section.settings.background_color | default: '#ffffff' }};
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 60px 0;
    overflow-x: hidden;
  }


  .pptb__background-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.3);
    z-index: 1;
  }


  .pptb__container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 40% 60%;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 2;
  }


  /* Left side - Content */
  .pptb__content {
    position: relative;
    z-index: 2;
  }


  .pptb__heading {
    font-size: {{ section.settings.heading_size | default: 48 }}px;
    font-weight: 600;
    color: {{ section.settings.heading_color | default: '#1a1a1a' }};
    line-height: 1.1;
    margin: 0 0 20px 0;
    letter-spacing: -0.02em;
    font-family: 'Montserrat', sans-serif;
  }


  .pptb__description {
    font-size: {{ section.settings.description_size | default: 18 }}px;
    line-height: 1.6;
    color: {{ section.settings.description_color | default: '#666666' }};
    font-weight: 400;
    font-family: 'Montserrat', sans-serif;
    margin: 0;
  }


  .pptb__description p {
    margin: 0 0 20px 0;
  }


  /* Right side - Product with dots */
  .pptb__product-section {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }


  .pptb__product-container {
    position: relative;
    max-width: 500px;
    width: 100%;
  }


  .pptb__product-image {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 12px;
  }


  /* Dot wrapper - sits at the dot's x/y position */
  .pptb__dot-wrapper {
    position: absolute;
    width: 20px;
    height: 20px;
    z-index: 10;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }


  /* Large invisible touch target around each dot */
  .pptb__dot-wrapper::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: transparent;
    z-index: 20;
  }


  /* Blinking dots - Loading cyan style with outline */
  .pptb__dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #4fffff;
    border: 2px solid #ffffff;
    box-shadow: 0 0 0 2px rgba(79, 255, 255, 0.3);
    cursor: pointer;
    z-index: 10;
    animation: pptb-slow-blink 3s ease-in-out infinite;
    pointer-events: auto;
    transition: all 0.3s ease;
  }


  @keyframes pptb-slow-blink {
    0%, 100% {
      opacity: 0.7;
      box-shadow: 0 0 0 2px rgba(79, 255, 255, 0.3);
    }
    50% {
      opacity: 1;
      box-shadow: 0 0 0 3px rgba(79, 255, 255, 0.5);
    }
  }


  @keyframes pptb-fast-blink {
    0%, 100% {
      opacity: 0.8;
      box-shadow: 0 0 0 3px rgba(79, 255, 255, 0.5);
    }
    50% {
      opacity: 1;
      box-shadow: 0 0 0 4px rgba(79, 255, 255, 0.7);
    }
  }


  /* Info panels - Smart positioning based on dot location */
  .pptb__info-panel {
    position: absolute;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 12px;
    padding: 20px;
    min-width: 250px;
    max-width: 300px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 15;
    pointer-events: none;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    /* vertically center panel on the dot */
    top: 50%;
  }


  /* Dot on left side — panel opens to the LEFT of the dot */
  .pptb__info-panel--left {
    right: calc(100% + 14px);
    transform: translateY(-50%) translateX(-8px);
  }


  /* Dot on right side — panel opens to the RIGHT of the dot */
  .pptb__info-panel--right {
    left: calc(100% + 14px);
    transform: translateY(-50%) translateX(8px);
  }


  /* Desktop hover — only on real pointer/mouse devices */
  @media (hover: hover) and (pointer: fine) {
    .pptb__dot-wrapper:hover .pptb__info-panel--left {
      opacity: 1;
      visibility: visible;
      transform: translateY(-50%) translateX(0);
    }


    .pptb__dot-wrapper:hover .pptb__info-panel--right {
      opacity: 1;
      visibility: visible;
      transform: translateY(-50%) translateX(0);
    }


    .pptb__dot-wrapper:hover .pptb__dot {
      animation: pptb-fast-blink 0.5s ease-in-out infinite;
      transform: scale(1.2);
      box-shadow: 0 0 0 3px rgba(79, 255, 255, 0.5), 0 0 20px rgba(79, 255, 255, 0.4);
    }
  }


  .pptb__info-title {
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 8px 0;
    font-family: 'Montserrat', sans-serif;
    line-height: 1.3;
  }


  .pptb__info-description {
    font-size: 14px;
    color: #666666;
    font-weight: 400;
    line-height: 1.4;
    margin: 0;
    font-family: 'Montserrat', sans-serif;
  }


  /* ── Touch tap-to-open panels (mobile & tablet ≤1024px) ──────────────────
     .pptb--tap-open is added by JS on tap. Desktop hover is CSS-only, untouched.
  ──────────────────────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    /* Enlarge touch target on mobile/tablet */
    .pptb__dot-wrapper::before {
      width: 64px !important;
      height: 64px !important;
    }


    .pptb__dot-wrapper.pptb--tap-open .pptb__info-panel--left {
      opacity: 1 !important;
      visibility: visible !important;
      transform: translateY(-50%) translateX(0) !important;
    }


    .pptb__dot-wrapper.pptb--tap-open .pptb__info-panel--right {
      opacity: 1 !important;
      visibility: visible !important;
      transform: translateY(-50%) translateX(0) !important;
    }
  }


  /* Mobile responsive */
  @media (max-width: 1024px) {
    .pptb__container {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }


    .pptb__heading {
      font-size: calc({{ section.settings.heading_size | default: 48 }}px * 0.8);
    }


    .pptb__description {
      font-size: calc({{ section.settings.description_size | default: 18 }}px * 0.9);
    }


    .pptb__product-container {
      max-width: 400px;
      margin: 0 auto;
    }
  }


  @media (max-width: 768px) {
    .pptb {
      padding: 40px 0;
    }


    .pptb__container {
      padding: 0 15px;
      gap: 30px;
    }


    .pptb__heading {
      font-size: calc({{ section.settings.heading_size | default: 48 }}px * 0.6);
      margin-bottom: 20px;
    }


    .pptb__description {
      font-size: calc({{ section.settings.description_size | default: 18 }}px * 0.8);
    }


    .pptb__product-container {
      max-width: 300px;
    }


    .pptb__dot {
      width: 14px;
      height: 14px;
    }


    .pptb__info-panel {
      min-width: 200px;
      max-width: 250px;
      padding: 15px;
    }


    .pptb__info-title {
      font-size: 14px;
    }


    .pptb__info-description {
      font-size: 12px;
    }
  }


  /* ── TABLET ONLY: 481px – 1024px ─────────────────────────────────────────
     Heading centered + larger, product bigger, dots + panels scaled up.
     Desktop (>1024px) and mobile (≤480px) are NOT touched.
  ──────────────────────────────────────────────────────────────────────── */
  @media (min-width: 481px) and (max-width: 1024px) {


    /* Stack layout, centered */
    .pptb__container {
      grid-template-columns: 1fr !important;
      gap: 36px !important;
      padding: 0 30px !important;
      text-align: center !important;
    }


    /* Reduce section height */
    .pptb {
      min-height: unset !important;
      padding: 40px 0 !important;
    }


    .pptb__content {
      text-align: center !important;
    }


    /* Heading: bigger and centered */
    .pptb__heading {
      font-size: {{ section.settings.tab_heading_size | default: 46 }}px !important;
      line-height: 1.15 !important;
      margin-bottom: 16px !important;
    }


    .pptb__description {
      font-size: {{ section.settings.tab_description_size | default: 22 }}px !important;
      max-width: 680px !important;
      margin: 0 auto !important;
    }


    /* Product image: much larger, centered */
    .pptb__product-section {
      display: flex !important;
      justify-content: center !important;
    }


    .pptb__product-container {
      max-width: 65vw !important;
      width: 65vw !important;
      margin: 0 auto !important;
    }


    /* Dots: larger */
    .pptb__dot {
      width: 22px !important;
      height: 22px !important;
    }


    /* Panels: larger text and padding */
    .pptb__info-panel {
      min-width: 280px !important;
      max-width: 340px !important;
      padding: 22px 24px !important;
    }


    .pptb__info-title {
      font-size: {{ section.settings.tab_panel_title_size | default: 18 }}px !important;
    }


    .pptb__info-description {
      font-size: {{ section.settings.tab_panel_desc_size | default: 15 }}px !important;
    }
  }


  /* ── MOBILE ONLY ≤480px: reference layout ─────────────────────────────
     Text centered top, image wider centered below, dots + panels unchanged.
     Desktop/tablet NOT touched. Uses pptb__ existing classes only.
  ──────────────────────────────────────────────────────────────────────── */
  @media (max-width: 480px) {


    .pptb {
      padding: 32px 0 40px !important;
      min-height: unset !important;
    }


    .pptb__container {
      grid-template-columns: 1fr !important;
      gap: 24px !important;
      padding: 0 20px !important;
    }


    /* Text: centered */
    .pptb__content {
      text-align: center !important;
    }


    .pptb__heading {
      font-size: {{ section.settings.mob_heading_size | default: 26 }}px !important;
      margin-bottom: 14px !important;
      line-height: 1.2 !important;
    }


    .pptb__description {
      font-size: {{ section.settings.mob_description_size | default: 15 }}px !important;
      line-height: 1.5 !important;
    }


    /* Image: wider, centered */
    .pptb__product-section {
      order: 2 !important;
    }


    .pptb__product-container {
      max-width: 85vw !important;
      width: 85vw !important;
      margin: 0 auto !important;
    }


    /* Dots: same size as 768px */
    .pptb__dot {
      width: 14px !important;
      height: 14px !important;
    }


    /* Info panels: smaller on mobile */
    .pptb__info-panel {
      min-width: 130px !important;
      max-width: 160px !important;
      padding: 10px 12px !important;
    }


    .pptb__info-title {
      font-size: {{ section.settings.mob_panel_title_size | default: 11 }}px !important;
      margin-bottom: 3px !important;
    }


    .pptb__info-description {
      font-size: {{ section.settings.mob_panel_desc_size | default: 10 }}px !important;
      line-height: 1.4 !important;
    }


    /* On mobile: left-side panels go LEFT, right-side panels go RIGHT — same as desktop */
    /* Panels start hidden — shown via JS tap class .pptb--tap-open only */
    .pptb__info-panel--left {
      left: auto !important;
      right: calc(100% + 8px) !important;
      transform: translateY(-50%) translateX(0) !important;
    }


    .pptb__info-panel--right {
      left: calc(100% + 8px) !important;
      right: auto !important;
      transform: translateY(-50%) translateX(0) !important;
    }
  }
</style>


<section class="pptb full-width" id="pptb-{{ section.id }}"
  {% if section.settings.background_image %}
    style="background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');"
  {% endif %}
>
  {% if section.settings.background_image %}
    <div class="pptb__background-overlay"></div>
  {% endif %}
 
  <div class="pptb__container">
    <!-- Left side - Content -->
    <div class="pptb__content">
      {% if section.settings.heading != blank %}
        <h2 class="pptb__heading">{{ section.settings.heading }}</h2>
      {% endif %}


      {% if section.settings.description != blank %}
        <div class="pptb__description">{{ section.settings.description }}</div>
      {% endif %}
    </div>


    <!-- Right side - Product with interactive dots -->
    <div class="pptb__product-section">
      <div class="pptb__product-container">
        {% if section.settings.product_image %}
          <img
            src="{{ section.settings.product_image | image_url: width: 500 }}"
            alt="{{ section.settings.heading | default: 'Product' }}"
            class="pptb__product-image"
            width="500"
            height="auto"
          >
        {% endif %}


        <!-- Interactive dots -->
        {% for block in section.blocks %}
          {% assign dot_x = block.settings.dot_position_x | default: 50 %}
          {% assign dot_y = block.settings.dot_position_y | default: 50 %}
         
          {% if dot_x >= 50 %}
            {% assign panel_side = 'right' %}
          {% else %}
            {% assign panel_side = 'left' %}
          {% endif %}


          <!-- Dot + panel wrapper: positioned at the dot location -->
          <div class="pptb__dot-wrapper" style="top: {{ dot_y }}%; left: {{ dot_x }}%;">
            <div class="pptb__dot" {{ block.shopify_attributes }}></div>
            <div class="pptb__info-panel pptb__info-panel--{{ panel_side }}">
              {% if block.settings.info_title != blank %}
                <h3 class="pptb__info-title">{{ block.settings.info_title }}</h3>
              {% endif %}
              {% if block.settings.info_description != blank %}
                <p class="pptb__info-description">{{ block.settings.info_description }}</p>
              {% endif %}
            </div>
          </div>


        {% endfor %}
      </div>
    </div>
  </div>
</section>


<script>
(function() {
  function resetPanels() {
    /* Remove any JS-applied inline styles so CSS takes full control */
    document.querySelectorAll('#pptb-{{ section.id }} .pptb__info-panel').forEach(function(panel) {
      panel.style.removeProperty('left');
      panel.style.removeProperty('right');
    });
  }
  document.addEventListener('DOMContentLoaded', resetPanels);
  window.addEventListener('resize', function() {
    resetPanels();
    /* Also close any open tap-panels when switching breakpoints */
    closeTapPanels();
  });


  /* ── Touch/click toggle for mobile & tablet only ──────────────────────────
     Desktop uses CSS :hover — untouched.
     On touch devices, tap dot to open panel, tap elsewhere to close.
  ──────────────────────────────────────────────────────────────────────────── */
  var TOUCH_MAX = 1024;


  function isTouchBreakpoint() {
    return window.innerWidth <= TOUCH_MAX;
  }


  function closeTapPanels() {
    document.querySelectorAll('#pptb-{{ section.id }} .pptb__dot-wrapper.pptb--tap-open')
      .forEach(function(w) { w.classList.remove('pptb--tap-open'); });
  }


  function handleTap(e) {
    if (!isTouchBreakpoint()) return;
    var wrapper = e.target.closest('.pptb__dot-wrapper');
    if (wrapper) {
      e.preventDefault();
      e.stopPropagation();
      var isOpen = wrapper.classList.contains('pptb--tap-open');
      closeTapPanels();
      if (!isOpen) wrapper.classList.add('pptb--tap-open');
      return;
    }
    closeTapPanels();
  }


  document.addEventListener('DOMContentLoaded', function() {
    var section = document.getElementById('pptb-{{ section.id }}');
    if (!section) return;


    /* touchend fires instantly on real devices without the 300ms click delay */
    section.addEventListener('touchend', handleTap, { passive: false });
    /* click as fallback (devtools touch simulation, stylus, etc.) */
    section.addEventListener('click', handleTap);
  });
})();
</script>


