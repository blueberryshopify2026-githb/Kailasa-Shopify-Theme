<style>
  .kailasa-product-grid {
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px;
    font-family: {{ section.settings.font_family | default: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif' }};
  }

  .kailasa-product-grid__container {
    max-width: {{ section.settings.container_width | default: 1400 }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.container_padding | default: 20 }}px;
  }

  .kailasa-product-grid__wrapper {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop | default: 2 }}, 1fr);
    gap: {{ section.settings.grid_gap | default: 20 }}px;
    align-items: stretch;
  }

  .kailasa-product-grid__item {
    position: relative;
    background: {{ section.settings.item_bg_color | default: '#f8f8f8' }};
    border-radius: {{ section.settings.border_radius | default: 16 }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
    min-height: {{ section.settings.min_height | default: 400 }}px;
    display: flex;
    flex-direction: column;
  }

  .kailasa-product-grid__item:hover {
    transform: translateY(-8px);
    box-shadow: 0 30px 60px rgba(0,0,0,0.15);
  }

  .kailasa-product-grid__image-container {
    position: relative;
    width: 100%;
    height: {{ section.settings.image_height | default: 300 }}px;
    overflow: hidden;
    background: {{ section.settings.image_placeholder_bg | default: '#e0e0e0' }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kailasa-product-grid__image {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit | default: 'cover' }};
    transition: transform 0.5s ease;
  }

  .kailasa-product-grid__item:hover .kailasa-product-grid__image {
    transform: scale(1.05);
  }.ka
  ilasa-product-grid__image-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.placeholder_text_color | default: '#999999' }};
    font-size: 16px;
    text-align: center;
    padding: 40px 20px;
  }

  .kailasa-product-grid__placeholder-icon {
    width: 48px;
    height: 48px;
    background: #cccccc;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    font-size: 20px;
    color: #666666;
  }

  .kailasa-product-grid__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.1) 100%);
    opacity: 1;
    transition: opacity 0.3s ease;
  }

  .kailasa-product-grid__item:hover .kailasa-product-grid__overlay {
    opacity: 0.7;
  }

  .kailasa-product-grid__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ section.settings.content_padding | default: 40 }}px;
    color: {{ section.settings.text_color | default: '#ffffff' }};
    z-index: 2;
  }

  .kailasa-product-grid__badge {
    position: absolute;
    top: 20px;
    left: 20px;
    background: rgba(255,255,255,0.9);
    color: #000000;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 3;
  }.kail
  asa-product-grid__trending-badge {
    position: absolute;
    top: 20px;
    right: 20px;
    background: rgba(255,255,255,0.9);
    color: #000000;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 3;
  }

  .kailasa-product-grid__title {
    font-size: {{ section.settings.title_font_size | default: 36 }}px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .kailasa-product-grid__subtitle {
    font-size: {{ section.settings.subtitle_font_size | default: 16 }}px;
    font-weight: 400;
    line-height: 1.4;
    margin-bottom: 24px;
    opacity: 0.9;
  }

  .kailasa-product-grid__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background: rgba(255,255,255,0.2);
    color: #ffffff;
    border: 2px solid #ffffff;
    border-radius: 25px;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    text-decoration: none;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .kailasa-product-grid__button:hover {
    background: #ffffff;
    color: #000000;
    transform: translateY(-2px);
  }/* Mobi
  le responsive */
  @media (max-width: 768px) {
    .kailasa-product-grid__wrapper {
      grid-template-columns: repeat({{ section.settings.columns_mobile | default: 1 }}, 1fr);
      gap: {{ section.settings.mobile_grid_gap | default: 16 }}px;
    }

    .kailasa-product-grid__item {
      min-height: {{ section.settings.mobile_min_height | default: 300 }}px;
    }

    .kailasa-product-grid__image-container {
      height: {{ section.settings.mobile_image_height | default: 200 }}px;
    }

    .kailasa-product-grid__content {
      padding: {{ section.settings.mobile_content_padding | default: 24 }}px;
    }

    .kailasa-product-grid__title {
      font-size: {{ section.settings.mobile_title_font_size | default: 24 }}px;
    }

    .kailasa-product-grid__subtitle {
      font-size: {{ section.settings.mobile_subtitle_font_size | default: 14 }}px;
    }

    .kailasa-product-grid__button {
      font-size: 12px;
      padding: 10px 20px;
    }
  }
</style>

<section class="kailasa-product-grid">
  <div class="kailasa-product-grid__container">
    <div class="kailasa-product-grid__wrapper">
      {% for block in section.blocks %}
        <div class="kailasa-product-grid__item" {{ block.shopify_attributes }}>
          <div class="kailasa-product-grid__image-container">
            {% if block.settings.image %}
              <img
                src="{{ block.settings.image | image_url: width: 800, height: 600 }}"
                alt="{{ block.settings.title | default: 'Product Image' }}"
                class="kailasa-product-grid__image"
                width="800"
                height="600"
                loading="lazy"
              >
            {% elsif block.settings.product and block.settings.product.featured_image %}
              <img
                src="{{ block.settings.product.featured_image | image_url: width: 800, height: 600 }}"
                alt="{{ block.settings.product.title | default: 'Product Image' }}"
                class="kailasa-product-grid__image"
                width="800"
                height="600"
                loading="lazy"
              >
            {% else %}
              <div class="kailasa-product-grid__image-placeholder">
                <div class="kailasa-product-grid__placeholder-icon">📷</div>
                <div>Upload Image or Select Product</div>
              </div>
            {% endif %}
            <div class="kailasa-product-grid__overlay"></div>

            {% if block.settings.badge_text %}
              <div class="kailasa-product-grid__badge">{{ block.settings.badge_text }}</div>
            {% endif %}

            {% if block.settings.trending_badge %}
              <div class="kailasa-product-grid__trending-badge">
                {{ block.settings.trending_badge_text | default: 'Now Trending' }}
              </div>
            {% endif %}

            <div class="kailasa-product-grid__content">
              <h3 class="kailasa-product-grid__title">
                {% if block.settings.product %}
                  {{ block.settings.product.title }}
                {% else %}
                  {{ block.settings.title | default: 'Product Title' }}
                {% endif %}
              </h3>

              <p class="kailasa-product-grid__subtitle">
                {% if block.settings.product and block.settings.use_product_description %}
                  {{ block.settings.product.description | strip_html | truncate: 100 }}
                {% else %}
                  {{ block.settings.subtitle | default: 'Product description goes here' }}
                {% endif %}
              </p>

              {% if block.settings.show_button %}
                {% assign button_url = block.settings.button_url %}
                {% if block.settings.product and block.settings.link_to_product %}
                  {% assign button_url = block.settings.product.url %}
                {% endif %}

                {% if button_url != blank %}
                  <a href="{{ button_url }}" class="kailasa-product-grid__button">
                    {{ block.settings.button_text | default: 'SHOP NOW' }}
                  </a>
                {% else %}
                  <span class="kailasa-product-grid__button" style="cursor: default;">
                    {{ block.settings.button_text | default: 'SHOP NOW' }}
                  </span>
                {% endif %}
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Kailasa Product Grid",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container Width",
      "min": 1000,
      "max": 1600,
      "step": 50,
      "default": 1400,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "container_padding",
      "label": "Container Padding",
      "min": 10,
      "max": 50,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid Gap",
      "min": 10,
      "max": 50,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_grid_gap",
      "label": "Mobile Grid Gap",
      "min": 10,
      "max": 30,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Item Settings"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum Height",
      "min": 300,
      "max": 600,
      "step": 25,
      "default": 400,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_min_height",
      "label": "Mobile Minimum Height",
      "min": 250,
      "max": 400,
      "step": 25,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image Height",
      "min": 200,
      "max": 500,
      "step": 25,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "label": "Mobile Image Height",
      "min": 150,
      "max": 300,
      "step": 25,
      "default": 200,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" },
        { "value": "fill", "label": "Fill" }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "item_bg_color",
      "label": "Item Background Color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "placeholder_text_color",
      "label": "Placeholder Text Color",
      "default": "#999999"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "text",
      "id": "font_family",
      "label": "Font Family",
      "default": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title Font Size",
      "min": 24,
      "max": 60,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_title_font_size",
      "label": "Mobile Title Font Size",
      "min": 18,
      "max": 36,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subtitle_font_size",
      "label": "Subtitle Font Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_subtitle_font_size",
      "label": "Mobile Subtitle Font Size",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content Padding",
      "min": 20,
      "max": 60,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_content_padding",
      "label": "Mobile Content Padding",
      "min": 15,
      "max": 40,
      "step": 5,
      "default": 25,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "product_item",
      "name": "Product Item",
      "settings": [
        {
          "type": "header",
          "content": "Content Source"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "checkbox",
          "id": "link_to_product",
          "label": "Link to Product Page",
          "default": true,
          "info": "When enabled, button links to selected product"
        },
        {
          "type": "checkbox",
          "id": "use_product_description",
          "label": "Use Product Description",
          "default": false,
          "info": "Use product description instead of custom subtitle"
        },
        {
          "type": "header",
          "content": "Custom Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image",
          "info": "Overrides product image if selected"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title",
          "info": "Overrides product title if entered"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Custom Subtitle",
          "default": "Transform Your Routine, Transform Your Skin"
        },
        {
          "type": "checkbox",
          "id": "show_button",
          "label": "Show Button",
          "default": true
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Custom Button URL",
          "info": "Leave blank to use product URL"
        },
        {
          "type": "header",
          "content": "Badges"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "placeholder": "Discover"
        },
        {
          "type": "checkbox",
          "id": "trending_badge",
          "label": "Show Trending Badge",
          "default": false
        },
        {
          "type": "text",
          "id": "trending_badge_text",
          "label": "Trending Badge Text",
          "default": "Now Trending"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kailasa Product Grid",
      "blocks": [
        {
          "type": "product_item",
          "settings": {
            "title": "Transform Your Routine, Transform Your Skin",
            "subtitle": "Advanced skincare for radiant results",
            "button_text": "SHOP NOW",
            "badge_text": "DISCOVER"
          }
        },
        {
          "type": "product_item",
          "settings": {
            "title": "Advanced Skincare for Radiant Results",
            "subtitle": "Professional-grade formulations for visible transformation",
            "button_text": "SHOP NOW",
            "badge_text": "NOW TRENDING"
          }
        }
      ]
    }
  ]
}
{% endschema %}
