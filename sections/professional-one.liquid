<script>
(function () {
  var cards   = document.querySelectorAll('.pro-one-hover-card');
  var buttons = document.querySelectorAll('.pro-one-arrow-btn');
  var activeCard = null;
  var isMobile = window.innerWidth <= 1024;
  window.addEventListener('resize', function () { isMobile = window.innerWidth <= 1024; });

  function showCard(index) {
    hideAll();
    var card = document.querySelector('.pro-one-hover-card[data-card="' + index + '"]');
    if (!card) return;
    card.classList.add('pro-one-card-visible');
    activeCard = index;
  }

  function hideAll() {
    cards.forEach(function (c) { c.classList.remove('pro-one-card-visible'); });
    activeCard = null;
  }

  // DESKTOP: hover to show/hide
  buttons.forEach(function (btn) {
    btn.addEventListener('mouseenter', function () {
      if (isMobile) return;
      showCard(parseInt(btn.getAttribute('data-target'), 10));
    });
  });

  document.querySelectorAll('.pro-one-feature-row').forEach(function (row) {
    row.addEventListener('mouseleave', function () {
      if (isMobile) return;
      hideAll();
    });
  });

  // MOBILE: click to toggle
  buttons.forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      if (!isMobile) return;
      e.stopPropagation();
      var index = parseInt(btn.getAttribute('data-target'), 10);
      if (activeCard === index) { hideAll(); } else { showCard(index); }
    });
  });

  // MOBILE: close on outside click
  document.addEventListener('click', function (e) {
    if (!isMobile || activeCard === null) return;
    var visibleCard = document.querySelector('.pro-one-hover-card.pro-one-card-visible');
    if (visibleCard && !visibleCard.contains(e.target)) hideAll();
  });

  // Add close button (✕) — mobile only
  cards.forEach(function (card) {
    if (!card.querySelector('.pro-one-card-close')) {
      var closeBtn = document.createElement('button');
      closeBtn.className = 'pro-one-card-close';
      closeBtn.setAttribute('aria-label', 'Close');
      closeBtn.innerHTML = '&#215;';
      closeBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        hideAll();
      });
      card.appendChild(closeBtn);
    }
  });
})();
</script>

