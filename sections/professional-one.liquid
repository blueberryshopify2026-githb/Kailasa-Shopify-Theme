                <path d="M12 8V16M8 12H16" stroke="#4fffff" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="pro-one-dr-card-body">
              <span class="pro-one-dr-card-label">Expert Care You Can Trust</span>
