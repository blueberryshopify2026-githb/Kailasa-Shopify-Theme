{% comment %}
  Professional One Section
  40% left content | 60% right image with frost glass doctor card
  Font: Montserrat | Colors: white, black, #4fffff
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap');

  .pro-one-section {
    font-family: 'Montserrat', sans-serif;
    background-color: {{ section.settings.section_bg }};
    color: #000;
    padding: 0;
    overflow: hidden;
    height: {{ section.settings.section_height }}vh;
    min-height: {{ section.settings.section_min_height }}px;
    max-height: {{ section.settings.section_height }}vh;
    box-sizing: border-box;
  }

  .pro-one-container {
    width: 100%;
    height: 100%;
    padding: 0;
    display: flex;
    align-items: stretch;
  }

  /* ─── LEFT SIDE ─── */
  .pro-one-left {
    flex: 0 0 {{ section.settings.left_width }}%;
    padding: {{ section.settings.left_padding_top }}px {{ section.settings.left_padding_right }}px {{ section.settings.left_padding_bottom }}px {{ section.settings.left_padding_left }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    background-color: {{ section.settings.left_bg }};
  }

  .pro-one-quote {
    font-size: {{ section.settings.quote_font_size }}px;
    font-weight: 700;
    line-height: {{ section.settings.quote_line_height }};
    color: {{ section.settings.quote_color }};
    margin: 0 0 {{ section.settings.quote_margin_bottom }}px 0;
  }

  /* Blog excerpt block */
  .pro-one-blog-block {
    margin-top: {{ section.settings.excerpt_margin_top }}px;
    margin-bottom: {{ section.settings.excerpt_margin_bottom }}px;
  }

  .pro-one-excerpt {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.65;
    color: {{ section.settings.excerpt_color }};
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0 0 6px 0;
  }

  .pro-one-read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 16px;
    font-weight: 700;
    color: #000000;
    text-decoration: underline;
    text-decoration-color: #4fffff;
    text-underline-offset: 3px;
    border-bottom: none;
    padding-bottom: 1px;
    transition: color 0.25s;
  }

  .pro-one-read-more:hover {
    color: {{ section.settings.accent_color }};
  }

  .pro-one-read-more-dots {
    font-weight: 400;
    letter-spacing: 1px;
  }

  /* ─── FEATURES ─── */
  .pro-one-features-wrap {
    position: relative;
    margin-top: {{ section.settings.features_margin_top }}px;
  }

  .pro-one-features-list {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
  }

  .pro-one-feature-row {
    display: flex;
    align-items: center;
    gap: {{ section.settings.feature_row_gap }}px;
    padding: {{ section.settings.feature_row_padding }}px 0;
    border-bottom: 1px solid {{ section.settings.divider_color }};
    cursor: default;
    position: relative;
  }

  .pro-one-feature-row:first-child {
    border-top: 1px solid {{ section.settings.divider_color }};
  }

  .pro-one-feature-thumb {
    width: {{ section.settings.thumb_size }}px;
    height: {{ section.settings.thumb_size }}px;
    border-radius: {{ section.settings.thumb_radius }}px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .pro-one-feature-thumb-placeholder {
    width: {{ section.settings.thumb_size }}px;
    height: {{ section.settings.thumb_size }}px;
    border-radius: {{ section.settings.thumb_radius }}px;
    background: #eee;
    flex-shrink: 0;
  }

  .pro-one-feature-label {
    font-size: {{ section.settings.feature_label_size }}px;
    font-weight: {{ section.settings.feature_label_weight }};
    color: {{ section.settings.feature_label_color }};
    flex: 1;
  }

  .pro-one-arrow-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.arrow_size }}px;
    font-weight: 700;
    color: {{ section.settings.arrow_color }};
    line-height: 1;
    transition: color 0.25s, transform 0.25s;
    font-family: 'Montserrat', sans-serif;
    min-width: 32px;
  }

  .pro-one-arrow-btn:hover {
    color: {{ section.settings.accent_color }};
    transform: translateX(4px);
  }

  /* Close button — hidden on desktop, shown on mobile */
  .pro-one-card-close {
    display: none;
  }

  .pro-one-feature-row:last-child .pro-one-hover-card {
    top: auto;
    bottom: 0;
  }

  /* Frost glass hover card */
  .pro-one-hover-card {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    min-height: 100%;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur({{ section.settings.card_blur }}px);
    -webkit-backdrop-filter: blur({{ section.settings.card_blur }}px);
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.accent_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: 18px 40px 18px 18px;
    box-shadow: 0 4px 20px rgba(79, 255, 255, 0.25);
    opacity: 0;
    visibility: hidden;
    z-index: 10;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    pointer-events: none;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .pro-one-hover-card.pro-one-card-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .pro-one-card-title {
    font-size: 22px;
    font-weight: 700;
    color: {{ section.settings.card_title_color }};
    margin: 0 0 12px 0;
  }

  .pro-one-card-desc {
    font-size: 16px;
    line-height: 1.65;
    color: {{ section.settings.card_desc_color }};
    margin: 0;
  }

  /* ─── RIGHT SIDE ─── */
  .pro-one-right {
    flex: 0 0 {{ 100 | minus: section.settings.left_width }}%;
    position: relative;
  }

  .pro-one-img-wrap {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  .pro-one-img-wrap--mobile {
    display: none !important;
  }

  #proDoctorCardMobile {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  #proDoctorModal {
    display: none !important;
  }

  .pro-one-img-wrap--desktop {
    display: block;
  }

  .pro-one-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pro-one-img-placeholder {
    width: 100%;
    height: 100%;
    background: #f0f0f0;
  }

  /* Doctor frost glass card */
  .pro-one-doctor-card {
    position: absolute;
    width: auto;
    max-width: 95%;
    bottom: {{ section.settings.doctor_card_bottom }}px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 2px solid #4fffff;
    border-radius: {{ section.settings.doctor_card_radius }}px;
    padding: 16px 20px;
    box-shadow: 0 8px 32px rgba(79, 255, 255, 0.35);
    display: inline-flex;
    box-sizing: border-box;
  }

  .pro-one-dr-card-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 14px;
  }

  .pro-one-dr-card-icon {
    flex-shrink: 0;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 2px solid #00bcd4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pro-one-dr-card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .pro-one-dr-card-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #00bcd4;
    text-transform: uppercase;
    white-space: nowrap;
    display: block;
    margin: 0 0 6px 0;
  }

  .pro-one-doctor-name {
    font-size: {{ section.settings.doctor_name_size }}px;
    font-weight: 700;
    color: {{ section.settings.doctor_name_color }};
    margin: 0 0 4px 0;
    white-space: nowrap;
  }

  .pro-one-doctor-specialty {
    font-size: {{ section.settings.doctor_meta_size }}px;
    font-weight: 400;
    color: {{ section.settings.doctor_meta_color }};
    margin: 0;
    white-space: nowrap;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }

  .pro-one-doctor-exp {
    font-size: {{ section.settings.doctor_meta_size }}px;
    font-weight: 400;
    color: {{ section.settings.doctor_meta_color }};
    margin: 8px 0 0 0;
    white-space: nowrap;
  }

  /* ─── RESPONSIVE ─── */

  /* ── TABLET: 768px–1024px, stacked like mobile but scaled up ── */
  @media (min-width: 768px) and (max-width: 1024px) {
    .pro-one-section {
      height: auto;
      min-height: auto;
      max-height: none;
    }

    .pro-one-container {
      flex-direction: column;
    }

    .pro-one-left {
      flex: 0 0 auto;
      flex-direction: column;
      gap: 0;
      padding: 20px;
      overflow: visible;
      align-items: center;
    }

    .pro-one-left-content {
      max-width: 100%;
      text-align: center;
      margin-bottom: 16px;
      width: 100%;
    }

    .pro-one-quote {
      font-size: 36px;
      line-height: 1.2;
      margin-bottom: 14px;
      text-align: center;
    }

    .pro-one-blog-block {
      margin-top: 10px;
      margin-bottom: 16px;
      text-align: center;
    }

    .pro-one-excerpt {
      font-size: 17px;
      font-weight: 400;
      line-height: 1.6;
      -webkit-line-clamp: 4;
      text-align: center;
    }

    .pro-one-read-more {
      font-size: 15px;
      font-weight: 700;
      justify-content: center;
      display: flex;
      border-bottom: none;
      width: 100%;
    }

    .pro-one-right {
      flex: 0 0 auto;
      width: 100%;
      display: none;
    }

    .pro-one-img-wrap--mobile {
      display: block !important;
      width: 100%;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
      height: 480px;
      min-height: 480px;
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 28px;
      position: relative;
    }

    #proDoctorCardMobile {
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }

    #proDoctorModal {
      display: none !important;
    }

    .pro-one-img-wrap--desktop {
      display: none;
    }

    .pro-one-doctor-card {
      width: auto;
      max-width: 93%;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      padding: 14px 18px;
      border-radius: 16px;
      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      display: inline-flex;
    }

    .pro-one-dr-card-row { display: flex; flex-direction: row; align-items: center; gap: 14px; }
    .pro-one-dr-card-icon { width: 44px; height: 44px; border: 2px solid #00bcd4; display: flex; align-items: center; justify-content: center; border-radius: 50%; flex-shrink: 0; }
    .pro-one-dr-card-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
    .pro-one-dr-card-label { font-size: 10px; margin: 0 0 4px 0; }
    .pro-one-doctor-name { font-size: 20px; margin: 0 0 4px 0; }
    .pro-one-doctor-specialty { font-size: 13px; margin: 0; padding-bottom: 6px; border-bottom: 1px solid rgba(0,0,0,0.1); }
    .pro-one-doctor-exp { font-size: 13px; margin: 6px 0 0 0; }

    .pro-one-features-wrap {
      width: 100%;
      max-width: 100%;
      margin: 0;
      position: relative;
      overflow: visible;
      padding-bottom: 0;
    }

    .pro-one-features-list {
      width: 100%;
      overflow: visible;
      margin-bottom: 0;
    }

    .pro-one-feature-row {
      width: 100%;
      gap: 16px;
      padding: 16px 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      overflow: visible;
    }

    .pro-one-feature-row:first-child {
      border-top: 1px solid {{ section.settings.divider_color }};
    }

    .pro-one-feature-row:last-child {
      border-bottom: 1px solid {{ section.settings.divider_color }};
    }

    .pro-one-feature-thumb {
      width: 60px;
      height: 60px;
      border-radius: 8px;
    }

    .pro-one-feature-thumb-placeholder {
      width: 60px;
      height: 60px;
      border-radius: 8px;
    }

    .pro-one-feature-label {
      font-size: 22px;
      flex: 1;
      text-align: left;
    }

    .pro-one-arrow-btn {
      font-size: 50px;
      font-weight: 700;
      padding: 6px 8px;
      flex-shrink: 0;
      display: block;
      min-width: 36px;
    }

    .pro-one-hover-card {
      padding: 22px 44px 22px 22px;
      background: rgba(255, 255, 255, 0.95) !important;
    }

    .pro-one-card-title {
      font-size: 26px;
      color: #000000;
      margin: 0 0 12px 0;
      text-align: center;
      font-weight: 700;
    }

    .pro-one-card-desc {
      font-size: 20px;
      color: #333333;
      text-align: center;
      line-height: 1.65;
    }

    .pro-one-card-close {
      display: flex;
      position: absolute;
      top: 10px;
      right: 12px;
      font-size: 18px;
      width: 24px;
      height: 24px;
    }
  }

  /* ── MOBILE only: 320px–767px ── */
  @media (max-width: 767px) {
    .pro-one-section {
      height: auto;
      min-height: unset;
      max-height: none;
      padding-bottom: 0;
    }

    .pro-one-container {
      flex-direction: column;
    }

    .pro-one-left {
      flex: 0 0 auto;
      flex-direction: column;
      gap: 0;
      padding: 20px;
      overflow: visible;
      align-items: center;
    }

    .pro-one-left-content {
      max-width: 100%;
      text-align: center;
      margin-bottom: clamp(10px, 2vw, 16px);
      width: 100%;
    }

    .pro-one-quote {
      font-size: clamp(20px, 5.5vw, 28px);
      line-height: 1.2;
      margin-bottom: clamp(8px, 2vw, 12px);
      text-align: center;
    }

    .pro-one-blog-block {
      margin-top: clamp(4px, 1.5vw, 8px);
      margin-bottom: clamp(8px, 2vw, 14px);
      text-align: center;
    }

    .pro-one-excerpt {
      font-size: clamp(14px, 3.5vw, 17px);
      font-weight: 400;
      line-height: 1.6;
      -webkit-line-clamp: 3;
      text-align: center;
    }

    .pro-one-read-more {
      font-size: clamp(13px, 3.2vw, 15px);
      font-weight: 700;
      justify-content: center;
      display: flex;
      border-bottom: none;
      width: 100%;
    }

    .pro-one-right {
      flex: 0 0 auto;
      width: 100%;
      display: none;
    }

    .pro-one-img-wrap--mobile {
      display: block !important;
      width: 100%;
      margin-left: auto;
      margin-right: auto;
      height: clamp(200px, 38vh, 360px);
      min-height: clamp(200px, 38vh, 360px);
      border-radius: clamp(8px, 2vw, 12px);
      overflow: hidden;
      margin-bottom: clamp(12px, 2.5vw, 20px);
      position: relative;
    }

    #proDoctorCardMobile {
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }

    .pro-one-img-wrap--desktop {
      display: none;
    }

    .pro-one-doctor-card {
      width: auto;
      max-width: 94%;
      bottom: 16px;
      left: 50%;
      transform: translateX(-50%);
      padding: 12px 14px;
      border-radius: 14px;
      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 2px solid #00bcd4;
      display: inline-flex;
      opacity: 1;
      pointer-events: auto;
    }

    .pro-one-dr-card-row { display: flex; flex-direction: row; align-items: center; gap: 10px; }

    .pro-one-dr-card-icon {
      flex-shrink: 0;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid #00bcd4;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .pro-one-dr-card-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }

    .pro-one-dr-card-label { font-size: 9px; letter-spacing: 0.07em; white-space: nowrap; margin: 0 0 3px 0; display: block; }

    .pro-one-doctor-name { font-size: 15px; font-weight: 700; margin: 0 0 3px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .pro-one-doctor-specialty { font-size: 11px; font-weight: 400; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-bottom: 4px; border-bottom: 1px solid rgba(0,0,0,0.1); }

    .pro-one-doctor-exp { font-size: 11px; margin: 4px 0 0 0; white-space: nowrap; }

    /* MOBILE FEATURES PANEL */
    .pro-one-features-wrap {
      width: 100%;
      position: relative;
      margin-top: 0;
      overflow: visible;
      padding-bottom: 0;
    }

    .pro-one-features-list {
      width: 100%;
      overflow: visible;
      margin-bottom: 0;
    }
      margin-top: 0;
      overflow: visible;
    }

    .pro-one-features-list {
      width: 100%;
      overflow: visible;
    }

    .pro-one-feature-row {
      width: 100%;
      gap: clamp(8px, 2.5vw, 14px);
      padding: clamp(8px, 2vh, 13px) 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      overflow: visible;
    }

    .pro-one-feature-row:first-child {
      border-top: 1px solid {{ section.settings.divider_color }};
    }

    .pro-one-feature-row:last-child {
      border-bottom: 1px solid {{ section.settings.divider_color }};
    }

    .pro-one-feature-thumb {
      width: clamp(36px, 10vw, 50px);
      height: clamp(36px, 10vw, 50px);
      border-radius: 6px;
    }

    .pro-one-feature-thumb-placeholder {
      width: clamp(36px, 10vw, 50px);
      height: clamp(36px, 10vw, 50px);
      border-radius: 6px;
    }

    .pro-one-feature-label {
      font-size: clamp(13px, 3.5vw, 16px);
      flex: 1;
      text-align: left;
    }

    .pro-one-arrow-btn {
      font-size: clamp(39px, 11vw, 50px);
      font-weight: 700;
      padding: 4px 6px;
      flex-shrink: 0;
      display: block;
      min-width: 36px;
    }

    .pro-one-hover-card.pro-one-card-visible {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .pro-one-card-close {
      display: flex;
      position: absolute;
      top: 8px;
      right: 10px;
      font-size: 16px;
      width: 22px;
      height: 22px;
      align-items: center;
      justify-content: center;
      background: none;
      border: none;
      color: #999;
      cursor: pointer;
      padding: 0;
      line-height: 1;
    }

    .pro-one-hover-card {
      padding: clamp(14px, 3vw, 20px) clamp(30px, 8vw, 40px) clamp(14px, 3vw, 20px) clamp(14px, 3vw, 20px);
      background: rgba(255, 255, 255, 0.95) !important;
    }

    .pro-one-card-title {
      font-size: 18px;
      color: #000000;
      margin: 0 0 12px 0;
      text-align: center;
      font-weight: 700;
    }

    .pro-one-card-desc {
      font-size: 15px;
      color: #333333;
      text-align: center;
      line-height: 1.65;
    }

    /* DOCTOR DETAILS MODAL */
    .pro-one-doctor-modal {
      display: none !important;
    }
  }
</style>

<section class="pro-one-section full-width">
  <div class="pro-one-container">

    <!-- ── LEFT ── -->
    <div class="pro-one-left">

      <div class="pro-one-left-content">
        <h2 class="pro-one-quote">{{ section.settings.quote }}</h2>

        <div class="pro-one-blog-block">
          {% if section.settings.blog_handle != blank %}
            {% assign selected_blog = blogs[section.settings.blog_handle] %}
            {% assign blog_article = selected_blog.articles.first %}
            {% if blog_article %}
              <p class="pro-one-excerpt">{{ blog_article.excerpt_or_content | strip_html }}</p>
              <a href="{{ blog_article.url }}" class="pro-one-read-more">
                read more<span class="pro-one-read-more-dots">....</span>
              </a>
            {% else %}
              <p class="pro-one-excerpt">{{ section.settings.fallback_excerpt }}</p>
              {% if section.settings.fallback_link != blank %}
                <a href="{{ section.settings.fallback_link }}" class="pro-one-read-more">
                  read more<span class="pro-one-read-more-dots">....</span>
                </a>
              {% endif %}
            {% endif %}
          {% else %}
            <p class="pro-one-excerpt">{{ section.settings.fallback_excerpt }}</p>
            {% if section.settings.fallback_link != blank %}
              <a href="{{ section.settings.fallback_link }}" class="pro-one-read-more">
                read more<span class="pro-one-read-more-dots">....</span>
              </a>
            {% endif %}
          {% endif %}
        </div>
      </div>

      <!-- MOBILE IMAGE - shown between text and features -->
      <div class="pro-one-img-wrap pro-one-img-wrap--mobile">
        {% if section.settings.doctor_image != blank %}
          <img
            src="{{ section.settings.doctor_image | image_url: width: 1200 }}"
            alt="{{ section.settings.doctor_name }}"
            width="1200"
            height="800"
            loading="lazy"
          >
        {% else %}
          <div class="pro-one-img-placeholder"></div>
        {% endif %}

        <div class="pro-one-doctor-card" id="proDoctorCardMobile">
          <div class="pro-one-dr-card-row">
