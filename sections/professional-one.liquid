{% comment %}
  Professional One Section
  40% left content | 60% right image with frost glass doctor card
  Font: Montserrat | Colors: white, black, #4fffff
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&display=swap');

  .pro-one-section {
    font-family: 'Montserrat', sans-serif;
    background-color: {{ section.settings.section_bg }};
    color: #000;
    padding: 0;
    overflow: hidden;
    height: {{ section.settings.section_height }}vh;
    min-height: {{ section.settings.section_min_height }}px;
    max-height: {{ section.settings.section_height }}vh;
    box-sizing: border-box;
  }

  .pro-one-container {
    width: 100%;
    height: 100%;
    padding: 0;
    display: flex;
    align-items: stretch;
  }

  /* ─── LEFT SIDE ─── */
  .pro-one-left {
    flex: 0 0 {{ section.settings.left_width }}%;
    padding: {{ section.settings.left_padding_top }}px {{ section.settings.left_padding_right }}px {{ section.settings.left_padding_bottom }}px {{ section.settings.left_padding_left }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    background-color: {{ section.settings.left_bg }};
  }

  .pro-one-quote {
    font-size: {{ section.settings.quote_font_size }}px;
    font-weight: {{ section.settings.quote_font_weight }};
    line-height: {{ section.settings.quote_line_height }};
    color: {{ section.settings.quote_color }};
    margin: 0 0 {{ section.settings.quote_margin_bottom }}px 0;
  }

  /* Blog excerpt block */
  .pro-one-blog-block {
    margin-top: {{ section.settings.excerpt_margin_top }}px;
    margin-bottom: {{ section.settings.excerpt_margin_bottom }}px;
  }

  .pro-one-excerpt {
    font-size: {{ section.settings.excerpt_font_size }}px;
    line-height: 1.65;
    color: {{ section.settings.excerpt_color }};
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0 0 6px 0;
  }

  .pro-one-read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: {{ section.settings.read_more_font_size }}px;
    font-weight: 700;
    color: {{ section.settings.read_more_color }};
    text-decoration: none;
    border-bottom: 2px solid {{ section.settings.read_more_color }};
    padding-bottom: 1px;
    transition: color 0.25s, border-color 0.25s;
  }

  .pro-one-read-more:hover {
    color: {{ section.settings.accent_color }};
    border-color: {{ section.settings.accent_color }};
  }

  .pro-one-read-more-dots {
    font-weight: 400;
    letter-spacing: 1px;
  }

  /* ─── FEATURES ─── */
  .pro-one-features-wrap {
    position: relative;
    margin-top: {{ section.settings.features_margin_top }}px;
  }

  .pro-one-features-list {
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 2;
    transition: opacity 0.3s ease;
  }

  .pro-one-features-list.pro-one-list-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .pro-one-feature-row {
    display: flex;
    align-items: center;
    gap: {{ section.settings.feature_row_gap }}px;
    padding: {{ section.settings.feature_row_padding }}px 0;
    border-bottom: 1px solid {{ section.settings.divider_color }};
    cursor: default;
  }

  .pro-one-feature-row:first-child {
    border-top: 1px solid {{ section.settings.divider_color }};
  }

  .pro-one-feature-thumb {
    width: {{ section.settings.thumb_size }}px;
    height: {{ section.settings.thumb_size }}px;
    border-radius: {{ section.settings.thumb_radius }}px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .pro-one-feature-thumb-placeholder {
    width: {{ section.settings.thumb_size }}px;
    height: {{ section.settings.thumb_size }}px;
    border-radius: {{ section.settings.thumb_radius }}px;
    background: #eee;
    flex-shrink: 0;
  }

  .pro-one-feature-label {
    font-size: {{ section.settings.feature_label_size }}px;
    font-weight: {{ section.settings.feature_label_weight }};
    color: {{ section.settings.feature_label_color }};
    flex: 1;
  }

  .pro-one-arrow-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.arrow_size }}px;
    font-weight: 600;
    color: {{ section.settings.arrow_color }};
    line-height: 1;
    transition: color 0.25s, transform 0.25s;
    font-family: 'Montserrat', sans-serif;
  }

  .pro-one-arrow-btn:hover {
    color: {{ section.settings.accent_color }};
    transform: translateX(4px);
  }

  /* Frost glass hover card */
  .pro-one-hover-card {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, {{ section.settings.card_bg_opacity | divided_by: 100.0 }});
    backdrop-filter: blur({{ section.settings.card_blur }}px);
    -webkit-backdrop-filter: blur({{ section.settings.card_blur }}px);
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.accent_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    box-shadow: 0 8px 32px rgba(79, 255, 255, 0.35), inset 0 0 0 1px rgba(255,255,255,0.3);
    opacity: 0;
    visibility: hidden;
    z-index: 3;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    pointer-events: none;
  }

  .pro-one-hover-card.pro-one-card-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .pro-one-card-title {
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: 700;
    color: {{ section.settings.card_title_color }};
    margin: 0 0 12px 0;
  }

  .pro-one-card-desc {
    font-size: {{ section.settings.card_desc_size }}px;
    line-height: 1.65;
    color: {{ section.settings.card_desc_color }};
    margin: 0;
  }

  /* ─── RIGHT SIDE ─── */
  .pro-one-right {
    flex: 0 0 {{ 100 | minus: section.settings.left_width }}%;
    position: relative;
  }

  .pro-one-img-wrap {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  .pro-one-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pro-one-img-placeholder {
    width: 100%;
    height: 100%;
    background: #f0f0f0;
  }

  /* Doctor frost glass card */
  .pro-one-doctor-card {
    position: absolute;
    bottom: {{ section.settings.doctor_card_bottom }}px;
    left: 50%;
    transform: translateX(-50%);
    width: {{ section.settings.doctor_card_width }}%;
    background: rgba(255, 255, 255, {{ section.settings.doctor_card_bg_opacity | divided_by: 100.0 }});
    backdrop-filter: blur({{ section.settings.doctor_card_blur }}px);
    -webkit-backdrop-filter: blur({{ section.settings.doctor_card_blur }}px);
    border: {{ section.settings.doctor_card_border_width }}px solid {{ section.settings.accent_color }};
    border-radius: {{ section.settings.doctor_card_radius }}px;
    padding: {{ section.settings.doctor_card_padding_v }}px {{ section.settings.doctor_card_padding_h }}px;
    box-shadow: 0 8px 32px rgba(79, 255, 255, 0.4);
  }

  .pro-one-doctor-name {
    font-size: {{ section.settings.doctor_name_size }}px;
    font-weight: {{ section.settings.doctor_name_weight }};
    font-style: italic;
    color: {{ section.settings.doctor_name_color }};
    margin: 0 0 6px 0;
  }

  .pro-one-doctor-specialty {
    font-size: {{ section.settings.doctor_meta_size }}px;
    font-weight: 700;
    color: {{ section.settings.doctor_meta_color }};
    margin: 0 0 4px 0;
  }

  .pro-one-doctor-exp {
    font-size: {{ section.settings.doctor_meta_size }}px;
    font-weight: 400;
    color: {{ section.settings.doctor_meta_color }};
    margin: 0;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: {{ section.settings.mobile_breakpoint }}px) {
    .pro-one-section {
      height: auto;
      max-height: none;
    }

    .pro-one-container {
      flex-direction: column;
    }

    .pro-one-left,
    .pro-one-right {
      flex: 0 0 100%;
    }

    .pro-one-left {
      padding: 30px 20px;
    }

    .pro-one-img-wrap {
      min-height: {{ section.settings.mobile_image_height }}px;
    }
  }
</style>

<section class="pro-one-section full-width">
  <div class="pro-one-container">

    <!-- ── LEFT ── -->
    <div class="pro-one-left">

      <h2 class="pro-one-quote">{{ section.settings.quote }}</h2>

      <div class="pro-one-blog-block">
        {% if section.settings.blog_handle != blank %}
          {% assign selected_blog = blogs[section.settings.blog_handle] %}
          {% assign blog_article = selected_blog.articles.first %}
          {% if blog_article %}
            <p class="pro-one-excerpt">{{ blog_article.excerpt_or_content | strip_html }}</p>
            <a href="{{ blog_article.url }}" class="pro-one-read-more">
              read more<span class="pro-one-read-more-dots">....</span>
            </a>
          {% else %}
            <p class="pro-one-excerpt">{{ section.settings.fallback_excerpt }}</p>
            {% if section.settings.fallback_link != blank %}
              <a href="{{ section.settings.fallback_link }}" class="pro-one-read-more">
                read more<span class="pro-one-read-more-dots">....</span>
              </a>
            {% endif %}
          {% endif %}
        {% else %}
          <p class="pro-one-excerpt">{{ section.settings.fallback_excerpt }}</p>
          {% if section.settings.fallback_link != blank %}
            <a href="{{ section.settings.fallback_link }}" class="pro-one-read-more">
              read more<span class="pro-one-read-more-dots">....</span>
            </a>
          {% endif %}
        {% endif %}
      </div>

      <div class="pro-one-features-wrap" id="proOneFeaturesWrap">
        <div class="pro-one-features-list" id="proOneFeaturesList">
          {% for block in section.blocks %}
            <div
              class="pro-one-feature-row"
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.feature_image != blank %}
                <img
                  class="pro-one-feature-thumb"
                  src="{{ block.settings.feature_image | image_url: width: 104 }}"
                  alt="{{ block.settings.feature_title }}"
                  width="{{ section.settings.thumb_size }}"
                  height="{{ section.settings.thumb_size }}"
                  loading="lazy"
                >
              {% else %}
                <div class="pro-one-feature-thumb-placeholder"></div>
              {% endif %}
              <span class="pro-one-feature-label">{{ block.settings.feature_title }}</span>
              <button
                class="pro-one-arrow-btn"
                aria-label="Learn more about {{ block.settings.feature_title }}"
                data-target="{{ forloop.index0 }}"
              >&#8250;</button>
            </div>
          {% endfor %}
        </div>

        {% for block in section.blocks %}
          <div class="pro-one-hover-card" data-card="{{ forloop.index0 }}">
            <h3 class="pro-one-card-title">{{ block.settings.feature_title }}</h3>
            <p class="pro-one-card-desc">{{ block.settings.feature_description }}</p>
          </div>
        {% endfor %}
      </div>

    </div>

    <!-- ── RIGHT ── -->
    <div class="pro-one-right">
      <div class="pro-one-img-wrap">
        {% if section.settings.doctor_image != blank %}
          <img
            src="{{ section.settings.doctor_image | image_url: width: 1200 }}"
            alt="{{ section.settings.doctor_name }}"
            width="1200"
            height="800"
            loading="lazy"
          >
        {% else %}
          <div class="pro-one-img-placeholder"></div>
        {% endif %}

        <div class="pro-one-doctor-card">
          <p class="pro-one-doctor-name">{{ section.settings.doctor_name }}</p>
          <p class="pro-one-doctor-specialty">{{ section.settings.doctor_specialty }}</p>
          <p class="pro-one-doctor-exp">{{ section.settings.doctor_experience }}</p>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
(function () {
  var list    = document.getElementById('proOneFeaturesList');
  var cards   = document.querySelectorAll('.pro-one-hover-card');
  var buttons = document.querySelectorAll('.pro-one-arrow-btn');
  var activeCard = null;

  function showCard(index) {
    hideAll();
    var card = document.querySelector('.pro-one-hover-card[data-card="' + index + '"]');
    if (!card) return;
    card.classList.add('pro-one-card-visible');
    list.classList.add('pro-one-list-hidden');
    activeCard = index;
  }

  function hideAll() {
    cards.forEach(function (c) { c.classList.remove('pro-one-card-visible'); });
    list.classList.remove('pro-one-list-hidden');
    activeCard = null;
  }

  buttons.forEach(function (btn) {
    btn.addEventListener('mouseenter', function () {
      showCard(parseInt(btn.getAttribute('data-target'), 10));
    });
  });

  var wrap = document.getElementById('proOneFeaturesWrap');
  if (wrap) {
    wrap.addEventListener('mouseleave', function () { hideAll(); });
  }
})();
</script>

{% schema %}
