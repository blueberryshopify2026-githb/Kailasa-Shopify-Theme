{% comment %}
  Professional Panel Section - 50/50 layout
  Left: white background + black card with professional info
  Right: image only
  Navigation arrows at bottom-right of right image column
{% endcomment %}

<style>
  .professional-panel-section {
    font-family: 'Montserrat', sans-serif;
    width: 100%;
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    position: relative;
  }

  /* ── Left column: white background, card centred ── */
  .prof-left {
    background: {{ section.settings.section_bg_color | default: '#ffffff' }};
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 40px;
    box-sizing: border-box;
    position: relative;
  }

  /* ── Right column: image fills full column ── */
  .prof-right {
    position: relative;
    overflow: hidden;
  }

  .prof-image-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }

  .prof-image-slide.active {
    opacity: 1;
    visibility: visible;
  }

  .prof-image-slide img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  /* ── Professional Card ── */
  .professional-card {
    background: {{ section.settings.card_bg_color | default: '#000000' }};
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: 50px 40px;
    max-width: 520px;
    width: 100%;
    min-height: 480px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    text-align: center;
  }

  .professional-card-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    padding: 50px 40px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 30px;
    box-sizing: border-box;
  }

  .professional-card-content.active {
    opacity: 1;
    visibility: visible;
  }

  .professional-name {
    font-size: {{ section.settings.name_font_size }}px;
    font-weight: 700;
    color: {{ section.settings.name_color | default: '#ffffff' }};
    margin: 0;
    line-height: 1.2;
    font-family: 'Montserrat', sans-serif;
  }

  .professional-designation {
    font-size: {{ section.settings.designation_font_size }}px;
    font-weight: 100;
    color: {{ section.settings.designation_color | default: '#4FFFFF' }};
    margin: -30px 0 0 0;
    line-height: 1.3;
    font-family: 'Montserrat', sans-serif;
  }

  .professional-quote {
    font-size: {{ section.settings.quote_font_size }}px;
    font-style: italic;
    color: {{ section.settings.quote_color | default: '#ffffff' }};
    line-height: 1.6;
    margin: 20px 0 0 0;
    position: relative;
    font-family: 'Montserrat', sans-serif;
  }

  .quote-mark {
    color: {{ section.settings.quote_mark_color | default: '#4FFFFF' }};
    font-size: 32px;
    font-style: normal;
    font-weight: bold;
    line-height: 1;
    vertical-align: baseline;
    display: inline;
  }

  .quote-mark.opening {
    position: relative;
    top: -8px;
    margin-right: 2px;
  }

  .quote-mark.closing {
    position: relative;
    top: -8px;
    margin-left: 2px;
  }

  .professional-cta {
    background: transparent;
    color: {{ section.settings.cta_text_color | default: '#ffffff' }};
    border: 2px solid {{ section.settings.cta_border_color | default: '#4FFFFF' }};
    border-radius: {{ section.settings.cta_border_radius }}px;
    padding: 14px 40px;
    font-family: 'Montserrat', sans-serif;
    font-size: {{ section.settings.cta_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.5s ease;
    text-decoration: none;
    display: inline-block;
    text-transform: uppercase;
    margin-top: 10px;
  }

  .professional-cta:hover {
    transform: translateY(-3px);
  }

  /* ── Navigation Arrows — bottom-right of right image column ── */
  .carousel-navigation {
    display: flex;
    gap: 10px;
    position: absolute;
    right: 30px;
    bottom: 30px;
    z-index: 10;
  }

  .carousel-arrow {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: {{ section.settings.arrow_bg_color | default: '#ffffff' }};
    border: 3px solid {{ section.settings.arrow_border_color | default: '#4FFFFF' }};
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .carousel-arrow:hover {
    background: {{ section.settings.arrow_border_color | default: '#4FFFFF' }};
    {% comment %} transform: scale(1.1); {% endcomment %}
  }

  .carousel-arrow svg {
    width: 34px;
    height: 34px;
    fill: {{ section.settings.arrow_color | default: '#4FFFFF' }};
    transition: fill 0.3s ease;
  }

  .carousel-arrow:hover svg {
    fill: #fff;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .professional-panel-section {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .prof-left {
      padding: 50px 30px;
    }

    .prof-right {
      min-height: 50vw;
    }

    .carousel-navigation {
      right: 20px;
      bottom: 20px;
    }
  }

  @media (max-width: 768px) {
    .professional-card {
      padding: 40px 24px;
      max-width: 100%;
    }

    .professional-name {
      font-size: {{ section.settings.name_font_size | minus: 6 }}px;
    }

    .professional-quote {
      font-size: {{ section.settings.quote_font_size | minus: 2 }}px;
    }

    .prof-right {
      min-height: 60vw;
    }
  }

  /* early 480px block removed — all mobile styles handled in the main block below */

  /* ── TABLET ONLY: 481px – 1024px ─────────────────────────────────────────
     50/50 side-by-side layout: black card left, image right, arrows bottom-right.
     Desktop (>1024px) and mobile (≤480px) are NOT touched.
  ────────────────────────────────────────────────────────────────────────────── */
  @media (min-width: 481px) and (max-width: 1024px) {

    /* 50/50 grid, height fits content */
    .professional-panel-section {
      display: grid !important;
      grid-template-columns: 1fr 1fr !important;
      grid-template-rows: auto !important;
      min-height: unset !important;
      height: auto !important;
      overflow: hidden !important;
    }

    /* Left column — card centred, natural height */
    .prof-left {
      order: unset !important;
      margin-top: 0 !important;
      z-index: auto !important;
      background: {{ section.settings.section_bg_color | default: '#ffffff' }} !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: {{ section.settings.tab_card_padding_v | default: 50 }}px {{ section.settings.tab_card_padding_h | default: 36 }}px !important;
      box-sizing: border-box !important;
    }

    /* Card — restore desktop appearance */
    .professional-card {
      background: {{ section.settings.card_bg_color | default: '#000000' }} !important;
      border-radius: {{ section.settings.card_border_radius }}px !important;
      padding: {{ section.settings.tab_card_inner_padding_v | default: 44 }}px {{ section.settings.tab_card_inner_padding_h | default: 32 }}px !important;
      max-width: 100% !important;
      width: 100% !important;
      min-height: 460px !important;
      height: auto !important;
      position: relative !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: center !important;
      box-shadow: 0 10px 40px rgba(0,0,0,0.2) !important;
      box-sizing: border-box !important;
    }

    /* Card content — restore absolute-positioned slide behaviour */
    .professional-card-content {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
      padding: {{ section.settings.tab_card_inner_padding_v | default: 44 }}px {{ section.settings.tab_card_inner_padding_h | default: 32 }}px !important;
      box-sizing: border-box !important;
      display: none !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: center !important;
      gap: {{ section.settings.tab_card_gap | default: 24 }}px !important;
      text-align: center !important;
      opacity: 0 !important;
      visibility: hidden !important;
    }

    .professional-card-content.active {
      display: flex !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    /* Right column — image fills column, arrows inside it */
    .prof-right {
      order: unset !important;
      width: 100% !important;
      height: auto !important;
      min-height: 460px !important;
      aspect-ratio: unset !important;
      position: relative !important;
      overflow: hidden !important;
    }

    .prof-image-slide {
      position: absolute !important;
      inset: 0 !important;
    }

    .prof-image-slide img {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
      object-position: center !important;
    }

    /* Arrows — bottom-right inside image column */
    .carousel-navigation {
      position: absolute !important;
      right: 20px !important;
      bottom: 20px !important;
    }

    .carousel-arrow {
      width: {{ section.settings.tab_arrow_size | default: 50 }}px !important;
      height: {{ section.settings.tab_arrow_size | default: 50 }}px !important;
    }

    /* Typography */
    .professional-name {
      font-size: {{ section.settings.tab_name_font_size | default: 36 }}px !important;
      line-height: 1.2 !important;
    }

    .professional-designation {
      font-size: {{ section.settings.tab_designation_font_size | default: 16 }}px !important;
      margin: -12px 0 0 0 !important;
    }

    .professional-quote {
      font-size: {{ section.settings.tab_quote_font_size | default: 15 }}px !important;
      line-height: 1.6 !important;
      margin: 0 !important;
    }

    .quote-mark {
      font-size: {{ section.settings.tab_quote_mark_size | default: 26 }}px !important;
    }

    .professional-cta {
      font-size: {{ section.settings.tab_cta_font_size | default: 13 }}px !important;
      padding: 12px 32px !important;
    }
  }

  /* ── MOBILE ONLY ≤480px — image top, info card flush below, no side margins ──
     Existing desktop/tablet code above is NOT modified.
     All rules use !important to isolate from desktop styles.
  ────────────────────────────────────────────────────────────────────────────── */
  @media (max-width: 480px) {

    /* Section — exactly one viewport tall */
    /* Section — exactly 100vh, split 60/40 */
    .professional-panel-section {
      display: flex !important;
      flex-direction: column !important;
      grid-template-columns: 1fr !important;
      min-height: 100vh !important;
      height: 100vh !important;
      overflow: hidden !important;
    }

    /* Image column — exactly 50vh */
    .prof-right {
      order: 1 !important;
      width: 100% !important;
      min-height: unset !important;
      flex: 0 0 50vh !important;
      height: 50vh !important;
      aspect-ratio: unset !important;
      position: relative !important;
      overflow: hidden !important;
    }

    .prof-image-slide {
      position: absolute !important;
      inset: 0 !important;
    }

    .prof-image-slide img {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
      object-position: center bottom !important;
    }

    /* Nav arrows — inside image, bottom-right */
    .carousel-navigation {
      right: 14px !important;
      bottom: 14px !important;
    }

    .carousel-arrow {
      width: 45px !important;
      height: 45px !important;
      {% comment %} background-color: red; {% endcomment %}
    }

    .carousel-arrow svg {
      width: 32px !important;
      height: 32px !important;
    }

    /* Info column — exactly 50vh, with side padding for card margins */
    .prof-left {
      order: 2 !important;
      padding: 0 12px !important;
      background: transparent !important;
      width: 100% !important;
      flex: 0 0 50vh !important;
      height: 50vh !important;
      display: flex !important;
      align-items: stretch !important;
      justify-content: flex-start !important;
      box-sizing: border-box !important;
      margin-top: 0 !important;
      position: relative !important;
      z-index: 2 !important;
    }

    /* Card — fills full 40vh height, flex so content centres */
    .professional-card {
      max-width: 100% !important;
      width: 100% !important;
      height: 100% !important;
      border-radius: {{ section.settings.card_border_radius }}px !important;
      padding: 0 !important;
      min-height: unset !important;
      box-shadow: none !important;
      position: relative !important;
      display: flex !important;
      align-items: stretch !important;
      box-sizing: border-box !important;
    }

    /* Card content — fills card, no top/bottom padding, content centred */
    .professional-card-content {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
      display: none !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      text-align: center !important;
      gap: {{ section.settings.mob_card_gap | default: 14 }}px !important;
      padding: 0 {{ section.settings.mob_card_padding_h | default: 20 }}px !important;
      box-sizing: border-box !important;
      opacity: 1 !important;
      visibility: visible !important;
    }

    .professional-card-content.active {
      display: flex !important;
    }

    /* Typography — controlled from theme editor via Mobile Settings */
    .professional-name {
      font-size: {{ section.settings.mob_name_font_size | default: 24 }}px !important;
      line-height: 1.2 !important;
    }

    .professional-designation {
      font-size: {{ section.settings.mob_designation_font_size | default: 13 }}px !important;
      margin: 0 !important;
    }

    .professional-quote {
      font-size: {{ section.settings.mob_quote_font_size | default: 12 }}px !important;
      margin: 0 !important;
      line-height: 1.6 !important;
    }

    .quote-mark {
      font-size: {{ section.settings.mob_quote_mark_size | default: 18 }}px !important;
    }

    .professional-cta {
      font-size: {{ section.settings.mob_cta_font_size | default: 11 }}px !important;
      padding: 11px 28px !important;
      margin-top: 0 !important;
    }
  }
</style>

<section class="professional-panel-section full-width" id="professional-panel">

  <!-- Left: white bg + card -->
  <div class="prof-left">
    <div class="professional-card">
      {% for block in section.blocks %}
        {% if block.type == 'professional' %}
          <div class="professional-card-content {% if forloop.first %}active{% endif %}"
               data-slide="{{ forloop.index0 }}"
               {{ block.shopify_attributes }}>
            <h2 class="professional-name">{{ block.settings.name }}</h2>
            <p class="professional-designation">{{ block.settings.designation }}</p>
            <p class="professional-quote">
              <span class="quote-mark opening">"</span>{{ block.settings.quote }}<span class="quote-mark closing">"</span>
            </p>
            {% if block.settings.cta_text != blank %}
              <a href="{{ block.settings.cta_link }}" class="professional-cta">
                {{ block.settings.cta_text }}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- Right: image only + navigation arrows -->
  <div class="prof-right">
    {% for block in section.blocks %}
      {% if block.type == 'professional' %}
        <div class="prof-image-slide {% if forloop.first %}active{% endif %}"
             data-slide="{{ forloop.index0 }}">
          {% if block.settings.background_image %}
            <img src="{{ block.settings.background_image | image_url: width: 1200 }}"
                 alt="{{ block.settings.name | escape }}"
                 width="1200" height="900"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}

    {% if section.blocks.size > 1 %}
      <div class="carousel-navigation">
        <button class="carousel-arrow carousel-prev" onclick="changeSlide(-1)" aria-label="Previous">
          <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        </button>
        <button class="carousel-arrow carousel-next" onclick="changeSlide(1)" aria-label="Next">
          <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>
      </div>
    {% endif %}
  </div>

</section>

<script>
(function () {
  var currentSlide = 0;
  var slideContents = document.querySelectorAll('#professional-panel .professional-card-content');
  var imageSlides  = document.querySelectorAll('#professional-panel .prof-image-slide');
  var totalSlides  = slideContents.length;

  window.changeSlide = function (direction) {
    slideContents[currentSlide].classList.remove('active');
    imageSlides[currentSlide] && imageSlides[currentSlide].classList.remove('active');

    currentSlide = (currentSlide + direction + totalSlides) % totalSlides;

    slideContents[currentSlide].classList.add('active');
    imageSlides[currentSlide] && imageSlides[currentSlide].classList.add('active');
  };
})();
</script>

{% schema %}
