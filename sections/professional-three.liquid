    { "type": "range", "id": "spt_dr_card_blur", "label": "Card Blur (px)", "min": 0, "max": 30, "step": 2, "default": 14 },
    { "type": "range", "id": "spt_dr_card_radius", "label": "Card Radius (px)", "min": 0, "max": 40, "step": 2, "default": 14 },
    { "type": "range", "id": "spt_dr_card_pad_v", "label": "Card Padding Vertical (px)", "min": 8, "max": 40, "step": 2, "default": 16 },
    { "type": "range", "id": "spt_dr_card_pad_h", "label": "Card Padding Horizontal (px)", "min": 8, "max": 40, "step": 2, "default": 20 },
    { "type": "range", "id": "spt_dr_name_size", "label": "Name Font Size (px)", "min": 14, "max": 36, "step": 1, "default": 22 },
    { "type": "color", "id": "spt_dr_name_color", "label": "Name Color", "default": "#000000" },
    { "type": "range", "id": "spt_dr_meta_size", "label": "Specialty/Exp Font Size (px)", "min": 11, "max": 20, "step": 1, "default": 14 },
    { "type": "color", "id": "spt_dr_meta_color", "label": "Specialty/Exp Color", "default": "#000000" }

  ],
  "blocks": [
    {
      "type": "thumbnail",
      "name": "Thumbnail",
      "settings": [
        { "type": "image_picker", "id": "spt_thumb_img", "label": "Image" },
        { "type": "text", "id": "spt_thumb_title", "label": "Hover Card Heading", "default": "Did you know?" },
        { "type": "textarea", "id": "spt_thumb_info", "label": "Hover Card Text (2 lines)", "default": "Healthy skin starts with the right routine and consistent care." },
        { "type": "url", "id": "spt_thumb_link", "label": "Read More Link" }
      ]
    }
  ],
