{% comment %}
  Professional Three Section
  60% left: heading, blog excerpt, thumbnails or info card
  40% right: doctor image with frost glass card
  Class suffix: spt
{% endcomment %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&display=swap');

  .spt-section {
    font-family: 'Montserrat', sans-serif;
    background: {{ section.settings.spt_bg }};
    height: 100vh;
    min-height: 600px;
    overflow-x: clip;
    overflow-y: visible;
    box-sizing: border-box;
    display: flex;
    align-items: stretch;
  }

  /* ── LEFT 55% ── */
  .spt-left {
    flex: 0 0 55%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: {{ section.settings.spt_left_pad_v }}px {{ section.settings.spt_left_pad_h }}px;
    position: relative;
  }

  .spt-heading {
    font-size: {{ section.settings.spt_heading_size }}px;
    font-weight: {{ section.settings.spt_heading_weight }};
    color: {{ section.settings.spt_heading_color }};
    line-height: 1.2;
    margin: 0 0 {{ section.settings.spt_heading_gap }}px 0;
  }

  /* Blog excerpt — 2 lines max */
  .spt-excerpt-wrap {
    font-size: max({{ section.settings.spt_excerpt_size }}px, 17px);
    color: {{ section.settings.spt_excerpt_color }};
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0 0 6px 0;
  }

  .spt-read-more {
    display: block;
    font-size: {{ section.settings.spt_excerpt_size }}px;
    font-weight: 700;
    color: #000000;
    text-decoration: underline;
    text-decoration-color: #00bcd4;
    text-underline-offset: 3px;
    margin-top: 4px;
    transition: opacity 0.2s;
  }

  .spt-read-more:hover { opacity: 0.75; }

  /* ── Bottom area: thumbnails OR info card ── */
  .spt-bottom {
    margin-top: 20px;
    padding-top: {{ section.settings.spt_bottom_gap }}px;
    padding-bottom: 10px;
  }

  /* Thumbnails row */
  .spt-thumbs {
    display: flex;
    gap: {{ section.settings.spt_thumb_gap }}px;
    align-items: flex-end;
    padding-bottom: 10px;
    margin-bottom: 10px;
  }

  .spt-thumb-wrap {
    position: relative;
    width: {{ section.settings.spt_thumb_size }}px;
    height: {{ section.settings.spt_thumb_size }}px;
    border-radius: {{ section.settings.spt_thumb_radius }}px;
    overflow: visible;
    flex-shrink: 0;
    cursor: pointer;
  }

  /* Desktop: thumbs fill available width equally, bigger gap */
  @media (min-width: 1025px) {
    .spt-thumbs {
      gap: 28px;
    }

    .spt-thumb-wrap {
      flex: 1 1 0;
      width: auto;
      min-width: 0;
    }
  }

  .spt-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: {{ section.settings.spt_thumb_radius }}px;
    transition: transform 0.3s ease;
  }

  .spt-thumb-wrap:hover .spt-thumb-img {
    transform: scale(1.05);
  }

  /* Hover info card — inside thumbnail, hidden by default */
  .spt-thumb-hover-card {
    display: none;
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    width: max-content;
    min-width: 100%;
    max-width: 320px;
    background: rgba(255,255,255,0.97);
    backdrop-filter: blur({{ section.settings.spt_thumb_frost_blur }}px);
    -webkit-backdrop-filter: blur({{ section.settings.spt_thumb_frost_blur }}px);
    border: 2px solid #4fffff;
    border-radius: {{ section.settings.spt_thumb_radius }}px;
    padding: 10px 14px;
    z-index: 30;
    box-shadow: 0 4px 16px rgba(0,188,212,0.25);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    box-sizing: border-box;
  }

  /* Visible state */
  .spt-thumb-hover-card.spt-active {
    display: block;
    opacity: 1;
    pointer-events: auto;
  }

  /* Desktop: show above on hover */
  @media (min-width: 1025px) {
    .spt-thumb-wrap:hover .spt-thumb-hover-card {
      display: block;
      opacity: 1;
      pointer-events: auto;
    }
  }

  .spt-hcard-title {
    font-size: 15px;
    font-weight: 700;
    color: {{ section.settings.spt_thumb_frost_color }};
    text-align: center;
    margin: 0 0 4px 0;
  }

  .spt-hcard-text {
    font-size: 13px;
    font-weight: 400;
    color: {{ section.settings.spt_thumb_frost_color }};
    text-align: center;
    line-height: 1.4;
    margin: 0;
  }

  .spt-hcard-link {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: #000;
    text-decoration: underline;
    text-decoration-color: #00bcd4;
    text-underline-offset: 2px;
    text-align: center;
    margin-top: 4px;
    transition: opacity 0.2s;
  }

  .spt-hcard-link:hover { opacity: 0.7; }

  /* Info card (alternative bottom) */
  .spt-info-card {
    background: rgba(255,255,255,{{ section.settings.spt_info_card_opacity | divided_by: 100.0 }});
    backdrop-filter: blur({{ section.settings.spt_info_card_blur }}px);
    -webkit-backdrop-filter: blur({{ section.settings.spt_info_card_blur }}px);
    border: 2px solid #00bcd4;
    border-radius: {{ section.settings.spt_info_card_radius }}px;
    padding: {{ section.settings.spt_info_card_pad }}px;
    max-width: {{ section.settings.spt_info_card_width }}px;
    box-shadow: 0 4px 20px rgba(79,255,255,0.2);
  }

  .spt-info-card-title {
    font-size: {{ section.settings.spt_info_title_size }}px;
    font-weight: 700;
    color: {{ section.settings.spt_info_title_color }};
    margin: 0 0 6px 0;
  }

  .spt-info-card-text {
    font-size: {{ section.settings.spt_info_text_size }}px;
    color: {{ section.settings.spt_info_text_color }};
    line-height: 1.55;
    margin: 0;
  }

  /* ── RIGHT 45% ── */
  .spt-right {
    flex: 0 0 45%;
    position: relative;
    overflow: visible;
  }

  /* Clip only the image, not the card */
  .spt-right-img-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .spt-doctor-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.spt_img_position }};
    display: block;
  }

  .spt-doctor-placeholder {
    width: 100%;
    height: 100%;
    background: #f0f0f0;
  }

  /* Doctor frost glass card — copied from pt-doctor-card desktop */
  .spt-doctor-card {
    position: absolute;
    width: auto;
    max-width: 90%;
    bottom: {{ section.settings.spt_dr_card_bottom }}px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(255,255,255,0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 2px solid #4fffff;
    border-radius: {{ section.settings.spt_dr_card_radius }}px;
    padding: {{ section.settings.spt_dr_card_pad_v }}px {{ section.settings.spt_dr_card_pad_h }}px;
    box-shadow: 0 8px 32px rgba(79,255,255,0.35);
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 14px;
  }

  .spt-dr-card-icon {
    flex-shrink: 0;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 2px solid #4fffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .spt-dr-card-body {
    flex: 1;
    min-width: 0;
  }

  .spt-dr-card-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    color: #00bcd4;
    text-transform: uppercase;
    margin: 0 0 4px 0;
    display: block;
    white-space: nowrap;
  }

  .spt-dr-name {
    font-size: {{ section.settings.spt_dr_name_size }}px;
    font-weight: 700;
    font-style: normal;
    color: {{ section.settings.spt_dr_name_color }};
    margin: 0 0 4px 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .spt-dr-specialty {
    font-size: {{ section.settings.spt_dr_meta_size }}px;
    font-weight: 400;
    color: {{ section.settings.spt_dr_meta_color }};
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .spt-dr-exp {
    font-size: {{ section.settings.spt_dr_meta_size }}px;
    font-weight: 400;
    color: {{ section.settings.spt_dr_meta_color }};
    margin: 6px 0 0 0;
    padding-top: 6px;
    border-top: 1px solid rgba(0,0,0,0.1);
    white-space: nowrap;
  }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .spt-section {
      flex-direction: column;
      height: auto;
      overflow: visible;
    }

    /* Image block FIRST — matches pt-left mobile size */
    .spt-right {
      flex: none;
      width: 94%;
      min-height: 420px;
      max-height: 85vw;
      order: 1;
      position: relative;
      overflow: visible;
      border-radius: 20px;
      margin: 16px auto 0;
    }

    .spt-right-img-clip {
      border-radius: 20px;
      overflow: hidden;
    }

    .spt-doctor-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      border-radius: {{ section.settings.spt_mob_img_radius }}px;
    }

    /* Doctor frost glass card — always visible */
    .spt-doctor-card {
      width: auto;
      max-width: 92%;
      bottom: 16px;
      left: 50%;
      transform: translateX(-50%);
      padding: 10px 14px;
      border-radius: 14px;
      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 2px solid #4fffff;
      display: inline-flex;
      flex-direction: row;
      align-items: center;
      gap: 10px;
      opacity: 1;
      pointer-events: auto;
    }

    .spt-dr-card-icon {
      flex-shrink: 0;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid #4fffff;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .spt-dr-card-body { flex: 1; min-width: 0; }

    .spt-dr-card-label { font-size: 8px; letter-spacing: 0.07em; white-space: nowrap; margin-bottom: 2px; }

    .spt-dr-name { font-size: 15px; font-weight: 700; margin-bottom: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .spt-dr-specialty { font-size: 11px; font-weight: 400; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .spt-dr-exp { font-size: 11px; margin: 4px 0 0 0; padding-top: 4px; border-top: 1px solid rgba(0,0,0,0.1); white-space: nowrap; }

    /* Text block SECOND */
    .spt-left {
      flex: none;
      width: 100%;
      padding: {{ section.settings.spt_mob_pad_v }}px {{ section.settings.spt_mob_pad_h }}px 0;
      order: 2;
    }

    .spt-heading {
      font-size: 22px;
      font-weight: 700;
      line-height: 1.3;
      text-align: center;
      margin-bottom: 10px;
    }

    .spt-excerpt-wrap {
      font-size: 16px;
      text-align: center;
      -webkit-line-clamp: 3;
      margin-bottom: 4px;
    }

    .spt-excerpt-block {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* Read more: black text, cyan underline */
    .spt-read-more {
      color: #000000 !important;
      text-decoration: underline;
      text-decoration-color: #00bcd4;
      text-underline-offset: 3px;
      font-size: 13px;
    }
    .spt-read-more:hover { color: #00bcd4 !important; }

    /* Thumbnails THIRD — 2x2 grid */
    .spt-bottom {
      order: 3;
      margin-top: {{ section.settings.spt_mob_bottom_gap }}px;
      padding: 0 {{ section.settings.spt_mob_pad_h }}px {{ section.settings.spt_mob_pad_h }}px;
    }

    .spt-thumbs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: {{ section.settings.spt_mob_thumb_gap }}px;
      align-items: unset;
      padding-bottom: 0;
      margin-bottom: 0;
    }

    /* Each thumbnail fills its grid cell */
    .spt-thumb-wrap {
      width: 100% !important;
      height: {{ section.settings.spt_mob_thumb_height }}px !important;
      border-radius: {{ section.settings.spt_thumb_radius }}px;
      position: relative;
      overflow: hidden;
    }

    /* Hover card: fills the full thumbnail on tap */
    .spt-thumb-hover-card {
      display: none;
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100% !important;
      max-width: none !important;
      height: 100% !important;
      transform: none !important;
      border-radius: {{ section.settings.spt_thumb_radius }}px;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 12px !important;
      box-sizing: border-box;
      background: rgba(255,255,255,0.95) !important;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 10;
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }

    .spt-thumb-hover-card.spt-active {
      display: flex !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }

    .spt-hcard-title {
      font-size: max({{ section.settings.spt_mob_hcard_size }}px, 15px);
      text-align: center;
      margin: 0 0 6px 0;
    }

    .spt-hcard-text {
      font-size: max({{ section.settings.spt_mob_hcard_size | minus: 1 }}px, 13px);
      text-align: center;
      margin: 0 0 4px 0;
    }

    .spt-hcard-link {
      font-size: {{ section.settings.spt_mob_hcard_size | minus: 1 }}px;
      text-align: center;
      color: #000;
      text-decoration: underline;
      text-decoration-color: #00bcd4;
    }
  }

  /* ── TABLET: 769px–1024px ── */
  @media (min-width: 769px) and (max-width: 1024px) {

    /* Stack column: image → text → thumbnails */
    .spt-section {
      flex-direction: column;
      height: auto;
      overflow: visible;
    }

    /* Image FIRST */
    .spt-right {
      flex: none;
      width: 94%;
      min-height: 520px;
      max-height: 60vw;
      order: 1;
      position: relative;
      overflow: visible;
      border-radius: 20px;
      margin: 20px auto 0;
    }

    .spt-right-img-clip {
      border-radius: 20px;
      overflow: hidden;
    }

    .spt-doctor-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      border-radius: 20px;
    }

    /* Doctor frost card on tablet — always visible */
    .spt-doctor-card {
      width: auto;
      max-width: 85%;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      padding: 14px 18px;
      border-radius: 16px;
      background: rgba(255,255,255,0.75);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 2px solid #4fffff;
      display: inline-flex;
      flex-direction: row;
      align-items: center;
      gap: 14px;
      opacity: 1;
      pointer-events: auto;
    }
    .spt-dr-card-icon { width: 44px; height: 44px; border: 2px solid #4fffff; }
    .spt-dr-card-label { font-size: 10px; }
    .spt-dr-name { font-size: 20px; }
    .spt-dr-specialty { font-size: 14px; }
    .spt-dr-exp { font-size: 14px; margin-top: 6px; padding-top: 6px; }

    /* Text block SECOND */
    .spt-left {
      flex: none;
      width: 94%;
      order: 2;
      margin: 0 auto;
      padding: 28px 0 0;
      display: flex;
      flex-direction: column;
    }

    .spt-heading {
      font-size: 36px;
      font-weight: 700;
      line-height: 1.3;
      margin-bottom: 14px;
      text-align: center;
    }

    .spt-excerpt-wrap {
      font-size: 19px;
      text-align: center;
      -webkit-line-clamp: 3;
    }

    .spt-excerpt-block { align-items: center; }

    .spt-read-more {
      font-size: 17px;
      color: #000000 !important;
      text-decoration: underline;
      text-decoration-color: #00bcd4;
      text-underline-offset: 3px;
      text-align: center;
    }

    /* Thumbnails THIRD — 4 in one row */
    .spt-bottom {
      width: 100%;
      margin: 32px 0 0;
      padding: 0 0 32px;
    }

    .spt-thumbs {
      display: flex;
      flex-direction: row;
      gap: 16px;
      align-items: stretch;
      padding-bottom: 0;
      margin-bottom: 0;
    }

    .spt-thumb-wrap {
      flex: 1 1 0;
      width: auto !important;
      height: 200px !important;
      border-radius: {{ section.settings.spt_thumb_radius }}px;
      position: relative;
      overflow: hidden;
    }

    /* Hover card on tablet — fills the full thumbnail on tap */
    .spt-thumb-hover-card {
      display: none;
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100% !important;
      max-width: none !important;
      height: 100% !important;
      transform: none !important;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 12px !important;
      box-sizing: border-box;
      background: rgba(255,255,255,0.95) !important;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-radius: {{ section.settings.spt_thumb_radius }}px;
      z-index: 10;
      opacity: 0;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }

    .spt-thumb-hover-card.spt-active {
      display: flex !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }

    .spt-hcard-title {
      font-size: 17px;
      text-align: center;
      margin: 0 0 6px 0;
    }

    .spt-hcard-text {
      font-size: 15px;
      text-align: center;
    }

    .spt-hcard-link {
      font-size: 14px;
    }
  }

  /* Narrow mobile: 320px–479px */
  @media (max-width: 479px) {
    .spt-right {
      min-height: 360px;
      max-height: 88vw;
    }
    .spt-heading { font-size: 20px; }
    .spt-excerpt-wrap, .spt-read-more { font-size: 15px; }
    .spt-dr-name { font-size: 14px; }
    .spt-dr-specialty, .spt-dr-exp { font-size: 10px; }
  }

  /* Very small: ≤360px */
  @media (max-width: 360px) {
    .spt-right { min-height: 300px; }
    .spt-heading { font-size: 18px; }
    .spt-excerpt-wrap, .spt-read-more { font-size: 14px; }
    .spt-dr-name { font-size: 13px; }
  }
</style>

<section class="spt-section full-width">

  <!-- LEFT 60% -->
  <div class="spt-left">

    <!-- Cyan accent dot -->
    {% if section.settings.spt_show_dot %}
      <div class="spt-accent-dot"></div>
    {% endif %}

    <!-- Heading -->
    <h2 class="spt-heading">{{ section.settings.spt_heading }}</h2>

    <!-- Blog excerpt -->
    <div class="spt-excerpt-block">
      {% if section.settings.spt_blog != blank %}
        {%- assign spt_blog_obj = blogs[section.settings.spt_blog] -%}
        {%- assign spt_article  = spt_blog_obj.articles.first -%}
        {% if spt_article %}
          <p class="spt-excerpt-wrap">{{ spt_article.excerpt_or_content | strip_html }}</p>
          <a href="{{ spt_article.url }}" class="spt-read-more">read more...</a>
        {% else %}
          <p class="spt-excerpt-wrap">{{ section.settings.spt_fallback_excerpt }}</p>
          {% if section.settings.spt_fallback_link != blank %}
            <a href="{{ section.settings.spt_fallback_link }}" class="spt-read-more">read more...</a>
          {% endif %}
        {% endif %}
      {% else %}
        <p class="spt-excerpt-wrap">{{ section.settings.spt_fallback_excerpt }}</p>
        {% if section.settings.spt_fallback_link != blank %}
          <a href="{{ section.settings.spt_fallback_link }}" class="spt-read-more">read more...</a>
        {% endif %}
      {% endif %}
    </div>

    <!-- Bottom: thumbnails or info card -->
    <div class="spt-bottom">

      {% if section.settings.spt_bottom_type == 'thumbnails' %}
        <div class="spt-thumbs-container">
          <div class="spt-thumbs">
            {% for block in section.blocks %}
              {% if block.type == 'thumbnail' %}
                <div class="spt-thumb-wrap" {{ block.shopify_attributes }}>
                  {% if block.settings.spt_thumb_img != blank %}
                    <img
                      class="spt-thumb-img"
                      src="{{ block.settings.spt_thumb_img | image_url: width: 300 }}"
                      alt="{{ block.settings.spt_thumb_title | default: block.settings.spt_thumb_info }}"
                      width="{{ section.settings.spt_thumb_size }}"
                      height="{{ section.settings.spt_thumb_size }}"
                      loading="lazy"
                    >
                  {% else %}
                    <div style="width:100%;height:100%;background:#e0e0e0;border-radius:{{ section.settings.spt_thumb_radius }}px;"></div>
                  {% endif %}
                  <!-- Hover card lives INSIDE the thumb so it overlays its own container -->
                  <div class="spt-thumb-hover-card">
                    {% if block.settings.spt_thumb_title != blank %}
                      <p class="spt-hcard-title">{{ block.settings.spt_thumb_title }}</p>
                    {% endif %}
                    <p class="spt-hcard-text">{{ block.settings.spt_thumb_info }}</p>
                    {% if block.settings.spt_thumb_link != blank %}
                      <a href="{{ block.settings.spt_thumb_link }}" class="spt-hcard-link">read more...</a>
                    {% endif %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

      {% else %}
        <div class="spt-info-card">
          {% if section.settings.spt_info_title != blank %}
            <p class="spt-info-card-title">{{ section.settings.spt_info_title }}</p>
          {% endif %}
          <p class="spt-info-card-text">{{ section.settings.spt_info_text }}</p>
        </div>
      {% endif %}

    </div>
  </div>

  <!-- RIGHT 40% -->
  <div class="spt-right">
    <div class="spt-right-img-clip">
      {% if section.settings.spt_doctor_image != blank %}
        <img
          class="spt-doctor-img"
          src="{{ section.settings.spt_doctor_image | image_url: width: 1000 }}"
          alt="{{ section.settings.spt_dr_name }}"
          width="1000"
          height="1200"
          loading="lazy"
        >
      {% else %}
        <div class="spt-doctor-placeholder"></div>
      {% endif %}
    </div>

    <!-- Doctor frost glass card -->
    <div class="spt-doctor-card">
      <div class="spt-dr-card-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M12 2L4 5.5V11C4 15.55 7.41 19.74 12 21C16.59 19.74 20 15.55 20 11V5.5L12 2Z" stroke="#4fffff" stroke-width="2" stroke-linejoin="round" fill="none"/>
          <path d="M12 8V16M8 12H16" stroke="#4fffff" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="spt-dr-card-body">
        <p class="spt-dr-card-label">Expert Care You Can Trust</p>
        <p class="spt-dr-name">{{ section.settings.spt_dr_name }}</p>
        <p class="spt-dr-specialty">{{ section.settings.spt_dr_specialty }}</p>
        <p class="spt-dr-exp">{{ section.settings.spt_dr_experience }}</p>
      </div>
    </div>
  </div>

</section>

<script>
(function() {
  function initSptCards() {
    var isMobileOrTablet = window.innerWidth <= 1024;

    // ── Thumbnail hover cards ──
    var wraps = document.querySelectorAll('.spt-thumb-wrap');
    if (!wraps.length) return;

    wraps.forEach(function(wrap) {
      var card = wrap.querySelector('.spt-thumb-hover-card');
      if (!card) return;

      if (isMobileOrTablet) {
        // Touch: toggle card inside the thumbnail
        wrap.addEventListener('click', function(e) {
          e.stopPropagation();
          var isActive = card.classList.contains('spt-active');
          // Close all others
          document.querySelectorAll('.spt-thumb-hover-card.spt-active').forEach(function(c) {
            c.classList.remove('spt-active');
          });
          if (!isActive) card.classList.add('spt-active');
        });
      } else {
        // Desktop: hover shows card above thumbnail via CSS :hover
        // JS fallback for browsers that need it
        wrap.addEventListener('mouseenter', function() {
          document.querySelectorAll('.spt-thumb-hover-card.spt-active').forEach(function(c) {
            c.classList.remove('spt-active');
          });
          card.classList.add('spt-active');
        });
        wrap.addEventListener('mouseleave', function() {
          card.classList.remove('spt-active');
        });
      }
    });

    // Close on outside tap (mobile/tablet)
    if (isMobileOrTablet) {
      document.addEventListener('click', function() {
        document.querySelectorAll('.spt-thumb-hover-card.spt-active').forEach(function(c) {
          c.classList.remove('spt-active');
        });
      });
    }
  }

  // Works on first load AND after Shopify theme editor re-renders sections
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSptCards);
  } else {
    initSptCards();
  }

  // Shopify theme editor section re-render
  document.addEventListener('shopify:section:load', initSptCards);
})();
</script>

