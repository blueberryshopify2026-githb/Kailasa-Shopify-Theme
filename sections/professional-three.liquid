        { "value": "thumbnails", "label": "Thumbnail Images" },
        { "value": "info_card", "label": "Info Card" }
      ],
      "default": "thumbnails"
    },
    { "type": "range", "id": "spt_bottom_gap", "label": "Gap Above Bottom (px)", "min": 0, "max": 200, "step": 4, "default": 40 },

    { "type": "header", "content": "── Thumbnails" },
