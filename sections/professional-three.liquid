    { "type": "range", "id": "spt_dot_top", "label": "Dot Top (px)", "min": 0, "max": 300, "step": 4, "default": 120 },
    { "type": "range", "id": "spt_dot_right", "label": "Dot Right (px)", "min": 0, "max": 300, "step": 4, "default": 60 },

    { "type": "header", "content": "── Heading" },
