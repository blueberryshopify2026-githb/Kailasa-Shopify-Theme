    { "type": "color", "id": "spt_heading_color", "label": "Color", "default": "#000000" },
    { "type": "range", "id": "spt_heading_gap", "label": "Gap Below Heading (px)", "min": 0, "max": 60, "step": 2, "default": 20 },

