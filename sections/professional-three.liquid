    { "type": "color", "id": "spt_read_more_color", "label": "Read More Color", "default": "#4fffff" },

    { "type": "header", "content": "── Bottom Section" },
    {
      "type": "select", "id": "spt_bottom_type", "label": "Bottom Content Type",
