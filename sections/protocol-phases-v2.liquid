<script>
  document.addEventListener('DOMContentLoaded', function () {
    const phaseItems = document.querySelectorAll('.veetwo-protocol-phases-v2 .veetwo-phase-item');
    const contentPanels = document.querySelectorAll('.veetwo-protocol-phases-v2 .veetwo-phase-content-panel');
    const progressLine = document.getElementById('progress-line-v2');
    const section = document.getElementById('protocol-phases-v2');
    const scrollSpacer = document.querySelector('.veetwo-scroll-spacer');
    let currentPhase = 0;
    let isScrolling = false;

    console.log('Protocol Phases V2 initialized');
    console.log('Found phase items:', phaseItems.length);
    console.log('Found content panels:', contentPanels.length);

    function showPhase(index) {
      if (index === currentPhase) return; // Prevent unnecessary transitions

      console.log('Switching to phase:', index);

      // Update sidebar highlighting immediately without transitions
      phaseItems.forEach((item, i) => {
        if (i === index) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });

      // Instant content panel switching - no fade effects to prevent blinking
      contentPanels.forEach((panel, i) => {
        if (i === index) {
          panel.style.display = 'block';
          panel.style.opacity = '1';
          panel.classList.add('active');
        } else {
          panel.style.display = 'none';
          panel.style.opacity = '0';
          panel.classList.remove('active');
        }
      });

      // Update progress line smoothly
      const progress = ((index + 1) / phaseItems.length) * 100;
      if (progressLine) {
        progressLine.style.height = progress + '%';
      }

      currentPhase = index;
    }

    // Enhanced scroll handler with smooth phase detection
    function handleScroll() {
      // Skip scroll handling if we're in a click-triggered transition
      if (isScrolling) return;

      const scrollY = window.pageYOffset;
      const sectionRect = section.getBoundingClientRect();
      const spacerRect = scrollSpacer.getBoundingClientRect();

      // Check if we're in the protocol section area
      if (sectionRect.top <= 0 && spacerRect.bottom > window.innerHeight) {
        // Calculate scroll progress through the spacer
        const spacerTop = scrollY + spacerRect.top;
        const scrollPastSpacer = Math.max(0, scrollY - spacerTop + window.innerHeight);
        const spacerHeight = spacerRect.height;
        const scrollProgress = Math.min(1, scrollPastSpacer / spacerHeight);

        // Calculate target phase based on scroll progress
        const totalPhases = phaseItems.length;
        let targetPhase = Math.floor(scrollProgress * totalPhases);
        targetPhase = Math.max(0, Math.min(totalPhases - 1, targetPhase));

        // Smooth phase transition only if different from current
        if (targetPhase !== currentPhase) {
          showPhase(targetPhase);
        }

        console.log('Scroll progress:', scrollProgress.toFixed(2), 'Target phase:', targetPhase);
      }
    }

    // Click handlers for direct phase navigation
    phaseItems.forEach((item, index) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        console.log('Phase item clicked:', index);

        // Temporarily disable scroll handling to prevent interference
        isScrolling = false;

        // Direct phase switch without scroll animation
        showPhase(index);

        // Re-enable scroll handling after a short delay
        setTimeout(() => {
          isScrolling = false;
        }, 100);
      });
    });

    // Throttled scroll listener for smooth performance
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    });

    // Initialize first phase
    showPhase(0);

    // Ensure first phase is properly set up
    if (phaseItems.length > 0) {
      phaseItems[0].classList.add('active');
    }
    if (contentPanels.length > 0) {
      contentPanels[0].classList.add('active');
      contentPanels[0].style.display = 'block';
      contentPanels[0].style.opacity = '1';
    }

    console.log('Protocol Phases V2 fully initialized');
  });
</script>

