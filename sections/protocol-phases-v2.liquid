{% comment %}
  Protocol Phases V2 - Clean Implementation
  Matches reference image layout exactly
{% endcomment %}

<section class="protocol-phases-v2 full-width" id="protocol-phases-v2">
  <!-- Main Title -->
  <div class="protocol-header">
    <h1 class="protocol-title">
      <span class="title-black">{{ section.settings.title_black | default: 'THE 360° SKIN' }}</span>
      <span class="title-cyan-protocol-phases">{{ section.settings.title_cyan | default: 'LONGEVITY PROTOCOL' }}</span>
      <sup class="trademark">{{ section.settings.trademark | default: '™' }}</sup>
    </h1>
  </div>

  <div class="protocol-container">
    <!-- Left Sidebar -->
    <div class="phases-sidebar">
      <div class="sidebar-track">
        <div class="progress-line" id="progress-line-v2"></div>
      </div>

      {% for block in section.blocks %}
        {% if block.type == 'phase_item' %}
          <div class="phase-item" data-phase="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="phase-number">
              {{ block.settings.phase_number | default: forloop.index | prepend: '00' | slice: -3, 3 }}
            </div>
            <div class="phase-content">
              <h3 class="phase-title">{{ block.settings.phase_title | default: 'Phase Title' }}</h3>
              <p class="phase-subtitle">{{ block.settings.phase_subtitle | default: 'Phase Description' }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Right Content Area -->
    <div class="content-area-protocol-phases">
      {% for block in section.blocks %}
        {% if block.type == 'phase_item' %}
          <div class="phase-content-panel" data-phase="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {% if forloop.first %}
              <!-- Phase 1: Interactive Layout -->
              <div class="phase-one-layout">
                <!-- Top Section: Image and Content Side by Side -->
                <div class="phase-one-top">
                  <!-- Left: Main Image -->
                  <div class="phase-one-image">
                    {% if block.settings.main_image %}
                      <img
                        src="{{ block.settings.main_image | image_url: width: 400 }}"
                        alt="{{ block.settings.content_title }}"
                        width="400"
                        height="420"
                      >
                    {% else %}
                      <div class="image-placeholder-protocol-phases">
                        <span></span>
                      </div>
                    {% endif %}
                  </div>

                  <!-- Right: Content -->
                  <div class="phase-one-content">
                    <!-- Header -->
                    <div class="phase-header">
                      <span class="phase-label">{{ block.settings.phase_label | default: 'PHASE I' }}</span>
                      <h2 class="content-title-protocol-phases">
                        {{ block.settings.content_title | default: 'Internal Optimization' }}
                      </h2>
                      <span class="content-subtitle-protocol-phases">
                        {{- block.settings.content_subtitle | default: 'Cellular Longevity Layer' -}}
                      </span>
                    </div>

                    <!-- Features List -->
                    <div class="features-list">
                      <!-- Feature 1 - Always show -->
                      <div class="feature-item-protocol-phases">
                        <div class="feature-icon-protocol-phases">
                          {% if block.settings.feature_1_icon %}
                            <img
                              src="{{ block.settings.feature_1_icon | image_url: width: 40 }}"
                              alt="Feature 1"
                              width="40"
                              height="40"
                            >
                          {% else %}
                            <!-- Default icon placeholder -->
                            <div class="icon-placeholder-protocol-phases"></div>
                          {% endif %}
                        </div>
                        <div class="feature-text">
                          <h4>{{ block.settings.feature_1_title | default: 'Advanced Cellular Enhancement' }}</h4>
                          <p>
                            {{
                              block.settings.feature_1_desc
                              | default: 'Optimizes cellular function and regeneration processes for improved skin health.'
                            }}
                          </p>
                        </div>
                      </div>

                      <!-- Feature 2 - Always show -->
                      <div class="feature-item-protocol-phases">
                        <div class="feature-icon-protocol-phases">
                          {% if block.settings.feature_2_icon %}
                            <img
                              src="{{ block.settings.feature_2_icon | image_url: width: 40 }}"
                              alt="Feature 2"
                              width="40"
                              height="40"
                            >
                          {% else %}
                            <!-- Default icon placeholder -->
                            <div class="icon-placeholder-protocol-phases"></div>
                          {% endif %}
                        </div>
                        <div class="feature-text">
                          <h4>{{ block.settings.feature_2_title | default: 'Longevity Matrix Support' }}</h4>
                          <p>
                            {{
                              block.settings.feature_2_desc
                              | default: 'Strengthens the skin natural defense mechanisms and repair systems.'
                            }}
                          </p>
                        </div>
                      </div>

                      <!-- Feature 3 - Always show -->
                      <div class="feature-item-protocol-phases">
                        <div class="feature-icon-protocol-phases">
                          {% if block.settings.feature_3_icon %}
                            <img
                              src="{{ block.settings.feature_3_icon | image_url: width: 40 }}"
                              alt="Feature 3"
                              width="40"
                              height="40"
                            >
                          {% else %}
                            <!-- Default icon placeholder -->
                            <div class="icon-placeholder-protocol-phases"></div>
                          {% endif %}
                        </div>
                        <div class="feature-text">
                          <h4>{{ block.settings.feature_3_title | default: 'Metabolic Optimization' }}</h4>
                          <p>
                            {{
                              block.settings.feature_3_desc
                              | default: 'Enhances cellular metabolism for sustained energy and vitality.'
                            }}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Bottom Single Container -->
                <div class="bottom-single-container">
                  <div class="single-stats-box">
                    <div class="stat-highlight">
                      <span class="stat-number">{{ block.settings.stat_number | default: '+150%' }}</span>
                      <span class="stat-label">
                        {{- block.settings.stat_label | default: 'Increase in Cellular Vitality' -}}
                      </span>
                    </div>
                    <p class="stat-description">
                      {{
                        block.settings.stat_description
                        | default: 'Double-blind, placebo-controlled 4-week clinical study'
                      }}
                    </p>
                  </div>
                </div>
              </div>

            {% else %}
              <!-- Phases 2-6: Static Layout -->
              <div class="static-phase-layout">
                <div class="static-header">
                  <span class="phase-label">{{ block.settings.phase_label | default: 'PHASE II' }}</span>
                  <h2 class="content-title-protocol-phases">{{ block.settings.content_title | default: 'Phase Title' }}</h2>
                  <span class="content-subtitle-protocol-phases">
                    {{- block.settings.content_subtitle | default: 'Phase Subtitle' -}}
                  </span>
                </div>

                <div class="static-content">
                  {% if block.settings.main_image %}
                    <img
                      src="{{ block.settings.main_image | image_url: width: 1200 }}"
                      alt="{{ block.settings.content_title }}"
                      class="static-image"
                      width="1200"
                      height="400"
                    >
                  {% else %}
                    <div class="static-placeholder">
                      <span>Upload Phase {{ forloop.index }} Image</span>
                    </div>
                  {% endif %}

                  {% if block.settings.phase_description %}
                    <div class="static-description">
                      <p>{{ block.settings.phase_description }}</p>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- Scroll Spacer for smooth phase transitions -->
<div class="scroll-spacer" style="height: {{ section.blocks.size | times: 600 }}px;"></div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap');

  /* Smooth scrolling for the entire page */
  html {
    scroll-behavior: smooth;
  }

  body {
    overflow-x: hidden;
  }

  .protocol-phases-v2 {
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    font-family: 'Montserrat', sans-serif;
    position: sticky;
    top: 0;
    height: 100vh; /* Ensure section height is screen size only */
    min-height: 100vh; /* Minimum screen height */
    max-height: 100vh; /* Maximum screen height */
    overflow: hidden;
    padding: 0;
    margin: 0;
    width: 100%;
    z-index: 10;
  }

  /* Header */
  .protocol-header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin | default: 20 }}px;
    padding: 15px 20px 0 20px;
  }

  .protocol-title {
    font-size: {{ section.settings.title_size | default: 42 }}px;
    font-weight: {{ section.settings.title_weight | default: 700 }};
    margin: 0;
    line-height: 1.2;
  }

  .title-black {
    color: {{ section.settings.black_color | default: '#000000' }};
  }

  .title-cyan-protocol-phases {
    color: {{ section.settings.cyan_color | default: '#00ffff' }};
  }

  .trademark {
    font-size: 0.6em;
    color: {{ section.settings.black_color | default: '#000000' }};
  }

  /* Main Container */
  .protocol-container {
    display: flex;
    max-width: none; /* Full width container */
    margin: 0;
    padding: 0 20px; /* Minimal side padding */
    gap: {{ section.settings.container_gap | default: 20 }}px;
    height: calc(100vh - 80px); /* Account for header */
    width: 100%;
   
  }

  /* Left Sidebar */
  .phases-sidebar {
    flex: 0 0 {{ section.settings.sidebar_width | default: 320 }}px;
    position: relative;
    height: 100%;
    padding: 40px 10px 40px 5px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: {{ section.settings.bg_color | default: '#ffffff' }};
  }

  .sidebar-track {
    position: absolute;
    left: {{ section.settings.track_position | default: 30 }}px;
    top: {{ section.settings.track_top | default: 35 }}px;
    bottom: {{ section.settings.track_bottom | default: 35 }}px;
    width: {{ section.settings.track_width | default: 2 }}px;
    background: {{ section.settings.track_color | default: '#e0e0e0' }};
    z-index: 0; /* Behind everything */
  }

  .progress-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background: {{ section.settings.progress_color | default: '#00ffff' }};
    transition: height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0; /* Behind everything */
  }

  .phase-item {
    display: flex;
    align-items: center;
    margin-bottom: {{ section.settings.phase_spacing | default: 15 }}px; /* Increased spacing */
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    padding: {{ section.settings.phase_item_padding | default: 15 }}px; /* Bigger hover box */
    border-radius: {{ section.settings.phase_item_radius | default: 12 }}px;
    position: relative;
    z-index: 5; /* Above progress line */
  }

  .phase-item:hover,
  .phase-item.active {
    background: {{ section.settings.active_phase_bg | default: '#e0f7ff' }};
    border-radius: {{ section.settings.phase_item_radius | default: 12 }}px;
    /* Removed transform to prevent movement */
  }

  .phase-item.active {
    background: {{ section.settings.active_phase_bg_strong | default: '#e0f7ff' }};
  }

  .phase-number {
    width: {{ section.settings.number_size | default: 50 }}px;
    height: {{ section.settings.number_size | default: 50 }}px;
    border-radius: 50%;
    background: {{ section.settings.number_bg | default: '#ffffff' }};
    color: {{ section.settings.number_color | default: '#666666' }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.number_font_size | default: 16 }}px;
    font-weight: 600;
    margin-right: {{ section.settings.number_margin | default: 15 }}px;
    transition: all 0.4s cubic-bezer(0.4, 0, 0.2, 1);
    position: relative;
    z-index: 10; /* Above everything */
    box-shadow: 0 0 0 3px {{ section.settings.number_bg | default: '#ffffff' }}; /* White border to cover line */
  }

  .phase-item.active .phase-number {
    background: {{ section.settings.active_number_bg | default: '#00ffff' }};
    color: {{ section.settings.active_number_color | default: '#000000' }};
    box-shadow: 0 0 0 3px {{ section.settings.bg_color | default: '#ffffff' }}; /* White border to cover line */
  }

  /* Make first phase active by default */
  .phase-item:first-of-type {
    background: {{ section.settings.active_phase_bg_strong | default: '#e0f7ff' }};
    padding: {{ section.settings.phase_item_padding | default: 15 }}px;
    border-radius: {{ section.settings.phase_item_radius | default: 12 }}px;
    /* Removed transform to prevent movement */
  }

  .phase-item:first-of-type .phase-number {
    background: {{ section.settings.active_number_bg | default: '#00ffff' }};
    color: {{ section.settings.active_number_color | default: '#000000' }};
    box-shadow: 0 0 0 3px {{ section.settings.bg_color | default: '#ffffff' }}; /* White border to cover line */
  }

  .phase-content h3 {
    font-size: {{ section.settings.phase_title_size | default: 18 }}px; /* Bigger font */
    font-weight: 600;
    color: {{ section.settings.phase_title_color | default: '#000000' }};
    margin: 0 0 3px 0;
    line-height: 1.6;
  }

  .phase-content p {
    font-size: {{ section.settings.phase_subtitle_size | default: 14 }}px; /* Bigger font */
    color: {{ section.settings.phase_subtitle_color | default: '#666666' }};
    margin: 0;
    line-height: 1.6;
  }

  /* Right Content Area */
  .content-area-protocol-phases {
    flex: 1;
    position: relative;
    overflow: hidden;
    padding: 0;
    height: 100%;
  }

  .phase-content-panel {
    display: none;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
    height: 100%; /* Use 100% instead of 100vh to work with parent container */
    width: 100%;
    padding: 0;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
  }

  .phase-content-panel.active {
    display: block;
    opacity: 1;
    position: relative; /* Keep relative positioning for active panel */
  }

  /* Show first panel by default */
  .phase-content-panel:first-child {
    display: block;
    opacity: 1;
    position: relative;
  }

  /* Phase 1 Layout */
  .phase-one-layout {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.phase_one_gap | default: 15 }}px;
    height: 100%; /* Take full available height */
    justify-content: center; /* Center content vertically */
    padding: 10px; /* 10px padding from all sides */
  }

  /* Top Section: Image and Content Side by Side */
  .phase-one-top {
    display: flex;
    gap: 20px; /* 20px gap as requested */
    align-items: flex-start; /* Changed back to flex-start for proper alignment */
    flex: 1;
    height: 100%;
  }

  .phase-one-image {
    flex: 0 0 {{ section.settings.image_width_percent | default: 40 }}%; /* Reduced from 40% to 35% */
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .phase-one-image img {
    width: {{ section.settings.image_width | default: 460 }}px; /* Reduced width */
    height: {{ section.settings.image_height | default: 400 }}px;
    object-fit: cover;
    border-radius: {{ section.settings.image_radius | default: 15 }}px;
     
  }

  .image-placeholder-protocol-phases {
    width: {{ section.settings.image_width | default: 360 }}px; /* Match reduced image width */
    height: {{ section.settings.image_height | default: 400 }}px;
    border: 2px dashed {{ section.settings.placeholder_border | default: '#cccccc' }};
    border-radius: {{ section.settings.image_radius | default: 15 }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.placeholder_bg | default: '#f9f9f9' }};
    color: {{ section.settings.placeholder_text_color | default: '#666666' }};
    font-size: {{ section.settings.placeholder_text_size | default: 14 }}px;
    
  }
  .phase-one-content {
    flex: 1; /* Take remaining space */
    display: flex;
    flex-direction: column;
    justify-content: space-between; /* Distribute content to show bottom box */
    height: auto;
    padding: 10px;
    margin-right: 20px; /* Add right margin to prevent content going too far right */
    max-width: calc(65% - 40px); /* Ensure content doesn't overflow (35% image + 20px gap + margins) */
   padding: 10px; /* 10px padding from all sides as requested */
   }
  

  /* Phase Header */
  .phase-header {
    text-align: left;
  }

  .phase-label {
    font-size: {{ section.settings.label_size | default: 12 }}px;
    color: {{ section.settings.label_color | default: '#666666' }};
    font-weight: 500;
    display: block;
    margin-bottom: 5px;
  }

  .content-title-protocol-phases {
    font-size: {{ section.settings.content_title_size | default: 28 }}px;
    font-weight: {{ section.settings.content_title_weight | default: 700 }};
    color: {{ section.settings.content_title_color | default: '#000000' }};
    margin: 0 0 8px 0;
    line-height: 1.1;
  }

  .content-subtitle-protocol-phases {
    font-size: {{ section.settings.content_subtitle_size | default: 14 }}px;
    color: {{ section.settings.content_subtitle_color | default: '#00ffff' }};
    font-weight: 500;
  }

  /* Features List */
  .features-list {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.feature_gap | default: 15 }}px; /* Reduced gap to fit content better */
    margin: 10px 0;
  }

  .feature-item-protocol-phases {
    display: flex;
    align-items: flex-start;
    gap: {{ section.settings.feature_icon_gap | default: 15 }}px; /* Reduced gap */
    padding: {{ section.settings.feature_item_padding | default: 14 }}px; /* Updated to match schema */
    background: {{ section.settings.feature_item_bg | default: 'transparent' }};
    border-radius: {{ section.settings.feature_item_radius | default: 8 }}px;
  }

  .feature-icon-protocol-phases {
    flex-shrink: 0;
    width: {{ section.settings.feature_icon_size | default: 45 }}px;
    height: {{ section.settings.feature_icon_size | default: 45 }}px;
    border-radius: 50%;
    background: {{ section.settings.icon_bg | default: '#f0f8ff' }}; /* Removed cyan color */
    display: flex;
    align-items: center;
    justify-content: center;
    
  }

  .feature-icon-protocol-phases img {
    width: {{ section.settings.feature_icon_img_size | default: 40 }}px; /* Reduced size */
    height: {{ section.settings.feature_icon_img_size | default: 40 }}px; /* Reduced size */
    object-fit: cover;
  
  }

  /* Remove icon placeholder (numbers) completely */
  .icon-placeholder-protocol-phases {
    display: none; /* Hide the numbered placeholders */
  }

  .feature-text h4 {
    font-size: {{ section.settings.feature_title_size | default: 18 }}px; /* Set to 18px as requested */
    font-weight: 600;
    color: {{ section.settings.feature_title_color | default: '#000000' }};
    margin: 0 0 6px 0;
    line-height: 1.2;
  }

  .feature-text p {
    font-size: {{ section.settings.feature_desc_size | default: 14 }}px; /* Set to 14px as requested */
    color: {{ section.settings.feature_desc_color | default: '#000000' }};
    margin: 0;
    line-height: 2;
  }

  /* Bottom Single Container */
  .bottom-single-container {
    display: flex;
    justify-content: center;
    margin-top: 10px; /* Increased margin to make it more visible */
    width: 100%;
  }

  .single-stats-box {
    background: {{ section.settings.stats_bg | default: '#f8f8f8' }};
    padding: {{ section.settings.stats_padding | default: 15 }}px; /* Reduced padding to fit better */
    border-radius: {{ section.settings.stats_radius | default: 8 }}px;
    min-height: 70px; /* Reduced height to fit in viewport */
    text-align: center;
    width: 100%;
  }

  .single-stats-box .stat-number {
    font-size: {{ section.settings.stat_number_size | default: 48 }}px; /* Increased font size */
    font-weight: 700;
    color: {{ section.settings.stat_number_color | default: '#00ffff' }};
    display: block;
    line-height: 1;
  }

  .single-stats-box .stat-label {
    font-size: {{ section.settings.stat_label_size | default: 18 }}px; /* Increased font size */
    color: {{ section.settings.stat_label_color | default: '#000000' }};
    font-weight: 500;
    line-height: 1.2;
  }

  .single-stats-box .stat-description {
    font-size: {{ section.settings.stat_desc_size | default: 18}}px; /* Increased font size */
    color: {{ section.settings.stat_desc_color | default: '#666666' }};
    margin: 8px 0 0 0;
    line-height: 1.4;
  }

  /* Static Phases Layout */
  .static-phase-layout {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    height: 100%; /* Use 100% instead of 100vh */
    text-align: center;
    gap: {{ section.settings.static_gap | default: 15 }}px;
    padding: 10px;
    overflow: hidden;
  }

  .static-header {
    margin-bottom: {{ section.settings.static_header_margin | default: 15 }}px;
  }

  .static-content {
    display: flex;
    flex-direction: column;
    align-items: stretch; /* Changed from center to stretch */
    gap: {{ section.settings.static_content_gap | default: 15 }}px;
  }

  .static-image {
    width: 100%; /* Use full available width */
    height: {{ section.settings.static_image_height | default: 400 }}px; /* Fixed height */
    object-fit: cover;
    border-radius: {{ section.settings.image_radius | default: 15 }}px;
  }

  .static-placeholder {
    width: 100%; /* Use full available width */
    height: {{ section.settings.static_image_height | default: 400 }}px; /* Fixed height */
    border: 2px dashed {{ section.settings.placeholder_border | default: '#cccccc' }};
    border-radius: {{ section.settings.image_radius | default: 15 }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.placeholder_bg | default: '#f9f9f9' }};
    color: {{ section.settings.placeholder_text_color | default: '#666666' }};
    font-size: {{ section.settings.placeholder_text_size | default: 14 }}px;
  }

  .static-description {
    background: {{ section.settings.description_bg | default: '#f8f8f8' }};
    padding: {{ section.settings.description_padding | default: 20 }}px;
    border-radius: {{ section.settings.description_radius | default: 10 }}px;
    width: 100%; /* Use full available width to match image */
    box-sizing: border-box; /* Include padding in width calculation */
  }

  .static-description p {
    font-size: {{ section.settings.description_text_size | default: 14 }}px;
    color: {{ section.settings.description_text_color | default: '#333333' }};
    margin: 0;
    line-height: 1.5;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .protocol-container {
      flex-direction: column;
      gap: {{ section.settings.mobile_gap | default: 20 }}px;
    }

    .phases-sidebar {
      flex: none;
      display: flex;
      flex-direction: row;
      overflow-x: auto;
      padding-bottom: 10px;
    }

    .sidebar-track {
      display: none;
    }

    .phase-item {
      flex-shrink: 0;
      margin-right: 15px;
      margin-bottom: 0;
    }

    .phase-one-layout {
      flex-direction: column;
      gap: {{ section.settings.mobile_content_gap | default: 15 }}px;
    }

    .phase-one-image {
      flex: none;
      order: -1;
    }

    .protocol-title {
      font-size: {{ section.settings.mobile_title_size | default: 28 }}px;
    }

    .content-title-protocol-phases {
      font-size: {{ section.settings.mobile_content_title | default: 24 }}px;
    }

    /* Mobile adjustments for static images */
    .static-image,
    .static-placeholder {
      width: 100%;
      max-width: 90vw;
      height: auto;
      min-height: 250px;
    }

    .static-description {
      width: 100%;
      max-width: 90vw;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const phaseItems = document.querySelectorAll('.protocol-phases-v2 .phase-item');
    const contentPanels = document.querySelectorAll('.protocol-phases-v2 .phase-content-panel');
    const progressLine = document.getElementById('progress-line-v2');
    const section = document.getElementById('protocol-phases-v2');
    const scrollSpacer = document.querySelector('.scroll-spacer');
    let currentPhase = 0;
    let isScrolling = false;

    console.log('Protocol Phases V2 initialized');
    console.log('Found phase items:', phaseItems.length);
    console.log('Found content panels:', contentPanels.length);

    function showPhase(index) {
      if (index === currentPhase && !isScrolling) return;

      console.log('Switching to phase:', index);

      // Update sidebar highlighting with smooth transitions
      phaseItems.forEach((item, i) => {
        if (i === index) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });

      // Improved content panel transition to prevent flash
      contentPanels.forEach((panel, i) => {
        if (i === index) {
          // Show new panel immediately but transparent
          panel.style.display = 'block';
          panel.style.opacity = '0';
          panel.classList.add('active');

          // Force reflow then fade in
          requestAnimationFrame(() => {
            panel.style.opacity = '1';
          });
        } else {
          // Fade out then hide
          panel.style.opacity = '0';
          panel.classList.remove('active');

          // Hide after transition completes
          setTimeout(() => {
            if (!panel.classList.contains('active')) {
              panel.style.display = 'none';
            }
          }, 300);
        }
      });

      // Update progress line smoothly
      const progress = ((index + 1) / phaseItems.length) * 100;
      if (progressLine) {
        progressLine.style.height = progress + '%';
      }

      currentPhase = index;
    }

    // Enhanced scroll handler with smooth phase detection
    function handleScroll() {
      const scrollY = window.pageYOffset;
      const sectionRect = section.getBoundingClientRect();
      const spacerRect = scrollSpacer.getBoundingClientRect();

      // Check if we're in the protocol section area
      if (sectionRect.top <= 0 && spacerRect.bottom > window.innerHeight) {
        isScrolling = true;

        // Calculate scroll progress through the spacer
        const spacerTop = scrollY + spacerRect.top;
        const scrollPastSpacer = Math.max(0, scrollY - spacerTop + window.innerHeight);
        const spacerHeight = spacerRect.height;
        const scrollProgress = Math.min(1, scrollPastSpacer / spacerHeight);

        // Calculate target phase based on scroll progress
        const totalPhases = phaseItems.length;
        let targetPhase = Math.floor(scrollProgress * totalPhases);
        targetPhase = Math.max(0, Math.min(totalPhases - 1, targetPhase));

        // Smooth phase transition
        if (targetPhase !== currentPhase) {
          showPhase(targetPhase);
        }

        console.log('Scroll progress:', scrollProgress.toFixed(2), 'Target phase:', targetPhase);
      } else {
        isScrolling = false;
      }
    }

    // Click handlers for direct phase navigation
    phaseItems.forEach((item, index) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        showPhase(index);

        // Scroll to appropriate position for this phase
        const spacerRect = scrollSpacer.getBoundingClientRect();
        const spacerTop = window.pageYOffset + spacerRect.top;
        const targetScroll = spacerTop + (index / phaseItems.length) * spacerRect.height - window.innerHeight;

        window.scrollTo({
          top: Math.max(0, targetScroll),
          behavior: 'smooth',
        });
      });
    });

    // Throttled scroll listener for smooth performance
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          handleScroll();
          ticking = false;
        });
        ticking = true;
      }
    });

    // Initialize first phase
    showPhase(0);

    // Ensure first phase is properly set up
    if (phaseItems.length > 0) {
      phaseItems[0].classList.add('active');
    }
    if (contentPanels.length > 0) {
      contentPanels[0].classList.add('active');
      contentPanels[0].style.display = 'block';
      contentPanels[0].style.opacity = '1';
    }

    console.log('Protocol Phases V2 fully initialized');
  });
</script>

