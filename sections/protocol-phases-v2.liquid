{% comment %}
  Protocol Phases V2 - Clean Implementation
  Matches reference image layout exactly
{% endcomment %}

<section class="veetwo-protocol-phases-v2 full-width" id="protocol-phases-v2">
  <!-- Main Title -->
  <div class="veetwo-protocol-header">
    <h1 class="veetwo-protocol-title">
      <span class="veetwo-title-black">{{ section.settings.title_black | default: 'THE 360° SKIN' }}</span>
      <span class="veetwo-title-cyan-protocol-phases">{{ section.settings.title_cyan | default: 'LONGEVITY PROTOCOL' }}</span>
      <sup class="veetwo-trademark">{{ section.settings.trademark | default: '™' }}</sup>
    </h1>
  </div>

  <div class="veetwo-protocol-container">
    <!-- Left Sidebar -->
    <div class="veetwo-phases-sidebar">
      <div class="veetwo-sidebar-track">
        <div class="veetwo-progress-line" id="progress-line-v2"></div>
      </div>

      {% for block in section.blocks %}
        <div class="veetwo-phase-item" data-phase="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="veetwo-phase-number">
            {{ block.settings.phase_number | default: forloop.index | prepend: '00' | slice: -3, 3 }}
          </div>
          <div class="veetwo-phase-content">
            <h3 class="veetwo-phase-title">{{ block.settings.phase_title | default: 'Phase Title' }}</h3>
            <p class="veetwo-phase-subtitle">{{ block.settings.phase_subtitle | default: 'Phase Description' }}</p>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Right Content Area -->
    <div class="veetwo-content-area-protocol-phases">
      {% for block in section.blocks %}
        <div class="veetwo-phase-content-panel" data-phase="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          {% if block.type == 'phase_1' %}
            <!-- Phase 1: Interactive Layout -->
            <div class="veetwo-phase-one-layout">
              <!-- Top Section: Image and Content Side by Side -->
              <div class="veetwo-phase-one-top">
                <!-- Left: Main Image -->
                <div class="veetwo-phase-one-image">
                  {% if block.settings.main_image %}
                    <img
                      src="{{ block.settings.main_image | image_url: width: 400 }}"
                      alt="{{ block.settings.content_title }}"
                      width="400"
                      height="420"
                    >
                  {% else %}
                    <div class="veetwo-image-placeholder-protocol-phases">
                      <span></span>
                    </div>
                  {% endif %}
                </div>

                <!-- Right: Content -->
                <div class="veetwo-phase-one-content">
                  <!-- Header -->
                  <div class="veetwo-phase-header">
                    <span class="veetwo-phase-label">{{ block.settings.phase_label | default: 'PHASE I' }}</span>
                    <h2 class="veetwo-content-title-protocol-phases">
                      {{ block.settings.content_title | default: 'Internal Optimization' }}
                    </h2>
                    <span class="veetwo-content-subtitle-protocol-phases">
                      {{- block.settings.content_subtitle | default: 'Cellular Longevity Layer' -}}
                    </span>
                  </div>

                  <!-- Features List -->
                  <div class="veetwo-features-list">
                    <!-- Feature 1 - Always show -->
                    <div class="veetwo-feature-item-protocol-phases">
                      <div class="veetwo-feature-icon-protocol-phases">
                        {% if block.settings.feature_1_icon %}
                          <img
                            src="{{ block.settings.feature_1_icon | image_url: width: 40 }}"
                            alt="Feature 1"
                            width="40"
                            height="40"
                          >
                        {% else %}
                          <!-- Default icon placeholder -->
                          <div class="veetwo-icon-placeholder-protocol-phases"></div>
                        {% endif %}
                      </div>
                      <div class="veetwo-feature-text">
                        <h4>{{ block.settings.feature_1_title | default: 'Advanced Cellular Enhancement' }}</h4>
                        <p>
                          {{
                            block.settings.feature_1_desc
                            | default: 'Optimizes cellular function and regeneration processes for improved skin health.'
                          }}
                        </p>
                      </div>
                    </div>

                    <!-- Feature 2 - Always show -->
                    <div class="veetwo-feature-item-protocol-phases">
                      <div class="veetwo-feature-icon-protocol-phases">
                        {% if block.settings.feature_2_icon %}
                          <img
                            src="{{ block.settings.feature_2_icon | image_url: width: 40 }}"
                            alt="Feature 2"
                            width="40"
                            height="40"
                          >
                        {% else %}
                          <!-- Default icon placeholder -->
                          <div class="veetwo-icon-placeholder-protocol-phases"></div>
                        {% endif %}
                      </div>
                      <div class="veetwo-feature-text">
                        <h4>{{ block.settings.feature_2_title | default: 'Longevity Matrix Support' }}</h4>
                        <p>
                          {{
                            block.settings.feature_2_desc
                            | default: 'Strengthens the skin natural defense mechanisms and repair systems.'
                          }}
                        </p>
                      </div>
                    </div>

                    <!-- Feature 3 - Always show -->
                    <div class="veetwo-feature-item-protocol-phases">
                      <div class="veetwo-feature-icon-protocol-phases">
                        {% if block.settings.feature_3_icon %}
                          <img
                            src="{{ block.settings.feature_3_icon | image_url: width: 40 }}"
                            alt="Feature 3"
                            width="40"
                            height="40"
                          >
                        {% else %}
                          <!-- Default icon placeholder -->
                          <div class="veetwo-icon-placeholder-protocol-phases"></div>
                        {% endif %}
                      </div>
                      <div class="veetwo-feature-text">
                        <h4>{{ block.settings.feature_3_title | default: 'Metabolic Optimization' }}</h4>
                        <p>
                          {{
                            block.settings.feature_3_desc
                            | default: 'Enhances cellular metabolism for sustained energy and vitality.'
                          }}
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Bottom Single Container -->
              <div class="veetwo-bottom-single-container">
                <div class="veetwo-single-stats-box">
                  <div class="veetwo-stat-highlight">
                    <span class="veetwo-stat-number">{{ block.settings.stat_number | default: '+150%' }}</span>
                    <span class="veetwo-stat-label">
                      {{- block.settings.stat_label | default: 'Increase in Cellular Vitality' -}}
                    </span>
                  </div>
                  <p class="veetwo-stat-description">
                    {{
                      block.settings.stat_description
                      | default: 'Double-blind, placebo-controlled 4-week clinical study'
                    }}
                  </p>
                </div>
              </div>
            </div>

          {% elsif block.type == 'phase_2' %}
            <!-- Phase 2: Three Pillar Architecture Layout -->
            <div class="veetwo-phase-two-layout">
              <div class="veetwo-phase-two-header">
                <span class="veetwo-phase-label">{{ block.settings.phase_label | default: 'PHASE II' }}</span>
                <h2 class="veetwo-content-title-protocol-phases">
                  {{ block.settings.content_title | default: 'Barrier Reconstitution' }}
                </h2>
                <span class="veetwo-content-subtitle-protocol-phases">
                  {{- block.settings.content_subtitle | default: 'Protective Layer Repair' -}}
                </span>
              </div>

              <div class="veetwo-three-pillar-section">
                <h3 class="veetwo-pillar-title">THE THREE PILLAR ARCHITECTURE</h3>

                <div class="veetwo-pillar-boxes">
                  <!-- LED MASK Box -->
                  <div class="veetwo-pillar-box">
                    <div class="veetwo-pillar-box-header">
                      <h4>LED MASK</h4>
                      <p>Circular stimulation</p>
                    </div>
                    <div class="veetwo-pillar-box-image">
                      {% if block.settings.pillar_1_image %}
                        <img
                          src="{{ block.settings.pillar_1_image | image_url: width: 300 }}"
                          alt="LED Mask"
                          width="300"
                          height="200"
                        >
                      {% else %}
                        <div class="veetwo-pillar-placeholder">
                          <span>LED Mask Image</span>
                        </div>
                      {% endif %}
                    </div>
                    <div class="veetwo-pillar-box-features">
                      <ul>
                        <li>{{ block.settings.pillar_1_feature_1 | default: 'Collagen stimulation' }}</li>
                        <li>{{ block.settings.pillar_1_feature_2 | default: 'Microcirculation' }}</li>
                        <li>{{ block.settings.pillar_1_feature_3 | default: 'Firmness boost' }}</li>
                      </ul>
                    </div>
                  </div>

                  <!-- SUPPLEMENTS Box -->
                  <div class="veetwo-pillar-box">
                    <div class="veetwo-pillar-box-header">
                      <h4>SUPPLEMENTS</h4>
                      <p>Internal Optimization</p>
                    </div>
                    <div class="veetwo-pillar-box-image">
                      {% if block.settings.pillar_2_image %}
                        <img
                          src="{{ block.settings.pillar_2_image | image_url: width: 300 }}"
                          alt="Supplements"
                          width="300"
                          height="200"
                        >
                      {% else %}
                        <div class="veetwo-pillar-placeholder">
                          <span>Supplements Image</span>
                        </div>
                      {% endif %}
                    </div>
                    <div class="veetwo-pillar-box-features">
                      <ul>
                        <li>{{ block.settings.pillar_2_feature_1 | default: 'Collagen stimulation' }}</li>
                        <li>{{ block.settings.pillar_2_feature_2 | default: 'Microcirculation' }}</li>
                        <li>{{ block.settings.pillar_2_feature_3 | default: 'Firmness boost' }}</li>
                      </ul>
                    </div>
                  </div>

                  <!-- PRODUCTS Box -->
                  <div class="veetwo-pillar-box">
                    <div class="veetwo-pillar-box-header">
                      <h4>PRODUCTS</h4>
                      <p>Internal Optimization</p>
                    </div>
                    <div class="veetwo-pillar-box-image">
                      {% if block.settings.pillar_3_image %}
                        <img
                          src="{{ block.settings.pillar_3_image | image_url: width: 300 }}"
                          alt="Products"
                          width="300"
                          height="200"
                        >
                      {% else %}
                        <div class="veetwo-pillar-placeholder">
                          <span>Products Image</span>
                        </div>
                      {% endif %}
                    </div>
                    <div class="veetwo-pillar-box-features">
                      <ul>
                        <li>{{ block.settings.pillar_3_feature_1 | default: 'Collagen stimulation' }}</li>
                        <li>{{ block.settings.pillar_3_feature_2 | default: 'Microcirculation' }}</li>
                        <li>{{ block.settings.pillar_3_feature_3 | default: 'Firmness boost' }}</li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Bottom Description -->
              <div class="veetwo-phase-two-bottom">
                <p>
                  {{
                    block.settings.bottom_description
                    | default: 'Buy Kits & Combos Online: Explore a range of skincare & haircare kits & combos products from top brands at Nykaa with best offers. Easy returns policy. Buy Kits & Combos Online. Explore a range of skincare & haircare kits & combos products from top brands at Nykaa with'
                  }}
                </p>
              </div>
            </div>

          {% elsif block.type == 'phase_6' %}
            <!-- Phase 6: Special Layout with Two Images and CTA -->
            <div class="veetwo-phase-six-layout">
              <div class="veetwo-phase-six-header">
                <span class="veetwo-phase-label">{{ block.settings.phase_label | default: 'PHASE VI' }}</span>
                <h2 class="veetwo-content-title-protocol-phases">
                  {{ block.settings.content_title | default: 'Matrix Stabilization' }}
                </h2>
                <span class="veetwo-content-subtitle-protocol-phases">
                  {{- block.settings.content_subtitle | default: 'Structural Reinforcement' -}}
                </span>
              </div>

              <div class="veetwo-phase-six-images">
                <div class="veetwo-phase-six-image-container">
                  {% if block.settings.image_1 %}
                    <img
                      src="{{ block.settings.image_1 | image_url: width: 600 }}"
                      alt="{{ block.settings.image_1_alt | default: 'Phase VI Image 1' }}"
                      width="600"
                      height="300"
                    >
                  {% else %}
                    <div class="veetwo-phase-six-placeholder">
                      <span>Upload Phase VI Image 1</span>
                    </div>
                  {% endif %}
                </div>
                
                <div class="veetwo-phase-six-image-container">
                  {% if block.settings.image_2 %}
                    <img
                      src="{{ block.settings.image_2 | image_url: width: 600 }}"
                      alt="{{ block.settings.image_2_alt | default: 'Phase VI Image 2' }}"
                      width="600"
                      height="300"
                    >
                  {% else %}
                    <div class="veetwo-phase-six-placeholder">
                      <span>Upload Phase VI Image 2</span>
                    </div>
                  {% endif %}
                </div>
              </div>

              <div class="veetwo-phase-six-cta">
                {% if block.settings.cta_text %}
                  <a href="{{ block.settings.cta_link | default: '#' }}" class="veetwo-phase-six-button">
                    {{ block.settings.cta_text | default: 'Start Your 90 Days Journey' }}
                  </a>
                {% endif %}
              </div>
            </div>

          {% else %}
            <!-- Phases 3-5: Static Layout -->
            <div class="veetwo-static-phase-layout">
              <div class="veetwo-static-header">
                <span class="veetwo-phase-label">{{ block.settings.phase_label | default: 'PHASE III' }}</span>
                <h2 class="veetwo-content-title-protocol-phases">
                  {{ block.settings.content_title | default: 'Phase Title' }}
                </h2>
                <span class="veetwo-content-subtitle-protocol-phases">
                  {{- block.settings.content_subtitle | default: 'Phase Subtitle' -}}
                </span>
              </div>

              <div class="veetwo-static-content">
                {% if block.settings.main_image %}
                  <img
                    src="{{ block.settings.main_image | image_url: width: 1200 }}"
                    alt="{{ block.settings.content_title }}"
                    class="veetwo-static-image"
                    width="1200"
                    height="400"
                  >
                {% else %}
                  <div class="veetwo-static-placeholder">
                    <span>Upload {{ block.settings.phase_label }} Image</span>
                  </div>
                {% endif %}

                {% if block.settings.phase_description %}
                  <div class="veetwo-static-description">
                    <p>{{ block.settings.phase_description }}</p>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Scroll Spacer for smooth phase transitions -->
<div class="veetwo-scroll-spacer" style="height: {{ section.blocks.size | times: 600 }}px;"></div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap');

  /* Smooth scrolling for the entire page */
  html {
    scroll-behavior: smooth;
  }

  body {
    overflow-x: hidden;
  }

  .veetwo-protocol-phases-v2 {
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    font-family: 'Montserrat', sans-serif;
    position: sticky;
    top: 0;
    height: 100vh; /* Ensure section height is screen size only */
    min-height: 100vh; /* Minimum screen height */
    max-height: 100vh; /* Maximum screen height */
    overflow: hidden;
    padding: 0;
    margin: 0;
    width: 100%;
    z-index: 10;
  }

  /* Header */
  .veetwo-protocol-header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin | default: 20 }}px;
    padding: 15px 20px 0 20px;
  }

  .veetwo-protocol-title {
    font-size: {{ section.settings.title_size | default: 42 }}px;
    font-weight: {{ section.settings.title_weight | default: 700 }};
    margin: 0;
    line-height: 1.2;
  }

  .veetwo-title-black {
    color: {{ section.settings.black_color | default: '#000000' }};
  }

  .veetwo-title-cyan-protocol-phases {
    color: {{ section.settings.cyan_color | default: '#00ffff' }};
  }

  .veetwo-trademark {
    font-size: 0.6em;
    color: {{ section.settings.black_color | default: '#000000' }};
  }

  /* Main Container */
  .veetwo-protocol-container {
    display: flex;
    max-width: none; /* Full width container */
    margin: 0;
    padding: 0 20px; /* Minimal side padding */
    gap: {{ section.settings.container_gap | default: 20 }}px;
    height: calc(100vh - 80px); /* Account for header */
    width: 100%;

  }

  /* Left Sidebar */
  .veetwo-phases-sidebar {
    flex: 0 0 {{ section.settings.sidebar_width | default: 320 }}px;
    position: relative;
    height: 100%;
    padding: 40px 10px 40px 5px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: {{ section.settings.bg_color | default: '#ffffff' }};
  }

  .veetwo-sidebar-track {
    position: absolute;
    left: {{ section.settings.track_position | default: 30 }}px;
    top: {{ section.settings.track_top | default: 35 }}px;
    bottom: {{ section.settings.track_bottom | default: 35 }}px;
    width: {{ section.settings.track_width | default: 2 }}px;
    background: {{ section.settings.track_color | default: '#e0e0e0' }};
    z-index: 0; /* Behind everything */
  }

  .veetwo-progress-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background: {{ section.settings.progress_color | default: '#00ffff' }};
    transition: height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0; /* Behind everything */
  }

  .veetwo-phase-item {
    display: flex;
    align-items: center;
    margin-bottom: {{ section.settings.phase_spacing | default: 15 }}px; /* Increased spacing */
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    padding: {{ section.settings.phase_item_padding | default: 15 }}px; /* Bigger hover box */
    border-radius: {{ section.settings.phase_item_radius | default: 12 }}px;
    position: relative;
    z-index: 5; /* Above progress line */
  }

  .veetwo-phase-item:hover,
  .veetwo-phase-item.active {
    background: {{ section.settings.active_phase_bg | default: '#e0f7ff' }};
    border-radius: {{ section.settings.phase_item_radius | default: 12 }}px;
    /* Removed transform to prevent movement */
  }

  .veetwo-phase-item.active {
    background: {{ section.settings.active_phase_bg_strong | default: '#e0f7ff' }};
  }

  .veetwo-phase-number {
    width: {{ section.settings.number_size | default: 50 }}px;
    height: {{ section.settings.number_size | default: 50 }}px;
    border-radius: 50%;
    background: {{ section.settings.number_bg | default: '#ffffff' }};
    color: {{ section.settings.number_color | default: '#666666' }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.number_font_size | default: 16 }}px;
    font-weight: 600;
    margin-right: {{ section.settings.number_margin | default: 15 }}px;
    transition: all 0.4s cubic-bezer(0.4, 0, 0.2, 1);
    position: relative;
    z-index: 10; /* Above everything */
    box-shadow: 0 0 0 3px {{ section.settings.number_bg | default: '#ffffff' }}; /* White border to cover line */
  }

  .veetwo-phase-item.active .veetwo-phase-number {
    background: {{ section.settings.active_number_bg | default: '#00ffff' }};
    color: {{ section.settings.active_number_color | default: '#000000' }};
    box-shadow: 0 0 0 3px {{ section.settings.bg_color | default: '#ffffff' }}; /* White border to cover line */
  }

  /* Make first phase active by default */
  .veetwo-phase-item:first-of-type {
    background: {{ section.settings.active_phase_bg_strong | default: '#e0f7ff' }};
    padding: {{ section.settings.phase_item_padding | default: 15 }}px;
    border-radius: {{ section.settings.phase_item_radius | default: 12 }}px;
    /* Removed transform to prevent movement */
  }

  .veetwo-phase-item:first-of-type .veetwo-phase-number {
    background: {{ section.settings.active_number_bg | default: '#00ffff' }};
    color: {{ section.settings.active_number_color | default: '#000000' }};
    box-shadow: 0 0 0 3px {{ section.settings.bg_color | default: '#ffffff' }}; /* White border to cover line */
  }

  .veetwo-phase-content h3 {
    font-size: {{ section.settings.phase_title_size | default: 18 }}px; /* Bigger font */
    font-weight: 600;
    color: {{ section.settings.phase_title_color | default: '#000000' }};
    margin: 0 0 3px 0;
    line-height: 1.6;
  }

  .veetwo-phase-content p {
    font-size: {{ section.settings.phase_subtitle_size | default: 14 }}px; /* Bigger font */
    color: {{ section.settings.phase_subtitle_color | default: '#666666' }};
    margin: 0;
    line-height: 1.6;
  }

  /* Right Content Area */
  .veetwo-content-area-protocol-phases {
    flex: 1;
    position: relative;
    overflow: hidden;
    padding: 0;
    height: 100%;
  }

  .veetwo-phase-content-panel {
    display: none;
    opacity: 0;
    height: 100%; /* Use 100% instead of 100vh to work with parent container */
    width: 100%;
    padding: 0;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
  }

  .veetwo-phase-content-panel.active {
    display: block;
    opacity: 1;
    position: relative; /* Keep relative positioning for active panel */
  }

  /* Show first panel by default */
  .veetwo-phase-content-panel:first-child {
    display: block;
    opacity: 1;
    position: relative;
  }

  /* Phase 1 Layout */
  .veetwo-phase-one-layout {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.phase_one_gap | default: 15 }}px;
    height: 100%; /* Take full available height */
    justify-content: center; /* Center content vertically */
    padding: 10px; /* 10px padding from all sides */
  }

  /* Top Section: Image and Content Side by Side */
  .veetwo-phase-one-top {
    display: flex;
    gap: 20px; /* 20px gap as requested */
    align-items: flex-start; /* Changed back to flex-start for proper alignment */
    flex: 1;
    height: 100%;
  }

  .veetwo-phase-one-image {
    flex: 0 0 {{ section.settings.image_width_percent | default: 40 }}%; /* Reduced from 40% to 35% */
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .veetwo-phase-one-image img {
    width: {{ section.settings.image_width | default: 460 }}px; /* Reduced width */
    height: {{ section.settings.image_height | default: 400 }}px;
    object-fit: cover;
    border-radius: {{ section.settings.image_radius | default: 15 }}px;

  }

  .veetwo-image-placeholder-protocol-phases {
    width: {{ section.settings.image_width | default: 360 }}px; /* Match reduced image width */
    height: {{ section.settings.image_height | default: 400 }}px;
    border: 2px dashed {{ section.settings.placeholder_border | default: '#cccccc' }};
    border-radius: {{ section.settings.image_radius | default: 15 }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.placeholder_bg | default: '#f9f9f9' }};
    color: {{ section.settings.placeholder_text_color | default: '#666666' }};
    font-size: {{ section.settings.placeholder_text_size | default: 14 }}px;

  }
  .veetwo-phase-one-content {
    flex: 1; /* Take remaining space */
    display: flex;
    flex-direction: column;
    justify-content: space-between; /* Distribute content to show bottom box */
    height: auto;
    padding: 10px;
    margin-right: 20px; /* Add right margin to prevent content going too far right */
    max-width: calc(65% - 40px); /* Ensure content doesn't overflow (35% image + 20px gap + margins) */
   padding: 10px; /* 10px padding from all sides as requested */
   }


  /* Phase Header */
  .veetwo-phase-header {
    text-align: left;
  }

  .veetwo-phase-label {
    font-size: {{ section.settings.label_size | default: 12 }}px;
    color: {{ section.settings.label_color | default: '#666666' }};
    font-weight: 500;
    display: block;
    margin-bottom: 5px;
  }

  .veetwo-content-title-protocol-phases {
    font-size: {{ section.settings.content_title_size | default: 28 }}px;
    font-weight: {{ section.settings.content_title_weight | default: 700 }};
    color: {{ section.settings.content_title_color | default: '#000000' }};
    margin: 0 0 8px 0;
    line-height: 1.1;
  }

  .veetwo-content-subtitle-protocol-phases {
