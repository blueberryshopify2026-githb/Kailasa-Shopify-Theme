{% comment %}
  Protocol Phases Section - 5 Phase Protocol Display
  Scroll-activated content with left sidebar progression
  White, Cyan, and Black color scheme
{% endcomment %}

<section class="protocol-phases" id="protocol-phases">
  <!-- Main Title -->
  <div class="protocol-header">
    <h1 class="protocol-title">
      <span class="title-black">{{ section.settings.title_black | default: 'THE 360° SKIN' }}</span>
      <span class="title-cyan">{{ section.settings.title_cyan | default: 'LONGEVITY PROTOCOL' }}</span>
      <sup class="trademark">{{ section.settings.trademark | default: '™' }}</sup>
    </h1>
  </div>

  <div class="protocol-container">
    <!-- Left Sidebar -->
    <div class="phases-sidebar">
      <div class="sidebar-track">
        <div class="progress-line" id="progress-line"></div>
      </div>

      {% for block in section.blocks %}
        {% if block.type == 'phase_item' %}
          <div class="phase-item" data-phase="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="phase-number">
              {{ block.settings.phase_number | default: forloop.index | prepend: '0' }}
            </div>
            <div class="phase-content">
              <h3 class="phase-title">{{ block.settings.phase_title | default: 'Phase Title' }}</h3>
              <p class="phase-subtitle">{{ block.settings.phase_subtitle | default: 'Phase Description' }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Right Content Area -->
    <div class="content-area">
      {% for block in section.blocks %}
        {% if block.type == 'phase_item' %}
          <div class="phase-content-panel" data-phase="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {% if forloop.first %}
              <!-- Phase 1: Image left, Features right -->
              <div class="phase-one-layout">
                <!-- Left: Main Content Image -->
                {% if block.settings.main_image %}
                  <div class="phase-one-image">
                    <img
                      src="{{ block.settings.main_image | image_url: width: 600 }}"
                      alt="{{ block.settings.content_title }}"
                      width="600"
                      height="400"
                    >
                  </div>
                {% endif %}

                <!-- Right: Header + Features List -->
                <div class="phase-one-content">
                  <!-- Phase Header -->
                  <div class="phase-one-header">
                    <span class="phase-label-right">{{ block.settings.phase_label | default: 'PHASE I' }}</span>
                    <h2 class="content-title-right">
                      {{ block.settings.content_title | default: 'Internal Optimization' }}
                    </h2>
                    <span class="content-subtitle-right">
                      {{- block.settings.content_subtitle | default: 'Cellular Longevity Layer' -}}
                    </span>
                  </div>

                  <!-- Features List -->
                  <div class="features-list-right"></div>
                  {% if block.settings.feature_1_icon and block.settings.feature_1_title %}
                    <div class="feature-item">
                      <div class="feature-icon">
                        <img
                          src="{{ block.settings.feature_1_icon | image_url: width: 40 }}"
                          alt="Feature 1"
                          width="40"
                          height="40"
                        >
                      </div>
                      <div class="feature-text">
                        <h4>{{ block.settings.feature_1_title }}</h4>
                        <p>{{ block.settings.feature_1_desc }}</p>
                      </div>
                    </div>
                  {% endif %}

                  {% if block.settings.feature_2_icon and block.settings.feature_2_title %}
                    <div class="feature-item">
                      <div class="feature-icon">
                        <img
                          src="{{ block.settings.feature_2_icon | image_url: width: 40 }}"
                          alt="Feature 2"
                          width="40"
                          height="40"
                        >
                      </div>
                      <div class="feature-text">
                        <h4>{{ block.settings.feature_2_title }}</h4>
                        <p>{{ block.settings.feature_2_desc }}</p>
                      </div>
                    </div>
                  {% endif %}

                  {% if block.settings.feature_3_icon and block.settings.feature_3_title %}
                    <div class="feature-item">
                      <div class="feature-icon">
                        <img
                          src="{{ block.settings.feature_3_icon | image_url: width: 40 }}"
                          alt="Feature 3"
                          width="40"
                          height="40"
                        >
                      </div>
                      <div class="feature-text">
                        <h4>{{ block.settings.feature_3_title }}</h4>
                        <p>{{ block.settings.feature_3_desc }}</p>
                      </div>
                    </div>
                  {% endif %}
                </div>
              </div>
              </div>

              <!-- Phase 1: Stats and Description below with 10px gap -->
              <div class="phase-one-bottom">
                <!-- Stats/Results for phase 1 -->
                {% if block.settings.stat_number %}
                  <div class="slide-stats-section">
                    <div class="stat-highlight">
                      <span class="stat-number">{{ block.settings.stat_number }}</span>
                      <span class="stat-label">{{ block.settings.stat_label }}</span>
                    </div>
                    {% if block.settings.stat_description %}
                      <p class="stat-description">{{ block.settings.stat_description }}</p>
                    {% endif %}
                  </div>
                {% endif %}

                <!-- Bottom Text for phase 1 -->
                {% if block.settings.bottom_text %}
                  <div class="slide-bottom-content">
                    <p>{{ block.settings.bottom_text }}</p>
                  </div>
                {% endif %}
              </div>

            {% else %}
              <!-- Phase Header for phases 2-6 -->
              <div
                class="content-header"
                style="text-align: {{ block.settings.header_alignment | default: 'center' }};"
              >
                <span class="phase-label">{{ block.settings.phase_label | default: 'PHASE I' }}</span>
                <h2 class="content-title">{{ block.settings.content_title | default: 'Content Title' }}</h2>
                <span class="content-subtitle">
                  {{- block.settings.content_subtitle | default: 'Content Subtitle' -}}
                </span>
              </div>

              <!-- Phases 2-6: Image placeholder then text description -->
              <div class="other-phases-layout">
                <!-- Image Placeholder -->
                {% if block.settings.main_image %}
                  <div
                    class="phase-image-container"
                    style="text-align: {{ block.settings.image_alignment | default: 'center' }};"
                  >
                    <img
                      src="{{ block.settings.main_image | image_url: width: 600 }}"
                      alt="{{ block.settings.content_title }}"
                      width="{{ block.settings.phase_image_width | default: 500 }}"
                      height="{{ block.settings.phase_image_height | default: 350 }}"
                    >
                  </div>
                {% else %}
                  <div
                    class="image-placeholder"
                    style="text-align: {{ block.settings.image_alignment | default: 'center' }};"
                  >
                    <div class="placeholder-box">
                      <span>Upload Image</span>
                    </div>
                  </div>
                {% endif %}

                <!-- Text Description Box -->
                {% if block.settings.phase_description %}
                  <div
                    class="phase-description-box"
                    style="text-align: {{ block.settings.text_alignment | default: 'center' }};"
                  >
                    <p>{{ block.settings.phase_description }}</p>
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap');

  .protocol-phases {
    background: {{ section.settings.bg_color | default: '#ffffff' }};
    font-family: 'Montserrat', sans-serif;
    position: relative;
  }

  /* Header */
  .protocol-header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin | default: 60 }}px;
    padding: 0 20px;
  }

  .protocol-title {
    font-size: {{ section.settings.title_size | default: 48 }}px;
    font-weight: {{ section.settings.title_weight | default: 700 }};
    margin: 0;
    line-height: 1.2;
  }

  .title-black {
    color: {{ section.settings.black_color | default: '#000000' }};
  }

  .title-cyan {
    color: {{ section.settings.cyan_color | default: '#00ffff' }};
  }

  .trademark {
    font-size: 0.6em;
    color: {{ section.settings.black_color | default: '#000000' }};
  }

  /* Individual Phase Sections */
  .phase-section {
    height: 120vh;
    display: flex;
    align-items: center;
    scroll-snap-align: start;
    padding: {{ section.settings.section_padding | default: 40 }}px 0;
    box-sizing: border-box;
  }

  /* Main Container */
  .protocol-container {
    display: flex;
    max-width: {{ section.settings.max_width | default: 1400 }}px;
    margin: 0 auto;
    padding: 0 20px;
    gap: {{ section.settings.container_gap | default: 60 }}px;
    width: 100%;
    height: 100%;
    align-items: center;
  }

  /* Left Sidebar */
  .phases-sidebar {
    flex: 0 0 {{ section.settings.sidebar_width | default: 280 }}px;
    position: relative;
    height: fit-content;
    min-height: {{ section.settings.sidebar_min_height | default: 550 }}px;
    display: flex;
    flex-direction: column;
  }

  .sidebar-track {
    position: absolute;
    left: 30px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: {{ section.settings.track_color | default: '#e0e0e0' }};
  }

  .progress-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 0%;
    background: {{ section.settings.progress_color | default: '#00ffff' }};
    transition: height 0.3s ease;
  }

  .phase-item {
    display: flex;
    align-items: flex-start;
    margin-bottom: {{ section.settings.phase_spacing | default: 25 }}px;
    position: relative;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .phase-item.active {
    background: {{ section.settings.active_phase_bg | default: '#d3ffff' }};
    padding: 15px;
    border-radius: {{ section.settings.active_phase_radius | default: 15 }}px;
    margin-left: -15px;
    margin-right: -15px;
  }

  .phase-number {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: {{ section.settings.number_bg | default: '#f0f0f0' }};
    color: {{ section.settings.number_color | default: '#666666' }};
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.number_size | default: 18 }}px;
    font-weight: 600;
    margin-right: 20px;
    transition: all 0.3s ease;
    position: relative;
    z-index: 2;
  }

  .phase-item.active .phase-number {
    background: {{ section.settings.active_number_bg | default: '#44ffff' }};
    color: {{ section.settings.active_number_color | default: '#000000' }};
  }

  .phase-content h3 {
    font-size: {{ section.settings.phase_title_size | default: 18 }}px;
    font-weight: 600;
    color: {{ section.settings.phase_title_color | default: '#000000' }};
    margin: 0 0 5px 0;
  }

  .phase-content p {
    font-size: {{ section.settings.phase_subtitle_size | default: 14 }}px;
    color: {{ section.settings.phase_subtitle_color | default: '#666666' }};
    margin: 0;
    line-height: 1.4;
  }

  /* Right Content Area */
  .content-area {
    flex: 1;
    position: relative;
  }

  .phase-content-panel {
    display: none;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .phase-content-panel.active {
    display: block;
    opacity: 1;
  }

  /* Content Header - Same for all phases */
  .content-header {
    margin-bottom: {{ section.settings.content_spacing | default: 40 }}px;
  }

  .phase-label {
    font-size: {{ section.settings.label_size | default: 14 }}px;
    color: {{ section.settings.label_color | default: '#666666' }};
    font-weight: 500;
    display: block;
    margin-bottom: 10px;
  }

  .content-title {
    font-size: {{ section.settings.content_title_size | default: 36 }}px;
    font-weight: {{ section.settings.content_title_weight | default: 700 }};
    color: {{ section.settings.content_title_color | default: '#000000' }};
    margin: 0 0 10px 0;
    line-height: 1.2;
  }

  .content-subtitle {
    font-size: {{ section.settings.content_subtitle_size | default: 16 }}px;
    color: {{ section.settings.content_subtitle_color | default: '#00ffff' }};
    font-weight: 500;
  }

  /* Phase 1 Layout - Centered image left, content right */
  .phase-one-layout {
    display: flex;
    gap: {{ section.settings.phase_one_gap | default: 60 }}px;
    margin-bottom: {{ section.settings.phase_one_margin | default: 10 }}px;
    align-items: flex-start;
    justify-content: center;
  }

  .phase-one-image {
    flex: 0 0 {{ section.settings.phase_one_image_width | default: 40 }}%;
    display: flex;
    justify-content: center;
  }

  .phase-one-image img {
    width: {{ section.settings.phase_one_img_width | default: 350 }}px;
    height: {{ section.settings.phase_one_image_height | default: 400 }}px;
    object-fit: cover;
    border-radius: {{ section.settings.image_radius | default: 15 }}px;
  }

  .phase-one-content {
    flex: 1;
    max-width: {{ section.settings.phase_one_content_width | default: 450 }}px;
  }

  /* Phase 1 Header Styles */
  .phase-one-header {
    margin-bottom: {{ section.settings.phase_one_header_margin | default: 30 }}px;
    text-align: left;
  }

  .phase-label-right {
    font-size: {{ section.settings.label_size | default: 14 }}px;
    color: {{ section.settings.label_color | default: '#666666' }};
    font-weight: 500;
    display: block;
    margin-bottom: 10px;
  }

  .content-title-right {
    font-size: {{ section.settings.content_title_size | default: 36 }}px;
    font-weight: {{ section.settings.content_title_weight | default: 700 }};
    color: {{ section.settings.content_title_color | default: '#000000' }};
    margin: 0 0 10px 0;
    line-height: 1.2;
  }

  .content-subtitle-right {
    font-size: {{ section.settings.content_subtitle_size | default: 16 }}px;
    color: {{ section.settings.content_subtitle_color | default: '#00ffff' }};
    font-weight: 500;
  }

  /* Phase 1 Features */
  .features-list-right {
    margin-top: {{ section.settings.features_top_margin | default: 20 }}px;
  }

  .phase-one-bottom {
    margin-top: {{ section.settings.phase_one_bottom_gap | default: 10 }}px;
  }

  /* Features List */
  .content-main {
    display: flex;
    gap: {{ section.settings.main_content_gap | default: 40 }}px;
    margin-bottom: {{ section.settings.features_spacing | default: 40 }}px;
    align-items: flex-start;
  }

  .features-section {
    flex: 1;
  }

  .features-list {
    margin-bottom: 0;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    margin-bottom: {{ section.settings.feature_spacing | default: 25 }}px;
  }

  .feature-icon {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: {{ section.settings.icon_bg | default: '#f0f8ff' }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 20px;
  }

  .feature-icon img {
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .feature-text h4 {
    font-size: {{ section.settings.feature_title_size | default: 16 }}px;
    font-weight: 600;
    color: {{ section.settings.feature_title_color | default: '#000000' }};
    margin: 0 0 5px 0;
  }

  .feature-text p {
    font-size: {{ section.settings.feature_desc_size | default: 14 }}px;
    color: {{ section.settings.feature_desc_color | default: '#666666' }};
    margin: 0;
    line-height: 1.5;
  }

  /* Other Phases Layout - Full width image with gaps */
  .other-phases-layout {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.other_phases_gap | default: 30 }}px;
  }

  .phase-image-full {
    margin: 0 {{ section.settings.full_image_side_gap | default: 10 }}px;
    margin-bottom: {{ section.settings.image_bottom_margin | default: 20 }}px;
  }

  .phase-image-full img {
    width: 100%;
    height: {{ section.settings.other_phase_image_height | default: 300 }}px;
    object-fit: cover;
    border-radius: {{ section.settings.image_radius | default: 15 }}px;
  }

  .image-placeholder-full {
    margin: 0 {{ section.settings.full_image_side_gap | default: 10 }}px;
    margin-bottom: {{ section.settings.image_bottom_margin | default: 20 }}px;
  }

  .placeholder-box-full {
    width: 100%;
    height: {{ section.settings.other_phase_image_height | default: 300 }}px;
    border: 2px dashed {{ section.settings.placeholder_border | default: '#cccccc' }};
    border-radius: {{ section.settings.image_radius | default: 15 }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.placeholder_bg | default: '#f9f9f9' }};
    color: {{ section.settings.placeholder_text_color | default: '#666666' }};
    font-size: {{ section.settings.placeholder_text_size | default: 16 }}px;
  }

  .phase-description-box {
    background: {{ section.settings.description_bg | default: '#f8f8f8' }};
    padding: {{ section.settings.description_padding | default: 20 }}px;
    border-radius: {{ section.settings.description_radius | default: 10 }}px;
    margin-bottom: {{ section.settings.description_margin | default: 20 }}px;
  }

  .phase-description-box p {
    font-size: {{ section.settings.description_text_size | default: 16 }}px;
    color: {{ section.settings.description_text_color | default: '#333333' }};
    line-height: 1.6;
    margin: 0;
  }

  /* Main Image */
  .main-image {
    flex: 0 0 {{ section.settings.image_width | default: 35 }}%;
    text-align: center;
    margin-top: {{ section.settings.image_top_offset | default: -80 }}px;
  }

  .main-image img {
    width: {{ section.settings.image_fixed_width | default: 400 }}px;
    height: {{ section.settings.image_fixed_height | default: 400 }}px;
    object-fit: cover;
    border-radius: {{ section.settings.image_radius | default: 15 }}px;
  }

  /* Simple content layout for phases 2-6 */
  .simple-content {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: {{ section.settings.simple_content_margin | default: 40 }}px;
  }

  .center-image {
    text-align: center;
  }

  .center-image img {
    width: {{ section.settings.center_image_width | default: 500 }}px;
    height: {{ section.settings.center_image_height | default: 350 }}px;
    object-fit: cover;
    border-radius: {{ section.settings.image_radius | default: 15 }}px;
  }

  /* Stats Section */
  .stats-section, .slide-stats-section {
    background: {{ section.settings.stats_bg | default: '#f8f8f8' }};
    padding: {{ section.settings.stats_padding | default: 30 }}px;
    border-radius: {{ section.settings.stats_radius | default: 15 }}px;
    margin-bottom: {{ section.settings.stats_spacing | default: 30 }}px;
    text-align: center;
  }

  .slide-stats-section {
    margin-top: {{ section.settings.slide_stats_margin | default: 30 }}px;
  }

  .stat-highlight {
    margin-bottom: 15px;
  }

  .stat-number {
    font-size: {{ section.settings.stat_number_size | default: 48 }}px;
    font-weight: 700;
    color: {{ section.settings.stat_number_color | default: '#00ffff' }};
    display: block;
  }

  .stat-label {
    font-size: {{ section.settings.stat_label_size | default: 16 }}px;
    color: {{ section.settings.stat_label_color | default: '#000000' }};
    font-weight: 500;
  }

  .stat-description {
    font-size: {{ section.settings.stat_desc_size | default: 14 }}px;
    color: {{ section.settings.stat_desc_color | default: '#666666' }};
    margin: 0;
    line-height: 1.5;
  }

  /* Bottom Content */
  .bottom-content, .slide-bottom-content {
    font-size: {{ section.settings.bottom_text_size | default: 16 }}px;
    color: {{ section.settings.bottom_text_color | default: '#333333' }};
    line-height: 1.6;
    margin-top: {{ section.settings.slide_bottom_margin | default: 20 }}px;
  }

  .bottom-content p, .slide-bottom-content p {
    margin: 0;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .protocol-container {
      flex-direction: column;
      gap: {{ section.settings.mobile_gap | default: 40 }}px;
    }

    .phases-sidebar {
      flex: none;
      display: flex;
      overflow-x: auto;
      padding-bottom: 10px;
    }

    .sidebar-track {
      display: none;
    }

    .phase-item {
      flex-shrink: 0;
      margin-right: 20px;
      margin-bottom: 0;
    }

    .protocol-title {
      font-size: {{ section.settings.mobile_title_size | default: 32 }}px;
    }

    .content-title {
      font-size: {{ section.settings.mobile_content_title | default: 28 }}px;
    }

    .content-main {
      flex-direction: column;
      gap: {{ section.settings.mobile_content_gap | default: 30 }}px;
    }

    .main-image {
      flex: none;
      order: -1;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const phaseItems = document.querySelectorAll('.phase-item');
    const contentPanels = document.querySelectorAll('.phase-content-panel');
    const progressLine = document.getElementById('progress-line');
    const section = document.getElementById('protocol-phases');
    let currentPhase = 0;
    let allPhasesCompleted = false;

    function showPhase(index) {
      // Prevent rapid changes
      if (index === currentPhase) return;

      // Update sidebar
      phaseItems.forEach((item, i) => {
        item.classList.toggle('active', i === index);
      });

      // Update content
      contentPanels.forEach((panel, i) => {
        panel.classList.toggle('active', i === index);
      });

      // Update progress line
      const progress = ((index + 1) / phaseItems.length) * 100;
      progressLine.style.height = progress + '%';

      currentPhase = index;

      // Check if all phases completed
      if (index === phaseItems.length - 1) {
        allPhasesCompleted = true;
      }
    }

    // Throttle function to prevent excessive calls
    function throttle(func, limit) {
      let inThrottle;
      return function() {
        const args = arguments;
        const context = this;
        if (!inThrottle) {
          func.apply(context, args);
          inThrottle = true;
          setTimeout(() => inThrottle = false, limit);
        }
      }
    }

    // Click handlers for phase items
    phaseItems.forEach((item, index) => {
      item.addEventListener('click', () => {
        showPhase(index);
      });
    });

    // Scroll-based activation with optimized 6-phase distribution
    function handleScroll() {
      const rect = section.getBoundingClientRect();
      const sectionHeight = rect.height;
      const windowHeight = window.innerHeight;

      // Only calculate when section is properly in viewport
      if (rect.top <= 0 && rect.bottom >= windowHeight) {
        const scrolledDistance = Math.abs(rect.top);
        const totalScrollDistance = sectionHeight - windowHeight;

        if (totalScrollDistance > 0) {
          // More precise scroll progress calculation for 6 phases
          const scrollProgress = Math.min(1, scrolledDistance / totalScrollDistance);

          // Calculate phase with better distribution for 6 phases
          let newPhase;

          // More precise phase calculation to ensure all 6 phases are reachable
          if (scrollProgress < 0.12) {
            newPhase = 0; // Phase 1
          } else if (scrollProgress < 0.28) {
            newPhase = 1; // Phase 2
          } else if (scrollProgress < 0.44) {
            newPhase = 2; // Phase 3
          } else if (scrollProgress < 0.6) {
            newPhase = 3; // Phase 4
          } else if (scrollProgress < 0.8) {
            newPhase = 4; // Phase 5
          } else {
            newPhase = 5; // Phase 6
          }

          const clampedPhase = Math.max(0, Math.min(phaseItems.length - 1, newPhase));

          // Only change if different from current phase
          if (clampedPhase !== currentPhase) {
            showPhase(clampedPhase);
          }
        }
      }
    }

    // Create throttled version of scroll handler
    const throttledScrollHandler = throttle(handleScroll, 100);

    // Auto-advance phases
    {% if section.settings.auto_advance %}
      let autoInterval = setInterval(() => {
        const nextPhase = (currentPhase + 1) % phaseItems.length;
        showPhase(nextPhase);
      }, {{ section.settings.auto_duration | default: 5000 }});

      // Pause on hover
      const container = document.querySelector('.protocol-container');
      container.addEventListener('mouseenter', () => clearInterval(autoInterval));
      container.addEventListener('mouseleave', () => {
        autoInterval = setInterval(() => {
          const nextPhase = (currentPhase + 1) % phaseItems.length;
          showPhase(nextPhase);
        }, {{ section.settings.auto_duration | default: 5000 }});
      });
    {% endif %}

    // Enable scroll activation if setting is enabled
    {% if section.settings.scroll_activation %}
      window.addEventListener('scroll', throttledScrollHandler);
    {% endif %}

    // Initialize first phase
    showPhase(0);
  });
</script>

