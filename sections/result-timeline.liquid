{% comment %}
  Result Timeline Section
  Features:
  - Interactive timeline with scrollable circles
  - Dynamic content based on active circle
  - Customizable images and text
  - Montserrat font family
{% endcomment %}

<style>
  .result-timeline {
    font-family: {{ section.settings.font_family }}, sans-serif;
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  .result-timeline__container {
    max-width: 1300px;
    margin: 0 auto;
    {% comment %} padding: 0 5px; {% endcomment %}
  }

  .result-timeline__header {
    text-align: center;
    margin-bottom: 30px;
  }

  .result-timeline__title {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    color: {{ section.settings.title_color }};
    margin-bottom: 5px;
    line-height: 1.2;
  }

  .result-timeline__subtitle {
    font-size: {{ section.settings.subtitle_font_size }}px;
    font-weight: {{ section.settings.subtitle_font_weight }};
    color: {{ section.settings.subtitle_color }};
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.5;
  }

  .result-timeline__content {
    display: flex;
    gap: 0;
    position: relative;
  }

  /* LEFT SIDE - 50% - 3 Images */
  .result-timeline__left-side {
    flex: 0 0 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    {% comment %} padding: 2px; {% endcomment %}
  } 

  .result-timeline__small-images {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .result-timeline__small-image {
    width: 210px;
    height: 210px;
    object-fit: cover;
    border-radius: 20px;
  }

  .result-timeline__large-image {
    width: 440px;
    height: 440px;
    object-fit: cover;
    border-radius: 20px;
  }

  /* Calculate total left side height for matching */
  .result-timeline__left-side-inner {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  /* RIGHT SIDE - 50% - Text and Timeline */
  .result-timeline__right-side {
    flex: 0 0 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    position: relative;
    overflow: hidden;
    height: 470px;
  }

  /* Scrollable wrapper - invisible scroll */
  .result-timeline__scroll-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow-y: scroll;
    overflow-x: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .result-timeline__scroll-wrapper::-webkit-scrollbar {
    display: none;
  }

  /* Scroll content to create scroll space */
  .result-timeline__scroll-content {
    height: 500%;
    position: relative;
  }

  .result-timeline__line-container {
    position: absolute;
    right: 20px;
    top: 48%;
    transform: translateY(-50%);
    width: 60px;
    height: 450px;
    display: flex;  
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    z-index: 10;
  }

  .result-timeline__line {
    width: 2px;
    background-color: #e0e0e0;
    height: 100%;
    position: relative;
  }

  .result-timeline__circles {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    height: 100%;
  }

  .result-timeline__circle {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid #000;
    background-color: #ffffff;
    left: 50%;
    transform: translateX(-50%);
    transition: all 0.3s ease;
    cursor: pointer;
    pointer-events: all;
  }

  .result-timeline__circle.active {
    background-color: #4fffff;
    border-color: #4fffff;
  }

  .result-timeline__text-content {
    position: absolute;
    top: 10%;
    left: 60px;
    right: 120px;
    transform: translateY(-50%);
    z-index: 5;
    pointer-events: none;
  }

  .result-timeline__content-area {
    position: relative;
    width: 100%;
    min-width: 400px;
  }

  .result-timeline__week-content {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .result-timeline__week-content.active {
    opacity: 1;
  }

  .result-timeline__week-badge {
    display: inline-block;
    background-color: #4fffff;
    {% comment %} border: 2px solid #4fffff; {% endcomment %}
    color: #000000;
    padding: 10px 30px;
    border-radius: 30px;
    font-size: {{ section.settings.week_badge_font_size }}px;
    font-weight: {{ section.settings.week_badge_font_weight }};
    margin-bottom: 25px;
    white-space: nowrap;
  }

  .result-timeline__week-title {
    font-size: {{ section.settings.week_title_font_size }}px;
    font-weight: {{ section.settings.week_title_font_weight }};
    color: {{ section.settings.week_title_color }};
    margin-bottom: 25px;
    line-height: 1.3;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .result-timeline__week-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .result-timeline__week-list li {
    font-size: {{ section.settings.list_font_size }}px;
    font-weight: {{ section.settings.list_font_weight }};
    color: {{ section.settings.list_color }};
    margin-bottom: 15px;
    padding-left: 20px;
    position: relative;
    line-height: 1.6;
  }

  .result-timeline__week-list li::before {
    content: "•";
    color: #000000;
    {% comment %} font-size: 20px; {% endcomment %}
    font-weight: bold;
    position: absolute;
    left: 0;
  }

  @media (max-width: 768px) {
    .result-timeline__content {
      flex-direction: column;
      min-height: auto;
    }

    .result-timeline__left-side,
    .result-timeline__right-side {
      flex: none;
      width: 100%;
    }

    .result-timeline__left-side {
      flex-direction: column;
      gap: 15px;
    }

    .result-timeline__small-images {
      flex-direction: row;
      gap: 15px;
    }

    .result-timeline__small-image {
      width: 120px;
      height: 120px;
    }

    .result-timeline__large-image {
      width: 100%;
      max-width: 300px;
      height: 300px;
    }

    .result-timeline__right-side {
      padding: 30px 20px;
    }

    .result-timeline__text-content {
      padding-right: 0;
    }

    .result-timeline__line-container {
      display: none;
    }
  }
</style>

<div class="result-timeline full-width" id="result-timeline-{{ section.id }}">
  <div class="result-timeline__container">
    {% if section.settings.title != blank or section.settings.subtitle != blank %}
      <div class="result-timeline__header">
        {% if section.settings.title != blank %}
          <h2 class="result-timeline__title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="result-timeline__subtitle">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="result-timeline__content">
      <!-- LEFT SIDE - 50% - 3 Images -->
      <div class="result-timeline__left-side">
        <!-- Small Images Column -->
        <div class="result-timeline__small-images">
          {% if section.settings.left_image_1 != blank %}
            <img src="{{ section.settings.left_image_1 | image_url: width: 360 }}" 
                 alt="{{ section.settings.left_image_1.alt | default: 'Product image 1' }}" 
                 class="result-timeline__small-image" 
                 width="210"
                 height="210">
          {% endif %}
          {% if section.settings.left_image_2 != blank %}
            <img src="{{ section.settings.left_image_2 | image_url: width: 360 }}" 
                 alt="{{ section.settings.left_image_2.alt | default: 'Product image 2' }}" 
                 class="result-timeline__small-image" 
                 width="210"
                 height="210">
          {% endif %}
        </div>

        <!-- Large Center Image -->
        {% if section.settings.center_image != blank %}
          <img src="{{ section.settings.center_image | image_url: width: 760 }}" 
               alt="{{ section.settings.center_image.alt | default: 'Main product image' }}" 
               class="result-timeline__large-image" 
               width="440"
               height="440">
        {% endif %}
      </div>

      <!-- RIGHT SIDE - 50% - Text and Timeline -->
      <div class="result-timeline__right-side">
        <!-- Invisible scroll wrapper -->
        <div class="result-timeline__scroll-wrapper" id="scroll-wrapper-{{ section.id }}">
          <div class="result-timeline__scroll-content"></div>
        </div>

        <!-- Text Content (Fixed in center) -->
        <div class="result-timeline__text-content">
          <div class="result-timeline__content-area">
            {% for block in section.blocks %}
              <div class="result-timeline__week-content {% if forloop.first %}active{% endif %}" 
                   data-week="{{ forloop.index }}" 
                   {{ block.shopify_attributes }}>
                <span class="result-timeline__week-badge">{{ block.settings.week_label }}</span>
                <h3 class="result-timeline__week-title">{{ block.settings.week_title }}</h3>
                {% if block.settings.week_description != blank %}
                  <ul class="result-timeline__week-list">
                    {% assign descriptions = block.settings.week_description | split: '|' %}
                    {% for description in descriptions %}
                      {% if description != blank %}
                        <li>{{ description | strip }}</li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>

        <!-- Timeline Line and Circles -->
        <div class="result-timeline__line-container">
          <div class="result-timeline__line">
            <div class="result-timeline__circles" id="timeline-circles-{{ section.id }}">
              <!-- Circles will be generated by JavaScript based on blocks -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sectionId = 'result-timeline-{{ section.id }}';
  const section = document.getElementById(sectionId);
  const scrollWrapper = document.getElementById('scroll-wrapper-{{ section.id }}');
  const circlesContainer = document.getElementById('timeline-circles-{{ section.id }}');
  const weekContents = section.querySelectorAll('.result-timeline__week-content');
  
  let currentWeek = 1;
  const totalWeeks = weekContents.length;
  let isScrollingInSection = false;
  
  // Generate circles based on number of blocks
  function generateCircles() {
    circlesContainer.innerHTML = '';
    for (let i = 0; i < totalWeeks; i++) {
      const circle = document.createElement('div');
      circle.className = 'result-timeline__circle';
      circle.dataset.week = i + 1;
      
      // Position circles evenly along the line
      const position = (i / (totalWeeks - 1)) * 100;
      circle.style.top = position + '%';
      
      if (i === 0) {
        circle.classList.add('active');
      }
      
      circlesContainer.appendChild(circle);
    }
  }
  
  // Update active states based on scroll
  function updateActiveStates() {
    const scrollTop = scrollWrapper.scrollTop;
    const scrollHeight = scrollWrapper.scrollHeight - scrollWrapper.clientHeight;
    const scrollProgress = scrollTop / scrollHeight;
    
    // Calculate which week should be active
    const newWeek = Math.min(totalWeeks, Math.max(1, Math.ceil(scrollProgress * totalWeeks) || 1));
    
    if (newWeek !== currentWeek) {
      currentWeek = newWeek;
      
      // Update circles
      const circles = section.querySelectorAll('.result-timeline__circle');
      circles.forEach((circle, index) => {
        circle.classList.toggle('active', index + 1 === currentWeek);
      });
      
      // Update week content
      weekContents.forEach((content, index) => {
        content.classList.toggle('active', index + 1 === currentWeek);
      });
    }
  }
  
  // Handle scroll within the invisible wrapper
  scrollWrapper.addEventListener('scroll', function() {
    updateActiveStates();
    
    // Check if at bottom
    const scrollTop = scrollWrapper.scrollTop;
    const scrollHeight = scrollWrapper.scrollHeight - scrollWrapper.clientHeight;
    const isAtBottom = scrollTop >= scrollHeight - 5;
    
    if (isAtBottom && currentWeek === totalWeeks) {
      isScrollingInSection = false;
    } else {
      isScrollingInSection = true;
    }
  });
  
  // Intercept wheel events on the right side
  const rightSide = section.querySelector('.result-timeline__right-side');
  rightSide.addEventListener('wheel', function(e) {
    const scrollTop = scrollWrapper.scrollTop;
    const scrollHeight = scrollWrapper.scrollHeight - scrollWrapper.clientHeight;
    const isAtBottom = scrollTop >= scrollHeight - 5;
    const isAtTop = scrollTop <= 5;
    
    // Scroll the invisible wrapper
    scrollWrapper.scrollTop += e.deltaY;
    
    // Prevent page scroll unless at boundaries
    if ((e.deltaY > 0 && !isAtBottom) || (e.deltaY < 0 && !isAtTop)) {
      e.preventDefault();
      e.stopPropagation();
    }
  }, { passive: false });
  
  // Handle circle clicks
  section.addEventListener('click', function(e) {
    if (e.target.classList.contains('result-timeline__circle')) {
      const weekNumber = parseInt(e.target.dataset.week);
      currentWeek = weekNumber;
      
      // Calculate scroll position for this week
      const scrollHeight = scrollWrapper.scrollHeight - scrollWrapper.clientHeight;
      const targetScroll = ((weekNumber - 1) / (totalWeeks - 1)) * scrollHeight;
      
      scrollWrapper.scrollTo({
        top: targetScroll,
        behavior: 'smooth'
      });
    }
  });
  
  // Initialize
  generateCircles();
  updateActiveStates();
});
</script>

