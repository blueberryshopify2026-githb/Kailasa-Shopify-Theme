{% comment %}
  Routine Hero Banner Section - Hero banner with headline, sub-headings, and frosted glass product card
  Features: Main headline, three sub-headings, background image, frosted glass product overlay
{% endcomment %}

<style>
  .routine-hero-banner {
    font-family: 'Montserrat', sans-serif;
    position: relative;
    width: 100%;
    min-height: 100vh;
    max-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 30px 20px;
    background: #fff;
    overflow: hidden;
  }

  /* Main Headline */
  .routine-hero-banner-headline {
    font-size: {{ section.settings.headline_font_size | default: 64 }}px;
    font-weight: 900;
    color: {{ section.settings.headline_color | default: '#000000' }};
    text-align: center;
    margin: 0 0 30px 0;
    line-height: 1.1;
    max-width: {{ section.settings.content_max_width | default: 1200 }}px;
    width: 100%;
    letter-spacing: -2px;
  }

  /* Sub-headings Container */
  .routine-hero-banner-subheadings {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    max-width: {{ section.settings.content_max_width | default: 1200 }}px;
    width: 100%;
    margin: 0 0 40px 0;
    gap: 40px;
  }

  .routine-hero-banner-subheading {
    flex: 1;
    text-align: left;
  }

  .routine-hero-banner-subheading-title {
    font-size: {{ section.settings.subheading_font_size | default: 18 }}px;
    font-weight: 400;
    color: {{ section.settings.subheading_color | default: '#333333' }};
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .routine-hero-banner-subheading-text {
    font-size: {{ section.settings.subheading_text_size | default: 14 }}px;
    font-weight: 400;
    color: {{ section.settings.subheading_text_color | default: '#666666' }};
    margin: 0;
    line-height: 1.4;
  }

  /* Image Container */
  .routine-hero-banner-image-container {
    position: relative;
    width: 100%;
    max-width: {{ section.settings.image_max_width | default: 1200 }}px;
    height: 400px;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  }

  .routine-hero-banner-main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Frosted Glass Product Card */
  .routine-hero-banner-product-card {
    position: absolute;
    top: 20px;
    right: 20px;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 16px;
    padding: 20px;
    width: 280px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }

  .routine-hero-banner-product-info {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .routine-hero-banner-product-image {
    width: 60px;
    height: 60px;
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .routine-hero-banner-product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .routine-hero-banner-product-content {
    flex: 1;
  }

  .routine-hero-banner-product-title {
    font-size: 16px;
    font-weight: 700;
    color: {{ section.settings.product_title_color | default: '#333333' }};
    margin: 0 0 6px 0;
    line-height: 1.2;
  }

  .routine-hero-banner-product-description {
    font-size: 12px;
    font-weight: 400;
    color: {{ section.settings.product_description_color | default: '#666666' }};
    margin: 0;
    line-height: 1.3;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .routine-hero-banner {
      padding: 40px 20px;
      min-height: 90vh;
    }

    .routine-hero-banner-headline {
      font-size: 48px;
      margin-bottom: 30px;
    }

    .routine-hero-banner-subheadings {
      flex-direction: column;
      gap: 24px;
      margin-bottom: 40px;
    }

    .routine-hero-banner-subheading {
      text-align: center;
    }

    .routine-hero-banner-image-container {
      height: 400px;
    }

    .routine-hero-banner-product-card {
      position: static;
      margin-top: 20px;
      width: 100%;
      max-width: 320px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 480px) {
    .routine-hero-banner-headline {
      font-size: 36px;
    }

    .routine-hero-banner-subheading-title {
      font-size: 16px;
    }

    .routine-hero-banner-subheading-text {
      font-size: 13px;
    }

    .routine-hero-banner-image-container {
      height: 300px;
    }
  }
</style>

<section class="routine-hero-banner full-width">
  <!-- Main Headline -->
  {% if section.settings.headline != blank %}
    <h1 class="routine-hero-banner-headline">{{ section.settings.headline }}</h1>
  {% endif %}

  <!-- Sub-headings -->
  <div class="routine-hero-banner-subheadings">
    {% if section.settings.subheading_1_title != blank %}
      <div class="routine-hero-banner-subheading">
        <h3 class="routine-hero-banner-subheading-title">{{ section.settings.subheading_1_title }}</h3>
        {% if section.settings.subheading_1_text != blank %}
          <p class="routine-hero-banner-subheading-text">{{ section.settings.subheading_1_text }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.subheading_2_title != blank %}
      <div class="routine-hero-banner-subheading">
        <h3 class="routine-hero-banner-subheading-title">{{ section.settings.subheading_2_title }}</h3>
        {% if section.settings.subheading_2_text != blank %}
          <p class="routine-hero-banner-subheading-text">{{ section.settings.subheading_2_text }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.subheading_3_title != blank %}
      <div class="routine-hero-banner-subheading">
        <h3 class="routine-hero-banner-subheading-title">{{ section.settings.subheading_3_title }}</h3>
        {% if section.settings.subheading_3_text != blank %}
          <p class="routine-hero-banner-subheading-text">{{ section.settings.subheading_3_text }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <!-- Image Container with Frosted Glass Product Card -->
  <div class="routine-hero-banner-image-container">
    {% if section.settings.main_image %}
      <img
        src="{{ section.settings.main_image | image_url: width: 1000 }}"
        alt="{{ section.settings.main_image.alt | default: 'Routine Hero Banner' }}"
        class="routine-hero-banner-main-image"
        width="1000"
        height="500"
      >
    {% else %}
      <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; color: white; font-size: 18px;">
        Add Main Image
      </div>
    {% endif %}

    <!-- Frosted Glass Product Card -->
    {% if section.settings.show_product_card %}
      <div class="routine-hero-banner-product-card">
        <div class="routine-hero-banner-product-info">
          <div class="routine-hero-banner-product-image">
            {% if section.settings.product_image %}
              <img
                src="{{ section.settings.product_image | image_url: width: 120 }}"
                alt="{{ section.settings.product_title | default: 'Product' }}"
                width="60"
                height="60"
              >
            {% else %}
              <div style="width: 100%; height: 100%; background: #ddd; border-radius: 8px;"></div>
            {% endif %}
          </div>
          <div class="routine-hero-banner-product-content">
            {% if section.settings.product_title != blank %}
              <h4 class="routine-hero-banner-product-title">{{ section.settings.product_title }}</h4>
            {% endif %}
            {% if section.settings.product_description != blank %}
              <p class="routine-hero-banner-product-description">{{ section.settings.product_description }}</p>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Routine Hero Banner",
  "tag": "section",
  "class": "routine-hero-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Content Max Width (Headline & Sub-headings)",
      "default": 1200,
      "info": "Controls the maximum width of headline and sub-headings"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "min": 800,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "label": "Image Max Width",
      "default": 1200,
      "info": "Controls the maximum width of the main image container"
    },
    {
      "type": "header",
      "content": "Main Headline"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Build Your Ageless Routine"
    },
    {
      "type": "range",
      "id": "headline_font_size",
      "min": 32,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Headline Font Size",
      "default": 64
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Sub-headings"
    },
    {
      "type": "text",
      "id": "subheading_1_title",
      "label": "Sub-heading 1 Title",
      "default": "Your Personalized Path to Youthful Skin"
    },
    {
      "type": "textarea",
      "id": "subheading_1_text",
      "label": "Sub-heading 1 Text"
    },
    {
      "type": "text",
      "id": "subheading_2_title",
      "label": "Sub-heading 2 Title",
      "default": "Where Science Meets Ageless Beauty"
    },
    {
      "type": "textarea",
      "id": "subheading_2_text",
      "label": "Sub-heading 2 Text"
    },
    {
      "type": "text",
      "id": "subheading_3_title",
      "label": "Sub-heading 3 Title",
      "default": "Design Your Age-Defying Ritual"
    },
    {
      "type": "textarea",
      "id": "subheading_3_text",
      "label": "Sub-heading 3 Text"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Sub-heading Font Size",
      "default": 18
    },
    {
      "type": "range",
      "id": "subheading_text_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Sub-heading Text Size",
      "default": 14
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Sub-heading Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "subheading_text_color",
      "label": "Sub-heading Text Color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Background Image"
    },
    {
      "type": "header",
      "content": "Product Card"
    },
    {
      "type": "checkbox",
      "id": "show_product_card",
      "label": "Show Product Card",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product Image"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Product Title",
      "default": "Photon LED Mask"
    },
    {
      "type": "textarea",
      "id": "product_description",
      "label": "Product Description",
      "default": "Advanced formulations work deep beneath the surface"
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Product Title Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "product_description_color",
      "label": "Product Description Color",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Routine Hero Banner",
      "settings": {
        "headline": "Build Your Ageless Routine",
        "subheading_1_title": "Your Personalized Path to Youthful Skin",
        "subheading_2_title": "Where Science Meets Ageless Beauty",
        "subheading_3_title": "Design Your Age-Defying Ritual",
        "product_title": "Photon LED Mask",
        "product_description": "Advanced formulations work deep beneath the surface"
      }
    }
  ]
}
{% endschema %}
