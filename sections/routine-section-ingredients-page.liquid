        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Routine Ingredients Page",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "tile_label": "Niacinamide",
            "tile_title": "START YOUR MORNING WITH A RITUAL THAT PROTECTS YOUR SKIN",
            "tile_description": "Derived from DNA fragments, PDRN supports tissue regeneration and enhances skin healing at a cellular level."
          }
        },
        {
          "type": "tile",
          "settings": {
            "tile_title": "EVENING RESTORATION THERAPY",
            "tile_description": "Advanced nighttime formulas work while you sleep to repair and rejuvenate your skin at the cellular level."
          }
        },
        {
          "type": "tile",
          "settings": {
            "tile_title": "WEEKLY INTENSIVE TREATMENT",
            "tile_description": "Powerful weekly treatments that target specific concerns and accelerate your skin's natural renewal process."
          }
        },
        {
          "type": "tile",
          "settings": {
            "tile_title": "DAILY PROTECTION SHIELD",
            "tile_description": "Essential daily defense that creates a protective barrier against environmental damage and premature aging."
          }
        }
      ]
    }
  ]
}
{% endschema %}