                      {% assign slide_content = '' %}
                      {% assign current_slide_products = 0 %}
                      {% assign slide_count = slide_count | plus: 1 %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
                
                {% comment %} Handle remaining products in last slide {% endcomment %}
