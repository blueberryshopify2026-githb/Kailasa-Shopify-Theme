                          {% else %}
                            <div class="routine-product-placeholder"><p>No Image</p></div>
                          {% endif %}
                        </div>
                        <div class="routine-product-name">
                          {% if block.settings.custom_product_name != blank %}
                            {{ block.settings.custom_product_name }}
                          {% else %}
                            {{ block.settings.product.title | default: 'Product Name' }}
                          {% endif %}
                        </div>
                      </div>
                      {% if block.settings.product %}
                        </a>
                      {% endif %}
                    {% endcapture %}
                    
                    {% assign slide_content = slide_content | append: product_html %}
                    {% assign current_slide_products = current_slide_products | plus: 1 %}
                    
                    {% if current_slide_products == products_per_slide %}
                      {% capture slide_html %}<div class="mobile-products-slide">{{ slide_content }}</div>{% endcapture %}
