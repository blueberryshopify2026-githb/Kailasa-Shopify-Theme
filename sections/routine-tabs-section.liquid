        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const tabButtons = document.querySelectorAll('.routine-tab-button');
    const tabContents = document.querySelectorAll('.routine-content');

    tabButtons.forEach((button) => {
      button.addEventListener('click', function () {
        const targetTab = this.getAttribute('data-tab');

        // Remove active class from all buttons and contents
        tabButtons.forEach((btn) => btn.classList.remove('active'));
        tabContents.forEach((content) => content.classList.remove('active'));

        // Add active class to clicked button and corresponding content
        this.classList.add('active');
        const targetContent = document.querySelector(`[data-content="${targetTab}"]`);
        if (targetContent) {
          targetContent.classList.add('active');
        }
      });
    });

    // Mobile carousel functionality
    function initMobileCarousel() {
      if (window.innerWidth <= 768) {
        // Show mobile carousel, hide desktop grid and tablet carousel
        document.querySelectorAll('.mobile-products-carousel').forEach(carousel => {
          carousel.style.display = 'block';
        });
        document.querySelectorAll('.tablet-products-carousel').forEach(carousel => {
          carousel.style.display = 'none';
        });
        document.querySelectorAll('.routine-products-grid > .routine-product-link, .routine-products-grid > .routine-product-card').forEach(item => {
          if (!item.closest('.mobile-products-carousel') && !item.closest('.tablet-products-carousel')) {
            item.style.display = 'none';
          }
        });

        // Initialize mobile carousel for each tab
        ['am', 'pm', 'pm-light', 'exfoliate'].forEach(tab => {
          initCarousel(`${tab}-carousel-wrapper`, `${tab}-carousel-dots`, true);
        });

      } else if (window.innerWidth <= 1280) {
        // Tablet: show tablet carousel, hide mobile and desktop
        document.querySelectorAll('.mobile-products-carousel').forEach(carousel => {
          carousel.style.display = 'none';
        });
        document.querySelectorAll('.tablet-products-carousel').forEach(carousel => {
          carousel.style.display = 'block';
        });
        document.querySelectorAll('.routine-products-grid > .routine-product-link, .routine-products-grid > .routine-product-card').forEach(item => {
          if (!item.closest('.mobile-products-carousel') && !item.closest('.tablet-products-carousel')) {
            item.style.display = 'none';
          }
        });

        // Initialize tablet carousel for each tab
        ['am', 'pm', 'pm-light', 'exfoliate'].forEach(tab => {
          initCarousel(`${tab}-tablet-wrapper`, `${tab}-tablet-dots`, true);
        });

      } else {
        // Desktop: show desktop grid, hide carousels
        document.querySelectorAll('.mobile-products-carousel').forEach(carousel => {
          carousel.style.display = 'none';
        });
        document.querySelectorAll('.tablet-products-carousel').forEach(carousel => {
          carousel.style.display = 'none';
        });
        document.querySelectorAll('.routine-products-grid > .routine-product-link, .routine-products-grid > .routine-product-card').forEach(item => {
          if (!item.closest('.mobile-products-carousel') && !item.closest('.tablet-products-carousel')) {
            item.style.display = 'block';
          }
        });
      }
    }

    function initCarousel(wrapperId, dotsId, enableTouch) {
      const wrapper = document.getElementById(wrapperId);
      const dotsContainer = document.getElementById(dotsId);
      if (!wrapper || !dotsContainer) return;

      // Avoid re-initializing
      if (wrapper.dataset.carouselInit === 'true') return;
      wrapper.dataset.carouselInit = 'true';

      let currentSlide = 0;
      const slides = wrapper.querySelectorAll('.mobile-products-slide, .tablet-products-slide');
      const dotElements = dotsContainer.querySelectorAll('.carousel-dot');

      function updateCarousel() {
        wrapper.style.transform = `translateX(-${currentSlide * 100}%)`;
        dotElements.forEach((dot, i) => dot.classList.toggle('active', i === currentSlide));
      }

      dotElements.forEach((dot, i) => {
        dot.addEventListener('click', () => { currentSlide = i; updateCarousel(); });
      });

      if (enableTouch) {
        // Attach touch to the carousel container (parent of wrapper) for reliability
        const container = wrapper.parentElement;
        const touchTarget = container || wrapper;
        let startX = 0;
        let startY = 0;
        let isDragging = false;

        touchTarget.addEventListener('touchstart', e => {
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
          isDragging = true;
        }, { passive: true });

        touchTarget.addEventListener('touchmove', e => {
          if (!isDragging) return;
          const diffX = Math.abs(startX - e.touches[0].clientX);
          const diffY = Math.abs(startY - e.touches[0].clientY);
          // Only prevent scroll if horizontal swipe is dominant
          if (diffX > diffY && diffX > 10) {
            e.preventDefault();
          }
        }, { passive: false });

        touchTarget.addEventListener('touchend', e => {
          if (!isDragging) return;
          isDragging = false;
          const diff = startX - e.changedTouches[0].clientX;
          const diffY = Math.abs(startY - e.changedTouches[0].clientY);
          if (Math.abs(diff) > 30 && Math.abs(diff) > diffY) {
            if (diff > 0 && currentSlide < slides.length - 1) currentSlide++;
            else if (diff < 0 && currentSlide > 0) currentSlide--;
            updateCarousel();
          }
        }, { passive: true });
      }
    }

    // Apply dynamic image sizing
    function applyImageSizing() {
      const productCards = document.querySelectorAll('.routine-product-card[data-image-width][data-image-height]');

      productCards.forEach((card) => {
        const imageWidth = card.dataset.imageWidth || 100;
        const imageHeight = card.dataset.imageHeight || 100;
        const image = card.querySelector('.routine-product-image');

        if (image) {
          image.style.width = `${imageWidth}%`;
          image.style.height = `${imageHeight}%`;
          image.style.maxWidth = `${imageWidth}%`;
          image.style.maxHeight = `${imageHeight}%`;
        }
      });
    }

    // Initialize on load
    initMobileCarousel();
    applyImageSizing();

    // Re-initialize on resize
    window.addEventListener('resize', () => {
      // Reset init flags so carousels re-initialize for new breakpoint
      document.querySelectorAll('[data-carousel-init]').forEach(el => el.removeAttribute('data-carousel-init'));
      initMobileCarousel();
      applyImageSizing();
    });

    // Apply sizing on tab change
    tabButtons.forEach((button) => {
      button.addEventListener('click', function () {
        setTimeout(() => {
          applyImageSizing();
          initMobileCarousel();
        }, 100);
      });
    });
  });
</script>
