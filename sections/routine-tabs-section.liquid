          {% if section.settings.am_image %}
            <img
              src="{{ section.settings.am_image | image_url: width: 600, height: 400 }}"
              alt="{{ section.settings.am_heading }}"
              width="600"
              height="400"
              class="routine-image"
            >
          {% endif %}
        </div>
        <div class="routine-content-card">
          <h2 class="routine-content-heading">{{ section.settings.am_heading }}</h2>
          <p class="routine-content-description">{{ section.settings.am_description }}</p>
          <a href="{{ section.settings.am_cta_link }}" class="routine-cta-button">
            {{ section.settings.am_cta_text }}
          </a>
        </div>
      </div>

      {% assign am_products_count = 0 %}
      {% for block in section.blocks %}
        {% if block.settings.tab_selector == 'am' %}
          {% assign am_products_count = am_products_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      {% if am_products_count > 0 %}
        <div class="routine-products-grid" style="grid-template-columns: repeat({{ am_products_count | at_most: 6 }}, 1fr);">
          <!-- Mobile Carousel Structure -->
          <div class="mobile-products-carousel" style="display: none;">
            <div class="mobile-products-wrapper" id="am-carousel-wrapper">
              {% assign slide_count = 0 %}
              {% assign products_per_slide = 2 %}
              {% assign current_slide_products = 0 %}
              {% assign am_products = '' %}
              
              {% comment %} First, collect all AM products {% endcomment %}
              {% for block in section.blocks %}
                {% if block.settings.tab_selector == 'am' %}
                  {% assign am_products = am_products | append: block.id | append: ',' %}
                {% endif %}
              {% endfor %}
              
              {% assign am_products_array = am_products | split: ',' %}
              {% assign total_products = am_products_array.size | minus: 1 %}
              
              {% if total_products > 0 %}
                {% assign am_slides = '' %}
                {% assign current_slide_products = 0 %}
                {% assign slide_content = '' %}
                
                {% for block in section.blocks %}
                  {% if block.settings.tab_selector == 'am' %}
                    {% capture product_html %}
                      {% if block.settings.product %}
                        <a href="{{ block.settings.product.url }}" class="routine-product-link">
                      {% endif %}
                      <div class="routine-product-card" {{ block.shopify_attributes }} data-image-width="{{ block.settings.image_width | default: 100 }}" data-image-height="{{ block.settings.image_height | default: 100 }}" style="--image-width: {{ block.settings.image_width | default: 100 }}; --image-height: {{ block.settings.image_height | default: 100 }};">
                        <div class="routine-product-number" style="font-size: {{ block.settings.number_font_size | default: 80 }}px; color: {{ block.settings.number_color | default: '#4FFFFF' }}; top: {{ block.settings.number_vertical_position | default: 20 }}%; left: {{ block.settings.number_horizontal_position | default: 25 }}%;">
                          {{ block.settings.step_number }}
                        </div>
                        <div class="routine-product-image-container">
                          {% if block.settings.product_image %}
