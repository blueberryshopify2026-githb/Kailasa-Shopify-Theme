<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tabButtons = document.querySelectorAll('.routine-tab-button');
    const tabContents = document.querySelectorAll('.routine-content');

    tabButtons.forEach(button => {
      button.addEventListener('click', function() {
        const targetTab = this.getAttribute('data-tab');
        
        // Remove active class from all buttons and contents
        tabButtons.forEach(btn => btn.classList.remove('active'));
        tabContents.forEach(content => content.classList.remove('active'));
        
        // Add active class to clicked button and corresponding content
        this.classList.add('active');
        const targetContent = document.querySelector(`[data-content="${targetTab}"]`);
        if (targetContent) {
          targetContent.classList.add('active');
        }
      });
    });

    // Apply dynamic image sizing
    function applyImageSizing() {
      const productCards = document.querySelectorAll('.routine-product-card[data-image-width][data-image-height]');
      
      productCards.forEach(card => {
        const imageWidth = card.dataset.imageWidth || 100;
        const imageHeight = card.dataset.imageHeight || 100;
        const image = card.querySelector('.routine-product-image');
        
        if (image) {
          image.style.width = `${imageWidth}%`;
          image.style.height = `${imageHeight}%`;
          image.style.maxWidth = `${imageWidth}%`;
          image.style.maxHeight = `${imageHeight}%`;
        }
      });
    }

    // Apply sizing on load and when tabs change
    applyImageSizing();
    
    tabButtons.forEach(button => {
      button.addEventListener('click', function() {
        setTimeout(applyImageSizing, 100); // Small delay to ensure content is visible
      });
    });
  });
</script>
