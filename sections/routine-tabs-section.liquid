        {% endif %}
      </div>
    {% endif %}

    <!-- Tab Navigation -->
    <div class="routine-tabs-nav">
      <button class="routine-tab-button active" data-tab="am"><span class="tab-label">{{ section.settings.tab_1_label }}</span></button>
