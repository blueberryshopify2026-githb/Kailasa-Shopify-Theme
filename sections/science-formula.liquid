{% comment %}
  Science Formula Section - Interactive expandable science content
  Features expandable blocks with media placeholders and cyan active states
{% endcomment %}


<section class="science-formula-section full-width" id="science-formula">
  <div class="science-container">
    <!-- Left Content Area -->
    <div class="science-content">
      <!-- Main Heading -->
      <div class="science-header">
        <h1 class="science-title">
          {{
            section.settings.main_title
            | default: 'We have the formula for long-term skin health. And we follow it.'
          }}
        </h1>
        <p class="science-subtitle">
          {{
            section.settings.subtitle
            | default: 'Every formulation begins with a question: What does skin need that current products dont deliver? We find the answers in our philosophy.'
          }}
        </p>


        <!-- Navigation Arrows -->
        <div class="content-nav-arrows">
          <div class="nav-arrow-small" onclick="scrollToTop()">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M9 7L6 4L3 7" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="nav-arrow-small" onclick="scrollToBottom()">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M3 5L6 8L9 5" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </div>


      <!-- Expandable Science Blocks -->
      <div class="science-blocks-container">
        <div class="science-blocks"></div>
        {% for block in section.blocks %}
          {% if block.type == 'science_item' %}
            <div class="science-block" data-block="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="block-header" onclick="toggleBlock({{ forloop.index0 }})">
                <h3 class="block-title">{{ block.settings.title | default: 'Science Block Title' }}</h3>
                <div class="expand-arrow">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              </div>


              <div class="block-content">
                <p class="block-description">
                  {{
                    block.settings.description
                    | default: 'Scientists have identified the biological hallmarks that drive aging. We focused on the ones that skincare has the unique power to address and built our formulas around them. This is the targeted longevity skincare is supposed to deliver.'
                  }}
                </p>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>


    <!-- Right Media Area -->
    <div class="science-media">
      <div class="media-container-science-formula">
        <!-- Single Media Display -->
        <div id="media-display" class="single-media-display">
          <!-- Default placeholder will be inserted here by JavaScript -->
        </div>
      </div>
    </div>
  </div>
</section>


<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap');


  .science-formula-section {
    background: {{ section.settings.bg_color | default: '#000000' }};
    color: {{ section.settings.text_color | default: '#ffffff' }};
    font-family: 'Montserrat', sans-serif;
    padding: {{ section.settings.section_padding | default: 20 }}px;
    min-height: 100vh;
    height: 100vh;
    overflow: hidden;
  }


  .science-container {
    max-width: {{ section.settings.container_width | default: 1400 }}px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: {{ section.settings.content_ratio | default: 50 }}% {{ section.settings.media_ratio | default: 50 }}%;
    gap: {{ section.settings.grid_gap | default: 20 }}px;
    height: calc(100vh - 40px);
  }


  /* Left Content Area */
  .science-content {
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: sticky;
    top: 0;
    z-index: 10;
    cursor: pointer; /* Pointer cursor for entire left area */
  }


  .content-nav-arrows {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    margin-top: 10px;
  }


  .nav-arrow-small {
    width: 24px;
    height: 24px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }


  .nav-arrow-small:hover {
    background: rgba(255, 255, 255, 0.2);
  }


  .science-blocks-container {
    flex: 1;
    overflow-y: scroll;
    overflow-x: hidden;
    padding-right: 10px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    max-height: calc(6 * 60px + 5 * 3px);
    scroll-behavior: auto; /* Changed from smooth to auto for better control */
    cursor: pointer;
  }


  .science-blocks-container::-webkit-scrollbar {
    display: none;
  }


  .science-header {
    margin-bottom: {{ section.settings.header_margin | default: 10 }}px;
    flex-shrink: 0;
  }


  .science-title {
    font-size: {{ section.settings.title_size | default: 20 }}px;
    font-weight: {{ section.settings.title_weight | default: 600 }};
    line-height: {{ section.settings.title_line_height | default: 1.1 }};
    color: {{ section.settings.title_color | default: '#ffffff' }};
    margin: 0 0 {{ section.settings.title_margin | default: 10 }}px 0;
  }


  .science-subtitle {
    font-size: {{ section.settings.subtitle_size | default: 14 }}px;
    font-weight: {{ section.settings.subtitle_weight | default: 400 }};
    line-height: {{ section.settings.subtitle_line_height | default: 1.5 }};
    color: {{ section.settings.subtitle_color | default: '#ffffff' }};
    margin: 0 0 {{ section.settings.subtitle_margin_bottom | default: 20 }}px 0;
  }


  /* Science Blocks */
  .science-blocks {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.blocks_gap | default: 3 }}px;
  }


  .science-block {
    border: none;
    border-top: {{ section.settings.block_border_width | default: 1 }}px solid {{ section.settings.block_border_color | default: '#333333' }};
    border-bottom: {{ section.settings.block_border_width | default: 1 }}px solid {{ section.settings.block_border_color | default: '#333333' }};
    border-radius: 0;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: {{ section.settings.block_bg | default: 'transparent' }};
    width: {{ section.settings.block_width | default: 100 }}%;
    min-height: 60px;
    flex-shrink: 0;
    cursor: pointer;
    position: relative; /* Ensure stable positioning */
  }


  .science-block.active {
    border-top-color: {{ section.settings.block_border_color | default: '#333333' }};
    border-bottom-color: {{ section.settings.block_border_color | default: '#333333' }};
    background: {{ section.settings.active_bg | default: 'transparent' }};
    box-shadow: none;
  }


  .block-header {
    display: flex;
    align-items: center;
    padding: {{ section.settings.header_padding | default: 18 }}px {{ section.settings.header_padding_horizontal | default: 20 }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    gap: {{ section.settings.header_gap | default: 16 }}px;
    min-height: 60px; /* Minimum height for headers */
    box-sizing: border-box;
  }


  .science-block:hover .block-header {
    background: {{ section.settings.hover_bg | default: 'rgba(255, 255, 255, 0.02)' }};
  }


  .science-block.active .block-header {
    background: {{ section.settings.active_header_bg | default: 'transparent' }};
  }


  .block-title {
    flex: 1;
    font-size: {{ section.settings.block_title_size | default: 16 }}px;
    font-weight: {{ section.settings.block_title_weight | default: 500 }};
    color: #ffffff;
    margin: 0;
    transition: color 0.3s ease;
  }


  .science-block.active .block-title {
    color: #4fffff !important;
  }


  .expand-arrow {
    width: {{ section.settings.arrow_size | default: 24 }}px;
    height: {{ section.settings.arrow_size | default: 24 }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    transition: all 0.3s ease;
    transform: rotate(0deg);
  }


  .science-block.active .expand-arrow {
    color: #ffffff;
    transform: rotate(180deg);
  }


  /* Mobile (≤767px): swap chevron for + / × */
  @media (max-width: 709px) {
    .expand-arrow svg {
      display: none;
    }
    .expand-arrow::after {
      content: '+';
      font-size: 20px;
      font-weight: 300;
      color: #ffffff;
      line-height: 1;
    }
    .science-block.active .expand-arrow {
      transform: none;
    }
    .science-block.active .expand-arrow::after {
      content: '×';
      font-size: 22px;
    }
  }


  .block-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), padding 0.4s ease;
    padding: 0 {{ section.settings.header_padding_horizontal | default: 20 }}px;
  }


  .science-block.active .block-content {
    max-height: {{ section.settings.content_max_height | default: 150 }}px;
    padding: 0 {{ section.settings.header_padding_horizontal | default: 20 }}px {{ section.settings.content_padding_bottom | default: 16 }}px;
  }


  .block-description {
    font-size: {{ section.settings.description_size | default: 12 }}px;
    font-weight: {{ section.settings.description_weight | default: 400 }};
    line-height: {{ section.settings.description_line_height | default: 1.6 }};
    color: #ffffff;
    margin: 0;
  }


  /* Right Media Area */
  .science-media {
    position: relative;
    height: 100%;
    border-radius: 16px;
    overflow: hidden;
    background: #000000;
    border: none;
    box-shadow: none;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Allow normal scrolling on right side */
  }


  .media-container-science-formula {
    position: relative;
    width: 90%;
    height: calc(100vh - 150px);
    max-height: 650px;
    border-radius: 16px;
    overflow: hidden;
  }


  .single-media-display {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }


  .science-video,
  .science-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
  }


  .media-placeholder-science-formula {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.placeholder_bg | default: '#222222' }};
    border: {{ section.settings.placeholder_border_width | default: 1 }}px solid {{ section.settings.placeholder_border_color | default: '#444444' }};
    border-radius: 16px;
  }


  .placeholder-content {
    text-align: center;
    color: {{ section.settings.placeholder_text_color | default: '#888888' }};
  }


  .placeholder-content p {
    margin: 0;
    font-size: {{ section.settings.placeholder_text_size | default: 14 }}px;
    font-weight: {{ section.settings.placeholder_text_weight | default: 500 }};
  }


  .science-video,
  .science-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
  }


  .media-placeholder-science-formula {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.placeholder_bg | default: '#222222' }};
    border: {{ section.settings.placeholder_border_width | default: 1 }}px solid {{ section.settings.placeholder_border_color | default: '#444444' }};
    border-radius: 16px;
  }


  .placeholder-content {
    text-align: center;
    color: {{ section.settings.placeholder_text_color | default: '#4fffff' }};
  }


  .placeholder-content p {
    margin: {{ section.settings.placeholder_text_margin | default: 16 }}px 0 0 0;
    font-size: {{ section.settings.placeholder_text_size | default: 16 }}px;
    font-weight: {{ section.settings.placeholder_text_weight | default: 500 }};
  }


  /* =============================================
     TABLET — 768px → 1024px
     Full-width heading top, FAQs left scroll, image right fixed
     ============================================= */
  @media (min-width: 710px) and (max-width: 1024px) {


    /* Section: auto height — no black gap below content */
    .science-formula-section {
      height: auto !important;
      min-height: unset !important;
      overflow: visible !important;
      padding: 28px 24px !important;
      box-sizing: border-box !important;
      display: block !important;
    }


    /* Full-width header row — shrinks to its natural height */
    .science-content .science-header,
    #science-formula > .science-header {
      display: block !important;
      width: 100% !important;
      flex-shrink: 0 !important;
      margin-bottom: 20px !important;
    }


    .science-title {
      font-size: clamp(24px, 3.2vw, 34px) !important;
      line-height: 1.2 !important;
      margin-bottom: 8px !important;
    }


    .science-subtitle {
      font-size: clamp(14px, 1.8vw, 16px) !important;
      line-height: 1.5 !important;
      margin-bottom: 0 !important;
    }


    /* 2-col grid — auto height, no flex stretching */
    .science-container {
      display: grid !important;
      grid-template-columns: 1fr 1fr !important;
      gap: 20px !important;
      height: auto !important;
      min-height: unset !important;
      max-width: 100% !important;
      margin: 0 !important;
      align-items: start !important;
    }


    /* Left col — fixed to collapsed FAQ height, clips expanded content */
    .science-content {
      position: static !important;
      display: block !important;
      /* 6 blocks × 58px + 5 gaps × 8px = 388px */
      height: calc(6 * 58px + 5 * 8px) !important;
      max-height: calc(6 * 58px + 5 * 8px) !important;
      overflow: hidden !important;
      padding-right: 0 !important;
      cursor: auto !important;
    }


    /* Safety: hide header inside science-content if JS hasn't moved it */
    .science-content > .science-header {
      display: none !important;
    }


    .content-nav-arrows {
      display: none !important;
    }


    /* Blocks scroll inside the fixed-height left col */
    .science-blocks-container {
      flex: 1 !important;
      min-height: 0 !important;
      overflow-y: auto !important;
      overflow-x: hidden !important;
      max-height: 100% !important;
      padding-right: 0 !important;
      scrollbar-width: none !important;
      -webkit-overflow-scrolling: touch !important;
      touch-action: pan-y !important;
    }


    .science-blocks-container::-webkit-scrollbar {
      display: none !important;
    }


    .science-block {
      border-radius: 8px !important;
      border: 1px solid {{ section.settings.block_border_color | default: '#333333' }} !important;
      border-top: 1px solid {{ section.settings.block_border_color | default: '#333333' }} !important;
      border-bottom: 1px solid {{ section.settings.block_border_color | default: '#333333' }} !important;
      margin-bottom: 8px !important;
      background: rgba(255,255,255,0.03) !important;
      min-height: 58px !important;
      flex-shrink: 0 !important;
    }


    .block-header {
      padding: 16px 18px !important;
      min-height: 58px !important;
    }


    .block-title {
      font-size: clamp(16px, 2vw, 18px) !important;
      line-height: 1.35 !important;
    }


    .block-description {
      font-size: clamp(14px, 1.7vw, 16px) !important;
      line-height: 1.5 !important;
    }


    .science-block.active .block-content {
      max-height: 150px !important;
    }


    /* Right col — same fixed height as left col, never moves */
    .science-media {
      height: calc(6 * 58px + 5 * 8px) !important;
      width: 100% !important;
      align-self: start !important;
      position: static !important;
      border-radius: 16px !important;
      overflow: hidden !important;
      background: #111 !important;
      flex-shrink: 0 !important;
    }


    .media-container-science-formula {
      width: 100% !important;
      height: 100% !important;
      max-height: none !important;
      border-radius: 16px !important;
      overflow: hidden !important;
    }


    .single-media-display {
      width: 100% !important;
      height: 100% !important;
      border-radius: 16px !important;
      overflow: hidden !important;
    }


    .science-image,
    .science-video {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      border-radius: 16px !important;
      display: block !important;
    }


    .media-placeholder-science-formula {
      border-radius: 16px !important;
      height: 100% !important;
    }
  }


  /* =============================================
     MOBILE RESPONSIVE — does NOT affect desktop
     375px → 767px | fits 100dvh | no overflow
     ============================================= */
  @media (max-width: 767px) {


    /* Lock to viewport — no overflow, no black gap */
    .science-formula-section {
      height: auto !important;
      max-height: none !important;
      min-height: unset !important;
      overflow: visible !important;
      padding: 16px !important;
      box-sizing: border-box !important;
    }


    /* Flex column container */
    .science-container {
      grid-template-columns: 1fr !important;
      gap: 0 !important;
      height: auto !important;
      display: flex !important;
      flex-direction: column !important;
      max-width: 100% !important;
    }


    /* science-content is emptied by JS on mobile — nothing to show */


    /* Title — readable on 375px */
    .science-title {
      font-size: 22px !important;
      line-height: 1.2 !important;
      margin-bottom: 6px !important;
      font-weight: 700 !important;
    }


    /* Subtitle — readable */
    .science-subtitle {
      font-size: 14px !important;
      line-height: 1.5 !important;
      margin-bottom: 0 !important;
    }


    /* Header — sits below image, above blocks */
    .science-header {
      flex-shrink: 0 !important;
      margin-bottom: 10px !important;
    }


    /* Hide desktop nav arrows */
    .content-nav-arrows {
      display: none !important;
    }


    /* Blocks container — natural height, scrollable if needed */
    .science-blocks-container {
      flex: 0 0 auto !important;
      overflow-y: auto !important;
      overflow-x: hidden !important;
      max-height: none !important;
      padding-right: 0 !important;
      scrollbar-width: none !important;
      -ms-overflow-style: none !important;
      -webkit-overflow-scrolling: touch !important;
      touch-action: pan-y !important;
    }


    .science-blocks-container::-webkit-scrollbar {
      display: none !important;
    }


    /* Image — top of stack, no top margin */
    .science-media {
      flex-shrink: 0 !important;
      height: clamp(110px, 20vh, 160px) !important;
      width: 100% !important;
      border-radius: 16px !important;
      margin: 0 0 10px 0 !important;
      background: #111 !important;
      overflow: hidden !important;
    }


    /* Inner container must also clip to radius */
    .media-container-science-formula {
      width: 100% !important;
      height: 100% !important;
      max-height: none !important;
      border-radius: 16px !important;
      overflow: hidden !important;
    }


    /* Single media display — clip too */
    .single-media-display {
      border-radius: 16px !important;
      overflow: hidden !important;
    }


    /* Image/video — hard radius on the element itself */
    .science-image {
      border-radius: 16px !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      display: block !important;
    }


    .science-video {
      border-radius: 16px !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      display: block !important;
    }


    .media-placeholder-science-formula {
      border-radius: 16px !important;
    }


    /* Accordion blocks */
    .science-block {
      min-height: 52px !important;
      border-radius: 10px !important;
      border: 1px solid {{ section.settings.block_border_color | default: '#333333' }} !important;
      border-top: 1px solid {{ section.settings.block_border_color | default: '#333333' }} !important;
      border-bottom: 1px solid {{ section.settings.block_border_color | default: '#333333' }} !important;
      margin-bottom: 8px !important;
      background: rgba(255, 255, 255, 0.04) !important;
    }


    .block-header {
      padding: 14px 16px !important;
      min-height: 52px !important;
      gap: 10px !important;
    }


    .block-title {
      font-size: 16px !important;
      line-height: 1.3 !important;
    }


    .expand-arrow {
      width: 20px !important;
      height: 20px !important;
      flex-shrink: 0 !important;
    }


    .block-description {
      font-size: 13px !important;
      line-height: 1.5 !important;
    }


    .science-block.active .block-content {
      max-height: 120px !important;
      padding: 0 16px 14px !important;
    }
  }
</style>


<script>
  document.addEventListener('DOMContentLoaded', function () {
    const scienceBlocks = document.querySelectorAll('.science-block');
    let activeBlock = -1;


    // Media content data


    const mediaData = {
      'default': {
        video: '{{ section.settings.default_video_file }}',
        cgi: '{{ section.settings.default_cgi_file }}',
        image: '{% if section.settings.default_media_image %}{{ section.settings.default_media_image | image_url: width: 800 }}{% endif %}',
        placeholder: '{{ section.settings.default_placeholder_text | default: "Default Media Placeholder" }}'
      }{% for block in section.blocks %}{% if block.type == 'science_item' %},
      '{{ forloop.index0 }}': {
        video: '{{ block.settings.video_file }}',
        cgi: '{{ block.settings.cgi_file }}',
        image: '{% if block.settings.media_image %}{{ block.settings.media_image | image_url: width: 800 }}{% endif %}',
        placeholder: '{{ block.settings.placeholder_text | default: "" }}'
      }{% endif %}{% endfor %}
    };


    // The default image — resolved once at render time by Liquid
    const defaultImageUrl = '{% if section.settings.default_media_image %}{{ section.settings.default_media_image | image_url: width: 800 }}{% endif %}';
    const mobileOverrideUrl = '{% if section.settings.mobile_media_image %}{{ section.settings.mobile_media_image | image_url: width: 800 }}{% endif %}';


    function isValid(str) {
      return str && str.trim().length > 0 && str !== 'undefined' && !str.includes('undefined');
    }


    // Pick the best image src for a given mediaData entry
    function getBestSrc(entry) {
      if (isValid(entry.image))  return { kind: 'image', src: entry.image };
      if (isValid(entry.video))  return { kind: 'video', src: entry.video };
      if (isValid(entry.cgi))    return { kind: 'video', src: entry.cgi };
      return null;
    }


    // Get best src, falling back to default image if entry has nothing
    function resolveSrc(mediaKey) {
      const isMob = window.innerWidth <= 768;


      // On mobile, always prefer the mobile override image first
      if (isMob && isValid(mobileOverrideUrl)) {
        return { kind: 'image', src: mobileOverrideUrl };
      }


      const entry = mediaData[mediaKey];
      if (entry) {
        const result = getBestSrc(entry);
        if (result) return result;
      }


      // Fall back to default
      if (isValid(defaultImageUrl)) {
        return { kind: 'image', src: defaultImageUrl };
      }


      return null; // nothing at all
    }


    // Render media into the display div
    function updateMediaDisplay(mediaKey) {
      const mediaDisplay = document.getElementById('media-display');
      if (!mediaDisplay) return;


      const resolved = resolveSrc(mediaKey);


      if (resolved && resolved.kind === 'image') {
        mediaDisplay.innerHTML = `<img src="${resolved.src}" alt="Media content" class="science-image" style="width:100%;height:100%;object-fit:cover;border-radius:16px;display:block;">`;
      } else if (resolved && resolved.kind === 'video') {
        mediaDisplay.innerHTML = `<video class="science-video" autoplay muted loop playsinline style="width:100%;height:100%;object-fit:cover;border-radius:16px;display:block;">
          <source src="${resolved.src}" type="video/mp4">
        </video>`;
      } else {
        const label = (mediaData[mediaKey] && mediaData[mediaKey].placeholder) || mediaData['default'].placeholder || 'Media Placeholder';
        mediaDisplay.innerHTML = `<div class="media-placeholder-science-formula">
          <div class="placeholder-content"><p>${label}</p></div>
        </div>`;
      }
    }


    // Initialize with default media
    scienceBlocks.forEach((block) => block.classList.remove('active'));


    // Tablet DOM reorder (768–1024px):
    // Section is flex-column. Move header before container → full-width flex row above grid.
    if (window.innerWidth >= 768 && window.innerWidth <= 1024) {
      const sectionEl = document.getElementById('science-formula');
      const container = document.querySelector('.science-container');
      const header    = document.querySelector('.science-header');


      if (sectionEl && container && header) {
        sectionEl.insertBefore(header, container);
      }
    }


    // Mobile DOM reorder (≤767px): image → heading → blocks stacked
    if (window.innerWidth <= 767) {
      const container  = document.querySelector('.science-container');
      const media      = document.querySelector('.science-media');
      const header     = document.querySelector('.science-header');
      const blocksWrap = document.querySelector('.science-blocks-container');


      if (container && media && header && blocksWrap) {
        container.innerHTML = '';
        container.appendChild(media);
        container.appendChild(header);
        container.appendChild(blocksWrap);
      }
    }


    // Now populate media (after DOM is in final order)
    updateMediaDisplay('default');


    // Add two-stage scrolling: first show all blocks, then allow page scroll
    const blocksContainer = document.querySelector('.science-blocks-container');
    const leftContent = document.querySelector('.science-content');
    const rightMedia = document.querySelector('.science-media');
   
    if (blocksContainer && leftContent) {
      let currentBlockIndex = 0;
      let isScrolling = false;
      let allBlocksVisible = false;
      const maxBlocks = Math.max(0, scienceBlocks.length - 6); // Max scroll position
     
      // Check if all blocks are visible
      function checkAllBlocksVisible() {
        const containerHeight = blocksContainer.clientHeight;
        const totalContentHeight = blocksContainer.scrollHeight;
        const currentScroll = blocksContainer.scrollTop;
       
        // All blocks are visible when we've scrolled to show all content
        allBlocksVisible = (currentScroll >= maxBlocks * 63) || (totalContentHeight <= containerHeight);
        return allBlocksVisible;
      }
     
      // Handle wheel events on the left content area
      leftContent.addEventListener('wheel', function(e) {
        if (isScrolling) return;
       
        const scrollDirection = e.deltaY > 0 ? 1 : -1; // 1 for down, -1 for up
        const isAtTop = currentBlockIndex === 0;
        const isAtBottom = currentBlockIndex >= maxBlocks;
       
        // Stage 1: Navigate through blocks
        if (!allBlocksVisible || (!isAtTop && scrollDirection === -1) || (!isAtBottom && scrollDirection === 1)) {
          e.preventDefault();
          e.stopPropagation();
          isScrolling = true;
         
          // Update current block index
          currentBlockIndex = Math.max(0, Math.min(maxBlocks, currentBlockIndex + scrollDirection));
         
          // Calculate target scroll position
          const targetScroll = currentBlockIndex * 63; // 60px + 3px gap
         
          blocksContainer.scrollTo({
            top: targetScroll,
            behavior: 'smooth'
          });
         
          // Check if all blocks are now visible
          setTimeout(() => {
            checkAllBlocksVisible();
            isScrolling = false;
          }, 300);
        } else {
          // Stage 2: Allow page scroll when all blocks are shown and at boundaries
          // Don't prevent default - allow normal page scrolling
          if ((scrollDirection === 1 && isAtBottom) || (scrollDirection === -1 && isAtTop)) {
            // Allow page scroll to next/previous section
            return;
          }
        }
      }, { passive: false });


      // Initialize check
      checkAllBlocksVisible();
    }


    window.toggleBlock = function (index) {
      const clickedBlock = scienceBlocks[index];
      const isCurrentlyActive = clickedBlock.classList.contains('active');


      if (isCurrentlyActive) {
        // Close the currently active block
        clickedBlock.classList.remove('active');
       
        // Show default media
        updateMediaDisplay('default');
       
        activeBlock = -1;
      } else {
        // Close all blocks first
        scienceBlocks.forEach((block) => block.classList.remove('active'));


        // Open the clicked block
        clickedBlock.classList.add('active');


        // Show corresponding media
        updateMediaDisplay(index.toString());
       
        activeBlock = index;
      }
    };


    // Scroll to top function
    window.scrollToTop = function () {
      const container = document.querySelector('.science-blocks-container');
      if (container) {
        container.scrollTo({ top: 0, behavior: 'smooth' });
      }
    };


    // Scroll to bottom function
    window.scrollToBottom = function () {
      const container = document.querySelector('.science-blocks-container');
      if (container) {
        container.scrollTo({ top: container.scrollHeight, behavior: 'smooth' });
      }
    };
  });
</script>
