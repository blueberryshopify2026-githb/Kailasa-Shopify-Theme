{% comment %}
  Science Page Hero Section
  Layout: full-width background image, left: title + subtitle, bottom-right: frosted glass box with image.
  CSS suffix: -sphero | Font: Montserrat
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap"
  rel="stylesheet"
>

<style>
  .section-sphero {
    font-family: 'Montserrat', sans-serif;
    position: relative;
    width: 100%;
    overflow: hidden;
    {% comment %} margin-top: {{ section.settings.section_top_margin }}px; {% endcomment %}
    margin-top: {{ section.settings.section_top_margin | default: 80 }}px;
    min-height: {{ section.settings.section_height | default: 520 }}px;
    display: flex;
    align-items: stretch;
  }

  /* Background image */
  .hero-bg-sphero {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    z-index: 0;
  }

  .hero-bg-placeholder-sphero {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #c8e8f5 0%, #a0d4e8 100%);
    z-index: 0;
  }

  /* Content wrapper */
  .hero-content-sphero {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 56px 56px 48px 56px;
    box-sizing: border-box;
    min-height: {{ section.settings.section_height | default: 520 }}px;
  }

  /* Top-left: title + subtitle */
  .hero-text-sphero {
    max-width: 45%;
    margin-top: 30px;
  }

  .hero-title-sphero {
    font-size: {{ section.settings.title_font_size | default: 56 }}px;
    font-weight: {{ section.settings.title_font_weight | default: '800' }};
    font-style: {{ section.settings.title_font_style | default: 'normal' }};
    line-height: 1.08;
    color: {{ section.settings.title_color | default: '#000000' }};
    margin: 0 0 18px 0;
    letter-spacing: -0.5px;
  }

  .hero-subtitle-sphero {
    font-size: {{ section.settings.subtitle_font_size | default: 19 }}px;
    font-weight: {{ section.settings.subtitle_font_weight | default: '300' }};
    font-style: {{ section.settings.subtitle_font_style | default: 'normal' }};
    line-height: 1.65;
    color: {{ section.settings.subtitle_color | default: '#1a1a1a' }};
    margin: 0;
    max-width: 500px;
  }

  /* Bottom-right: frosted glass box */
  .hero-bottom-row-sphero {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    margin-top: 20px;
  }

  .hero-glass-sphero {
    position: relative;
    background: rgba(209, 209, 209, 0.08);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(212, 212, 212, 0.7);
    border-radius: {{ section.settings.glass_border_radius | default: 18 }}px;
    width: {{ section.settings.glass_width | default: 280 }}px;
    height: {{ section.settings.glass_height | default: 220 }}px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.10);
  }

  /* Diagonal arrow in top-left corner of glass box */
  .hero-glass-arrow-sphero {
    position: absolute;
    top: 12px;
    left: 14px;
    z-index: 3;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-glass-arrow-sphero svg {
    width: 20px;
    height: 20px;
  }

  /* Image slides inside glass box */
  .hero-glass-slide-sphero {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    opacity: 0;
    transition: opacity 0.8s ease-in-out;
  }

  .hero-glass-slide-sphero.active-sphero {
    opacity: 1;
  }

  .hero-glass-img-placeholder-sphero {
    position: absolute;
    inset: 0;
    background: rgba(200, 220, 235, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: rgba(0,0,0,0.35);
    letter-spacing: 1px;
  }

  /* ─── Mobile (≤ 767px) — DO NOT edit above this line ─── */
  @media (max-width: 767px) {
    .section-sphero {
      min-height: {{ section.settings.mobile_section_height | default: 680 }}px;
      align-items: flex-end;
      margin-top: {{ section.settings.mobile_section_top_margin | default: 60 }}px;
    }

    /* Background image fills the full section on mobile */
    .hero-bg-sphero {
      object-position: center top;
    }

    /* Content sits at the bottom of the section */
    .hero-content-sphero {
      padding: 0;
      min-height: {{ section.settings.mobile_section_height | default: 680 }}px;
      justify-content: flex-end;
    }

    /* Reposition glass box to top-right on mobile */
    .hero-bottom-row-sphero {
      display: block;
      position: absolute;
      top: {{ section.settings.mobile_glass_top | default: 16 }}px;
      right: {{ section.settings.mobile_glass_right | default: 16 }}px;
      margin: 0;
    }

    .hero-glass-sphero {
      width: {{ section.settings.mobile_glass_width | default: 160 }}px;
      height: {{ section.settings.mobile_glass_height | default: 130 }}px;
    }

    /* Mobile text block — full width, centered, sits at bottom */
    .hero-text-sphero {
      max-width: 100%;
      margin-top: 0;
      padding: {{ section.settings.mobile_text_padding_vertical | default: 28 }}px {{ section.settings.mobile_text_padding_horizontal | default: 20 }}px {{ section.settings.mobile_text_padding_vertical | default: 28 }}px {{ section.settings.mobile_text_padding_horizontal | default: 20 }}px;
      text-align: center;
      background: transparent;
    }

    .hero-title-sphero {
      font-size: {{ section.settings.mobile_title_font_size | default: 36 }}px;
      font-weight: {{ section.settings.mobile_title_font_weight | default: '800' }};
      font-style: {{ section.settings.mobile_title_font_style | default: 'normal' }};
      color: {{ section.settings.mobile_title_color | default: '#000000' }};
      line-height: 1.1;
      margin: 0 0 12px 0;
      letter-spacing: -0.3px;
    }

    .hero-subtitle-sphero {
      font-size: {{ section.settings.mobile_subtitle_font_size | default: 15 }}px;
      font-weight: {{ section.settings.mobile_subtitle_font_weight | default: '400' }};
      font-style: {{ section.settings.mobile_subtitle_font_style | default: 'normal' }};
      color: {{ section.settings.mobile_subtitle_color | default: '#1a1a1a' }};
      line-height: 1.6;
      max-width: 100%;
      margin: 0;
    }
  }

  /* ─── Tablet (768px–1024px) — DO NOT edit above or below this block ─── */
  @media (min-width: 768px) and (max-width: 1024px) {
    .section-sphero {
      min-height: {{ section.settings.tablet_section_height | default: 780 }}px;
      align-items: flex-end;
      margin-top: {{ section.settings.tablet_section_top_margin | default: 80 }}px;
    }

    .hero-bg-sphero {
      object-position: center top;
    }

    .hero-content-sphero {
      padding: 0;
      min-height: {{ section.settings.tablet_section_height | default: 780 }}px;
      justify-content: flex-end;
    }

    /* Glass box: top-right, larger than mobile */
    .hero-bottom-row-sphero {
      display: block;
      position: absolute;
      top: {{ section.settings.tablet_glass_top | default: 20 }}px;
      right: {{ section.settings.tablet_glass_right | default: 20 }}px;
      margin: 0;
    }

    .hero-glass-sphero {
      width: {{ section.settings.tablet_glass_width | default: 220 }}px;
      height: {{ section.settings.tablet_glass_height | default: 180 }}px;
    }

    /* Text block: full width, centered, at bottom */
    .hero-text-sphero {
      max-width: 100%;
      margin-top: 0;
      padding: {{ section.settings.tablet_text_padding_vertical | default: 36 }}px {{ section.settings.tablet_text_padding_horizontal | default: 32 }}px;
      text-align: center;
      background: transparent;
    }

    .hero-title-sphero {
      font-size: {{ section.settings.tablet_title_font_size | default: 52 }}px;
      font-weight: {{ section.settings.tablet_title_font_weight | default: '800' }};
      font-style: {{ section.settings.tablet_title_font_style | default: 'normal' }};
      color: {{ section.settings.tablet_title_color | default: '#000000' }};
      line-height: 1.08;
      margin: 0 0 16px 0;
      letter-spacing: -0.4px;
    }

    .hero-subtitle-sphero {
      font-size: {{ section.settings.tablet_subtitle_font_size | default: 18 }}px;
      font-weight: {{ section.settings.tablet_subtitle_font_weight | default: '400' }};
      font-style: {{ section.settings.tablet_subtitle_font_style | default: 'normal' }};
      color: {{ section.settings.tablet_subtitle_color | default: '#1a1a1a' }};
      line-height: 1.6;
      max-width: 100%;
      margin: 0;
    }
  }
</style>

<section
  class="section-sphero full-width"
  id="science-page-hero-{{ section.id }}"
  aria-label="{{ section.settings.title | default: 'Science Page Hero' }}"
>
  {% if section.settings.background_image %}
    <img
      class="hero-bg-sphero"
      src="{{ section.settings.background_image | image_url: width: 2000 }}"
      alt="{{ section.settings.background_image.alt | default: '' }}"
      width="{{ section.settings.background_image.width }}"
      height="{{ section.settings.background_image.height }}"
      loading="eager"
    >
  {% else %}
    <div class="hero-bg-placeholder-sphero"></div>
  {% endif %}

  <div class="hero-content-sphero">
    <!-- Title + Subtitle (top-left) -->
    <div class="hero-text-sphero">
      <h1 class="hero-title-sphero">
        {{ section.settings.title | default: 'Your Daily Dose of Luxury' }}
      </h1>
      <p class="hero-subtitle-sphero">
        {{ section.settings.subtitle | default: 'A soothing botanical extract that calms irritation, reduces redness, repairs damaged skin.' }}
      </p>
    </div>

    <!-- Frosted glass box (bottom-right) -->
    <div class="hero-bottom-row-sphero">
      <div class="hero-glass-sphero">
        <!-- Diagonal arrow SVG top-left corner -->
        <div class="hero-glass-arrow-sphero" aria-hidden="true">
          <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="5" y1="5" x2="16" y2="16" stroke="#222222" stroke-width="2.5" stroke-linecap="round"/>
            <polyline points="15,5 5,5 5,15" stroke="#222222" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </div>

        {% assign glass_slide_index = 0 %}
        {% assign glass_has_image = false %}
        {% for i in (1..8) %}
          {% assign img_key = 'glass_image_' | append: i %}
          {% assign img = section.settings[img_key] %}
          {% if img %}
            {% assign glass_has_image = true %}
            <img
              class="hero-glass-slide-sphero{% if glass_slide_index == 0 %} active-sphero{% endif %}"
              src="{{ img | image_url: width: 600 }}"
              alt="{{ img.alt | default: '' }}"
              width="{{ img.width }}"
              height="{{ img.height }}"
              loading="{% if glass_slide_index == 0 %}eager{% else %}lazy{% endif %}"
              data-glass-slide-sphero="{{ glass_slide_index }}"
            >
            {% assign glass_slide_index = glass_slide_index | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% unless glass_has_image %}
          <div class="hero-glass-img-placeholder-sphero">IMAGE</div>
        {% endunless %}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('science-page-hero-{{ section.id }}');
    if (!section) return;
    var slides = section.querySelectorAll('[data-glass-slide-sphero]');
    if (slides.length < 2) return;
    var current = 0;
    setInterval(function () {
      slides[current].classList.remove('active-sphero');
      current = (current + 1) % slides.length;
      slides[current].classList.add('active-sphero');
    }, 2000);
  })();
</script>

