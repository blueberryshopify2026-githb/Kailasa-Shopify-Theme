{% comment %}
  Science Page Hero Section
  Layout: full-width background image, left: title + subtitle, bottom-right: frosted glass box with image.
  CSS suffix: -sphero | Font: Montserrat
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap"
  rel="stylesheet"
>

<style>
  .section-sphero {
    font-family: 'Montserrat', sans-serif;
    position: relative;
    width: 100%;
    overflow: hidden;
    {% comment %} margin-top: {{ section.settings.section_top_margin }}px; {% endcomment %}
    margin-top: 80px;
    min-height: {{ section.settings.section_height | default: 520 }}px;
    display: flex;
    align-items: stretch;
  }

  /* Background image */
  .hero-bg-sphero {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    z-index: 0;
  }

  .hero-bg-placeholder-sphero {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #c8e8f5 0%, #a0d4e8 100%);
    z-index: 0;
  }

  /* Content wrapper */
  .hero-content-sphero {
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 56px 56px 48px 56px;
    box-sizing: border-box;
    min-height: {{ section.settings.section_height | default: 520 }}px;
  }

  /* Top-left: title + subtitle */
  .hero-text-sphero {
    max-width: 45%;
    margin-top: 30px;
  }

  .hero-title-sphero {
    font-size: {{ section.settings.title_font_size | default: 56 }}px;
    font-weight: 800;
    line-height: 1.08;
    color: {{ section.settings.title_color | default: '#000000' }};
    margin: 0 0 18px 0;
    letter-spacing: -0.5px;
  }

  .hero-subtitle-sphero {
    font-size: {{ section.settings.subtitle_font_size | default: 19 }}px;
    font-weight: 300;
    line-height: 1.65;
    color: {{ section.settings.subtitle_color | default: '#1a1a1a' }};
    margin: 0;
    max-width: 500px;
  }

  /* Bottom-right: frosted glass box */
  .hero-bottom-row-sphero {
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    margin-top: 20px;
  }

  .hero-glass-sphero {
    position: relative;
    background: rgba(209, 209, 209, 0.08);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    border: 1px solid rgba(212, 212, 212, 0.7);
    border-radius: {{ section.settings.glass_border_radius | default: 18 }}px;
    width: {{ section.settings.glass_width | default: 280 }}px;
    height: {{ section.settings.glass_height | default: 220 }}px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.10);
  }

  /* Diagonal arrow in top-left corner of glass box */
  .hero-glass-arrow-sphero {
    position: absolute;
    top: 12px;
    left: 14px;
    z-index: 3;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-glass-arrow-sphero svg {
    width: 20px;
    height: 20px;
  }

  /* Image slides inside glass box */
  .hero-glass-slide-sphero {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    opacity: 0;
    transition: opacity 0.8s ease-in-out;
  }

  .hero-glass-slide-sphero.active-sphero {
    opacity: 1;
  }

  .hero-glass-img-placeholder-sphero {
    position: absolute;
    inset: 0;
    background: rgba(200, 220, 235, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Montserrat', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: rgba(0,0,0,0.35);
    letter-spacing: 1px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-content-sphero {
      padding: 36px 24px 32px 24px;
      min-height: auto;
    }

    .hero-text-sphero {
      max-width: 100%;
    }

    .hero-title-sphero {
      font-size: 34px;
    }

    .hero-subtitle-sphero {
      font-size: 15px;
      max-width: 100%;
    }

    .hero-glass-sphero {
      width: 200px;
      height: 160px;
    }
  }
</style>

<section
  class="section-sphero full-width"
  id="science-page-hero-{{ section.id }}"
  aria-label="{{ section.settings.title | default: 'Science Page Hero' }}"
>
  {% if section.settings.background_image %}
    <img
      class="hero-bg-sphero"
      src="{{ section.settings.background_image | image_url: width: 2000 }}"
      alt="{{ section.settings.background_image.alt | default: '' }}"
      width="{{ section.settings.background_image.width }}"
      height="{{ section.settings.background_image.height }}"
      loading="eager"
    >
  {% else %}
    <div class="hero-bg-placeholder-sphero"></div>
  {% endif %}

  <div class="hero-content-sphero">
    <!-- Title + Subtitle (top-left) -->
    <div class="hero-text-sphero">
      <h1 class="hero-title-sphero">
        {{ section.settings.title | default: 'Your Daily Dose of Luxury' }}
      </h1>
      <p class="hero-subtitle-sphero">
        {{ section.settings.subtitle | default: 'skin elasticity at a cellular level. Technology skin elasticity at a cellular level.' }}
      </p>
    </div>

    <!-- Frosted glass box (bottom-right) -->
    <div class="hero-bottom-row-sphero">
      <div class="hero-glass-sphero">
        <!-- Diagonal arrow SVG top-left corner -->
        <div class="hero-glass-arrow-sphero" aria-hidden="true">
          <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <line x1="5" y1="5" x2="16" y2="16" stroke="#222222" stroke-width="2.5" stroke-linecap="round"/>
            <polyline points="15,5 5,5 5,15" stroke="#222222" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </div>

        {% assign glass_slide_index = 0 %}
        {% assign glass_has_image = false %}
        {% for i in (1..8) %}
          {% assign img_key = 'glass_image_' | append: i %}
          {% assign img = section.settings[img_key] %}
          {% if img %}
            {% assign glass_has_image = true %}
            <img
              class="hero-glass-slide-sphero{% if glass_slide_index == 0 %} active-sphero{% endif %}"
              src="{{ img | image_url: width: 600 }}"
              alt="{{ img.alt | default: '' }}"
              width="{{ img.width }}"
              height="{{ img.height }}"
              loading="{% if glass_slide_index == 0 %}eager{% else %}lazy{% endif %}"
              data-glass-slide-sphero="{{ glass_slide_index }}"
            >
            {% assign glass_slide_index = glass_slide_index | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% unless glass_has_image %}
          <div class="hero-glass-img-placeholder-sphero">IMAGE</div>
        {% endunless %}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var section = document.getElementById('science-page-hero-{{ section.id }}');
    if (!section) return;
    var slides = section.querySelectorAll('[data-glass-slide-sphero]');
    if (slides.length < 2) return;
    var current = 0;
    setInterval(function () {
      slides[current].classList.remove('active-sphero');
      current = (current + 1) % slides.length;
      slides[current].classList.add('active-sphero');
    }, 2000);
  })();
</script>

{% schema %}
{
  "name": "Science Page Hero Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_top_margin",
      "label": "Top Margin (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Height (px)",
      "min": 300,
      "max": 900,
      "step": 10,
      "default": 520
    },
    {
      "type": "header",
      "content": "Background Image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Your Daily Dose of Luxury"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title Font Size (px)",
      "min": 24,
      "max": 100,
      "step": 2,
      "default": 56
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Subtitle"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "skin elasticity at a cellular level. Technology skin elasticity at a cellular level."
    },
    {
      "type": "range",
      "id": "subtitle_font_size",
      "label": "Subtitle Font Size (px)",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 19
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Frosted Glass Box — Images (up to 8)"
    },
    {
      "type": "image_picker",
      "id": "glass_image_1",
      "label": "Glass Image 1"
    },
    {
      "type": "image_picker",
      "id": "glass_image_2",
      "label": "Glass Image 2"
    },
    {
      "type": "image_picker",
      "id": "glass_image_3",
      "label": "Glass Image 3"
    },
    {
      "type": "image_picker",
      "id": "glass_image_4",
      "label": "Glass Image 4"
    },
    {
      "type": "image_picker",
      "id": "glass_image_5",
      "label": "Glass Image 5"
    },
    {
      "type": "image_picker",
      "id": "glass_image_6",
      "label": "Glass Image 6"
    },
    {
      "type": "image_picker",
      "id": "glass_image_7",
      "label": "Glass Image 7"
    },
    {
      "type": "image_picker",
      "id": "glass_image_8",
      "label": "Glass Image 8"
    },
    {
      "type": "range",
      "id": "glass_width",
      "label": "Glass Box Width (px)",
      "min": 100,
      "max": 600,
      "step": 10,
      "default": 280
    },
    {
      "type": "range",
      "id": "glass_height",
      "label": "Glass Box Height (px)",
      "min": 100,
      "max": 500,
      "step": 10,
      "default": 220
    },
    {
      "type": "range",
      "id": "glass_border_radius",
      "label": "Glass Box Border Radius (px)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "Science Page Hero Section"
    }
  ]
}
{% endschema %}