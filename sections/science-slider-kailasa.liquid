        color: var(--s5-mob-bullet-color, #333);
        font-style: var(--s5-mob-bullet-style, normal);
        line-height: 1.5;
      }

      /* Vertical label shown at bottom of text cell */
      .s5-vert-label-ssk {
        writing-mode: horizontal-tb;
        transform: none;
        text-align: center;
        font-size: var(--s5-mob-label-size, 12px);
        font-weight: var(--s5-mob-label-weight, 600);
