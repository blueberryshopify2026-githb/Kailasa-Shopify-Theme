      /* Points list */
      .s3-points-ssk { order: 3; }

      /* Points as clickable tiles */
      .s3-points-ssk {
        margin-top: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .s3-point-ssk {
