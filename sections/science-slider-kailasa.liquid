{% comment %}
  Science Slider Kailasa
  5-slide science/ingredient slider with smooth looping transitions.
  CSS suffix: -ssk | Font: Montserrat | Cyan: #4fffff
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap"
  rel="stylesheet"
>

<style>
    .section-ssk {
      font-family: 'Montserrat', sans-serif;
      background: #fff;
      overflow: hidden;
      position: relative;
      margin-top: 100px;
    }

    /* ── Slider wrapper ── */
    .slider-overflow-ssk {
      overflow: hidden;
      width: 100%;
    }

    .slider-track-ssk {
      display: flex;
      transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: transform;
    }

    .slide-ssk {
      min-width: 100%;
      display: flex;
      flex-direction: row;
      align-items: stretch;
      flex-shrink: 0;
    }

    /* ── Left content pane ── */
    .slide-left-ssk {
      flex: 0 0 50%;
      max-width: 50%;
      height: {{ section.settings.section_height }}px;
      max-height: {{ section.settings.section_height }}px;
      padding: 50px 56px 80px 50px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: #fff;
      box-sizing: border-box;
      overflow: hidden;
    }

    .slide-heading-ssk {
      font-size: var(--s1-desk-heading-size, 50px);
      font-weight: var(--s1-desk-heading-weight, 800);
      line-height: 1.1;
      color: var(--s1-desk-heading-color, #000);
      font-style: var(--s1-desk-heading-style, normal);
      margin: 0 0 10px 0;
      text-transform: uppercase;
      letter-spacing: -0.5px;
    }

    .slide-subheading-ssk {
      font-size: var(--s1-desk-subheading-size, 26px);
      font-weight: var(--s1-desk-subheading-weight, 600);
      color: var(--s1-desk-subheading-color, #1a1a1a);
      font-style: var(--s1-desk-subheading-style, normal);
      margin: 0 0 14px 0;
      letter-spacing: -0.5px;
    }

    .slide-description-ssk {
      font-size: var(--s1-desk-desc-size, 18px);
      font-weight: var(--s1-desk-desc-weight, 400);
      color: var(--s1-desk-desc-color, #222222);
      font-style: var(--s1-desk-desc-style, normal);
      line-height: 1.65;
      margin: 0 0 28px 0;
      max-width: 600px;
    }

    /* ── Feature cards (PDRN / SNAIL MUCIN) ── */
    .slide-cards-ssk {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-bottom: 36px;
      max-width: 560px;
    }

    .slide-card-ssk {
      background: #d2fcfaff;
      border-radius: 6px;
      padding: 14px 16px;
    }

    .slide-card-title-ssk {
      font-size: var(--s1-desk-card-title-size, 14px);
      font-weight: var(--s1-desk-card-title-weight, 700);
      color: var(--s1-desk-card-title-color, #000);
      font-style: var(--s1-desk-card-title-style, normal);
      margin: 0 0 4px 0;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    .slide-card-text-ssk {
      font-size: var(--s1-desk-card-text-size, 16px);
      font-weight: var(--s1-desk-card-text-weight, 400);
      color: var(--s1-desk-card-text-color, #242424);
      font-style: var(--s1-desk-card-text-style, normal);
      margin: 0;
      line-height: 1.5;
    }

    /* ── Icon row ── */
    .slide-icons-row-ssk {
      display: flex;
      gap: 40px;
      align-items: center;
    }

    .slide-icon-item-ssk {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      max-width: 190px;
    }

    .slide-icon-img-ssk {
      width: 65px;
      height: 65px;
      object-fit: contain;
    }

    /* SVG placeholder icon wrapper */
    .slide-icon-svg-ssk {
      width: 65px;
      height: 65px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .slide-icon-svg-ssk svg {
      width: 65px;
      height: 65px;
      stroke: #222;
      fill: none;
      stroke-width: 1.5;
    }

    .slide-icon-label-ssk {
      font-size: var(--s1-desk-icon-label-size, 15px);
      font-weight: var(--s1-desk-icon-label-weight, 700);
      color: var(--s1-desk-icon-label-color, #000);
      font-style: var(--s1-desk-icon-label-style, normal);
      text-transform: uppercase;
      letter-spacing: 0.3px;
      margin: 0;
    }

    .slide-icon-desc-ssk {
      font-size: var(--s1-desk-icon-desc-size, 15px);
      font-weight: var(--s1-desk-icon-desc-weight, 400);
      color: var(--s1-desk-icon-desc-color, #000);
      font-style: var(--s1-desk-icon-desc-style, normal);
      line-height: 1.4;
      margin: 0;
      text-align: center;
    }

    /* ── Right image pane ── */
    .slide-right-ssk {
      flex: 0 0 50%;
      max-width: 50%;
      position: relative;
      overflow: hidden;
      height: {{ section.settings.section_height }}px;
      max-height: {{ section.settings.section_height }}px;
    }

    .slide-right-ssk img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .slide-right-placeholder-ssk {
      width: 100%;
      height: 100%;
      min-height: 540px;
      background: linear-gradient(135deg, #d0eef5 0%, #b0d8e8 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Montserrat', sans-serif;
      font-size: 22px;
      font-weight: 700;
      color: #4fffff;
      letter-spacing: 1px;
    }

    /* ── Navigation arrows ── */
    .slider-nav-ssk {
      position: absolute;
      bottom: 45px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 12px;
      z-index: 10;
    }

    .slider-btn-ssk {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: #fff;
      border: 3px solid #4fffff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.25s ease, border-color 0.25s ease;
      outline: none;
      padding: 0;
    }

    .slider-btn-ssk svg {
      width: 27px;
      height: 27px;
      stroke: #4fffff;
      fill: none;
      stroke-width: 2.7;
      stroke-linecap: round;
      stroke-linejoin: round;
      transition: stroke 0.25s ease;
    }

    @media (hover: hover) {
      .slider-btn-ssk:hover {
        background: #4fffff;
        border-color: #4fffff;
      }

      .slider-btn-ssk:hover svg {
        stroke: #fff;
      }
    }

    /* ── Placeholder slides ── */
    .slide-placeholder-ssk {
      min-width: 100%;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      height: {{ section.settings.section_height }}px;
      background: #f5fffe;
      font-family: 'Montserrat', sans-serif;
      font-size: 28px;
      font-weight: 700;
      color: #4fffff;
      letter-spacing: 2px;
    }

    /* ── Slide 2 ── */
    .s2-slide-ssk {
      min-width: 100%;
      flex-shrink: 0;
      display: flex;
      flex-direction: row;
      align-items: stretch;
      height: {{ section.settings.section_height }}px;
      
    }

    .s2-image-pane-ssk {
      flex: 0 0 60%;
      max-width: 60%;
      position: relative;
      overflow: hidden;
    }

    .s2-img-ssk {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 0.5s ease;
    }

    .s2-img-ssk.s2-img-active-ssk {
      opacity: 1;
    }

    .s2-img-placeholder-ssk {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #cce8f0 0%, #a8d4e0 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      font-weight: 700;
      color: #4fffff;
    }

    .s2-content-pane-ssk {
      flex: 0 0 40%;
      max-width: 40%;
      padding: 90px 36px 10px 36px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: #fff;
      box-sizing: border-box;
      overflow-y: visible;
    }

    .s2-heading-ssk {
      font-family: 'Montserrat', sans-serif;
      font-size: var(--s2-desk-heading-size, 40px);
      font-weight: var(--s2-desk-heading-weight, 800);
      line-height: 1.1;
      color: var(--s2-desk-heading-color, #000);
      font-style: var(--s2-desk-heading-style, normal);
      text-transform: uppercase;
      {% comment %} margin: 0 0 5px 0; {% endcomment %}
      letter-spacing: -0.3px;
    }

    .s2-desc-ssk {
      font-family: 'Montserrat', sans-serif;
      font-size: var(--s2-desk-desc-size, 16px);
      font-weight: var(--s2-desk-desc-weight, 500);
      color: var(--s2-desk-desc-color, #000);
      font-style: var(--s2-desk-desc-style, normal);
      margin: 0 0 20px 0;
      line-height: 1.5;
    }

    .s2-boxes-ssk {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .s2-box-ssk {
      border: 1.5px solid #ccc;
      background: #fafafaff;
      border-radius: 6px;
      padding: 12px 16px;
      cursor: pointer;
      transition: border-color 0.25s ease, background 0.25s ease;
    }

    .s2-box-ssk:hover,
    .s2-box-ssk.s2-box-active-ssk {
      border: 3px solid #4fffff;
      background: #f5f5f5;
    }

    .s2-box-title-ssk {
      font-family: 'Montserrat', sans-serif;
      font-size: var(--s2-desk-box-title-size, 14px);
      font-weight: var(--s2-desk-box-title-weight, 700);
      color: var(--s2-desk-box-title-color, #000);
      font-style: var(--s2-desk-box-title-style, normal);
      margin: 0 0 3px 0;
    }

    .s2-box-text-ssk {
      font-family: 'Montserrat', sans-serif;
      font-size: var(--s2-desk-box-text-size, 14px);
      font-weight: var(--s2-desk-box-text-weight, 400);
      color: var(--s2-desk-box-text-color, #252525);
      font-style: var(--s2-desk-box-text-style, normal);
      margin: 0;
      line-height: 1.4;
    }

    /* Mobile/tablet image for slide 2 — hidden on desktop */
    .s2-mob-image-ssk {
      display: none;
    }

      /* Mobile/tablet image container — hidden on desktop */
      .s3-mob-image-ssk { display: none; }
      .s3-mob-img-mob-ssk, .s3-mob-img-tab-ssk { display: none; }

    /* ── Slide 3 ── */
    .s3-slide-ssk {
      min-width: 100%;
      flex-shrink: 0;
      display: flex;
      flex-direction: row;
      align-items: stretch;
      height: {{ section.settings.section_height }}px;
    }

    /* Left image pane 60% */
    .s3-image-pane-ssk {
      flex: 0 0 60%;
      max-width: 60%;
      position: relative;
      overflow: hidden;
      background: #f0f4f8;
    }

    .s3-main-img-ssk {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .s3-main-placeholder-ssk {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #daeef5 0%, #b8d8e8 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      font-weight: 700;
      color: #4fffff;
      font-family: 'Montserrat', sans-serif;
    }

    /* Dot hotspots */
    .s3-dot-ssk {
      position: absolute;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: #222;
      color: #fff;
      font-family: 'Montserrat', sans-serif;
      font-size: 12px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.25s ease;
      z-index: 5;
      transform: translate(-50%, -50%);
    }

    .s3-dot-ssk:hover,
    .s3-dot-ssk.s3-dot-active-ssk {
      background: #4fffff;
      color: #000;
      width: 32px;
      height: 32px;
      font-size: 14px;
      transition: all 0.4s ease;
    }

    /* Right content pane 40% */
    .s3-content-pane-ssk {
      flex: 0 0 40%;
      max-width: 40%;
      padding: 44px 36px 5px 36px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: #fff;
      box-sizing: border-box;
    }

    .s3-heading-ssk {
      font-family: 'Montserrat', sans-serif;
      font-size: var(--s3-desk-heading-size, 36px);
      text-transform: uppercase;
      font-weight: var(--s3-desk-heading-weight, 800);
      line-height: 1.15;
      color: var(--s3-desk-heading-color, #000);
      font-style: var(--s3-desk-heading-style, normal);
      {% comment %} margin: 0 0 32px 0; {% endcomment %}
    }

    .s3-points-ssk {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin-top: 20px;
    }

    .s3-point-ssk {
      display: flex;
      gap: 14px;
      align-items: flex-start;
      padding: 11px 16px;
      border: 3px solid transparent;
      border-radius: 8px;
      transition: border-color 0.25s ease;
      cursor: default;
    }

    .s3-point-ssk.s3-point-active-ssk {
      border-color: #4fffff;
    }

    .s3-point-num-ssk {
      font-family: 'Montserrat', sans-serif;
      font-size: 16px;
      font-weight: 700;
      color: #000;
      min-width: 20px;
      padding-top: 1px;
    }

    .s3-point-body-ssk {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .s3-point-title-ssk {
      font-family: 'Montserrat', sans-serif;
      font-size: var(--s3-desk-point-title-size, 16px);
      font-weight: var(--s3-desk-point-title-weight, 700);
      color: var(--s3-desk-point-title-color, #000);
      font-style: var(--s3-desk-point-title-style, normal);
      margin: 0;
    }
  {% comment %}
   .s3-point-title-ssk.s3-point-title-active-ssk {
      font-size: 17px;
      transition: all 0.4s ease;
    }  {% endcomment %}

    .s3-point-desc-ssk {
      font-family: 'Montserrat', sans-serif;
      font-size: var(--s3-desk-point-desc-size, 15px);
      font-weight: var(--s3-desk-point-desc-weight, 400);
      color: var(--s3-desk-point-desc-color, #2c2c2c);
      font-style: var(--s3-desk-point-desc-style, normal);
      margin: 0;
      line-height: 1.45;
    }
  {% comment %}
    .s3-point-desc-ssk.s3-point-desc-active-ssk {
      font-size: 16px;
      transition: all 0.4s ease;
    } {% endcomment %}

    /* ── Slide 4 ── */
    .s4-slide-ssk {
      min-width: 100%;
      flex-shrink: 0;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      height: {{ section.settings.section_height }}px;
      overflow: hidden;
      font-family: 'Montserrat', sans-serif;
    }

    .s4-bg-img-ssk {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      z-index: 0;
    }

    .s4-bg-placeholder-ssk {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #c8e8f5 0%, #a0cfe8 100%);
      z-index: 0;
    }

    /* Frosted glass card */
    .s4-glass-ssk {
      position: relative;
      z-index: 2;
      background: rgba(255, 255, 255, 0.20);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.75);
      border-radius: 15px;
      padding: 40px 80px 40px;
      max-width: 840px;
      width: 80%;
      text-align: center;
      box-shadow: 0 8px 40px rgba(0, 0, 0, 0.08);
      margin-top: 90px;
    }

    /* Fixed-height text block so card never resizes */
    .s4-text-block-ssk {
      height: 110px;
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      overflow: hidden;
      margin-bottom: 28px;
    }

    .s4-title-ssk {
      font-size: 30px;
      font-weight: 800;
      color: #000;
      margin: 0 0 8px 0;
      letter-spacing: -0.3px;
      flex-shrink: 0;
    }

    .s4-subtitle-ssk {
      font-size: 17px;
      font-weight: 400;
      color: #1b1b1bff;
      margin: 0;
      line-height: 1.5;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
    }

    /* Icon row */
    .s4-icons-row-ssk {
      display: flex;

      justify-content: center;
      gap: 50px;
      margin-top: 50px;
    }

    .s4-icon-item-ssk {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      flex: 1;
      padding: 0 8px;
      cursor: default;
      position: relative;
    }

    .s4-icon-img-ssk {
      width: 62px;
      height: 62px;
      object-fit: contain;
    }

    .s4-icon-svg-ssk {
      width: 62px;
      height: 62px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .s4-icon-svg-ssk svg {
      width: 58px;
      height: 58px;
      stroke: #333;
      fill: none;
      stroke-width: 1.4;
    }

    .s4-icon-label-ssk {
      font-size: 13px;
      font-weight: 700;
      color: #000;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin: 0;
      position: relative;
      padding-bottom: 10px;
    }

    /* Active underline — cyan, default on icon 1, hover on any */
    .s4-icon-item-ssk .s4-icon-label-ssk::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: #4fffff;
      border-radius: 2px;
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    .s4-icon-item-ssk.s4-icon-active-ssk .s4-icon-label-ssk::after,
    .s4-icon-item-ssk:hover .s4-icon-label-ssk::after {
      opacity: 1;
    }

    /* ── Slide 5 ── */
    .s5-slide-ssk {
      min-width: 100%;
      flex-shrink: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: {{ section.settings.section_height }}px;
      background: #eef5f8;
      box-sizing: border-box;
      padding: 0;
      gap: 12px;
    }

    .s5-row-ssk {
      display: grid;
      grid-template-columns: 1fr 100px 1fr;
      flex: 1;
      min-height: 0;
    }

    /* Left image cell */
    .s5-img-cell-ssk {
      position: relative;
      overflow: hidden;
    }

    .s5-img-cell-ssk img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .s5-img-placeholder-ssk {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #cce4ef 0%, #a8cfe0 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Montserrat', sans-serif;
      font-size: 13px;
      font-weight: 600;
      color: #4fffff;
    }

    /* Middle vertical label cell */
    .s5-mid-cell-ssk {
      background: #eef5f8;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .s5-vert-label-ssk {
      font-family: 'Montserrat', sans-serif;
      font-size: var(--s5-desk-label-size, 19px);
      font-weight: var(--s5-desk-label-weight, 600);
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--s5-desk-label-color, #555);
      font-style: var(--s5-desk-label-style, normal);
      writing-mode: vertical-rl;
      text-orientation: mixed;
      transform: rotate(180deg);
      white-space: nowrap;
    }

    /* Right text cell */
    .s5-text-cell-ssk {
      background: #fff;
      display: flex;
      flex-direction: column;
      {% comment %} justify-content: center; {% endcomment %}
      padding: 24px 36px;
      box-sizing: border-box;
    }

    .s5-right-text-container-ssk {
      margin-top: 50px;
    }

    .s5-text-title-ssk {
      font-family: 'Montserrat', sans-serif;
      font-size: var(--s5-desk-title-size, 19px);
      font-weight: var(--s5-desk-title-weight, 700);
      color: var(--s5-desk-title-color, #000);
      font-style: var(--s5-desk-title-style, normal);
      text-transform: uppercase;
      letter-spacing: 0.3px;
      margin: 0 0 12px 0;
      padding-bottom: 10px;
      display: inline-block;
      position: relative;
    }

    .s5-text-title-ssk::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 70px;
      height: 4px;
      background: #4fffff;
      border-radius: 2px;
    }

