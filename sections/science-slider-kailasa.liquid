      /* Re-show mid cell as bottom label strip */
      .s5-mid-cell-ssk {
        display: flex;
        order: 3;
        flex: 0 0 100%;
        max-width: 100%;
        background: #eef5f8;
        justify-content: center;
        align-items: center;
        padding: 8px 0;
