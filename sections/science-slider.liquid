  /* Technology Showcase Slide Styles - 60/40 Split Layout */
  .technology-slide {
    background: #ffffff;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .technology-split-layout {
    display: grid;
    grid-template-columns: 60% 40%;
    width: 100%;
    height: 100vh;
    gap: 0;
    overflow: hidden !important;
    max-width: 100vw;
    box-sizing: border-box;
  }

  .technology-image-section {
    position: relative;
    overflow: hidden;
    background: #f8f9fa;
  }

  .technology-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .technology-bg-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f0f0f0 0%, #e0e0e0 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    font-size: 1.2rem;
    font-weight: 600;
  }

  .technology-points-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .overlay-point {
    position: absolute;
    width: 40px;
    height: 40px;
    background: rgba(0, 0, 0, 0.8);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    pointer-events: all;
    z-index: 15;
  }

  .overlay-point:hover {
    background: #4fffff;
    transform: scale(1.1);
  }

  .overlay-point.active {
    background: #4fffff;
    transform: scale(1.2);
  }

  .point-number {
    color: #ffffff;
    font-weight: 700;
    font-size: 1.1rem;
  }

  .overlay-point:hover .point-number,
  .overlay-point.active .point-number {
    color: #000000;
  }

  .arrow-lines {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
  }

  .arrow-line {
    position: absolute;
    height: 2px;
    background: #000000;
    transition: all 0.3s ease;
    transform-origin: right center;
  }

  .arrow-line::after {
    content: '';
    position: absolute;
    right: 0;
    top: -4px;
    width: 0;
    height: 0;
    border-left: 10px solid #000000;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
  }

  .line-1 {
    width: 60%;
    top: 45%;
    left: calc(30% + 20px);
    transform: translateY(-50%);
  }

  .line-2 {
    width: 40%;
    top: 70%;
    left: calc(70% + 20px);
    transform: translateY(-50%);
  }

  .line-3 {
    width: 60%;
    top: 95%;
    left: calc(25% + 20px);
    transform: translateY(-50%);
  }

  .technology-content-section {
    background: #ffffff;
    padding: 0 40px 60px 40px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  .content-header {
    margin: 0 0 40px 0;
    padding: 0;
  }

  .technology-main-title {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 700;
    color: #000000;
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-align: left;
    padding-top: 40px;
  }

  .content-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 0;
    height: 100%;
