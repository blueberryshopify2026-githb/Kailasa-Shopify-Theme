  .content-item.item-1 {
    margin-top: 0;
  }

  .content-item.item-2 {
    margin-top: 20px;
  }

  .content-item.item-3 {
    margin-top: 10px;
  }

  .content-item:hover {
    transform: translateX(5px);
  }

  .content-item.highlighted {
    transform: translateX(5px);
  }

  .content-number {
    font-size: 1.4rem;
    font-weight: 700;
    color: #000000;
