{% comment %}
  Science Slider Section - Full Screen Slider
  Clean, focused design for molecular science showcase
{% endcomment %}

<section class="science-slider-section">
  <div class="slider-container">
    <div class="slides-wrapper" id="slidesWrapper">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="slide" data-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {% if block.type == 'molecular_standard' %}
              <div class="slide-content molecular-slide">
                <div class="slide-layout">
                  <div class="left-panel">
                    <h1 class="main-title">{{ block.settings.main_title | default: 'THE MOLECULAR<br>STANDARD.' }}</h1>

                    <div class="slide-header">
                      <h2 class="slide-subtitle">{{ block.settings.subtitle | default: 'The Molecular Standard.' }}</h2>
                    </div>

                    <p class="description">
                      {{
                        block.settings.description
                        | default: 'Harnessing South Korea patented fermentation technology skin elasticity at a cellular level.'
                      }}
                    </p>

                    <div class="feature-boxes">
                      <div class="feature-box">
                        <h4>{{ block.settings.feature_1_title | default: 'PDRN:' }}</h4>
                        <p>{{ block.settings.feature_1_desc | default: 'DNA-based rejuvenation.' }}</p>
                      </div>

                      <div class="feature-box">
                        <h4>{{ block.settings.feature_2_title | default: 'SNAIL MUCIN' }}</h4>
                        <p>{{ block.settings.feature_2_desc | default: 'Advanced barrier repair' }}</p>
                      </div>
                    </div>

                    <div class="molecular-icons">
                      <!-- Icons Row -->
                      <div class="icons-row">
                        <div class="icon-container">
                          {% if block.settings.icon_1_image %}
                            <img
                              src="{{ block.settings.icon_1_image | image_url: width: 80 }}"
                              alt="{{ block.settings.icon_1_title }}"
                              width="80"
                              height="80"
                              class="molecular-icon"
                            >
                          {% else %}
                            <div class="icon-placeholder pdrn-icon"></div>
                          {% endif %}
                        </div>

                        <div class="icon-container">
                          {% if block.settings.icon_2_image %}
                            <img
                              src="{{ block.settings.icon_2_image | image_url: width: 80 }}"
                              alt="{{ block.settings.icon_2_title }}"
                              width="80"
                              height="80"
                              class="molecular-icon"
                            >
                          {% else %}
                            <div class="icon-placeholder ceramides-icon"></div>
                          {% endif %}
                        </div>

                        <div class="icon-container">
                          {% if block.settings.icon_3_image %}
                            <img
                              src="{{ block.settings.icon_3_image | image_url: width: 80 }}"
                              alt="{{ block.settings.icon_3_title }}"
                              width="80"
                              height="80"
                              class="molecular-icon"
                            >
                          {% else %}
                            <div class="icon-placeholder peptides-icon"></div>
                          {% endif %}
                        </div>
                      </div>

                      <!-- Titles Row -->
                      <div class="titles-row">
                        <h5 class="icon-title">{{ block.settings.icon_1_title | default: 'PDRN' }}</h5>
                        <h5 class="icon-title">{{ block.settings.icon_2_title | default: 'CERAMIDES' }}</h5>
                        <h5 class="icon-title">{{ block.settings.icon_3_title | default: 'PEPTIDES' }}</h5>
                      </div>

                      <!-- Descriptions Row -->
                      <div class="descriptions-row">
                        <p class="icon-desc">{{ block.settings.icon_1_desc | default: 'DNA-based rejuvenation.' }}</p>
                        <p class="icon-desc">
                          {{ block.settings.icon_2_desc | default: 'Barrier strength and protration' }}
                        </p>
                        <p class="icon-desc">
                          {{ block.settings.icon_3_desc | default: 'Collagen synthesis and elasticity' }}
                        </p>
                      </div>
                    </div>
                  </div>

                  <div class="right-panel">
                    {% if block.settings.media_type == 'video' and block.settings.background_video %}
                      <video autoplay muted loop class="background-video" width="600" height="400">
                        <source src="{{ block.settings.background_video | asset_url }}" type="video/mp4">
                      </video>
                    {% elsif block.settings.background_image %}
                      <img
                        src="{{ block.settings.background_image | image_url: width: 600 }}"
                        alt="Molecular background"
                        class="background-image"
                        width="600"
                        height="400"
                      >
                    {% else %}
                      <div class="molecular-background">
                        <div class="molecular-pattern"></div>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>

            {% elsif block.type == 'clinical_dossier' %}
              <div class="slide-content clinical-slide">
                <div
                  class="clinical-layout"
                  style="grid-template-columns: {{ block.settings.left_ratio | default: 60 }}% {{ block.settings.right_ratio | default: 40 }}%;"
                >
                  <!-- Left Side - Image Display -->
                  <div class="clinical-left">
                    <div class="image-display-area">
                      <div class="clinical-image-container" id="clinicalImageContainer">
                        {% for i in (1..6) %}
                          {% assign card_image = 'card_' | append: i | append: '_image' %}
                          {% if block.settings[card_image] %}
                            <img
                              src="{{ block.settings[card_image] | image_url: width: 500 }}"
                              alt="Card {{ i }} image"
                              class="clinical-image card-image-{{ i }}"
                              width="500"
                              height="400"
                              style="display: {% if i == 1 %}block{% else %}none{% endif %}; object-fit: {{ block.settings.image_fit | default: 'cover' }};"
                            >
                          {% endif %}
                        {% endfor %}
                      </div>
                    </div>
                  </div>

                  <!-- Cyan Divider Line -->
                  {% if block.settings.show_divider %}
                    <div
                      class="clinical-divider"
                      style="background-color: {{ block.settings.divider_color | default: '#00bcd4' }}; left: {{ block.settings.left_ratio | default: 60 }}%;"
                    ></div>
                  {% endif %}

                  <!-- Right Side - Content and Cards -->
                  <div class="clinical-right">
                    <div class="right-content">
                      <div class="right-header">
                        <h2 class="molecular-title">
                          {{ block.settings.right_title | default: 'THE MOLECULAR FOUNDATIONS' }}
                        </h2>
                        <p class="molecular-subtitle">
                          {{
                            block.settings.right_subtitle
                            | default: 'Beyond the surface. We engineer the architecture.'
                          }}
                        </p>
                      </div>

                      <!-- Interactive Cards -->
                      <div class="clinical-cards">
                        {% for i in (1..6) %}
                          {% assign card_title = 'card_' | append: i | append: '_title' %}
                          {% assign card_subtitle = 'card_' | append: i | append: '_subtitle' %}

                          <div
                            class="clinical-card"
                            data-card="{{ i }}"
                            onmouseover="showCardImage({{ i }})"
                            onclick="showCardImage({{ i }})"
                            style="border-radius: {{ block.settings.card_border_radius | default: 25 }}px;"
                          >
                            <div class="card-content">
                              <div class="card-left">
                                <div class="card-text">
                                  <h3 class="card-title">{{ block.settings[card_title] | default: 'Card title' }}</h3>
                                  <p class="card-subtitle">
                                    {{ block.settings[card_subtitle] | default: 'Card description text' }}
                                  </p>
                                </div>
                              </div>
                            </div>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            {% elsif block.type == 'technology_showcase' %}
              <div class="slide-content technology-slide">
                <div class="technology-split-layout">
                  <!-- Left 60% - Image with Points -->
                  <div class="technology-image-section">
                    {% if block.settings.main_image %}
                      <img
                        src="{{ block.settings.main_image | image_url: width: 1200 }}"
                        alt="{{ block.settings.main_title }}"
                        class="technology-bg-image"
                        width="1200"
                        height="800"
                      >
                    {% else %}
                      <div class="technology-bg-placeholder">
                        <p>Upload your main background image</p>
                      </div>
                    {% endif %}

                    <!-- Overlay Points on Image -->
                    <div class="technology-points-overlay">
                      <div
                        class="overlay-point point-1"
                        data-point="1"
                        style="top: {{ block.settings.point_1_top | default: 45 }}%; left: {{ block.settings.point_1_left | default: 30 }}%;"
                        onmouseover="highlightPoint(1)"
                        onmouseout="unhighlightPoint(1)"
                        onclick="selectPoint(1)"
                      >
                        <span class="point-number">1</span>
                      </div>

                      <div
                        class="overlay-point point-2"
                        data-point="2"
                        style="top: {{ block.settings.point_2_top | default: 70 }}%; left: {{ block.settings.point_2_left | default: 70 }}%;"
                        onmouseover="highlightPoint(2)"
                        onmouseout="unhighlightPoint(2)"
                        onclick="selectPoint(2)"
                      >
                        <span class="point-number">2</span>
                      </div>

                      <div
                        class="overlay-point point-3"
                        data-point="3"
                        style="top: {{ block.settings.point_3_top | default: 95 }}%; left: {{ block.settings.point_3_left | default: 25 }}%;"
                        onmouseover="highlightPoint(3)"
                        onmouseout="unhighlightPoint(3)"
                        onclick="selectPoint(3)"
                      >
                        <span class="point-number">3</span>
                      </div>

                      <!-- Arrow Lines -->
                      {% if block.settings.show_arrows != false %}
                        <div class="arrow-lines">
                          <div
                            class="arrow-line line-1"
                            data-line="1"
                            style="width: {{ block.settings.arrow_1_width | default: 60 }}%; top: {{ block.settings.point_1_top | default: 45 }}%; left: calc({{ block.settings.point_1_left | default: 30 }}% + 20px);"
                          ></div>
                          <div
                            class="arrow-line line-2"
                            data-line="2"
                            style="width: {{ block.settings.arrow_2_width | default: 40 }}%; top: {{ block.settings.point_2_top | default: 70 }}%; left: calc({{ block.settings.point_2_left | default: 70 }}% + 20px);"
                          ></div>
                          <div
                            class="arrow-line line-3"
                            data-line="3"
                            style="width: {{ block.settings.arrow_3_width | default: 60 }}%; top: {{ block.settings.point_3_top | default: 95 }}%; left: calc({{ block.settings.point_3_left | default: 25 }}% + 20px);"
                          ></div>
                        </div>
                      {% endif %}
                    </div>
                  </div>

                  <!-- Right 40% - Content Area -->
                  <div class="technology-content-section">
                    <!-- Main Title -->
                    <div class="content-header">
                      <h1 class="technology-main-title">
                        {{ block.settings.main_title | default: 'Derm proven retinol with patented technology' }}
                      </h1>
                    </div>

                    <!-- Structured Content List -->
                    <div class="content-list">
                      <!-- Point 1 Content -->
                      <div
                        class="content-item item-1"
                        data-content="1"
                        onmouseover="highlightPoint(1)"
                        onmouseout="unhighlightPoint(1)"
                        onclick="selectPoint(1)"
                      >
                        <div class="content-number">1.</div>
                        <div class="content-text">
                          <h3 class="point-title">
                            {{ block.settings.point_1_title | default: 'Derm proven retinol' }}
                          </h3>
                          <p class="point-description">
                            {{ block.settings.point_1_description | default: 'Helps to fade lines and wrinkles' }}
                          </p>
                        </div>
                      </div>

                      <!-- Point 2 Content -->
                      <div
                        class="content-item item-2"
                        data-content="2"
                        onmouseover="highlightPoint(2)"
                        onmouseout="unhighlightPoint(2)"
                        onclick="selectPoint(2)"
                      >
                        <div class="content-number">2.</div>
                        <div class="content-text">
                          <h3 class="point-title">
                            {{ block.settings.point_2_title | default: 'Peptides' }}
                          </h3>
                          <p class="point-description">
                            {{
                              block.settings.point_2_description
                              | default: 'Helps improve skin firmness and elasticity'
                            }}
                          </p>
                        </div>
                      </div>

                      <!-- Point 3 Content -->
                      <div
                        class="content-item item-3"
                        data-content="3"
                        onmouseover="highlightPoint(3)"
                        onmouseout="unhighlightPoint(3)"
                        onclick="selectPoint(3)"
                      >
                        <div class="content-number">3.</div>
                        <div class="content-text">
                          <h3 class="point-title">
                            {{ block.settings.point_3_title | default: 'Soothing Complex' }}
                          </h3>
                          <p class="point-description">
                            {{
                              block.settings.point_3_description
                              | default: 'Helps nourish skin and minimize irritation'
                            }}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            {% elsif block.type == 'korean_beauty_showcase' %}
              <div class="slide-content korean-beauty-slide">
                <div class="korean-beauty-layout">
                  <!-- Background Image -->
                  <div class="korean-beauty-background">
                    {% if block.settings.background_image %}
                      <img
                        src="{{ block.settings.background_image | image_url: width: 1920 }}"
                        alt="{{ block.settings.main_heading }}"
                        class="korean-bg-image"
                        width="1920"
                        height="1080"
                        style="opacity: {{ block.settings.background_opacity | default: 1 }};"
                      >
                    {% else %}
                      <div class="korean-bg-placeholder">
                        <p>Upload your background image</p>
                      </div>
                    {% endif %}
                  </div>

                  <!-- Overlay Content -->
                  <div class="korean-beauty-overlay">
                    <!-- Main Content -->
                    <div class="korean-content-area">
                      <h1
                        class="korean-main-heading"
                        style="
                          font-size: {{ block.settings.main_heading_size | default: 48 }}px;
                          color: {{ block.settings.main_heading_color | default: '#000000' }};
                          text-align: {{ block.settings.main_heading_alignment | default: 'left' }};
                          font-weight: {{ block.settings.main_heading_weight | default: 700 }};
                        "
                        id="koreanMainHeading"
                        data-default-heading="{{ block.settings.default_main_heading | default: 'Where Korean beauty meets Precision' }}"
                      >
                        {{ block.settings.default_main_heading | default: 'Where Korean beauty meets Precision' }}
                      </h1>
                      <p
                        class="korean-subheading"
                        style="
                          font-size: {{ block.settings.subheading_size | default: 18 }}px;
                          color: {{ block.settings.subheading_color | default: '#000000' }};
                          text-align: {{ block.settings.subheading_alignment | default: 'left' }};
                          font-weight: {{ block.settings.subheading_weight | default: 400 }};
                        "
                        id="koreanSubheading"
                        data-default-subheading="{{ block.settings.default_subheading | default: 'Our formulations are built on decades of Korean dermatological research focusing on cellular repair, barrier health, and long-term skin resilience.' }}"
                      >
                        {{
                          block.settings.default_subheading
                          | default: 'Our formulations are built on decades of Korean dermatological research focusing on cellular repair, barrier health, and long-term skin resilience.'
                        }}
                      </p>
                    </div>

                    <!-- Interactive Icons Section -->
                    <div class="korean-icons-section">
                      <div
                        class="icons-container"
                        style="
                          background: rgba(255, 255, 255, {{ block.settings.glass_opacity | default: 0.2 }});
                          backdrop-filter: blur({{ block.settings.glass_blur | default: 10 }}px);
                          width: {{ block.settings.glass_width | default: 800 }}px;
                          height: {{ block.settings.glass_height | default: 120 }}px;
                          border-radius: {{ block.settings.glass_border_radius | default: 20 }}px;
                          padding: {{ block.settings.glass_padding_vertical | default: 30 }}px {{ block.settings.glass_padding_horizontal | default: 40 }}px;
                        "
                      >
                        <!-- Icon 1 -->
                        <div
                          class="korean-icon-item"
                          data-icon="1"
                          onmouseover="activateIcon(1)"
                          onmouseout="deactivateIcon(1)"
                          onclick="selectIcon(1)"
                        >
                          {% if block.settings.icon_1_image %}
                            <img
                              src="{{ block.settings.icon_1_image | image_url: width: 60 }}"
                              alt="{{ block.settings.icon_1_title }}"
                              class="icon-image"
                              width="60"
                              height="60"
                            >
                          {% else %}
                            <div class="icon-placeholder">
                              <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                                <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="2"/>
                                <path d="M15 20l5 5 10-10" stroke="currentColor" stroke-width="2" fill="none"/>
                              </svg>
                            </div>
                          {% endif %}
                          <span
                            class="icon-title"
                            style="
                              font-size: {{ block.settings.icon_title_size | default: 16 }}px;
                              color: {{ block.settings.icon_title_color | default: '#000000' }};
                              font-weight: {{ block.settings.icon_title_weight | default: 600 }};
                            "
                          >
                            {{ block.settings.icon_1_title | default: 'Repair' }}
                          </span>
                          <div
                            class="icon-underline"
                            style="background-color: {{ block.settings.underline_color | default: '#00bcd4' }};"
                          ></div>
                        </div>

                        <!-- Icon 2 -->
                        <div
                          class="korean-icon-item"
                          data-icon="2"
                          onmouseover="activateIcon(2)"
                          onmouseout="deactivateIcon(2)"
                          onclick="selectIcon(2)"
                        >
                          {% if block.settings.icon_2_image %}
                            <img
                              src="{{ block.settings.icon_2_image | image_url: width: 60 }}"
                              alt="{{ block.settings.icon_2_title }}"
                              class="icon-image"
                              width="60"
                              height="60"
                            >
                          {% else %}
                            <div class="icon-placeholder">
                              <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                                <path d="M20 5l5 10h10l-8 6 3 10-10-7-10 7 3-10-8-6h10z" stroke="currentColor" stroke-width="2" fill="none"/>
                              </svg>
                            </div>
                          {% endif %}
                          <span
                            class="icon-title"
                            style="
                              font-size: {{ block.settings.icon_title_size | default: 16 }}px;
                              color: {{ block.settings.icon_title_color | default: '#000000' }};
                              font-weight: {{ block.settings.icon_title_weight | default: 600 }};
                            "
                          >
                            {{ block.settings.icon_2_title | default: 'Renew' }}
                          </span>
                          <div
                            class="icon-underline"
                            style="background-color: {{ block.settings.underline_color | default: '#00bcd4' }};"
                          ></div>
                        </div>

                        <!-- Icon 3 -->
                        <div
                          class="korean-icon-item"
                          data-icon="3"
                          onmouseover="activateIcon(3)"
                          onmouseout="deactivateIcon(3)"
                          onclick="selectIcon(3)"
                        >
                          {% if block.settings.icon_3_image %}
                            <img
                              src="{{ block.settings.icon_3_image | image_url: width: 60 }}"
                              alt="{{ block.settings.icon_3_title }}"
                              class="icon-image"
                              width="60"
                              height="60"
                            >
                          {% else %}
                            <div class="icon-placeholder">
                              <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                                <circle cx="20" cy="20" r="15" stroke="currentColor" stroke-width="2"/>
                                <circle cx="20" cy="20" r="8" stroke="currentColor" stroke-width="2"/>
                              </svg>
                            </div>
                          {% endif %}
                          <span
                            class="icon-title"
                            style="
                              font-size: {{ block.settings.icon_title_size | default: 16 }}px;
                              color: {{ block.settings.icon_title_color | default: '#000000' }};
                              font-weight: {{ block.settings.icon_title_weight | default: 600 }};
                            "
                          >
                            {{ block.settings.icon_3_title | default: 'Protect' }}
                          </span>
                          <div
                            class="icon-underline"
                            style="background-color: {{ block.settings.underline_color | default: '#00bcd4' }};"
                          ></div>
                        </div>

                        <!-- Icon 4 -->
                        <div
                          class="korean-icon-item"
                          data-icon="4"
                          onmouseover="activateIcon(4)"
                          onmouseout="deactivateIcon(4)"
                          onclick="selectIcon(4)"
                        >
                          {% if block.settings.icon_4_image %}
                            <img
                              src="{{ block.settings.icon_4_image | image_url: width: 60 }}"
                              alt="{{ block.settings.icon_4_title }}"
                              class="icon-image"
                              width="60"
                              height="60"
                            >
                          {% else %}
                            <div class="icon-placeholder">
                              <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                                <path d="M10 20c0-5.5 4.5-10 10-10s10 4.5 10 10-4.5 10-10 10-10-4.5-10-10z" stroke="currentColor" stroke-width="2" fill="none"/>
                                <path d="M15 20l3 3 7-7" stroke="currentColor" stroke-width="2" fill="none"/>
                              </svg>
                            </div>
                          {% endif %}
                          <span
                            class="icon-title"
                            style="
                              font-size: {{ block.settings.icon_title_size | default: 16 }}px;
                              color: {{ block.settings.icon_title_color | default: '#000000' }};
                              font-weight: {{ block.settings.icon_title_weight | default: 600 }};
                            "
                          >
                            {{ block.settings.icon_4_title | default: 'Repair' }}
                          </span>
                          <div
                            class="icon-underline"
                            style="background-color: {{ block.settings.underline_color | default: '#00bcd4' }};"
                          ></div>
                        </div>

                        <!-- Icon 5 -->
                        <div
                          class="korean-icon-item"
                          data-icon="5"
                          onmouseover="activateIcon(5)"
                          onmouseout="deactivateIcon(5)"
                          onclick="selectIcon(5)"
                        >
                          {% if block.settings.icon_5_image %}
                            <img
                              src="{{ block.settings.icon_5_image | image_url: width: 60 }}"
                              alt="{{ block.settings.icon_5_title }}"
                              class="icon-image"
                              width="60"
                              height="60"
                            >
                          {% else %}
                            <div class="icon-placeholder">
                              <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                                <path d="M20 5v30M5 20h30" stroke="currentColor" stroke-width="2"/>
                                <circle cx="20" cy="20" r="12" stroke="currentColor" stroke-width="2" fill="none"/>
                              </svg>
                            </div>
                          {% endif %}
                          <span
                            class="icon-title"
                            style="
                              font-size: {{ block.settings.icon_title_size | default: 16 }}px;
                              color: {{ block.settings.icon_title_color | default: '#000000' }};
                              font-weight: {{ block.settings.icon_title_weight | default: 600 }};
                            "
                          >
                            {{ block.settings.icon_5_title | default: 'Renew' }}
                          </span>
                          <div
                            class="icon-underline"
                            style="background-color: {{ block.settings.underline_color | default: '#00bcd4' }};"
                          ></div>
                        </div>
                      </div>
                    </div>

                    <!-- Hidden Content Data for JavaScript -->
                    <div class="korean-content-data" style="display: none;">
                      <div data-content="1">
                        <span class="content-heading">
                          {{- block.settings.icon_1_heading | default: 'Advanced Repair Technology' -}}
                        </span>
                        <span class="content-subheading">
                          {{-
                            block.settings.icon_1_subheading
                            | default: 'Cellular regeneration and DNA repair mechanisms'
                          -}}
                        </span>
                      </div>
                      <div data-content="2">
                        <span class="content-heading">
                          {{- block.settings.icon_2_heading | default: 'Renewal Complex' -}}
                        </span>
                        <span class="content-subheading">
                          {{-
                            block.settings.icon_2_subheading
                            | default: 'Advanced skin renewal and rejuvenation formulas'
                          -}}
                        </span>
                      </div>
                      <div data-content="3">
                        <span class="content-heading">
                          {{- block.settings.icon_3_heading | default: 'Protection Shield' -}}
                        </span>
                        <span class="content-subheading">
                          {{-
                            block.settings.icon_3_subheading
                            | default: 'Barrier protection and environmental defense'
                          -}}
                        </span>
                      </div>
                      <div data-content="4">
                        <span class="content-heading">
                          {{- block.settings.icon_4_heading | default: 'Deep Repair' -}}
                        </span>
                        <span class="content-subheading">
                          {{- block.settings.icon_4_subheading | default: 'Intensive repair and restoration therapy' -}}
                        </span>
                      </div>
                      <div data-content="5">
                        <span class="content-heading">
                          {{- block.settings.icon_5_heading | default: 'Complete Renewal' -}}
                        </span>
