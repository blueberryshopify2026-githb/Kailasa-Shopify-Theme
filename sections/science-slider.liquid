{% comment %}
  Science Slider Section - Full Screen Slider
  Clean, focused design for molecular science showcase
{% endcomment %}

<section
  class="science-slider-section full-width"
  style="display: block !important; visibility: visible !important; opacity: 1 !important;"
>
  <div class="slider-container">
    <div class="slides-wrapper" id="slidesWrapper">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="slide-science-slider" data-slide="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {% if block.type == 'molecular_slide' %}
              <div class="slide-content molecular-slide">
                <div class="molecular-layout">
                  <!-- Left 50% - Content -->
                  <div
                    class="molecular-left"
                    style="background-color: {{ block.settings.left_panel_bg_color | default: '#ffffff' }};"
                  >
                    <div class="molecular-content">
                      <!-- Main Title -->
                      <h1
                        class="molecular-main-title"
                        style="
                          color: {{ block.settings.main_title_color | default: '#000000' }};
                          font-size: {{ block.settings.main_title_size | default: 42 }}px;
                          font-weight: {{ block.settings.main_title_weight | default: 700 }};
                          line-height: {{ block.settings.main_title_line_height | default: 1.1 }};
                          margin-bottom: {{ block.settings.main_title_margin_bottom | default: 20 }}px;
                        "
                      >
                        {{ block.settings.main_title | default: 'THE MOLECULAR<br>STANDARD' }}
                      </h1>

                      <!-- Subtitle -->
                      <h2
                        class="molecular-subtitle"
                        style="
                          color: {{ block.settings.subtitle_color | default: '#4fffff' }};
                          font-size: {{ block.settings.subtitle_size | default: 20 }}px;
                          font-weight: {{ block.settings.subtitle_weight | default: 600 }};
                          margin-bottom: {{ block.settings.subtitle_margin_bottom | default: 15 }}px;
                        "
                      >
                        {{ block.settings.subtitle | default: 'The Molecular Standard' }}
                      </h2>

                      <!-- Description -->
                      <p
                        class="molecular-description"
                        style="
                          color: {{ block.settings.description_color | default: '#666666' }};
                          font-size: {{ block.settings.description_size | default: 16 }}px;
                          line-height: {{ block.settings.description_line_height | default: 1.5 }};
                          margin-bottom: {{ block.settings.description_margin_bottom | default: 30 }}px;
                        "
                      >
                        {{
                          block.settings.description
                          | default: 'Harnessing South Korea patented fermentation technology skin elasticity at a cellular level.'
                        }}
                      </p>

                      <!-- Feature Boxes -->
                      <div
                        class="molecular-feature-boxes"
                        style="
                          gap: {{ block.settings.feature_boxes_gap | default: 15 }}px;
                          margin-bottom: {{ block.settings.feature_boxes_margin_bottom | default: 40 }}px;
                        "
                      >
                        <div
                          class="molecular-feature-box"
                          style="
                            background-color: {{ block.settings.feature_box_bg_color | default: '#D3FFFF' }};
                            padding: {{ block.settings.feature_box_padding | default: 16 }}px;
                            border-radius: {{ block.settings.feature_box_border_radius | default: 8 }}px;
                          "
                        >
                          <h4
                            class="feature-title-science-slider"
                            style="
                              color: {{ block.settings.feature_box_text_color | default: '#000000' }};
                              font-size: {{ block.settings.feature_title_size | default: 14 }}px;
                              font-weight: {{ block.settings.feature_title_weight | default: 700 }};
                              margin-bottom: {{ block.settings.feature_title_margin_bottom | default: 8 }}px;
                            "
                          >
                            {{ block.settings.feature_1_title | default: 'PDRN:' }}
                          </h4>
                          <p
                            class="feature-desc-science-slider"
                            style="
                              color: {{ block.settings.feature_box_text_color | default: '#000000' }};
                              font-size: {{ block.settings.feature_desc_size | default: 12 }}px;
                              margin: 0;
                            "
                          >
                            {{ block.settings.feature_1_desc | default: 'DNA-based rejuvenation.' }}
                          </p>
                        </div>

                        <div
                          class="molecular-feature-box"
                          style="
                            background-color: {{ block.settings.feature_box_bg_color | default: '#D3FFFF' }};
                            padding: {{ block.settings.feature_box_padding | default: 16 }}px;
                            border-radius: {{ block.settings.feature_box_border_radius | default: 8 }}px;
                          "
                        >
                          <h4
                            class="feature-title-science-slider"
                            style="
                              color: {{ block.settings.feature_box_text_color | default: '#000000' }};
                              font-size: {{ block.settings.feature_title_size | default: 14 }}px;
                              font-weight: {{ block.settings.feature_title_weight | default: 700 }};
                              margin-bottom: {{ block.settings.feature_title_margin_bottom | default: 8 }}px;
                            "
                          >
                            {{ block.settings.feature_2_title | default: 'SNAIL MUCIN' }}
                          </h4>
                          <p
                            class="feature-desc-science-slider"
                            style="
                              color: {{ block.settings.feature_box_text_color | default: '#000000' }};
                              font-size: {{ block.settings.feature_desc_size | default: 12 }}px;
                              margin: 0;
                            "
                          >
                            {{ block.settings.feature_2_desc | default: 'Advanced barrier repair' }}
                          </p>
                        </div>
                      </div>

                      <!-- Molecular Icons Section -->
                      <div class="molecular-icons-section">
                        <!-- Icons Row -->
                        <div
                          class="molecular-icons-row"
                          style="
                            gap: {{ block.settings.icons_gap | default: 30 }}px;
                            margin-bottom: {{ block.settings.icons_margin_bottom | default: 15 }}px;
                          "
                        >
                          <div class="molecular-icon-item">
                            {% if block.settings.icon_1_image %}
                              <img
                                src="{{ block.settings.icon_1_image | image_url: width: 60 }}"
                                alt="{{ block.settings.icon_1_title }}"
                                class="molecular-icon"
                                width="60"
                                height="60"
                                style="width: {{ block.settings.icon_size | default: 60 }}px; height: {{ block.settings.icon_size | default: 60 }}px;"
                              >
                            {% else %}
                              <div
                                class="molecular-icon-placeholder pdrn-icon"
                                style="
                                  width: {{ block.settings.icon_size | default: 60 }}px;
                                  height: {{ block.settings.icon_size | default: 60 }}px;
                                  background-color: {{ block.settings.icon_placeholder_bg | default: '#4fffff' }};
                                  color: {{ block.settings.icon_placeholder_color | default: '#ffffff' }};
                                "
                              ></div>
                            {% endif %}
                          </div>

                          <div class="molecular-icon-item">
                            {% if block.settings.icon_2_image %}
                              <img
                                src="{{ block.settings.icon_2_image | image_url: width: 60 }}"
                                alt="{{ block.settings.icon_2_title }}"
                                class="molecular-icon"
                                width="60"
                                height="60"
                                style="width: {{ block.settings.icon_size | default: 60 }}px; height: {{ block.settings.icon_size | default: 60 }}px;"
                              >
                            {% else %}
                              <div
                                class="molecular-icon-placeholder ceramides-icon"
                                style="
                                  width: {{ block.settings.icon_size | default: 60 }}px;
                                  height: {{ block.settings.icon_size | default: 60 }}px;
                                  background-color: {{ block.settings.icon_placeholder_bg | default: '#4fffff' }};
                                  color: {{ block.settings.icon_placeholder_color | default: '#ffffff' }};
                                "
                              ></div>
                            {% endif %}
                          </div>

                          <div class="molecular-icon-item">
                            {% if block.settings.icon_3_image %}
                              <img
                                src="{{ block.settings.icon_3_image | image_url: width: 60 }}"
                                alt="{{ block.settings.icon_3_title }}"
                                class="molecular-icon"
                                width="60"
                                height="60"
                                style="width: {{ block.settings.icon_size | default: 60 }}px; height: {{ block.settings.icon_size | default: 60 }}px;"
                              >
                            {% else %}
                              <div
                                class="molecular-icon-placeholder peptides-icon"
                                style="
                                  width: {{ block.settings.icon_size | default: 60 }}px;
                                  height: {{ block.settings.icon_size | default: 60 }}px;
                                  background-color: {{ block.settings.icon_placeholder_bg | default: '#4fffff' }};
                                  color: {{ block.settings.icon_placeholder_color | default: '#ffffff' }};
                                "
                              ></div>
                            {% endif %}
                          </div>
                        </div>

                        <!-- Titles Row -->
                        <div
                          class="molecular-titles-row"
                          style="
                            gap: {{ block.settings.icons_gap | default: 30 }}px;
                            margin-bottom: {{ block.settings.titles_margin_bottom | default: 10 }}px;
                          "
                        >
                          <h5
                            class="molecular-icon-title"
                            style="
                              color: {{ block.settings.icon_title_color | default: '#000000' }};
                              font-size: {{ block.settings.icon_title_size | default: 14 }}px;
                              font-weight: {{ block.settings.icon_title_weight | default: 700 }};
                              text-align: center;
                            "
                          >
                            {{ block.settings.icon_1_title | default: 'PDRN' }}
                          </h5>
                          <h5
                            class="molecular-icon-title"
                            style="
                              color: {{ block.settings.icon_title_color | default: '#000000' }};
                              font-size: {{ block.settings.icon_title_size | default: 14 }}px;
                              font-weight: {{ block.settings.icon_title_weight | default: 700 }};
                              text-align: center;
                            "
                          >
                            {{ block.settings.icon_2_title | default: 'CERAMIDES' }}
                          </h5>
                          <h5
                            class="molecular-icon-title"
                            style="
                              color: {{ block.settings.icon_title_color | default: '#000000' }};
                              font-size: {{ block.settings.icon_title_size | default: 14 }}px;
                              font-weight: {{ block.settings.icon_title_weight | default: 700 }};
                              text-align: center;
                            "
                          >
                            {{ block.settings.icon_3_title | default: 'PEPTIDES' }}
                          </h5>
                        </div>

                        <!-- Descriptions Row -->
                        <div
                          class="molecular-descriptions-row"
                          style="gap: {{ block.settings.icons_gap | default: 30 }}px;"
                        >
                          <p
                            class="molecular-icon-desc"
                            style="
                              color: {{ block.settings.icon_desc_color | default: '#4fffff' }};
                              font-size: {{ block.settings.icon_desc_size | default: 14 }}px;
                              text-align: center;
                              line-height: {{ block.settings.icon_desc_line_height | default: 1.4 }};
                            "
                          >
                            {{ block.settings.icon_1_desc | default: 'DNA-based rejuvenation.' }}
                          </p>
                          <p
                            class="molecular-icon-desc"
                            style="
                              color: {{ block.settings.icon_desc_color | default: '#4fffff' }};
                              font-size: {{ block.settings.icon_desc_size | default: 14 }}px;
                              text-align: center;
                              line-height: {{ block.settings.icon_desc_line_height | default: 1.4 }};
                            "
                          >
                            {{ block.settings.icon_2_desc | default: 'Barrier strength and protration' }}
                          </p>
                          <p
                            class="molecular-icon-desc"
                            style="
                              color: {{ block.settings.icon_desc_color | default: '#4fffff' }};
                              font-size: {{ block.settings.icon_desc_size | default: 14 }}px;
                              text-align: center;
                              line-height: {{ block.settings.icon_desc_line_height | default: 1.4 }};
                            "
                          >
                            {{ block.settings.icon_3_desc | default: 'Collagen<br>synthesis and elasticity' }}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Right 50% - Image -->
                  <div
                    class="molecular-right"
                    style="background-color: {{ block.settings.right_panel_bg_color | default: '#e8f8f5' }};"
                  >
                    {% if block.settings.background_image %}
                      <img
                        src="{{ block.settings.background_image | image_url: width: 800 }}"
                        alt="Molecular background"
                        class="molecular-bg-image"
                        width="800"
                        height="600"
                        style="
                          object-fit: {{ block.settings.image_fit | default: 'cover' }};
                          opacity: {{ block.settings.image_opacity | default: 1 }};
                        "
                      >
                    {% else %}
                      <div class="molecular-image-placeholder">
                        <p
                          style="
                            color: {{ block.settings.placeholder_text_color | default: '#666666' }};
                            font-size: {{ block.settings.placeholder_text_size | default: 18 }}px;
                          "
                        >
                          {{ block.settings.placeholder_text | default: 'Upload your background image' }}
                        </p>
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>

            {% elsif block.type == 'clinical_dossier' %}
              <div class="slide-content clinical-slide">
                <div
                  class="clinical-layout"
                  style="grid-template-columns: {{ block.settings.left_ratio | default: 60 }}% {{ block.settings.right_ratio | default: 40 }}%;"
                >
                  <!-- Left Side - Image Display -->
                  <div class="clinical-left">
                    <div class="image-display-area">
                      <div class="clinical-image-container" id="clinicalImageContainer">
                        {% for i in (1..6) %}
                          {% assign card_image = 'card_' | append: i | append: '_image' %}
                          {% if block.settings[card_image] %}
                            <img
                              src="{{ block.settings[card_image] | image_url: width: 500 }}"
                              alt="Card {{ i }} image"
                              class="clinical-image card-image-{{ i }}"
                              width="500"
                              height="400"
                              style="display: {% if i == 1 %}block{% else %}none{% endif %}; object-fit: {{ block.settings.image_fit | default: 'cover' }};"
                            >
                          {% endif %}
                        {% endfor %}
                      </div>
                    </div>
                  </div>

                  <!-- Cyan Divider Line -->
                  {% if block.settings.show_divider %}
                    <div
                      class="clinical-divider"
                      style="background-color: {{ block.settings.divider_color | default: '#4fffff' }}; left: {{ block.settings.left_ratio | default: 60 }}%;"
                    ></div>
                  {% endif %}

                  <!-- Right Side - Content and Cards -->
                  <div class="clinical-right">
                    <div class="right-content-science-slider">
                      <div class="right-header">
                        <h2 class="molecular-title">
                          {{ block.settings.right_title | default: 'THE MOLECULAR FOUNDATIONS' }}
                        </h2>
                        <p class="molecular-subtitle">
                          {{
                            block.settings.right_subtitle
                            | default: 'Beyond the surface. We engineer the architecture.'
                          }}
                        </p>
                      </div>

                      <!-- Interactive Cards -->
                      <div class="clinical-cards">
                        {% for i in (1..6) %}
                          {% assign card_title = 'card_' | append: i | append: '_title' %}
                          {% assign card_subtitle = 'card_' | append: i | append: '_subtitle' %}

                          <div
                            class="clinical-card"
                            data-card="{{ i }}"
                            onmouseover="showCardImage({{ i }})"
                            onclick="showCardImage({{ i }})"
                            style="
                              border-radius: {{ block.settings.card_border_radius | default: 25 }}px;
                              width: {{ block.settings.card_width | default: 80 }}%;
                              max-width: {{ block.settings.card_max_width | default: 400 }}px;
                            "
                          >
                            <div class="card-content">
                              <div class="card-left">
                                <div class="card-text">
                                  <h3 class="card-title">{{ block.settings[card_title] | default: 'Card title' }}</h3>
                                  <p class="card-subtitle">
                                    {{ block.settings[card_subtitle] | default: 'Card description text' }}
                                  </p>
                                </div>
                              </div>
                            </div>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            {% elsif block.type == 'technology_showcase' %}
              <div class="slide-content technology-slide">
                <div class="technology-split-layout">
                  <!-- Left 60% - Image with Points -->
                  <div class="technology-image-section">
                    {% if block.settings.main_image %}
                      <img
                        src="{{ block.settings.main_image | image_url: width: 1200 }}"
                        alt="{{ block.settings.main_title }}"
                        class="technology-bg-image"
                        width="1200"
                        height="800"
                      >
                    {% else %}
                      <div class="technology-bg-placeholder">
                        <p>Upload your main background image</p>
                      </div>
                    {% endif %}

                    <!-- Overlay Points on Image -->
                    <div class="technology-points-overlay">
                      <div
                        class="overlay-point point-1"
                        data-point="1"
                        style="top: {{ block.settings.point_1_top | default: 35 }}%; left: {{ block.settings.point_1_left | default: 30 }}%;"
                        onmouseover="highlightPoint(1)"
                        onmouseout="unhighlightPoint(1)"
                        onclick="selectPoint(1)"
                      >
                        <span class="point-number">1</span>
                      </div>

                      <div
                        class="overlay-point point-2"
                        data-point="2"
                        style="top: {{ block.settings.point_2_top | default: 65 }}%; left: {{ block.settings.point_2_left | default: 70 }}%;"
                        onmouseover="highlightPoint(2)"
                        onmouseout="unhighlightPoint(2)"
                        onclick="selectPoint(2)"
                      >
                        <span class="point-number">2</span>
                      </div>

                      <div
                        class="overlay-point point-3"
                        data-point="3"
                        style="top: {{ block.settings.point_3_top | default: 80 }}%; left: {{ block.settings.point_3_left | default: 25 }}%;"
                        onmouseover="highlightPoint(3)"
                        onmouseout="unhighlightPoint(3)"
                        onclick="selectPoint(3)"
                      >
                        <span class="point-number">3</span>
                      </div>

                      <!-- Arrow Lines -->
                      {% if block.settings.show_arrows != false %}
                        <div class="arrow-lines">
                          <div
                            class="arrow-line line-1"
                            data-line="1"
                            style="width: {{ block.settings.arrow_1_width | default: 60 }}%; top: {{ block.settings.point_1_top | default: 35 }}%; right: calc(100% - {{ block.settings.point_1_left | default: 30 }}% + 10px);"
                          ></div>
                          <div
                            class="arrow-line line-2"
                            data-line="2"
                            style="width: {{ block.settings.arrow_2_width | default: 40 }}%; top: {{ block.settings.point_2_top | default: 65 }}%; right: calc(100% - {{ block.settings.point_2_left | default: 70 }}% + 10px);"
                          ></div>
                          <div
                            class="arrow-line line-3"
                            data-line="3"
                            style="width: {{ block.settings.arrow_3_width | default: 60 }}%; top: {{ block.settings.point_3_top | default: 80 }}%; right: calc(100% - {{ block.settings.point_3_left | default: 25 }}% + 10px);"
                          ></div>
                        </div>
                      {% endif %}
                    </div>
                  </div>

                  <!-- Right 40% - Content Area -->
                  <div class="technology-content-section">
                    <!-- Main Title -->
                    <div class="content-header">
                      <h1 class="technology-main-title">
                        {{ block.settings.main_title | default: 'Derm proven retinol with patented technology' }}
                      </h1>
                    </div>

                    <!-- Structured Content List -->
                    <div class="content-list">
                      <!-- Point 1 Content -->
                      <div
                        class="content-item item-1"
                        data-content="1"
                        onmouseover="highlightPoint(1)"
                        onmouseout="unhighlightPoint(1)"
                        onclick="selectPoint(1)"
                      >
                        <div class="content-number">1.</div>
                        <div class="content-text">
                          <h3 class="point-title">
                            {{ block.settings.point_1_title | default: 'Derm proven retinol' }}
                          </h3>
                          <p class="point-description">
                            {{ block.settings.point_1_description | default: 'Helps to fade lines and wrinkles' }}
                          </p>
                        </div>
                      </div>

                      <!-- Point 2 Content -->
                      <div
                        class="content-item item-2"
                        data-content="2"
                        onmouseover="highlightPoint(2)"
                        onmouseout="unhighlightPoint(2)"
                        onclick="selectPoint(2)"
                      >
                        <div class="content-number">2.</div>
                        <div class="content-text">
                          <h3 class="point-title">
                            {{ block.settings.point_2_title | default: 'Peptides' }}
                          </h3>
                          <p class="point-description">
                            {{
                              block.settings.point_2_description
                              | default: 'Helps improve skin firmness and elasticity'
                            }}
                          </p>
                        </div>
                      </div>

                      <!-- Point 3 Content -->
                      <div
                        class="content-item item-3"
                        data-content="3"
                        onmouseover="highlightPoint(3)"
                        onmouseout="unhighlightPoint(3)"
                        onclick="selectPoint(3)"
                      >
                        <div class="content-number">3.</div>
                        <div class="content-text">
                          <h3 class="point-title">
                            {{ block.settings.point_3_title | default: 'Soothing Complex' }}
                          </h3>
                          <p class="point-description">
                            {{
                              block.settings.point_3_description
                              | default: 'Helps nourish skin and minimize irritation'
                            }}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            {% elsif block.type == 'korean_beauty_showcase' %}
              <div class="slide-content korean-beauty-slide">
                <div class="korean-beauty-layout">
                  <!-- Background Image -->
                  <div class="korean-beauty-background">
                    {% if block.settings.background_image %}
                      <img
                        src="{{ block.settings.background_image | image_url: width: 1920 }}"
                        alt="{{ block.settings.main_heading }}"
                        class="korean-bg-image"
                        width="1920"
                        height="1080"
                        style="opacity: {{ block.settings.background_opacity | default: 1 }};"
                      >
                    {% else %}
                      <div class="korean-bg-placeholder"></div>
                    {% endif %}
                  </div>

                  <!-- Overlay Content -->
                  <div class="korean-beauty-overlay">
                    <!-- Interactive Icons Section -->
                    <div
                      class="korean-icons-section"
                      style="margin-top: calc({{ block.settings.icons_margin_top | default: 5 }}% - 10%);"
                    >
                      <!-- Frosted Glass Background with Text Inside -->
                      <div
                        class="icons-container"
                        style="
                          background: rgba(255, 255, 255, {{ block.settings.glass_opacity | default: 0.2 }});
                          backdrop-filter: blur({{ block.settings.glass_blur | default: 10 }}px);
                          width: {{ block.settings.glass_width | default: 900 }}px;
                          height: {{ block.settings.glass_height | default: 280 }}px;
                          border-radius: {{ block.settings.glass_border_radius | default: 20 }}px;
                          box-sizing: border-box;
                          display: flex;
                          flex-direction: column;
                          justify-content: space-between;
                          align-items: center;
                          position: relative;
                          padding: 30px 20px 20px 20px;
                          overflow: visible;
                        "
                      >
                        <!-- Text Content Inside Glass -->
                        <div
                          class="glass-text-content"
                          style="
                            text-align: {{ block.settings.text_alignment | default: 'center' }};
                            width: 100%;
                          "
                        >
                          <h1
                            class="korean-main-heading"
                            style="
                              font-size: {{ block.settings.main_heading_size | default: 48 }}px;
                              color: {{ block.settings.main_heading_color | default: '#000000' }};
                              font-weight: {{ block.settings.main_heading_weight | default: 700 }};
                              margin: 0 0 5px 0;
                            "
                            id="koreanMainHeading"
                            data-default-heading="{{ block.settings.icon_1_heading | default: 'Advanced Repair Technology' }}"
                          >
                            {{ block.settings.icon_1_heading | default: 'Advanced Repair Technology' }}
                          </h1>
                          <p
                            class="korean-subheading"
                            style="
                              font-size: {{ block.settings.subheading_size | default: 18 }}px;
                              color: {{ block.settings.subheading_color | default: '#000000' }};
                              font-weight: {{ block.settings.subheading_weight | default: 400 }};
                              margin: 0;
                            "
                            id="koreanSubheading"
                            data-default-subheading="{{ block.settings.icon_1_subheading | default: 'Cellular regeneration and DNA repair mechanisms' }}"
                          >
                            {{
                              block.settings.icon_1_subheading
                              | default: 'Cellular regeneration and DNA repair mechanisms'
                            }}
                          </p>
                        </div>

                        <!-- Icons positioned at bottom of glass -->
                        <div
                          class="icons-wrapper"
                          style="gap: {{ block.settings.icon_gap | default: 60 }}px;"
                        >
                          <!-- Icon 1 -->
                          <div
                            class="korean-icon-item active"
                            data-icon="1"
                            onmouseover="activateIcon(1)"
                            onmouseout="deactivateIcon(1)"
                            onclick="selectIcon(1)"
                          >
                            {% if block.settings.icon_1_image %}
                              <img
                                src="{{ block.settings.icon_1_image | image_url: width: 60 }}"
                                alt="{{ block.settings.icon_1_title }}"
