<script>
  (function () {
    // Science Slider namespace to avoid conflicts
    let currentSlide = 0;
    let totalSlides = 0;

    document.addEventListener('DOMContentLoaded', function () {
      // Only initialize if science slider section exists
      const scienceSliderSection = document.querySelector('.science-slider-section');
      if (!scienceSliderSection) {
        console.log('Science slider section not found, skipping initialization');
        return;
      }

      const slidesWrapper = scienceSliderSection.querySelector('#slidesWrapper');

      if (!slidesWrapper) return;

      const originalSlides = scienceSliderSection.querySelectorAll('.slide-science-slider');
      totalSlides = originalSlides.length;

      // Ensure we have at least 1 slide (default content)
      if (totalSlides === 0) totalSlides = 1;

      // Create true infinite loop by duplicating first slide at the end and last slide at the beginning
      if (totalSlides > 1) {
        const firstSlideClone = originalSlides[0].cloneNode(true);
        const lastSlideClone = originalSlides[totalSlides - 1].cloneNode(true);

        firstSlideClone.classList.add('clone-slide', 'first-clone');
        lastSlideClone.classList.add('clone-slide', 'last-clone');

        // Add last slide clone at the beginning
        slidesWrapper.insertBefore(lastSlideClone, originalSlides[0]);
        // Add first slide clone at the end
        slidesWrapper.appendChild(firstSlideClone);

        // Set slides wrapper width to include both clones
        slidesWrapper.style.width = (totalSlides + 2) * 100 + 'vw';

        // Start at the first real slide (index 1 because of the prepended clone)
        currentSlide = 1;
        slidesWrapper.style.transform = `translateX(-100vw)`;
      } else {
        slidesWrapper.style.width = totalSlides * 100 + 'vw';
      }

      // Keyboard navigation - only when science slider is focused or visible
      document.addEventListener('keydown', function (e) {
        // Only handle keyboard events when science slider is in focus and visible in viewport
        const scienceSliderSection = document.querySelector('.science-slider-section');
        if (!scienceSliderSection) return;

        // Check if science slider is in viewport
        const rect = scienceSliderSection.getBoundingClientRect();
        const isVisible = rect.top < window.innerHeight && rect.bottom > 0;

        if (!isVisible) return;

        if (e.key === 'ArrowLeft') {
          e.preventDefault(); // Prevent default scroll behavior
          previousSlide();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault(); // Prevent default scroll behavior
          nextSlide();
        }
      });

      // Initialize first slide - start at slide 1 (first real slide)
      setTimeout(() => {
        goToSlide(1);
      }, 200);

      // Debug log
      console.log('Science Slider initialized with', totalSlides, 'slides');
    });

    function showCardImage(cardNumber) {
      // Only work within science slider section
      const scienceSliderSection = document.querySelector('.science-slider-section');
      if (!scienceSliderSection) return;

      // Hide all images
      const images = scienceSliderSection.querySelectorAll('.clinical-image');
      images.forEach((img) => (img.style.display = 'none'));

      // Show selected image
      const selectedImage = scienceSliderSection.querySelector(`.card-image-${cardNumber}`);
      if (selectedImage) {
        selectedImage.style.display = 'block';
        // Hide default placeholder
        const placeholder = scienceSliderSection.querySelector('#defaultPlaceholder');
        if (placeholder) placeholder.style.display = 'none';
      } else {
        // Show default placeholder if no image
        const placeholder = scienceSliderSection.querySelector('#defaultPlaceholder');
        if (placeholder) placeholder.style.display = 'flex';
      }

      // Update active card state
      const cards = scienceSliderSection.querySelectorAll('.clinical-card');
      cards.forEach((card) => card.classList.remove('active'));

      const activeCard = scienceSliderSection.querySelector(`[data-card="${cardNumber}"]`);
      if (activeCard) activeCard.classList.add('active');
    }

    function goToSlide(slideIndex) {
      if (totalSlides === 0) return;

      // Only work within science slider section
      const scienceSliderSection = document.querySelector('.science-slider-section');
      if (!scienceSliderSection) return;

      const slidesWrapper = scienceSliderSection.querySelector('#slidesWrapper');
      if (!slidesWrapper) return;

      // Handle infinite loop with smooth transitions - adjusted for new slide structure
      if (slideIndex > totalSlides) {
        // Moving past the last real slide to the first clone
        currentSlide = totalSlides + 1; // First clone position
        const translateX = -currentSlide * 100;
        slidesWrapper.style.transform = `translateX(${translateX}vw)`;

        // After transition, jump to the real first slide
        setTimeout(() => {
          currentSlide = 1; // Real first slide position (after last clone)
          slidesWrapper.style.transition = 'none';
          slidesWrapper.style.transform = `translateX(-100vw)`;

          // Re-enable transition
          setTimeout(() => {
            slidesWrapper.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
          }, 50);
        }, 600);
      } else if (slideIndex < 1) {
        // Moving before the first real slide to the last clone
        currentSlide = 0; // Last clone position
        const translateX = -currentSlide * 100;
        slidesWrapper.style.transform = `translateX(${translateX}vw)`;

        // After transition, jump to the real last slide
        setTimeout(() => {
          currentSlide = totalSlides; // Real last slide position
          slidesWrapper.style.transition = 'none';
          slidesWrapper.style.transform = `translateX(-${totalSlides * 100}vw)`;

          // Re-enable transition
          setTimeout(() => {
            slidesWrapper.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
          }, 50);
        }, 600);
      } else {
        // Normal slide transition
        currentSlide = slideIndex;
        const translateX = -slideIndex * 100;
        slidesWrapper.style.transform = `translateX(${translateX}vw)`;
      }

      // Debug log
      console.log('Going to slide', currentSlide, 'translateX:', -currentSlide * 100 + 'vw');
    }

    // Create namespaced functions to avoid conflicts
    function nextSlide() {
      goToSlide(currentSlide + 1);
    }

    function previousSlide() {
      goToSlide(currentSlide - 1);
    }

    // Alias for backward compatibility
    function prevSlide() {
      previousSlide();
    }

    // Make functions globally accessible with namespace
    window.ScienceSlider = {
      nextSlide: nextSlide,
      previousSlide: previousSlide,
      prevSlide: prevSlide,
    };

    // Technology Showcase Interactive Functions
    function highlightPoint(pointNumber) {
      // Only work within science slider section
      const scienceSliderSection = document.querySelector('.science-slider-section');
      if (!scienceSliderSection) return;

      // Highlight the overlay point
      const overlayPoint = scienceSliderSection.querySelector(`.overlay-point.point-${pointNumber}`);
      if (overlayPoint) {
        overlayPoint.classList.add('active');
      }

      // Highlight the corresponding content item
      const contentItem = scienceSliderSection.querySelector(`.content-item.item-${pointNumber}`);
      if (contentItem) {
        contentItem.classList.add('highlighted');
      }
    }

    function unhighlightPoint(pointNumber) {
      // Only work within science slider section
      const scienceSliderSection = document.querySelector('.science-slider-section');
      if (!scienceSliderSection) return;

      // Remove highlight from overlay point
      const overlayPoint = scienceSliderSection.querySelector(`.overlay-point.point-${pointNumber}`);
      if (overlayPoint) {
        overlayPoint.classList.remove('active');
      }

      // Remove highlight from content item
      const contentItem = scienceSliderSection.querySelector(`.content-item.item-${pointNumber}`);
      if (contentItem) {
        contentItem.classList.remove('highlighted');
      }
    }

    function selectPoint(pointNumber) {
      // Remove active state from all points
      const scienceSliderSection = document.querySelector('.science-slider-section');
      if (!scienceSliderSection) return;

      scienceSliderSection.querySelectorAll('.overlay-point').forEach((point) => {
        point.classList.remove('active');
      });
      document.querySelectorAll('.content-item').forEach((item) => {
        item.classList.remove('highlighted');
      });

      // Add active state to selected point
      highlightPoint(pointNumber);
    }

    // Add hover functionality to content points
    document.addEventListener('DOMContentLoaded', function () {
      const scienceSliderSection = document.querySelector('.science-slider-section');
      if (!scienceSliderSection) return;

      const contentPoints = scienceSliderSection.querySelectorAll('.content-point');

      contentPoints.forEach((point, index) => {
        const pointNumber = index + 1;

        point.addEventListener('mouseenter', function () {
          highlightPoint(pointNumber);
        });

        point.addEventListener('mouseleave', function () {
          unhighlightPoint(pointNumber);
        });

        point.addEventListener('click', function () {
          selectPoint(pointNumber);
        });
      });
    });

    // Korean Beauty Showcase Interactive Functions
    let currentSelectedIcon = 1; // Track the currently selected icon (default to first)
    let isHovering = false; // Track if user is currently hovering

    function activateIcon(iconNumber) {
      const scienceSliderSection = document.querySelector('.science-slider-section');
      if (!scienceSliderSection) return;

      const iconItem = scienceSliderSection.querySelector(`.korean-icon-item[data-icon="${iconNumber}"]`);
      if (iconItem) {
        // Remove active class from all icons first
        scienceSliderSection.querySelectorAll('.korean-icon-item').forEach((item) => {
          item.classList.remove('active');
        });

        // Add active class to current icon
        iconItem.classList.add('active');
        isHovering = true;

        // Change content on hover with smoother transition
        const contentData = scienceSliderSection.querySelector(`.korean-content-data [data-content="${iconNumber}"]`);
        if (contentData) {
          const heading = contentData.querySelector('.content-heading').textContent;
          const subheading = contentData.querySelector('.content-subheading').textContent;

          const mainHeading = scienceSliderSection.querySelector('#koreanMainHeading');
          const subHeadingElement = scienceSliderSection.querySelector('#koreanSubheading');

          if (mainHeading && subHeadingElement) {
            // Smoother fade transition without blinking
            mainHeading.style.transition = `opacity 0.4s ease-in-out`;
            subHeadingElement.style.transition = `opacity 0.4s ease-in-out`;

            mainHeading.style.opacity = '0.3';
            subHeadingElement.style.opacity = '0.3';

            setTimeout(() => {
              mainHeading.textContent = heading;
              subHeadingElement.textContent = subheading;

              // Smooth fade in
              setTimeout(() => {
                mainHeading.style.opacity = '1';
                subHeadingElement.style.opacity = '1';
              }, 100);
            }, 200);
          }
        }
      }
    }

    function deactivateIcon(iconNumber) {
      isHovering = false;

      // Only reset if we're not hovering and this isn't the currently selected icon
      setTimeout(() => {
        if (!isHovering) {
          const scienceSliderSection = document.querySelector('.science-slider-section');
          if (!scienceSliderSection) return;

          // Remove active class from all icons
          scienceSliderSection.querySelectorAll('.korean-icon-item').forEach((item) => {
            item.classList.remove('active');
          });

          // Reactivate the currently selected icon
          const selectedIcon = scienceSliderSection.querySelector(
            `.korean-icon-item[data-icon="${currentSelectedIcon}"]`
          );
          if (selectedIcon) {
            selectedIcon.classList.add('active');
          }

          // Reset to the currently selected icon's content
          const contentData = scienceSliderSection.querySelector(
            `.korean-content-data [data-content="${currentSelectedIcon}"]`
          );
          if (contentData) {
            const heading = contentData.querySelector('.content-heading').textContent;
            const subheading = contentData.querySelector('.content-subheading').textContent;

            const mainHeading = scienceSliderSection.querySelector('#koreanMainHeading');
            const subHeadingElement = scienceSliderSection.querySelector('#koreanSubheading');

            if (mainHeading && subHeadingElement) {
              // Smoother fade transition without blinking
              mainHeading.style.transition = `opacity 0.4s ease-in-out`;
              subHeadingElement.style.transition = `opacity 0.4s ease-in-out`;

              mainHeading.style.opacity = '0.3';
              subHeadingElement.style.opacity = '0.3';

              setTimeout(() => {
                mainHeading.textContent = heading;
                subHeadingElement.textContent = subheading;

                // Smooth fade in
                setTimeout(() => {
                  mainHeading.style.opacity = '1';
                  subHeadingElement.style.opacity = '1';
                }, 100);
              }, 200);
            }
          }
        }
      }, 100); // Small delay to allow for quick hover transitions
    }

    function selectIcon(iconNumber) {
      // Update the currently selected icon
      currentSelectedIcon = iconNumber;

      const scienceSliderSection = document.querySelector('.science-slider-section');
      if (!scienceSliderSection) return;

      // Remove active state from all icons
      scienceSliderSection.querySelectorAll('.korean-icon-item').forEach((item) => {
        item.classList.remove('active');
      });

      // Add active state to selected icon
      activateIcon(iconNumber);

      console.log(`Icon ${iconNumber} selected and set as current`);
    }

    // Store original content on page load and initialize first icon as active
    document.addEventListener('DOMContentLoaded', function () {
      const scienceSliderSection = document.querySelector('.science-slider-section');
      if (!scienceSliderSection) return;

      const mainHeading = scienceSliderSection.querySelector('#koreanMainHeading');
      const subHeadingElement = scienceSliderSection.querySelector('#koreanSubheading');

      if (mainHeading && subHeadingElement) {
        mainHeading.setAttribute('data-original', mainHeading.textContent);
        subHeadingElement.setAttribute('data-original', subHeadingElement.textContent);

        // Store default values from theme settings
        mainHeading.setAttribute('data-default-heading', mainHeading.textContent);
        subHeadingElement.setAttribute('data-default-subheading', subHeadingElement.textContent);

        // Store transition speed
        mainHeading.setAttribute('data-transition-speed', '0.8');

        // Initialize first icon as selected (not just active)
        setTimeout(() => {
          selectIcon(1); // This will set icon 1 as the current selected icon
        }, 100);
      }
    });
  })(); // End of Science Slider IIFE
</script>
