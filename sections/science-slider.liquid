<script>
  let currentSlide = 0;
  let totalSlides = 0;

  document.addEventListener('DOMContentLoaded', function () {
    const slidesWrapper = document.getElementById('slidesWrapper');

    if (!slidesWrapper) return;

    totalSlides = document.querySelectorAll('.slide').length;

    // Keyboard navigation
    document.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') {
        previousSlide();
      } else if (e.key === 'ArrowRight') {
        nextSlide();
      }
    });

    // Initialize first slide
    goToSlide(0);
  });

  function showCardImage(cardNumber) {
    // Hide all images
    const images = document.querySelectorAll('.clinical-image');
    images.forEach((img) => (img.style.display = 'none'));

    // Show selected image
    const selectedImage = document.querySelector(`.card-image-${cardNumber}`);
    if (selectedImage) {
      selectedImage.style.display = 'block';
      // Hide default placeholder
      const placeholder = document.getElementById('defaultPlaceholder');
      if (placeholder) placeholder.style.display = 'none';
    } else {
      // Show default placeholder if no image
      const placeholder = document.getElementById('defaultPlaceholder');
      if (placeholder) placeholder.style.display = 'flex';
    }

    // Update active card state
    const cards = document.querySelectorAll('.clinical-card');
    cards.forEach((card) => card.classList.remove('active'));

    const activeCard = document.querySelector(`[data-card="${cardNumber}"]`);
    if (activeCard) activeCard.classList.add('active');
  }

  function goToSlide(slideIndex) {
    if (slideIndex < 0 || slideIndex >= totalSlides) return;

    currentSlide = slideIndex;
    const slidesWrapper = document.getElementById('slidesWrapper');
    const translateX = -slideIndex * 100;

    slidesWrapper.style.transform = `translateX(${translateX}%)`;
  }

  function nextSlide() {
    const nextIndex = (currentSlide + 1) % totalSlides;
    goToSlide(nextIndex);
  }

  function previousSlide() {
    const prevIndex = (currentSlide - 1 + totalSlides) % totalSlides;
    goToSlide(prevIndex);
  }

  // Alias for backward compatibility
  function prevSlide() {
    previousSlide();
  }

  // Technology Showcase Interactive Functions
  function highlightPoint(pointNumber) {
    // Highlight the overlay point
    const overlayPoint = document.querySelector(`.overlay-point.point-${pointNumber}`);
    if (overlayPoint) {
      overlayPoint.classList.add('active');
    }

    // Highlight the corresponding content item
    const contentItem = document.querySelector(`.content-item.item-${pointNumber}`);
    if (contentItem) {
      contentItem.classList.add('highlighted');
    }
  }

  function unhighlightPoint(pointNumber) {
    // Remove highlight from overlay point
    const overlayPoint = document.querySelector(`.overlay-point.point-${pointNumber}`);
    if (overlayPoint) {
      overlayPoint.classList.remove('active');
    }

    // Remove highlight from content item
    const contentItem = document.querySelector(`.content-item.item-${pointNumber}`);
    if (contentItem) {
      contentItem.classList.remove('highlighted');
    }
  }

  function selectPoint(pointNumber) {
    // Remove active state from all points
    document.querySelectorAll('.overlay-point').forEach((point) => {
      point.classList.remove('active');
    });
    document.querySelectorAll('.content-item').forEach((item) => {
      item.classList.remove('highlighted');
    });

    // Add active state to selected point
    highlightPoint(pointNumber);
  }

  // Add hover functionality to content points
  document.addEventListener('DOMContentLoaded', function () {
    const contentPoints = document.querySelectorAll('.content-point');

    contentPoints.forEach((point, index) => {
      const pointNumber = index + 1;

      point.addEventListener('mouseenter', function () {
        highlightPoint(pointNumber);
      });

      point.addEventListener('mouseleave', function () {
        unhighlightPoint(pointNumber);
      });

      point.addEventListener('click', function () {
        selectPoint(pointNumber);
      });
    });
  });

  // Korean Beauty Showcase Interactive Functions
  function activateIcon(iconNumber) {
    const iconItem = document.querySelector(`.korean-icon-item[data-icon="${iconNumber}"]`);
    if (iconItem) {
      iconItem.classList.add('active');

      // Change content on hover with smoother transition
      const contentData = document.querySelector(`.korean-content-data [data-content="${iconNumber}"]`);
      if (contentData) {
        const heading = contentData.querySelector('.content-heading').textContent;
        const subheading = contentData.querySelector('.content-subheading').textContent;

        const mainHeading = document.getElementById('koreanMainHeading');
        const subHeadingElement = document.getElementById('koreanSubheading');

        if (mainHeading && subHeadingElement) {
          // Smoother fade out
          mainHeading.style.transition = 'opacity 0.4s ease-in-out';
          subHeadingElement.style.transition = 'opacity 0.4s ease-in-out';

          mainHeading.style.opacity = '0';
          subHeadingElement.style.opacity = '0';

          setTimeout(() => {
            mainHeading.textContent = heading;
            subHeadingElement.textContent = subheading;

            // Smoother fade in
            setTimeout(() => {
              mainHeading.style.opacity = '1';
              subHeadingElement.style.opacity = '1';
            }, 50);
          }, 400);
        }
      }
    }
  }

  function deactivateIcon(iconNumber) {
    const iconItem = document.querySelector(`.korean-icon-item[data-icon="${iconNumber}"]`);
    if (iconItem) {
      iconItem.classList.remove('active');

      // Reset to original content with smoother transition
      const mainHeading = document.getElementById('koreanMainHeading');
      const subHeadingElement = document.getElementById('koreanSubheading');

      if (mainHeading && subHeadingElement) {
        const originalHeading =
          mainHeading.getAttribute('data-original') ||
          mainHeading.getAttribute('data-default-heading') ||
          'Where Korean beauty meets Precision';
        const originalSubheading =
          subHeadingElement.getAttribute('data-original') ||
          subHeadingElement.getAttribute('data-default-subheading') ||
          'Our formulations are built on decades of Korean dermatological research focusing on cellular repair, barrier health, and long-term skin resilience.';

        // Smoother fade out
        mainHeading.style.transition = 'opacity 0.4s ease-in-out';
        subHeadingElement.style.transition = 'opacity 0.4s ease-in-out';

        mainHeading.style.opacity = '0';
        subHeadingElement.style.opacity = '0';

        setTimeout(() => {
          mainHeading.textContent = originalHeading;
          subHeadingElement.textContent = originalSubheading;

          // Smoother fade in
          setTimeout(() => {
            mainHeading.style.opacity = '1';
            subHeadingElement.style.opacity = '1';
          }, 50);
        }, 400);
      }
    }
  }

  function selectIcon(iconNumber) {
    // Remove active state from all icons
    document.querySelectorAll('.korean-icon-item').forEach((item) => {
      item.classList.remove('active');
    });

    // Add active state to selected icon
    activateIcon(iconNumber);

    // Keep the content changed permanently until another icon is selected
    console.log(`Icon ${iconNumber} selected`);
  }

  // Store original content on page load
  document.addEventListener('DOMContentLoaded', function () {
    const mainHeading = document.getElementById('koreanMainHeading');
    const subHeadingElement = document.getElementById('koreanSubheading');

    if (mainHeading && subHeadingElement) {
      mainHeading.setAttribute('data-original', mainHeading.textContent);
      subHeadingElement.setAttribute('data-original', subHeadingElement.textContent);

      // Store default values from theme settings
      mainHeading.setAttribute('data-default-heading', mainHeading.textContent);
      subHeadingElement.setAttribute('data-default-subheading', subHeadingElement.textContent);
    }
  });
</script>
