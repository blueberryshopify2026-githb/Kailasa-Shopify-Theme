  .content-item:hover .content-number,
  .content-item.highlighted .content-number {
    color: #4fffff;
  }

  .content-item:hover .point-title,
  .content-item.highlighted .point-title {
    color: #4fffff;
  }

  .content-item:hover .point-description,
  .content-item.highlighted .point-description {
    color: #4fffff;
  }

