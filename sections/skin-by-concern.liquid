  // Global variables
  let isSliding = false;
  let currentConcern = 'dullness';
  let currentProductRows = [];
















  // Switch concern function
  function switchConcern(concern, sectionId, event) {
    // Prevent default behavior and event bubbling if event is provided
    if (event) {
      event.preventDefault();
      event.stopPropagation();
    }
   
    currentConcern = concern;
   
    // Update active tab
    const tabs = document.querySelectorAll(`#skin-by-concern-${sectionId} .sbc-concern-tab`);
    tabs.forEach(tab => {
      tab.classList.remove('active');
      if (tab.dataset.concern === concern) {
        tab.classList.add('active');
      }
    });

    // Update images
    updateImages(concern, sectionId);
   
    // Update products header
    updateProductsHeader(concern, sectionId);
   
    // Show/hide concern data
    const concernDataElements = document.querySelectorAll(`#skin-by-concern-${sectionId} .sbc-concern-data`);
    concernDataElements.forEach(element => {
      element.classList.remove('active');
      if (element.dataset.concern === concern) {
        element.classList.add('active');
      }
    });

    // Reset scroll position to top for all viewports when switching tabs
    const productsContent = document.querySelector(`#skin-by-concern-${sectionId} .sbc-products-content`);
    if (productsContent) productsContent.scrollTop = 0;

    // Reset before/after slider to center (50%) on every tab switch
    const sliderContainer = document.getElementById(`sbc-before-after-container-${sectionId}`);
    if (sliderContainer && sliderContainer._resetSlider) sliderContainer._resetSlider();

    // Also reset any mobile/tablet carousel tracks back to first slide
    const mobileTrack = document.querySelector(`#skin-by-concern-${sectionId} .sbc-mobile-carousel-track`);
    if (mobileTrack) mobileTrack.style.transform = 'translateX(0%)';
    const tabletTrack = document.querySelector(`#skin-by-concern-${sectionId} .sbc-tablet-carousel-track`);
    if (tabletTrack) tabletTrack.style.transform = 'translateX(0%)';

    // Desktop: scroll window so the section's top edge is flush with viewport top.
    // The sticky tabs bar will naturally sit at top:0 from there.
    // Skip on initial page load — only scroll on user-triggered tab switches.
    if (window.innerWidth > 1024 && !switchConcern._isInitCall) {
      const sectionEl = document.getElementById(`skin-by-concern-${sectionId}`);
      if (sectionEl) {
        let docTop = 0;
        let el = sectionEl;
        while (el) { docTop += el.offsetTop; el = el.offsetParent; }
        window.scrollTo({ top: docTop, behavior: 'instant' });
      }
    }
    // Update products
    updateProducts(concern, sectionId);
   
    // Return false to prevent any default link behavior
    return false;
  }

  // Update before/after images
  function updateImages(concern, sectionId) {
    const data = concernData[concern];
    const beforeImg = document.getElementById(`sbc-before-image-${sectionId}`);
    const afterImg = document.getElementById(`sbc-after-image-${sectionId}`);
   
    // Use placeholder images if no images are set
    const defaultBefore = "{{ 'placeholder-before.svg' | asset_url }}";
    const defaultAfter = "{{ 'placeholder-after.svg' | asset_url }}";
   
    if (data.beforeImage && data.beforeImage !== '' && !data.beforeImage.includes('undefined')) {
      beforeImg.src = data.beforeImage;
    } else {
      beforeImg.src = defaultBefore;
    }
   
    if (data.afterImage && data.afterImage !== '' && !data.afterImage.includes('undefined')) {
      afterImg.src = data.afterImage;
    } else {
      afterImg.src = defaultAfter;
    }
  }

  // Update products title and description
  function updateProductsHeader(concern, sectionId) {
    const data = concernData[concern];
    const titleElement = document.getElementById(`sbc-concern-products-title-${sectionId}`);
    const descriptionElement = document.getElementById(`sbc-products-description-${sectionId}`);
   
    if (titleElement && data.title) {
      titleElement.textContent = data.title;
    }
   
    if (descriptionElement && data.description) {
      descriptionElement.textContent = data.description;
    }
  }

  // Update products with scroll animation
  function updateProducts(concern, sectionId) {
    const data = concernData[concern];
    const container = document.getElementById(`products-${concern}-${sectionId}`);
   
    if (!container) return;
   
    // Clean up previous scroll handlers
    const sectionElement = document.getElementById(`skin-by-concern-${sectionId}`);
    if (sectionElement._scrollHandler) {
      window.removeEventListener('scroll', sectionElement._scrollHandler);
    }
    if (sectionElement._sectionObserver) {
      sectionElement._sectionObserver.disconnect();
    }
   
    // No need to reset transforms since we're not using them
   
    container.innerHTML = '';
    currentProductRows = [];
   
    // Get only actual products - no placeholders
    let products = data.products && data.products.length > 0 ? data.products : [];
   
    // If no products are configured, don't show any products
    if (products.length === 0) {
      container.innerHTML = '<div style="padding: 40px; text-align: center; color: #666;">No products configured for this concern.</div>';
      return;
    }
   
    // Create rows with 2 products each for scrolling - ensure all products are accessible
    currentProductRows = [];
   
    for (let i = 0; i < products.length; i += 2) {
      const row = document.createElement('div');
      row.className = 'sbc-products-row';
     
      const productsInRow = products.slice(i, i + 2);
     
      productsInRow.forEach(product => {
        const productCard = document.createElement('div');
        productCard.className = 'sbc-product-card';
        if (product.url && product.url !== '#') {
          productCard.onclick = () => window.location.href = product.url;
        }
       
        const stars = '★'.repeat(Math.floor(parseFloat(product.rating))) +
                     (parseFloat(product.rating) % 1 >= 0.5 ? '☆' : '');
       
        // Get custom image/video or fallback to product image
        const customMedia = product.customImage || product.image;
        const productCode = product.code || 'NEW';
        const isNew = product.isNew !== false;
       
        productCard.innerHTML = `
          <div class="sbc-product-code">${productCode}</div>
          <div class="sbc-product-content">
            <div class="sbc-product-header">
              <div class="sbc-product-title">${product.title}</div>
            </div>
            <img src="${customMedia}" alt="${product.title}" class="sbc-product-image" width="220" height="220">
            <div class="sbc-product-footer">
              <div class="sbc-product-button">Shop Now</div>
              <div class="sbc-product-price">${product.price ? `Starting at ${product.price} per month` : ''}</div>
            </div>
          </div>
        `;
       
        row.appendChild(productCard);
      });
     
      container.appendChild(row);
      currentProductRows.push(row);
    }

    // Initialize scroll animation for the products
    initializeScrollAnimation(sectionId);
  }

  // Initialize scroll animation for products with enhanced scroll behavior
  function initializeScrollAnimation(sectionId) {
    const sectionElement = document.getElementById(`skin-by-concern-${sectionId}`);
    const productsSection = document.querySelector(`#skin-by-concern-${sectionId} .sbc-products-section`);
    const beforeAfterSection = document.querySelector(`#skin-by-concern-${sectionId} .sbc-before-after-section`);
   
    if (!productsSection || !sectionElement || !beforeAfterSection) return;
   
    // Simple intersection observer for product rows visibility
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    });
   
    // Observe all product rows
    currentProductRows.forEach(row => {
      observer.observe(row);
    });
   
    // Store reference for cleanup
    sectionElement._sectionObserver = observer;
  }

  // Initialize slider functionality
  function initializeSlider(sectionId) {
    const container = document.getElementById(`sbc-before-after-container-${sectionId}`);
    const handle = document.getElementById(`sbc-slider-handle-${sectionId}`);
    const beforeImage = document.getElementById(`sbc-before-image-${sectionId}`);
    const afterImage = document.getElementById(`sbc-after-image-${sectionId}`);
   
    if (!container || !handle || !beforeImage || !afterImage) return;

    let isSliding = false;

    function updateSlider(percentage) {
      // Clamp percentage between 0 and 100
      percentage = Math.max(0, Math.min(100, percentage));
     
      // Update handle position immediately
      handle.style.left = percentage + '%';
     
      // Clip the before image to show only the left portion up to the divider
      // Using inset: top right bottom left
      const rightInset = (100 - percentage) + '%';
      beforeImage.style.clipPath = `inset(0 ${rightInset} 0 0)`;
    }

    function getPercentageFromEvent(clientX) {
      const rect = container.getBoundingClientRect();
      const x = clientX - rect.left;
      return (x / rect.width) * 100;
    }

    function handleMove(clientX) {
      if (!isSliding) return;
      const percentage = getPercentageFromEvent(clientX);
      updateSlider(percentage);
    }

    // Only the circular button triggers drag — not the full-height line
    const button = handle.querySelector('.sbc-slider-button') || handle;

    let dragStartX = 0;
    let hasDragged = false;

    // Mouse events — drag starts only from the button circle
    button.addEventListener('mousedown', (e) => {
      isSliding = true;
      hasDragged = false;
      dragStartX = e.clientX;
      e.preventDefault();
      e.stopPropagation();
      document.body.style.cursor = 'ew-resize';
    });

    document.addEventListener('mousemove', (e) => {
      if (!isSliding) return;
      // Only move slider after actual drag movement of 3px+
      if (!hasDragged && Math.abs(e.clientX - dragStartX) < 3) return;
      hasDragged = true;
      handleMove(e.clientX);
      e.preventDefault();
    }, { passive: false });

    document.addEventListener('mouseup', () => {
      if (isSliding) {
        isSliding = false;
        hasDragged = false;
        document.body.style.cursor = '';
      }
    });

    // Touch events — only the button circle starts a drag, requires actual movement
    let touchStartX = 0;
    let touchHasDragged = false;

    button.addEventListener('touchstart', (e) => {
      isSliding = true;
      touchHasDragged = false;
      touchStartX = e.touches[0].clientX;
      e.preventDefault();
      e.stopPropagation();
    }, { passive: false });

    document.addEventListener('touchmove', (e) => {
      if (!isSliding || !e.touches.length) return;
      const dx = Math.abs(e.touches[0].clientX - touchStartX);
      const dy = Math.abs(e.touches[0].clientY - (e.touches[0].clientY || 0));
      // Only block scroll if it's a confirmed horizontal drag on the slider
      if (!touchHasDragged && dx < 3) return;
      touchHasDragged = true;
      handleMove(e.touches[0].clientX);
      e.preventDefault(); // only blocks scroll during actual slider drag
    }, { passive: false });

    document.addEventListener('touchend', () => {
      if (isSliding) {
        isSliding = false;
        touchHasDragged = false;
      }
    });

    // Prevent context menu on long press
    container.addEventListener('contextmenu', (e) => {
      e.preventDefault();
    });

    // Initialize at 50%
    updateSlider(50);

    // Expose reset function so switchConcern can reset slider to center on tab change
    container._resetSlider = () => updateSlider(50);
  }

  // Initialize tab event listeners to prevent navigation issues
  function initializeTabListeners(sectionId) {
    const tabs = document.querySelectorAll(`#skin-by-concern-${sectionId} .sbc-concern-tab`);
    tabs.forEach(tab => {
      tab.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const concern = this.dataset.concern;
        switchConcern(concern, sectionId);
        return false;
      });
    });
  }

  // ── MOBILE CAROUSEL ──────────────────────────────────────────
  // Runs only on mobile (≤768px). Rebuilds product display as a
  // swipeable carousel with 2-per-slide and nav dots.
  // Desktop updateProducts() is NOT modified.

  function isMobile() {
    return window.innerWidth <= 768;
  }

  function buildMobileCarousel(concern, sectionId) {
    if (!isMobile()) return;

    const data = concernData[concern];
    if (!data) return;

    // Target the sbc-concern-data container
    const concernDataEl = document.querySelector(
      `#skin-by-concern-${sectionId} .sbc-concern-data[data-concern="${concern}"]`
    );
    if (!concernDataEl) return;

    const products = data.products && data.products.length > 0 ? data.products : [];

    // Remove any previous carousel
    const existing = concernDataEl.querySelector('.sbc-mobile-carousel-wrapper');
    if (existing) existing.remove();

    if (products.length === 0) {
      concernDataEl.innerHTML = '<div style="padding:30px;text-align:center;color:#666;font-size:14px;">No products configured for this concern.</div>';
      return;
    }

    // Build slides: 2 products per slide
    const slides = [];
    for (let i = 0; i < products.length; i += 2) {
      slides.push(products.slice(i, i + 2));
    }

    // Wrapper
    const wrapper = document.createElement('div');
    wrapper.className = 'sbc-mobile-carousel-wrapper';

    // Track
    const track = document.createElement('div');
    track.className = 'sbc-mobile-carousel-track';

    slides.forEach((slideProducts) => {
      const slide = document.createElement('div');
      slide.className = 'sbc-mobile-carousel-slide';

      slideProducts.forEach(product => {
        const card = document.createElement('div');
        card.className = 'sbc-product-card';
        if (product.url && product.url !== '#') {
          card.onclick = () => window.location.href = product.url;
        }
        const media = product.customImage || product.image;
        card.innerHTML = `
          <div class="sbc-product-content">
            <div class="sbc-product-header">
              <div class="sbc-product-title">${product.title}</div>
            </div>
            <img src="${media}" alt="${product.title}" class="sbc-product-image" width="160" height="160" loading="lazy">
            <div class="sbc-product-footer">
              <div class="sbc-product-button">Shop Now</div>
              <div class="sbc-product-price">${product.price ? 'Starting at ' + product.price + ' per month' : ''}</div>
            </div>
          </div>
        `;
        slide.appendChild(card);
      });

      track.appendChild(slide);
    });

    wrapper.appendChild(track);

    // Dots
    const dotsContainer = document.createElement('div');
    dotsContainer.className = 'sbc-mobile-carousel-dots';

    let currentSlide = 0;

    function goToSlide(index) {
      currentSlide = Math.max(0, Math.min(index, slides.length - 1));
      track.style.transform = `translateX(-${currentSlide * 100}%)`;
      dotsContainer.querySelectorAll('.sbc-mobile-carousel-dot').forEach((dot, i) => {
        dot.classList.toggle('active', i === currentSlide);
      });
    }

    slides.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.className = 'sbc-mobile-carousel-dot' + (i === 0 ? ' active' : '');
      dot.setAttribute('aria-label', `Slide ${i + 1}`);
      dot.addEventListener('click', () => goToSlide(i));
      dotsContainer.appendChild(dot);
    });

    wrapper.appendChild(dotsContainer);

    // Touch swipe
    let touchStartX = 0;
    let touchDeltaX = 0;
    let isSwiping = false;

    wrapper.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      touchDeltaX = 0;
      isSwiping = true;
    }, { passive: true });

    wrapper.addEventListener('touchmove', (e) => {
      if (!isSwiping) return;
      touchDeltaX = e.touches[0].clientX - touchStartX;
    }, { passive: true });

    wrapper.addEventListener('touchend', () => {
      if (!isSwiping) return;
      isSwiping = false;
      if (Math.abs(touchDeltaX) > 40) {
        if (touchDeltaX < 0) {
          goToSlide(currentSlide + 1);
        } else {
          goToSlide(currentSlide - 1);
        }
      }
      touchDeltaX = 0;
    });

    // Replace container contents with carousel
    concernDataEl.innerHTML = '';
    concernDataEl.appendChild(wrapper);
  }

  function buildAllMobileCarousels(sectionId) {
    if (!isMobile()) return;
    const concerns = ['dullness', 'wrinkles', 'undereye', 'anti-aging', 'sunburn', 'acne'];
    concerns.forEach(c => buildMobileCarousel(c, sectionId));
  }

  // ── Hook into existing switchConcern to also update mobile header ──
  const _origSwitchConcern = switchConcern;
  switchConcern = function(concern, sectionId, event) {
    const result = _origSwitchConcern(concern, sectionId, event);

    if (isMobile()) {
      updateProductsHeader(concern, sectionId);
      const concernDataEl = document.querySelector(
        `#skin-by-concern-${sectionId} .sbc-concern-data[data-concern="${concern}"]`
      );
      if (concernDataEl && !concernDataEl.querySelector('.sbc-mobile-carousel-wrapper')) {
        buildMobileCarousel(concern, sectionId);
      } else if (concernDataEl) {
        // Reset existing carousel to slide 1 and update dots
        const track = concernDataEl.querySelector('.sbc-mobile-carousel-track');
        if (track) track.style.transform = 'translateX(0%)';
        const dots = concernDataEl.querySelectorAll('.sbc-mobile-carousel-dot');
        dots.forEach((d, i) => d.classList.toggle('active', i === 0));
      }
    } else if (isTablet()) {
      updateProductsHeader(concern, sectionId);
      const concernDataEl = document.querySelector(
        `#skin-by-concern-${sectionId} .sbc-concern-data[data-concern="${concern}"]`
      );
      if (concernDataEl && !concernDataEl.querySelector('.sbc-tablet-carousel-wrapper')) {
        buildTabletCarousel(concern, sectionId);
      } else if (concernDataEl) {
        // Reset existing tablet carousel to slide 1 and update dots
        const track = concernDataEl.querySelector('.sbc-tablet-carousel-track');
        if (track) track.style.transform = 'translateX(0%)';
        const dots = concernDataEl.querySelectorAll('.sbc-tablet-carousel-dot');
        dots.forEach((d, i) => d.classList.toggle('active', i === 0));
      }
    }
    // Desktop: scroll reset already done in core switchConcern above

    return result;
  };

  // Initialize mobile carousels on load
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    if (isMobile()) {
      buildAllMobileCarousels(sectionId);
    }
  });

  // Re-init on resize crossing the 768px boundary
  (function() {
    let wasMobile = window.innerWidth <= 768;
    window.addEventListener('resize', function() {
      const nowMobile = window.innerWidth <= 768;
      if (nowMobile !== wasMobile) {
        wasMobile = nowMobile;
        if (nowMobile) {
          buildAllMobileCarousels('{{ section.id }}');
        }
      }
    });
  })();
  // ── TABLET CAROUSEL ──────────────────────────────────────────
  // Runs only on tablet (769px–1024px). 3 products per slide.
  // Desktop and mobile code are NOT modified.

  function isTablet() {
    return window.innerWidth >= 769 && window.innerWidth <= 1024;
  }

  function buildTabletCarousel(concern, sectionId) {
    if (!isTablet()) return;

    const data = concernData[concern];
    if (!data) return;

    const concernDataEl = document.querySelector(
      `#skin-by-concern-${sectionId} .sbc-concern-data[data-concern="${concern}"]`
    );
    if (!concernDataEl) return;

    const products = data.products && data.products.length > 0 ? data.products : [];

    // Remove any previous tablet carousel
    const existing = concernDataEl.querySelector('.sbc-tablet-carousel-wrapper');
    if (existing) existing.remove();

    if (products.length === 0) {
      concernDataEl.innerHTML = '<div style="padding:40px;text-align:center;color:#666;font-size:15px;">No products configured for this concern.</div>';
      return;
    }

    // Build slides: 3 products per slide
    const slides = [];
    for (let i = 0; i < products.length; i += 3) {
      slides.push(products.slice(i, i + 3));
    }

    const wrapper = document.createElement('div');
    wrapper.className = 'sbc-tablet-carousel-wrapper';

    const track = document.createElement('div');
    track.className = 'sbc-tablet-carousel-track';

    slides.forEach((slideProducts) => {
      const slide = document.createElement('div');
      slide.className = 'sbc-tablet-carousel-slide';

      slideProducts.forEach(product => {
        const card = document.createElement('div');
        card.className = 'sbc-product-card';
        if (product.url && product.url !== '#') {
          card.onclick = () => window.location.href = product.url;
        }
        const media = product.customImage || product.image;
        card.innerHTML = `
          <div class="sbc-product-content">
            <div class="sbc-product-header">
              <div class="sbc-product-title">${product.title}</div>
            </div>
            <img src="${media}" alt="${product.title}" class="sbc-product-image" width="180" height="180" loading="lazy">
            <div class="sbc-product-footer">
              <div class="sbc-product-button">Shop Now</div>
              <div class="sbc-product-price">${product.price ? 'Starting at ' + product.price + ' per month' : ''}</div>
            </div>
          </div>
        `;
        slide.appendChild(card);
      });

      track.appendChild(slide);
    });

    wrapper.appendChild(track);

    // Dots
    const dotsContainer = document.createElement('div');
    dotsContainer.className = 'sbc-tablet-carousel-dots';

    let currentSlide = 0;

    function goToSlide(index) {
      currentSlide = Math.max(0, Math.min(index, slides.length - 1));
      track.style.transform = `translateX(-${currentSlide * 100}%)`;
      dotsContainer.querySelectorAll('.sbc-tablet-carousel-dot').forEach((dot, i) => {
        dot.classList.toggle('active', i === currentSlide);
      });
    }

    slides.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.className = 'sbc-tablet-carousel-dot' + (i === 0 ? ' active' : '');
      dot.setAttribute('aria-label', `Slide ${i + 1}`);
      dot.addEventListener('click', () => goToSlide(i));
      dotsContainer.appendChild(dot);
    });

    wrapper.appendChild(dotsContainer);

    // Touch swipe
    let tStartX = 0;
    let tDeltaX = 0;
    let tSwiping = false;

    wrapper.addEventListener('touchstart', (e) => {
      tStartX = e.touches[0].clientX;
      tDeltaX = 0;
      tSwiping = true;
    }, { passive: true });

    wrapper.addEventListener('touchmove', (e) => {
      if (!tSwiping) return;
      tDeltaX = e.touches[0].clientX - tStartX;
    }, { passive: true });

    wrapper.addEventListener('touchend', () => {
      if (!tSwiping) return;
      tSwiping = false;
      if (Math.abs(tDeltaX) > 50) {
        goToSlide(tDeltaX < 0 ? currentSlide + 1 : currentSlide - 1);
      }
      tDeltaX = 0;
    });

    concernDataEl.innerHTML = '';
    concernDataEl.appendChild(wrapper);
  }

  function buildAllTabletCarousels(sectionId) {
    if (!isTablet()) return;
    ['dullness', 'wrinkles', 'undereye', 'anti-aging', 'sunburn', 'acne'].forEach(c => {
      buildTabletCarousel(c, sectionId);
    });
  }

  // Initialize tablet carousels on load
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    if (isTablet()) {
      buildAllTabletCarousels(sectionId);
    }
  });

  // Re-init on resize crossing tablet boundary
  (function() {
    let wasTablet = window.innerWidth >= 769 && window.innerWidth <= 1024;
    window.addEventListener('resize', function() {
      const nowTablet = window.innerWidth >= 769 && window.innerWidth <= 1024;
      if (nowTablet !== wasTablet) {
        wasTablet = nowTablet;
        if (nowTablet) {
          buildAllTabletCarousels('{{ section.id }}');
        }
      }
    });
  })();
  // ── END TABLET CAROUSEL ───────────────────────────────────────
  function initializeTabPositioning(sectionId) {
    const sectionElement = document.getElementById(`skin-by-concern-${sectionId}`);
    const tabsElement = sectionElement.querySelector('.sbc-concern-tabs');
   
    if (!sectionElement || !tabsElement) return;
   
    // Tabs are already sticky within the section via CSS
    // Just ensure they stay visible when section is in view
    const sectionObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && entry.intersectionRatio >= 0.1) {
          // Section is visible - ensure tabs are visible
          tabsElement.style.opacity = '1';
          tabsElement.style.visibility = 'visible';
        } else if (entry.intersectionRatio < 0.05) {
          // Section is barely visible - fade out tabs
          tabsElement.style.opacity = '0';
          tabsElement.style.visibility = 'hidden';
        }
      });
    }, {
      threshold: [0.05, 0.1, 0.9],
      rootMargin: '0px'
    });
   
    sectionObserver.observe(sectionElement);
  }
  // Initialize everything when DOM is ready
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
   
    // Initialize slider
    initializeSlider(sectionId);
   
    // Initialize tab listeners
    initializeTabListeners(sectionId);
   
    // Initialize tab positioning
    initializeTabPositioning(sectionId);
   
    // Load initial content — use rAF so layout is settled before scroll resets fire
    requestAnimationFrame(() => {
      switchConcern._isInitCall = true;
      switchConcern('dullness', sectionId);
      switchConcern._isInitCall = false;
    });
  });

  // Also initialize if DOM is already loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      const sectionId = '{{ section.id }}';
      initializeSlider(sectionId);
      initializeTabListeners(sectionId);
      initializeTabPositioning(sectionId);
      requestAnimationFrame(() => {
        switchConcern._isInitCall = true;
        switchConcern('dullness', sectionId);
        switchConcern._isInitCall = false;
      });
    });
  } else {
    const sectionId = '{{ section.id }}';
    initializeSlider(sectionId);
    initializeTabListeners(sectionId);
    initializeTabPositioning(sectionId);
    requestAnimationFrame(() => {
      switchConcern._isInitCall = true;
      switchConcern('dullness', sectionId);
      switchConcern._isInitCall = false;
    });
  }
</script>

