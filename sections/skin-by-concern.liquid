<style>
  .sbc-skin-by-concern-section {
    padding: 0;
    background: #ffffff;
    font-family: 'Montserrat', sans-serif;
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: 100vh;
    {% comment %} margin-top: 80px; /* Add space from previous section */ {% endcomment %}
  }

  .sbc-skin-by-concern-container {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  /* Full Width Tab Navigation */
  .sbc-concern-tabs {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 8px;
    width: 100%;
    margin-bottom: 0;
    padding: 20px 20px;
    position: sticky;
    top: 0;
    left: 0;
    z-index: 100;
    background: white;
  }

  .sbc-concern-tab {
    background: white;
    color: #000;
    border: 1px solid #000;
    border-radius: 8px;
    padding: 8px 15px;
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    white-space: nowrap;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 16.6%;
    min-height: 44px;
  }

  .sbc-concern-tab:hover:not(.active) {
    background: #000;
    color: white;
    border-color: #000;
  }

  .sbc-concern-tab.active {
    background: #000;
    color: white;
    border-color: #000;
    z-index: 2;
  }

  .sbc-concern-tab.active::before {
    content: '';
    width: 8px;
    height: 8px;
    background: #00E0FF;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Main Content Layout */
  .sbc-concern-content {
    display: flex;
    width: 100%;
    min-height: calc(100vh - 60px);
    gap: 0;
    align-items: flex-start;
    position: relative;
  }

  /* Before/After Image Section - Sticky within section */
  .sbc-before-after-section {
    width: 50%;
    height: calc(100vh - 60px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 20px;
    position: sticky;
    top: 60px;
    background: white;
    z-index: 10;
    align-self: flex-start;
  }

  .sbc-before-after-container {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    user-select: none;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    touch-action: pan-y;
    cursor: default;
  }

  .before-sbc-after-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  /* After image - always fully visible as base layer */
  .sbc-after-image {
    z-index: 1;
  }

  /* Before image - clipped to show only left portion up to divider */
  .sbc-before-image {
    z-index: 2;
    clip-path: inset(0 50% 0 0);
    will-change: clip-path;
    transform: translateZ(0);
  }

  .sbc-slider-handle {  
    position: absolute;
    top: 0;
    left: 50%;
    width: 3px;
    height: 100%;
    background: rgba(255, 255, 255, 0.9);
    cursor: default;
    transform: translateX(-50%);
    z-index: 10;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.4);
    transition: background 0.2s ease;
    pointer-events: none;
  }

  .sbc-slider-handle:hover {
    background: rgba(255, 255, 255, 1);
    width: 4px;
  }

  .sbc-slider-button {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.95);
    border: 3px solid #00E0FF;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    cursor: ew-resize;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
    pointer-events: all;
    touch-action: none;
    z-index: 11;
    transition: all 0.2s ease;
  }

  .sbc-slider-button:hover {
    background: rgba(255, 255, 255, 1);
    border-color: #00B8CC;
    transform: translate(-50%, -50%) scale(1.1);
  }

  .sbc-slider-button::before,
  .sbc-slider-button::after {
    content: '';
    position: absolute;
    width: 8px;
    height: 2px;
    background: #00E0FF;
  }

  .sbc-slider-button::before {
    transform: rotate(45deg) translateX(-2px);
  }

  .sbc-slider-button::after {
    transform: rotate(-45deg) translateX(-2px);
  }

  .sbc-image-labels {
    display: flex;
    justify-content: space-between;
    margin-top: 15px;
    font-size: 14px;
    color: #666;
  }

  .sbc-label-left {
    font-weight: 600;
  }

  .sbc-label-right {
    font-weight: 600;
    text-align: right;
  }

  /* Products Section */
  .sbc-products-section {
    width: 50%;
    background: #ffffff;
    padding: 0;
    position: relative;
    min-height: calc(100vh - 60px);
    overflow: visible;
    display: flex;
    flex-direction: column;
  }

  /* Hide scrollbar for WebKit browsers (Chrome, Safari, Edge) */
  .sbc-products-section::-webkit-scrollbar {
    display: none;
  }

  /* Sticky Title and Description */
  .sbc-products-header {
    margin-top: 0;
    padding-top: 30px;
    position: sticky;
    top: 60px;
    background: white;
    z-index: 50;
    padding-bottom: 10px;
    {% comment %} border-bottom: 1px solid rgba(0, 0, 0, 0.1); {% endcomment %}
    flex-shrink: 0;
    /* Ensure header is not affected by transforms */
    transform: none !important;
    will-change: auto;
    padding-left: 15px;
    padding-right: 15px;
    /* Add white mask above the header */
    background: white;
    /* Extend the background upward */
    padding-top: 20px;
  }

  /* Create a large white mask above the header */
  .sbc-products-header::before {
    content: '';
    position: absolute;
    top: -100px;
    left: 0;
    right: 0;
    height: 120px;
    background: white;
    z-index: 51;
  }

  .sbc-concern-products-title {
    font-size:35px;
    font-weight: 900;
    color: #333333;
    margin-bottom: 3px;
    line-height: 1.1;
  }

  .sbc-products-description {
    font-size: 17px;
    color: #666666;
    line-height: 1.3;
    margin-top: 8px;
    {% comment %} margin-bottom: 0; {% endcomment %}
    {% comment %} padding-bottom: 25px {% endcomment %}
  }

  /* Products Container with padding */
  .sbc-products-content {
    padding: 20px 15px 40px 15px;
    position: relative;
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    /* Hide scrollbar while keeping scroll functionality */
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* Internet Explorer 10+ */
    /* Prevent any transforms from being applied */
    transform: none !important;
  }

  /* Hide scrollbar for WebKit browsers (Chrome, Safari, Edge) */
  .sbc-products-content::-webkit-scrollbar {
    display: none;
  }

  /* Remove scroll indicators - they're causing visual clutter */

  .sbc-products-scroll-container {
    display: flex;
    flex-direction: column;
    gap: 25px;
    padding: 0;
    width: 100%;
    height: auto;
    position: relative;
  }

  .sbc-products-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    opacity: 1;
    transform: translateY(0) scale(1);
    transition: all 0.6s ease;
    align-items: stretch;
    justify-items: stretch;
    height: 460px;
    flex-shrink: 0;
    padding: 10px;
    position: relative;
  }


  .sbc-products-row.visible {
    opacity: 1;
    transform: translateY(0);
  }


  .sbc-product-card {
    background: var(--tile-bg-color, #ffffff);
    padding: 50px;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: none;
    cursor: pointer;
    height: 100%;
    max-height: 420px;
    display: flex;
     padding: 25px 15px 40px 15px;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    border-radius: var(--tile-radius, 16px);
    position: relative;
    overflow: visible;
    box-shadow: 5px 5px 10px rgba(204, 226, 226, 0.77);
  }


  .sbc-product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 24px rgba(204, 226, 226, 0.77);
  }



  .sbc-product-code {
    position: absolute;
    top: 15px;
    right: 15px;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 500;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }


  .sbc-product-content {
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
    align-items: center;
  }




  .sbc-product-header {
    margin-top: 15px;
    flex-shrink: 0;
  }


  .sbc-product-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--tile-text-color, #ffffff);
    margin: 0 0 10px 0;
    line-height: 1.1;
    text-transform: none;
    letter-spacing: 0;
    text-align: center;
  }

  .sbc-product-image {
    width: 100%;
    height: 300px;
    max-width: 300px;
    object-fit: contain;
    object-position: center;
    margin: 10px auto;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    padding: 12px;
    box-sizing: border-box;
    flex: 1;
    min-height: 200px;
    display: block;
  }

  .sbc-product-footer {
    margin-top: auto;
    flex-shrink: 0;
  }

  .sbc-product-button {
    {% comment %} background: rgba(0, 0, 0, 0.9); {% endcomment %}
    background: #4FFFFF;
    color: rgba(0, 0, 0, 0.9);
    padding: 10px 34px;
    border-radius: 25px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 12px;
    transition: all 0.3s ease;
    border: none;
  }

  .sbc-product-button:hover {
    background: cyan;
    color: #000000;
    transform: translateY(-2px);
  }

  .sbc-product-price {
    font-size: 13px;
    font-weight: 400;
    color: black;
    margin: 0;
  }

  .sbc-product-subtitle {
    display: none;
  }

  .sbc-product-rating {
    display: none;

  }

  /* Hidden content for other concerns */
  .sbc-concern-data {
    display: none;
  }

  .sbc-concern-data.active {
    display: block;
  }

  /* Ensure section ends after last product */
  .sbc-products-row:last-child {
    margin-bottom: 0;
  }

  .sbc-products-scroll-container:after {
    content: '';
    display: block;
    height: 40px;
  }

  /* =============================================
     TABLET ONLY - 769px to 1024px
     Desktop code above is NOT touched
     Mobile code below is NOT touched
     ============================================= */
  @media (min-width: 769px) and (max-width: 1024px) {

    /* --- Section reset --- */
    .sbc-skin-by-concern-section {
      min-height: auto;
      margin-top: 0;
    }

    .sbc-skin-by-concern-container {
      padding: 0;
    }

    /* --- Tabs: all 6 in one row, full width --- */
    .sbc-concern-tabs {
      display: grid !important;
      grid-template-columns: repeat(6, 1fr) !important;
      gap: 6px !important;
      padding: 14px 16px !important;
      position: sticky;
      top: 0;
      z-index: 100;
      background: #ffffff;
      overflow: hidden !important;
      border-bottom: 1px solid rgba(0,0,0,0.06);
      width: 100% !important;
      box-sizing: border-box !important;
    }

    .sbc-concern-tab {
      padding: 9px 6px !important;
      font-size: 13px !important;
      font-weight: 500;
      min-width: 0 !important;
      width: 100% !important;
      min-height: 40px !important;
      border-radius: 8px !important;
      white-space: normal !important;
      word-break: break-word;
      text-align: center !important;
      justify-content: center;
      align-items: center;
      gap: 4px !important;
      line-height: 1.2 !important;
      display: flex !important;
    }

    .sbc-concern-tab.active::before {
      width: 7px !important;
      height: 7px !important;
      flex-shrink: 0;
      min-width: 7px;
    }

    /* --- Main content stacks vertically --- */
    .sbc-concern-content {
      flex-direction: column !important;
      min-height: auto !important;
      gap: 0;
    }

    /* --- Before/After: full width --- */
    .sbc-before-after-section {
      position: relative !important;
      width: 100% !important;
      height: auto !important;
      padding: 20px 20px 0 20px !important;
      top: auto !important;
      left: auto !important;
      align-self: auto !important;
    }

    .sbc-before-after-container {
      height: {{ section.settings.tablet_before_after_height | default: 600 }}px !important;
      min-height: unset !important;
      max-height: unset !important;
      border-radius: 16px;
    }

    .sbc-image-labels {
      margin-top: 12px;
      font-size: 13px;
      padding: 0 4px;
    }

    /* --- Products section: full width --- */
    .sbc-products-section {
      position: relative !important;
      width: 100% !important;
      min-height: auto !important;
      max-height: none !important;
      overflow: visible !important;
      padding: 0 !important;
    }

    /* --- Products header: centered below image --- */
    .sbc-products-header {
      position: relative !important;
      top: auto !important;
      background: #ffffff !important;
      z-index: 1 !important;
      padding: 24px 20px 14px 20px !important;
      border-bottom: none !important;
      box-shadow: none !important;
      text-align: center;
    }

    .sbc-products-header::before {
      display: none !important;
    }

    .sbc-concern-products-title {
      font-size: {{ section.settings.tablet_title_font_size | default: 36 }}px !important;
      font-weight: 900 !important;
      color: #1a1a1a !important;
      margin-bottom: 10px !important;
      line-height: 1.15 !important;
      text-align: center;
    }

    .sbc-products-description {
      font-size: {{ section.settings.tablet_description_font_size | default: 16 }}px !important;
      color: #666666 !important;
      line-height: 1.5 !important;
      margin: 0 !important;
      text-align: center;
    }

    /* --- Products content: no scroll, carousel handles it --- */
    .sbc-products-content {
      overflow: visible !important;
      padding: 0 !important;
      flex: none !important;
      transform: none !important;
    }

    /* --- Tablet carousel wrapper --- */
    .sbc-tablet-carousel-wrapper {
      position: relative;
      width: 100%;
      overflow: hidden;
      padding: 20px 0 0 0;
    }

    .sbc-tablet-carousel-track {
      display: flex;
      flex-direction: row;
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: transform;
    }

    .sbc-tablet-carousel-slide {
      flex: 0 0 100%;
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
      padding: 0 20px;
      box-sizing: border-box;
    }

    /* --- Nav dots --- */
    .sbc-tablet-carousel-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding: 20px 0 28px 0;
    }

    .sbc-tablet-carousel-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: {{ section.settings.tablet_dot_inactive_color | default: '#d0d0d0' }};
      cursor: pointer;
      transition: background 0.2s ease, transform 0.2s ease;
      border: none;
      padding: 0;
    }

    .sbc-tablet-carousel-dot.active {
      background: {{ section.settings.tablet_dot_active_color | default: '#00E0FF' }};
      transform: scale(1.3);
    }

    /* --- Product card on tablet --- */
    .sbc-product-card {
      max-height: none !important;
      height: auto !important;
      padding: 16px 12px 18px 12px !important;
      border-radius: 16px !important;
      box-shadow: 4px 4px 12px rgba(204, 226, 226, 0.8) !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      justify-content: space-between !important;
      background: #ffffff !important;
    }

    .sbc-product-content {
      align-items: center;
      width: 100%;
    }

    .sbc-product-header {
      margin-top: 10px;
    }

    .sbc-product-title {
      font-size: 13px !important;
      font-weight: 700 !important;
      color: var(--tile-text-color, #1a1a1a) !important;
      text-align: center !important;
      margin: 0 0 8px 0 !important;
      line-height: 1.3 !important;
    }

    .sbc-product-image {
      height: {{ section.settings.tablet_card_image_height | default: 160 }}px !important;
      min-height: unset !important;
      max-width: 100% !important;
      width: 100% !important;
      object-fit: contain !important;
      margin: 10px auto !important;
      padding: 8px !important;
      flex: none !important;
    }

    .sbc-product-footer {
      margin-top: 10px;
      width: 100%;
      text-align: center;
    }

    .sbc-product-button {
      font-size: 12px !important;
      padding: 8px 20px !important;
      border-radius: 20px !important;
      margin-bottom: 8px !important;
      display: inline-block;
    }

    .sbc-product-price {
      font-size: 11px !important;
      color: #555 !important;
    }

    .sbc-product-code {
      font-size: 10px !important;
      top: 10px !important;
      right: 10px !important;
    }

    /* Hide desktop sbc-products-row on tablet (carousel JS rebuilds it) */
    .sbc-products-row {
      display: none !important;
    }

  }

  /* =============================================
     MOBILE ONLY - max-width: 768px
     Desktop code above is NOT touched
     ============================================= */
  @media (max-width: 768px) {

    /* --- Section reset --- */
    .sbc-skin-by-concern-section {
      min-height: auto;
      margin-top: 0;
    }

    .sbc-skin-by-concern-container {
      padding: 0;
    }

    /* --- Tabs: all 6 fit in one row --- */
    .sbc-concern-tabs {
      display: grid !important;
      grid-template-columns: repeat(6, 1fr) !important;
      gap: 3px !important;
      padding: 8px 6px !important;
      position: sticky;
      top: 0;
      z-index: 100;
      background: #ffffff;
      overflow: hidden !important;
      border-bottom: 1px solid rgba(0,0,0,0.06);
      width: 100% !important;
      box-sizing: border-box !important;
    }

    .sbc-concern-tab {
      flex: none;
      padding: 0 2px !important;
      font-size: 8px !important;
      font-weight: 500;
      min-width: 0 !important;
      width: 100% !important;
      min-height: 30px !important;
      border-radius: 6px !important;
      white-space: normal !important;
      overflow: hidden;
      word-break: break-word;
      text-align: center !important;
      justify-content: center;
      align-items: center;
      gap: 2px !important;
      line-height: 1.2 !important;
      display: flex !important;
    }

    .sbc-concern-tab.active::before {
      width: 5px !important;
      height: 5px !important;
      flex-shrink: 0;
      min-width: 5px;
    }

    /* --- Main content stacks vertically --- */
    .sbc-concern-content {
      flex-direction: column !important;
      min-height: auto !important;
      gap: 0;
    }

    /* --- Before/After image: full width --- */
    .sbc-before-after-section {
      position: relative !important;
      width: 100% !important;
      height: auto !important;
      padding: 16px 16px 0 16px !important;
      top: auto !important;
      left: auto !important;
      align-self: auto !important;
    }

    .sbc-before-after-container {
      height: {{ section.settings.mobile_before_after_height | default: 260 }}px !important;
      min-height: unset !important;
      max-height: unset !important;
      border-radius: 16px;
    }

    .sbc-image-labels {
      margin-top: 10px;
      font-size: 12px;
      padding: 0 4px;
    }

    /* --- Products section: full width, no overflow clipping --- */
    .sbc-products-section {
      position: relative !important;
      width: 100% !important;
      min-height: auto !important;
      max-height: none !important;
      overflow: visible !important;
      padding: 0 !important;
    }

    /* --- Products header: title + description, centered --- */
    .sbc-products-header {
      position: relative !important;
      top: auto !important;
      background: #ffffff !important;
      z-index: 1 !important;
      padding: 20px 16px 12px 16px !important;
      border-bottom: none !important;
      box-shadow: none !important;
      text-align: center;
    }

    .sbc-products-header::before {
      display: none !important;
    }

    .sbc-concern-products-title {
      font-size: {{ section.settings.mobile_title_font_size | default: 28 }}px !important;
      font-weight: 900 !important;
      color: #1a1a1a !important;
      margin-bottom: 8px !important;
      line-height: 1.15 !important;
      text-align: center;
    }

    .sbc-products-description {
      font-size: {{ section.settings.mobile_description_font_size | default: 14 }}px !important;
      color: #666666 !important;
      line-height: 1.5 !important;
      margin: 0 !important;
      text-align: center;
    }

    /* --- Products content: no scroll, let carousel handle it --- */
    .sbc-products-content {
      overflow: visible !important;
      padding: 0 !important;
      flex: none !important;
      transform: none !important;
    }

    /* --- Carousel wrapper (added by JS on mobile) --- */
    .sbc-mobile-carousel-wrapper {
      position: relative;
      width: 100%;
      overflow: hidden;
      padding: 16px 0 0 0;
    }

    .sbc-mobile-carousel-track {
      display: flex;
      flex-direction: row;
      transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: transform;
    }

    .sbc-mobile-carousel-slide {
      flex: 0 0 100%;
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      padding: 0 16px;
      box-sizing: border-box;
    }

    /* --- Nav dots --- */
    .sbc-mobile-carousel-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding: 16px 0 24px 0;
    }

    .sbc-mobile-carousel-dot {
      width: 8px;
      height: 8px;
