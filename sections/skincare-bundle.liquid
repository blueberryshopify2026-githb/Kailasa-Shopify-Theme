      "label": "CTA Button Text",
      "default": "Explore the full routine →"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "color",
      "id": "cta_bg_color",
      "label": "CTA Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "cta_hover_color",
      "label": "CTA Hover Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "CTA Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "cta_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
