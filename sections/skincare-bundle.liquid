      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 16
    },
    {
      "type": "color",
      "id": "description_color",
