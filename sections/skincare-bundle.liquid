      "label": "CTA Border Radius",
      "default": 50
    },
    {
      "type": "range",
      "id": "cta_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "CTA Font Size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Products Area"
    },
    {
      "type": "image_picker",
      "id": "bundle_image",
      "label": "Bundle Products Image"
    },
    {
      "type": "color",
