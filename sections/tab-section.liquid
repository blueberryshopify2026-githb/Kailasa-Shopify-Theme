<script>
  function toggleTabContent(button) {
    const contentInner = button.nextElementSibling.querySelector('.sts-tab-content-inner');
    const isExpanded = button.getAttribute('aria-expanded') === 'true';

    button.setAttribute('aria-expanded', !isExpanded);
    contentInner.style.display = isExpanded ? 'none' : 'block';
  }

  function switchInnerTab(button, tabIndex) {
    const section = button.closest('.sts-tab-section');

    // Remove active class from all inner tab buttons and content
    section.querySelectorAll('.sts-inner-tab-nav-button').forEach((btn) => btn.classList.remove('active'));
    section.querySelectorAll('.sts-inner-tab-content').forEach((content) => content.classList.remove('active'));

    // Add active class to clicked button and corresponding content
    button.classList.add('active');
    section.querySelector(`.sts-inner-tab-content[data-tab="${tabIndex}"]`).classList.add('active');
  }

  function stsToggleFAQ(button) {
    const faqItem = button.closest('.sts-faq-item');
    const faqList = button.closest('.sts-faq-list');
    const answer = faqItem.querySelector('.sts-faq-answer');
    const isActive = button.classList.contains('active');

    // Close all other FAQs in the same list
    faqList.querySelectorAll('.sts-faq-question').forEach((q) => {
      q.classList.remove('active');
      q.closest('.sts-faq-item').querySelector('.sts-faq-answer').classList.remove('active');
    });

    // Toggle current FAQ
    if (!isActive) {
      button.classList.add('active');
      answer.classList.add('active');
    }
  }

  function scrollIngredients(button, direction) {
    const ingredientsSection = button.closest('.sts-ingredients-section');
    const scrollContainer = ingredientsSection.querySelector('.sts-ingredients-list-container');

    if (!scrollContainer) return;

    const scrollAmount = 120; // Scroll by approximately one ingredient height
    const currentScrollTop = scrollContainer.scrollTop;

    if (direction === 'up') {
      scrollContainer.scrollTo({
        top: Math.max(0, currentScrollTop - scrollAmount),
        behavior: 'smooth',
      });
    } else if (direction === 'down') {
      scrollContainer.scrollTo({
        top: currentScrollTop + scrollAmount,
        behavior: 'smooth',
      });
    }
  }

  function scrollFAQs(button, direction) {
    const faqSection = button.closest('.sts-faq-section');
    const scrollContainer = faqSection.querySelector('.sts-faq-list-container');

    if (!scrollContainer) return;

    const scrollAmount = 100; // Scroll by approximately one FAQ height
    const currentScrollTop = scrollContainer.scrollTop;

    if (direction === 'up') {
      scrollContainer.scrollTo({
        top: Math.max(0, currentScrollTop - scrollAmount),
        behavior: 'smooth',
      });
    } else if (direction === 'down') {
      scrollContainer.scrollTo({
        top: currentScrollTop + scrollAmount,
        behavior: 'smooth',
      });
    }
  }

  // Force refresh for live theme editor updates
  if (window.Shopify && window.Shopify.designMode) {
    document.addEventListener('shopify:section:load', function (event) {
      // Re-initialize dropdown functionality
      const dropdownButtons = event.target.querySelectorAll('.sts-tab-button');
      dropdownButtons.forEach((button) => {
        button.addEventListener('click', function () {
          toggleTabContent(this);
        });
      });

      // Re-initialize inner tab functionality
      const innerTabButtons = event.target.querySelectorAll('.sts-inner-tab-nav-button');
      innerTabButtons.forEach((button, index) => {
        button.addEventListener('click', function () {
          switchInnerTab(this, index);
        });
      });

      // Re-initialize FAQ functionality
      const faqButtons = event.target.querySelectorAll('.sts-faq-question');
      faqButtons.forEach((button) => {
        button.addEventListener('click', function () {
          stsToggleFAQ(this);
        });
      });
    });
  }
</script>

