<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Gilroy:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
  rel="stylesheet"
>

<section
  class="sts-tab-section"
  data-section-id="{{ section.id }}"
  style="
    --tab-bg-color: {{ section.settings.background_color }};
    --tab-text-color: {{ section.settings.text_color }};
    --tab-border-color: {{ section.settings.border_color }};
    --tab-border-width: {{ section.settings.border_width }}px;
    --title-font-family: {{ section.settings.title_font_family }};
    --title-font-weight: {{ section.settings.title_font_weight }};
    --title-font-style: {{ section.settings.title_font_style }};
    --title-font-size-desktop: {{ section.settings.title_font_size_desktop }}px;
    --title-font-size-tablet: {{ section.settings.title_font_size_tablet }}px;
    --title-font-size-mobile: {{ section.settings.title_font_size_mobile }}px;
    --tab-font-family: {{ section.settings.tab_font_family }};
    --tab-font-weight: {{ section.settings.tab_font_weight }};
    --tab-font-style: {{ section.settings.tab_font_style }};
    --tab-font-size-desktop: {{ section.settings.tab_font_size_desktop }}px;
    --tab-font-size-tablet: {{ section.settings.tab_font_size_tablet }}px;
    --tab-font-size-mobile: {{ section.settings.tab_font_size_mobile }}px;
    --tab-height-desktop: {{ section.settings.height_desktop }}px;
    --tab-height-tablet: {{ section.settings.height_tablet }}px;
    --tab-height-mobile: {{ section.settings.height_mobile }}px;
    --tab-title-padding-desktop: {{ section.settings.title_padding_desktop }}px;
    --tab-title-padding-tablet: {{ section.settings.title_padding_tablet }}px;
    --tab-title-padding-mobile: {{ section.settings.title_padding_mobile }}px;
    --tab-arrow-padding-desktop: {{ section.settings.arrow_padding_desktop }}px;
    --tab-arrow-padding-tablet: {{ section.settings.arrow_padding_tablet }}px;
    --tab-arrow-padding-mobile: {{ section.settings.arrow_padding_mobile }}px;
    --tab-arrow-size-desktop: {{ section.settings.arrow_size_desktop }}px;
    --tab-arrow-size-tablet: {{ section.settings.arrow_size_tablet }}px;
    --tab-arrow-size-mobile: {{ section.settings.arrow_size_mobile }}px;
    --tab-arrow-stroke-desktop: {{ section.settings.arrow_stroke_desktop }}px;
    --tab-arrow-stroke-tablet: {{ section.settings.arrow_stroke_tablet }}px;
    --tab-arrow-stroke-mobile: {{ section.settings.arrow_stroke_mobile }}px;
    --inner-tab-active-bg: {{ section.settings.inner_tab_active_bg }};
    --inner-tab-active-text: {{ section.settings.inner_tab_active_text }};
    --inner-tab-active-dot: {{ section.settings.inner_tab_active_dot }};
    --inner-tab-inactive-bg: {{ section.settings.inner_tab_inactive_bg }};
    --inner-tab-inactive-text: {{ section.settings.inner_tab_inactive_text }};
    --inner-tab-hover-bg: {{ section.settings.inner_tab_hover_bg }};
    --inner-tab-hover-text: {{ section.settings.inner_tab_hover_text }};
    --inner-tab-border-color: {{ section.settings.inner_tab_border_color }};
    --inner-tab-border-width: {{ section.settings.inner_tab_border_width }}px;
  "
>
  <button
    class="sts-tab-button"
    aria-expanded="false"
    data-no-focus-ring
    onclick="toggleTabContent(this)"
  >
    <h2 class="sts-tab-title">{{ section.settings.title | default: 'Photon Youth™ Pro' }}</h2>

    <div class="sts-tab-arrow">
      {% if section.settings.arrow_style == 'filled' %}
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M7 10l5 5 5-5z"/>
        </svg>
      {% else %}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <polyline points="6,9 12,15 18,9"></polyline>
        </svg>
      {% endif %}
    </div>
  </button>

  <div class="sts-tab-content">
    <div class="sts-tab-content-inner" style="display: none;">
      <!-- Inner Tab Navigation -->
      <div class="sts-inner-tab-navigation">
        {% for block in section.blocks %}
          <button
            class="sts-inner-tab-nav-button {% if forloop.first %}active{% endif %}"
            data-tab="{{ forloop.index0 }}"
            onclick="switchInnerTab(this, {{ forloop.index0 }})"
            {{ block.shopify_attributes }}
          >
            <div class="sts-tab-content-wrapper">
              <span class="sts-inner-tab-dot"></span>
              <span class="sts-tab-text">{{ block.settings.tab_name }}</span>
            </div>
          </button>
        {% endfor %}
      </div>

      <!-- Inner Tab Content -->
      <div class="sts-inner-tab-content-wrapper">
        {% for block in section.blocks %}
          <div class="sts-inner-tab-content {% if forloop.first %}active{% endif %}" data-tab="{{ forloop.index0 }}">
            {% if block.type == 'ingredient-block' %}
              <!-- Ingredient Block Content -->
              <div
                class="sts-ingredient-block"
                style="
                  display: flex;
                  align-items: stretch;
                  gap: 0;
                  padding: 0;
                  min-height: 400px;
                  {% if block.settings.layout == 'image-ingredients' %}
                    flex-direction: row-reverse;
                  {% endif %}
                "
              >
                <!-- Ingredients Section (Left Side - 50%) -->
                <div
                  class="sts-ingredients-section"
                  style="
                    flex: 1;
                    width: 50%;
                    padding: 1rem;
                    background-color: {{ block.settings.ingredient_bg_color | default: '#ffffff' }};
                    overflow: hidden;
                  "
                >
                  {% if block.settings.ingredients_title != blank %}
                    <div
                      class="sts-ingredients-header"
                      style="
                        display: flex;
                        justify-content: space-between;
                        align-items: center;
                        margin-bottom: 0.5rem;
                      "
                    >
                      <h3
                        style="
                          font-family: {{ block.settings.font_family | default: 'Montserrat, sans-serif' }};
                          font-size: {{ block.settings.section_title_font_size | default: 14 }}px;
                          font-weight: 400;
                          color: {{ block.settings.section_title_color | default: '#999999' }};
                          margin: 0;
                          text-transform: uppercase;
                          letter-spacing: 1px;
                        "
                      >
                        {{ block.settings.ingredients_title }}
                      </h3>

                      <div
                        class="sts-scroll-arrows"
                        style="
                          display: flex;
                          gap: 0.5rem;
                          align-items: center;
                          margin-right : 10px;
                        "
                      >
                        <button
                          class="sts-scroll-arrow sts-scroll-up"
                          onclick="scrollIngredients(this, 'up')"
                          style="
                            background: none;
                            border: none;
                            cursor: pointer;
                            padding: 4px;
                            color: {{ block.settings.section_title_color | default: '#999999' }};
                            font-size: 35px;
                            line-height: 1;
                            transition: opacity 0.2s ease;
                          "
                          onmouseover="this.style.opacity='0.6'"
                          onmouseout="this.style.opacity='1'"
                        >
                          &#8249;
                        </button>
                        <button
                          class="sts-scroll-arrow sts-scroll-down"
                          onclick="scrollIngredients(this, 'down')"
                          style="
                            background: none;
                            border: none;
                            cursor: pointer;
                            padding: 4px;
                            color: {{ block.settings.section_title_color | default: '#999999' }};
                            font-size: 35px;
                            line-height: 1;
                            transition: opacity 0.2s ease;
                          "
                          onmouseover="this.style.opacity='0.6'"
                          onmouseout="this.style.opacity='1'"
                        >
                          &#8250;
                        </button>
                      </div>
                    </div>
                  {% endif %}

                  <div
                    class="sts-ingredients-list-container"
                    style="
                      max-height: 500px;
                      overflow-y: auto;
                      overflow-x: hidden;
                      scrollbar-width: none;
                      -ms-overflow-style: none;
                    "
                  >
                    <div
                      class="sts-ingredients-list"
                      style="
                        display: flex;
                        flex-direction: column;
                        gap: 1.5rem;
                        padding-right: 10px;
                      "
                    >
                      {% for i in (1..20) %}
                        {% assign ingredient_image = 'ingredient_image_' | append: i %}
                        {% assign ingredient_title = 'ingredient_title_' | append: i %}
                        {% assign ingredient_description = 'ingredient_description_' | append: i %}

                        {% if block.settings[ingredient_image] != blank or block.settings[ingredient_title] != blank %}
                          <div
                            class="sts-ingredient-item"
                            style="
                              display: flex;
                              align-items: center;
                              gap: 1rem;
                              padding: 10px;
                              background-color: #D3FFFF;
                              border: none;
                              width: 100%;
                            "
                          >
                            {% if block.settings[ingredient_image] != blank %}
                              <div
                                class="sts-ingredient-image"
                                style="
                                  width: {{ block.settings.ingredient_image_size | default: 60 }}px;
                                  height: {{ block.settings.ingredient_image_size | default: 60 }}px;
                                  border-radius: 50%;
                                  overflow: hidden;
                                  flex-shrink: 0;
                                  background-color: #f8f8f8;
                                  border: none;
                                "
                              >
                                <img
                                  src="{{ block.settings[ingredient_image] | image_url: width: 120, height: 120 }}"
                                  alt="{{ block.settings[ingredient_title] | default: 'Ingredient' }}"
                                  width="120"
                                  height="120"
                                  style="width: 100%; height: 100%; object-fit: cover;"
                                >
                              </div>
                            {% endif %}

                            <div
                              class="sts-ingredient-content"
                              style="
                                flex: 1;
                                min-width: 0;
                                max-width: calc(100% - 70px);
                              "
                            >
                              {% if block.settings[ingredient_title] != blank %}
                                <h4
                                  style="
                                    font-family: {{ block.settings.font_family | default: 'Montserrat, sans-serif' }};
                                    font-size: {{ block.settings.ingredient_title_font_size | default: 16 }}px;
                                    font-weight: 600;
                                    color: {{ block.settings.ingredient_title_color | default: '#333333' }};
                                    margin: 0 0 0.5rem 0;
                                    line-height: 1.3;
                                    word-wrap: break-word;
                                    overflow-wrap: break-word;
                                  "
                                >
                                  {{ block.settings[ingredient_title] }}
                                </h4>
                              {% endif %}

                              {% if block.settings[ingredient_description] != blank %}
                                <p
                                  style="
                                    font-family: {{ block.settings.font_family | default: 'Montserrat, sans-serif' }};
                                    font-size: {{ block.settings.ingredient_desc_font_size | default: 13 }}px;
                                    font-weight: 400;
                                    color: {{ block.settings.ingredient_desc_color | default: '#888888' }};
                                    margin: 0;
                                    line-height: 1.5;
                                    word-wrap: break-word;
                                    overflow-wrap: break-word;
                                    hyphens: auto;
                                    white-space: normal;
                                  "
                                >
                                  {{ block.settings[ingredient_description] }}
                                </p>
                              {% endif %}
                            </div>
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </div>
                </div>

                <!-- Main Image Section -->
                <div class="sts-main-image-section" style="flex: 1; padding: 1rem;">
                  {% if block.settings.main_image != blank %}
                    <img
                      src="{{ block.settings.main_image | image_url: width: 600, height: 600 }}"
                      alt="{{ block.settings.main_image_alt | default: 'Product ingredients' }}"
                      width="600"
                      height="600"
                      style="width: 100%; height: auto; display: block;"
                    >
                  {% endif %}
                </div>
              </div>
            {% elsif block.type == 'faq-block' %}
              <!-- FAQ Block Content -->
              <div
                class="sts-faq-content {% if block.settings.layout == 'faq-image' %}reverse{% endif %}"
                style="
                  --faq-bg-color: {{ block.settings.faq_bg_color }};
                  --question-text-color: {{ block.settings.question_text_color }};
                  --answer-text-color: {{ block.settings.answer_text_color }};
                  --faq-border-color: {{ block.settings.border_color }};
                  --faq-max-height: {{ block.settings.faq_max_height }}px;
                "
              >
                <div class="sts-faq-image">
                  {% if block.settings.image %}
                    <img
                      src="{{ block.settings.image | image_url: width: 600, height: 600 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {% else %}
                    <div class="sts-placeholder-image">
                      <svg width="100" height="100" viewBox="0 0 100 100" fill="none">
                        <rect width="100" height="100" fill="#f0f0f0"/>
                        <path d="M30 70L50 50L70 70M40 40H40.01" stroke="#ccc" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </div>
                  {% endif %}
                </div>
                <div class="sts-faq-section">
                  <div
                    class="sts-faq-list-container"
                    style="
                      max-height: var(--faq-max-height, 550px);
                      overflow-y: auto;
                      overflow-x: hidden;
                      scrollbar-width: none;
                      -ms-overflow-style: none;
                    "
                  > 
                    <div
                      class="sts-faq-list"
                      data-block-id="{{ block.id }}"
                      style="padding-right: 30px;"
                    >
                      {% for i in (1..15) %}
                        {% assign faq_question = 'faq' | append: i | append: '_question' %}
                        {% assign faq_answer = 'faq' | append: i | append: '_answer' %}

                        {% if block.settings[faq_question] != blank %}
                          <div class="sts-faq-item">
                            <button class="sts-faq-question" onclick="stsToggleFAQ(this)">
                              <span class="sts-question-text">{{ block.settings[faq_question] }}</span>
                              <span class="sts-faq-icon">+</span>
                            </button>
                            <div class="sts-faq-answer">
                              <div class="sts-answer-content">
                                {{ block.settings[faq_answer] }}
                              </div>
                            </div>
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </div>
                </div>
              </div>
            {% else %}
              <!-- Image Text Block Content -->
              <div class="sts-image-text-content {% if block.settings.layout == 'text-image' %}reverse{% endif %}">
                <div class="sts-content-image">
                  {% if block.settings.image %}
                    <img
                      src="{{ block.settings.image | image_url: width: 600, height: 600 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {% else %}
                    <div class="sts-placeholder-image">
                      <svg width="100" height="100" viewBox="0 0 100 100" fill="none">
                        <rect width="100" height="100" fill="#f0f0f0"/>
                        <path d="M30 70L50 50L70 70M40 40H40.01" stroke="#ccc" stroke-width="2" stroke-linecap="round"/>
                      </svg>
                    </div>
                  {% endif %}
                </div>
                <div class="sts-content-text">
                  <div class="sts-text-content">
                    {{ block.settings.text_content }}
                  </div>
                </div>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  /* Main Dropdown Section */
  .sts-tab-section {
    width: 100%;
    max-width: 100%;
    border: var(--tab-border-width) solid var(--tab-border-color);
    background-color: var(--tab-bg-color);
    margin-top: 20px;
  }

  .sts-tab-button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: transparent;
    color: var(--tab-text-color);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: var(--tab-font-family);
    font-weight: var(--tab-font-weight);
    font-style: var(--tab-font-style);
    height: var(--tab-height-mobile); /* base fallback */
  }

  .sts-tab-button:hover {
    opacity: 0.8;
  }

  .sts-tab-button:focus {
    outline: none;
  }

  .sts-tab-title {
    margin: 0;
    padding-left: var(--tab-title-padding-mobile);
    font-size: var(--title-font-size-mobile); /* base fallback */
    font-family: var(--title-font-family);
    font-weight: var(--title-font-weight);
    font-style: var(--title-font-style);
    color: inherit;
    text-align: left;
  }

  .sts-tab-arrow {
    padding-right: var(--tab-arrow-padding-mobile);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
  }

  .sts-tab-arrow svg {
    width: var(--tab-arrow-size-mobile);
    height: var(--tab-arrow-size-mobile);
    stroke-width: var(--tab-arrow-stroke-mobile);
  }

  .sts-tab-button[aria-expanded='true'] .sts-tab-arrow {
    transform: rotate(180deg);
  }

  .sts-tab-content {
    background-color: transparent;
    border: none;
  }

  .sts-tab-content-inner {
    color: var(--tab-text-color);
  }

  /* Inner Tab System */
  .sts-inner-tab-navigation {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 20px 0 20px 0;
    gap: 8px;
    padding: 0 10px;
    border: none;
  }

  .sts-inner-tab-nav-button {
    flex: 1;
    max-width: 25%;
    min-height: 44px;
    padding: 8px 15px;
    border: var(--inner-tab-border-width) solid var(--inner-tab-border-color);
    border-radius: 8px;
    background-color: var(--inner-tab-inactive-bg);
    color: var(--inner-tab-inactive-text);
    font-family: var(--tab-font-family);
    font-weight: var(--tab-font-weight);
    font-style: var(--tab-font-style);
    font-size: var(--tab-font-size-desktop);
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    position: relative;
    text-align: center;
  }

  .sts-inner-tab-nav-button .sts-tab-content-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    max-width: 100%;
  }

  .sts-inner-tab-nav-button .sts-tab-text {
    word-wrap: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
    line-height: 1.2;
    white-space: normal;
  }

  .sts-inner-tab-nav-button:hover {
    background-color: var(--inner-tab-hover-bg);
    color: var(--inner-tab-hover-text);
  }

  .sts-inner-tab-nav-button.active {
    background-color: var(--inner-tab-active-bg);
    color: var(--inner-tab-active-text);
  }

  .sts-inner-tab-dot {
    display: none;
  }

  .sts-inner-tab-nav-button:focus {
    outline: none;
  }

  .sts-inner-tab-content-wrapper {
    position: relative;
    min-height: 400px;
    overflow: hidden;
  }

  .sts-inner-tab-content {
    display: none;
    padding: 0;
    background-color: var(--inner-tab-inactive-bg);
    border: none;
  }

  .sts-inner-tab-content.active {
    display: block;
  }

  .sts-image-text-content {
    display: flex;
    align-items: stretch;
    gap: 0;
    min-height: 400px;
    width: 100%;
  }

  .sts-image-text-content.reverse {
    flex-direction: row-reverse;
  }

  .sts-content-image,
  .sts-content-text {
    flex: 1;
    width: 50%;
    min-width: 0; /* Allows flex items to shrink below their content size */
  }

  .sts-content-image {
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    padding: 20px;
    margin: 0;
  }

  .sts-content-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    margin: 0;
    padding: 0;
  }

  .sts-placeholder-image {
    width: 100%;
    height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f8f8f8;
    border: 2px dashed #ddd;
    border-radius: 8px;
  }

  .sts-content-text {
    display: flex;
    padding: 30px;
    overflow: hidden; /* Prevents text from overflowing */
  }

  .sts-text-content {
    font-family: var(--content-font-family, var(--tab-font-family));
    font-weight: var(--content-font-weight, 400);
    font-style: var(--content-font-style, normal);
    font-size: var(--content-font-size-desktop, 16px);
    line-height: 1.6;
    color: var(--content-text-color, var(--inner-tab-inactive-text));
    width: 100%;
    word-wrap: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
  }

  /* Mobile Styles */
  @media (max-width: 767px) {
    .shopify-section:has(.sts-tab-section) {
      --page-margin: 0px;
    }

    .sts-tab-button {
      height: var(--tab-height-mobile);
    }

    .sts-tab-title {
      padding-left: var(--tab-title-padding-mobile);
      font-size: var(--title-font-size-mobile);
    }

    .sts-tab-arrow {
      padding-right: var(--tab-arrow-padding-mobile);
    }

    .sts-tab-arrow svg {
      width: var(--tab-arrow-size-mobile);
      height: var(--tab-arrow-size-mobile);
      stroke-width: var(--tab-arrow-stroke-mobile);
    }

    .sts-inner-tab-navigation {
      gap: 6px;
      padding: 0 5px;
    }

    .sts-inner-tab-nav-button {
      font-size: var(--tab-font-size-mobile);
      padding: 6px 10px;
      min-height: 40px;
      border-radius: 6px;
    }

    .sts-inner-tab-nav-button .sts-tab-content-wrapper {
      gap: 6px;
    }

    .sts-inner-tab-content {
      padding: 0;
    }

    .sts-content-text {
      padding: 20px;
    }

    .sts-image-text-content {
      flex-direction: column;
      gap: 0;
    }

    .sts-image-text-content.reverse {
      flex-direction: column;
    }

    .sts-content-image,
    .sts-content-text {
      width: 100%;
      flex: none;
    }

    .sts-content-image img {
      max-height: 260px;
      object-fit: cover;
    }

    .sts-text-content {
      font-size: var(--content-font-size-mobile, 14px);
    }

    .sts-inner-tab-content-wrapper {
      min-height: auto;
    }

    .sts-main-image-section,
    .sts-faq-image {
      display: none !important;
    }

    .sts-faq-content {
      flex-direction: column;
      min-height: auto;
    }

    .sts-faq-section {
      width: 100% !important;
      max-width: 100% !important;
      flex: none;
    }

    .sts-faq-list {
      padding: 15px 15px 20px 15px;
      background-color: transparent;
    }

    .sts-faq-question {
      font-size: 14px;
      padding: 18px 0;
    }

    .sts-answer-content {
      padding: 0 0 15px 0;
      font-size: 14px;
    }
