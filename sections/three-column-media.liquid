               alt="Video preview" width="600" height="450"
               style="width:100%;height:100%;object-fit:cover;display:block;">
        {% else %}
          <div style="width:100%;height:100%;background:linear-gradient(135deg,#f5f7fa,#c3cfe2);display:flex;align-items:center;justify-content:center;color:#999;font-size:14px;font-family:'Montserrat',sans-serif;">Add video URL</div>
        {% endif %}
      </div>

      {% comment %} Step circle — absolutely positioned at bottom-center of top-unit {% endcomment %}
      <div class="three-col-mob-step-wrap">
        <div class="three-col-mob-step-circle">
          {% if section.settings.step_text != blank %}
            <span class="three-col-mob-step-label">{{ section.settings.step_text }}</span>
          {% endif %}
          {% if section.settings.step_number != blank %}
            <span class="three-col-mob-step-num">{{ section.settings.step_number }}</span>
          {% endif %}
        </div>
      </div>
    </div>

    {% comment %} 3. Text + CTA {% endcomment %}
    <div class="three-col-mob-text-block">
      {% if section.settings.main_heading != blank %}
        <h2 class="three-col-mob-heading">{{ section.settings.main_heading }}</h2>
      {% endif %}
      {% if section.settings.main_description != blank %}
        <p class="three-col-mob-desc">{{ section.settings.main_description }}</p>
      {% endif %}
      {% if section.settings.cta_text != blank %}
        <a href="{{ section.settings.cta_link }}" class="three-col-mob-cta">{{ section.settings.cta_text }}</a>
      {% endif %}
    </div>

    {% comment %} 4. Product image {% endcomment %}
    {% if section.settings.product_image != blank %}
      <div class="three-col-mob-image-block">
        <img src="{{ section.settings.product_image | image_url: width: 600 }}"
             alt="{{ section.settings.main_heading | default: 'Product' }}"
             class="three-col-mob-product-img"
             width="600" height="600">
      </div>
    {% endif %}

  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const video = document.getElementById('three-column-video');
  
  if (video) {
    // Function to attempt video playback
    function attemptPlay() {
      const playPromise = video.play();
      
      if (playPromise !== undefined) {
        playPromise.then(() => {
          console.log('Video autoplay started successfully');
        }).catch(error => {
          console.log('Autoplay prevented:', error);
          // If autoplay fails, try again after user interaction
          document.addEventListener('click', function() {
            video.play().catch(e => console.log('Manual play failed:', e));
          }, { once: true });
        });
      }
    }

    // Try to play when video metadata is loaded
    video.addEventListener('loadedmetadata', attemptPlay);
    
    // Fallback: try to play after a short delay
    setTimeout(attemptPlay, 500);
    
    // Ensure video loops properly
    video.addEventListener('ended', function() {
      video.currentTime = 0;
      video.play();
    });
  }
});
</script>

