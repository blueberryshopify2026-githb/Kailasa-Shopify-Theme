{% comment %}
  UGC Content Section
  Features: Large center card, small side cards, seamless infinite loop (2-clone pattern)
{% endcomment %}

<style>
  .ucs {
    font-family: 'Montserrat', sans-serif;
    background: {{ section.settings.section_background | default: '#ffffff' }};
    padding: 20px 0 10px 0;
    overflow: hidden;
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .ucs__container {
    width: 100%;
    padding: 0;
  }

  /* Header */
  .ucs__header {
    text-align: center;
    padding: 0 20px;
  }

  .ucs__title {
    font-size: {{ section.settings.title_font_size | default: 42 }}px;
    font-weight: 700;
    color: {{ section.settings.title_color | default: '#000000' }};
    line-height: 1.2;
    margin: 0 0 10px 0;
    font-family: 'Montserrat', sans-serif;
  }

  .ucs__description {
    font-size: {{ section.settings.description_font_size | default: 16 }}px;
    color: {{ section.settings.description_color | default: '#666666' }};
    line-height: 1.6;
    margin: 0 auto;
    max-width: 600px;
    font-family: 'Montserrat', sans-serif;
  }

  /* Desktop Carousel — >1024px only */
  .ucs__carousel {
    position: relative;
    height: 550px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 100vw; /* Full viewport width */
    margin-left: calc(-50vw + 50%); /* Center full width in any container */
    padding: 0 50px;
  }

  .ucs__viewport {
    flex: 1;
    overflow: visible;
    position: relative;
    height: 550px;
  }

  .ucs__track {
    display: flex;
    align-items: center;
    gap: {{ section.settings.card_gap | default: 20 }}px;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translateX(0) translateY(-50%);
    opacity: 0;
    visibility: hidden;
    will-change: transform;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .ucs__track.initialized {
    opacity: 1;
    visibility: visible;
  }

  /* Card Base Styles */
  .ucs__card {
    flex-shrink: 0;
    cursor: pointer;
    border-radius: 25px;
    overflow: hidden;
    background: #f0f0f0;
    position: relative;
    transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* ALL SIDE CARDS - Same size, grayscale */
  .ucs__card:not(.ucs__card--center) {
    width: {{ section.settings.side_card_width | default: 220 }}px;
    height: {{ section.settings.side_card_height | default: 300 }}px;
    opacity: 0.7;
    filter: grayscale(100%);
    transform: scale(0.9);
  }

  .ucs__card:not(.ucs__card--center):hover {
    opacity: 0.85;
    transform: scale(0.95);
  }




  /* CENTER CARD - Optimized for above the fold */
  .ucs__card--center {
    width: 380px !important;
    height: 500px !important;
    opacity: 1 !important;
    filter: grayscale(0) !important;
    transform: scale(1) !important;
    z-index: 10 !important;
  }




  /* Card Content */
  .ucs__card-media {
    width: 100%;
    height: 100%;
    position: relative;
    border-radius: 25px;
    overflow: hidden;
  }




  .ucs__card-video,
  .ucs__card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }




  .ucs__card-video {
    pointer-events: none;
  }




  .ucs__card--center .ucs__card-video {
    pointer-events: auto;
  }




  /* Product Panel - Only visible on centered cards */
  .ucs__product-panel {
    position: absolute;
    bottom: 15px;
    left: 15px;
    right: 30px;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 20px;
    padding: 10px;
    display: flex;
    align-items: center;
    gap: 15px;
    opacity: 0;
    transform: translateY(30px) scale(0.9);
    transition: all 0.5s ease;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    pointer-events: none;
  }


  /* Only show product panel on center cards that are also centered */
  .ucs__card--center.centered .ucs__product-panel {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }


  /* Hide product panel on side cards */
  .ucs__card:not(.ucs__card--center) .ucs__product-panel {
    opacity: 0;
    transform: translateY(30px) scale(0.9);
    pointer-events: none;
  }




  .ucs__product-image {
    width: 60px;
    height: 60px;
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.1);
  }




  .ucs__product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }




  .ucs__product-info {
    flex: 1;
    min-width: 0;
  }




  .ucs__product-title {
    font-size: 16px;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 6px 0;
    line-height: 1.3;
    font-family: 'Montserrat', sans-serif;
  }




  .ucs__product-price {
    font-size: 18px;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    font-family: 'Montserrat', sans-serif;
  }




  .ucs__buy-button {
    background: transparent;
    color: #ffffff;
    border: 2px solid #4fffff;
    border-radius: 10px;
    padding: 12px 18px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: 'Montserrat', sans-serif;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    text-transform: uppercase;
  }




  .ucs__buy-button:hover {
    background: #4fffff;
    color: #000000;
    transform: translateY(-1px);
  }




  /* Placeholder */
  .ucs__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 10px;
    color: #999;
    text-align: center;
    padding: 40px 20px;
    height: 100%;
  }




  /* Responsive */
  @media (max-width: 1024px) {
    .ucs__carousel {
      height: 550px;
      padding: 0 30px;
    }

    .ucs__card:not(.ucs__card--center) {
      width: 160px;
      height: 220px;
    }




    .ucs__card--center {
      width: 320px !important;
      height: 450px !important;
    }




    .ucs__track {
      gap: 20px;
    }




    .ucs__product-panel {
      bottom: 20px;
      left: 20px;
      right: 20px;
      padding: 15px;
      gap: 12px;
    }




    .ucs__product-image {
      width: 50px;
      height: 50px;
    }




    .ucs__product-title {
      font-size: 14px;
    }




    .ucs__product-price {
      font-size: 16px;
    }




    .ucs__buy-button {
      padding: 10px 14px;
      font-size: 12px;
    }
  }




  @media (max-width: 768px) {
    .ucs__carousel {
      height: 450px;
      padding: 0 20px;
    }

    .ucs__card:not(.ucs__card--center) {
      width: 120px;
      height: 160px;
    }




    .ucs__card--center {
      width: 240px !important;
      height: 320px !important;
    }




    .ucs__track {
      gap: 15px;
    }




    .ucs__product-panel {
      bottom: 15px;
      left: 15px;
      right: 15px;
      padding: 12px;
      gap: 10px;
    }




    .ucs__product-image {
      width: 40px;
      height: 40px;
    }




    .ucs__product-title {
      font-size: 12px;
    }




    .ucs__product-price {
      font-size: 14px;
    }




    .ucs__buy-button {
      padding: 8px 12px;
      font-size: 10px;
    }
  }




  @media (max-width: 480px) {
    .ucs__carousel {
      height: 400px;
      padding: 0 15px;
      display: none !important; /* hide desktop carousel — mobile uses ucs__mob-carousel */
    }

    .ucs__card:not(.ucs__card--center) {
      width: 80px;
      height: 120px;
    }




    .ucs__card--center {
      width: 180px !important;
      height: 240px !important;
    }




    .ucs__track {
      gap: 10px;
    }




    .ucs__product-panel {
      bottom: 10px;
      left: 10px;
      right: 10px;
      padding: 10px;
      gap: 8px;
    }




    .ucs__product-image {
      width: 35px;
      height: 35px;
    }




    .ucs__product-title {
      font-size: 11px;
    }




    .ucs__product-price {
      font-size: 12px;
    }




    .ucs__buy-button {
      padding: 6px 10px;
      font-size: 9px;
    }
  }

  /* ── MOBILE ONLY ≤480px — center card large, side cards peek, dots nav ──────
     Existing desktop/tablet code above is NOT modified.
     All rules use !important to isolate from desktop styles.
  ────────────────────────────────────────────────────────────────────────────── */
  @media (max-width: 480px) {

    /* Hide the desktop carousel entirely — already done in existing 480px block above */

    /* Section: remove min-height, overflow so carousel isn't clipped */
    .ucs {
      min-height: unset !important;
      padding-bottom: 0 !important;
      overflow: visible !important;
    }

    /* Hide desktop carousel container so browser skips rendering it */
    .ucs__carousel {
      display: none !important;
      visibility: hidden !important;
    }

    /* Show mobile carousel — full width, no margin tricks needed */
    .ucs__mob-carousel {
      display: block !important;
      width: 100% !important;
      overflow: hidden !important;
      position: relative !important;
      padding-top: {{ section.settings.mob_carousel_padding_top | default: 8 }}px !important;
    }

    .ucs__mob-track-wrapper {
      overflow: hidden !important;
      width: 100% !important;
      position: relative !important;
      height: {{ section.settings.mob_center_card_height | default: 85 }}vw !important;
    }

    .ucs__mob-track {
      display: flex !important;
      align-items: center !important;
      gap: {{ section.settings.mob_card_gap | default: 12 }}px !important;
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      will-change: transform !important;
    }

    /* Side cards — bigger peek, grayscale */
    .ucs__mob-card {
      flex: 0 0 {{ section.settings.mob_side_card_width | default: 28 }}vw !important;
      width: {{ section.settings.mob_side_card_width | default: 28 }}vw !important;
      height: {{ section.settings.mob_side_card_height | default: 42 }}vw !important;
      border-radius: {{ section.settings.mob_card_radius | default: 18 }}px !important;
      overflow: hidden !important;
      position: relative !important;
      filter: grayscale(100%) !important;
      opacity: 0.65 !important;
      transition: filter 0.35s ease, opacity 0.35s ease !important;
      background: #e0e0e0 !important;
      cursor: pointer !important;
      flex-shrink: 0 !important;
    }

    .ucs__mob-card img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: top center !important;
      display: block !important;
    }

    /* Video fills card same as image */
    .ucs__mob-card .ucs__card-video,
    .ucs__mob-card .ucs__card-image {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      display: block !important;
      border: none !important;
    }

    /* Active center card — full color, larger */
    .ucs__mob-card.ucs__mob-card--active {
      flex: 0 0 {{ section.settings.mob_center_card_width | default: 68 }}vw !important;
      width: {{ section.settings.mob_center_card_width | default: 68 }}vw !important;
      height: {{ section.settings.mob_center_card_height | default: 85 }}vw !important;
      filter: grayscale(0) !important;
      opacity: 1 !important;
      z-index: 5 !important;
    }

    /* Product panel — larger image, smaller button, text wraps */
    .ucs__mob-card.ucs__mob-card--active .ucs__product-panel {
      opacity: 1 !important;
      transform: translateY(0) scale(1) !important;
      pointer-events: auto !important;
      bottom: 12px !important;
      left: 10px !important;
      right: 10px !important;
      padding: 10px 8px !important;
      gap: 8px !important;
      align-items: center !important;
      flex-wrap: nowrap !important;
    }

    .ucs__mob-card:not(.ucs__mob-card--active) .ucs__product-panel {
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
      transform: translateY(30px) scale(0.9) !important;
      transition: none !important;
    }

    /* Larger product image — fixed size, doesn't grow */
    .ucs__mob-card .ucs__product-image {
      flex: 0 0 56px !important;
      width: 56px !important;
      height: 56px !important;
      flex-shrink: 0 !important;
      border-radius: 10px !important;
    }

    /* Product info — takes all available middle space */
    .ucs__mob-card .ucs__product-info {
      flex: 1 1 0 !important;
      min-width: 0 !important;
    }

    .ucs__mob-card .ucs__product-title {
      font-size: {{ section.settings.mob_product_title_size | default: 13 }}px !important;
      white-space: normal !important;
      line-height: 1.3 !important;
      word-break: break-word !important;
    }

    .ucs__mob-card .ucs__product-price {
      font-size: {{ section.settings.mob_product_price_size | default: 15 }}px !important;
      margin-top: 3px !important;
    }

    /* Button — fixed width just enough for "BUY NOW" text */
    .ucs__mob-card .ucs__buy-button {
      flex: 0 0 auto !important;
      min-width: 72px !important;
      font-size: {{ section.settings.mob_buy_button_size | default: 11 }}px !important;
      padding: 10px 10px !important;
      white-space: nowrap !important;
      flex-shrink: 0 !important;
      border-radius: 8px !important;
      text-align: center !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    /* Dots pagination */
    .ucs__mob-dots {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 8px !important;
      padding: 16px 0 8px !important;
    }

    .ucs__mob-dot {
      width: 8px !important;
      height: 8px !important;
      border-radius: 50% !important;
      background: #cccccc !important;
      cursor: pointer !important;
      transition: background 0.3s ease, transform 0.3s ease !important;
      flex-shrink: 0 !important;
    }

    .ucs__mob-dot.ucs__mob-dot--active {
      background: {{ section.settings.mob_dot_active_color | default: '#333333' }} !important;
      transform: scale(1.3) !important;
    }

    /* Header sizing on mobile */
    .ucs__title {
      font-size: {{ section.settings.mob_title_font_size | default: 28 }}px !important;
    }

    .ucs__description {
      font-size: {{ section.settings.mob_description_font_size | default: 14 }}px !important;
    }
  }

  @media (min-width: 481px) {
    .ucs__mob-carousel {
      display: none !important;
    }
  }

  /* ── TABLET ONLY: 481px – 1024px ──────────────────────────────────────────
     Same layout as mobile: center card wider, 1 full + half side cards each side.
     Desktop (>1024px) and mobile (≤480px) NOT touched.
  ────────────────────────────────────────────────────────────────────────────── */
  @media (min-width: 481px) and (max-width: 1024px) {

    /* Hide desktop carousel on tablet */
    .ucs__carousel { display: none !important; visibility: hidden !important; }

    /* Section */
    .ucs {
      min-height: unset !important;
      overflow: visible !important;
      padding-bottom: 0 !important;
    }

    /* Header */
    .ucs__title {
      font-size: {{ section.settings.tab_title_font_size | default: 36 }}px !important;
    }
    .ucs__description {
      font-size: {{ section.settings.tab_description_font_size | default: 16 }}px !important;
    }

    /* Tablet carousel wrapper */
    .ucs__tab-carousel {
      display: block !important;
      width: 100% !important;
      overflow: hidden !important;
      position: relative !important;
      padding-top: {{ section.settings.tab_carousel_padding_top | default: 16 }}px !important;
    }

    .ucs__tab-track-wrapper {
      overflow: hidden !important;
      width: 100% !important;
      position: relative !important;
      height: {{ section.settings.tab_center_card_height | default: 52 }}vw !important;
    }

    .ucs__tab-track {
      display: flex !important;
      align-items: center !important;
      gap: {{ section.settings.tab_card_gap | default: 16 }}px !important;
      position: absolute !important;
      left: 50% !important;
      top: 50% !important;
      will-change: transform !important;
    }

    /* Side cards */
    .ucs__tab-card {
      flex: 0 0 {{ section.settings.tab_side_card_width | default: 22 }}vw !important;
      width: {{ section.settings.tab_side_card_width | default: 22 }}vw !important;
      height: {{ section.settings.tab_side_card_height | default: 46 }}vw !important;
      border-radius: {{ section.settings.tab_card_radius | default: 20 }}px !important;
      overflow: hidden !important;
      position: relative !important;
      filter: grayscale(100%) !important;
      opacity: 0.65 !important;
      transition: filter 0.35s ease, opacity 0.35s ease !important;
      background: #e0e0e0 !important;
      cursor: pointer !important;
      flex-shrink: 0 !important;
    }

    .ucs__tab-card img,
    .ucs__tab-card .ucs__card-video,
    .ucs__tab-card .ucs__card-image {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      display: block !important;
      border: none !important;
    }

    /* Active center card */
    .ucs__tab-card.ucs__tab-card--active {
      flex: 0 0 {{ section.settings.tab_center_card_width | default: 42 }}vw !important;
      width: {{ section.settings.tab_center_card_width | default: 42 }}vw !important;
      height: {{ section.settings.tab_center_card_height | default: 52 }}vw !important;
      filter: grayscale(0) !important;
      opacity: 1 !important;
      z-index: 5 !important;
      border-radius: {{ section.settings.tab_card_radius | default: 20 }}px !important;
    }

    /* Product panel — hidden on non-active */
    .ucs__tab-card:not(.ucs__tab-card--active) .ucs__product-panel {
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
      transform: translateY(30px) scale(0.9) !important;
      transition: none !important;
    }

    .ucs__tab-card .ucs__product-title {
      font-size: {{ section.settings.tab_product_title_size | default: 15 }}px !important;
      white-space: normal !important;
      line-height: 1.3 !important;
    }
    .ucs__tab-card .ucs__product-price {
      font-size: {{ section.settings.tab_product_price_size | default: 17 }}px !important;
    }
    .ucs__tab-card .ucs__product-image {
      width: {{ section.settings.tab_product_image_size | default: 70 }}px !important;
      height: {{ section.settings.tab_product_image_size | default: 70 }}px !important;
      flex-shrink: 0 !important;
    }
    .ucs__tab-card .ucs__buy-button {
      font-size: {{ section.settings.tab_buy_button_size | default: 12 }}px !important;
      padding: 10px 14px !important;
      white-space: nowrap !important;
      flex-shrink: 0 !important;
    }

    /* Dots pagination */
    .ucs__tab-dots {
      display: flex !important;
      justify-content: center !important;
      align-items: center !important;
      gap: 8px !important;
      padding: 16px 0 8px !important;
    }

    .ucs__tab-dot {
      width: 8px !important;
      height: 8px !important;
      border-radius: 50% !important;
      background: #cccccc !important;
      cursor: pointer !important;
      transition: background 0.3s ease, transform 0.3s ease !important;
      flex-shrink: 0 !important;
    }

    .ucs__tab-dot.ucs__tab-dot--active {
      background: {{ section.settings.tab_dot_active_color | default: '#333333' }} !important;
      transform: scale(1.3) !important;
    }
  }

  /* Hide tablet carousel outside tablet range */
  .ucs__tab-carousel { display: none; }
  @media (min-width: 481px) and (max-width: 1024px) {
    .ucs__tab-carousel { display: block; }
  }
</style>

<section class="ucs full-width" id="ucs-{{ section.id }}">
  <div class="ucs__container">
    <!-- Header -->
    {% if section.settings.section_title != blank or section.settings.section_description != blank %}
      <div class="ucs__header">
        {% if section.settings.section_title != blank %}
          <h2 class="ucs__title">{{ section.settings.section_title }}</h2>
        {% endif %}
        {% if section.settings.section_description != blank %}
          <p class="ucs__description">{{ section.settings.section_description }}</p>
        {% endif %}
      </div>
    {% endif %}

    <!-- Carousel -->
    <div class="ucs__carousel">
      <div class="ucs__viewport">
        <div class="ucs__track" id="ucs-track-{{ section.id }}">
          {% if section.blocks.size == 0 %}
            <div class="ucs__placeholder">
              <div style="font-size: 18px; font-weight: 600;">No content added yet</div>
              <div style="font-size: 14px;">Add UGC content blocks to get started</div>
            </div>
          {% else %}
            <!-- Real cards only — JS prepends clone-last and appends clone-first for seamless loop -->
            {% for block in section.blocks %}
              <div
                class="ucs__card original-card"
                data-index="{{ forloop.index0 }}"
                data-video-url="{{ block.settings.video_url }}"
                data-image-url="{% if block.settings.fallback_image %}{{ block.settings.fallback_image | image_url: width: 350 }}{% endif %}"
                data-product-image="{% if block.settings.product_image %}{{ block.settings.product_image | image_url: width: 100 }}{% endif %}"
                data-product-title="{{ block.settings.product_title }}"
                data-product-price="{{ block.settings.product_price }}"
                data-product-url="{{ block.settings.product_url }}"
                data-redirect-url="{{ block.settings.redirect_url }}"
              >
                <div class="ucs__card-media">
                  <!-- Content injected by initializeUCS JS -->
                </div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% comment %}── MOBILE CAROUSEL (≤480px) — data-only cards, JS injects media ──{% endcomment %}
  <div class="ucs__mob-carousel" id="ucs-mob-{{ section.id }}">
    <div class="ucs__mob-track-wrapper">
      <div class="ucs__mob-track" id="ucs-mob-track-{{ section.id }}">
        {% for block in section.blocks %}
          {% comment %}Compute video embed URL server-side, store in data attribute{% endcomment %}
          {% assign mob_media_type = 'image' %}
          {% assign mob_media_src = '' %}
          {% if block.settings.video_url %}
            {% assign mob_vid = block.settings.video_url %}
            {% if mob_vid contains 'instagram.com' %}
              {% assign mob_pid = mob_vid | split: '/reel/' | last | split: '/' | first %}
              {% if mob_pid == blank -%}
                {%- assign mob_pid = mob_vid | split: '/p/' | last | split: '/' | first -%}
              {%- endif %}
              {% assign mob_media_type = 'iframe' %}
              {% assign mob_media_src = 'https://www.instagram.com/p/' | append: mob_pid | append: '/embed/' %}
            {% elsif mob_vid contains 'tiktok.com' %}
              {% assign mob_media_type = 'iframe' %}
              {% assign mob_media_src = mob_vid | replace: '/video/', '/embed/v2/' %}
            {% elsif mob_vid contains 'youtube.com' or mob_vid contains 'youtu.be' %}
              {% assign mob_ytid = '' %}
              {% if mob_vid contains 'youtu.be/' -%}
                {%- assign mob_ytid = mob_vid | split: 'youtu.be/' | last | split: '?' | first %}
              {% elsif mob_vid contains 'youtube.com/watch' -%}
                {%- assign mob_ytid = mob_vid | split: 'v=' | last | split: '&' | first %}
              {% elsif mob_vid contains 'youtube.com/shorts/' -%}
                {%- assign mob_ytid = mob_vid | split: '/shorts/' | last | split: '?' | first %}
              {% endif %}
              {% if mob_ytid != blank %}
                {% assign mob_media_type = 'iframe' %}
                {% assign mob_media_src = 'https://www.youtube.com/embed/'
                  | append: mob_ytid
                  | append: '?autoplay=1&mute=1&loop=1&playlist='
                  | append: mob_ytid
                  | append: '&controls=0'
                %}
              {% endif %}
            {% else %}
              {% assign mob_media_type = 'video' %}
              {% assign mob_media_src = mob_vid %}
            {% endif %}
          {% elsif block.settings.fallback_image %}
            {% assign mob_media_type = 'image' %}
            {% assign mob_media_src = block.settings.fallback_image | image_url: width: 600 %}
          {% endif %}

          <div
            class="ucs__mob-card"
            data-mob-index="{{ forloop.index0 }}"
            data-media-type="{{ mob_media_type }}"
            data-media-src="{{ mob_media_src }}"
            data-redirect-url="{{ block.settings.redirect_url }}"
            data-product-title="{{ block.settings.product_title | escape }}"
            data-product-price="{{ block.settings.product_price | escape }}"
            data-product-url="{{ block.settings.product_url }}"
            data-product-img="{% if block.settings.product_image %}{{ block.settings.product_image | image_url: width: 100 }}{% endif %}"
          >
            {% comment %}No media HTML here — JS injects only for visible cards{% endcomment %}
          </div>
        {% endfor %}
      </div>
    </div>
    {% if section.blocks.size > 1 %}
      <div class="ucs__mob-dots" id="ucs-mob-dots-{{ section.id }}">
        {% for block in section.blocks %}
          <div
            class="ucs__mob-dot {% if forloop.first %}ucs__mob-dot--active{% endif %}"
            data-dot-index="{{ forloop.index0 }}"
          ></div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {% comment %}── TABLET CAROUSEL (481px–1024px) — same lazy pattern as mobile ──{% endcomment %}
  <div class="ucs__tab-carousel" id="ucs-tab-{{ section.id }}">
    <div class="ucs__tab-track-wrapper">
      <div class="ucs__tab-track" id="ucs-tab-track-{{ section.id }}">
        {% for block in section.blocks %}
          {% assign tab_media_type = 'image' %}
          {% assign tab_media_src = '' %}
          {% if block.settings.video_url %}
            {% assign tab_vid = block.settings.video_url %}
            {% if tab_vid contains 'instagram.com' %}
              {% assign tab_pid = tab_vid | split: '/reel/' | last | split: '/' | first %}
              {% if tab_pid == blank -%}
                {%- assign tab_pid = tab_vid | split: '/p/' | last | split: '/' | first -%}
              {%- endif %}
              {% assign tab_media_type = 'iframe' %}
              {% assign tab_media_src = 'https://www.instagram.com/p/' | append: tab_pid | append: '/embed/' %}
            {% elsif tab_vid contains 'tiktok.com' %}
              {% assign tab_media_type = 'iframe' %}
              {% assign tab_media_src = tab_vid | replace: '/video/', '/embed/v2/' %}
            {% elsif tab_vid contains 'youtube.com' or tab_vid contains 'youtu.be' %}
              {% assign tab_ytid = '' %}
              {% if tab_vid contains 'youtu.be/' -%}
                {%- assign tab_ytid = tab_vid | split: 'youtu.be/' | last | split: '?' | first %}
              {% elsif tab_vid contains 'youtube.com/watch' -%}
                {%- assign tab_ytid = tab_vid | split: 'v=' | last | split: '&' | first %}
              {% elsif tab_vid contains 'youtube.com/shorts/' -%}
                {%- assign tab_ytid = tab_vid | split: '/shorts/' | last | split: '?' | first %}
              {% endif %}
              {% if tab_ytid != blank %}
                {% assign tab_media_type = 'iframe' %}
                {% assign tab_media_src = 'https://www.youtube.com/embed/'
                  | append: tab_ytid
                  | append: '?autoplay=1&mute=1&loop=1&playlist='
                  | append: tab_ytid
                  | append: '&controls=0'
                %}
              {% endif %}
            {% else %}
              {% assign tab_media_type = 'video' %}
              {% assign tab_media_src = tab_vid %}
            {% endif %}
          {% elsif block.settings.fallback_image %}
            {% assign tab_media_src = block.settings.fallback_image | image_url: width: 800 %}
          {% endif %}
          <div
            class="ucs__tab-card"
            data-tab-index="{{ forloop.index0 }}"
            data-media-type="{{ tab_media_type }}"
            data-media-src="{{ tab_media_src }}"
            data-redirect-url="{{ block.settings.redirect_url }}"
            data-product-title="{{ block.settings.product_title | escape }}"
            data-product-price="{{ block.settings.product_price | escape }}"
            data-product-url="{{ block.settings.product_url }}"
            data-product-img="{% if block.settings.product_image %}{{ block.settings.product_image | image_url: width: 100 }}{% endif %}"
          ></div>
        {% endfor %}
      </div>
    </div>
    {% if section.blocks.size > 1 %}
      <div class="ucs__tab-dots" id="ucs-tab-dots-{{ section.id }}">
        {% for block in section.blocks %}
          <div
            class="ucs__tab-dot {% if forloop.first %}ucs__tab-dot--active{% endif %}"
            data-dot-index="{{ forloop.index0 }}"
          ></div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<script>
  // ── DESKTOP CAROUSEL JS (>1024px) — identical structure to mobile/tablet ───
  (function() {
    var SIDE_PX = {{ section.settings.side_card_width | default: 220 }};
    var CTR_PX  = 380;
    var GAP_PX  = {{ section.settings.card_gap | default: 20 }};

    window.initializeUCS = function(sectionId) {
      var track = document.getElementById('ucs-track-' + sectionId);
      if (!track) return;

      var origCards = Array.from(track.querySelectorAll('.ucs__card.original-card'));
      var N = origCards.length;
      if (N === 0) return;

      // ── 2 clones each side — identical to mobile/tablet ──────────────────
      var PREPEND = 2, APPEND = 2;

      for (var p = PREPEND; p >= 1; p--) {
        var cl = origCards[(N - p + N) % N].cloneNode(true);
        cl.classList.add('ucs__card--clone');
        track.insertBefore(cl, track.firstChild);
      }
      for (var a = 0; a < APPEND; a++) {
        var cl = origCards[a % N].cloneNode(true);
        cl.classList.add('ucs__card--clone');
        track.appendChild(cl);
      }

      var cards     = Array.from(track.querySelectorAll('.ucs__card'));
      var current   = PREPEND;
      var animating = false;

      // Inject media into all N+4 cards
      cards.forEach(function(card) {
        var videoUrl     = card.getAttribute('data-video-url')     || '';
        var imageUrl     = card.getAttribute('data-image-url')     || '';
        var productImage = card.getAttribute('data-product-image') || '';
        var productTitle = card.getAttribute('data-product-title') || '';
        var productPrice = card.getAttribute('data-product-price') || '';
        var productUrl   = card.getAttribute('data-product-url')   || '';
        card.innerHTML = buildCardHTML(videoUrl, imageUrl, productImage, productTitle, productPrice, productUrl);
      });

      // ── centerDesk: same formula as mobile/tablet ─────────────────────────
      // Track is position:absolute left:50% → origin = viewport center
      // translateX = -(index × (sideW+gap) + ctrW/2)
      function centerDesk(idx, anim) {
        var tx = -(idx * (SIDE_PX + GAP_PX) + CTR_PX / 2);
        track.style.transition = anim
          ? 'transform 0.4s cubic-bezier(0.25,0.46,0.45,0.94)'
          : 'none';
        track.style.transform = 'translateX(' + tx + 'px) translateY(-50%)';
        if (!anim) {
          requestAnimationFrame(function() {
            track.style.transition = 'transform 0.4s cubic-bezier(0.25,0.46,0.45,0.94)';
          });
        }
      }

      function applyCenterClass(idx) {
        cards.forEach(function(c, i) {
          var on = i === idx;
          c.classList.toggle('ucs__card--center', on);
          c.classList.remove('centered');
          var v = c.querySelector('video');
          if (v) { if (on) v.play().catch(function(){}); else v.pause(); }
        });
      }

      function showPanel(idx) {
        var card = cards[idx];
        if (!card) return;
        card.classList.add('centered');
        var v = card.querySelector('video');
        if (v) v.play().catch(function(){});
      }

      // ── go: pre-jump pattern — identical to mobile/tablet ────────────────
      function go(dir) {
        if (animating) return;
        animating = true;

        // Pre-jump: silently move track to clone position (no class change = no blink)
        if (dir === 1 && current === PREPEND + N - 1) {
          var jumpTo = current - N;
          var jumpTx = -(jumpTo * (SIDE_PX + GAP_PX) + CTR_PX / 2);
          track.style.transition = 'none';
          track.style.transform  = 'translateX(' + jumpTx + 'px) translateY(-50%)';
          track.getBoundingClientRect();
          current = jumpTo;
        } else if (dir === -1 && current === PREPEND) {
          var jumpTo = current + N;
          var jumpTx = -(jumpTo * (SIDE_PX + GAP_PX) + CTR_PX / 2);
          track.style.transition = 'none';
          track.style.transform  = 'translateX(' + jumpTx + 'px) translateY(-50%)';
          track.getBoundingClientRect();
          current = jumpTo;
        }

        // Advance and animate
        current += dir;
        applyCenterClass(current);
        track.style.transition = 'transform 0.4s cubic-bezier(0.25,0.46,0.45,0.94)';
        centerDesk(current, true);

        setTimeout(function() { showPanel(current); animating = false; }, 420);
      }

      // Click
      track.addEventListener('click', function(e) {
        var card = e.target.closest('.ucs__card');
        if (!card) return;
        var idx = cards.indexOf(card);
        if (idx === -1 || animating) return;
        if (idx === current) {
          var url = card.getAttribute('data-redirect-url');
          if (url) window.open(url, '_blank');
        } else go(idx > current ? 1 : -1);
      });

      // Init — identical to mobile/tablet
      applyCenterClass(current);
      centerDesk(current, false);
      setTimeout(function() {
        track.classList.add('initialized');
        showPanel(current);
      }, 100);
    };

    // ── Media helpers ─────────────────────────────────────────────────────────
    function buildCardHTML(videoUrl, imageUrl, productImage, productTitle, productPrice, productUrl) {
      var media = '';
      if (videoUrl) {
        var vs = getVideoSource(videoUrl);
        if (vs && vs.type === 'direct') {
          media = '<video class="ucs__card-video" muted loop playsinline preload="metadata"><source src="' + vs.src + '" type="video/mp4"></video>';
        } else if (vs) {
          media = '<iframe class="ucs__card-video" src="' + vs.embed.replace('autoplay=1','autoplay=0') + '" frameborder="0" allowfullscreen></iframe>';
        }
      } else if (imageUrl) {
        media = '<img class="ucs__card-image" src="' + imageUrl + '" alt="UGC Content" loading="lazy">';
      } else {
        media = '<div class="ucs__placeholder"><div>No Media</div></div>';
      }
      var panel = '';
      if (productTitle || productPrice || productImage) {
        panel = '<div class="ucs__product-panel">'
          + (productImage ? '<div class="ucs__product-image"><img src="' + productImage + '" alt="' + (productTitle||'') + '" width="100" height="100"></div>' : '')
          + '<div class="ucs__product-info">'
          + (productTitle ? '<div class="ucs__product-title">' + productTitle + '</div>' : '')
          + (productPrice ? '<div class="ucs__product-price">' + productPrice + '</div>' : '')
          + '</div>'
          + (productUrl ? '<a href="' + productUrl + '" class="ucs__buy-button" target="_blank">BUY NOW</a>' : '')
          + '</div>';
      }
      return '<div class="ucs__card-media">' + media + panel + '</div>';
    }

    function getVideoSource(url) {
      if (!url) return null;
      if (url.match(/\.(mp4|webm|ogg|mov)(\?.*)?$/i)) return { type: 'direct', src: url };
      if (url.includes('instagram.com')) {
        var m = url.match(/\/(?:reel|p)\/([A-Za-z0-9_-]+)/);
        if (m) return { type: 'instagram', embed: 'https://www.instagram.com/p/' + m[1] + '/embed/' };
      }
      if (url.includes('tiktok.com')) return { type: 'tiktok', embed: url.replace('/video/', '/embed/v2/') };
      if (url.includes('youtube.com') || url.includes('youtu.be')) {
        var vid = null;
        if (url.includes('youtu.be/')) vid = url.split('youtu.be/')[1].split('?')[0];
        else if (url.includes('youtube.com/watch')) vid = (url.split('v=')[1]||'').split('&')[0];
        else if (url.includes('youtube.com/shorts/')) vid = url.split('/shorts/')[1].split('?')[0];
        if (vid) return { type: 'youtube', embed: 'https://www.youtube.com/embed/' + vid + '?autoplay=1&mute=1&loop=1&playlist=' + vid + '&controls=0' };
      }
      return { type: 'direct', src: url };
    }
  })();

  // Initialize all carousels on DOMContentLoaded
  document.addEventListener('DOMContentLoaded', function() {
    if (window.innerWidth > 1024) {
      setTimeout(function() { initializeUCS('{{ section.id }}'); }, 100);
    }
    initUCSMobCarousel('{{ section.id }}');
    initUCSTabCarousel('{{ section.id }}');
  });
</script>

<script>
  // ── MOBILE CAROUSEL JS (≤480px) — mirrors desktop pattern exactly ──────────
  (function() {
    var SIDE_VW = {{ section.settings.mob_side_card_width | default: 28 }} / 100;
    var CTR_VW  = {{ section.settings.mob_center_card_width | default: 68 }} / 100;
    var GAP_PX  = {{ section.settings.mob_card_gap | default: 12 }};

    window.initUCSMobCarousel = function(sid) {
      if (window.innerWidth > 480) return;

      var track    = document.getElementById('ucs-mob-track-' + sid);
      var dotsWrap = document.getElementById('ucs-mob-dots-' + sid);
      if (!track) return;

      var orig = Array.from(track.querySelectorAll('.ucs__mob-card'));
      var N = orig.length;
      if (N === 0) return;

      // ── 2 clones each side — same as desktop ─────────────────────────────
      var PREPEND = 2, APPEND = 2;

      var dataArr = orig.map(function(c) {
        return {
          mediaType:    c.getAttribute('data-media-type')    || 'image',
          mediaSrc:     c.getAttribute('data-media-src')     || '',
          redirectUrl:  c.getAttribute('data-redirect-url')  || '',
          productTitle: c.getAttribute('data-product-title') || '',
          productPrice: c.getAttribute('data-product-price') || '',
          productUrl:   c.getAttribute('data-product-url')   || '',
          productImg:   c.getAttribute('data-product-img')   || ''
        };
      });

      function buildPanel(d) {
        if (!d.productTitle && !d.productPrice) return '';
        return '<div class="ucs__product-panel" style="transition:none;opacity:0;visibility:hidden;transform:translateY(30px) scale(0.9);pointer-events:none;">'
          + (d.productImg ? '<div class="ucs__product-image"><img src="' + d.productImg + '" alt="' + d.productTitle + '" width="100" height="100" loading="lazy"></div>' : '')
          + '<div class="ucs__product-info">'
          + (d.productTitle ? '<div class="ucs__product-title">' + d.productTitle + '</div>' : '')
          + (d.productPrice ? '<div class="ucs__product-price">' + d.productPrice + '</div>' : '')
          + '</div>'
          + (d.productUrl ? '<a href="' + d.productUrl + '" class="ucs__buy-button" target="_blank">BUY NOW</a>' : '')
          + '</div>';
      }

      function makeCard(realIdx) {
        var d  = dataArr[((realIdx % N) + N) % N];
        var el = document.createElement('div');
        el.className = 'ucs__mob-card';
        el.setAttribute('data-media-type',    d.mediaType);
        el.setAttribute('data-media-src',     d.mediaSrc);
        el.setAttribute('data-redirect-url',  d.redirectUrl);
        el.setAttribute('data-product-title', d.productTitle);
        el.setAttribute('data-product-price', d.productPrice);
        el.setAttribute('data-product-url',   d.productUrl);
        el.setAttribute('data-product-img',   d.productImg);
        return el;
      }

      // Inject media into a card (called lazily only for visible cards)
      function loadMedia(el) {
        if (el.getAttribute('data-media-loaded')) return;
        el.setAttribute('data-media-loaded', '1');
        var type  = el.getAttribute('data-media-type') || 'image';
        var src   = el.getAttribute('data-media-src')  || '';
        var title = el.getAttribute('data-product-title') || 'UGC';
        var isActive = el.classList.contains('ucs__mob-card--active');
        var media = '';
        if (src) {
          if (type === 'image') {
            media = '<img class="ucs__card-image" src="' + src + '" alt="' + title + '" loading="' + (isActive ? 'eager' : 'lazy') + '">';
          } else if (type === 'video') {
            media = '<video class="ucs__card-video" muted loop playsinline preload="' + (isActive ? 'auto' : 'metadata') + '"' + (isActive ? ' autoplay' : '') + '><source src="' + src + '" type="video/mp4"></video>';
          } else if (type === 'iframe') {
            media = '<iframe class="ucs__card-video" src="' + src + '" frameborder="0" allowfullscreen loading="lazy"></iframe>';
          }
        }
        // Find real data index from track position
        var pos = Array.from(track.querySelectorAll('.ucs__mob-card')).indexOf(el);
        var ri  = ((pos - PREPEND) % N + N) % N;
        el.innerHTML = media + buildPanel(dataArr[ri] || {});
        if (isActive) {
          setTimeout(function() {
            var v = el.querySelector('video');
            if (v) { v.muted = true; v.play().catch(function() { v.setAttribute('autoplay',''); v.load(); }); }
          }, 80);
        }
      }

      function loadNearby(idx) {
        [idx-2, idx-1, idx, idx+1, idx+2].forEach(function(i) {
          if (i >= 0 && i < cards.length) loadMedia(cards[i]);
        });
      }

      function hidePanel(el) {
        var p = el.querySelector('.ucs__product-panel');
        if (p) p.style.cssText = 'transition:none;opacity:0;visibility:hidden;transform:translateY(30px) scale(0.9);pointer-events:none;';
      }

      function showPanel(el) {
        var p = el.querySelector('.ucs__product-panel');
        if (!p) return;
        p.style.cssText = 'transition:none;opacity:0;visibility:hidden;transform:translateY(30px) scale(0.9);pointer-events:none;';
        setTimeout(function() {
          p.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
          p.style.opacity    = '1';
          p.style.visibility = 'visible';
          p.style.transform  = 'translateY(0) scale(1)';
          p.style.pointerEvents = 'auto';
        }, 50);
      }

      // Build N+4 cards: [clone(N-2),clone(N-1), real0…realN-1, clone(0),clone(1)]
      track.innerHTML = '';
      var cards = [];
      for (var p = PREPEND; p >= 1; p--) { var c = makeCard(N - p); track.appendChild(c); cards.push(c); }
      for (var i = 0; i < N; i++)         { var c = makeCard(i);     track.appendChild(c); cards.push(c); }
      for (var a = 0; a < APPEND; a++)    { var c = makeCard(a);     track.appendChild(c); cards.push(c); }

      var current   = PREPEND; // index of real card 0
      var animating = false;

      function updateDots(idx) {
        if (!dotsWrap) return;
        var dots = dotsWrap.querySelectorAll('.ucs__mob-dot');
        var realIdx = idx - PREPEND;
        dots.forEach(function(d, i) { d.classList.toggle('ucs__mob-dot--active', i === realIdx); });
      }

      // ── centerMob: track is position:absolute left:50% (origin = viewport center)
      // translateX = -(index × (sideW+gap) + ctrW/2) — exactly like desktop
      function centerMob(idx, anim) {
        var sideW = Math.round(window.innerWidth * SIDE_VW);
        var ctrW  = Math.round(window.innerWidth * CTR_VW);
        var tx    = -(idx * (sideW + GAP_PX) + ctrW / 2);
        track.style.transition = anim
          ? 'transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94)'
          : 'none';
        track.style.transform = 'translateX(' + tx + 'px) translateY(-50%)';
        if (!anim) {
          requestAnimationFrame(function() {
            track.style.transition = 'transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94)';
          });
        }
      }

      function applyCenterClass(idx) {
        cards.forEach(function(c, i) {
          var on = i === idx;
          c.classList.toggle('ucs__mob-card--active', on);
          if (!on) hidePanel(c);
          var v = c.querySelector('video');
          if (v) { if (on) v.play().catch(function(){}); else v.pause(); }
        });
        loadNearby(idx);
        updateDots(idx);
      }

      // ── go: pre-jump pattern identical to desktop ucsGo ──────────────────
      function go(dir) {
        if (animating) return;
        animating = true;

        if (dir === 1 && current === PREPEND + N - 1) {
          var jumpTo = current - N;
          var jumpTx = -(jumpTo * (Math.round(window.innerWidth * SIDE_VW) + GAP_PX) + Math.round(window.innerWidth * CTR_VW) / 2);
          track.style.transition = 'none';
          track.style.transform  = 'translateX(' + jumpTx + 'px) translateY(-50%)';
          track.getBoundingClientRect();
          current = jumpTo;
        } else if (dir === -1 && current === PREPEND) {
          var jumpTo = current + N;
          var jumpTx = -(jumpTo * (Math.round(window.innerWidth * SIDE_VW) + GAP_PX) + Math.round(window.innerWidth * CTR_VW) / 2);
          track.style.transition = 'none';
          track.style.transform  = 'translateX(' + jumpTx + 'px) translateY(-50%)';
          track.getBoundingClientRect();
          current = jumpTo;
        }

        current += dir;
        applyCenterClass(current);
        track.style.transition = 'transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94)';
        centerMob(current, true);

        setTimeout(function() { showPanel(cards[current]); animating = false; }, 370);
      }

      // Click
      track.addEventListener('click', function(e) {
        var card = e.target.closest('.ucs__mob-card');
        if (!card) return;
        var idx = cards.indexOf(card);
        if (idx === -1 || animating) return;
        if (idx === current) {
          var url = card.getAttribute('data-redirect-url');
          if (url) window.open(url, '_blank');
        } else go(idx > current ? 1 : -1);
      });

      // Dots
      if (dotsWrap) {
        dotsWrap.addEventListener('click', function(e) {
          var dot = e.target.closest('.ucs__mob-dot');
          if (!dot || animating) return;
          var dotIdx   = parseInt(dot.getAttribute('data-dot-index'), 10);
          var currReal = current - PREPEND;
          if (dotIdx !== currReal) go(dotIdx > currReal ? 1 : -1);
        });
      }

      // Swipe
      var sx = 0, sy = 0, swDir = null;
      track.parentElement.addEventListener('touchstart', function(e) {
        sx = e.touches[0].clientX; sy = e.touches[0].clientY; swDir = null;
      }, { passive: true });
      track.parentElement.addEventListener('touchmove', function(e) {
        if (swDir === 'v') return;
        var dx = Math.abs(e.touches[0].clientX - sx), dy = Math.abs(e.touches[0].clientY - sy);
        if (!swDir && dx < 5 && dy < 5) return;
        if (!swDir) swDir = dx >= dy ? 'h' : 'v';
        if (swDir === 'h') e.preventDefault();
      }, { passive: false });
      track.parentElement.addEventListener('touchend', function(e) {
        if (swDir !== 'h' || animating) return;
        if (Math.abs(e.changedTouches[0].clientX - sx) > 35)
          go(e.changedTouches[0].clientX < sx ? 1 : -1);
      }, { passive: true });

      // Init — position instantly then reveal (same as desktop)
      applyCenterClass(current);
      centerMob(current, false);
      setTimeout(function() { showPanel(cards[current]); }, 100);
    };
  })();
</script>

<script>
  // ── TABLET CAROUSEL JS (481px–1024px) — same pattern as mobile ──────────────
  (function() {
    var SIDE_VW = {{ section.settings.tab_side_card_width | default: 22 }} / 100;
    var CTR_VW  = {{ section.settings.tab_center_card_width | default: 42 }} / 100;
    var GAP     = {{ section.settings.tab_card_gap | default: 16 }};

    window.initUCSTabCarousel = function(sid) {
      var w = window.innerWidth;
      if (w <= 480 || w > 1024) return;

      var track    = document.getElementById('ucs-tab-track-' + sid);
      var dotsWrap = document.getElementById('ucs-tab-dots-' + sid);
      if (!track) return;

      var orig = Array.from(track.querySelectorAll('.ucs__tab-card'));
      var N = orig.length;
      if (N === 0) return;

      var dataArr = orig.map(function(c) {
        return {
          mediaType:    c.getAttribute('data-media-type') || 'image',
          mediaSrc:     c.getAttribute('data-media-src')  || '',
          redirectUrl:  c.getAttribute('data-redirect-url') || '',
          productTitle: c.getAttribute('data-product-title') || '',
          productPrice: c.getAttribute('data-product-price') || '',
          productUrl:   c.getAttribute('data-product-url') || '',
          productImg:   c.getAttribute('data-product-img') || ''
        };
      });

      function buildPanel(d) {
        if (!d.productTitle && !d.productPrice) return '';
        return '<div class="ucs__product-panel" style="transition:none;opacity:0;visibility:hidden;transform:translateY(30px) scale(0.9);pointer-events:none;">'
          + (d.productImg ? '<div class="ucs__product-image"><img src="' + d.productImg + '" alt="' + d.productTitle + '" width="100" height="100" loading="lazy"></div>' : '')
          + '<div class="ucs__product-info">'
          + (d.productTitle ? '<div class="ucs__product-title">' + d.productTitle + '</div>' : '')
          + (d.productPrice ? '<div class="ucs__product-price">' + d.productPrice + '</div>' : '')
          + '</div>'
          + (d.productUrl ? '<a href="' + d.productUrl + '" class="ucs__buy-button" target="_blank">BUY NOW</a>' : '')
          + '</div>';
      }

      function loadMedia(el, d) {
        if (el.getAttribute('data-media-loaded')) return;
        el.setAttribute('data-media-loaded', '1');
        var isActive = el.classList.contains('ucs__tab-card--active');
        var media = '';
        if (d.mediaSrc) {
          if (d.mediaType === 'image') media = '<img class="ucs__card-image" src="' + d.mediaSrc + '" alt="' + d.productTitle + '" width="800" height="1000" loading="' + (isActive ? 'eager' : 'lazy') + '">';
          else if (d.mediaType === 'video') {
            var autoplayAttr = isActive ? ' autoplay' : '';
            media = '<video class="ucs__card-video" muted loop playsinline preload="' + (isActive ? 'auto' : 'metadata') + '"' + autoplayAttr + '><source src="' + d.mediaSrc + '" type="video/mp4"></video>';
          }
          else media = '<iframe class="ucs__card-video" src="' + d.mediaSrc + '" frameborder="0" allowfullscreen loading="lazy"></iframe>';
        }
        el.innerHTML = media + buildPanel(d);
        if (isActive) {
          setTimeout(function() {
            var video = el.querySelector('video');
            if (video) {
              video.muted = true;
              video.play().catch(function() {
                video.setAttribute('autoplay', '');
                video.load();
              });
            }
          }, 100);
        }
      }

      function makeCard(d) {
        var el = document.createElement('div');
        el.className = 'ucs__tab-card';
        Object.keys(d).forEach(function(k) { el.setAttribute('data-' + k.replace(/[A-Z]/g, function(c) { return '-' + c.toLowerCase(); }), d[k]); });
        return el;
      }

      function hidePanel(el) {
        var p = el.querySelector('.ucs__product-panel');
        if (p) p.style.cssText = 'transition:none;opacity:0;visibility:hidden;transform:translateY(30px) scale(0.9);pointer-events:none;';
      }

      function showPanel(el) {
        var p = el.querySelector('.ucs__product-panel');
        if (!p) return;
        p.style.cssText = 'transition:none;opacity:0;visibility:hidden;transform:translateY(30px) scale(0.9);pointer-events:none;';
        setTimeout(function() {
          p.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
          p.style.opacity = '1'; p.style.visibility = 'visible';
          p.style.transform = 'translateY(0) scale(1)'; p.style.pointerEvents = 'auto';
        }, 50);
      }

      // Build: 2 clones each side → N+4 total (same as mobile/desktop)
      // Layout: [clone(N-2), clone(N-1), real0…realN-1, clone(0), clone(1)]
      track.innerHTML = '';
      var cards = [];
      var PREPEND = 2, APPEND = 2;

      for (var p = PREPEND; p >= 1; p--) {
        var cl = makeCard(dataArr[(N - p + N) % N]); track.appendChild(cl); cards.push(cl);
      }
      dataArr.forEach(function(d) { var c = makeCard(d); track.appendChild(c); cards.push(c); });
      for (var a = 0; a < APPEND; a++) {
        var cl = makeCard(dataArr[a % N]); track.appendChild(cl); cards.push(cl);
      }

      var current   = PREPEND; // index of real card 0
      var animating = false;

      function loadNearby(idx) {
        [idx-2, idx-1, idx, idx+1, idx+2].forEach(function(i) {
          if (i >= 0 && i < cards.length) {
            var realI = ((i - PREPEND) % N + N) % N;
            loadMedia(cards[i], dataArr[realI]);
          }
        });
      }

      function updateDots(idx) {
        if (!dotsWrap) return;
        var dots = dotsWrap.querySelectorAll('.ucs__tab-dot');
        var realIdx = idx - PREPEND;
        dots.forEach(function(d, i) { d.classList.toggle('ucs__tab-dot--active', i === realIdx); });
      }

      // ── centerTab: same formula as mobile/desktop ─────────────────────────
      // Track is position:absolute left:50% → origin = viewport center
      // translateX = -(index × (sideW+gap) + ctrW/2)
      function centerTab(idx, anim) {
        var sideW = Math.round(window.innerWidth * SIDE_VW);
        var ctrW  = Math.round(window.innerWidth * CTR_VW);
        var tx    = -(idx * (sideW + GAP) + ctrW / 2);
        track.style.transition = anim
          ? 'transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94)'
          : 'none';
        track.style.transform = 'translateX(' + tx + 'px) translateY(-50%)';
        if (!anim) {
          requestAnimationFrame(function() {
            track.style.transition = 'transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94)';
          });
        }
      }

      function applyCenterClass(idx) {
        cards.forEach(function(c, i) {
          var on = i === idx;
          c.classList.toggle('ucs__tab-card--active', on);
          if (!on) hidePanel(c);
          var v = c.querySelector('video');
          if (v) {
            if (on) {
              v.preload = 'auto';
              if (v.readyState >= 2) v.play().catch(function(){});
              else v.addEventListener('canplay', function() { v.play().catch(function(){}); }, { once: true });
            } else {
              v.pause();
              v.preload = 'metadata';
            }
          }
        });
        loadNearby(idx);
        updateDots(idx);
      }

      // ── go: pre-jump pattern identical to mobile/desktop ─────────────────
      function go(dir) {
        if (animating) return;
        animating = true;

        if (dir === 1 && current === PREPEND + N - 1) {
          var jumpTo = current - N;
          var jumpTx = -(jumpTo * (Math.round(window.innerWidth * SIDE_VW) + GAP) + Math.round(window.innerWidth * CTR_VW) / 2);
          track.style.transition = 'none';
          track.style.transform  = 'translateX(' + jumpTx + 'px) translateY(-50%)';
          track.getBoundingClientRect();
          current = jumpTo;
        } else if (dir === -1 && current === PREPEND) {
          var jumpTo = current + N;
          var jumpTx = -(jumpTo * (Math.round(window.innerWidth * SIDE_VW) + GAP) + Math.round(window.innerWidth * CTR_VW) / 2);
          track.style.transition = 'none';
          track.style.transform  = 'translateX(' + jumpTx + 'px) translateY(-50%)';
          track.getBoundingClientRect();
          current = jumpTo;
        }

        current += dir;
        applyCenterClass(current);
        track.style.transition = 'transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94)';
        centerTab(current, true);

        setTimeout(function() { showPanel(cards[current]); animating = false; }, 370);
      }

      track.addEventListener('click', function(e) {
        var card = e.target.closest('.ucs__tab-card');
        if (!card) return;
        var idx = cards.indexOf(card);
        if (idx === -1 || animating) return;
        if (idx === current) {
          var url = card.getAttribute('data-redirect-url');
          if (url) window.open(url, '_blank');
        } else go(idx > current ? 1 : -1);
      });

      if (dotsWrap) {
        dotsWrap.addEventListener('click', function(e) {
          var dot = e.target.closest('.ucs__tab-dot');
          if (!dot || animating) return;
          var dotIdx   = parseInt(dot.getAttribute('data-dot-index'), 10);
          var currReal = current - PREPEND;
          if (dotIdx !== currReal) go(dotIdx > currReal ? 1 : -1);
        });
      }

      var sx = 0, sy = 0, swDir = null;
      track.parentElement.addEventListener('touchstart', function(e) {
        sx = e.touches[0].clientX; sy = e.touches[0].clientY; swDir = null;
      }, { passive: true });
      track.parentElement.addEventListener('touchmove', function(e) {
        if (swDir === 'v') return;
        var dx = Math.abs(e.touches[0].clientX - sx), dy = Math.abs(e.touches[0].clientY - sy);
        if (!swDir && dx < 5 && dy < 5) return;
        if (!swDir) swDir = dx >= dy ? 'h' : 'v';
        if (swDir === 'h') e.preventDefault();
      }, { passive: false });
      track.parentElement.addEventListener('touchend', function(e) {
        if (swDir !== 'h' || animating) return;
        if (Math.abs(e.changedTouches[0].clientX - sx) > 35)
          go(e.changedTouches[0].clientX < sx ? 1 : -1);
      }, { passive: true });

      // Init — same as mobile/desktop
      applyCenterClass(current);
      centerTab(current, false);
      setTimeout(function() { showPanel(cards[current]); }, 100);
    };
  })();
</script>

