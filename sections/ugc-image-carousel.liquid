{% comment %}
  UGC Image Carousel - Premium horizontal carousel with image cards
  - Center card: Large, active, clickable to redirect
  - Side cards: Smaller, dimmed, clickable to move to center
  - Only center card redirects to link
  - Side cards move to center when clicked
{% endcomment %}

<style>
  .ugc-image-section {
    font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
    background: {{ section.settings.section_background }};
    position: relative;
    overflow: hidden;
  }
  
  .ugc-image-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ugc-image-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .ugc-image-title {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin: 0 0 20px 0;
    line-height: 1.2;
  }

  .ugc-image-description {
    font-size: {{ section.settings.description_font_size }}px;
    color: {{ section.settings.description_color }};
    line-height: 1.5;
    margin: 0;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Fixed 5-Card Layout - Never Breaking System */
  .ugc-image-carousel-container {
    position: relative;
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 0 50px;
  }

  .ugc-image-carousel-track {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Fixed 5-card positioning - Always 2 left + 1 center + 2 right */
  .ugc-image-card {
    position: absolute;
    border-radius: 16px;
    overflow: hidden;
    background: #f5f5f5;
    cursor: pointer;
    transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    top: 50%;
    left: 50%;
    transform-origin: center center;
  }

  /* Position -2: Far left */
  .ugc-image-card.pos-left-2 {
    width: 160px;
    height: 240px;
    opacity: 0.5;
    filter: brightness(0.7);
    transform: translate(-50%, -50%) translateX(-280px) scale(0.8);
    z-index: 1;
  }

  /* Position -1: Near left */
  .ugc-image-card.pos-left-1 {
    width: 180px;
    height: 280px;
    opacity: 0.7;
    filter: brightness(0.85);
    transform: translate(-50%, -50%) translateX(-140px) scale(0.9);
    z-index: 2;
  }

  /* Position 0: CENTER - Always sticky in middle */
  .ugc-image-card.pos-center {
    width: 240px;
    height: 380px;
    opacity: 1;
    filter: none;
    transform: translate(-50%, -50%) translateX(0px) scale(1);
    z-index: 10;
  }

  /* Position +1: Near right */
  .ugc-image-card.pos-right-1 {
    width: 180px;
    height: 280px;
    opacity: 0.7;
    filter: brightness(0.85);
    transform: translate(-50%, -50%) translateX(140px) scale(0.9);
    z-index: 2;
  }

  /* Position +2: Far right */
  .ugc-image-card.pos-right-2 {
    width: 160px;
    height: 240px;
    opacity: 0.5;
    filter: brightness(0.7);
    transform: translate(-50%, -50%) translateX(280px) scale(0.8);
    z-index: 1;
  }

  /* Hidden transition positions to prevent cards going behind */
  .ugc-image-card.pos-left-hidden {
    width: 160px;
    height: 240px;
    opacity: 0;
    filter: brightness(0.7);
    transform: translate(-50%, -50%) translateX(-420px) scale(0.8);
    z-index: 0;
    visibility: visible;
    pointer-events: none;
  }

  .ugc-image-card.pos-right-hidden {
    width: 160px;
    height: 240px;
    opacity: 0;
    filter: brightness(0.7);
    transform: translate(-50%, -50%) translateX(420px) scale(0.8);
    z-index: 0;
    visibility: visible;
    pointer-events: none;
  }

  /* Hide cards not in the positioning system */
  .ugc-image-card:not(.pos-left-hidden):not(.pos-left-2):not(.pos-left-1):not(.pos-center):not(.pos-right-1):not(.pos-right-2):not(.pos-right-hidden) {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Image Card Content */
  .ugc-image-card-content {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    border-radius: inherit;
  }

  .ugc-image-card-content img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Image Product Overlay - Bottom of Card */
  .ugc-image-product-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
    padding: 30px 15px 15px;
    color: white;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.3s ease;
  }

  /* Product overlay only shows on center card */
  .ugc-image-card.pos-center .ugc-image-product-overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .ugc-image-product-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ugc-image-product-thumbnail {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.1);
  }

  .ugc-image-product-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ugc-image-product-details {
    flex: 1;
    min-width: 0;
  }

  .ugc-image-product-title {
    font-size: 12px;
    font-weight: 600;
    margin: 0 0 2px 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ugc-image-product-price {
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }

  .ugc-image-add-icon {
    width: 28px;
    height: 28px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 16px;
    font-weight: 900;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .ugc-image-add-icon:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.1);
  }

  /* Image Navigation Dots */
  .ugc-image-navigation {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 40px;
  }

  .ugc-image-nav-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: {{ section.settings.dot_inactive_color }};
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ugc-image-nav-dot.active {
    background: {{ section.settings.dot_active_color }};
    transform: scale(1.3);
  }

  /* Image Loading State */
  .ugc-image-loading-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #666;
    border-radius: inherit;
    font-size: 12px;
    text-align: center;
  }

  /* Responsive Design - 7-Position Layout */
  @media (max-width: 1200px) {
    .ugc-image-carousel-container {
      padding: 0 30px;
    }

    .ugc-image-card.pos-left-hidden {
      width: 120px;
      height: 170px;
      transform: translate(-50%, -50%) translateX(-360px) scale(0.8);
    }

    .ugc-image-card.pos-left-2 {
      width: 120px;
      height: 170px;
      transform: translate(-50%, -50%) translateX(-240px) scale(0.8);
    }

    .ugc-image-card.pos-left-1 {
      width: 140px;
      height: 200px;
      transform: translate(-50%, -50%) translateX(-120px) scale(0.9);
    }

    .ugc-image-card.pos-center {
      width: 180px;
      height: 260px;
    }

    .ugc-image-card.pos-right-1 {
      width: 140px;
      height: 200px;
      transform: translate(-50%, -50%) translateX(120px) scale(0.9);
    }

    .ugc-image-card.pos-right-2 {
      width: 120px;
      height: 170px;
      transform: translate(-50%, -50%) translateX(240px) scale(0.8);
    }

    .ugc-image-card.pos-right-hidden {
      width: 120px;
      height: 170px;
      transform: translate(-50%, -50%) translateX(360px) scale(0.8);
    }
  }

  @media (max-width: 768px) {
    .ugc-image-carousel-container {
      height: 300px;
      padding: 0 20px;
    }

    .ugc-image-card.pos-left-hidden {
      width: 80px;
      height: 120px;
      transform: translate(-50%, -50%) translateX(-240px) scale(0.8);
    }

    .ugc-image-card.pos-left-2 {
      width: 80px;
      height: 120px;
      transform: translate(-50%, -50%) translateX(-160px) scale(0.8);
    }

    .ugc-image-card.pos-left-1 {
      width: 100px;
      height: 150px;
      transform: translate(-50%, -50%) translateX(-80px) scale(0.9);
    }

    .ugc-image-card.pos-center {
      width: 140px;
      height: 200px;
    }

    .ugc-image-card.pos-right-1 {
      width: 100px;
      height: 150px;
      transform: translate(-50%, -50%) translateX(80px) scale(0.9);
    }

    .ugc-image-card.pos-right-2 {
      width: 80px;
      height: 120px;
      transform: translate(-50%, -50%) translateX(160px) scale(0.8);
    }

    .ugc-image-card.pos-right-hidden {
      width: 80px;
      height: 120px;
      transform: translate(-50%, -50%) translateX(240px) scale(0.8);
    }

    .ugc-image-product-overlay {
      padding: 20px 10px 10px;
    }

    .ugc-image-product-title {
      font-size: 10px;
    }

    .ugc-image-product-price {
      font-size: 12px;
    }
  }

  @media (max-width: 480px) {
    .ugc-image-carousel-container {
      height: 250px;
      padding: 0 15px;
    }

    .ugc-image-card.pos-left-hidden {
      width: 60px;
      height: 90px;
      transform: translate(-50%, -50%) translateX(-180px) scale(0.8);
    }

    .ugc-image-card.pos-left-2 {
      width: 60px;
      height: 90px;
      transform: translate(-50%, -50%) translateX(-120px) scale(0.8);
    }

    .ugc-image-card.pos-left-1 {
      width: 80px;
      height: 120px;
      transform: translate(-50%, -50%) translateX(-60px) scale(0.9);
    }

    .ugc-image-card.pos-center {
      width: 120px;
      height: 180px;
    }

    .ugc-image-card.pos-right-1 {
      width: 80px;
      height: 120px;
      transform: translate(-50%, -50%) translateX(60px) scale(0.9);
    }

    .ugc-image-card.pos-right-2 {
      width: 60px;
      height: 90px;
      transform: translate(-50%, -50%) translateX(120px) scale(0.8);
    }

    .ugc-image-card.pos-right-hidden {
      width: 60px;
      height: 90px;
      transform: translate(-50%, -50%) translateX(180px) scale(0.8);
    }
  }
</style>

<section class="ugc-image-section">
  <div class="ugc-image-container">
    {% if section.settings.section_title != blank or section.settings.section_description != blank %}
      <div class="ugc-image-header">
        {% if section.settings.section_title != blank %}
          <h2 class="ugc-image-title">{{ section.settings.section_title }}</h2>
        {% endif %}
        {% if section.settings.section_description != blank %}
          <p class="ugc-image-description">{{ section.settings.section_description }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="ugc-image-carousel-container">
        <div class="ugc-image-carousel-track" id="ugcImageTrack">
          {% for block in section.blocks %}
            <div class="ugc-image-card" 
                 data-index="{{ forloop.index0 }}"
                 data-redirect-url="{{ block.settings.redirect_url }}">
              
              {% if block.settings.card_image != blank %}
                <!-- Image Card Content -->
                <div class="ugc-image-card-content">
                  <img src="{{ block.settings.card_image | image_url: width: 440 }}" 
                       alt="{{ block.settings.product_title | escape }}"
                       width="440"
                       height="640"
                       loading="lazy">
                </div>
              {% else %}
                <!-- Image Loading Placeholder -->
                <div class="ugc-image-loading-placeholder">
                  <p>Add Card Image</p>
                </div>
              {% endif %}

              <!-- Image Product Overlay (Only visible on center card) -->
              {% if block.settings.product_title != blank or block.settings.product_price != blank %}
                <div class="ugc-image-product-overlay">
                  <div class="ugc-image-product-info">
                    <div class="ugc-image-product-thumbnail">
                      {% if block.settings.product_image != blank %}
                        <img src="{{ block.settings.product_image | image_url: width: 80 }}" 
                             alt="{{ block.settings.product_title | escape }}"
                             width="80"
                             height="80">
                      {% endif %}
                    </div>
                    <div class="ugc-image-product-details">
                      {% if block.settings.product_title != blank %}
                        <h3 class="ugc-image-product-title">{{ block.settings.product_title }}</h3>
                      {% endif %}
                      {% if block.settings.product_price != blank %}
                        <p class="ugc-image-product-price">{{ block.settings.product_price }}</p>
                      {% endif %}
                    </div>
                    <div class="ugc-image-add-icon">+</div>
                  </div>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.blocks.size > 1 %}
        <div class="ugc-image-navigation">
          {% for block in section.blocks %}
            <div class="ugc-image-nav-dot" data-index="{{ forloop.index0 }}"></div>
          {% endfor %}
        </div>
      {% endif %}
    {% else %}
      <div style="text-align: center; padding: 60px 20px; color: #666;">
        <p>Add UGC image cards using the theme editor.</p>
      </div>
    {% endif %}
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const track = document.getElementById('ugcImageTrack');
  const imageCards = document.querySelectorAll('.ugc-image-card');
  const imageDots = document.querySelectorAll('.ugc-image-nav-dot');
  let currentImageCenterIndex = 0;

  if (imageCards.length === 0) return;

  // Fixed 7-position system - Prevents cards going behind
  function updateFixedLayout(centerIndex) {
    console.log('🎯 7-Position Layout - Center:', centerIndex, 'of', imageCards.length, 'total cards');
    
    const totalCards = imageCards.length;
    
    // Normalize center index
    centerIndex = ((centerIndex % totalCards) + totalCards) % totalCards;
    
    // Remove all position classes from all cards
    imageCards.forEach(card => {
      card.className = 'ugc-image-card';
    });
    
    // 7-position system: hidden-left, far-left, near-left, CENTER, near-right, far-right, hidden-right
    const positions = [
      { offset: -3, class: 'pos-left-hidden' },   // Hidden left (smooth entry)
      { offset: -2, class: 'pos-left-2' },       // Far left
      { offset: -1, class: 'pos-left-1' },       // Near left
      { offset: 0,  class: 'pos-center' },       // CENTER (sticky)
      { offset: 1,  class: 'pos-right-1' },      // Near right
      { offset: 2,  class: 'pos-right-2' },      // Far right
      { offset: 3,  class: 'pos-right-hidden' }  // Hidden right (smooth exit)
    ];
    
    positions.forEach(pos => {
      const cardIndex = (centerIndex + pos.offset + totalCards) % totalCards;
      const card = imageCards[cardIndex];
      
      if (card) {
        card.classList.add(pos.class);
        console.log(`✅ Offset ${pos.offset}: Card ${cardIndex} → ${pos.class} ${pos.offset === 0 ? '(CENTER - STICKY)' : pos.offset === -3 || pos.offset === 3 ? '(HIDDEN)' : '(SIDE)'}`);
      }
    });
    
    currentImageCenterIndex = centerIndex;
    
    // Update dots
    imageDots.forEach(dot => dot.classList.remove('active'));
    if (imageDots[centerIndex]) {
      imageDots[centerIndex].classList.add('active');
    }
    
    console.log('🔒 7-position layout complete - No cards go behind during transitions');
  }

  // Navigation functions
  function slideToNext() {
    updateFixedLayout(currentImageCenterIndex + 1);
  }

  function slideToPrev() {
    updateFixedLayout(currentImageCenterIndex - 1);
  }

  function slideToIndex(targetIndex) {
    updateFixedLayout(targetIndex);
  }

  // Initialize carousel with 7-position layout
  function initImageCarousel() {
    console.log('🖼️ Initializing 7-Position Image Carousel (No Behind Sliding)');
    console.log('Total image cards:', imageCards.length);
    
    // Set initial layout
    updateFixedLayout(0);
    
    console.log('✅ 7-Position Image Carousel initialized - Cards will never go behind');
  }

  // Card click handlers
  imageCards.forEach((card, index) => {
    card.addEventListener('click', (e) => {
      e.preventDefault();
      
      if (card.classList.contains('pos-center')) {
        // Center card clicked - redirect to link
        const redirectUrl = card.dataset.redirectUrl;
        if (redirectUrl) {
          console.log('🔗 Center image card clicked, redirecting to:', redirectUrl);
          window.open(redirectUrl, '_blank');
        } else {
          console.log('⚠️ Center image card clicked but no redirect URL set');
        }
      } else {
        // Side card clicked - slide to make it center
        console.log('👆 Side image card', index, 'clicked, moving to center');
        slideToIndex(index);
      }
    });
  });

  // Dot navigation
  imageDots.forEach((dot, index) => {
    dot.addEventListener('click', () => {
      console.log('🔘 Image Dot', index, 'clicked');
      slideToIndex(index);
    });
  });

  // Touch/swipe support
  let startX = 0;
  let startY = 0;
  
  track.addEventListener('touchstart', (e) => {
    startX = e.touches[0].clientX;
    startY = e.touches[0].clientY;
  });

  track.addEventListener('touchend', (e) => {
    if (!startX || !startY) return;
    
    const endX = e.changedTouches[0].clientX;
    const endY = e.changedTouches[0].clientY;
    
    const diffX = startX - endX;
    const diffY = startY - endY;
    
    if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 50) {
      if (diffX > 0) {
        // Swipe left - next card
        slideToNext();
      } else {
        // Swipe right - previous card
        slideToPrev();
      }
    }
    
    startX = 0;
    startY = 0;
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      slideToPrev();
    } else if (e.key === 'ArrowRight') {
      slideToNext();
    }
  });

  // Initialize everything
  console.log('🚀 Starting 7-Position Image Carousel - No Behind Sliding...');
  initImageCarousel();
});
</script>

{% schema %}
{
  "name": "UGC Image Carousel",
  "tag": "section",
  "class": "ugc-image-section",
  "settings": [
    {
      "type": "header",
