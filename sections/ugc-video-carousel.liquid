{% comment %}
  UGC Video Carousel - Using Medical Team UI with video functionality
  Features: Center focus card with video content, side cards with thumbnails, infinite scroll		!	
{% endcomment %}




<style>
  .ugc-video-section {
    font-family: 'Montserrat', sans-serif;
    background: {{ section.settings.section_background | default: '#000000' }};
    padding: 40px 0 30px 0;
    overflow: hidden;
    min-height: auto;
    display: flex;
    align-items: center;
  }




  .ugc-video-container {
    width: 100%;
    margin: 0;
    padding: 0;
  }




  /* Header */
  .ugc-video-header {
    text-align: center;
    margin-bottom: 50px;
    background: transparent;
    width: 100%;
    padding: 0 20px;
  }




  .ugc-video-title {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: 800;
    color: {{ section.settings.title_color | default: '#ffffff' }};
    line-height: 1.2;
    margin: 0 auto;
    padding: 0;
    font-family: 'Montserrat', sans-serif;
    background: transparent !important;
    text-align: center;
    width: 100%;
  }




  .ugc-video-description {
    font-size: {{ section.settings.description_font_size }}px;
    color: {{ section.settings.description_color | default: '#ffffff' }};
    line-height: 1.6;
    margin: 0 auto;
    max-width: 800px;
    font-family: 'Montserrat', sans-serif;
    text-align: center;
  }




  /* Carousel */
  .ugc-video-carousel {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
    padding: 0 20px;
    height: 500px;
    min-height: 500px;
    width: 100%;
  }




  .ugc-video-track-container {
    flex: 1;
    overflow: visible;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 500px;
  }




  .ugc-video-track {
    display: flex;
    gap: 25px;
    transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    padding: 15px 0;
    align-items: center;
    justify-content: center;
    height: 500px;
    opacity: 0;
    visibility: hidden;
    will-change: transform;
  }
 
  .ugc-video-track.initialized {
    opacity: 1;
    visibility: visible;
  }




  /* Placeholder styles */
  .ugc-video-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 300px;
    color: #666;
    font-family: 'Montserrat', sans-serif;
    text-align: center;
    flex-direction: column;
    gap: 10px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 18px;
    border: 2px dashed rgba(255, 255, 255, 0.2);
    margin: 0 20px;
    padding: 40px;
  }




  /* Navigation Buttons */
  .ugc-video-nav {
    background: {{ section.settings.nav_bg_color | default: '#000000' }};
    border: 2px solid {{ section.settings.nav_border_color | default: '#4FFFFF' }};
    border-radius: 50%;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    flex-shrink: 0;
    z-index: 10;
  }




  .ugc-video-nav:hover {
    transform: scale(1.1);
    box-shadow: 0 0 20px {{ section.settings.nav_border_color | default: '#4FFFFF' }};
  }




  .ugc-video-nav svg {
    width: 24px;
    height: 24px;
    stroke: {{ section.settings.nav_icon_color | default: '#4FFFFF' }};
  }




  /* Side Cards - Simple Grayscale Videos/Images */
  .ugc-video-card {
    position: relative;
    flex-shrink: 0;
    cursor: pointer;
    transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    background: transparent;
    border-radius: 18px;
    padding: 0;
    box-shadow: none;
    width: 240px;
    height: 280px;
    opacity: 0.7;
    filter: grayscale(100%);
    align-self: center;
    overflow: hidden;
  }




  .ugc-video-card:hover {
    opacity: 0.8;
    transform: none;
  }




  .ugc-side-card-content {
    width: 100%;
    height: 100%;
    border-radius: 18px;
    overflow: hidden;
    margin-bottom: 0;
    background: #f0f0f0;
  }




  .ugc-side-card-content img,
  .ugc-side-card-content video,
  .ugc-side-card-content iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }




  /* Center Active Card - Larger with Full Video and Product Overlay */
  .ugc-video-card.active {
    width: 400px !important;
    height: 480px !important;
    opacity: 1 !important;
    filter: grayscale(0) !important;
    transform: scale(1) !important;
    z-index: 10 !important;
    border-radius: 22px !important;
    overflow: hidden !important;
    {% comment %} box-shadow: 0 25px 70px rgba(0, 0, 0, 0.5) !important; {% endcomment %}
    background: #000000 !important;
    padding: 0 !important;
    align-self: center !important;
    margin-bottom: 0 !important;
  }




  .ugc-video-card.active:hover {
    transform: scale(1) !important;
    opacity: 1 !important;
  }




  .ugc-video-card.active .ugc-side-card-content {
    display: none !important;
  }
 
  .ugc-video-card.active .ugc-center-card-content {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
  }




  .ugc-center-card-content {
    width: 100%;
    height: 100%;
    position: relative;
    display: block;
  }




  .ugc-center-card-content img,
  .ugc-center-card-content video,
  .ugc-center-card-content iframe {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: none;
  }




  /* Video Controls Hiding */
  .ugc-center-card-content video::-webkit-media-controls,
  .ugc-side-card-content video::-webkit-media-controls {
    display: none !important;
  }




  .ugc-center-card-content video::-webkit-media-controls-panel,
  .ugc-side-card-content video::-webkit-media-controls-panel {
    display: none !important;
  }




  .ugc-center-card-content video::-moz-media-controls,
  .ugc-side-card-content video::-moz-media-controls {
    display: none !important;
  }




  .ugc-center-card-content video,
  .ugc-side-card-content video {
    pointer-events: none !important;
    -webkit-user-select: none !important;
    -moz-user-select: none !important;
    user-select: none !important;
  }




  /* Product Overlay - Bottom of Card */
  .ugc-video-product-overlay {
    position: absolute;
    bottom: 30px;
    left: 30px;
    right: 30px;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    padding: 15px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    color: white;
  }




  .ugc-video-card.active.centered .ugc-video-product-overlay {
    opacity: 1;
    transform: translateY(0);
  }




  .ugc-video-product-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }




  .ugc-video-product-thumbnail {
    width: 50px;
    height: 50px;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.1);
  }




  .ugc-video-product-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 6px;
    padding: 2px;
  }




  .ugc-video-product-details {
    flex: 1;
    min-width: 0;
  }




  .ugc-video-product-title {
    font-size: 14px;
    font-weight: 600;
    margin: 0 0 4px 0;
    line-height: 1.3;
    color: white;
    font-family: 'Montserrat', sans-serif;
  }




  .ugc-video-product-price {
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    margin: 0;
    font-family: 'Montserrat', sans-serif;
  }




  .ugc-video-product-arrow {
    width: auto;
    height: 36px;
    background: transparent;
    border: 2px solid #4FFFFF;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    flex-shrink: 0;
    transition: all 0.3s ease;
    cursor: pointer;
    outline: none;
    padding: 0 12px;
    font-family: 'Montserrat', sans-serif;
  }




  .ugc-video-product-arrow:hover {
    background: rgba(79, 255, 255, 0.1);
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgba(79, 255, 255, 0.3);
  }




  /* Responsive */
  @media (max-width: 1024px) {
    .ugc-video-header {
      margin-bottom: 40px;
    }




    .ugc-video-card {
      width: 200px;
      height: 240px;
    }




    .ugc-video-card.active {
      width: 350px !important;
      height: 420px !important;
    }
  }




  @media (max-width: 768px) {
    .ugc-video-section {
      padding: 60px 0;
    }




    .ugc-video-header {
      margin-bottom: 40px;
      padding: 0 15px;
    }




    .ugc-video-title {
      font-size: {{ section.settings.title_font_size | minus: 10 }}px;
    }




    .ugc-video-description {
      font-size: {{ section.settings.description_font_size | minus: 2 }}px;
    }




    .ugc-video-carousel {
      gap: 15px;
      padding: 0 15px;
    }




    .ugc-video-card {
      width: 200px;
      height: 240px;
    }




    .ugc-video-card.active {
      width: 320px !important;
      height: 420px !important;
    }




    .ugc-video-product-overlay {
      bottom: 20px;
      left: 20px;
      right: 20px;
      padding: 12px;
    }




    .ugc-video-nav {
      width: 48px;
      height: 48px;
    }
  }




  @media (max-width: 480px) {
    .ugc-video-carousel {
      gap: 10px;
      padding: 0 10px;
    }




    .ugc-video-card {
      width: 160px;
      height: 200px;
    }




    .ugc-video-card.active {
      width: 260px !important;
      height: 340px !important;
    }




    .ugc-video-product-overlay {
      bottom: 15px;
      left: 15px;
      right: 15px;
      padding: 10px;
    }




    .ugc-video-nav {
      width: 40px;
      height: 40px;
    }
  }
</style>




<section class="ugc-video-section full-width">
  <div class="ugc-video-container">
    <!-- Header -->
    <div class="ugc-video-header">
      {% if section.settings.section_title != blank %}
        <h2 class="ugc-video-title">{{ section.settings.section_title }}</h2>
      {% endif %}
      {% if section.settings.section_description != blank %}
        <p class="ugc-video-description">{{ section.settings.section_description }}</p>
      {% endif %}
    </div>




    <!-- Carousel -->
    <div class="ugc-video-carousel">
      {% if section.blocks.size > 0 %}
        <button class="ugc-video-nav" onclick="moveUgcVideo(-1, '{{ section.id }}')">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M15 18L9 12L15 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {% endif %}




      <div class="ugc-video-track-container">
        <div class="ugc-video-track" id="ugc-video-track-{{ section.id }}">
          {% if section.blocks.size == 0 %}
            <!-- No blocks placeholder -->
            <div class="ugc-video-placeholder">
              <div style="font-size: 18px; font-weight: 600;">No video cards added yet</div>
              <div style="font-size: 14px; opacity: 0.8;">Add UGC Video Cards to display content</div>
            </div>
          {% else %}
            <!-- Clone cards before (for left side infinite scroll) -->
            {% for block in section.blocks %}
              <div class="ugc-video-card clone-before"
                   data-index="{{ forloop.index0 }}"
                   data-video-url="{{ block.settings.video_url }}"
                   data-redirect-url="{{ block.settings.redirect_url }}"
                   onclick="handleUgcVideoCardClick(this, '{{ section.id }}')">
               
                <!-- Side Card Content (always present) -->
                <div class="ugc-side-card-content">
                  {% comment %}Side card content will be populated by JavaScript{% endcomment %}
                </div>
               
                <!-- Center Card Content (always present) -->
                <div class="ugc-center-card-content" style="display: none;">
                  {% comment %}Center card content will be populated by JavaScript{% endcomment %}
                 
                  <!-- Video Product Overlay -->
                  {% if block.settings.product_title != blank or block.settings.product_price != blank %}
                    <div class="ugc-video-product-overlay">
                      <div class="ugc-video-product-info">
                        <div class="ugc-video-product-thumbnail">
                          {% if block.settings.product_image != blank %}
                            <img src="{{ block.settings.product_image | image_url: width: 80 }}"
                                 alt="{{ block.settings.product_title | escape }}"
                                 width="80"
                                 height="80">
                          {% endif %}
                        </div>
                        <div class="ugc-video-product-details">
                          {% if block.settings.product_title != blank %}
                            <h3 class="ugc-video-product-title">{{ block.settings.product_title }}</h3>
                          {% endif %}
                          {% if block.settings.product_price != blank %}
                            <p class="ugc-video-product-price">{{ block.settings.product_price }}</p>
                          {% endif %}
                        </div>
                        <button class="ugc-video-product-arrow"
                                data-product-url="{{ block.settings.product_url | default: block.settings.product.url }}"
                                onclick="redirectToProduct(this)">BUY NOW</button>
                      </div>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}




            <!-- Original cards -->
            {% for block in section.blocks %}
              <div class="ugc-video-card original {% if forloop.first %}active{% endif %}"
                   data-index="{{ forloop.index0 }}"
                   data-video-url="{{ block.settings.video_url }}"
                   data-redirect-url="{{ block.settings.redirect_url }}"
                   onclick="handleUgcVideoCardClick(this, '{{ section.id }}')">
               
                <!-- Side Card Content (always present) -->
                <div class="ugc-side-card-content">
                  {% comment %}Side card content will be populated by JavaScript{% endcomment %}
                </div>
               
                <!-- Center Card Content (always present) -->
                <div class="ugc-center-card-content" {% unless forloop.first %}style="display: none;"{% endunless %}>
                  {% comment %}Center card content will be populated by JavaScript{% endcomment %}
                 
                  <!-- Video Product Overlay -->
                  {% if block.settings.product_title != blank or block.settings.product_price != blank %}
                    <div class="ugc-video-product-overlay">
                      <div class="ugc-video-product-info">
                        <div class="ugc-video-product-thumbnail">
                          {% if block.settings.product_image != blank %}
                            <img src="{{ block.settings.product_image | image_url: width: 80 }}"
                                 alt="{{ block.settings.product_title | escape }}"
                                 width="80"
                                 height="80">
                          {% endif %}
                        </div>
                        <div class="ugc-video-product-details">
                          {% if block.settings.product_title != blank %}
                            <h3 class="ugc-video-product-title">{{ block.settings.product_title }}</h3>
                          {% endif %}
                          {% if block.settings.product_price != blank %}
                            <p class="ugc-video-product-price">{{ block.settings.product_price }}</p>
                          {% endif %}
                        </div>
                        <button class="ugc-video-product-arrow"
                                data-product-url="{{ block.settings.product_url | default: block.settings.product.url }}"
                                onclick="redirectToProduct(this)">BUY NOW</button>
                      </div>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}




            <!-- Clone cards after (for right side infinite scroll) -->
            {% for block in section.blocks %}
              <div class="ugc-video-card clone-after"
                   data-index="{{ forloop.index0 }}"
                   data-video-url="{{ block.settings.video_url }}"
                   data-redirect-url="{{ block.settings.redirect_url }}"
                   onclick="handleUgcVideoCardClick(this, '{{ section.id }}')">
               
                <!-- Side Card Content (always present) -->
                <div class="ugc-side-card-content">
                  {% comment %}Side card content will be populated by JavaScript{% endcomment %}
                </div>
               
                <!-- Center Card Content (always present) -->
                <div class="ugc-center-card-content" style="display: none;">
                  {% comment %}Center card content will be populated by JavaScript{% endcomment %}
                 
                  <!-- Video Product Overlay -->
                  {% if block.settings.product_title != blank or block.settings.product_price != blank %}
                    <div class="ugc-video-product-overlay">
                      <div class="ugc-video-product-info">
                        <div class="ugc-video-product-thumbnail">
                          {% if block.settings.product_image != blank %}
                            <img src="{{ block.settings.product_image | image_url: width: 80 }}"
                                 alt="{{ block.settings.product_title | escape }}"
                                 width="80"
                                 height="80">
                          {% endif %}
                        </div>
                        <div class="ugc-video-product-details">
                          {% if block.settings.product_title != blank %}
                            <h3 class="ugc-video-product-title">{{ block.settings.product_title }}</h3>
                          {% endif %}
                          {% if block.settings.product_price != blank %}
                            <p class="ugc-video-product-price">{{ block.settings.product_price }}</p>
                          {% endif %}
                        </div>
                        <button class="ugc-video-product-arrow"
                                data-product-url="{{ block.settings.product_url | default: block.settings.product.url }}"
                                onclick="redirectToProduct(this)">BUY NOW</button>
                      </div>
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>




      {% if section.blocks.size > 0 %}
        <button class="ugc-video-nav" onclick="moveUgcVideo(1, '{{ section.id }}')">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M9 18L15 12L9 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {% endif %}
    </div>
  </div>
</section>




<script>
// UGC Video Carousel - Simplified approach without infinite scroll
window.ugcVideoData = window.ugcVideoData || {};




// Video URL processing function
function getVideoSource(url) {
  if (!url) return null;
 
  // Direct video file (mp4, webm, etc.)
  if (url.match(/\.(mp4|webm|ogg|mov)(\?.*)?$/i)) {
    return {
      type: 'direct',
      src: url,
      embed: null
    };
  }
 
  // Instagram Reel
  if (url.includes('instagram.com/reel/') || url.includes('instagram.com/p/')) {
    const postId = url.match(/\/(?:reel|p)\/([A-Za-z0-9_-]+)/);
    if (postId) {
      return {
        type: 'instagram',
        src: url,
        embed: `https://www.instagram.com/p/${postId[1]}/embed/`
      };
    }
  }
 
  // TikTok
  if (url.includes('tiktok.com')) {
    return {
      type: 'tiktok',
      src: url,
      embed: url.replace('/video/', '/embed/v2/')
    };
  }
 
  // YouTube Shorts or regular videos
  if (url.includes('youtube.com') || url.includes('youtu.be')) {
    let videoId = null;
    if (url.includes('youtu.be/')) {
      videoId = url.split('youtu.be/')[1].split('?')[0];
    } else if (url.includes('youtube.com/watch')) {
      videoId = url.split('v=')[1]?.split('&')[0];
    } else if (url.includes('youtube.com/shorts/')) {
      videoId = url.split('/shorts/')[1].split('?')[0];
    }
   
    if (videoId) {
      return {
        type: 'youtube',
        src: url,
        embed: `https://www.youtube.com/embed/${videoId}?autoplay=1&mute=1&loop=1&playlist=${videoId}&controls=0&modestbranding=1&rel=0`
      };
    }
  }
 
  // Facebook
  if (url.includes('facebook.com')) {
    return {
      type: 'facebook',
      src: url,
      embed: `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&width=400&height=480`
    };
  }
 
  // Default: try as direct video
  return {
    type: 'direct',
    src: url,
    embed: null
  };
}




function createVideoElement(videoUrl, isActive = false) {
  if (!videoUrl || videoUrl.trim() === '') {
    return `<div style="background: #f0f0f0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #666; font-family: 'Montserrat', sans-serif; text-align: center; flex-direction: column; gap: 8px; border-radius: inherit;">
      <div style="font-size: 16px; font-weight: 600;">No Video URL</div>
      <div style="font-size: 12px;">Add a video URL to display content</div>
    </div>`;
  }
 
  const videoSource = getVideoSource(videoUrl);
  if (!videoSource) {
    return `<div style="background: #f0f0f0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #666; font-family: 'Montserrat', sans-serif; text-align: center; flex-direction: column; gap: 8px; border-radius: inherit;">
      <div style="font-size: 16px; font-weight: 600;">Invalid Video URL</div>
      <div style="font-size: 12px;">Please check the video URL format</div>
    </div>`;
  }
 
  if (videoSource.type === 'direct') {
    return `<video ${isActive ? 'autoplay' : ''} muted loop playsinline preload="metadata" style="width: 100%; height: 100%; object-fit: cover; pointer-events: none; border-radius: inherit;"><source src="${videoSource.src}" type="video/mp4"></video>`;
  } else {
    return `<iframe src="${videoSource.embed}" frameborder="0" allowfullscreen allow="autoplay; encrypted-media; picture-in-picture" style="width: 100%; height: 100%; object-fit: cover; pointer-events: ${isActive ? 'auto' : 'none'}; border-radius: inherit;" loading="lazy" scrolling="no"></iframe>`;
  }
}




function initializeUgcVideo(sectionId) {
  const originalBlocksCount = parseInt('{{ section.blocks.size }}');
 
  console.log('🎬 Initializing UGC Video Carousel (Infinite Scroll)');
  console.log('Section ID:', sectionId);
  console.log('Original blocks count:', originalBlocksCount);
 
  if (originalBlocksCount === 0) {
    console.log('❌ No video blocks found - carousel cannot initialize');
    return;
  }




  // Start at the first original card (after clone-before cards)
  const startIndex = originalBlocksCount;




  window.ugcVideoData[sectionId] = {
    currentIndex: startIndex,
    originalBlocksCount: originalBlocksCount,
    totalCards: originalBlocksCount * 3, // clone-before + original + clone-after
    isTransitioning: false
  };




  const track = document.getElementById(`ugc-video-track-${sectionId}`);
  const cards = track.querySelectorAll('.ugc-video-card');




  console.log('Track element:', track);
  console.log('Cards found:', cards.length);




  if (cards.length === 0) {
    console.log('❌ No video cards found in DOM');
    return;
  }




  // Load content for ALL cards
  cards.forEach((card, i) => {
    const videoUrl = card.getAttribute('data-video-url') || '';
    const sideContent = card.querySelector('.ugc-side-card-content');
    const centerContent = card.querySelector('.ugc-center-card-content');
   
    console.log(`Processing card ${i}, video URL:`, videoUrl);
   
    // Load video content for side display
    if (sideContent) {
      sideContent.innerHTML = createVideoElement(videoUrl, false);
    }
   
    // Load video content for center display
    if (centerContent) {
      const overlay = centerContent.querySelector('.ugc-video-product-overlay');
      const overlayHTML = overlay ? overlay.outerHTML : '';
      centerContent.innerHTML = createVideoElement(videoUrl, true) + overlayHTML;
    }
  });




  // Set initial active state
  selectUgcVideoCard(startIndex, sectionId, false);
 
  // Show the track after positioning
  setTimeout(() => {
    track.classList.add('initialized');
    console.log('✅ UGC Video Carousel initialized successfully');
  }, 100);
}




function centerUgcVideoCard(index, sectionId, animate = true) {
  const track = document.getElementById(`ugc-video-track-${sectionId}`);
  const cards = track.querySelectorAll('.ugc-video-card');
  const container = track.parentElement;




  if (cards.length === 0) return;




  const containerWidth = container.offsetWidth;
  const containerCenter = containerWidth / 2;
  const sideCardWidth = 240;
  const activeCardWidth = 400;
  const gap = 25;




  // Calculate the left edge position of the active card
  let leftEdgePosition = 0;
  for (let i = 0; i < index; i++) {
    leftEdgePosition += sideCardWidth + gap;
  }




  // Add half of the active card width to get to its center
  const activeCardCenter = leftEdgePosition + (activeCardWidth / 2);




  // Calculate how much to shift to center the active card
  const targetTransform = containerCenter - activeCardCenter;




  if (!animate) {
    track.style.transition = 'none';
  } else {
    track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
  }




  track.style.transform = `translateX(${targetTransform}px)`;




  if (!animate) {
    requestAnimationFrame(() => {
      track.style.transition = 'transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
    });
  }
}




function selectUgcVideoCard(index, sectionId, animate = true) {
  const track = document.getElementById(`ugc-video-track-${sectionId}`);
  const cards = track.querySelectorAll('.ugc-video-card');
  const data = window.ugcVideoData[sectionId];


  // Remove centered class from all cards first
  cards.forEach(card => {
    card.classList.remove('centered');
  });


  // Update active states and show/hide appropriate content
  cards.forEach((card, i) => {
    const sideContent = card.querySelector('.ugc-side-card-content');
    const centerContent = card.querySelector('.ugc-center-card-content');
   
    if (i === index) {
      // New active card - show center content, hide side content
      card.classList.add('active');
      if (sideContent) sideContent.style.display = 'none';
      if (centerContent) centerContent.style.display = 'block';
      console.log(`✅ Set card ${i} as active (center)`);
    } else {
      // All other cards - show side content, hide center content
      card.classList.remove('active');
      if (sideContent) sideContent.style.display = 'block';
      if (centerContent) centerContent.style.display = 'none';
    }
  });


  data.currentIndex = index;
 
  // Center the carousel
  requestAnimationFrame(() => {
    centerUgcVideoCard(index, sectionId, animate);
   
    // Add centered class after transition completes to show overlay
    setTimeout(() => {
      const activeCard = cards[index];
      if (activeCard && activeCard.classList.contains('active')) {
        activeCard.classList.add('centered');
      }
    }, animate ? 650 : 100); // Match transition duration
  });
}




function moveUgcVideo(direction, sectionId) {
  const data = window.ugcVideoData[sectionId];
  if (data.isTransitioning) return;




  data.isTransitioning = true;


  // Remove centered class from all cards during transition
  const track = document.getElementById(`ugc-video-track-${sectionId}`);
  const cards = track.querySelectorAll('.ugc-video-card');
  cards.forEach(card => {
    card.classList.remove('centered');
  });




  let newIndex = data.currentIndex + direction;
  const originalBlocksCount = data.originalBlocksCount;
  const totalCards = originalBlocksCount * 3;




  console.log(`Moving ${direction > 0 ? 'right' : 'left'} from ${data.currentIndex} to ${newIndex}`);




  // Handle boundaries with wrapping
  if (newIndex >= totalCards) {
    // Wrap to beginning
    newIndex = originalBlocksCount; // Start of original cards
    console.log(`Wrapped right: new index ${newIndex}`);
  } else if (newIndex < 0) {
    // Wrap to end
    newIndex = originalBlocksCount * 2 - 1; // End of original cards
    console.log(`Wrapped left: new index ${newIndex}`);
  }




  // Update current index and select the card
  data.currentIndex = newIndex;
  selectUgcVideoCard(newIndex, sectionId, true);




  setTimeout(() => {
    data.isTransitioning = false;
  }, 650);
}




function handleUgcVideoCardClick(cardElement, sectionId) {
  const data = window.ugcVideoData[sectionId];
  if (data.isTransitioning) return;




  const track = document.getElementById(`ugc-video-track-${sectionId}`);
  const cards = track.querySelectorAll('.ugc-video-card');
  const clickedIndex = Array.from(cards).indexOf(cardElement);




  if (clickedIndex === -1) return;




  if (clickedIndex === data.currentIndex) {
    // Center card clicked - redirect to link
    const redirectUrl = cardElement.getAttribute('data-redirect-url');
    if (redirectUrl) {
      window.open(redirectUrl, '_blank');
    }
  } else {
    // Side card clicked - calculate shortest path to center
    const originalBlocksCount = data.originalBlocksCount;
    const currentOriginalIndex = (data.currentIndex - originalBlocksCount + originalBlocksCount) % originalBlocksCount;
    const clickedOriginalIndex = parseInt(cardElement.getAttribute('data-index'));
   
    // Calculate shortest distance
    let distance = clickedOriginalIndex - currentOriginalIndex;
    if (distance > originalBlocksCount / 2) {
      distance -= originalBlocksCount;
    } else if (distance < -originalBlocksCount / 2) {
      distance += originalBlocksCount;
    }




    console.log(`Card clicked: original index ${clickedOriginalIndex}, distance: ${distance}`);




    // Move step by step for smooth animation
    data.isTransitioning = true;


    // Remove centered class from all cards during transition
    const cards = track.querySelectorAll('.ugc-video-card');
    cards.forEach(card => {
      card.classList.remove('centered');
    });
   
    if (distance !== 0) {
      const direction = distance > 0 ? 1 : -1;
      const steps = Math.abs(distance);
     
      for (let i = 0; i < steps; i++) {
        setTimeout(() => {
          const newIndex = data.currentIndex + direction;
          selectUgcVideoCard(newIndex, sectionId, true);
          data.currentIndex = newIndex;
         
          if (i === steps - 1) {
            setTimeout(() => {
              data.isTransitioning = false;
            }, 650);
          }
        }, i * 150);
      }
    } else {
      data.isTransitioning = false;
    }
  }
}




function redirectToProduct(button) {
  const productUrl = button.dataset.productUrl;
  if (productUrl) {
    window.open(productUrl, '_blank');
  }
}




// Initialize
document.addEventListener('DOMContentLoaded', function() {
  initializeUgcVideo('{{ section.id }}');
});
</script>
