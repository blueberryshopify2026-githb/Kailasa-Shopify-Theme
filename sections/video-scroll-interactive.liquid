{% comment %}
  Video Scroll Interactive Section
  Left: Auto-playing videos that change on scroll
  Right: Text content with vertical progress bar and scroll activation
{% endcomment %}

<section class="video-scroll-section" id="videoScrollSection">
  <div class="video-scroll-container">
    <!-- Left 50% - Video/Image Area -->
    <div class="video-area">
      {% for block in section.blocks %}
        {% if block.type == 'video_text_item' %}
          <div
            class="video-item"
            data-index="{{ forloop.index0 }}"
            style="display: {% if forloop.first %}block{% else %}none{% endif %};"
            {{ block.shopify_attributes }}
          >
            <div class="media-container-vsi">
              {% if block.settings.video_file %}
                <video
                  class="section-video"
                  autoplay
                  muted
                  loop
                  playsinline
                >
                  <source src="{{ block.settings.video_file | asset_url }}" type="video/mp4">
                  Your browser does not support the video tag.
                </video>
              {% elsif block.settings.image_file %}
                <img
                  src="{{ block.settings.image_file | image_url: width: 600 }}"
                  alt="{{ block.settings.text_title }}"
                  class="section-image"
                  width="600"
                  height="400"
                >
              {% else %}
                <div class="media-placeholder-vsi">
                  <p>Upload video or image</p>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Right 50% - Text Content with Progress Bar -->
    <div class="content-area-vsi">
      <!-- Vertical Progress Bar -->
      <div class="progress-bar-container">
        <div class="progress-bar" id="progressBar"></div>
      </div>

      <!-- Text Items -->
      <div class="text-items-container">
        {% for block in section.blocks %}
          {% if block.type == 'video_text_item' %}
            <div
              class="text-item {% if forloop.first %}active{% endif %}"
              data-index="{{ forloop.index0 }}"
              style="
                padding: {{ section.settings.text_padding | default: 30 }}px;
                margin-bottom: {{ section.settings.text_margin_bottom | default: 20 }}px;
                border-radius: {{ section.settings.text_border_radius | default: 12 }}px;
                border: {{ section.settings.text_border_width | default: 2 }}px solid transparent;
                transition: all 0.3s ease;
              "
              {{ block.shopify_attributes }}
            >
              <h3
                class="text-title"
                style="
                  color: {{ section.settings.title_color | default: '#000000' }};
                  font-size: {{ section.settings.title_size | default: 24 }}px;
                  font-weight: {{ section.settings.title_weight | default: 600 }};
                  margin-bottom: {{ section.settings.title_margin_bottom | default: 15 }}px;
                  font-family: 'Montserrat', sans-serif;
                "
              >
                {{
                  block.settings.text_title
                  | default: 'Designed to give your body the nutrients it needs to feel well and live well.'
                }}
              </h3>

              {% if block.settings.text_description %}
                <p
                  class="text-description"
                  style="
                    color: {{ section.settings.description_color | default: '#666666' }};
                    font-size: {{ section.settings.description_size | default: 16 }}px;
                    line-height: {{ section.settings.description_line_height | default: 1.5 }};
                    margin: 0;
                    font-family: 'Montserrat', sans-serif;
                  "
                >
                  {{ block.settings.text_description }}
                </p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap');

  .video-scroll-section {
    width: 100%;
    height: 100vh;
    overflow: hidden;
    position: relative;
    font-family: 'Montserrat', sans-serif;
  }

  .video-scroll-container {
    display: grid;
    grid-template-columns: 50% 50%;
    height: 100vh;
    width: 100%;
  }

  /* Video Area */
  .video-area {
    position: relative;
    overflow: hidden;
    background: {{ section.settings.video_area_bg | default: '#f8f8f8' }};
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.video_area_padding | default: 60 }}px;
  }

  .video-item {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
    max-width: 500px;
    height: auto;
  }

  .media-container-vsi {
    width: 100%;
    height: {{ section.settings.media_height | default: 400 }}px;
    border-radius: {{ section.settings.media_border_radius | default: 20 }}px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    background: #fff;
  }

  .section-video,
  .section-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .media-placeholder-vsi {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f0f0f0;
    color: #666;
    font-size: 18px;
    font-family: 'Montserrat', sans-serif;
  }

  /* Content Area */
  .content-area-vsi {
    position: relative;
    display: flex;
    align-items: center;
    padding: 40px;
    background: {{ section.settings.content_bg_color | default: '#ffffff' }};
     
  }

  /* Progress Bar */
  .progress-bar-container {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 200px;
    background: #e0e0e0;
    border-radius: 2px;
  }

  .progress-bar {
    width: 100%;
    height: 0%;
    background: {{ section.settings.progress_bar_color | default: '#00bcd4' }};
    border-radius: 2px;
    transition: height 0.3s ease;
  }

  /* Text Items */
  .text-items-container {
    flex: 1;
    max-width: 500px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: {{ section.settings.media_height | default: 400 }}px;
     
  }

  .text-item {
    opacity: 0.4;
    transition: all 0.5s ease;
  }

  .text-item.active {
    opacity: 1;
    background-color: {{ section.settings.active_bg_color | default: '#d3ffff' }};
    border-color: {{ section.settings.active_border_color | default: '#00bcd4' }} !important;
  }

  .text-item.active:hover {
    border-color: {{ section.settings.hover_border_color | default: '#00bcd4' }} !important;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .video-scroll-container {
      grid-template-columns: 1fr;
      grid-template-rows: 50% 50%;
    }

    .video-area {
      padding: 30px;
    }

    .video-item {
      width: 90%;
    }

    .content-area-vsi {
      padding: 30px 20px;
    }

    .progress-bar-container {
      right: 10px;
      height: 150px;
    }

    .text-item {
      padding: 20px !important;
      margin-bottom: 15px !important;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.getElementById('videoScrollSection');
    const textItemsContainer = section.querySelector('.text-items-container');
    const textItems = section.querySelectorAll('.text-item');
    const videoItems = section.querySelectorAll('.video-item');
    const progressBar = document.getElementById('progressBar');

    let currentIndex = 0;
    let isScrolling = false;

    // Initialize
    updateActiveStates(0);

    // Scroll event handler - only on text items container
    textItemsContainer.addEventListener('wheel', function (e) {
      // Only prevent default if we're actually handling the scroll within the container
      const isScrollingDown = e.deltaY > 0;
      const isScrollingUp = e.deltaY < 0;
      
      // Allow natural scroll to next/previous sections
      if (isScrollingDown && currentIndex >= textItems.length - 1) {
        // At last item, scrolling down - allow natural page scroll to next section
        return;
      }
      
      if (isScrollingUp && currentIndex <= 0) {
        // At first item, scrolling up - allow natural page scroll to previous section
        return;
      }
      
      // Only prevent default if we're handling the scroll within the container
      e.preventDefault();

      if (isScrolling) return;
      isScrolling = true;

      if (isScrollingDown) {
        // Scroll down within container
        if (currentIndex < textItems.length - 1) {
          currentIndex++;
          updateActiveStates(currentIndex);
        }
      } else {
        // Scroll up within container
        if (currentIndex > 0) {
          currentIndex--;
          updateActiveStates(currentIndex);
        }
      }

      setTimeout(() => {
        isScrolling = false;
      }, 300); // Reduced timeout for better responsiveness
    });

    // Touch events for mobile - only on text items container
    let touchStartY = 0;
    textItemsContainer.addEventListener('touchstart', function (e) {
      touchStartY = e.touches[0].clientY;
    });

    textItemsContainer.addEventListener('touchend', function (e) {
      if (isScrolling) return;

      const touchEndY = e.changedTouches[0].clientY;
      const diff = touchStartY - touchEndY;

      if (Math.abs(diff) > 50) {
        const isSwipeDown = diff > 0;
        const isSwipeUp = diff < 0;
        
        // Allow natural scroll to next/previous sections
        if (isSwipeDown && currentIndex >= textItems.length - 1) {
          // At last item, swiping down - allow natural page scroll
          return;
        }
        
        if (isSwipeUp && currentIndex <= 0) {
          // At first item, swiping up - allow natural page scroll
          return;
        }
        
        isScrolling = true;

        if (isSwipeDown) {
          // Swipe down
          if (currentIndex < textItems.length - 1) {
            currentIndex++;
            updateActiveStates(currentIndex);
          }
        } else {
          // Swipe up
          if (currentIndex > 0) {
            currentIndex--;
            updateActiveStates(currentIndex);
          }
        }

        setTimeout(() => {
          isScrolling = false;
        }, 300);
      }
    });

    // Click events for text items
    textItems.forEach((item, index) => {
      item.addEventListener('click', function () {
        if (currentIndex !== index) {
          currentIndex = index;
          updateActiveStates(currentIndex);
        }
      });
    });

    function updateActiveStates(index) {
      // Update text items
      textItems.forEach((item, i) => {
        if (i === index) {
          item.classList.add('active');
        } else {
          item.classList.remove('active');
        }
      });

      // Update videos
      videoItems.forEach((video, i) => {
        if (i === index) {
          video.style.display = 'block';
          const videoElement = video.querySelector('video');
          if (videoElement) {
            videoElement.play();
          }
        } else {
          video.style.display = 'none';
          const videoElement = video.querySelector('video');
          if (videoElement) {
            videoElement.pause();
          }
        }
      });

      // Update progress bar
      const progress = ((index + 1) / textItems.length) * 100;
      progressBar.style.height = progress + '%';
    }
  });
</script>

