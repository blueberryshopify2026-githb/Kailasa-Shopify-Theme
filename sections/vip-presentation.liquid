{% comment %}
  VIP Presentation Section - 50:50 split with sliding blocks
  Features: Multiple content blocks with sliding animations, arrow navigation, camera reel effect
{% endcomment %}

<style>

.vip-presentation-section {
  font-family: 'Montserrat', sans-serif;
  background: {{ section.settings.section_bg_color | default: '#ffffff' }};
  padding: 20px 0;
  overflow: hidden;
  height: 100vh;
  max-height: 100vh;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

  .vip-presentation-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 10px 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: stretch;
    width: 100%;
    box-sizing: border-box;
    height: calc(100vh - 40px);
    max-height: calc(100vh - 40px);
  }

  /* Left Content */
  .vip-presentation-left {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: relative;
    padding: 0;
    justify-content: space-between;
    height: 100%;
  }

  .vip-presentation-content {
    position: relative;
    overflow: hidden;
    flex: 1;
    max-height: 450px;
  }

  .vip-presentation-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.4s ease-in-out;
    overflow: hidden;
    z-index: 1;
  }

  .vip-presentation-slide.active {
    opacity: 1;
    position: absolute;
    z-index: 2;
  }

  .vip-presentation-heading {
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: 800;
    color: {{ section.settings.heading_color | default: '#000000' }};
    line-height: 1.2;
    margin: 0 0 20px 0;
    font-family: 'Montserrat', sans-serif;
  }

  .vip-presentation-key-points {
    font-size: {{ section.settings.key_points_font_size }}px;
    color: {{ section.settings.key_points_color | default: '#333333' }};
    line-height: 1.6;
    margin: 0;
    font-family: 'Montserrat', sans-serif;
  }

  .vip-presentation-key-points ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .vip-presentation-key-points li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 15px;
  }

  .vip-presentation-key-points li:before {
    content: '•';
    position: absolute;
    left: 0;
    color: {{ section.settings.bullet_color | default: '#000000' }};
    font-weight: bold;
    font-size: 1.2em;
  }

  .vip-presentation-navigation {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 5px;
    margin-top: 15px;
    width: 100%;
  }

  .vip-presentation-arrow {
    width: auto;
    height: auto;
    background: none;
    border: none;
    outline: none;
    box-shadow: none;
    border-radius: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    flex-shrink: 0;
    position: relative;
    padding: 0;
    margin: 0;
  }

  .vip-presentation-arrow:hover {
    transform: scale(1.05);
  }

  .vip-presentation-arrow img {
    width: 180px;
    height: 180px;
    object-fit: contain;
    display: block;
  }

  .vip-presentation-preview-container {
    position: relative;
    width: calc(70% - 10px);
    height: 180px;
    overflow: hidden;
    border-radius: {{ section.settings.preview_border_radius }}px;
    margin-left: auto;
  }

  .vip-presentation-preview-track {
    display: flex;
    height: 100%;
    will-change: transform;
  }

  .vip-presentation-preview {
    width: calc(100% / {{ section.blocks.size | times: 10 }});
    height: 180px;
    border-radius: {{ section.settings.preview_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
    filter: grayscale(100%);
    opacity: 0.8;
    position: relative;
    flex-shrink: 0;
  }

  .vip-presentation-preview.active {
    filter: grayscale(100%);
    opacity: 1;
  }

  .vip-presentation-preview:hover {
    filter: grayscale(100%);
    opacity: 0.9;
    transform: scale(1.02);
  }

  .vip-presentation-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vip-presentation-right {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: stretch;
    height: 100%;
    overflow: hidden;
  }

  .vip-presentation-main-image-container {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 500px;
    border-radius: {{ section.settings.main_image_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  }

  .vip-presentation-main-track {
    display: flex;
    height: 100%;
    will-change: transform;
  }

  .vip-presentation-main-image {
    width: calc(100% / {{ section.blocks.size | times: 10 }});
    height: 100%;
    flex-shrink: 0;
    position: relative;
  }

  .vip-presentation-main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vip-presentation-main-cta {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    background: #000000;
    color: #ffffff;
    padding: 12px 24px;
    border-radius: 25px;
    font-size: 14px;
    font-weight: 600;
    font-family: 'Montserrat', sans-serif;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
    z-index: 10;
    text-decoration: none;
  }

  .vip-presentation-main-cta:hover {
    background: #333333;
    transform: translateX(-50%) scale(1.05);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .vip-presentation-container {
      grid-template-columns: 1fr;
      gap: 60px;
      padding: 40px 40px;
      align-items: flex-start;
    }

    .vip-presentation-section {
      padding: 60px 0;
      height: auto;
      min-height: auto;
    }

    .vip-presentation-left {
      justify-content: flex-start;
    }

    .vip-presentation-content {
      min-height: auto;
    }

    .vip-presentation-slide {
      min-height: auto;
    }

    .vip-presentation-main-image-container {
      height: 400px;
      max-height: 400px;
    }

    .vip-presentation-main-cta {
      bottom: 20px;
    }
  }

  @media (max-width: 768px) {
    .vip-presentation-container {
      padding: 20px;
      gap: 40px;
    }

    .vip-presentation-heading {
      font-size: {{ section.settings.heading_font_size | minus: 8 }}px;
    }

    .vip-presentation-key-points {
      font-size: {{ section.settings.key_points_font_size | minus: 2 }}px;
    }

    .vip-presentation-content {
      min-height: auto;
    }

    .vip-presentation-slide {
      min-height: auto;
    }

    .vip-presentation-navigation {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }

    .vip-presentation-preview-container {
      width: 200px;
      height: 120px;
    }

    .vip-presentation-preview {
      height: 120px;
    }

    .vip-presentation-arrow {
      width: 120px;
      height: 90px;
    }

    .vip-presentation-arrow img {
      width: 120px;
      height: 90px;
    }

    .vip-presentation-main-cta {
      bottom: 15px;
      padding: 10px 20px;
      font-size: 12px;
    }
  }
</style>

<section class="vip-presentation-section">
  <div class="vip-presentation-container">
    <!-- Left Content -->
    <div class="vip-presentation-left">
      <div class="vip-presentation-content">
        {% for block in section.blocks %}
          {% if block.type == 'vip_slide' %}
            <div class="vip-presentation-slide {% if forloop.first %}active{% endif %}" 
                 data-block-id="{{ forloop.index0 }}"
                 {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h2 class="vip-presentation-heading">{{ block.settings.heading }}</h2>
              {% endif %}

              {% if block.settings.key_points != blank %}
                <div class="vip-presentation-key-points">
                  {{ block.settings.key_points }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="vip-presentation-navigation">
        {% if section.settings.arrow_icon %}
          <div class="vip-presentation-arrow" onclick="changeSlide('{{ section.id }}')">
            <img src="{{ section.settings.arrow_icon | image_url }}" 
                 alt="Arrow Icon"
                 width="180"
                 height="180">
          </div>
        {% endif %}

        <div class="vip-presentation-preview-container">
          <div class="vip-presentation-preview-track" id="preview-track-{{ section.id }}" style="width: calc(100% * {{ section.blocks.size | times: 10 }});">
            {% comment %} Create multiple clone sets for seamless infinite right sliding {% endcomment %}
            {% for clone_set in (1..10) %}
              {% for block in section.blocks %}
                {% if block.type == 'vip_slide' and block.settings.preview_image %}
                  <div class="vip-presentation-preview {% if clone_set == 1 and forloop.first %}active{% endif %}" 
                       data-block-id="{{ forloop.index0 }}"
                       data-clone-set="{{ clone_set }}"
                       onclick="goToSlide('{{ section.id }}', {{ forloop.index0 }})">
                    <img src="{{ block.settings.preview_image | image_url: width: 600 }}" 
                         alt="{{ block.settings.heading | strip_html }}"
                         width="600"
                         height="400"
                         loading="lazy">
                  </div>
                {% endif %}
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

    <!-- Right Image -->
    <div class="vip-presentation-right">
      <div class="vip-presentation-main-image-container">
        <div class="vip-presentation-main-track" id="main-track-{{ section.id }}" style="width: calc(100% * {{ section.blocks.size | times: 10 }});">
          {% comment %} Create multiple clone sets for seamless infinite right sliding {% endcomment %}
          {% for clone_set in (1..10) %}
            {% for block in section.blocks %}
              {% if block.type == 'vip_slide' and block.settings.main_image %}
                <div class="vip-presentation-main-image" 
                     data-block-id="{{ forloop.index0 }}"
                     data-clone-set="{{ clone_set }}">
                  <img src="{{ block.settings.main_image | image_url: width: 800 }}" 
                       alt="{{ block.settings.heading | strip_html }}"
                       width="800"
                       height="800"
                       loading="lazy">
                </div>
              {% endif %}
            {% endfor %}
          {% endfor %}
        </div>
        
        <!-- Fixed CTA Button inside image container -->
        {% for block in section.blocks %}
          {% if forloop.first %}
            {% if block.settings.main_cta_text != blank %}
              <a href="{{ block.settings.main_cta_link }}" class="vip-presentation-main-cta" id="main-cta-{{ section.id }}">
                {{ block.settings.main_cta_text }}
              </a>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<script>
let sliderState = {};

function initializeSlider(sectionId) {
  const totalSlides = document.querySelectorAll('.vip-presentation-slide').length;
  
  sliderState[sectionId] = {
    currentSlide: 0,
    totalSlides: totalSlides,
    currentPosition: 0, // Track current position in the cloned track
    isAnimating: false,
    totalClones: 10 // Number of clone sets we created
  };
  
  // Set initial position - start from a middle clone set to allow movement in both directions
  const previewTrack = document.getElementById(`preview-track-${sectionId}`);
  const mainTrack = document.getElementById(`main-track-${sectionId}`);
  
  if (previewTrack && mainTrack) {
    // DISABLE transitions first to prevent initial animation
    previewTrack.style.transition = 'none';
    mainTrack.style.transition = 'none';
    
    // Start from the 5th clone set (middle) to allow for right movement
    const startPosition = 5 * totalSlides;
    sliderState[sectionId].currentPosition = startPosition;
    
    const slideWidth = 100 / (totalSlides * sliderState[sectionId].totalClones);
    const initialTransform = -(startPosition * slideWidth);
    
    // Set initial position WITHOUT animation
    previewTrack.style.transform = `translateX(${initialTransform}%)`;
    mainTrack.style.transform = `translateX(${initialTransform}%)`;
    
    // Force reflow to ensure the position is applied
    previewTrack.offsetHeight;
    mainTrack.offsetHeight;
    
    // Re-enable transitions after a short delay
    setTimeout(() => {
      previewTrack.style.transition = 'transform 1.2s cubic-bezier(0.4, 0, 0.2, 1)';
      mainTrack.style.transition = 'transform 1.2s cubic-bezier(0.4, 0, 0.2, 1)';
    }, 100);
  }
  
  updateSlider(sectionId);
}

function changeSlide(sectionId) {
  if (sliderState[sectionId].isAnimating) return;
  
  const state = sliderState[sectionId];
  const previewTrack = document.getElementById(`preview-track-${sectionId}`);
  const mainTrack = document.getElementById(`main-track-${sectionId}`);
  
  if (!previewTrack || !mainTrack) return;
  
  state.isAnimating = true;
  
  // Move to next slide
  state.currentSlide = (state.currentSlide + 1) % state.totalSlides;
  state.currentPosition = state.currentPosition - 1; // Move backwards in the track (right direction)
  
  // Calculate slide width as percentage
  const slideWidth = 100 / (state.totalSlides * state.totalClones);
  const newPosition = -(state.currentPosition * slideWidth); // This will be more positive (moving right)
  
  // Apply smooth transition
  previewTrack.style.transition = 'transform 1.2s cubic-bezier(0.4, 0, 0.2, 1)';
  mainTrack.style.transition = 'transform 1.2s cubic-bezier(0.4, 0, 0.2, 1)';
  
  previewTrack.style.transform = `translateX(${newPosition}%)`;
  mainTrack.style.transform = `translateX(${newPosition}%)`;
  
  // Update text content immediately
  updateSlider(sectionId);
  
  // Check if we need to reset position for infinite loop
  setTimeout(() => {
    // If we're getting too close to the beginning, jump to a later clone set
    if (state.currentPosition <= state.totalSlides) {
      // Reset to later position without animation
      const resetPosition = state.currentPosition + (state.totalSlides * 5); // Jump forward 5 clone sets
      state.currentPosition = resetPosition;
      
      previewTrack.style.transition = 'none';
      mainTrack.style.transition = 'none';
      
      const resetTransform = -(resetPosition * slideWidth);
      previewTrack.style.transform = `translateX(${resetTransform}%)`;
      mainTrack.style.transform = `translateX(${resetTransform}%)`;
      
      // Force reflow
      previewTrack.offsetHeight;
      mainTrack.offsetHeight;
      
      // Re-enable transitions
      setTimeout(() => {
        previewTrack.style.transition = 'transform 1.2s cubic-bezier(0.4, 0, 0.2, 1)';
        mainTrack.style.transition = 'transform 1.2s cubic-bezier(0.4, 0, 0.2, 1)';
      }, 50);
    }
    
    state.isAnimating = false;
  }, 1200);
}

function goToSlide(sectionId, slideIndex) {
  if (sliderState[sectionId].isAnimating) return;
  
  const state = sliderState[sectionId];
  
  // Find the closest instance of the target slide
  const currentCloneSet = Math.floor(state.currentPosition / state.totalSlides);
  const targetPosition = (currentCloneSet * state.totalSlides) + slideIndex;
  
  state.currentSlide = slideIndex;
  state.currentPosition = targetPosition;
  state.isAnimating = true;
  
  const previewTrack = document.getElementById(`preview-track-${sectionId}`);
  const mainTrack = document.getElementById(`main-track-${sectionId}`);
  
  if (previewTrack && mainTrack) {
    const slideWidth = 100 / (state.totalSlides * state.totalClones);
    const newPosition = -(targetPosition * slideWidth);
    
    previewTrack.style.transform = `translateX(${newPosition}%)`;
    mainTrack.style.transform = `translateX(${newPosition}%)`;
  }
  
  updateSlider(sectionId);
  
  setTimeout(() => {
    state.isAnimating = false;
  }, 1200);
}

function updateSlider(sectionId) {
  const state = sliderState[sectionId];
  
  // Get all content slides
  const contentSlides = document.querySelectorAll('.vip-presentation-slide');
  const currentActiveSlide = document.querySelector('.vip-presentation-slide.active');
  const targetSlide = contentSlides[state.currentSlide];
  
  if (currentActiveSlide && targetSlide && currentActiveSlide !== targetSlide) {
    // Step 1: EXIT - Remove active class from current slide (fade out)
    currentActiveSlide.classList.remove('active');
    
    // Step 2: ENTER - Very short delay to avoid overlap but minimize blank time
    setTimeout(() => {
      targetSlide.classList.add('active');
    }, 50); // Minimal delay - just enough to avoid overlap
  } else if (targetSlide && !currentActiveSlide) {
    // First load case - no delay needed
    targetSlide.classList.add('active');
  }
  
  // Update active states for preview images
  updateActiveStates(sectionId);
}

function updateActiveStates(sectionId) {
  const state = sliderState[sectionId];
  
  // Update preview active state
  const previewImages = document.querySelectorAll('.vip-presentation-preview');
  previewImages.forEach((preview, index) => {
    const blockId = parseInt(preview.getAttribute('data-block-id'));
    if (blockId !== null && !isNaN(blockId)) {
      preview.classList.toggle('active', blockId === state.currentSlide);
    }
  });
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
  const sections = document.querySelectorAll('.vip-presentation-section');
  sections.forEach(section => {
    const sectionId = section.querySelector('[id*="preview-track-"]')?.id.replace('preview-track-', '');
    if (sectionId) {
      initializeSlider(sectionId);
    }
  });
});
</script>

{% schema %}
{
  "name": "VIP Presentation",
  "tag": "section",
  "class": "vip-presentation-section",
  "settings": [
    {
      "type": "header",
