{% comment %}
  VIP Presentation Section
  Layout: 50/50 grid — left has text + navigation (arrow + preview), right has main image
  Animation: slides enter from right, exit to left. Always rightward. Infinite loop.
{% endcomment %}


<style>
  #vip-{{ section.id }} {
    font-family: 'Montserrat', sans-serif;
    background: {{ section.settings.section_bg_color | default: '#ffffff' }};
    box-sizing: border-box;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: center;
    padding: 20px 0;
  }


  #vip-{{ section.id }} .vip-container {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 40px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    height: calc(100vh - 40px);
  }


  /* ─── LEFT COLUMN ─── */
  #vip-{{ section.id }} .vip-left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    overflow: hidden;
  }


  /* text area */
  #vip-{{ section.id }} .vip-text-area {
    position: relative;
    flex: 1;
    overflow: hidden;
    max-height: 450px;
  }


  #vip-{{ section.id }} .vip-text-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
    overflow: hidden;
  }
  #vip-{{ section.id }} .vip-text-slide.active { opacity: 1; }


  #vip-{{ section.id }} .vip-heading {
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: 800;
    color: {{ section.settings.heading_color | default: '#000000' }};
    line-height: 1.2;
    margin: 0 0 20px;
    font-family: 'Montserrat', sans-serif;
  }


  #vip-{{ section.id }} .vip-key-points {
    font-size: {{ section.settings.key_points_font_size }}px;
    color: {{ section.settings.key_points_color | default: '#333333' }};
    line-height: 1.6;
    font-family: 'Montserrat', sans-serif;
  }
  #vip-{{ section.id }} .vip-key-points ul { list-style: none; padding: 0; margin: 0; }
  #vip-{{ section.id }} .vip-key-points li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 8px;
  }
  #vip-{{ section.id }} .vip-key-points li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: {{ section.settings.bullet_color | default: '#000000' }};
    font-weight: bold;
    font-size: 1.2em;
  }


  /* navigation row */
  #vip-{{ section.id }} .vip-nav {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    margin-top: 15px;
  }


  /* arrow sits beside preview image — NOT overlaid */
  #vip-{{ section.id }} .vip-arrow {
    flex-shrink: 0;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    line-height: 0;
    transition: transform 0.3s ease;
  }
  #vip-{{ section.id }} .vip-arrow:hover { transform: scale(1.05); }
  #vip-{{ section.id }} .vip-arrow img {
    width: 150px;
    height: 150px;
    object-fit: contain;
    display: block;
  }


  /* preview image box — fills remaining nav row width */
  #vip-{{ section.id }} .vip-preview-box {
    position: relative;
    flex: 1;
    height: 180px;
    overflow: hidden;
    border-radius: {{ section.settings.preview_border_radius }}px;
  }


  /* ─── SLIDE ANIMATION (shared by preview + main) ─── */
  /* default: waiting off-screen to the LEFT */
  #vip-{{ section.id }} .vip-img-slide {
    position: absolute;
    inset: 0;
    overflow: hidden;
    transform: translateX(-100%);
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }
  #vip-{{ section.id }} .vip-img-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* visible */
  #vip-{{ section.id }} .vip-img-slide.active {
    transform: translateX(0);
  }
  /* exiting: pushed off-screen to the RIGHT */
  #vip-{{ section.id }} .vip-img-slide.exit {
    transform: translateX(100%);
  }
  /* grayscale only for preview */
  #vip-{{ section.id }} .vip-preview-box .vip-img-slide {
    filter: grayscale(100%);
    cursor: pointer;
  }


  /* ─── RIGHT COLUMN ─── */
  #vip-{{ section.id }} .vip-right {
    height: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.main_image_border_radius }}px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    position: relative;
  }


  /* CTA button */
  #vip-{{ section.id }} .vip-cta {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    background: #000;
    color: #fff;
    padding: 12px 24px;
    border-radius: 25px;
    font-size: 14px;
    font-weight: 600;
    font-family: 'Montserrat', sans-serif;
    white-space: nowrap;
    z-index: 10;
    text-decoration: none;
    transition: background 0.3s ease, transform 0.3s ease;
  }
  #vip-{{ section.id }} .vip-cta:hover {
    background: #333;
    transform: translateX(-50%) scale(1.05);
  }


  /* ─── RESPONSIVE ─── */
  @media (max-width: 1024px) {
    #vip-{{ section.id }} {
      height: auto;
      padding: 60px 0;
    }
    #vip-{{ section.id }} .vip-container {
      grid-template-columns: 1fr;
      height: auto;
      gap: 40px;
    }
    #vip-{{ section.id }} .vip-left {
      height: auto;
    }
    #vip-{{ section.id }} .vip-text-area {
      min-height: 200px;
    }
    #vip-{{ section.id }} .vip-right {
      height: 400px;
    }
    #vip-{{ section.id }} .vip-cta { bottom: 20px; }
  }


  /* ─── TABLET ONLY: 769px – 1024px ─── */
  /* Keeps the desktop two-column layout, scaled and optimised for tablet */
  @media (min-width: 769px) and (max-width: 1024px) {


    /* Section: full viewport height, same as desktop */
    #vip-{{ section.id }} {
      height: auto !important;
      padding: 40px 0 !important;
      overflow: visible !important;
    }


    /* Container: two equal columns, tighter padding */
    #vip-{{ section.id }} .vip-container {
      display: grid !important;
      grid-template-columns: 1fr 1fr !important;
      gap: 24px !important;
      padding: 0 24px !important;
      height: auto !important;
      max-width: 100% !important;
      align-items: end !important;
    }


    /* Left column */
    #vip-{{ section.id }} .vip-left {
      display: flex !important;
      flex-direction: column !important;
      justify-content: flex-end !important;
      height: auto !important;
      overflow: visible !important;
    }


    /* Text area */
    #vip-{{ section.id }} .vip-text-area {
      position: relative !important;
      flex: none !important;
      overflow: hidden !important;
      height: 300px !important;
      max-height: 300px !important;
      min-height: unset !important;
    }


    /* Text slides stay absolute — JS unchanged */
    #vip-{{ section.id }} .vip-text-slide {
      position: absolute !important;
      inset: 0 !important;
      display: block !important;
    }


    /* Scale heading and key points for tablet */
    #vip-{{ section.id }} .vip-heading {
      font-size: {{ section.settings.heading_font_size | minus: 12 }}px !important;
      margin: 0 0 14px !important;
    }


    #vip-{{ section.id }} .vip-key-points {
      font-size: {{ section.settings.key_points_font_size | minus: 2 }}px !important;
      line-height: 1.5 !important;
    }


    #vip-{{ section.id }} .vip-key-points li {
      margin-bottom: 10px !important;
    }


    /* Nav row: arrow left, preview right — same as desktop */
    #vip-{{ section.id }} .vip-nav {
      display: flex !important;
      align-items: center !important;
      gap: 10px !important;
      flex-shrink: 0 !important;
      margin-top: 12px !important;
      position: static !important;
    }


    /* Arrow: beside preview, not overlaid */
    #vip-{{ section.id }} .vip-arrow {
      position: static !important;
      flex-shrink: 0 !important;
    }
    #vip-{{ section.id }} .vip-arrow img {
      width: 80px !important;
      height: 80px !important;
    }


    /* Preview box: fills remaining row width */
    #vip-{{ section.id }} .vip-preview-box {
      position: relative !important;
      flex: 1 !important;
      width: auto !important;
      height: 150px !important;
      overflow: hidden !important;
      border-radius: {{ section.settings.preview_border_radius }}px !important;
    }


    /* Right column: main image */
    #vip-{{ section.id }} .vip-right {
      height: 500px !important;
      overflow: hidden !important;
      border-radius: {{ section.settings.main_image_border_radius }}px !important;
      box-shadow: 0 8px 30px rgba(0,0,0,0.1) !important;
      position: relative !important;
    }


    /* CTA button */
    #vip-{{ section.id }} .vip-cta {
      bottom: 28px !important;
      font-size: 13px !important;
      padding: 10px 22px !important;
    }
  }
  /* ─── END TABLET ─── */


  @media (max-width: 768px) {


    /* Section: auto height, scrollable */
    #vip-{{ section.id }} {
      height: auto;
      padding: 0;
      overflow: visible;
      align-items: flex-start;
    }


    /* Container: single flex column — reorders left/right without new HTML */
    #vip-{{ section.id }} .vip-container {
      display: flex;
      flex-direction: column;
      grid-template-columns: unset;
      gap: 0;
      padding: 0;
      height: auto;
      max-width: 100%;
    }


    /* ── 1. Main image — top, full width with padding, rounded corners ── */
    #vip-{{ section.id }} .vip-right {
      order: 1;
      width: calc(100% - 32px);
      margin: 16px 16px 0;
      height: 70vw;
      max-height: 420px;
      min-height: 220px;
      border-radius: 16px;
      box-shadow: none;
      position: relative;
      overflow: hidden;
    }


    /* CTA stays overlaid at bottom of main image */
    #vip-{{ section.id }} .vip-cta {
      bottom: 16px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 13px;
      padding: 10px 22px;
    }
    #vip-{{ section.id }} .vip-cta:hover {
      transform: translateX(-50%) scale(1.05);
    }


    /* ── 2. Left column: heading + key points, then nav row ── */
    #vip-{{ section.id }} .vip-left {
      order: 2;
      height: auto;
      overflow: visible;
      padding: 20px 16px 0;
      gap: 0;
      justify-content: flex-start;
    }


    /* Text area: auto height driven by content — slides stack in flow */
    #vip-{{ section.id }} .vip-text-area {
      position: relative;
      flex: none;
      max-height: none;
      min-height: unset;
      height: auto;
    }


    /* Text slides: relative positioning on mobile so content flows naturally */
    #vip-{{ section.id }} .vip-text-slide {
      position: relative;
      inset: unset;
      display: none;
    }
    #vip-{{ section.id }} .vip-text-slide.active {
      display: block;
      opacity: 1;
    }


    #vip-{{ section.id }} .vip-heading {
      font-size: {{ section.settings.heading_font_size | minus: 10 }}px;
      margin-bottom: 12px;
    }


    #vip-{{ section.id }} .vip-key-points {
      font-size: {{ section.settings.key_points_font_size | minus: 2 }}px;
    }


    /* ── 3. Nav: preview full width, arrow overlaid bottom-left ── */
    #vip-{{ section.id }} .vip-nav {
      display: block;
      position: relative;
      margin-top: 16px;
      padding-bottom: 24px;
    }


    #vip-{{ section.id }} .vip-preview-box {
      width: 100%;
      flex: none;
      height: 160px;
      min-height: 120px;
      border-radius: {{ section.settings.preview_border_radius }}px;
    }


    /* Arrow: absolutely overlaid at bottom-left of preview */
    #vip-{{ section.id }} .vip-arrow {
      position: absolute;
      bottom: 40px;
      left: 16px;
      z-index: 10;
      flex-shrink: unset;
    }
    #vip-{{ section.id }} .vip-arrow img {
      width: 60px;
      height: 60px;
    }
  }
</style>


<div id="vip-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="vip-container">


    <!-- LEFT: text + navigation -->
    <div class="vip-left">


      <!-- Text slides -->
      <div class="vip-text-area">
        {% for block in section.blocks %}
          {% if block.type == 'vip_slide' %}
            <div class="vip-text-slide {% if forloop.first %}active{% endif %}"
                 data-index="{{ forloop.index0 }}"
                 {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h2 class="vip-heading">{{ block.settings.heading }}</h2>
              {% endif %}
              {% if block.settings.key_points != blank %}
                <div class="vip-key-points">{{ block.settings.key_points }}</div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>


      <!-- Arrow beside preview — desktop layout -->
      <div class="vip-nav">
        {% if section.settings.arrow_icon %}
          <button class="vip-arrow" onclick="vipNext('{{ section.id }}')" aria-label="Next slide">
            <img src="{{ section.settings.arrow_icon | image_url }}" alt="" width="100" height="100">
          </button>
        {% endif %}


        <div class="vip-preview-box">
          {% for block in section.blocks %}
            {% if block.type == 'vip_slide' %}
              <div class="vip-img-slide {% if forloop.first %}active{% endif %}"
                   data-index="{{ forloop.index0 }}"
                   onclick="vipGoTo('{{ section.id }}', {{ forloop.index0 }})">
                {% if block.settings.preview_image %}
                  <img src="{{ block.settings.preview_image | image_url: width: 600 }}"
                       alt="{{ block.settings.heading | strip_html }}"
                       width="600" height="400" loading="lazy">
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>


    </div><!-- /vip-left -->


    <!-- RIGHT: main image -->
    <div class="vip-right">
      {% for block in section.blocks %}
        {% if block.type == 'vip_slide' %}
          <div class="vip-img-slide {% if forloop.first %}active{% endif %}"
               data-index="{{ forloop.index0 }}">
            {% if block.settings.main_image %}
              <img src="{{ block.settings.main_image | image_url: width: 800 }}"
                   alt="{{ block.settings.heading | strip_html }}"
                   width="800" height="800" loading="lazy">
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}


      {% for block in section.blocks %}
        {% if forloop.first and block.settings.main_cta_text != blank %}
          <a href="{{ block.settings.main_cta_link }}" class="vip-cta">
            {{ block.settings.main_cta_text }}
          </a>
        {% endif %}
      {% endfor %}
    </div><!-- /vip-right -->


  </div>
</div>


<script>
(function () {
  var _state = {};


  function getEls(id) {
    var root = document.getElementById('vip-' + id);
    if (!root) return null;
    return {
      text:    Array.from(root.querySelectorAll('.vip-text-area .vip-text-slide')),
      preview: Array.from(root.querySelectorAll('.vip-preview-box .vip-img-slide')),
      main:    Array.from(root.querySelectorAll('.vip-right .vip-img-slide'))
    };
  }


  function slideOut(el) {
    /* push outgoing slide to the RIGHT */
    el.classList.add('exit');
    el.classList.remove('active');
    setTimeout(function () {
      /* animation done — snap back off-screen LEFT without animating */
      el.classList.remove('exit');
      el.style.transition = 'none';
      el.style.transform  = 'translateX(-100%)';
      el.offsetWidth; /* reflow */
      el.style.transition = '';
      el.style.transform  = '';
    }, 720);
  }


  function slideIn(el) {
    /* ensure incoming slide starts from the LEFT before transitioning in */
    el.style.transition = 'none';
    el.style.transform  = 'translateX(-100%)';
    el.offsetWidth; /* reflow */
    el.style.transition = '';
    el.style.transform  = '';
    el.classList.add('active');
  }


  function goTo(id, to) {
    var st = _state[id];
    if (!st || st.busy || to === st.cur) return;
    st.busy = true;


    var els  = getEls(id);
    var from = st.cur;
    st.cur   = to;


    /* images: slide transition */
    slideOut(els.preview[from]);
    slideIn(els.preview[to]);


    slideOut(els.main[from]);
    slideIn(els.main[to]);


    /* text: crossfade */
    els.text[from].classList.remove('active');
    els.text[to].classList.add('active');


    setTimeout(function () { st.busy = false; }, 720);
  }


  window.vipNext = function (id) {
    var st = _state[id];
    if (!st) return;
    goTo(id, (st.cur + 1) % st.total);
  };


  window.vipGoTo = function (id, idx) {
    goTo(id, idx);
  };


  function init(id) {
    var els = getEls(id);
    if (!els) return;


    _state[id] = { cur: 0, total: els.text.length, busy: false };


    /* ensure clean starting state */
    function resetSlides(arr) {
      arr.forEach(function (el, i) {
        el.classList.remove('active', 'exit');
        el.style.transition = 'none';
        el.style.transform  = i === 0 ? 'translateX(0)' : 'translateX(-100%)';
        el.offsetWidth;
        el.style.transition = '';
        el.style.transform  = '';
        if (i === 0) el.classList.add('active');
      });
    }


    resetSlides(els.preview);
    resetSlides(els.main);
    els.text.forEach(function (el, i) {
      el.classList.toggle('active', i === 0);
    });
  }


  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-section-id]').forEach(function (el) {
      var id = el.getAttribute('data-section-id');
      if (id && el.id === 'vip-' + id) init(id);
    });
  });
})();
</script>


{% schema %}
{
  "name": "VIP Presentation",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 42
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "key_points_font_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Key Points Font Size",
      "default": 16
    },
    {
      "type": "color",
      "id": "key_points_color",
      "label": "Key Points Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "bullet_color",
      "label": "Bullet Point Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Arrow & Preview"
    },
    {
      "type": "image_picker",
      "id": "arrow_icon",
      "label": "Arrow Icon (SVG/Image)",
      "info": "Upload your custom arrow icon/SVG"
    },
    {
      "type": "color",
      "id": "arrow_bg_color",
      "label": "Arrow Background Color",
      "default": "#4FFFFF"
    },
    {
      "type": "color",
      "id": "arrow_hover_color",
      "label": "Arrow Hover Color",
      "default": "#3DEEEE"
    },
    {
      "type": "color",
      "id": "arrow_icon_color",
      "label": "Arrow Icon Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "preview_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Preview Image Border Radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "main_image_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Main Image Border Radius",
      "default": 20
    }
  ],
 "blocks": [
    {
      "type": "vip_slide",
      "name": "VIP Slide",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Skincare Elevated to an Elite Membership Experience"
        },
        {
          "type": "richtext",
          "id": "key_points",
          "label": "Key Points",
          "default": "<ul><li>Powerful ingredients that visibly reduce fine lines and wrinkles.</li><li>Restores elasticity and plumps skin from within</li><li>Protects against environmental aging and daily stressors.</li><li>Restores elasticity and plumps skin from within</li><li>Protects against environmental aging and daily stressors.</li></ul>"
        },
        {
          "type": "image_picker",
          "id": "preview_image",
          "label": "Preview Image (Grayscale)",
          "info": "Small preview image shown in the slider"
        },
        {
          "type": "text",
          "id": "preview_cta_text",
          "label": "Preview CTA Text",
          "default": "Become a Member"
        },
        {
          "type": "image_picker",
          "id": "main_image",
          "label": "Main Image",
          "info": "Large image shown on the right side"
        },
        {
          "type": "text",
          "id": "main_cta_text",
          "label": "Main CTA Text",
          "default": "Become a Member"
        },
        {
          "type": "url",
          "id": "main_cta_link",
          "label": "Main CTA Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VIP Presentation",
      "blocks": [
        { "type": "vip_slide" },
        { "type": "vip_slide" },
        { "type": "vip_slide" }
      ]
    }
  ]
}
{% endschema %}







