{% comment %}
  VIP Presentation Section - 50:50 split with sliding blocks
  Features: Multiple content blocks with sliding animations, arrow navigation, camera reel effect
{% endcomment %}

<style>
  .vip-presentation-section {
    font-family: 'Montserrat', sans-serif;
    background: {{ section.settings.section_bg_color | default: '#ffffff' }};
    padding: 40px 0;
    overflow: hidden;
    height: 100vh;
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  .vip-presentation-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 20px 60px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: flex-start;
    width: 100%;
    height: calc(100vh - 80px);
    box-sizing: border-box;
  }

  /* Left Content */
  .vip-presentation-left {
    display: flex;
    flex-direction: column;
    gap: 30px;
    position: relative;
    padding: 0;
    justify-content: flex-start;
    height: 100%;
    max-height: calc(100vh - 120px);
  }

  .vip-presentation-content {
    position: relative;
    overflow: hidden;
    flex: 1;
  }

  .vip-presentation-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    opacity: 0;
    transform: translateX(100%);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .vip-presentation-slide.active {
    opacity: 1;
    transform: translateX(0);
  }

  .vip-presentation-slide.prev {
    transform: translateX(-100%);
  }

  .vip-presentation-heading {
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: 800;
    color: {{ section.settings.heading_color | default: '#000000' }};
    line-height: 1.2;
    margin: 0 0 20px 0;
    font-family: 'Montserrat', sans-serif;
  }

  .vip-presentation-key-points {
    font-size: {{ section.settings.key_points_font_size }}px;
    color: {{ section.settings.key_points_color | default: '#333333' }};
    line-height: 1.6;
    margin: 0;
    font-family: 'Montserrat', sans-serif;
  }

  .vip-presentation-key-points ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .vip-presentation-key-points li {
    position: relative;
    padding-left: 20px;
    margin-bottom: 15px;
  }

  .vip-presentation-key-points li:before {
    content: '•';
    position: absolute;
    left: 0;
    color: {{ section.settings.bullet_color | default: '#000000' }};
    font-weight: bold;
    font-size: 1.2em;
  }

  .vip-presentation-navigation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-top: 20px;
    width: 100%;
  }

  .vip-presentation-arrows {
    display: flex;
    gap: 10px;
  }

  .vip-presentation-arrow {
    width: 50px;
    height: 50px;
    background: {{ section.settings.arrow_bg_color | default: '#4FFFFF' }};
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .vip-presentation-arrow:hover {
    background: {{ section.settings.arrow_hover_color | default: '#3DEEEE' }};
    transform: scale(1.1);
  }

  .vip-presentation-arrow svg {
    width: 20px;
    height: 20px;
    fill: {{ section.settings.arrow_icon_color | default: '#000000' }};
  }

  .vip-presentation-preview-container {
    position: relative;
    width: calc(70% - 30px);
    height: 160px;
    overflow: hidden;
    border-radius: {{ section.settings.preview_border_radius }}px;
    margin-left: auto;
  }

  .vip-presentation-preview-track {
    display: flex;
    width: calc(100% * {{ section.blocks.size }});
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .vip-presentation-preview {
    width: calc(100% / {{ section.blocks.size }});
    height: 160px;
    border-radius: {{ section.settings.preview_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
    filter: grayscale(100%);
    opacity: 0.8;
    position: relative;
    flex-shrink: 0;
  }

  .vip-presentation-preview.active {
    filter: grayscale(0%);
    opacity: 1;
  }

  .vip-presentation-preview:hover {
    filter: grayscale(70%);
    opacity: 0.9;
    transform: scale(1.02);
  }

  .vip-presentation-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vip-presentation-preview-cta {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: #000000;
    color: #ffffff;
    padding: 10px 20px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    font-family: 'Montserrat', sans-serif;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .vip-presentation-preview:hover .vip-presentation-preview-cta {
    background: #4fffff;
    transform: translateX(-50%) scale(1.05);
  }

  /* Right Image */
  .vip-presentation-right {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    height: 100%;
    overflow: hidden;
  }

  .vip-presentation-main-image-container {
    position: relative;
    width: 100%;
    height: calc(100vh - 60px);
    max-height: calc(100vh - 60px);
    border-radius: {{ section.settings.main_image_border_radius }}px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  }

  .vip-presentation-main-track {
    display: flex;
    width: calc(100% * {{ section.blocks.size }});
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .vip-presentation-main-image {
    width: calc(100% / {{ section.blocks.size }});
    height: 100%;
    flex-shrink: 0;
    position: relative;
  }

  .vip-presentation-main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vip-presentation-main-cta {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    background: #000000;
    color: #ffffff;
    padding: 12px 24px;
    border-radius: 25px;
    font-size: 14px;
    font-weight: 600;
    font-family: 'Montserrat', sans-serif;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
    z-index: 10;
  }

  .vip-presentation-main-cta:hover {
    background: #333333;
    transform: translateX(-50%) scale(1.05);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .vip-presentation-container {
      grid-template-columns: 1fr;
      gap: 60px;
      padding: 40px 40px;
      align-items: flex-start;
    }

    .vip-presentation-section {
      padding: 60px 0;
      height: auto;
      min-height: 100vh;
    }

    .vip-presentation-left {
      justify-content: flex-start;
    }

    .vip-presentation-main-image-container {
      height: 400px;
      max-height: 400px;
    }
  }

  @media (max-width: 768px) {
    .vip-presentation-container {
      padding: 20px;
      gap: 40px;
    }

    .vip-presentation-heading {
      font-size: {{ section.settings.heading_font_size | minus: 8 }}px;
    }

    .vip-presentation-key-points {
      font-size: {{ section.settings.key_points_font_size | minus: 2 }}px;
    }

    .vip-presentation-navigation {
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }

    .vip-presentation-preview-container {
      width: 200px;
      height: 120px;
    }

    .vip-presentation-preview {
      height: 120px;
    }

    .vip-presentation-arrow {
      width: 40px;
      height: 40px;
    }
  }
</style>

<section class="vip-presentation-section">
  <div class="vip-presentation-container">
    <!-- Left Content -->
    <div class="vip-presentation-left">
      <div class="vip-presentation-content">
        {% for block in section.blocks %}
          {% if block.type == 'content_block' %}
            <div class="vip-presentation-slide {% if forloop.first %}active{% endif %}" 
                 data-block-id="{{ forloop.index0 }}"
                 {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h2 class="vip-presentation-heading">{{ block.settings.heading }}</h2>
              {% endif %}

              {% if block.settings.key_points != blank %}
                <div class="vip-presentation-key-points">
                  {{ block.settings.key_points }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="vip-presentation-navigation">
        <div class="vip-presentation-arrows">
          <button class="vip-presentation-arrow" onclick="changeSlide('{{ section.id }}', -1)">
            <svg viewBox="0 0 24 24">
              <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
            </svg>
          </button>
          <button class="vip-presentation-arrow" onclick="changeSlide('{{ section.id }}', 1)">
            <svg viewBox="0 0 24 24">
              <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
            </svg>
          </button>
        </div>

        <div class="vip-presentation-preview-container">
          <div class="vip-presentation-preview-track" id="preview-track-{{ section.id }}">
            {% for block in section.blocks %}
              {% if block.type == 'content_block' and block.settings.preview_image %}
                <div class="vip-presentation-preview {% if forloop.first %}active{% endif %}" 
                     data-block-id="{{ forloop.index0 }}"
                     onclick="goToSlide('{{ section.id }}', {{ forloop.index0 }})">
                  <img src="{{ block.settings.preview_image | image_url: width: 600 }}" 
                       alt="{{ block.settings.heading | strip_html }}"
                       width="600"
                       height="400"
                       loading="lazy">
                  {% if block.settings.preview_cta_text != blank %}
                    <button class="vip-presentation-preview-cta">
                      {{ block.settings.preview_cta_text }}
                    </button>
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

    <!-- Right Image -->
    <div class="vip-presentation-right">
      <div class="vip-presentation-main-image-container">
        <div class="vip-presentation-main-track" id="main-track-{{ section.id }}">
          {% for block in section.blocks %}
            {% if block.type == 'content_block' and block.settings.main_image %}
              <div class="vip-presentation-main-image" data-block-id="{{ forloop.index0 }}">
                <img src="{{ block.settings.main_image | image_url: width: 800 }}" 
                     alt="{{ block.settings.heading | strip_html }}"
                     width="800"
                     height="800"
                     loading="lazy">
                {% if block.settings.main_cta_text != blank %}
                  <a href="{{ block.settings.main_cta_link }}" class="vip-presentation-main-cta">
                    {{ block.settings.main_cta_text }}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
let currentSlideIndex = {};

function initializeSlider(sectionId) {
  currentSlideIndex[sectionId] = 0;
  updateSlider(sectionId);
}

function changeSlide(sectionId, direction) {
  const slides = document.querySelectorAll(`[data-block-id]`);
  const totalSlides = slides.length / 2; // Divided by 2 because we have both content and image slides
  
  currentSlideIndex[sectionId] = (currentSlideIndex[sectionId] + direction + totalSlides) % totalSlides;
  updateSlider(sectionId);
}

function goToSlide(sectionId, slideIndex) {
  currentSlideIndex[sectionId] = slideIndex;
  updateSlider(sectionId);
}

function updateSlider(sectionId) {
  const currentIndex = currentSlideIndex[sectionId];
  
  // Update content slides
  const contentSlides = document.querySelectorAll('.vip-presentation-slide');
  contentSlides.forEach((slide, index) => {
    slide.classList.remove('active', 'prev');
    if (index === currentIndex) {
      slide.classList.add('active');
    } else if (index < currentIndex) {
      slide.classList.add('prev');
    }
  });
  
  // Update preview images with camera reel effect
  const previewTrack = document.getElementById(`preview-track-${sectionId}`);
  const previewImages = document.querySelectorAll('.vip-presentation-preview');
  if (previewTrack) {
    const translateX = -currentIndex * (100 / previewImages.length);
    previewTrack.style.transform = `translateX(${translateX}%)`;
  }
  
  // Update preview active state
  previewImages.forEach((preview, index) => {
    preview.classList.toggle('active', index === currentIndex);
  });
  
  // Update main images with camera reel effect
  const mainTrack = document.getElementById(`main-track-${sectionId}`);
  if (mainTrack) {
    const translateX = -currentIndex * (100 / previewImages.length);
    mainTrack.style.transform = `translateX(${translateX}%)`;
  }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
  const sections = document.querySelectorAll('.vip-presentation-section');
  sections.forEach(section => {
    const sectionId = section.querySelector('[id*="preview-track-"]')?.id.replace('preview-track-', '');
    if (sectionId) {
      initializeSlider(sectionId);
    }
  });
});
</script>

