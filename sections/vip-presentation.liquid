    },
    {
      "type": "color",
      "id": "key_points_color",
      "label": "Key Points Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "bullet_color",
      "label": "Bullet Point Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Arrow & Preview"
    },
    {
      "type": "image_picker",
      "id": "arrow_icon",
